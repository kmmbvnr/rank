+const storageSlot: unique symbol = Symbol('Rank owned storage');
+type InlineArray = RankArray & { readonly [storageSlot]?: OwnedStorage };
+export const ownedStorage = {
+    get(value: RankArray): OwnedStorage | undefined { return (value as InlineArray)[storageSlot]; },
+    has(value: RankArray): boolean { return (value as InlineArray)[storageSlot] !== undefined; },
+    set(value: RankArray, state: OwnedStorage): void {
+        Object.defineProperty(value, storageSlot, { value: state });
