rem Repunit Divisibility
rem https://projecteuler.net/problem=129
rem Find the least n coprime to ten
rem whose shortest repunit multiple has
rem more than Limit digits

use sequences
use io
use cli

arg Limit integer = 1000000
arg Window integer = 30

rem A(n) is the order of 10 mod 9 n and
rem is at most n, so look just above
rem Limit. Build the powers 10^1 to 10^k
rem of every candidate at once, doubling
rem the table: 10^(w+i) = 10^w 10^i.
N = Limit + 1 to Limit + Window array
Free' = N mod 2 equal 1 and N mod 5 not equal 0
N = N filter Free array
Rows = N len
M = (9 * N) reshape Rows 1
Tab = 10 mod M
Width = 1
for Width at most Limit
  Col' = Tab # (Width - 1)
  Last' = Col reshape Rows 1
  Next' = Tab * Last mod M
  Tab = (concat Tab Next axis 1) copy
  Width = Width * 2
end
Cut' = Tab # (0 till Limit)
Short' = (Cut equal 1) any axis 1
Long' = N filter (not Short) array
Answer = Long first
Answer print
