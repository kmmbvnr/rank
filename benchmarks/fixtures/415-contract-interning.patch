--- /dev/null
+++ b/packages/interpreter/src/contract-descriptor.ts
@@ -0,0 +1,70 @@
+import type { CollectionElementType } from './value.js';
+
+type Contract = CollectionElementType;
+const identities = new WeakMap<Contract, number>();
+const normalized = new WeakMap<Contract, Contract>();
+const descriptors = new Map<string, WeakRef<Contract>>();
+let serial = 0;
+const released = new FinalizationRegistry<{ key: string; reference: WeakRef<Contract> }>(({ key, reference }) => {
+    if (descriptors.get(key) === reference) descriptors.delete(key);
+});
+
+/** Only descriptors without live record fields can be shared by a snapshot. */
+export function immutableContract(value: Contract): boolean {
+    return identities.has(value);
+}
+
+/** Canonicalize persistent array/tuple domains. Record maps remain live: a
+ * field refinement must still reach every binding that retained that record. */
+export function contractDescriptor(value: Contract): Contract {
+    const previous = normalized.get(value);
+    if (previous) return previous;
+    const pending: { value: Contract; children?: boolean }[] = [{ value }];
+    while (pending.length) {
+        const task = pending.pop()!, node = task.value;
+        if (normalized.has(node)) continue;
+        if (identities.has(node) || node.fields) {
+            normalized.set(node, node);
+            continue;
+        }
+        if (!task.children) {
+            pending.push({ value: node, children: true });
+            for (const child of [...node.elements ?? [], ...node.positions ?? []]) pending.push({ value: child });
+            continue;
+        }
+        const elements = node.elements?.map(child => normalized.get(child)!);
+        const positions = node.positions?.map(child => normalized.get(child)!);
+        if ([...elements ?? [], ...positions ?? []].some(child => !immutableContract(child))) {
+            normalized.set(node, node);
+            continue;
+        }
+        const key = JSON.stringify([node.type, node.rank, elements?.map(child => identities.get(child)),
+            positions?.map(child => identities.get(child))]);
+        let descriptor = descriptors.get(key)?.deref();
+        if (!descriptor) {
+            descriptor = Object.freeze({ type: node.type, ...(node.rank === undefined ? {} : { rank: node.rank }),
+                ...(elements === undefined ? {} : { elements: Object.freeze(elements) }),
+                ...(positions === undefined ? {} : { positions: Object.freeze(positions) }) });
+            identities.set(descriptor, ++serial);
+            const reference = new WeakRef(descriptor);
+            descriptors.set(key, reference);
+            released.register(descriptor, { key, reference });
+        }
+        normalized.set(node, descriptor);
+    }
+    return normalized.get(value)!;
+}
+
+const transitions = new WeakMap<Contract, WeakMap<Contract, Contract>>();
+
+/** Successful immutable merges contain no binding name or mutable record state. */
+export function contractTransition(expected: Contract, received: Contract, merge: () => Contract): Contract {
+    if (!immutableContract(expected) || !immutableContract(received)) return merge();
+    let following = transitions.get(expected);
+    const cached = following?.get(received);
+    if (cached) return cached;
+    const result = contractDescriptor(merge());
+    if (!following) transitions.set(expected, following = new WeakMap());
+    following.set(received, result);
+    return result;
+}
