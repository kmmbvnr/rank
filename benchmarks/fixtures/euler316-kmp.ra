rem Numbers in Decimal Expansions
rem https://projecteuler.net/problem=316

use sequences
use io
use cli

arg Top integer = 999999
arg Num integer = 10000000000000000

Answer = 0
for N in 2 to Top
  Answer += (Num // N) waiting
end
Answer print

fun N waiting
  Text = N text
  Len = Text len
  Pi = array shape Len fill 0
  J = 0
  for I in 1 till Len
    for J greater 0
      if (Text I) equal (Text J)
        break
      end
      J = Pi (J - 1)
    end
    if (Text I) equal (Text J)
      J += 1
    end
    Pi I = J
  end
  Total = 0
  for Len greater 0
    Total += 10 ** Len
    Len = Pi (Len - 1)
  end
  return Total - (Text len) + 1
end
