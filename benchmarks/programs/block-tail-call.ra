rem Compiler fixture: tail into branches.

fun X bounded
  Value = X - 100000
  if Value less 0
    return 0
  elif Value greater 50000
    Value = 50000
  end
  return Value
end

fun N tail_score
  for N at least 0
    return N bounded
  end
  return 0
end

fun N scores
  Total = 0
  for I in 0 until N
    Total += I tail_score
  end
  return Total
end
