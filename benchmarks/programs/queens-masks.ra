rem N-Queens
rem Place N queens so that none attack each other.

use sequences
use text
use io

Size = 8

Cols = 0 till Size array

rem Each row of States holds the columns of the queens placed so far.
rem Start with Size placements of one queen, one for each possible column.
States = Cols reshape Size 1

rem A column must be free vertically and on both diagonals.
fun Q Dy available
  Mask = Cols not in Q
  Mask and= Cols not in (Q + Dy)
  Mask and= Cols not in (Q - Dy)
  return Mask
end

for Row in 1 till Size
  Dy = Row till 0 by -1
  fun Q avail = Q Dy available
  Free = States avail rank 1
  Where = Free indices

  Previous = States (Where # 0)
  Column = (Where # 1) reshape (Where len) 1
  States = concat Previous Column axis 1
end

States copy
