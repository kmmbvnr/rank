rem Trial divisors: stop at the square root
rem and skip values that do not divide N.

fun trial_divisors N
  Count = 0
  for I in 1 to N
    Square = I * I
    if Square greater N
      break
    end
    if N % I not equal 0
      continue
    end
    Count += 2
    if Square equal N
      Count -= 1
    end
  end
  return Count
end
