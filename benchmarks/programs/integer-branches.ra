rem Exercise branching in a numeric loop.
rem Restart Collatz when it reaches one.
use ranges

fun recurrence Limit
  N = 837799
  Total = 0
  for I in 0 until Limit
    if N equal 1
      N = 837799
    elif N % 2 equal 0
      N //= 2
    else
      N = 3 * N + 1
    end
    Total += N
  end
  return Total
end
