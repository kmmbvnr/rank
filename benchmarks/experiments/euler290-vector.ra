rem Digital Signature
rem https://projecteuler.net/problem=290
rem Count the integers n below 10^N with
rem the same digit sum as 137 n

use numbers
use io
use cli

arg N integer = 18

rem Build n digit by digit from the low
rem end, as a product by 137 is done.
rem A state is the carry c and the digit
rem sum of the product so far minus that
rem of n. The carry left at the end adds
rem its own digit sum, and the total
rem must come to 0.
Rows = 137
Cols = 400
Off = 200
Now = array shape Rows Cols fill 0
Now 0 Off = 1
for Level in 1 to N
  Next = array shape Rows Cols fill 0
  Lo = Off - 9 * (Level - 1) max (Off - 9 * (N - Level + 1) - 18)
  Hi = Off + 9 * (Level - 1) min (Off + 9 * (N - Level + 1))
  for C in 0 till Rows
    for D in 0 to 9
      V = 137 * D + C
      Carry = V // 10
      Move = V mod 10 - D
      Next Carry (Lo + Move to Hi + Move) += Now C (Lo to Hi)
    end
  end
  Now = Next
end
Answer = 0
for C in 0 till Rows
  Mid = C // 10 mod 10
  Extra = C // 100 + Mid + C mod 10
  Answer += Now C (Off - Extra)
end
Answer print
