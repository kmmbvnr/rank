rem Research prototype: sieve polynomial values by their residual factors.
rem Uses O(Limit) exact-integer cells; reference execution is slower.
use numbers
use io
use cli
arg Limit integer = 50000000
fun Bound count_primes
  R = array shape (Bound + 1) fill 0
  Count = 0
  for N in 2 to Bound
    R N = 2 * N * N - 1
  end
  for N in 2 to Bound
    P = R N
    if P greater 1
      if P equal 2 * N * N - 1
        Count += 1
      end
      for K in N + P to Bound by P
        for (R K) mod P equal 0
          R K = R K // P
        end
      end
      Other = P - N
      if Other greater N
        for K in Other to Bound by P
          for (R K) mod P equal 0
            R K = R K // P
          end
        end
      end
    end
  end
  return Count
end
Answer = Limit count_primes
Answer print
