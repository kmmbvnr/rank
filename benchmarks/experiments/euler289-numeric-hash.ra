rem Eulerian Cycles
rem https://projecteuler.net/problem=289
rem C(x, y) is the circle through the
rem corners of the unit square at (x,
rem y), and E(M, N) has the circles with
rem 0 <= x < M and 0 <= y < N. A closed
rem path goes along every arc once,
rem touching itself but not crossing.
rem L(M, N) counts them. Find L(M, N)
rem mod 10^10.

use numbers
use algo
use sequences
use io
use cli

arg M integer = 6
arg N integer = 10

rem The corners are taken row by row,
rem and the state is how the arcs that
rem cross the cut between the corners
rem done and the rest are joined in
rem pairs by the paths of the corners
rem done. Each corner joins its arcs in
rem pairs that do not cross, listed in
rem the order around it by tangent and
rem the side of the curve: there are 1,
rem 2 or 14 of these for 2, 4 or 8 arcs.
rem A pair of ends of one path closes a
rem cycle, allowed only at the very end.
rem The count is mod 10^10.
M0 = array 0 1 2 3 4 5 6 7
M1 = array 0 1 2 3 4 7 5 6
M2 = array 0 1 2 5 3 4 6 7
M3 = array 0 1 2 7 3 4 5 6
M4 = array 0 1 2 7 3 6 4 5
M5 = array 0 3 1 2 4 5 6 7
M6 = array 0 3 1 2 4 7 5 6
M7 = array 0 5 1 2 3 4 6 7
M8 = array 0 5 1 4 2 3 6 7
M9 = array 0 7 1 2 3 4 5 6
M10 = array 0 7 1 2 3 6 4 5
M11 = array 0 7 1 4 2 3 5 6
M12 = array 0 7 1 6 2 3 4 5
M13 = array 0 7 1 6 2 5 3 4
Mt8 = M0
Mt8 = concat Mt8 M1
Mt8 = concat Mt8 M2
Mt8 = concat Mt8 M3
Mt8 = concat Mt8 M4
Mt8 = concat Mt8 M5
Mt8 = concat Mt8 M6
Mt8 = concat Mt8 M7
Mt8 = concat Mt8 M8
Mt8 = concat Mt8 M9
Mt8 = concat Mt8 M10
Mt8 = concat Mt8 M11
Mt8 = concat Mt8 M12
Mt8 = concat Mt8 M13
Mt4 = array 0 1 2 3 0 3 1 2
Mt2 = array 0 1
Sc = array 0 -1 0 -1 -1 0 -1 0
Sx = array -1 0 0 -1 0 -1 -1 0
Ss = array 2 1 3 2 0 3 1 0
Cap = 4000
Ca = array shape (Cap * 16) fill 0
Cp = array shape (Cap * 16) fill 0
Cl = array shape Cap fill 0
Cv = array shape Cap fill 0
Na = array shape (Cap * 16) fill 0
Np = array shape (Cap * 16) fill 0
Nl = array shape Cap fill 0
Nv = array shape Cap fill 0
Ta = array shape 40 fill 0
Tp = array shape 40 fill 0
Pa = array shape 8 fill 0
Pos = array shape (M * N * 4) fill 0
Nc = 1
Cv 0 = 1
Total = (M + 1) * (N + 1)
Vc = 0
for Y in 0 to N
  for X in 0 to M
    Vc += 1
    Last = Vc equal Total
    K = 0
    for J in 0 to 7
      Cx = X + Sc J
      Cy = Y + Sx J
      if Cx at least 0 and Cx less M
        if Cy at least 0 and Cy less N
          Ci = Cx * N + Cy
          Pa K = Ci * 4 + Ss J
          K += 1
        end
      end
    end
    Mc = 1
    Mt = Mt2
    if K equal 4
      Mc = 2
      Mt = Mt4
    end
    if K equal 8
      Mc = 14
      Mt = Mt8
    end
    Hk = array shape 8191 fill -1
    Hv = array shape 8191 fill 0
    Ns = 0
    for S in 0 till Nc
      for Mi in 0 till Mc
        Tn = Cl S
        for I in 0 till Tn
          Ta I = Ca (S * 16 + I)
          Tp I = Cp (S * 16 + I)
        end
        Closed = 0
        for Q in 0 to (K // 2 - 1)
          Mo = Mi * K + 2 * Q
          A = Pa (Mt Mo)
          B = Pa (Mt (Mo + 1))
          Ia = 0 - 1
          Ib = 0 - 1
          for I in 0 till Tn
            if Ta I equal A
              Ia = I
            end
            if Ta I equal B
              Ib = I
            end
          end
          Ha = Ia at least 0
          Hb = Ib at least 0
          Both = Ha and Hb
          if Both
            Pta = Tp Ia
            if Pta equal B
              Closed += 1
              Hi = Ia
              Lo = Ib
              if Ib greater Ia
                Hi = Ib
                Lo = Ia
              end
              Ta Hi = Ta (Tn - 1)
              Tp Hi = Tp (Tn - 1)
              Tn -= 1
              Ta Lo = Ta (Tn - 1)
              Tp Lo = Tp (Tn - 1)
              Tn -= 1
            else
              Ptb = Tp Ib
              for I in 0 till Tn
                if Ta I equal Pta
                  Tp I = Ptb
                end
                if Ta I equal Ptb
                  Tp I = Pta
                end
              end
              Hi = Ia
              Lo = Ib
              if Ib greater Ia
                Hi = Ib
                Lo = Ia
              end
              Ta Hi = Ta (Tn - 1)
              Tp Hi = Tp (Tn - 1)
              Tn -= 1
              Ta Lo = Ta (Tn - 1)
              Tp Lo = Tp (Tn - 1)
              Tn -= 1
            end
          end
          if Ia at least 0 and Ib less 0
            Pta = Tp Ia
            Ta Ia = B
            for I in 0 till Tn
              if Ta I equal Pta
                Tp I = B
              end
            end
          end
          if Ia less 0 and Ib at least 0
            Ptb = Tp Ib
            Ta Ib = A
            for I in 0 till Tn
              if Ta I equal Ptb
                Tp I = A
              end
            end
          end
          if Ia less 0 and Ib less 0
            Ta Tn = A
            Tp Tn = B
            Tn += 1
            Ta Tn = B
            Tp Tn = A
            Tn += 1
          end
        end
        Ok = 1
        if Closed greater 1
          Ok = 0
        end
        if Closed equal 1
          if Last equal false
            Ok = 0
          end
          if Tn greater 0
            Ok = 0
          end
        end
        if Last and Closed equal 0
          Ok = 0
        end
        if Ok equal 1
          for I in 1 till Tn
            Xa = Ta I
            Xp = Tp I
            Jj = I - 1
            for
              if Jj less 0
                break
              end
              if Ta Jj at most Xa
                break
              end
              Ta (Jj + 1) = Ta Jj
              Tp (Jj + 1) = Tp Jj
              Jj -= 1
            end
            Ta (Jj + 1) = Xa
            Tp (Jj + 1) = Xp
          end
          for I in 0 till Tn
            Pos (Ta I) = I
          end
          Key = 0
          for I in 0 till Tn
            if Ta I less Tp I
              Key = Key * 16 + Pos (Tp I)
            end
          end
          H = Key mod 8191
          for
            if Hk H equal -1 or Hk H equal Key
              break
            end
            H = (H + 1) mod 8191
          end
          Id = 0
          if Hk H equal Key
            Id = Hv H
            Sm = Nv Id + Cv S
            Nv Id = Sm mod 10000000000
          else
            Id = Ns
            Hk H = Key
            Hv H = Ns
            Nl Id = Tn
            Nv Id = Cv S
            for I in 0 till Tn
              Na (Id * 16 + I) = Ta I
              Np (Id * 16 + I) = Tp I
            end
            Ns += 1
          end
        end
      end
    end
    Old = Ca
    Ca = Na
    Na = Old
    Old = Cp
    Cp = Np
    Np = Old
    Old = Cl
    Cl = Nl
    Nl = Old
    Old = Cv
    Cv = Nv
    Nv = Old
    Nc = Ns
  end
end
Answer = Cv 0
Answer print
