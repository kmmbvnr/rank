rem Strong Achilles Numbers
rem https://projecteuler.net/problem=302

use numbers
use sequences
use algo
use io
use cli

arg Limit integer = 10 ** 18

rem The largest prime has exponent at
rem least three, so it is below cbrt N.
Root = (Limit ** (1 / 3)) floor
for (Root + 1) ** 3 less Limit
  Root += 1
end
for Root ** 3 at least Limit
  Root -= 1
end
Pr = primes to Root array
rem Packed factors of each P - 1.
Offsets = array shape (Pr len + 1) fill 0
Factors = new queue
for I in 0 till Pr len
  for F in (Pr I - 1) factors
    Factors push F
  end
  Offsets (I + 1) = Factors len
end
Flat = Factors array
Empty = array shape 0 fill 0
Last = Pr len - 1
Answer = 1 Empty 0 0 Last g
Answer print

rem Fs holds unfinished factors of phi.
rem Gp holds finished exponent gcds.
fun N Fs Gn Gp Max g
  Total = 0
  Ks = Fs unique
  if Gn equal 1
    G = Gp
    Done = true
    for F in Ks
      E = (Fs equal F) count
      if E less 2
        Done = false
        break
      end
      G = G gcd E
    end
    if Done and (G equal 1)
      Total = 1
    end
  end
  for I in 0 to Max
    P = Pr I
    Pow = P * P
    if N * Pow at least Limit
      break
    end
    Have = (Fs equal P) count
    Exp = 2
    if Have equal 0
      Pow *= P
      Exp += 1
    end
    if N * Pow at least Limit
      continue
    end
    G2 = Gp
    Ok = true
    for F in Ks
      if F greater P
        E = (Fs equal F) count
        if E less 2
          Ok = false
          break
        end
        G2 = G2 gcd E
      end
    end
    if not Ok
      continue
    end
    Lo = Offsets I
    Hi = Offsets (I + 1)
    Size = (Fs less P) count + Hi - Lo
    F2 = array shape Size fill 0
    At = 0
    for F in Fs
      if F less P
        F2 At = F
        At += 1
      end
    end
    for J in Lo till Hi
      F2 At = Flat J
      At += 1
    end
    for N * Pow less Limit
      Next = N * Pow
      Gn2 = Gn gcd Exp
      Ep = Have + Exp - 1
      Gp2 = G2 gcd Ep
      Prev = I - 1
      More = Next F2 Gn2 Gp2 Prev g
      Total += More
      Pow *= P
      Exp += 1
    end
  end
  return Total
end
