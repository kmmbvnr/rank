rem Largest Integer with Two Primes
rem https://projecteuler.net/problem=347

use sequences
use io
use cli

arg Limit integer = 10000000

fun Limit twoprimes
  Ps = primes to Limit // 2 array
  Sum = 0
  for I in 0 till (Ps len)
    P = Ps I
    if P * P greater Limit
      break
    end
    for J in I + 1 till (Ps len)
      Q = Ps J
      if P * Q greater Limit
        break
      end
      Best = 0
      Power = P
      Top = Q
      for Top * Q * P at most Limit
        Top *= Q
      end
      for Power * Q at most Limit
        for Power * Top greater Limit
          Top = Top // Q
        end
        Best = Best max (Power * Top)
        Power *= P
      end
      Sum += Best
    end
  end
  return Sum
end

Answer = Limit twoprimes
Answer print
