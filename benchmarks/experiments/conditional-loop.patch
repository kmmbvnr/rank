+import { describe, expect, it } from 'vitest';
+import { runConditionalLoop } from '../src/conditional-loop.js';
+import { completed, ExecutionStack, type Execution } from '../src/execution.js';
+import { Interpreter, RankError, formatValue, type RankValue } from '../src/index.js';
+
+describe('synchronous conditional loops', () => {
+    it('finishes completed bodies without allocating a suspended task', () => {
+        let index = 0;
+        const result = runConditionalLoop(() => index < 10,
+            () => completed(BigInt(++index)), error => { throw error; });
+        expect(result).toEqual({ done: true, value: 10n });
+    });
+
+    it('keeps continuation depth bounded across repeated suspensions', () => {
+        let index = 0, depth = 0;
+        const loop = runConditionalLoop(() => index < 20000, () => (function* (): Execution<RankValue | undefined> {
+            yield { value: BigInt(++index) };
+            return BigInt(index);
+        })(), error => { throw error; });
+        const stack = new ExecutionStack(loop);
+        let next = stack.next();
+        while (!next.done) {
+            depth = Math.max(depth, (stack as unknown as { stack: unknown[] }).stack.length);
+            next = stack.next();
+        }
+        expect(next.value).toBe(20000n);
+        expect(depth).toBeLessThanOrEqual(2);
+    });
+
+    it('handles break and continue after a suspended body without replay', () => {
+        let index = 0;
+        const loop = runConditionalLoop(() => index < 10, () => (function* (): Execution<RankValue | undefined> {
+            const value = ++index;
+            yield { value: BigInt(value) };
+            if (value === 2) throw 'continue';
+            if (value === 5) throw 'break';
+            return BigInt(value);
+        })(), error => {
+            if (error === 'break' || error === 'continue') return error;
+            throw error;
+        });
+        const stack = new ExecutionStack(loop);
+        const seen: RankValue[] = [];
+        let next = stack.next();
+        while (!next.done) { seen.push(next.value); next = stack.next(); }
+        expect(seen).toEqual([1n, 2n, 3n, 4n, 5n]);
+        expect(next.value).toBe(4n);
+    });
+
+    it.each([
+        `use io
+fun next X
+  Y = X + 1
+  Y print
+  return Y
+end
+I = 0
+for I less 3
+  I = I next
+  X = I + 1
+end
+I
+`,
+        `use io
+fun values X
+  try
+    for true
+      yield X
+      X += 1
+    end
+  finally
+    "closed" print
+  end
+end
+for V in 10 values
+  V print
+  break
+end
+true
+`,
+        `I = 0
+for I less 2
+  I += 1
+  Value = 1 / (I - 1)
+end
+`,
+    ])('matches reference loop output and diagnostics', source => {
+        const run = (synchronousLoops: boolean) => {
+            const output: string[] = [];
+            const runtime = new Interpreter(line => output.push(line), { synchronousLoops });
+            try {
+                const value = runtime.execute(source);
+                return { output, value: value === undefined ? undefined : formatValue(value) };
+            } catch (error) {
+                return { output, error: error instanceof RankError ? error.format() : String(error) };
+            } finally { runtime.dispose(); }
+        };
+        expect(run(true)).toEqual(run(false));
+    });
+});
