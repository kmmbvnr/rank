+import { completed, type Evaluation, type Execution } from './execution.js';
+import type { RankValue } from './value.js';
+
+type Value = RankValue | undefined;
+type Control = (error: unknown) => 'break' | 'continue';
+
+/** Completed iterations need neither a generator nor per-loop state closures. */
+export function runConditionalLoop(
+    test: () => boolean, body: () => Evaluation<Value>, control: Control,
+): Evaluation<Value> {
+    let result: Value;
+    while (test()) {
+        try {
+            const task = body();
+            if ('done' in task) result = task.value;
+            else return continueLoop(test, body, control, result, task);
+        } catch (error) {
+            if (control(error) === 'break') break;
+        }
+    }
+    return completed(result);
+}
+
+/** One continuation handles every later suspension, with bounded stack depth. */
+function* continueLoop(
+    test: () => boolean, body: () => Evaluation<Value>, control: Control,
+    result: Value, first: Execution<Value>,
+): Execution<Value> {
+    try { result = (yield { task: first }) as Value; }
+    catch (error) { if (control(error) === 'break') return result; }
+    while (test()) {
+        try {
+            const task = body();
+            result = 'done' in task ? task.value : (yield { task }) as Value;
+        } catch (error) {
+            if (control(error) === 'break') break;
+        }
+    }
+    return result;
+}
