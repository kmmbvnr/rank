fun N pairs M
  Period = 6 * M
  Whole = N // Period
  Rest = N mod Period
  Seen = array shape M fill 0
  Tail = array shape M fill 0
  B = array -1 3 6 7 13 14
  C = array 0 1 2 2 5 5
  for T in 0 till M
    Base = 9 * T * T
    for R in 0 till 6
      Index = 6 * T + R
      Prefix = (Base + B R * T + C R)
      Prefix = Prefix mod M
      Seen Prefix += 1
      if Index at most Rest
        Tail Prefix += 1
      end
    end
  end
  Answer = 0
  for I in 0 till M
    Count = Whole * Seen I + Tail I
    Answer += Count * (Count - 1) // 2
  end
  return Answer
end
