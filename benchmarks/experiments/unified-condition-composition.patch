@@ -71,6 +71,22 @@ interface Frame {
     returning: boolean;
 }
 
+export function findExecution<T>(values: readonly T[], predicate: (value: T) => Evaluation<boolean>): Evaluation<number> {
+    for (let index = 0; index < values.length; index++) {
+        const task = predicate(values[index]);
+        if ('done' in task) {
+            if (task.value) return completed(index);
+        } else return (function* (): Execution<number> {
+            if (yield* resume(task)) return index;
+            for (index++; index < values.length; index++) {
+                if (yield* resume(predicate(values[index]))) return index;
+            }
+            return -1;
+        })();
+    }
+    return completed(-1);
+}
+
 // Both ordinary functions and suspended Rank generators use this driver.
 // Cancellation unwinds every suspended task, including finally blocks that
 // themselves call Rank functions.
