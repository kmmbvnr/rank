diff --git a/packages/interpreter/test/condition-composition.test.ts b/packages/interpreter/test/condition-composition.test.ts
new file mode 100644
index 0000000..787dfe4
--- /dev/null
+++ b/packages/interpreter/test/condition-composition.test.ts
@@ -0,0 +1,48 @@
+import { describe, expect, it } from 'vitest';
+import { completed, emit, ExecutionStack, findExecution, type Execution } from '../src/execution.js';
+import { Interpreter } from '../src/index.js';
+
+describe('condition composition', () => {
+    it('stops synchronously at the first match', () => {
+        const seen: number[] = [];
+        expect(findExecution([1, 2, 3], value => {
+            seen.push(value); return completed(value === 2);
+        })).toEqual(completed(1));
+        expect(seen).toEqual([1, 2]);
+        expect(findExecution([], () => completed(true))).toEqual(completed(-1));
+    });
+
+    it('resumes without replaying completed conditions', () => {
+        const seen: number[] = [];
+        const stack = new ExecutionStack(findExecution([0, 1, 2, 3], value => {
+            seen.push(value);
+            return value === 1 ? (function* (): Execution<boolean> { yield* emit(7n); return false; })()
+                : completed(value === 2);
+        }));
+        expect(stack.next()).toEqual({ done: false, value: 7n });
+        expect(seen).toEqual([0, 1]);
+        expect(stack.next()).toEqual({ done: true, value: 2 });
+        expect(seen).toEqual([0, 1, 2]);
+    });
+
+    it('keeps Rank call conditions and skipped elif effects in order', () => {
+        const output: string[] = [];
+        const runtime = new Interpreter(line => output.push(line));
+        expect(runtime.execute(`use io
+fun check N
+  N print
+  return N equal 2
+end
+if 1 check
+  10
+elif 2 check
+  20
+elif 3 check
+  30
+else
+  40
+end`)).toBe(20n);
+        expect(output).toEqual(['1', '2']);
+        runtime.dispose();
+    });
+});
