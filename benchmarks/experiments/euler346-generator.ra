rem Strong Repunits
use numbers
use algo
use sequences
use io
use cli

arg Limit integer = 10 ** 12

fun Limit longer
  for Base in 2 to (Limit - 1 isqrt)
    Value = Base ** 3 + Base ** 2
    Value += Base + 1
    if Value at least Limit
      break
    end
    for Value less Limit
      yield Value
      Value = Value * Base + 1
    end
  end
end

fun Limit strong
  if Limit at most 1
    return 0
  end
  if Limit less 7
    return 1
  end
  B = (4 * Limit - 7 isqrt) - 1
  B = B // 2
  Total = B * (B + 1) * (B + 2) // 3
  Values = Limit longer unique
  D = 4 * Values - 3
  Keep = D isqrt ** 2 not equal D
  Extra = Values Keep
  return Total + B - 2 + (Extra sum)
end

Limit strong print
