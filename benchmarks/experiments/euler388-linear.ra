rem Distinct Lines
rem https://projecteuler.net/problem=388

use numbers
use sequences
use algo
use io
use cli

arg N integer = 10 ** 10
arg Cut integer = 4641589

rem Mertens values up to N^(2/3).
Mu = array shape (Cut + 1) fill 2
Mu 0 = 0
Mu 1 = 1
PrimeSize = Cut // 2 + 1
Pr = array shape PrimeSize fill 0
Cnt = 0
for I in 2 to Cut
  if Mu I equal 2
    Pr Cnt = I
    Cnt += 1
    Mu I = -1
  end
  for J in 0 till Cnt
    V = I * Pr J
    if V greater Cut
      break
    end
    if I mod Pr J equal 0
      Mu V = 0
      break
    end
    Mu V = -(Mu I)
  end
end
for I in 1 to Cut
  Mu I += Mu (I - 1)
end
Cache = new index
Answer = 0
L = 1
for L at most N
  Q = N // L
  R = N // Q
  M = R mertens Cache
  Before = L - 1 mertens Cache
  F = (Q + 1) ** 3 - 1
  Answer += (M - Before) * F
  L = R + 1
end
Text = Answer text
Len = Text len
Token = Text
if Len greater 18
  Head = Text take 9
  Tail = Text drop (Len - 9)
  Token = Head + Tail
end
Token print

fun X mertens Cache
  if X at most Cut
    return Mu X
  end
  Slot = N // X
  if Slot in Cache
    return Cache Slot
  end
  Total = 1
  L = 2
  for L at most X
    Q = X // L
    R = X // Q
    Count = R - L + 1
    Part = Q mertens Cache
    Total -= Count * Part
    L = R + 1
  end
  Cache Slot = Total
  return Total
end
