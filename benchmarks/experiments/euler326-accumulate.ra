fun N pairs M
  Period = 6 * M
  Whole = N // Period
  Rest = N mod Period
  Seen = array shape M fill 0
  Tail = array shape M fill 0
  B = array -1 3 6 7 13 14
  C = array 0 1 2 2 5 5
  T = 0 till M array
  Base = (9 * T * T) mod M
  for R in 0 till 6
    Slope = B R
    Offset = C R
    Keys = (Base + Slope * T + Offset) mod M
    if Whole greater 0
      Seen Keys += 1 .accumulate
    end
    Length = (Rest - R) // 6 + 1
    if Length greater 0
      Part = Keys take Length
      Tail Part += 1 .accumulate
    end
  end
  Answer = 0
  for I in 0 till M
    Count = Whole * Seen I + Tail I
    Answer += Count * (Count - 1) // 2
  end
  return Answer
end
