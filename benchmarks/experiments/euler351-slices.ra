rem Hexagonal Orchards
rem https://projecteuler.net/problem=351

use sequences
use numbers
use algo
use io
use cli

arg Limit integer = 10 ** 8

fun X N Root Phi Cache tots
  if X at most Root
    return Phi X
  end
  Slot = N // X
  if Slot in Cache
    return Cache Slot
  end
  Sum = X * (X + 1) // 2
  L = 2
  for L at most X
    Q = X // L
    R = X // Q
    T = Q N Root Phi Cache tots
    Sum -= (R - L + 1) * T
    L = R + 1
  end
  Cache Slot = Sum
  return Sum
end

fun N hidden
  Root = N ** (2 / 3) floor
  Phi = 0 to Root array
  for P in primes to Root
    Ix = P to Root by P
    Phi Ix -= Phi Ix // P
  end
  Phi = Phi scan + array
  Cache = new index
  S = N N Root Phi Cache tots
  return 6 * (N * (N + 1) // 2 - S)
end

Answer = Limit hidden
Answer print
