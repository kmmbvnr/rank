rem Golomb's Self-describing Sequence
rem https://projecteuler.net/problem=341

use io
use cli

arg Count integer = 1000000

Count cubes print

fun Count cubes
  G = array shape (Count + 3) fill 0
  G 1 = 1
  V = 1
  End = 1
  Idx = 1
  Sum = 1
  Products = 1
  PrevSum = 0
  PrevProd = 0
  Answer = 0
  for N in 1 till Count
    Cube = N ** 3
    for Products less Cube
      Idx += 1
      PrevSum = Sum
      PrevProd = Products
      if Idx greater End
        V += 1
        At = V - (G (G (V - 1)))
        G V = 1 + G At
        End += G V
      end
      Sum += V
      Products += Idx * V
    end
    Gap = Cube - PrevProd
    Offset = (Gap + Idx - 1) // Idx
    Answer += PrevSum + Offset
  end
  return Answer
end

fun N term
  G = array shape (N + 1) fill 0
  G 1 = 1
  for I in 2 to N
    Prev = I - 1
    At = I - (G (G Prev))
    G I = 1 + G At
  end
  return G N
end
