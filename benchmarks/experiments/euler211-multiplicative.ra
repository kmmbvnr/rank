rem Research control for Euler 211.
rem Factor each block and multiply the
rem squared-prime geometric sums.

use numbers
use io
use sequences

use cli

arg Limit integer = 64000000
arg Block integer = 1000000
Root = Limit isqrt
Ps = primes to Root array
Sig = array shape Block fill 0
Rem = array shape Block fill 0
Total = 0
for Lo in 1 to (Limit - 1) by Block
  Hi = (Lo + Block) min Limit
  for K in 0 till (Hi - Lo)
    Sig K = 1
    Rem K = Lo + K
  end
  for P in Ps
    P2 = P * P
    From = (Lo + P - 1) // P * P
    for N in From to (Hi - 1) by P
      K = N - Lo
      V = Rem K
      Term = 1
      Power = 1
      for
        if V mod P not equal 0
          break
        end
        V //= P
        Power *= P2
        Term += Power
      end
      Rem K = V
      Sig K *= Term
    end
  end
  for K in 0 till (Hi - Lo)
    V = Rem K
    S = Sig K
    if V greater 1
      S *= 1 + V * V
    end
    R = S isqrt
    if R * R equal S
      Total += Lo + K
    end
  end
end
Answer = Total
Answer print
