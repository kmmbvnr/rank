rem Digital Root Clocks
rem https://projecteuler.net/problem=315

use bits
use sequences
use io
use cli

arg From integer = 10000000
arg To integer = 20000000

Masks = array 125 80 55 115 90
Tail = array 107 111 89 127 123
Masks = concat Masks Tail
Common = ((Masks reshape 10 1) band Masks) popcount
Answer = 0
for P in primes from From till To
  Answer += P clock_diff
end
Answer print

fun N digit_sum
  Sum = 0
  for N greater 0
    Sum += (N mod 10)
    N //= 10
  end
  return Sum
end

fun N segments
  Count = 0
  for N greater 0
    D = N mod 10
    Count += (Masks D) popcount
    N //= 10
  end
  return Count
end

fun A overlap B
  Count = 0
  for B greater 0
    Count += Common (A mod 10) (B mod 10)
    A //= 10
    B //= 10
  end
  return Count
end

fun N clock_diff
  Count = 0
  for N at least 10
    Next = N digit_sum
    Count += N overlap Next
    N = Next
  end
  return 2 * Count
end
