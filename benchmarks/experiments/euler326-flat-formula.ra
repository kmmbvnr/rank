fun N pairs M
  Period = 6 * M
  Whole = N // Period
  Rest = N mod Period
  Counts = array shape M fill 0
  B = array -1 3 6 7 13 14
  C = array 0 1 2 2 5 5
  for Index in 0 till Period
    T = Index // 6
    R = Index mod 6
    Prefix = (9 * T * T + B R * T + C R)
    Prefix = Prefix mod M
    Counts Prefix += Whole
    if Index at most Rest
      Counts Prefix += 1
    end
  end
  Answer = 0
  for Count in Counts
    Answer += Count * (Count - 1) // 2
  end
  return Answer
end
