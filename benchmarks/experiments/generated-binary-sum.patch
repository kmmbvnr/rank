diff --git a/packages/interpreter/src/generated-sum.ts b/packages/interpreter/src/generated-sum.ts
new file mode 100644
index 0000000..e9d48b7
--- /dev/null
+++ b/packages/interpreter/src/generated-sum.ts
@@ -0,0 +1,41 @@
+import { expectNumeric } from './modules/shared.js';
+import type { RankValue } from './value.js';
+
+type Reader = ((index: number) => RankValue) | undefined;
+type Kernel = (size: number, a: Reader, b: Reader, left: RankValue, right: RankValue) => RankValue;
+
+/** Experimental: source contains only a whitelisted operator, never Rank text. */
+export function generatedBinarySum(
+    operator: string,
+    operation: (left: RankValue, right: RankValue) => RankValue,
+): Kernel | undefined {
+    if (!['+', '-', '*'].includes(operator)) return undefined;
+    try {
+        return new Function('operation', 'numeric', `
+            return function(size, a, b, left, right) {
+                let total = 0n;
+                let invalid;
+                for (let index = 0; index < size; index++) {
+                    const x = a ? a(index) : left;
+                    const y = b ? b(index) : right;
+                    const item = typeof x === 'bigint' && typeof y === 'bigint'
+                        ? x ${operator} y
+                        : (typeof x === 'number' || typeof x === 'bigint')
+                            && (typeof y === 'number' || typeof y === 'bigint')
+                            ? Number(x) ${operator} Number(y) : operation(x, y);
+                    if (invalid !== undefined) continue;
+                    try {
+                        const value = numeric(item);
+                        total = typeof total === 'bigint' && typeof value === 'bigint'
+                            ? total + value : Number(total) + Number(value);
+                    } catch (error) { invalid = error; }
+                }
+                if (invalid !== undefined) throw invalid;
+                return total;
+            };
+        `)(operation, expectNumeric) as Kernel;
+    } catch {
+        // Hosts that prohibit dynamic code keep the ordinary validated fold.
+        return undefined;
+    }
+}
diff --git a/packages/interpreter/test/generated-sum.test.ts b/packages/interpreter/test/generated-sum.test.ts
