index 0000000..377b252
--- /dev/null
+++ b/packages/interpreter/test/generated-sum.test.ts
@@ -0,0 +1,30 @@
+import { describe, expect, it, vi } from 'vitest';
+import { generatedBinarySum } from '../src/generated-sum.js';
+import type { RankValue } from '../src/value.js';
+
+describe('generated sum experiment', () => {
+    it('retains exact integers, mixed arithmetic and left-fold rounding', () => {
+        const kernel = generatedBinarySum('*', () => { throw new Error('unexpected fallback'); })!;
+        const huge = 2n ** 80n;
+        expect(kernel(2, i => [huge, 1n][i], undefined, 0n, 2n)).toBe(huge * 2n + 2n);
+        expect(kernel(3, i => [1e16, 1, -1e16][i], undefined, 0n, 1n)).toBe(0);
+        expect(kernel(2, i => [1n, 0.5][i], undefined, 0n, 2n)).toBe(3);
+        expect(kernel(0, undefined, undefined, 1n, 2n)).toBe(0n);
+        expect(kernel(1, undefined, undefined, NaN, 1n)).toBeNaN();
+    });
+
+    it('retains read order and arithmetic error precedence over bad sum elements', () => {
+        const seen: number[] = [];
+        const kernel = generatedBinarySum('+', () => 'bad')!;
+        const a = (i: number): RankValue => { seen.push(i); if (i === 2) throw new Error('later arithmetic'); return false; };
+        expect(() => kernel(3, a, undefined, 0n, false)).toThrow('later arithmetic');
+        expect(seen).toEqual([0, 1, 2]);
+    });
+
+    it('rejects unknown operators and falls back when dynamic code is disabled', () => {
+        expect(generatedBinarySum('x; throw 1', () => 0n)).toBeUndefined();
+        vi.stubGlobal('Function', function () { throw new Error('dynamic code disabled'); });
+        try { expect(generatedBinarySum('+', () => 0n)).toBeUndefined(); }
+        finally { vi.unstubAllGlobals(); }
+    });
+});
