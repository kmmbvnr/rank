rem Integer Ladders
rem https://projecteuler.net/problem=309

use algo
use numbers
use sequences
use io
use cli

arg Limit integer = 1000000

Top = Limit - 1
Cnt = array shape Limit fill 0
Root = (Top ** 0.5) floor + 2
for M in 2 to Root
  for N in (1 + M mod 2) till M by 2
    rem Coprime parameters of opposite parity generate each triangle once.
    if M gcd N not equal 1
      continue
    end
    A = M * M - N * N
    B = 2 * M * N
    C = M * M + N * N
    for K in 1 to (Top // C)
      Cnt (A * K) += 1
      Cnt (B * K) += 1
    end
  end
end
Ends = Cnt scan + array
Data = array shape (Cnt sum) fill 0
Cnt = array shape Limit fill 0
for M in 2 to Root
  for N in (1 + M mod 2) till M by 2
    rem Coprime parameters of opposite parity generate each triangle once.
    if M gcd N not equal 1
      continue
    end
    A = M * M - N * N
    B = 2 * M * N
    C = M * M + N * N
    for K in 1 to (Top // C)
      W1 = A * K
      H1 = B * K
      I1 = Cnt W1
      Data ((Ends W1) - I1 - 1) = H1
      Cnt W1 += 1
      W2 = B * K
      H2 = A * K
      I2 = Cnt W2
      Data ((Ends W2) - I2 - 1) = H2
      Cnt W2 += 1
    end
  end
end
Answer = 0
for W in 1 to Top
  Size = Cnt W
  if Size less 2
    continue
  end
  Start = (Ends W) - Size
  for I in 1 till Size
    H = Data (Start + I)
    for J in 0 till I
      Lo = Data (Start + J)
      if (H * Lo) mod (H + Lo) equal 0
        Answer += 1
      end
    end
  end
end
Answer print
