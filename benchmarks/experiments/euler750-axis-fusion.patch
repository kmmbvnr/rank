+export function reduceNumberTensorAxis(value: RankArray, operation: 'min' | 'max', axis: number): RankValue | undefined {
+    const graph = prepareTensorGraph(value);
+    if (!graph?.transformed || graph.nonReplayableChecks) return undefined;
+    const { root, domains, host, scope } = graph;
+    const result = prepareLayoutNumberTensor(root, domains, operation, scope.code, host.valid!,
+        undefined, 0, host.compiled, axis)?.();
+    if (result === undefined || typeof result !== 'bigint' && !isRankArray(result as RankValue)) return undefined;
+    scope.executed();
+    const diagnostics = currentDiagnostics();
+    if (diagnostics) diagnostics.numberTensors++;
+    return result as RankValue;
