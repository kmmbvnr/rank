rem Strong Repunits
use numbers
use algo
use io
use cli

arg Limit integer = 10 ** 12

fun Limit strong
  if Limit at most 1
    return 0
  end
  if Limit less 7
    return 1
  end
  B = (4 * Limit - 7 isqrt) - 1
  B = B // 2
  Total = B * (B + 1) * (B + 2) // 3
  Total += B - 2
  Seen = new set
  for Base in 2 to (Limit - 1 isqrt)
    Value = Base ** 3 + Base ** 2
    Value += Base + 1
    if Value at least Limit
      break
    end
    for Value less Limit
      Root = 4 * Value - 3 isqrt
      if Root * Root not equal 4 * Value - 3
        Seen add Value
      end
      Value = Value * Base + 1
    end
  end
  return Total + (Seen sum)
end

Limit strong print
