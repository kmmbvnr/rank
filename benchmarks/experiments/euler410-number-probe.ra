rem Circle and Tangent Line
rem https://projecteuler.net/problem=410

use numbers
use sequences
use io
use cli

arg R integer = 100000000
arg X integer = 1000000000
arg Block integer = 10000000

rem F(A, B) = sum over m <= min(A, B)
rem of 2^w(m) U(m), w = distinct
rem primes, a = A // m, b = B // m,
rem U = 2 a b for odd m and
rem a b + (a mod 2)(b mod 2) for
rem even m. F is symmetric, so the
rem answer is 2 F(R, X). w comes
rem from a sieve of each block by
rem primes up to sqrt: the smooth
rem part of m shows a big factor.
L = R min X
Root = L isqrt
Primes = primes to Root copy
Powers = 2 ** (0 to 10)
Tot = 0
for Lo in 1 to L by Block
  Hi = L min (Lo + Block - 1)
  Len = Hi - Lo + 1
  M = Lo to Hi copy
  Sm = array shape Len fill 1
  Om = array shape Len fill 0
  for P in Primes
    Q = P
    for Q at most Hi
      S = (Lo + Q - 1) // Q * Q - Lo
      if S less Len
        Sm (S to Len - 1 by Q) *= P
        if Q equal P
          Om (S to Len - 1 by Q) += 1
        end
      end
      Q *= P
    end
  end
  Om = Om + (Sm less M choose 1 0)
  A = R // M
  B = X // M
  Even = (A * B + A mod 2 * (B mod 2))
  Us = M mod 2 equal 1 choose (2 * A * B) Even
  Tot += Powers Om * Us sum
end
Answer = 2 * Tot
Answer print
