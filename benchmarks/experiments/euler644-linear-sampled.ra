rem Squares on the Line
rem https://projecteuler.net/problem=644

use numbers
use sequences
use algo
use bits
use io
use cli

arg Lo integer = 200
arg Hi integer = 500

rem Pass 1: Grundy values g(L) of a
rem segment, constant between lattice
rem points a + b sqrt 2. For L inside
rem one lattice gap, the moves leave
rem u = L - 1 or L - sqrt 2; cutting
rem [0, u] at the starts of the runs of
rem g and at u minus them gives pieces
rem with one g(x) xor g(u - x) each.
Rt = 2.0 sqrt
Lim = Hi + 2
Ij = 0 to Lim
Jm = Lim / Rt floor
Jj = 0 to Jm
Ir = Ij reshape (Lim + 1) 1
Jr = Jj * Rt reshape 1 (Jm + 1)
Gr = Ir + Jr
Fg = Gr reshape ((Lim + 1) * (Jm + 1))
Kp = Fg at most Lim indices
Bp = Fg Kp sort
Nb = Bp len
St = array shape Nb fill 0.0
Vs = array shape Nb fill 0
S = 1
Seen = array shape (8 * Nb) fill 0
Ka = (Bp less Lo integer) sum
Kz = (Bp less Hi integer) sum
Nr = Kz - Ka + 1
Q1 = array shape Nr fill 0.0
Q2 = array shape Nr fill 0.0
Q3 = array shape Nr fill 0.0
Q4 = array shape Nr fill 0.0
Q5 = array shape Nr fill 0.0
Q6 = array shape Nr fill 0.0
Q7 = array shape Nr fill 0.0
Ep = 1.0 / 1000000000000.0
for Pass in 1 to 2
  Start = 1
  Stop = Nb - 2
  if Pass equal 2
    Start = Ka
    Stop = Kz
  end
  for K in Start to Stop
    Mid = (Bp K + Bp (K + 1)) / 2.0
    M1 = 0.0
    D1 = 0.0
    M2 = 0.0
    D2 = 0.0
    for Move in 1 to 2
      U = Mid - 1.0
      if Move equal 2
        U = Mid - Rt
      end
      if U at least 0.0
        A = 0
        B = S
        for A less B
          C = (A + B) // 2
          if St C less U
            A = C + 1
          else
            B = C
          end
        end
        Last = A - 1 max 0
        I = 1
        J = Last
        Ix = 0
        Iy = Last
        Left = 0.0
        Velocity = 0.0
        Measure = 0.0
        Slope = 0.0
        for Left less U
          Forward = U
          if I at most Last
            Forward = St I
          end
          Reverse = U
          if J at least 1
            Reverse = U - St J
          end
          Right = U
          V = 1.0
          if Forward at most Reverse
            if Forward less U
              Right = Forward
              V = 0.0
              I += 1
            end
          else
            Right = Reverse
            J -= 1
          end
          if Right - Left greater Ep
            X = (Left + Right) / 2.0
            for Ix + 1 less S
              if St (Ix + 1) greater X
                break
              end
              Ix += 1
            end
            for Iy greater 0
              if St Iy at most (U - X)
                break
              end
              Iy -= 1
            end
            G = Vs Ix bxor Vs Iy
            if Pass equal 1
              Seen G = K + 1
            else
              if G equal 0
                Measure += Right - Left
                Slope += V - Velocity
              end
            end
          end
          Left = Right
          Velocity = V
        end
        if Move equal 1
          M1 = Measure
          D1 = Slope
        else
          M2 = Measure
          D2 = Slope
        end
      end
    end
    if Pass equal 1
      G = 0
      for Seen G equal (K + 1)
        G += 1
      end
      if G not equal (Vs (S - 1))
        St S = Bp K
        Vs S = G
        S += 1
      end
    else
      Q1 (K - Ka) = M1
      Q2 (K - Ka) = D1
      Q3 (K - Ka) = M2
      Q4 (K - Ka) = D2
      Q5 (K - Ka) = Mid
      Q6 (K - Ka) = Bp K max (Lo * 1.0)
      Q7 (K - Ka) = Bp (K + 1)
      Q7 (K - Ka) = Q7 (K - Ka) min (Hi * 1.0)
    end
  end
end
Fr = ((0 to 40) / 40.0) reshape 1 41
Ac = Q6 reshape Nr 1
Wd = Q7 - Q6 reshape Nr 1
Lg = Ac + Wd * Fr
Dl = Lg - (Q5 reshape Nr 1)
SampleA = (Q1 reshape Nr 1)
SampleA = SampleA + (Q2 reshape Nr 1) * Dl
SampleB = (Q3 reshape Nr 1)
SampleB = SampleB + (Q4 reshape Nr 1) * Dl
Ev = Lg / 2.0 * (SampleA / (Lg - 1.0))
Ev += Lg / 2.0 * (SampleB / (Lg - Rt))
Q8 = Ev max axis 1
Top = Q8 max
Cn = (Q8 at least (Top - 0.05)) indices
Ra = Q6 Cn
Rb = Q7 Cn
Rc = Q5 Cn
R1 = Q1 Cn
R2 = Q2 Cn
R3 = Q3 Cn
R4 = Q4 Cn
Lx = Ra
Hx = Rb
for It in 1 to 80
  Ma = Lx + (Hx - Lx) / 3.0
  Mb = Hx - (Hx - Lx) / 3.0
  Wa = (R1 + R2 * (Ma - Rc))
  Wa = Wa / (Ma - 1.0)
  Xa = (R3 + R4 * (Ma - Rc)) / (Ma - Rt)
  E1 = Ma / 2.0 * (Wa + Xa)
  Wb = (R1 + R2 * (Mb - Rc))
  Wb = Wb / (Mb - 1.0)
  Xb = (R3 + R4 * (Mb - Rc)) / (Mb - Rt)
  E2 = Mb / 2.0 * (Wb + Xb)
  Lx = E1 less E2 choose Ma Lx
  Hx = E1 less E2 choose Hx Mb
end
Lf = (Lx + Hx) / 2.0
Wf = (R1 + R2 * (Lf - Rc)) / (Lf - 1.0)
Xf = (R3 + R4 * (Lf - Rc)) / (Lf - Rt)
Ef = Lf / 2.0 * (Wf + Xf)
Best = Ef max max Top
Answer = Best text ".8f"
Answer print
