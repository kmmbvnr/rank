rem Idempotents
rem https://projecteuler.net/problem=407

use numbers
use sequences
use io
use cli

arg N integer = 10000000

rem a^2 = a mod n has an idempotent
rem e = 0 mod v, 1 mod u for every
rem coprime split n = u v, and 1 - e.
rem The largest is n + 1 minus the
rem least one above 1. Split with
rem u < v, so u <= sqrt n, and take
rem e = v / v mod u from a small
rem inverse table of u.
Big = 2 * N + 5
Root = N isqrt
Phi = 0 to Root copy
for P in primes to Root
  Sl = P to Root by P
  Phi Sl -= Phi Sl // P
end
Least = array shape (N + 1) fill Big
for U in 2 to Root
  Hi = N // U
  if Hi greater U
    Rs = 0 to U - 1 copy
    E = Phi U - 1
    X = Rs E U powmod
    Pr = X * Rs mod U
    Inv = Pr equal 1 choose X 0
    Vs = (U + 1 to Hi) copy
    Iv = (Inv (Vs mod U)) copy
    Ev = Vs * Iv copy
    Ns = U * Vs
    Cand = (Ev min (Ns + 1 - Ev)) copy
    Cand = Iv greater 0 choose Cand Big
    Cand = Cand copy
    From = U * (U + 1)
    Sl = (From to N by U) copy
    Cur = Least Sl copy
    Least Sl = Cur min Cand
    rem Research: discard the array result.
    Last = U
  end
end
Ns = 2 to N copy
Ms = Least (2 to N)
Mk = Ms less Big
Ms = Mk choose (Ns + 1 - Ms) 1
Answer = Ms sum
Answer print
