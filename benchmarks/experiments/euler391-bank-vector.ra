rem Hopping Game
rem https://projecteuler.net/problem=391

use numbers
use io
use cli

arg Limit integer = 1000

rem Rows map residues zero through N.
Stride = Limit + 1
Rows = Limit + 2
Size = Stride * Rows
Data = array shape (2 * Size) fill 0
A = 0
B = Size
for V in 0 to Limit
  Data (A + V) = V
  Data (B + V) = V
end
Answer = 0
for N in 1 to Limit
  Step = N + 1
  for S in 1 to Step
    for M in 1 to S
      Add = S - M + 1
      Prev = (M - 1) * Stride
      Cur = M * Stride
      Ix = 0 to N
      X = Data (B + Prev + Ix) + Add
      X (X at least Step) = 0
      Data (B + Cur + Ix) = Data (A + Prev + X)
    end
    Row = S * Stride
    Val = Data (B + Row)
    Same = true
    for V in 1 to N
      if Data (B + Row + V) not equal Val
        Same = false
        break
      end
    end
    if Same
      Answer += Val ** 3
      break
    end
    Tmp = A
    A = B
    B = Tmp
  end
end
Answer print
