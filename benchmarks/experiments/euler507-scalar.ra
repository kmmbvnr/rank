rem Shortest Lattice Vector
rem https://projecteuler.net/problem=507

use numbers
use sequences
use io
use cli

arg N integer = 20000000
arg Lc integer = 20

rem Lattice n uses Tribonacci terms
rem 12n-11 .. 12n: v = (r1 - r2, r3 +
rem r4, r5 r6), w the same from r7.
rem Reduce like Gauss in the L1 norm:
rem w - t v is convex in t, least at
rem the median of w_i / v_i weighted
rem by |v_i|; try its floor and the
rem next integer. All lattices of a
rem chunk at once.
Md = 10000000
fun A mm3 B
  rem Product of two 3 x 3 matrices,
  rem each a row of 9.
  Ar = A reshape 3 3 1
  Br = B reshape 1 3 3
  C = Ar * Br sum axis 1
  return C reshape 9 mod Md
end
rem Each lattice owns six scalar registers;
rem the active set needs no array copies.
fun X1 Y1 Z1 X2 Y2 Z2 shortest
  for true
    La = X1 abs + (Y1 abs) + (Z1 abs)
    Lb = X2 abs + (Y2 abs) + (Z2 abs)
    if Lb less La
      Tx = X1
      X1 = X2
      X2 = Tx
      Tx = Y1
      Y1 = Y2
      Y2 = Tx
      Tx = Z1
      Z1 = Z2
      Z2 = Tx
      Tx = La
      La = Lb
      Lb = Tx
    end
    W1 = X1 abs
    W2 = Y1 abs
    W3 = Z1 abs
    D1 = X1 equal 0 choose 1 X1
    D2 = Y1 equal 0 choose 1 Y1
    D3 = Z1 equal 0 choose 1 Z1
    Tt = W1 + W2 + W3
    Tm = Z2 // D3
    if 2 * W1 at least Tt
      Tm = X2 // D1
    elif 2 * W2 at least Tt
      Tm = Y2 // D2
    elif 2 * W3 less Tt
      Q1 = X2 * 1.0 / D1
      Q2 = Y2 * 1.0 / D2
      Q3 = Z2 * 1.0 / D3
      Mid = Q1 at least (Q2 min Q3)
      Mid = Mid and Q1 at most (Q2 max Q3)
      if Mid
        Tm = X2 // D1
      else
        Mid = Q2 at least (Q1 min Q3)
        Mid = Mid and Q2 at most (Q1 max Q3)
        if Mid
          Tm = Y2 // D2
        end
      end
    end
    Le = X2 - Tm * X1 abs
    Le += Y2 - Tm * Y1 abs
    Le += Z2 - Tm * Z1 abs
    T2 = Tm + 1
    Ld = X2 - T2 * X1 abs
    Ld += Y2 - T2 * Y1 abs
    Ld += Z2 - T2 * Z1 abs
    Tb = Ld less Le choose T2 Tm
    Lm = Ld min Le
    if Lm at least Lb
      if La equal 0
        return Lb
      end
      return La
    end
    X2 -= Tb * X1
    Y2 -= Tb * Y1
    Z2 -= Tb * Z1
  end
  return 0
end
rem Step matrix A; M = A^12 jumps one
rem lattice ahead.
A = array 0 1 0 0 0 1 1 1 1
M = array 1 0 0 0 1 0 0 0 1
for I in 1 to 12
  M = M mm3 A
end
Ch = 2 ** Lc
S0 = array 0 1 1
Answer = 0
for C0 in 0 till N by Ch
  Nc = Ch min (N - C0)
  rem States of the chunk by doubling:
  rem append M^(2^k) times the block.
  Sx = array (S0 0)
  Sy = array (S0 1)
  Sz = array (S0 2)
  Mp = M
  for K in 1 to Lc
    Nx = Mp 0 * Sx + Mp 1 * Sy
    Nx = (Nx + Mp 2 * Sz) mod Md
    Ny = Mp 3 * Sx + Mp 4 * Sy
    Ny = (Ny + Mp 5 * Sz) mod Md
    Nz = Mp 6 * Sx + Mp 7 * Sy
    Nz = (Nz + Mp 8 * Sz) mod Md
    Sx = concat Sx Nx
    Sy = concat Sy Ny
    Sz = concat Sz Nz
    Mp = Mp mm3 Mp
  end
  rem Mp = M^(2^Lc) starts the next.
  M3 = Mp reshape 3 3
  S0 = M3 * S0 sum axis 1 mod Md
  R1 = Sx (0 till Nc)
  R2 = Sy (0 till Nc)
  R3 = Sz (0 till Nc)
  R4 = (R1 + R2 + R3) mod Md
  R5 = (R2 + R3 + R4) mod Md
  R6 = (R3 + R4 + R5) mod Md
  R7 = (R4 + R5 + R6) mod Md
  R8 = (R5 + R6 + R7) mod Md
  R9 = (R6 + R7 + R8) mod Md
  Ra = (R7 + R8 + R9) mod Md
  Rb = (R8 + R9 + Ra) mod Md
  Rc = (R9 + Ra + Rb) mod Md
  Ax = R1 - R2
  Ay = R3 + R4
  Az = R5 * R6
  Bx = R7 - R8
  By = R9 + Ra
  Bz = Rb * Rc
  for I in 0 till Nc
    X1 = Ax I
    Y1 = Ay I
    Z1 = Az I
    X2 = Bx I
    Y2 = By I
    Z2 = Bz I
    Answer += X1 Y1 Z1 X2 Y2 Z2 shortest
  end
end
Answer print
