rem Prime Generating Integers
rem https://projecteuler.net/problem=357

use numbers
use sequences
use io
use cli

arg Limit integer = 10 ** 8

Sieve = Limit + 1 primesieve

fun N good
  if N equal 1
    return true
  end
  if N mod 2 equal 1 or N mod 4 equal 0
    return false
  end
  if 2 + N // 2 not in Sieve
    return false
  end
  Ds = N divisors array
  Tests = Ds + N // Ds
  Checks = Tests in Sieve
  return Checks all
end

Answer = 0
for P in primes to (Limit + 1)
  N = P - 1
  if N good
    Answer += N
  end
end
Answer print
