fun N pairs M
  Period = 6 * M
  Whole = N // Period
  Rest = N mod Period
  Counts = array shape M fill 0
  B = array -1 3 6 7 13 14
  C = array 0 1 2 2 5 5
  Batch = 32768
  for Start in 0 till M by Batch
    End = (Start + Batch) min M
    T = Start till End array
    Base = (9 * T * T) mod M
    for R in 0 till 6
      Slope = B R
      Offset = C R
      Keys = (Base + Slope * T + Offset)
      Keys = Keys mod M
      if Whole greater 0
        Counts Keys += Whole .accumulate
      end
      Length = (Rest - R) // 6 + 1 - Start
      Length = Length min (End - Start)
      if Length greater 0
        Part = Keys take Length
        Counts Part += 1 .accumulate
      end
    end
  end
  Answer = 0
  for Count in Counts
    Answer += Count * (Count - 1) // 2
  end
  return Answer
end
