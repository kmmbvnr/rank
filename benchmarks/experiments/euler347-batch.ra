rem Largest Integer with Two Primes
rem https://projecteuler.net/problem=347

use numbers
use algo
use sequences
use io
use cli

arg Limit integer = 10000000

fun Limit twoprimes
  Ps = primes to Limit // 2 array
  Cs = concat (array 0) (Ps scan +)
  Cs = Cs copy
  Small = Ps (Ps at most (Limit isqrt) indices)
  High = Ps upperindex (Limit // Small)
  Low = Ps upperindex (Limit // Small // Small)
  Low = Low max (1 to (Small len))
  Sum = 0
  for I in 0 till (Small len)
    P = Ps I
    if P * P greater Limit
      break
    end
    Last = High I
    End = Low I
    Sum += P * (Cs Last - Cs End)
    for J in I + 1 till End
      Q = Ps J
      if P * Q greater Limit
        break
      end
      Best = 0
      Power = P
      for Power * Q at most Limit
        Value = Power * Q
        for Value * Q at most Limit
          Value *= Q
        end
        Best = Best max Value
        Power *= P
      end
      Sum += Best
    end
  end
  return Sum
end

Answer = Limit twoprimes
Answer print
