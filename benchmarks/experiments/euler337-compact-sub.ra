rem Totient Stairstep Sequences
rem https://projecteuler.net/problem=337

use bits
use io
use cli

arg Limit integer = 20000000

Mod = 100000000
Phi = 0 to Limit array
Size = Limit // 2 + 2
Bit = array shape Size fill 0
if Limit greater 0
  Phi 1 = 0
end
for N in 2 to Limit
  if Phi N equal N
    for J in N to Limit by N
      Phi J -= Phi J // N
    end
  end
  T = Phi N
  V = 0
  if N equal 6
    V = 1
  else
    Q = T // 2
    for Q greater 0
      V += Bit Q
      Q -= Q band (0 - Q)
    end
    V -= Phi T
    V = V mod Mod
  end
  I = T // 2 + 1
  for I less Size
    Bit I += V
    if Bit I at least Mod
      Bit I -= Mod
    end
    I += I band (0 - I)
  end
  Phi N = (Phi (N - 1) + V) mod Mod
end
Phi Limit print
