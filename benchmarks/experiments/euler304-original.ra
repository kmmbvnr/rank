rem Primonacci
rem https://projecteuler.net/problem=304

use bits
use sequences
use io
use cli

arg Start integer = 10 ** 14
arg Count integer = 100000
arg Mod integer = 1234567891011

Pr = primes from Start take Count array
F0 = Pr * 0
F1 = F0 + 1
Text = Pr max binary
Bits = 0 till (Text len) array
for Bit in Bits reverse
  Twice' = 2 * F1 - F0
  Even = F0 * Twice mod Mod
  Odd = (F0 * F0 + F1 * F1) mod Mod
  Shifted' = Pr shr Bit
  Set = (Shifted band 1) equal 1
  F0 = Set choose Odd Even
  Next' = (Even + Odd) mod Mod
  F1 = Set choose Next Odd
end
Answer = F0 sum mod Mod
Answer print
