rem Sum of Digits - Experience 13
rem https://projecteuler.net/problem=377

use linalg
use io
use cli

arg Terms integer = 17

Mod = 10 ** 9
Cnt = array shape 9 fill 0
Sum = array shape 9 fill 0
Cnt 0 = 1
for N in 1 to 8
  for D in 1 to 9
    if D at most N
      Cnt N += Cnt (N - D)
      Sum N += 10 * (Sum (N - D))
      Sum N += D * (Cnt (N - D))
    end
  end
  Cnt N = Cnt N mod Mod
  Sum N = Sum N mod Mod
end
Mat = array shape 18 18 fill 0
for D in 1 to 9
  Mat 0 (D - 1) += 10
  Mat 0 (D + 8) += D
  Mat 9 (D + 8) = 1
end
for I in 1 to 8
  Mat I (I - 1) = 1
  Mat (I + 9) (I + 8) = 1
end
State = array shape 18 fill 0
for I in 0 to 8
  State I = Sum (8 - I)
  State (I + 9) = Cnt (8 - I)
end
Answer = 0
Power = 13
for I in 1 to Terms
  P = Mat matpow (Power - 8) mod Mod
  V = P matmul State mod Mod
  Answer += V 0
  Answer = Answer mod Mod
  Power *= 13
end
Answer print
