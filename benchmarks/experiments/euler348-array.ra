rem Sum of a Square and a Cube
rem https://projecteuler.net/problem=348

use sequences
use numbers
use algo
use io
use cli

arg Want integer = 5

fun Prefix mirror Odd
  Tail = Prefix
  if Odd equal 1
    Tail //= 10
  end
  Value = Prefix
  for Tail greater 0
    Value = Value * 10 + Tail mod 10
    Tail //= 10
  end
  return Value
end

fun N reps
  Bs = 2 to (N isqrt)
  Cubes = Bs * Bs * Bs
  Rest = N - (Cubes till greater N - 4)
  Roots = Rest isqrt
  return Roots * Roots equal Rest count
end

fun Want solve
  Hits = new queue
  Len = 1
  for Hits len less Want
    Odd = Len mod 2
    Half = (Len + 1) // 2
    From = 1
    if Len greater 1
      From = 10 ** (Half - 1)
    end
    To = 10 ** Half - 1
    for Prefix in From to To
      Value = Prefix mirror Odd
      if Value at least 12
        if Value reps equal 4
          Hits push Value
          if Hits len equal Want
            break
          end
        end
      end
    end
    Len += 1
  end
  return Hits sum
end

Answer = Want solve
Answer print
