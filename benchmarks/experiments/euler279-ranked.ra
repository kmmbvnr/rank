rem Research: canonical primitive 120-degree triples also produce
rem two non-equilateral 60-degree triangles.
use numbers
use sequences
use io
use cli
arg Limit integer = 100000000
Total = Limit // 3
Top = (Limit // 2) isqrt
for M in 2 to Top
  Hi = (Limit // (2 * M) - M) min (M - 1)
  Ns = 1 to Hi array
  Counts' = M contribution Ns rank 0 0
  Total += Counts sum
end
Answer = Total
Answer print

fun M contribution N
  if M gcd N not equal 1
    return 0
  end
  Count = 0
  if (M - N) mod 2 equal 1
    Count += Limit // (2 * M * (M + N))
  end
  if (M - N) mod 3 not equal 0
    Count += Limit // ((2 * M + N) * (M + N))
    Count += Limit // (3 * M * (M + N))
    Count += Limit // ((2 * M + N) * (M + 2 * N))
  end
  return Count
end
