  "workerSource": "// Research variants only: the demo and production interpreter are unchanged.\n// Build: npx tsc -b tsconfig.build.json\n// Run: node benchmarks/euler110-reciprocals.mjs 4000000 --trim --lazy --diag\n// Other controls: --reference, --trace. Omit --diag/--trace for timings.\nimport {readFileSync} from 'node:fs';\nimport {Interpreter,RuntimeDiagnostics} from '../packages/interpreter/out/index.js';\nconst target=process.argv[2]??'4000000',diag=process.argv.includes('--diag'),trace=process.argv.includes('--trace');\nlet source=readFileSync(new URL('../demos/euler/110_reciprocals2.ra', import.meta.url),'utf8').replace('Target integer = 4000000',`Target integer = ${target}`);\nif(process.argv.includes('--trim')) source=source.replace('Cols = Exp reshape 1 60\\n','').replace('  Rows = N len','  if N len equal 0\\n    break\\n  end\\n  Exp = 1 to (Top max) array\\n  Cols = Exp reshape 1 (Exp len)\\n  Rows = N len');\nif(process.argv.includes('--lazy')) source=source.replace('  Big =','  Big\\' =').replace('  Next =','  Next\\' =');\nif(trace) source=source.replace('  Rows = N len','  P print\\n  Rows = N len\\n  Rows print').replace('  Cnt = Next filter Keep array','  Cnt = Next filter Keep array\\n  Best print');\nconst d=new RuntimeDiagnostics(),start=performance.now();\nconst r=new Interpreter(line=>{process.stderr.write(JSON.stringify({ms:performance.now()-start,out:line})+'\\n')},{compilation:!process.argv.includes('--reference')});\ntry{\n if(diag)d.run(()=>r.execute(source));else r.execute(source);\n console.log(JSON.stringify({target,ms:performance.now()-start,rss:process.resourceUsage().maxRSS/1024,answer:String(r.variables.get('Answer')),diagnostics:diag?d:undefined}));\n}finally{r.dispose()}\n",
