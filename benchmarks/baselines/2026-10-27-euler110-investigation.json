  "oracleSource": "import {spawnSync} from 'node:child_process';\nimport {writeFileSync} from 'node:fs';\nconst primes=[2n,3n,5n,7n,11n,13n,17n,19n,23n,29n,31n,37n,41n,43n,47n,53n];\nfunction oracle(target){\n const need=2n*BigInt(target)-1n;let best=1n,d=1n,k=0,visits=0;\n while(d<=need){best*=primes[k++];d*=3n;}\n function visit(i,n,count,cap){visits++;if(count>need){if(n<best)best=n;return;}if(i>=primes.length)return;\n  let next=n;for(let e=1;e<=cap;e++){next*=primes[i];if(next>=best)break;visit(i+1,next,count*BigInt(2*e+1),e);}\n }\n visit(0,1n,1n,64);return {answer:String(best),visits};\n}\nconst results=[];\nfor(const target of [1,2,3,4,5,10,20,50,100,1000,10000,4000000]){\n const expected=oracle(target);\n for(const args of [['--trim'],['--trim','--lazy'],['--trim','--reference']]){\n  const r=spawnSync(process.execPath,['/tmp/rank110-investigate.mjs',String(target),...args],{encoding:'utf8',timeout:20000});if(r.status!==0)throw Error(r.stderr);\n  const x=JSON.parse(r.stdout);if(x.answer!==expected.answer)throw Error(JSON.stringify({x,expected}));results.push({target,args,...expected});\n }\n}\nwriteFileSync('/tmp/rank110-verification.json',JSON.stringify(results,null,2));console.log(`${results.length} oracle comparisons passed`);\n"
