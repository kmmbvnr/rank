    "source": "import assert from 'node:assert/strict';\nfunction solve(limit, tail) {\n const half=Math.floor(limit/2), stack=[[0,1,1,1]];\n let answer=0,nodes=0,batches=0,skipped=0,maxTop=1;\n while(stack.length) {\n  let [a,b,c,d]=stack.pop();\n  while(b*d<=half && 100*a<b) {\n   nodes++;\n   if(tail && (b+d)*d>half) {\n    const end=Math.floor(half/b), threshold=Math.floor(50/(b-100*a));\n    const start=d+Math.max(0,Math.floor((threshold-d)/b)+1)*b;\n    const count=Math.max(0,Math.floor((end-start)/b)+1);\n    answer+=count;batches++;skipped+=Math.floor((end-d)/b)+1;break;\n   }\n   if((a*d+b*c)*100<2*b*d) answer++;\n   const e=a+c,f=b+d;\n   if(f*d<=half) stack.push([e,f,c,d]);\n   c=e;d=f;maxTop=Math.max(maxTop,stack.length);\n  }\n }\n return {answer,nodes,batches,skipped,maxTop};\n}\nfor(const limit of [120,200000,1000000,100000000]){\n const results=[];\n for(const tail of [false,true]){ const start=performance.now();results.push({tail,...solve(limit,tail),ms:performance.now()-start}); }\n assert.equal(results[0].answer,results[1].answer); console.log(JSON.stringify({limit,results}));\n}\n"
  }
