    "smallOracleSource": "import assert from 'node:assert/strict';\nimport { readFileSync } from 'node:fs';\nimport { resolve,dirname } from 'node:path';\nconst original=readFileSync('/tmp/rank196-delivery/demos/euler/210_obtuse.ra','utf8');\nconst optimized=original.replace('  Gen += (Q - Xs * Xs) isqrt sum', \"  Part' = (Q - Xs * Xs) isqrt sum\\n  Gen += Part\");\nfunction oracle(r){let n=0,c=r/4;for(let x=-r;x<=r;x++)for(let y=-r+Math.abs(x);y<=r-Math.abs(x);y++){\n if(x===y)continue;\n if(c*(x+y)<0 || x*x+y*y-c*(x+y)<0 || 2*c*c-c*(x+y)<0)n++;\n}return String(n);}\nconst results=[];\nfor(const prototype of [false]){\n const {Interpreter}=await import(prototype?'/tmp/rank210-runtime/index.js':'/tmp/rank195-isolated/packages/interpreter/out/index.js');\n for(const compilation of [false,true]){\n  for(let radius=8;radius<=160;radius+=8){\n   const r=new Interpreter(()=>{}, {compilation});\n   try{\n   const src=(prototype?optimized:original).replace('arg R integer = 1000000000',`arg R integer = ${radius}`).replace(/arg Chunk integer = \\d+/,'arg Chunk integer = 3');\n   r.execute(src);const answer=String(r.variables.get('Answer'));assert.equal(answer,oracle(radius));\n   }finally{r.dispose();}\n  }\n  const file='/tmp/rank196-delivery/demos/euler/210_obtuse_test.ra';\n  const fixture=new Interpreter(()=>{}, {compilation,testing:true,sourceId:file,loadModule(specifier,from){const id=resolve(dirname(from??file),specifier+'.ra');return {id,source:specifier==='210_obtuse'?(prototype?optimized:original):readFileSync(id,'utf8')};}});\n  try{fixture.execute(readFileSync(file,'utf8'));assert.equal(fixture.testResults.length,1);assert(fixture.testResults.every(x=>x.passed));results.push({prototype,compilation,smallOracleChecks:20,fixture:fixture.testResults});}finally{fixture.dispose();}\n }\n}\nconsole.log(JSON.stringify(results));\n",
