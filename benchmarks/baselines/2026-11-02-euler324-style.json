  "runnerSource": "import {readFileSync} from 'node:fs';\nimport {spawnSync} from 'node:child_process';\nimport {cpus} from 'node:os';\nconst root=process.env.RANK_ROOT;\nif(!root)throw Error('RANK_ROOT');\nif(process.argv[2]==='worker'){\n const {Interpreter}=await import(`${root}/packages/interpreter/out/index.js`);\n const [mode,path]=process.argv.slice(3),source=readFileSync(path,'utf8');\n const r=new Interpreter(()=>{},{compilation:mode==='compiled'}),t=performance.now(),cpu=process.cpuUsage();\n try{r.execute(source);console.log(JSON.stringify({mode,ms:performance.now()-t,cpuMs:(process.cpuUsage(cpu).user+process.cpuUsage(cpu).system)/1000,rssMiB:process.resourceUsage().maxRSS/1024,answer:String(r.variables.get('Answer'))}));}finally{r.dispose()}\n}else{\n const paths=process.argv.slice(2),cases=[['compiled','before',paths[0]],['compiled','after',paths[1]]],records=[];\n for(let trial=0;trial<7;trial++)for(let j=0;j<cases.length;j++){\n  const [mode,version,path]=cases[(trial+j)%cases.length];\n  const p=spawnSync(process.execPath,[process.argv[1],'worker',mode,path],{encoding:'utf8',timeout:10000});\n  if(p.status!==0)throw Error(p.error?.message??p.stderr);\n  const r={trial,version,...JSON.parse(p.stdout)};\n  if(r.answer!=='96972774')throw Error('wrong answer');records.push(r);\n }\n console.log(JSON.stringify({node:process.version,cpu:cpus()[0]?.model,method:'Seven fresh processes per case, rotating serial order; full default; parse/analysis/compile/execution included; peak process RSS',records},null,2));\n}\n",
