  "oracleSource": "import json\nfrom fractions import Fraction\nlevels=[set(),{Fraction(1)}];union=set(levels[1]);out=[1]\nfor n in range(2,11):\n v=set()\n for i in range(1,n):\n  for a in levels[i]:\n   for b in levels[n-i]: v.add(a+b);v.add(a*b/(a+b))\n levels.append(v);union|=v;out.append(len(union))\nopen('/tmp/rank155-oracle.json','w').write(json.dumps(out));print(out)\n",
  "checkSource": "import assert from 'node:assert/strict';\nimport {readFileSync} from 'node:fs';\nimport {Interpreter} from '/Users/kmmbvnr/Workspace/Playground/09-Rank/packages/interpreter/out/index.js';\nconst oracle=JSON.parse(readFileSync('/tmp/rank155-oracle.json','utf8'));\nlet checks=0;\nfor(const compilation of [false,true])for(const v of ['base','rec','recsort'])for(let n=1;n<=10;n++){\n const path=v==='base'?'/Users/kmmbvnr/Workspace/Playground/09-Rank/demos/euler/155_capacitors.ra':`/tmp/rank155-${v}.ra`;\n const r=new Interpreter(()=>{},{compilation});\n try{r.execute(readFileSync(path,'utf8').replace('Count integer = 18',`Count integer = ${n}`));assert.equal(r.variables.get('Answer'),BigInt(oracle[n-1]));checks++;}finally{r.dispose();}\n}\nconsole.log(JSON.stringify({checks,oracle}));\n",
