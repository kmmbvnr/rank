rem Reuse lengths of smaller starting values in a dense array.
use io
use cli

option Limit integer = 1000000

Lengths = array shape Limit fill 0
Lengths 1 = 1
for Start in 2 till Limit
  N = Start
  Steps = 0
  for N at least Start
    if N mod 2 equal 0
      N = N // 2
    else
      N = 3 * N + 1
    end
    Steps += 1
  end
  Lengths Start = Steps + Lengths N
end

Answer = Lengths max .index
Answer print
