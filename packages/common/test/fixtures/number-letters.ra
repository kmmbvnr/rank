rem Number Letter Counts
rem https://projecteuler.net/problem=17
rem Count letters in British English names
rem from one through Limit

use io
use cli
use sequences

option Limit integer = 1000

Small = array shape 10
  ""
  "one"
  "two"
  "three"
  "four"
  "five"
  "six"
  "seven"
  "eight"
  "nine"
end len rank 0 copy

Teens = array shape 10
  "ten"
  "eleven"
  "twelve"
  "thirteen"
  "fourteen"
  "fifteen"
  "sixteen"
  "seventeen"
  "eighteen"
  "nineteen"
end len rank 0 copy

Tens = array shape 10
  ""
  ""
  "twenty"
  "thirty"
  "forty"
  "fifty"
  "sixty"
  "seventy"
  "eighty"
  "ninety"
end len rank 0 copy

Numbers' = 1 to Limit
Counts' = Numbers letters rank 0
Counts sum print

fun Value letters
  if Value equal 1000
    return "one" len + ("thousand" len)
  end

  Count = 0
  N = Value
  if N at least 100
    unpack D N = N divmod 100
    Count += Small D + ("hundred" len)
    if N greater 0
      Count += "and" len
    end
  end

  if N at least 20
    unpack D N = N divmod 10
    Count += Tens D
  elif N at least 10
    return Count + Teens (N - 10)
  end

  return Count + Small N
end
