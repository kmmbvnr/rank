{
    "name": "@arrrank/common",
    "description": "Shared Rank application runtime",
    "version": "0.0.1",
    "license": "MIT",
    "type": "module",
    "engines": {
        "node": ">=22.12.0",
        "npm": ">=10.2.3"
    },
    "main": "./out/index.js",
    "types": "./out/index.d.ts",
    "files": [
        "out",
        "src"
    ],
    "scripts": {
        "clean": "shx rm -fr *.tsbuildinfo out",
        "build": "echo 'No build step'",
        "test": "vitest run"
    },
    "dependencies": {
        "@arrrank/interpreter": "0.0.1",
        "@arrrank/language": "0.0.1",
        "string-width": "^7.2.0",
        "strip-ansi": "^7.1.0"
    },
    "devDependencies": {
        "vitest": "~3.2.7"
    },
    "exports": {
        ".": {
            "types": "./out/index.d.ts",
            "default": "./out/index.js"
        },
        "./*": {
            "types": "./out/*.d.ts",
            "default": "./out/*.js"
        }
    }
}
