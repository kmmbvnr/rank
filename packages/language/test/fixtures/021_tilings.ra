rem CSES 2181: Counting Tilings
rem https://cses.fi/problemset/task/2181

use bits
use io

Height = stdin .integer
Width = stdin .integer
Height counting_tilings Width print


rem Carry occupied cells across columns.
fun Height counting_tilings Width
  Modulus = 1000000007
  States = 1 shl Height
  Current = array shape States fill 0
  Current 0 = 1

  for Column in 1 to Width
    Next = array shape States fill 0

    for Mask in 0 till States
      Ways = Current Mask
      if Ways greater 0
        0 place 0
      end
    end

    Current = Next
  end

  return Current 0

  rem Fill a column and emit its mask.
  fun Row place NextMask
    if Row equal Height
      Next NextMask += Ways
      Next NextMask mod= Modulus
      return 0
    end

    NextRow = Row + 1
    if Mask bit Row
      return NextRow place NextMask
    end

    Bit = 1 shl Row
    NewMask = NextMask bor Bit
    NextRow place NewMask

    if NextRow less Height
      if Mask bit NextRow equal false
        Row + 2 place NextMask
      end
    end
    return 0
  end
end
