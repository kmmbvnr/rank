rem Regular Expression Matching
rem Full match of text against a pattern
rem containing '.' and '*'

use algo

rem Build a table where index i j says whether
rem the first i characters match the first j
rem pattern characters.
fun match Text Pattern
  Index = new index
  N = Text len
  M = Pattern len

  Index 0 0 = true

  rem A starred element can match empty text.
  for PatternSymbol j in Pattern
    if j at least 1 and PatternSymbol equal "*"
      Column = j + 1
      Previous = j - 1
      Index 0 Column = Index 0 Previous default false
    end
  end

  for TextSymbol i in Text
    for PatternSymbol j in Pattern
      Row = i + 1
      Column = j + 1

      if PatternSymbol equal "*"
        Previous = Column - 2
        Repeated = Pattern Previous
        Same = Repeated equal "." or Repeated equal TextSymbol
        Zero = Index Row Previous default false
        More = Same and Index i Column default false
        Index Row Column = Zero or More
      else
        Same = PatternSymbol equal "." or PatternSymbol equal TextSymbol
        Previous = Column - 1
        Prefix = Index i Previous default false
        Index Row Column = Same and Prefix
      end
    end
  end

  return Index N M default false
end
