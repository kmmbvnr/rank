{
    "name": "@arrrank/cli",
    "description": "Command-line interface for Rank",
    "version": "0.0.1",
    "license": "MIT",
    "type": "module",
    "engines": {
        "node": ">=22.12.0",
        "npm": ">=10.2.3"
    },
    "files": [
        "bin",
        "out",
        "src",
        "native/*.cc",
        "native/binding.gyp",
        "scripts/build-sqlite-interrupt.mjs"
    ],
    "bin": {
        "rank": "./bin/cli.js"
    },
    "scripts": {
        "clean": "shx rm -fr *.tsbuildinfo out native/build",
        "build": "node scripts/build-sqlite-interrupt.mjs",
        "build:clean": "npm run clean && npm run build",
        "test": "node --test test/*.test.mjs",
        "install": "node scripts/build-sqlite-interrupt.mjs"
    },
    "dependencies": {
        "better-sqlite3": "12.8.0",
        "chalk": "~5.6.2",
        "commander": "~15.0.0",
        "@arrrank/common": "0.0.1",
        "@arrrank/interpreter": "0.0.1",
        "@arrrank/language": "0.0.1",
        "sharp": "~0.35.4",
        "string-width": "^7.2.0"
    },
    "devDependencies": {
        "@xterm/headless": "^5.5.0"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/kmmbvnr/rank.git",
        "directory": "packages/cli"
    }
}
