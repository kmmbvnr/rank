rem Hypocycloid and Lattice Points
rem https://projecteuler.net/problem=450

use numbers
use sequences
use io
use cli

arg N integer = 1000000

rem With R = g p and r = g q the point
rem is g (e z^q + q z^-e) for a point z
rem of the unit circle with rational
rem coordinates, e = p - q. The four
rem trivial z give 4 R - 2 r per pair
rem less a correction by cos(pi RR / 2)
rem summed with mu. The other z come
rem from primitive Pythagorean triples
rem (a, b, c), c <= sqrt N: the point
rem for angle powers rr and RR - rr is
rem reduced by a common factor, and
rem every multiple that fits adds its
rem coordinates.
Root = N isqrt
Side = Root isqrt
Values = 1 to Side copy
U = Values reshape Side 1
V = Values reshape 1 Side
SquaredU = U * U
SquaredV = V * V
Hyp = SquaredU + SquaredV
Common = U gcd V
Coprime = Common equal 1
Valid = V less U
Within = Hyp at most Root
Valid and= Within
Valid and= Coprime
Parity = (U + V) mod 2
Odd = Parity equal 1
Valid and= Odd
Cells = Side * Side
FlatValid = Valid reshape Cells
Real = SquaredU - SquaredV
Imag = 2 * U * V
FlatReal = Real reshape Cells
FlatImag = Imag reshape Cells
FlatHyp = Hyp reshape Cells
A = FlatReal FlatValid
B = FlatImag FlatValid
C = FlatHyp FlatValid
Count = A len
Triples = 4 * Count
RealParts = concat A (0 - A) B (0 - B)
ImagParts = concat B B A A
Bases = concat C C C C
Data = concat RealParts ImagParts Bases
Matrix = Data reshape 3 Triples
Points = Matrix transpose
Limit = N * N // 2

fun Point power Count
  Real = Point 0
  Imag = Point 1
  Base = Point 2
  X = 1
  Y = 0
  Scale = 1
  for I in 1 to Count
    Next = X * Real - Y * Imag
    Y = X * Imag + Y * Real
    X = Next
    Scale *= Base
  end
  return array X Y Scale
end

fun Point order_sum Order
  Total = 0
  Last = (Order - 1) // 2
  for First in 1 to Last
    Common = Order gcd First
    if Common equal 1
      Second = Order - First
      Left = Point power First
      Right = Point power Second
      Ratio = Right 2 // Left 2
      X = Second * Left 0 * Ratio
      X += First * Right 0
      Y = Second * Left 1 * Ratio
      Y -= First * Right 1
      Common = X gcd Y
      Common = Right 2 gcd Common
      Scale = Right 2 // Common
      Size = X abs
      Size += Y abs
      Size //= Common
      Fits = N // (Scale * Order)
      Total += Size * Fits * (Fits + 1)
    end
  end
  return Total
end

fun Point point_sum
  Base = Point 2
  Order = 3
  Power = Base ** Order
  Total = 0
  for Power at most Limit
    Total += Point order_sum Order
    Order += 1
    Power *= Base
  end
  return Total
end

Contributions = Points point_sum rank 1
Nontrivial = Contributions sum
rem Pair odd and twice-odd Mobius terms.
rem For m > 1, even m uses m phi(m);
rem odd m uses
rem -(m phi(m) + product(1-p)) / 2.
rem Use distinct primes of m.
fun Bound correction_weights
  Size = Bound + 1
  Phi = 0 to Bound copy
  Product = array shape Size fill 1
  Removed = array shape Size fill 1
  Top = Bound isqrt
  Primes = primes to Top copy
  Count = Primes len
  Index = 0
  Power = 2
  for Index less Count
    Prime = Primes Index
    Slots = Power to Bound by Power
    Removed Slots *= Prime
    if Power equal Prime
      Phi Slots -= Phi Slots // Prime
      Product Slots *= 1 - Prime
    end
    Power *= Prime
    if Power greater Bound
      Index += 1
      if Index less Count
        Power = Primes Index
      end
    end
  end
  Keys = 0 to Bound copy
  Rest = Keys // Removed max 1
  Large = Rest greater 1
  Phi = Large choose (Phi - Phi // Rest) Phi
  Product = Large choose (Product * (1 - Rest)) Product
  Weight = Keys * Phi
  Half = (Weight + Product) // 2
  Odd = Keys mod 2 equal 1
  Weight = Odd choose (0 - Half) Weight
  if Bound at least 1
    Weight 1 = 0
  end
  return Weight
end

Bound = N // 2
Weights = Bound correction_weights
Keys = 2 to Bound copy
Counts = N // (2 * Keys)
Triangle = Counts * (Counts + 1) // 2
Coefficients = Weights Keys
Terms = Coefficients * Triangle
Correction = Terms sum

Half = N // 2
Polynomial = Half * (7 * Half - 3) - 4
Trivial = 2 * Half * Polynomial // 3
if N mod 2 equal 1
  Trivial += 7 * Half * Half + 3 * Half
end
Total = Nontrivial + Trivial
Answer = Total + Correction
Answer print
