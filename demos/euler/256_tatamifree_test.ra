use testing

test "default input"
  use "256_tatamifree" as solve
  Answer = solve

  Answer equal 85765680
end

test "every even area"
  use "256_tatamifree" as solve
  Answer = solve 1 2 2

  Answer equal 70
  Answer = solve 2 2 2

  Answer equal 198
  Answer = solve 5 2 2

  Answer equal 1320
  Answer = solve 7 2 2

  Answer equal 3696
end
