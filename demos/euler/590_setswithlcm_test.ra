use testing

test "statement and brute-force values"
  use "590_setswithlcm" as solve
  Answer = solve 4
  Answer equal 44
  Answer = solve 6
  Answer equal 3748
  Answer = solve 10
  Answer equal 946139968
  Answer = solve 16
  Answer equal 265773312
end

test "default input"
  use "590_setswithlcm" as solve
  Answer = solve
  Answer equal 834171904
end
