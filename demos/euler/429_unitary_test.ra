use testing

test "statement value"
  use "429_unitary" as solve
  Answer = solve 4
  Answer equal 650
end

test "products of prime powers"
  use "429_unitary" as solve
  Answer = solve 8
  Answer equal 746640991
  Answer = solve 100
  Answer equal 202476099
end

test "empty and unit factorial"
  use "429_unitary" as solve
  Answer = solve 0
  Answer equal 1
  Answer = solve 1
  Answer equal 1
end
