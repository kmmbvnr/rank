use testing

test "statement value"
  use "429_unitary"
  N = 4
  run
  Answer equal 650
end

test "products of prime powers"
  use "429_unitary"
  N = 8
  run
  Answer equal 746640991
  N = 100
  run
  Answer equal 202476099
end

test "empty and unit factorial"
  use "429_unitary"
  N = 0
  run
  Answer equal 1
  N = 1
  run
  Answer equal 1
end
