rem Largest Palindrome Product
rem https://projecteuler.net/problem=4
rem Early-stopping variant: merge the rows of
rem the product table in decreasing order, so
rem the first palindrome found is the answer.

use sequences
use text
use io
use cli
use algo

rem Number of digits in each factor.
option Digits integer = 3

Lower = 10 ** (Digits - 1)
Upper = Lower * 10 - 1

rem Each factor pair starts at A * A. The heap
rem keeps the largest unvisited product first.
Factors = (Lower to Upper) array
Squares = Factors * Factors
Pairs = ((array Factors Factors) stack) transpose
Candidates = new heap Squares Pairs .descending

Answer = 0
for Candidates len greater 0
  unpack A B = Candidates pop
  Product = A * B
  if Product palindrome
    Answer = Product
    break
  end
  if B greater Lower
    Next = B - 1
    Product = A * Next
    Candidates Product (array A Next) enqueue
  end
end

Answer print

rem Return true when a nonnegative integer
rem reads the same in both directions.
fun palindrome X
  Text = X text
  Back = Text reverse
  return Text equal Back
end
