rem Largest Palindrome Product
rem https://projecteuler.net/problem=4
rem Early-stopping variant: merge the rows of
rem the product table in decreasing order, so
rem the first palindrome found is the answer.

use sequences
use text
use io
use cli

rem Number of digits in each factor.
option Digits integer = 3

Lower = 10 ** (Digits - 1)
Upper = Lower * 10 - 1

rem Every product row is descending. Merge the
rem rows without materializing the product table.
Factors = Upper to Lower by -1
Products = Factors Factors outer *
Candidates = Products merge .descending

Answer = 0
for Product in Candidates
  if Product palindrome
    Answer = Product
    break
  end
end

Answer print

rem Return true when a nonnegative integer
rem reads the same in both directions.
fun palindrome X
  Text = X text
  Back = Text reverse
  return Text equal Back
end
