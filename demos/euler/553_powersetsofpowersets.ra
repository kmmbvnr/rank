rem Power Sets of Power Sets
rem https://projecteuler.net/problem=553
use numbers
use sequences
use bits
use io
use cli
arg N integer = 10000
arg K integer = 10
Mod = 1000000007
fun Left multiply Right
  return Left * Right mod Mod
end
fun N families K
  if K greater N
    return 0
  end
  if K equal 0
    return 1
  end
  Size = N - K + 1
  Index = 0 to Size copy
  Fact = (Index max 1) scan multiply
  Last = Fact Size (Mod - 2) Mod powmod
  Down = Size to 1 by -1
  Prefix = Down scan multiply with Last
  Weights = Prefix reverse
  Powers = 2 Index (Mod - 1) powmod
  Families = 2 (Powers - 1) Mod powmod
  Families = Families - 1
  Terms = Families * Weights mod Mod
  Signs = 1 - 2 * (Index mod 2)
  Signed = Signs * Weights mod Mod
  Full = Terms convolve Signed mod Mod
  Whole = Full take (Size + 1) copy
  Whole 0 = 1
  rem Newton reciprocal of 1+A(x).
  fun Series grow
    Width = Series len * 2 min Size
    Part = Whole take Width
    Wide = Part convolve Series mod Mod
    Convolved = Wide take Width
    Minus = (0 - Convolved) mod Mod
    Minus 0 = (2 - Convolved 0) mod Mod
    Next = Series convolve Minus mod Mod
    return Next take Width
  end
  Unit = array 1
  Levels = Size - 1 binary len
  Inverse = Unit grow repeat Levels
  rem H(x)/x = integral(F'/F)/x.
  Orders = 1 to Size copy
  Tail = Whole drop 1
  Slope = Orders * Tail mod Mod
  Full = Slope convolve Inverse mod Mod
  Product = Full take Size
  Before = Fact take Size
  After = Weights drop 1
  Divisors = Before * After mod Mod
  Connected = Product * Divisors mod Mod
  rem Shift out x^K before powering H.
  fun State square
    Value = State .result
    Base = State .base
    Count = State .count
    if Count odd
      Next = Value convolve Base mod Mod
      Value = Next take Size
    end
    if Count greater 1
      Next = Base convolve Base mod Mod
      Base = Next take Size
    end
    return record
      .result = Value
      .base = Base
      .count = Count // 2
    end
  end
  Seed = record
    .result = Unit
    .base = Connected
    .count = K
  end
  Steps = K binary len
  State = Seed square repeat Steps
  Result = State .result
  Back = Weights take Size reverse
  Terms = Result * Back mod Mod
  Total = Terms sum mod Mod
  Labels = K + 1 to N
  Scale = Labels reduce multiply with 1
  return Scale * Total mod Mod
end
Answer = N families K
Answer print
