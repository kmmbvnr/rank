rem Cutting Rectangular Grid Paper
rem https://projecteuler.net/problem=338

use numbers
use io
use cli

arg Limit integer = 1000000000000

Limit grid print

fun N grid
  if N less 2
    return 0
  end
  Product = N products
  Divs = N divsums
  return Product - Divs
end

fun N products
  I = 2
  Sum = 0
  for I at most N
    A = N // I
    B = N // (I - 1)
    NA = N // A + 1
    NB = N // B + 2
    Next = NA min NB
    Next = Next min (N + 1)
    Sum += (Next - I) * A * B
    I = Next
  end
  return Sum
end

rem Ordered triples minus ordered pairs.
rem Sort A <= B <= C; count orderings.
rem O(N^(2/3)) work, using exact sums.
fun N divsums
  Sum = 0
  A = 1
  for A * A * A at most N
    Q = N // A
    Last = Q isqrt
    rem Equal A,B: weights 1 then 3.
    Sum += 3 * (Q // A - A) + 1
    rem Distinct A,B: weights 3 then 6.
    Part = Q // (A + 1 to Last) sum
    Sum += 6 * Part
    Sum -= 3 * (Last - A) * (Last + A)
    A += 1
  end
  return Sum - (N pairs)
end

fun N pairs
  Root = N isqrt
  Sum = N // (1 to Root) sum
  return 2 * Sum - Root * Root
end
