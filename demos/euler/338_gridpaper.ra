rem Cutting Rectangular Grid Paper
rem https://projecteuler.net/problem=338

use numbers
use io
use cli

arg Limit integer = 1000000000000

Limit grid print

fun N grid
  if N less 2
    return 0
  end
  Product = N products
  Divs = N divsums
  return Product - Divs
end

fun N products
  I = 2
  Sum = 0
  for I at most N
    A = N // I
    B = N // (I - 1)
    NA = N // A + 1
    NB = N // B + 2
    Next = NA min NB
    Next = Next min (N + 1)
    Sum += (Next - I) * A * B
    I = Next
  end
  return Sum
end

rem Sum over I >= 2 of D(N // I) is T(N) - D(N), where
rem D counts ordered pairs and T counts ordered triples with product <= N.
rem Count each sorted triple A <= B <= C with its permutation weight.
rem There are O(N^(2/3)) (A, B) pairs; all values remain exact integers.
fun N divsums
  Sum = 0
  A = 1
  for A * A * A at most N
    Q = N // A
    Last = Q isqrt
    rem B = A: (A,A,A) has weight 1, larger C have weight 3.
    Sum += 3 * (Q // A - A) + 1
    for B in A + 1 to Last
      rem B > A: C = B has weight 3, larger C have weight 6.
      Sum += 6 * (Q // B - B) + 3
    end
    A += 1
  end
  return Sum - (N pairs)
end

fun N pairs
  Root = N isqrt
  Sum = 0
  for I in 1 to Root
    Sum += N // I
  end
  return 2 * Sum - Root * Root
end
