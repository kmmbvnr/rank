rem Snowflakes
rem https://projecteuler.net/problem=570
use numbers
use sequences
use io
use cli

arg N integer = 10000000

rem With U=4^(n-2) and V=3^(n-2),
rem A=6(2U-V) and
rem B=6((3n-23)U+(2n+13)V).
rem Their gcd is 6*gcd(7n+3,2U-V).
Answer = 0
rem Keep temporary arrays in one batch.
Batch = 65536
for Start in 3 to N by Batch
  Last = Start + Batch - 1 min N
  Numbers = Start to Last copy
  Moduli = 7 * Numbers + 3
  Exponents = Numbers - 2
  Fours = 4 Exponents Moduli powmod
  Threes = 3 Exponents Moduli powmod
  Residues = 2 * Fours - Threes
  Values = Moduli gcd Residues
  Answer += 6 * Values sum
end
Answer print
