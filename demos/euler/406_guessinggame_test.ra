use testing

test "equal costs halve the interval"
  use "406_guessinggame" as solve
  Answer = solve 5 1
  Answer equal 2
  Answer = solve 1000 1
  Answer equal 9
  Answer = solve 1000000000000 1
  Answer equal 39
end

test "first terms of the sum"
  use "406_guessinggame" as solve
  Answer = solve 1000000000000 2
  Answer equal 86.04163056
  Answer = solve 1000000000000 3
  Answer equal 147.69556898
end
