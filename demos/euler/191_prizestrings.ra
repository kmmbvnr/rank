rem Prize Strings
rem https://projecteuler.net/problem=191
rem Count the attendance strings of Days
rem days with at most one late and no
rem three absent days in a row

use linalg
use sequences
use io
use cli

option Days integer = 30

rem State s = 3 l + a: lates so far l,
rem absents a at the end. A day on time
rem returns a to 0, absent adds one (up
rem to 2) and late is allowed once.
Tm = array shape 36 fill 0
All = 0 to 5 array
Tm (All * 6 + All // 3 * 3) += 1
Gap = array 0 1 3 4
Tm (Gap * 6 + Gap + 1) += 1
Fresh = 0 to 2 array
Tm (Fresh * 6 + 3) += 1
Mat = Tm reshape 6 6
V = array 1 0 0 0 0 0
for Day in 1 to Days
  V = V Mat matmul
end
Answer = V sum
Answer print
