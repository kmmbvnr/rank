rem Unpredictable Permutations
rem https://projecteuler.net/problem=720

use numbers
use sequences
use io
use cli

arg Bits integer = 25
arg Prime integer = 1000000007

rem The first unpredictable permutation
rem of 2N comes from that of N: odd
rem values 2p - 1 for all but the last
rem place, then bridge entries 2 p(1)
rem and 2 p(N) - 1, then the even
rem values 2p. The Lehmer code L is
rem updated alongside, and the rank is
rem 1 + sum of L(i) (n - 1 - i)!.
fun A mulp B = A * B mod Prime
Perm = array 1 3 2 4
Lehmer = array 0 1 0 0
Size = 4
for Size less 2 ** Bits
  Head = Perm take (Size - 1)
  Tail = Perm drop 1
  Last = Perm (Size - 1)
  First = 2 * (Perm 0)
  Bridge = array First (2 * Last - 1)
  LHead = Lehmer take (Size - 1)
  LBridge = array 0 (Size - 2)
  Joined = concat (2 * Head - 1) Bridge
  Perm = concat Joined (2 * Tail)
  Shifted = LHead + Head - 1
  LJoined = concat Shifted LBridge
  Rest = Lehmer drop 1
  Lehmer = concat LJoined Rest
  Size = Size * 2
end
Run = (1 to Size - 1) scan mulp
Facts = concat (array 1) Run
Back = Facts reverse
Weights = Lehmer * Back mod Prime
Total = Weights sum
Answer = (1 + Total) mod Prime
Answer print
