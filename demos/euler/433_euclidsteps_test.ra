use testing

test "statement values"
  use "433_euclidsteps" as solve
  Answer = solve 1
  Answer equal 1
  Answer = solve 10
  Answer equal 221
  Answer = solve 100
  Answer equal 39826
end

test "larger bounds"
  use "433_euclidsteps" as solve
  Answer = solve 1000
  Answer equal 5893024
  Answer = solve 10000
  Answer equal 782828208
end

test "empty and small squares"
  use "433_euclidsteps" as solve
  Answer = solve 0
  Answer equal 0
  Answer = solve 2
  Answer equal 5
  Answer = solve 5
  Answer equal 47
end
