use testing

test "default input"
  use "090_cubedigitpairs" as solve
  Out = solve
  Answer = Out .answer

  Answer equal 1217
end

test "statement dice show all squares"
  use "090_cubedigitpairs" as solve
  Out = solve
  Both = Out .both
  Num = Out .num

  Num equal 210
  Both 125 135 equal true
  Both 135 125 equal true
end

test "identical dice fail"
  use "090_cubedigitpairs" as solve
  Out = solve
  Both = Out .both

  Both 0 0 equal false
  Both 125 125 equal false
end
