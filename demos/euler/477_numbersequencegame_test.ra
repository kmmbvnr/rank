use testing

test "statement values"
  use "477_numbersequencegame" as solve
  Answer = solve 2
  Answer equal 45
  Answer = solve 4
  Answer equal 4284990
  Answer = solve 100
  Answer equal 26365463243
end

test "before and after the cycle"
  use "477_numbersequencegame" as solve
  Answer = solve 10000
  Answer equal 2495838522951
  Answer = solve 70000
  Answer equal 17509702126643
  Answer = solve 150000
  Answer equal 37548213762131
end
