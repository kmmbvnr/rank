use testing

test "default input"
  use "242_oddtriplets" as solve
  Answer = solve

  Answer equal 997104142249036713
end

test "small limits"
  use "242_oddtriplets" as solve
  Answer = solve 10

  Answer equal 5
  Answer = solve 100

  Answer equal 139
  Answer = solve 1000

  Answer equal 5793
end
