use testing

rem Exercise the full default limit.
test "default input"
  use "233_circlepoints" as solve
  Answer = solve

  Answer equal 271204031455541309
end

test "smaller limits"
  use "233_circlepoints" as solve
  Answer = solve 10000000

  Answer equal 1722531830
  Answer = solve 20000000

  Answer equal 7843770952
end
