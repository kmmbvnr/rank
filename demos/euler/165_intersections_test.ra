use testing

test "first segment from the statement"
  use "165_intersections"
  Lines = 1 segments
  (Lines 0) 0 equal 27
  (Lines 1) 0 equal 144
  (Lines 2) 0 equal 12
  (Lines 3) 0 equal 232
end

test "smaller sets of segments"
  use "165_intersections" as crossings
  Answer = crossings 300 (300 * 299 // 2)
  Answer equal 11064
  Answer = crossings 1000 (1000 * 999 // 2)
  Answer equal 113849
end
