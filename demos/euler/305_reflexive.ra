rem Reflexive Position
rem https://projecteuler.net/problem=305

use algo
use text
use io
use cli

arg Power integer = 13

Answer = 0
for N in 3 ** (1 to Power array)
  Answer += N solve
end
Answer print

fun State E A id
  K = E join ","
  K += ":"
  K += A join ","
  Ids = State .ids
  if K in Ids
    return Ids K
  end
  Ids K = K
  Ends = State .ends
  Adds = State .adds
  Ends K = E
  Adds K = A
  return K
end

fun State X Y merge
  Ends = State .ends
  Adds = State .adds
  EX = Ends X
  AX = Adds X
  EY = Ends Y
  AY = Adds Y
  E = EY EX
  A = AX + AY EX
  return State E A id
end

fun State X D adddig
  Dig = State .dig
  return State X (Dig D) merge
end

fun State X R block
  Full = State .full
  K = X + ":"
  K += R text
  if K in Full
    return Full K
  end
  if R equal 0
    Full K = X
    return X
  end
  Z = State .unit
  for D in 0 to 9
    Y = State X D adddig
    C = State Y (R - 1) block
    Z = State Z C merge
  end
  Full K = Z
  return Z
end

fun State X R Top partial
  if R equal 0
    return X
  end
  B = 10 ** (R - 1)
  F = Top // B
  Rest = Top mod B
  Z = State .unit
  for D in 0 till F
    Y = State X D adddig
    C = State Y (R - 1) block
    Z = State Z C merge
  end
  Y = State X F adddig
  C = State Y (R - 1) Rest partial
  return State Z C merge
end

fun State ranged N
  if N equal 0
    return State .unit
  end
  T = N text
  D = T len
  Z = State .unit
  Dig = State .dig
  for W in 1 till D
    for F in 1 to 9
      C = State (Dig F) (W - 1) block
      Z = State Z C merge
    end
  end
  F = (T 0) integer
  R = D - 1
  for A in 1 till F
    C = State (Dig A) R block
    Z = State Z C merge
  end
  if R equal 0
    return State Z (Dig F) merge
  end
  Suf = (T (1 to R)) integer
  C = State (Dig F) R Suf partial
  return State Z C merge
end

fun State count N
  X = State ranged N
  Adds = State .adds
  A = Adds X
  return A 0
end

fun N before
  if N equal 0
    return 0
  end
  T = N text
  D = T len
  Z = 0
  for W in 1 till D
    Z += 9 * (10 ** (W - 1)) * W
  end
  Base = 10 ** (D - 1)
  return Z + (N - Base + 1) * D
end

fun State nth Target
  Hi = 1
  for State count Hi less Target
    Hi *= 2
  end
  Lo = 1
  for Lo less Hi
    Mid = (Lo + Hi) // 2
    if State count Mid at least Target
      Hi = Mid
    else
      Lo = Mid + 1
    end
  end
  N = Lo
  Old = State count (N - 1)
  Left = Target - Old
  X = State ranged (N - 1)
  Ends = State .ends
  E = (Ends X) 0
  Hit = State .hit
  Nxt = State .nxt
  L = State .l
  Pos = (N - 1) before
  T = N text
  for I in 0 till T len
    D = (T I) integer
    if Hit E D equal 1
      Left -= 1
      if Left equal 0
        return Pos + I - L + 2
      end
    end
    E = Nxt E D
  end
  return 0
end

fun Need solve
  Pat = Need text
  L = Pat len
  Pi = array shape L fill 0
  for I in 1 till L
    J = Pi (I - 1)
    for J greater 0
      if Pat I equal Pat J
        break
      end
      J = Pi (J - 1)
    end
    if Pat I equal Pat J
      J += 1
    end
    Pi I = J
  end
  Nxt = array shape (L + 1) 10 fill 0
  Hit = array shape (L + 1) 10 fill 0
  for S in 0 to L
    for D in 0 to 9
      J = S
      Dt = D text
      for J greater 0
        Same = J less L
        Same = Same and Pat J equal Dt
        if Same
          break
        end
        J = Pi (J - 1)
      end
      if J less L and Pat J equal Dt
        J += 1
      end
      if J equal L
        Hit S D = 1
        J = Pi (L - 1)
      end
      Nxt S D = J
    end
  end
  State = record
    .l = L
    .nxt = Nxt
    .hit = Hit
    .ends = new index
    .adds = new index
    .ids = new index
    .full = new index
    .dig = array shape 10 fill ""
    .unit = ""
  end
  E0 = 0 to L array
  A0 = array shape (L + 1) fill 0
  State .unit = State E0 A0 id
  Dig = State .dig
  for D in 0 to 9
    E = 0 to L array
    A = array shape (L + 1) fill 0
    for S in 0 to L
      E S = Nxt S D
      A S = Hit S D
    end
    Dig D = State E A id
  end
  State .dig = Dig
  return State nth Need
end
