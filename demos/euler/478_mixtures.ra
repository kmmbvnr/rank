rem Mixtures
rem https://projecteuler.net/problem=478

use numbers
use sequences
use io
use cli

arg N integer = 10000000

rem Small prime powers leave at most
rem one prime cofactor in each entry.
fun Bound sieve
  Size = Bound + 1
  Signs = array shape Size fill 1
  Signs 0 = 0
  Phi = 0 to Bound copy
  Rest = 0 to Bound copy
  Root = Bound isqrt
  Primes = primes to Root copy
  Count = Primes len
  Index = 0
  Power = 2
  for Index less Count
    Prime = Primes Index
    Slots = Power to Bound by Power
    Rest Slots //= Prime
    if Power equal Prime
      Signs Slots *= -1
      Phi Slots -= Phi Slots // Prime
      Square = Prime * Prime
      Slots = Square to Bound by Square
      Signs Slots = 0
    end
    Power *= Prime
    if Power greater Bound
      Index += 1
      if Index less Count
        Power = Primes Index
      end
    end
  end
  Large = Rest greater 1
  Signs = Large choose (0 - Signs) Signs
  Divisors = Rest max 1
  Delta = Phi // Divisors
  Phi = Large choose (Phi - Delta) Phi
  Prefix = Signs scan +
  return tuple Prefix Phi
end

rem H(L) = 1 + coprime x, y > 0 with
rem x + L y <= Bound. Group Mobius
rem inversion by m = Bound // d.
fun Bound counts Quotients Weights
  Size = Bound + 1
  Counts = array shape Size fill 1
  Count = Quotients len
  for I in 0 till Count
    Weight = Weights I
    if Weight not equal 0
      Top = Quotients I
      Slopes = 1 to Top
      Rows = Top // Slopes
      Pairs = (
        Rows * Top -
        Slopes * Rows * (Rows + 1) // 2
      )
      Counts Slopes += Weight * Pairs
    end
  end
  return Counts
end

unpack Prefix Phi = N sieve
Root = N isqrt
Divisors = 1 to Root copy
Small = N // (Root + 1) to 1 by -1
Quotients = concat (N // Divisors) Small
Quotients = Quotients unique
High = N // Quotients
Low = N // (Quotients + 1)
Weights = Prefix High - Prefix Low
rem P counts primitive triples in
rem 0..N^3, excluding the origin.
Cubes = (Quotients + 1) ** 3 - 1
Terms = Weights * Cubes
Primitive = Terms sum
Counts = N counts Quotients Weights

rem E = 2^P - 1 - 2^h B + T, where
rem h = (P - 1) / 2, B = 6 sum phi,
rem T = sum 6 phi(L) 2^(h - H(L)).
rem Only exponent residues are needed.
Modulus = 214358881
Period = 194871710
Half = (Primitive - 1) // 2 mod Period
Keys = 1 to N
Shifts = (Half - Counts Keys) mod Period
rem Two small tables give 2^e mod M.
Stride = 16384
LowIndex = 0 till Stride copy
Lower = 2 LowIndex Modulus powmod
Step = 2 Stride Modulus powmod
Top = Period // Stride
HighIndex = 0 to Top copy
Upper = Step HighIndex Modulus powmod
Powers = (
  Lower (Shifts mod Stride) *
  Upper (Shifts // Stride)
) mod Modulus
Values = Phi Keys
Terms = 6 * Values * Powers mod Modulus
Total = Terms sum mod Modulus
Sum = Values sum
Rays = 6 * Sum mod Modulus
HalfPower = 2 Half Modulus powmod
Excluded = 1 + HalfPower * Rays - Total
Bad = Excluded mod Modulus
Residue = Primitive mod Period
Leading = 2 Residue Modulus powmod
Answer = (Leading - Bad) mod Modulus
Answer print
