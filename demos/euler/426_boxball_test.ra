use testing

test "statement sample"
  use "426_boxball"
  Last = 10
  run
  Answer equal 8912
end

test "per-ball stack references"
  use "426_boxball"
  Last = 100
  run
  Answer equal 170376
  Last = 1000
  run
  Answer equal 1714252
end

test "drain even the first ball run"
  use "426_boxball"
  Last = 0
  run
  Answer equal 2116
  Last = 1
  run
  Answer equal 2116
  Last = 2
  run
  Answer equal 2197
end
