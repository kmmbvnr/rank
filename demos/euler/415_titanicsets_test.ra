use testing

test "statement values"
  use "415_titanicsets" as solve
  Answer = solve 1
  Answer equal 11
  Answer = solve 2
  Answer equal 494
  Answer = solve 4
  Answer equal 33554178
end

test "published checkpoints"
  use "415_titanicsets" as solve
  Answer = solve 111
  Answer equal 13500401
  Answer = solve 100000
  Answer equal 63259062
end

test "short tables use the recursion"
  use "415_titanicsets" as solve
  Answer = solve 111 30
  Answer equal 13500401
  Answer = solve 100000 400
  Answer equal 63259062
end
