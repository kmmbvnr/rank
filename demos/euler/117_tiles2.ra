rem Red, Green, and Blue Tiles
rem https://projecteuler.net/problem=117
rem Count the ways to tile a row with
rem grey squares and tiles of length 2,
rem 3 and 4

use sequences
use io
use cli

option Size integer = 50

rem Compositions into parts 1 to 4: each
rem count is the sum of the previous
rem four. Three zeros pad the front.
Ways = array shape (Size + 4) fill 0
Ways 3 = 1
for N in 1 to Size
  Pre = (Ways (N - 1 to N + 2)) sum
  At = N + 3
  Ways At = Pre
end
End = Size + 3
Answer = Ways End
Answer print
