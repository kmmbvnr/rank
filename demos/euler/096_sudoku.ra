rem Su Doku
rem https://projecteuler.net/problem=96
rem Sum the top left three-digit numbers
rem of fifty solved puzzles

use bits
use linalg
use sequences
use text
use io
use cli

argument Input path = (
  "demos/euler/fixtures/"
  + "0096_sudoku.txt"
)

Lines = Input readlines
Heads' = Lines startswith "Grid"
Rows = Lines (not Heads)
Text = Rows join ""
Cells = Text integer rank 0
Count = Cells len // 81
Grids = Cells reshape Count 81
Ids = 0 till 81 array
RowK = Ids // 9
ColK = Ids mod 9 + 9
Band' = Ids // 27 * 3
Stack' = Ids mod 9 // 3
BoxK = Band + Stack + 18
Bit = array 1 2 4 8 16 32 64 128 256
Pop = (0 to 511 array) popcount
Weight = array 100 10 1
rem Backtrack on the cell with fewest
rem candidates. Spot, Left and Put hold,
rem per depth, the cell, the candidates
rem not yet tried and the digit placed.
Grid = Grids 0 copy
Used = array shape 27 fill 0
Answer = 0
for G in 0 till Count
  Grid = Grids G copy
  Used = array shape 27 fill 0
  for C in 0 till 81
    D = Grid C
    if D greater 0
      B = Bit (D - 1)
      Used (RowK C) += B
      Used (ColK C) += B
      Used (BoxK C) += B
    end
  end
  Depth = 0
  Fresh = true
  Spot = array shape 81 fill 0
  Left = array shape 81 fill 0
  Put = array shape 81 fill 0
  for Depth greater -1
    if Fresh
      Pick = -1
      PickN = 10
      PickFree = 0
      for C in 0 till 81
        if Grid C equal 0
          Row = Used (RowK C)
          Col = Used (ColK C)
          Box = Used (BoxK C)
          RC = Row bor Col
          Mask = RC bor Box
          Free = 511 - Mask
          N = Pop Free
          if N less PickN
            PickN = N
            Pick = C
            PickFree = Free
          end
        end
      end
      if Pick less 0
        break
      end
      Spot Depth = Pick
      Left Depth = PickFree
    end
    if Left Depth equal 0
      Depth -= 1
      if Depth less 0
        break
      end
      At = Spot Depth
      Mine = Put Depth
      Grid At = 0
      Used (RowK At) -= Mine
      Used (ColK At) -= Mine
      Used (BoxK At) -= Mine
      Fresh = false
      continue
    end
    Rem = Left Depth
    Mine = Rem band (0 - Rem)
    Left Depth = Rem - Mine
    Put Depth = Mine
    At = Spot Depth
    Digit = (Mine - 1) popcount + 1
    Grid At = Digit
    Used (RowK At) += Mine
    Used (ColK At) += Mine
    Used (BoxK At) += Mine
    Depth += 1
    Fresh = true
  end
  Head = Grid take 3
  Answer += Head matmul Weight
end
Answer print
