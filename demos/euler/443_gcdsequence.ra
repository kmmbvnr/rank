rem GCD Sequence
rem https://projecteuler.net/problem=443

use numbers
use sequences
use io
use cli

arg N integer = 1000000000000000

fun Value next_gcd Index
  Step = Index gcd Value
  return Value + Step
end

Last = N min 9
Indices = 5 to Last
Values = Indices scan next_gcd with 13
Answer = Values last
if N greater 9
  rem At each anchor, g(a) = 3a. The
  rem next non-unit gcd is at a+(p-1)/2,
  rem p the least prime factor of 2a-1.
  Anchor = 9
  for Anchor less N
    Value = 2 * Anchor - 1
    Prime = Value factors first
    Next = Anchor + (Prime - 1) // 2
    if Next greater N
      break
    end
    Anchor = Next
  end
  rem Between jumps, g(n) = n + 2a.
  Answer = N + 2 * Anchor
end
return Answer
