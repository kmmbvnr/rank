use testing

test "default input"
  use "192_bestapprox" as solve
  Answer = solve

  Answer equal 57060635927998347
end

test "small bounds"
  use "192_bestapprox" as solve
  Answer = solve 13 20

  Answer equal 159
  Answer = solve 50 100

  Answer equal 2981
  Answer = solve 200 1000

  Answer equal 112225
end
