use testing

test "statement values"
  use "537_primecounting"
  N = 3
  K = 3
  run
  Answer equal 19
  N = 10
  K = 10
  run
  Answer equal 869985
  N = 1000
  K = 1000
  run
  Answer equal 578270566
end


test "empty tuples and zero prime counts"
  use "537_primecounting"
  N = 0
  K = 0
  run
  Answer equal 1
  K = 7
  run
  Answer equal 1
  N = 1
  K = 0
  run
  Answer equal 0
end
