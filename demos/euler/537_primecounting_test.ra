use testing

test "statement values"
  use "537_primecounting" as solve
  Answer = solve 3 3
  Answer equal 19
  Answer = solve 10 10
  Answer equal 869985
  Answer = solve 1000 1000
  Answer equal 578270566
end


test "empty tuples and zero prime counts"
  use "537_primecounting" as solve
  Answer = solve 0 0
  Answer equal 1
  Answer = solve 0 7
  Answer equal 1
  Answer = solve 1 0
  Answer equal 0
end
