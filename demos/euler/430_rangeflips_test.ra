use testing

test "statement values"
  use "430_rangeflips" as solve
  Answer = solve 3 1 8
  Answer equal 1.11111111
  Answer = solve 3 2 8
  Answer equal 1.66666667
  Answer = solve 10 4 8
  Answer equal 5.15702608
end

test "one hundred disks"
  use "430_rangeflips" as solve
  Answer = solve 100 10 13
  Answer equal 51.8928010382861
end

test "edges of a long row"
  use "430_rangeflips" as solve
  Answer = solve 1000000 40 2 100000
  Answer equal 506172.33
end
