rem Collatz prefix families
rem https://projecteuler.net/problem=494

use numbers
use sequences
use bits
use io
use cli

arg T integer = 90

rem f(t) = F_t plus, for the seeds 9,
rem 19, 37, 51, 155 and 159, B_r(s):
rem the backward Collatz walks of r =
rem t - lambda(s) steps, lambda the
rem steps to a power of 2. Backward, x
rem goes to 2x, and to (x - 1)/3 when
rem x = 4 mod 6. An odd node can only
rem double, so keep nodes even: B_d(x)
rem then depends on x mod 2 3^(d/2+1),
rem and equal residues merge.
Fb = array shape (T + 2) fill 1
for I in 3 to T
  Fb I = Fb (I - 1) + Fb (I - 2)
end
Answer = Fb T
Ss = array 9 19 37 51 155 159
for S in Ss
  rem lambda(s).
  X = S
  Lm = 0
  for X popcount greater 1
    if X mod 2 equal 0
      X //= 2
    else
      X = 3 * X + 1
    end
    Lm += 1
  end
  R = T - Lm
  if R less 0
    continue
  end
  Cr = array S
  if S mod 2 equal 1
    if R equal 0
      Answer += 1
      continue
    end
    Cr = array (2 * S)
    R -= 1
  end
  Cc = array 1
  B1 = array shape 0 fill 0
  C1 = B1
  B2 = B1
  C2 = B1
  for D in R to 0 by -1
    if D equal 0
      Answer += Cc sum
      break
    end
    Md = 2 * 3 ** (D // 2 + 1)
    Cr = Cr mod Md
    Od = Cr argsort
    Cr = Cr Od
    Cs = (Cc Od) scan +
    Nx = Cr shift -1 with -1
    Ei = (Cr not equal Nx) indices
    Cr = Cr Ei
    Gs = Cs Ei
    Cc = Gs - (Gs shift 1)
    B1 = concat B1 (2 * Cr)
    C1 = concat C1 Cc
    Ob = (Cr mod 6 equal 4) indices
    Y = (Cr Ob - 1) // 3
    if D equal 1
      Answer += (Cc Ob) sum
    else
      B2 = concat B2 (2 * Y)
      C2 = concat C2 (Cc Ob)
    end
    Cr = B1
    Cc = C1
    B1 = B2
    C1 = C2
    B2 = B2 (0 till 0)
    C2 = C2 (0 till 0)
  end
end
Answer print
