rem Monopoly Odds
rem https://projecteuler.net/problem=84
rem Modal string of the three most
rem visited squares with two dice

use linalg
use sequences
use io
use cli

option Sides integer = 4

rem Land[p]: squares reached after
rem landing on p and resolving
rem go-to-jail and cards. Chance rows
rem reuse the chest row of 33.
Ids = 0 till 41 array
Ri = Ids reshape 41 1
Ci = Ids reshape 1 41
Land = (Ri equal Ci) choose 1.0 0.0 copy
Land 30 = 0.0
Land 30 40 = 1.0
Chest = array 2 17 33
At = Chest reshape 3 1
Keep' = (At equal Ci) choose 0.875 0.0
Pass' = (Ci equal 0) or (Ci equal 40)
Gift' = Pass choose 0.0625 0.0
Land Chest = Keep + Gift
Chance = array 7 22 36
Cp = Chance reshape 3 1
Tens = (Chance + 5) // 10 * 10
Rail = (Tens + 5) mod 40
Inner = Chance at least 12
Inner and= Chance less 28
Util = Inner choose 28 12
Fixed = array 0 40 11 24 39 5
Hits' = Ci equal (Fixed reshape 6 1 1)
Any' = Hits any axis 0
Same' = Any choose 0.0625 0.0
Ours' = (Cp equal Ci) choose 0.375 0.0
RailAt = Rail reshape 3 1
UtilAt = Util reshape 3 1
OnRail' = Ci equal RailAt
OnUtil' = Ci equal UtilAt
Rails' = OnRail choose 0.125 0.0
Utils' = OnUtil choose 0.0625 0.0
Behind = Chance - 3
Back = Land Behind / 16
Cards' = Ours + Same + Rails + Utils
Land Chance = Cards + Back

rem Dice sums: counts of rolls that are
rem not doubles and of doubles, per
rem total.
Die = 1 to Sides array
Side = Die reshape Sides 1
Tot = Side + (Die reshape 1 Sides)
IsD = Side equal (Die reshape 1 Sides)
Plain = Tot (not IsD) array
Twins = Tot IsD array
Sq40 = 0 till 40 array
Col40 = Sq40 reshape 40 1
NP = Plain len
NT = Twins len
Wnd' = Col40 equal (Plain reshape 1 NP)
Wd' = Col40 equal (Twins reshape 1 NT)
NonCount = Wnd count axis 1
TwinCount = Wd count axis 1

rem From square q (41 = in jail, played
rem from 10) a roll total s lands on
rem (q + s) mod 40.
Qs = 0 till 41 array
Base = (Qs equal 40) choose 10 Qs
Row40 = Sq40 reshape 1 40
Col41 = Base reshape 41 1
Gap = Row40 - Col41
Where = (Gap mod 40) reshape 1640
Rolls = Sides * Sides
NonAt = NonCount Where
TwinAt = TwinCount Where
NonGrid = NonAt reshape 41 40
TwinGrid = TwinAt reshape 41 40
NonRoll' = NonGrid / Rolls
TwinRoll' = TwinGrid / Rolls
Reach' = Land take 40
NonD = NonRoll matmul Reach
Dbl = TwinRoll matmul Reach

rem State: square 0 to 39, or 40 if sent
rem to jail, and 0 to 2 doubles so far.
rem Jail is one state; a double either
rem adds one to the count or, the third
rem time, jails.
Jail = (Qs equal 40) choose 1.0 0.0
Gone = (Qs less 40) choose 1.0 0.0
Mine = Dbl # 40
Rows = Dbl sum axis 1
Away = Dbl * (Gone reshape 1 41)
JailRow = Jail reshape 1 41
Jail0 = Mine reshape 41 1
Jail2 = Rows reshape 41 1
Stay0 = NonD + Jail0 * JailRow
Stay2' = NonD + Jail2 * JailRow
Zero = array shape 41 41 fill 0.0
Row0' = concat Stay0 Away Zero axis 1
Row1' = concat Stay0 Zero Away axis 1
Row2' = concat Stay2 Zero Zero axis 1
Size = 41 * 3
Trans' = concat Row0 Row1 Row2 axis 0

rem The long-run shares solve pi T = pi
rem with the shares adding to 1: one
rem balance equation is swapped for that
rem sum.
Cells = Size
Ind = 0 till Cells array
Down = Ind reshape Cells 1
Across = Ind reshape 1 Cells
Eye' = Down equal Across
Unit' = Eye choose 1.0 0.0
Flow' = (Trans transpose) - Unit
Top0 = Ind equal 0
Ones = array shape Cells fill 1.0
Pick = Top0 reshape Cells 1
Norm = Ones reshape 1 Cells
Mat' = Pick choose Norm Flow
Rhs = Top0 choose 1.0 0.0
Seen = Mat solve Rhs
Mid' = Seen drop 41 take 41
Last' = Seen drop 82
Sum' = Seen take 41 + Mid + Last
Sq = Sum copy
Sq 10 += Sq 40
Rank = Sq take 40 argsort .descending
Top = Rank take 3
Weight = array 10000 100 1
Answer = Top matmul Weight
Answer print
