rem Lexicographic Permutations
rem https://projecteuler.net/problem=24
rem Find the millionth ordered permutation
rem of the decimal digits

use algo
use io
use cli

arg Position integer = 1000000

Digits = 0 to 9 array

rem Select each digit directly from its
rem factorial-sized permutation block.
Available = Digits multiset
Remaining = Position - 1
Size = Available len
Block = (1 till Size) reduce *
Result = ""

for Size greater 0
  Choice = Remaining // Block
  Digit = Available Choice
  Piece = Digit text
  Result += Piece
  Available remove Digit
  Remaining mod= Block
  Size -= 1
  if Size greater 0
    Block = Block // Size
  end
end

Answer = Result
Answer print
