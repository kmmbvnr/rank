rem Lexicographic Permutations
rem https://projecteuler.net/problem=24
rem Find the millionth ordered permutation
rem of the decimal digits

use ranges
use sequences
use algo
use text
use io
use cli

option Position integer = 1000000

Digits = (0 to 9) array
Answer = Digits Position lexicographic
Answer print


rem Select each digit directly from its
rem factorial-sized permutation block.
fun lexicographic Digits Position
  Available = Digits multiset
  Remaining = Position - 1
  Size = Available len
  Block = (Size - 1) factorial
  Result = ""

  for Size greater 0
    Choice = Remaining // Block
    Digit = Available Choice
    Piece = Digit text
    Result += Piece
    Available remove Digit
    Remaining %= Block
    Size -= 1
    if Size greater 0
      Block = Block // Size
    end
  end

  return Result
end


rem Multiply the inclusive range from one to N.
fun factorial N
  if N equal 0
    return 1
  end
  return (1 to N) * reduce
end
