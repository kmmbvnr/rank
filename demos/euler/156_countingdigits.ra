rem Counting Digits
rem https://projecteuler.net/problem=156
rem Sum all n for which the count of the
rem digit d in 1 to n equals n, over
rem the digits d = 1 to Last

use sequences
use io
use cli

option Top integer = 11
option Last integer = 9

rem Let g(n) = f(n, d) - n. It falls by
rem at most 1 per step, and rises by
rem any step, so an interval of length B
rem holds a zero only if g at its start
rem is at most B and g at its end is at
rem least -B. Split intervals tenfold
rem and keep those that can still hold
rem a zero; f counts digits per place.
Ps = 10 ** (0 till 13 array)
Pw = Ps reshape 1 13
Pw10 = Pw * 10
Answer = 0
for D in 1 to Last
  Lo = array 0
  B = 10 ** Top
  for Lvl in 0 to Top
    if Lvl greater 0
      B = B // 10
      Cols = Lo len
      Kids' = (0 till 10 array) * B
      Row' = Lo reshape Cols 1
      Kid' = Kids reshape 1 10
      Num = Cols * 10
      Lo = (Row + Kid) reshape Num
    end
    Ends = concat Lo (Lo + B)
    Col = Ends reshape (Ends len) 1
    Cur = Col // Pw mod 10
    Low' = Col mod Pw + 1
    Part' = Cur equal D choose Low 0
    Add' = Cur greater D choose Pw Part
    Top10' = Col // Pw10 * Pw
    F' = Add + Top10 sum axis 1
    G = F - Ends
    Half = Lo len
    Glo = G take Half
    Ghi' = G drop Half
    if B equal 1
      Z' = Glo equal 0 and Lo greater 0
      Hit' = Lo filter Z array
      Answer += Hit sum
    end
    Under' = Glo - B at most 0
    Keep' = Under and Ghi + B at least 0
    Lo = Lo filter Keep array
  end
end
Answer print
