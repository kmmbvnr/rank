rem Squarefree Hilbert numbers
rem https://projecteuler.net/problem=580
use numbers
use sequences
use io
use cli
arg N integer = 9999999999999999
arg Batch integer = 2000000
Width = Batch max 1
Top = N isqrt
Root = Top isqrt
Primes = primes from 3 to Root array

rem Track mu and its prime derivative.
fun Low subtotal
  Count = (Top - Low) // 2 + 1
  Count = Count min Width
  Values = Low + 2 * (0 till Count copy)
  Rest = Values copy
  Mu = array shape Count fill 1
  Terms = array shape Count fill 1
  for Prime in Primes
    rem Locate an odd multiple.
    First = (Prime - Low) // 2 mod Prime
    Rows = First till Count by Prime
    Rest Rows //= Prime
    if Prime mod 4 equal 1
      Mu Rows *= -1
      Terms Rows *= -1
      Step = Prime * Prime
      First = (Step - Low) // 2 mod Step
      Rows = First till Count by Step
      Mu Rows = 0
      Terms Rows = 0
    else
      Terms Rows = Mu Rows - Terms Rows
      Mu Rows *= -1
      Step = Prime * Prime
      First = (Step - Low) // 2 mod Step
      Rows = First till Count by Step
      Terms Rows = Mu Rows
      Mu Rows = 0
      Rest Rows //= Prime
      Step *= Prime
      First = (Step - Low) // 2 mod Step
      Rows = First till Count by Step
      Terms Rows = 0
    end
  end
  Residue = Rest mod 4 equal 3 integer
  Extra = Mu * Residue - Terms
  Active = Rest greater 1
  Result = Active choose Extra Terms
  Quotients = N // Values // Values
  Counts = (Quotients + 3) // 4
  return Result * Counts sum
end

Starts = 1 to Top by (2 * Width)
Totals = Starts subtotal rank 0
Answer = Totals sum
Answer print
