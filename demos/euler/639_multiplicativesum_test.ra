use testing

test "statement values"
  use "639_multiplicativesum" as solve
  Answer = solve 10 1
  Answer equal 41
  Answer = solve 100 1
  Answer equal 3512
  Answer = solve 100 2
  Answer equal 211602
  Answer = solve 10000 1
  Answer equal 35252550
end

test "three exponents"
  use "639_multiplicativesum" as solve
  Answer = solve 100000000 3
  Answer equal 338787512
end
