rem Repeated permutation
rem https://projecteuler.net/problem=483

use numbers
use sequences
use io
use cli
use bits

arg N integer = 350

rem Cycle types weigh n! / prod c^m m!.
rem Process largest prime factors first.
rem After each block, its prime power
rem leaves the order and its square
rem joins the weight. Sums stay exact.

rem Keep only distinct (used, order).
rem A fresh radix keeps state keys small.
fun Used coalesce Orders Weights
  Base = Orders max + 1
  Keys = Used * Base + Orders
  Order = Keys argsort
  Keys = Keys Order
  Previous = Keys shift 1 with -1
  Change = Keys not equal Previous
  Marks = Change integer
  Prefix = Marks scan +
  Group = Prefix - 1
  Sorted = Weights Order
  Weights = Sorted sum by Group
  Keys = Keys Change
  Used = Keys // Base
  Orders = Keys mod Base
  return tuple Used Orders Weights
end

rem Enumerate admissible cycle counts.
fun Bound include_cycles Length State
  unpack Used Orders Weights = State
  Counts = (Bound - Used) // Length + 1
  Prefix = Counts scan + with 0
  Size = Prefix last
  Rows = array shape Size fill 0
  Count = Counts len
  Slots = 0 till Count
  Rows (Prefix Slots) = Slots
  Rows = Rows scan max
  Copies = (0 till Size) - Prefix Rows
  Multiples = 1 to Bound // Length
  Denom = Multiples * Length
  Denom = Denom scan * with 1
  Used = Used Rows + Copies * Length
  Next = Orders lcm Length
  Previous = Orders Rows
  Orders = Next Rows
  Active = Copies greater 0
  Orders = Active choose Orders Previous
  Weights = Weights Rows // Denom Copies
  return Used coalesce Orders Weights
end

rem Extract all powers of Prime at once.
fun Bound remove_prime Prime State
  unpack Used Orders Weights = State
  Count = Bound binary len
  Steps = 1 to Count
  Powers = Prime ** Steps
  Mask = Powers at most Bound
  Powers = Powers Mask
  Power = Powers last
  Divisors = Orders gcd Power
  Orders = Orders // Divisors
  Weights = Weights * Divisors ** 2
  return Used coalesce Orders Weights
end

fun Length largest_prime
  Factors = Length factors
  return Factors last
end

Factorial = 1 to N scan * with 1
Lengths = 2 to N copy
Largest = Lengths largest_prime rank 0
Keys = (N - Largest) * (N + 1) + Lengths
Order = Keys argsort
Lengths = Lengths Order
Largest = Largest Order
Next = Largest shift -1 with 0
Last = Largest not equal Next
Used = 0 to N copy
Orders = Used * 0 + 1
Weights = Factorial N // Factorial
State = tuple Used Orders Weights
Count = Lengths len
for I in 0 till Count
  Length = Lengths I
  State = N include_cycles Length State
  if Last I
    Prime = Largest I
    State = N remove_prime Prime State
  end
end
unpack Used Orders Weights = State
Mask = Used equal N
Keep = Mask indices
Terms = Orders Keep ** 2 * Weights Keep
Total = Terms sum
rem Round to ten significant digits.
Exponent = Total // Factorial N text len
Exponent -= 1
Divisor = Factorial N * 10 ** Exponent
Rounded = Total * 10 ** 10 // Divisor
Rounded = (Rounded + 5) // 10
Digits = Rounded text
Answer = Digits (0 till 1) + "."
Answer += Digits (1 till 10) + "e"
Answer += Exponent text
Answer print
