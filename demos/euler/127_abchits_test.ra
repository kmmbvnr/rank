use testing

test "default input"
  use "127_abchits"
  run

  Answer equal 18407904
end

test "statement value for 1000"
  use "127_abchits"
  Limit = 1000
  run

  Answer equal 12523
end


test "exclude a hit at the limit"
  use "127_abchits"
  Limit = 9
  run

  Answer equal 0
end

test "include the first hit"
  use "127_abchits"
  Limit = 10
  run

  Answer equal 9
end
