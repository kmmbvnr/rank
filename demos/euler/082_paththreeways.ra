rem Path Sum: Three Ways
rem https://projecteuler.net/problem=82
rem Least path sum from the left column
rem to the right column, moving up,
rem down or right

use graph
use numbers
use sequences
use text
use io
use cli

arg Input path = (
  "demos/euler/fixtures/"
  + "0081_matrix.txt"
)

rem Cells are vertices; entering a cell
rem costs its value. A gate vertex joins
rem the left column.
Text = Input read
Commas = Text "\n" "," translate
Parts = Commas split ","
Count = Parts len - 1
Side = Count isqrt
Cells = Parts take Count integer
Id = 0 till Count array
Col = Id mod Side
Last = Side - 1
Rows = Count - Side
Right = Id filter (Col less Last) copy
Down = Id filter less Rows copy
East = Right + 1
South = Down + Side
First = Id (Col equal 0) array
Far = Id (Col equal Last) array
Gate = First * 0 + Count
From = concat Right Down South Gate
To = concat East South Down First
Cost' = Cells To
Edges' = stack From To Cost transpose
Net = new graph .directed
Net add Id
Net add Edges
Dist = (Net dijkstra Count) .distance
Answer = (Dist Far) min
Answer print
