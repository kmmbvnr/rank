rem Incomplete Words
rem https://projecteuler.net/problem=657

use numbers
use sequences
use io
use cli

arg Al integer = 10000000
arg Nl integer = 1000000000000

rem Inclusion-exclusion over the unused
rem letters: I(a, n) is the sum over k
rem used letters of (-1)^(a-k+1) C(a, k)
rem G_k, G_k = 1 + k + ... + k^n. The
rem factorials and their inverses come
rem from prefix products, doubling the
rem span each pass (no modular scan).
P = 1000000007
Vs = 0 to Al
Fa = (Vs at least 1) choose Vs 1
Sf = (Al to 1 by -1) copy
Sp = 0
for 2 ** Sp less Al
  Sh = 2 ** Sp
  Pd = array shape Sh fill 1
  Pd = concat Pd (Fa (0 to Al - Sh))
  Fa = Fa * Pd mod P
  Pr = array shape Sh fill 1
  Pr = concat Pr (Sf (0 to Al - 1 - Sh))
  Sf = Sf * Pr mod P
  Sp += 1
end
Fl = Fa Al
Ifa = Fl (P - 2) P powmod
Fi = (Ifa * Sf mod P) reverse
Fi = concat Fi (array shape 1 fill Ifa)
Ks = 0 to (Al - 1)
Cb = Fi (0 to (Al - 1))
Cr = Fi (1 to Al) reverse
Bn = Fl * Cb mod P * Cr mod P
Pk = Ks (Nl + 1) P powmod
Iv = Fi (1 to (Al - 2))
Iv = Iv * Fa (0 to (Al - 3)) mod P
Pm = Pk (2 to (Al - 1)) + P - 1
Gk = Pm * Iv mod P
G0 = array shape 1 fill 1
G1 = array shape 1 fill ((Nl + 1) mod P)
Gs = concat (concat G0 G1) Gk
Tm = Bn * Gs mod P
Ng = (Al - Ks + 1) mod 2 equal 1
Tm = Ng choose (P - Tm) Tm
Answer = Tm sum mod P
Answer print
