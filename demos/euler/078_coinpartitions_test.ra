use testing

test "default input"
  use "078_coinpartitions" as solve
  Out = solve
  Answer = Out .answer

  Answer equal 55374
end

test "small moduli"
  use "078_coinpartitions" as solve
  Out = solve 7
  Answer = Out .answer

  Answer equal 5
  Out = solve 1000
  Answer = Out .answer

  Answer equal 449
end

test "partition numbers"
  use "078_coinpartitions" as solve
  Out = solve 1000000007 100
  Ways = Out .ways

  Ways 5 equal 7
  Ways 10 equal 42
  Ways 100 equal 190569292
end

test "no multiple within the limit"
  use "078_coinpartitions" as solve
  Out = solve 1000000 100
  Answer = Out .answer

  Answer equal -1
end

test "empty search and the first term"
  use "078_coinpartitions" as solve
  Out = solve 1000000 0
  Answer = Out .answer
  Ways = Out .ways

  Answer equal -1
  Ways 0 equal 1
  Out = solve 1 1
  Answer = Out .answer
  Ways = Out .ways

  Answer equal 1
  Ways 0 equal 1
  Ways 1 equal 0
end
