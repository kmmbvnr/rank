rem Squares on the Line
rem https://projecteuler.net/problem=644

use numbers
use sequences
use algo
use bits
use io
use cli

arg Lo integer = 200
arg Hi integer = 500

rem Pass 1: Grundy values g(L) of a
rem segment, constant between lattice
rem points a + b sqrt 2. For L inside
rem one lattice gap, the moves leave
rem u = L - 1 or L - sqrt 2; cutting
rem [0, u] at the starts of the runs of
rem g and at u minus them gives pieces
rem with one g(x) xor g(u - x) each.
Rt = 2.0 sqrt
Lim = Hi + 2
Ij = 0 to Lim
Jm = Lim / Rt floor
Jj = 0 to Jm
Ir = Ij reshape (Lim + 1) 1
Jr = Jj * Rt reshape 1 (Jm + 1)
Gr = Ir + Jr
Fg = Gr reshape ((Lim + 1) * (Jm + 1))
Kp = Fg at most Lim indices
Bp = Fg Kp sort
Nb = Bp len
St = (0 to 0) * 1.0
Vs = (0 to 0) * 0
Ep = 1.0 / 1000000000000.0
for W in 1 to Lim
  K0 = (Bp less W integer) sum
  K1 = ((Bp less (W + 1)) integer) sum
  if K1 greater K0
    Ks = K0 till K1
    T0 = Bp Ks
    T1 = Bp (Ks + 1 min (Nb - 1))
    Lm = (T0 + T1) / 2.0
    R = Ks len
    Us = concat (Lm - 1.0) (Lm - Rt)
    Ok = Us at least 0.0 integer
    Ur = (Us max 0.0) reshape (2 * R) 1
    S = St len
    rem XORs fit below this mex bound.
    Gw = 2 * (Vs max + 1)
    Sr = St reshape 1 S
    Ca1 = Sr min Ur
    Cb1 = Ur - Sr max 0.0
    Cc = concat Ca1 Cb1 axis 1
    Z0 = Sr * 0 + Ur * 0
    Tg = concat Z0 (Z0 + 1) axis 1
    Od = Cc argsort axis 1
    R2n = 2 * R
    Rw = (0 to (R2n - 1)) reshape R2n 1
    Fx = Od + Rw * (2 * S)
    Cs = (Cc reshape (4 * R * S)) Fx
    Tr = (Tg reshape (4 * R * S)) Fx
    Ts = Tr integer
    Rr = 0 to (R2n - 1)
    Sc = 0 to (2 * S - 2)
    Cp = Cs Rr Sc
    Pv = concat (Rw * 0.0) Cp axis 1
    Ln = Cs - Pv
    Na = 1 - Ts
    Ca = (Na scan + axis 1) - Na
    Cb = (Ts scan + axis 1) - Ts
    Gx = Vs (Ca - 1 max 0)
    Gy = Vs (S - Cb - 1 max 0)
    Xo = Gx bxor Gy
    Ok2 = Ok reshape (2 * R) 1
    Pp = Ln greater Ep integer
    Vd = Pp * Ok2
    Rk = Rw mod R
    Ps = Rk * Gw + Xo
    Fl = (0 to (R * Gw - 1)) * 0
    Vf = Vd reshape (4 * R * S)
    Ix = Vf greater 0 indices
    Fl ((Ps reshape (4 * R * S)) Ix) = 1
    Bm = Fl reshape R Gw
    Gk = Bm scan min axis 1 sum axis 1
    Lv = Vs (S - 1 to S - 1)
    Pg = concat Lv (Gk (0 to (R - 2)))
    Ch = Gk not equal Pg indices
    if Ch len greater 0
      St = concat St (T0 Ch)
      Vs = concat Vs (Gk Ch)
    end
  end
end
rem Pass 2: m(u), the measure of x with
rem g(x) = g(u - x), is linear between
rem lattice points, so one sweep per gap
rem gives its value and slope (an end
rem moves with u when it is u or a
rem u - start). Then e(L) = L / 2 (m(L
rem - 1) / (L - 1) + m(L - sqrt 2) / (L
rem - sqrt 2)) is maximised over every
rem gap using its stationary points.
St = St copy
Vs = Vs copy
Runs = St len
Ka = (Bp less Lo integer) sum
Kz = (Bp less Hi integer) sum
Q1 = (0 to 0) * 0.0
Q2 = Q1 * 1
Q3 = Q1 * 1
Q4 = Q1 * 1
Q5 = Q1 * 1
Q6 = Q1 * 1
Q7 = Q1 * 1
Fst = 1
for Kb in Ka to Kz by 64
  Ks = Kb till (Kb + 64 min (Kz + 1))
  T0 = Bp Ks
  T1 = Bp (Ks + 1 min (Nb - 1))
  Lm = (T0 + T1) / 2.0
  R = Ks len
  Us = concat (Lm - 1.0) (Lm - Rt)
  rem Skip later runs for this block.
  S = (St less (Us max) integer) sum
  Sr = (St (0 till S) copy) reshape 1 S
  Ur = Us reshape (2 * R) 1
  Ia = Sr less Ur integer
  Ca1 = Sr min Ur
  Cb1 = Ur - Sr max 0.0
  Cc = concat Ca1 Cb1 axis 1
  Z0 = Sr * 0 + Ur * 0
  Ty = concat Z0 (Z0 + 1) axis 1
  Mv = concat (1 - Ia) Ia axis 1
  Od = Cc argsort axis 1
  R2n = 2 * R
  Rw = (0 to (R2n - 1)) reshape R2n 1
  Fx = Od + Rw * (2 * S)
  Fz = 4 * R * S
  Cs = (Cc reshape Fz) Fx
  Ts = ((Ty reshape Fz) Fx) integer
  Mo = ((Mv reshape Fz) Fx) integer
  Rr = 0 to (R2n - 1)
  Sc = 0 to (2 * S - 2)
  Cp = Cs Rr Sc
  Mq = Mo Rr Sc
  Pv = concat (Rw * 0.0) Cp axis 1
  Mp = concat (Rw * 0) Mq axis 1
  Ln = Cs - Pv
  Na = 1 - Ts
  Ca = (Na scan + axis 1) - Na
  Cb = (Ts scan + axis 1) - Ts
  Gx = Vs (Ca - 1 max 0)
  Gy = Vs (S - Cb - 1 max 0)
  Pos = Ln greater Ep integer
  Eq = (Gx equal Gy integer) * Pos
  Mm = Ln * Eq sum axis 1
  Sk = ((Mo - Mp) * Eq) sum axis 1
  Sl = Sk * 1.0
  M1 = Mm (0 to (R - 1))
  S1 = Sl (0 to (R - 1))
  M2 = Mm (R to (2 * R - 1))
  S2 = Sl (R to (2 * R - 1))
  Aa = T0 max (Lo * 1.0)
  Bb = T1 min (Hi * 1.0)
  if Fst equal 1
    Q1 = M1
    Q2 = S1
    Q3 = M2
    Q4 = S2
    Q5 = Lm
    Q6 = Aa
    Q7 = Bb
    Fst = 0
  else
    Q1 = concat Q1 M1
    Q2 = concat Q2 S1
    Q3 = concat Q3 M2
    Q4 = concat Q4 S2
    Q5 = concat Q5 Lm
    Q6 = concat Q6 Aa
    Q7 = concat Q7 Bb
  end
end
rem Split at the possible inflection.
C1 = Q1 - Q2 * (Q5 - 1.0)
C2 = Q3 - Q4 * (Q5 - Rt)
Safe = C1 equal 0.0 choose 1.0 C1
T = (Rt * C2 / Safe abs)
T = T ** (1.0 / 3.0)
Den = 1.0 - T
Safe = Den equal 0.0 choose 1.0 Den
Cut = (Rt - T) / Safe
Turn = C1 * C2 less 0.0
Turn = Turn and (Den not equal 0.0)
Cut = Turn choose Cut Q6
Q8 = Cut max Q6 min Q7
rem In each gap, e has the form
rem L/2 (D + A/(L-1) + B/(L-Rt)).
rem Its second derivative vanishes at
rem most once. Split there, then find
rem roots where the derivative changes
rem sign.
D = Q2 + Q4
Ea = D + C1 / (Q6 - 1.0)
Ea = Q6 / 2.0 * (Ea + C2 / (Q6 - Rt))
Eb = D + C1 / (Q7 - 1.0)
Eb = Q7 / 2.0 * (Eb + C2 / (Q7 - Rt))
Best = (Ea max) max (Eb max)
L = concat Q6 Q8
H = concat Q8 Q7
A = concat C1 C1
B = concat C2 C2
V = concat D D
DLeft = V - A / ((L - 1.0) ** 2)
DLeft -= Rt * B / ((L - Rt) ** 2)
DRight = V - A / ((H - 1.0) ** 2)
DRight -= Rt * B / ((H - Rt) ** 2)
Roots = DLeft * DRight less 0.0 indices
if Roots len greater 0
  Low = L Roots copy
  High = H Roots copy
  Sign = DLeft Roots copy
  Ac = A Roots copy
  Bc = B Roots copy
  Dc = V Roots copy
  for It in 1 to 60
    X = (Low + High) / 2.0
    F = Dc - Ac / ((X - 1.0) ** 2)
    F -= Rt * Bc / ((X - Rt) ** 2)
    Same = Sign * F greater 0.0
    Low = Same choose X Low
    High = Same choose High X
  end
  X = (Low + High) / 2.0
  E = Dc + Ac / (X - 1.0)
  E = X / 2.0 * (E + Bc / (X - Rt))
  Best = Best max (E max)
end
Answer = Best text ".8f"
return Answer
