use testing

test "small grids"
  use "289_eulerianloops"
  M = 1
  N = 1
  run

  Answer equal 1
  M = 1
  N = 2
  run

  Answer equal 2
  M = 2
  N = 2
  run

  Answer equal 37
  M = 2
  N = 3
  run

  Answer equal 672
  M = 3
  N = 2
  run

  Answer equal 672
  M = 3
  N = 3
  run

  Answer equal 104290
end
