use testing

test "six-pip dice"
  use "376_dice" as solve
  Answer = solve 6
  Answer equal 581
end

test "no nontransitive dice"
  use "376_dice" as solve
  Answer = solve 0
  Answer equal 0
  Answer = solve 4
  Answer equal 0
end

test "five-pip dice"
  use "376_dice" as solve
  Answer = solve 5
  Answer equal 15
end
