use testing

test "default input"
  use "085_countrectangles" as solve
  Answer = solve

  Answer equal 2772
end

test "statement three by two grid"
  use "085_countrectangles" as solve
  Answer = solve 18

  Answer equal 6
end

test "single cell"
  use "085_countrectangles" as solve
  Answer = solve 1

  Answer equal 1
end
