use testing

test "statement values"
  use "409_nimextreme" as solve
  Answer = solve 1
  Answer equal 1
  Answer = solve 2
  Answer equal 6
  Answer = solve 3
  Answer equal 168
  Answer = solve 5
  Answer equal 19764360
end

test "brute force for four heaps"
  use "409_nimextreme" as solve
  Answer = solve 4
  Answer equal 30240
end

test "one hundred heaps"
  use "409_nimextreme" as solve
  Answer = solve 100
  Answer equal 384777056
end

test "default input"
  use "409_nimextreme" as solve
  Answer = solve
  Answer equal 253223948
end
