use testing

rem Keep the full default in the manual execution lane.
test "small limits"
  use "216_primality" as solve
  Answer = solve 100

  Answer equal 45
  Answer = solve 10000

  Answer equal 2202
end

test "empty limits and repeated prime factors"
  use "216_primality" as solve
  Answer = solve 0
  Answer equal 0
  Answer = solve 1
  Answer equal 0
  Answer = solve 2
  Answer equal 1
  Answer = solve 5
  Answer equal 3
end
