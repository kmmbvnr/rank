rem First Sort II
rem https://projecteuler.net/problem=524

use sequences
use bits
use io
use cli

arg K integer = 8916100448256

rem Nonrecords cost 2^s, with s smaller
rem values before them. An identity
rem prefix doubles cost at equal rank.
fun Steps first_order
  if Steps equal 0
    return array 1
  end
  Low = Steps band (0 - Steps)
  Odd = Steps // Low
  rem For odd cost the minimal length
  rem is one more than its bit length.
  N = Odd binary len + 1
  Values = 0 till N copy
  Ceiling = 1 shl (N - 1)

  rem Pair the forced nonrecords with
  rem the lowest remaining bits.
  fun Used fits Bits
    if Bits at least Ceiling
      return false
    end
    Size = Used binary len
    Count = Used popcount
    Forced = Size - Count
    Available = Bits popcount
    Rest = Available - Forced
    if Rest less 0
      return false
    end
    rem Leave the largest free value
    rem as a record if it exceeds Used.
    if Rest greater 0
      Room = N - Size
      if Rest at least Room
        return false
      end
      Limit = (1 shl Count) - 1
      Small = Bits band Limit popcount
      if Small greater Forced
        return false
      end
    end
    if Forced equal 0
      return true
    end
    Slots = Bits bit Values indices
    Below = Values (0 till Size)
    Unused = not (Used bit Below)
    Free = Below Unused copy
    Mask = (1 shl Free) - 1
    Lower = Used band Mask popcount
    Scores = Slots (0 till Forced)
    Enough = Scores at least Lower
    Inside = Scores at most Free
    Good = Enough and Inside
    return Good all
  end

  fun State extend
    Used = State .used
    Bits = State .bits
    Order = State .order
    fun Value possible rank 0
      if Used bit Value
        return false
      end
      Flag = 1 shl Value
      Cost = Bits
      if Flag less Used
        Mask = Flag - 1
        Score = Used band Mask popcount
        if not (Bits bit Score)
          return false
        end
        Cost -= 1 shl Score
      end
      Next = Used + Flag
      return Next fits Cost
    end

    Valid' = Values possible
    Value = Values first where Valid
    Bit = 1 shl Value
    if Bit less Used
      LowerMask = Bit - 1
      Below = Used band LowerMask
      Index = Below popcount
      Bits -= 1 shl Index
    end
    Entry = array (Value + 1)
    return record
      .used = Used + Bit
      .bits = Bits
      .order = concat Order Entry
    end
  end

  Seed = record
    .used = 0
    .bits = Odd
    .order = array shape 0 fill 0
  end
  Final = Seed extend repeat N
  return Final .order
end

rem Later smaller entries give the
rem factorial digits of the rank.
fun Order rank_of
  Size = Order len
  Slots = 0 till Size copy
  Column = Order reshape Size 1
  Rows = Slots reshape Size 1
  Earlier = Rows less Slots
  Smaller = Column greater Order
  Pairs = (Smaller and Earlier) integer
  Counts = Pairs sum axis 1
  Weights = 1 till Size scan *
  Weights = concat (array 1) Weights
  Places = Size - 1 - Slots
  Units = Weights Places
  return Counts * Units sum + 1
end

P = K first_order
Answer = P rank_of
return Answer
