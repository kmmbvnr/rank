use testing

test "default input"
  use "081_pathtwoways"
  run

  Answer equal 427337
end

test "statement matrix"
  use "081_pathtwoways"
  use io
  Grid = "131,673,234,103,18\n201,96,342,965,150\n630,803,746,422,111\n537,699,497,121,956\n805,732,524,37,331\n"
  Grid "/tmp/euler081.txt" write
  Input = "/tmp/euler081.txt"
  run

  Answer equal 2427
end

test "single cell and single row"
  use "081_pathtwoways"
  use io
  "7\n" "/tmp/euler081.txt" write
  Input = "/tmp/euler081.txt"
  run

  Answer equal 7
  "1,2,3\n" "/tmp/euler081.txt" write
  run

  Answer equal 6
end
