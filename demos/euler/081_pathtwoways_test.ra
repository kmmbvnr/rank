use testing

test "default input"
  use "081_pathtwoways"
  run

  Answer equal 427337
end

test "statement matrix"
  use "081_pathtwoways"

  Rows = array "131,673,234,103,18" "201,96,342,965,150" "630,803,746,422,111" "537,699,497,121,956" "805,732,524,37,331"
  Rows two_ways equal 2427
end

test "single cell and single row"
  use "081_pathtwoways"

  (array "7") two_ways equal 7
  (array "1,2,3") two_ways equal 6
end
