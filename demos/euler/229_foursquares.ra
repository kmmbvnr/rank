rem Four Representations using Squares
rem https://projecteuler.net/problem=229
rem Count the n up to Limit that are
rem a^2 + b^2, a^2 + 2 b^2, a^2 + 3 b^2
rem and a^2 + 7 b^2 for positive a and b

use numbers
use sequences
use io
use cli

arg Limit integer = 2000000000

rem With a and b allowed to be 0, n is
rem all four when n = q m^2, q
rem squarefree with every prime p = 1,
rem 25 or 121 mod 168. Those n number
rem the m up to sqrt(Limit / q) for each
rem such q, so the sum is over the
rem primes p, and the pairs and triples
rem of them, with the count of m with q
rem m^2 up to Limit being a count of the
rem primes up to Limit / (q' m^2) for
rem the last prime, found by binary
rem search on the sorted list of these
rem primes, sieved by classes mod 168.
rem Squares have b = 0 too often: q = 1
rem is dropped. Count the positive
rem representations of m^2 separately
rem from the prime factors of m.
Rt = Limit isqrt
Pq = primes till (Rt + 1) array
Gp = array shape 0 fill 0
Rc = array 1 25 121
for R in Rc
  Kn = (Limit - R) // 168 + 1
  Sv = array shape Kn fill 0
  for Q in Pq
    if Q less 5 or Q equal 7
      continue
    end
    Iv = 1
    Bs = 168 mod Q
    Ex = Q - 2
    for
      if Ex equal 0
        break
      end
      if Ex mod 2 equal 1
        Iv = Iv * Bs mod Q
      end
      Bs = Bs * Bs mod Q
      Ex = Ex // 2
    end
    K0 = (Q - R mod Q) mod Q * Iv mod Q
    Ks = (Q * Q - R + 167) // 168
    if Ks less 0
      Ks = 0
    end
    Fk = Ks + (K0 - Ks) mod Q
    Sv (Fk till Kn by Q) = 1
  end
  Ix = 0 till Kn array
  Keep = Sv equal 0
  Pm = ((Ix filter Keep) * 168 + R) copy
  Gp = concat Gp Pm copy
end
Gp = Gp filter (Gp greater 1) array
Gp = Gp sort
Ng = Gp len
Qx = array shape 100000 fill 0
Qs = array shape 100000 fill 0
Nq = 0
for M in 1 to Rt
  X = Limit // (M * M)
  if X less 193
    break
  end
  Qx Nq = X
  Nq += 1
end
for I in 0 till Ng
  P1 = Gp I
  if P1 * P1 greater Limit
    break
  end
  for M in 1 to Rt
    X = Limit // (P1 * M * M)
    if X at most P1
      break
    end
    Qx Nq = X
    Qs Nq = I + 1
    Nq += 1
  end
  for J in (I + 1) till Ng
    P2 = Gp J
    if P1 * P2 * P2 greater Limit
      break
    end
    for M in 1 to Rt
      X = Limit // (P1 * P2 * M * M)
      if X at most P2
        break
      end
      Qx Nq = X
      Qs Nq = J + 1
      Nq += 1
    end
  end
end
Total = 0
for Qi in 0 till Nq
  X = Qx Qi
  Lo = 0
  Hi = Ng
  for
    if Lo at least Hi
      break
    end
    Md = (Lo + Hi) // 2
    if Gp Md at most X
      Lo = Md + 1
    else
      Hi = Md
    end
  end
  Total += Lo - Qs Qi
end
Sp = array shape (Rt + 1) fill 0
for P in 2 to (Rt isqrt)
  if Sp P equal 0
    for J in (P * P) to Rt by P
      if Sp J equal 0
        Sp J = P
      end
    end
  end
end
rem Positive representations of m^2 need
rem a prime p in these classes in m:
rem d=1: p=1 mod 4; d=2: p=1,3 mod 8;
rem d=3: p=1 mod 3; d=7: odd p=1,2,4
rem mod 7. Also 2 divides m suffices for
rem d=3, and 4 divides m for d=7, from
rem 2^2=1+3 and 4^2=9+7.
Sq = 0
for M in 1 to Rt
  F1 = 0
  F2 = 0
  F3 = 0
  F7 = 0
  if M mod 2 equal 0
    F3 = 1
  end
  if M mod 4 equal 0
    F7 = 1
  end
  V = M
  for
    if V equal 1
      break
    end
    P = Sp V
    if P equal 0
      P = V
    end
    if P mod 4 equal 1
      F1 = 1
    end
    R8 = P mod 8
    if R8 equal 1 or R8 equal 3
      F2 = 1
    end
    if P mod 3 equal 1
      F3 = 1
    end
    R7 = P mod 7
    if P not equal 2 and (R7 equal 1 or R7 equal 2 or R7 equal 4)
      F7 = 1
    end
    for
      if V mod P greater 0
        break
      end
      V = V // P
    end
  end
  Sq += F1 * F2 * F3 * F7
end
Answer = Total + Sq
Answer print
