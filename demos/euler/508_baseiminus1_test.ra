use testing

test "statement values"
  use "508_baseiminus1" as solve
  Answer = solve 1
  Answer equal 20
  Answer = solve 2
  Answer equal 75
end

test "recursion against brute force"
  use "508_baseiminus1" as solve
  Answer = solve 20 1
  Answer equal 10235
  Answer = solve 1000 1024
  Answer equal 47138470
end
