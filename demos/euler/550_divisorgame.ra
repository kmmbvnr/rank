rem Divisor game
rem https://projecteuler.net/problem=550
use numbers
use sequences
use bits
use algo
use io
use cli
arg N integer = 10000000
arg K integer = 1000000000000
Mod = 987654321
Primes = primes to N copy
rem Products have nondecreasing primes.
rem Count all last primes in one query.
fun State grow
  Products = State .products
  First = State .first
  Bounds = N // Products
  Available = Primes upperindex Bounds
  Choices = Available - First
  Count = Choices sum
  rem Expand only extendable prefixes.
  Roots = Bounds isqrt
  Last = Primes upperindex Roots
  Lengths = Last - First
  Lengths = Lengths max 0
  Ends = Lengths scan +
  Begin = Ends - Lengths
  Size = Lengths sum
  Positions = 0 till Size copy
  Owners = Ends upperindex Positions
  Indices = First Owners + Positions
  Indices -= Begin Owners
  Parents = Products Owners
  Next = Parents * Primes Indices
  Histogram = State .histogram
  Added = array Count
  return record
    .products = Next copy
    .first = Indices copy
    .histogram = concat Histogram Added
  end
end
fun Before done After
  Products = After .products
  return Products len equal 0
end
Seed = record
  .products = array 1
  .first = array 0
  .histogram = array 0
end
Levels = N binary len
Tree = Seed grow repeat Levels till done
Histogram = Tree .histogram
Width = Histogram len - 1
rem The mex depends only on Omega(n).
Digits = Width binary len
SeenSize = 2 ** (2 * Digits)
Grundy = array shape (Width + 1) fill 0
for W in 2 to Width
  Previous = Grundy (1 till W)
  Matrix = Previous Previous outer bxor
  Size = (W - 1) * (W - 1)
  Moves = Matrix reshape Size
  Seen = array shape SeenSize fill false
  Seen Moves = true
  Missing = Seen equal false indices
  Grundy W = Missing first
end
Largest = Grundy max
Bits = Largest binary len
Size = 2 ** Bits
Groups = Histogram
Counts = Groups sum by Grundy size Size
Positions = 0 till Size copy
Signs = Positions Positions outer band
Signs = Signs popcount mod 2
Weights = 1 - 2 * Signs
Transform = Weights * Counts sum axis 1
Reduced = Transform mod Mod
Powers = Reduced K Mod powmod
rem Mod is odd, so Size is invertible.
Trials = 0 till Size copy
Remainder = (Mod * Trials + 1) mod Size
Selected = Remainder equal 0 indices
Trial = Trials (Selected first)
Inverse = (Mod * Trial + 1) // Size
Lost = Powers sum
Lost = Lost mod Mod * Inverse mod Mod
Items = (N - 1) max 0
All = Items K Mod powmod
return (All - Lost) mod Mod
