use testing

test "empty totient stairs"
  use "337_totientstairs"
  Limit = 0
  run
  Answer equal 0
end

test "totient stairs seed"
  use "337_totientstairs"
  Limit = 6
  run
  Answer equal 1
end

test "small totient stairs"
  use "337_totientstairs"
  Limit = 10
  run
  Answer equal 4
end

test "given totient stairs"
  use "337_totientstairs"
  Limit = 100
  run
  Answer equal 82073668
end

test "medium totient stairs"
  use "337_totientstairs"
  Limit = 10000
  run
  Answer equal 73808307
end
