use testing

test "statement value"
  use "474_lastdigitsdivisors" as solve
  Answer = solve 50 123
  Answer equal 17888
end

test "brute force values"
  use "474_lastdigitsdivisors" as solve
  Answer = solve 40 7
  Answer equal 65664
  Answer = solve 45 1750
  Answer equal 110880
  Answer = solve 80 65432
  Answer equal 14894618
end

test "saturated valuation"
  use "474_lastdigitsdivisors" as solve
  Answer = solve 12 12
  Answer equal 11
end
