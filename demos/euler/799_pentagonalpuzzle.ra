rem Pentagonal Puzzle
rem https://projecteuler.net/problem=799

use numbers
use sequences
use io
use cli

arg Limit integer = 28000000
arg Least integer = 100
arg Floor integer = 240

rem P(a) + P(b) = P(n) is
rem x^2 + y^2 = (6n - 1)^2 + 1 = N with
rem x = 6a - 1, y = 6b - 1.
rem Keep the original candidate filter:
rem N / 2 is 400-smooth and has at least
rem Floor divisors. This filter alone is
rem not a proof of global minimality.
rem Two roots modulo each prime locate
rem its multiples without full scans.
rem Count surviving pairs exactly via
rem Gaussian prime factors.
Ns = 1 to Limit
Side = 6 * Ns - 1
Rest = (Side * Side + 1) // 2
Divs = Ns * 0 + 1
Cand = primes to 400 copy
Cand = Cand filter (Cand mod 4 equal 1)
for Index in 0 to Cand len - 1
  Prime = Cand Index
  Roots = 1 till Prime
  Squares = Roots * Roots mod Prime
  Matches = Roots (
    Squares equal Prime - 1)
  Root = Matches first
  Inverse = 6 (Prime - 2) Prime powmod
  Start = (Root + 1) * Inverse - 1
  Other = (1 - Root) * Inverse - 1
  Start = Start mod Prime
  Other = Other mod Prime
  Ids = concat (
    Start till Limit by Prime) (
    Other till Limit by Prime)
  Sub = Rest Ids
  Part = Sub gcd (Prime ** 22)
  Count = (Part log) / (Prime log) + 0.5
  Pow = Count integer
  Rest Ids = Sub // Part
  Divs Ids = Divs Ids * (Pow + 1)
end
Rich = Divs at least Floor
Smooth = (Rest equal 1) and Rich
Picks = (0 till Limit) Smooth
Nums = Picks + 1
Counts = Nums pair_count rank 0
Found = Nums (Counts greater Least)
First = Found min
Answer = First * (3 * First - 1) // 2


rem Each Gaussian factor chooses a prime
rem or its conjugate. Units and ordering
rem disappear by keeping distinct Xs.
fun Num pair_count
  Side = 6 * Num - 1
  Half = (Side * Side + 1) // 2
  unpack Real Imag = (
    Half representations)
  Real = Real abs
  Imag = Imag abs
  Xs = Real max Imag
  Ys = Real min Imag
  Good = (Xs mod 6 equal 5) and (
    Ys mod 6 equal 5)
  return Xs Good unique len
end


memo Prime component
  Bound = Prime isqrt
  Imag = 1 to Bound
  Squares = Prime - Imag * Imag
  Real = Squares isqrt
  Good = Real * Real equal Squares
  X = Real Good first
  return X
end


fun Prime powers Exponent
  if Exponent equal 0
    return tuple (array 1) (array 0)
  end
  X = Prime component
  Y = (Prime - X * X) isqrt
  Previous = Prime powers (Exponent - 1)
  unpack Real Imag = Previous
  FirstReal = Real 0 * X + Imag 0 * Y
  FirstImag = Imag 0 * X - Real 0 * Y
  NextReal = Real * X - Imag * Y
  NextImag = Real * Y + Imag * X
  Reals = concat (
    array FirstReal) NextReal
  Imags = concat (
    array FirstImag) NextImag
  return tuple Reals Imags
end


fun N representations
  if N equal 1
    return tuple (array 1) (array 1)
  end
  unpack Primes Counts = (
    N factors unique .counts)
  Prime = Primes 0
  Exponent = Counts 0
  Rest = N // Prime ** Exponent
  unpack Real Imag = (
    Rest representations)
  unpack X Y = Prime powers Exponent
  Across = Real X outer *
  Along = Imag Y outer *
  Reals = Across - Along
  Across = Real Y outer *
  Along = Imag X outer *
  Imags = Across + Along
  Count = Real len
  Width = X len
  Size = Count * Width
  FlatReal = Reals reshape Size
  FlatImag = Imags reshape Size
  return tuple FlatReal FlatImag
end
return Answer
