rem Consecutive Die Throws
rem https://projecteuler.net/problem=423

use numbers
use sequences
use io
use cli

option L integer = 50000000

rem C(n) = 6 P(n-1, pi(n)) with
rem P(m, t) = sum of C(m, k) 5^(m-k)
rem for k <= t. Row step: P' = 6 P -
rem U with U = C(m, t) 5^(m-t), and
rem a new prime moves t up by one.
rem Inverses mod Q come from the
rem linear recurrence.
Q = 1000000007
Top = L max 6 + 1
Iv = array shape (Top + 1) fill 1
for I in 2 to Top
  Lo = Q - Q // I
  Iv I = Lo * Iv (Q mod I) mod Q
end
I5 = Iv 5
Pr = primes to L array
Pn = Pr len
Np = 0
Tot = 6
Cur = 1
Un = 1
T = 0
for N in 1 to L - 1
  M = N - 1
  Cur = (6 * Cur - Un) mod Q
  Un = 5 * Un mod Q * (M + 1) mod Q
  Un = Un * Iv (M + 1 - T) mod Q
  if Np less Pn
    if Pr Np equal N + 1
      Un = Un * (M + 1 - T) mod Q
      Un = Un * Iv (T + 1) mod Q
      Un = Un * I5 mod Q
      Cur = (Cur + Un) mod Q
      T += 1
      Np += 1
    end
  end
  Tot += 6 * Cur
end
Answer = Tot mod Q
Answer print
