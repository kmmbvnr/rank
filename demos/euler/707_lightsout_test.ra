use testing

test "statement values"
  use "707_lightsout"
  Width = 3
  Count = 3
  run
  Answer equal 32
  Width = 4
  Count = 5
  run
  Answer equal 1052960
  Width = 5
  Count = 7
  run
  Answer equal 346547294
end

test "empty and single-cell widths"
  use "707_lightsout"
  Width = 0
  Count = 3
  run
  Answer equal 3
  Width = 1
  Count = 1
  run
  Answer equal 2
  Width = 3
  Count = 0
  run
  Answer equal 0
end
