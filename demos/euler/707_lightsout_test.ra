use testing

test "statement values"
  use "707_lightsout" as solve
  Answer = solve 3 3
  Answer equal 32
  Answer = solve 4 5
  Answer equal 1052960
  Answer = solve 5 7
  Answer equal 346547294
end

test "empty and single-cell widths"
  use "707_lightsout" as solve
  Answer = solve 0 3
  Answer equal 3
  Answer = solve 1 1
  Answer equal 2
  Answer = solve 3 0
  Answer equal 0
end
