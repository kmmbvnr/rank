rem Product-sum Numbers
rem https://projecteuler.net/problem=88
rem Sum the distinct minimal product-sum
rem numbers for sizes 2 up to a limit

use sequences
use io
use cli

option Limit integer = 12000

rem Factors with product P, sum S and
rem count n give k = P - S + n, the rest
rem being ones. Grow all factor lists a
rem factor at a time, never decreasing.
Big = Limit * 2
Best = array shape (Limit + 1) fill Big
Prod = array 1
Sum = array 0
Cnt = array 0
Low = array 2
for Prod len greater 0
  K' = Prod - Sum + Cnt
  Ok = Cnt greater 1 and K at most Limit
  Ks = K Ok array
  Ps = Prod Ok array
  Cur = Best Ks
  Val = Ps Cur min
  rem Last write wins for a repeated K:
  rem put its smallest value last.
  Ord = Val argsort .descending
  Best (Ks Ord) = Val Ord
  Num' = (Big // Prod) - Low + 1
  Num0 = Num 0 max
  Has = Num0 greater 0
  P1 = Prod Has array
  S1 = Sum Has array
  C1 = Cnt Has array
  L1 = Low Has array
  N1 = Num0 Has array
  Total = N1 sum
  Starts = N1 scan + with 0
  Marks = array shape Total fill 0
  Marks (Starts take (N1 len)) += 1
  Owner = (Marks scan +) - 1
  Each' = 0 till Total
  Pos' = Each - (Starts Owner)
  F = (L1 Owner) + Pos
  Prod = (P1 Owner) * F
  Sum = (S1 Owner) + F
  Cnt = (C1 Owner) + 1
  Low = F
end
Mins = Best drop 2 unique
Answer = Mins sum
Answer print
