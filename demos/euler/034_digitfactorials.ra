rem Digit Factorials
rem https://projecteuler.net/problem=34
rem Sum numbers equal to the sum of the
rem factorials of their decimal digits

use ranges
use sequences
use text
use algo
use numbers
use io

Answer = 7 digit_factorial_sum
Answer print


rem Enumerate digit multisets instead of all
rem 2.5 million integers below seven times 9!.
fun digit_factorial_sum MaximumDigits
  Factorials = array shape 10
    1 1 2 6 24 120
    720 5040 40320 362880
  end
  Matches = new set

  for Length in 2 to MaximumDigits
    0 Length "" 0 search
  end
  return Matches sum

  rem Generate nondecreasing digit text and
  rem compare it with the factorial sum digits.
  fun search First Remaining Digits Sum
    if Remaining equal 0
      Candidate = Sum text sort
      if Candidate equal Digits
        Matches add Sum
      end
      return 0
    end

    for Digit in First to 9
      NextDigits = Digits + Digit text
      NextRemaining = Remaining - 1
      NextSum = Sum + Factorials Digit
      Digit NextRemaining NextDigits NextSum search
    end
    return 0
  end
end
