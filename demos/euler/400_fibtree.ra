rem Fibonacci Tree Game
rem https://projecteuler.net/problem=400

use bits
use algo
use sequences
use io
use cli

option K integer = 10000

Mod = 1000000000000000000
Gs = array shape (K + 1) fill 0
if K at least 2
  Gs 2 = 1
end
for N in 3 to K
  A = 1 + Gs (N - 1)
  B = 1 + Gs (N - 2)
  Gs N = A B bxor
end

rem XOR operands stay below Stride.
rem Key = N * Stride + T + 1.
Stride = 1
for Stride at most (1 + Gs max)
  Stride *= 2
end
Answer = K Gs Stride Mod cuts
Answer print

fun K Gs Stride Mod cuts
  Cache = new index
  Tasks = new stack
  Values = new stack
  Tasks push K * Stride + 1
  Value = 0
  for (Tasks len) greater 0
    Key = Tasks pop
    if Key equal -1
      rem Save the first child's result.
      Values push Value
    elif Key less 0
      rem Combine the two child results.
      Value += Values pop
      if Value at least Mod
        Value -= Mod
      end
      Cache (-Key) = Value
    else
      Cached = Cache Key default -1
      if Cached at least 0
        Value = Cached
      else
        N = Key // Stride
        T = Key mod Stride - 1
        if T equal -1
          Value = 1
        elif N at most 1
          Value = 0
        elif N equal 2
          Value = 0
          if T equal 0
            Value = 1
          end
        else
          A = 1 + Gs (N - 1)
          B = 1 + Gs (N - 2)
          Right = A T bxor
          Left = B T bxor
          Base = (N - 2) * Stride
          rem Right, save, left, sum.
          Tasks push -Key
          Next = Base + Stride + Left
          Tasks push Next
          Tasks push -1
          Tasks push Base + Right
        end
      end
    end
  end
  return Value
end
