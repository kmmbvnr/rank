rem Fibonacci Tree Game
rem https://projecteuler.net/problem=400

use bits
use sequences
use io
use cli

arg K integer = 10000

Mod = 1000000000000000000
Gs = array shape (K + 1) fill 0
if K at least 2
  Gs 2 = 1
end
for N in 3 to K
  A = 1 + Gs (N - 1)
  B = 1 + Gs (N - 2)
  Gs N = A bxor B
end

rem XOR operands stay below Stride.
Stride = 1
for Stride at most (1 + Gs max)
  Stride *= 2
end
Answer = K Gs Stride Mod cuts
Answer print

fun K Gs Stride Mod cuts
  rem Slot J counts target J - 1.
  rem Keep only two preceding DP rows.
  Ts = 0 till Stride array
  Prev = array shape (Stride + 1) fill 0
  Prev 0 = 1
  Older = Prev
  if K at least 2
    Prev 1 = 1
  end
  for N in 3 to K
    A = 1 + Gs (N - 1)
    B = 1 + Gs (N - 2)
    Counts = (Prev (Ts bxor B) +
      Older (Ts bxor A)) mod Mod
    Older = Prev
    Prev = concat (array 1) Counts
  end
  return Prev 1
end
