rem 47-smooth Triangular Numbers
rem https://projecteuler.net/problem=581
use numbers
use bits
use sequences
use io
use cli
arg B integer = 10000000000000
Bound = B max 0
Maximum = 4 * Bound + 1
Digits = Maximum binary len
Primes = primes till 48 copy
Product = Primes reduce * with 1
rem One gcd tests the smooth part.
Allowed = Product ** Digits

rem Squarefree parts of smooth products.
fun Values extend Prime
  return concat Values (Values * Prime)
end
Seed = array 1
Parts = Primes reduce extend with Seed
Good = Parts greater 1
Ceiling = Maximum * Maximum - 1
Good = Good and (Parts at most Ceiling)
Parts = Parts Good

rem X^2 - D Y^2 = 1 gives index (X-1)/2.
fun D subtotal
  Root = D isqrt
  Offset = 0
  Scale = 1
  Term = Root
  X = Root
  PreviousX = 1
  Y = 1
  PreviousY = 0
  Found = false
  BaseX = 0
  BaseY = 0
  Total = 0
  for X at most Maximum
    rem Stop convergents at the bound.
    if not Found
      if X * X - D * Y * Y equal 1
        BaseX = X
        BaseY = Y
        Found = true
      else
        Offset = Scale * Term - Offset
        Square = Offset * Offset
        Scale = (D - Square) // Scale
        Term = (Root + Offset) // Scale
        Next = Term * X + PreviousX
        PreviousX = X
        X = Next
        Next = Term * Y + PreviousY
        PreviousY = Y
        Y = Next
        continue
      end
    end
    if X mod 2 equal 1
      if Y gcd Allowed equal Y
        Total += (X - 1) // 2
      end
    end
    rem Powers give all Pell solutions.
    Next = BaseX * X + D * BaseY * Y
    Y = BaseY * X + BaseX * Y
    X = Next
  end
  return Total
end
Totals = Parts subtotal rank 0
Answer = Totals sum
Answer print
