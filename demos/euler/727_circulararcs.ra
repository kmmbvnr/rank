rem Triangle of Circular Arcs
rem https://projecteuler.net/problem=727

use numbers
use sequences
use io
use cli

arg Limit integer = 100

rem Centres: O_a at the origin, O_b on
rem the axis, O_c from the law of
rem cosines. Tangency points split the
rem centre segments in the ratio of the
rem radii; D is their circumcentre. The
rem inner Soddy circle has radius r from
rem Descartes' theorem and its centre E
rem follows from two linear equations.
Radii = 1 to Limit
First = Radii reshape Limit 1 1
Second = Radii reshape 1 Limit 1
Third = Radii reshape 1 1 Limit
Common = (First gcd Second) gcd Third
Order = First less Second
Order = Order and (Second less Third)
Valid = Order and (Common equal 1)
rem Invalid cells get the triple 1 2 3.
Zero = First * 0 + Second * 0
Zero = Zero + Third * 0
SafeA = (First + Zero) * 1.0
SafeB = (Second + Zero) * 1.0
SafeC = (Third + Zero) * 1.0
A = Valid choose SafeA 1.0
B = Valid choose SafeB 2.0
C = Valid choose SafeC 3.0
SideAB = A + B
SideAC = A + C
SideBC = B + C
Numer = SideAC ** 2 + SideAB ** 2
Numer = Numer - SideBC ** 2
CenterX = Numer / (2 * SideAB)
Height = SideAC ** 2 - CenterX ** 2
CenterY = Height sqrt
RatioA = A / SideAC
RatioB = B / SideBC
TouchX = RatioA * CenterX
TouchY = RatioA * CenterY
Reach = CenterX - SideAB
OtherX = SideAB + RatioB * Reach
OtherY = RatioB * CenterY
Drop = TouchY - OtherY
Det = A * Drop + TouchX * OtherY
Det = 2 * (Det - OtherX * TouchY)
NormP = A ** 2
NormQ = TouchX ** 2 + TouchY ** 2
NormS = OtherX ** 2 + OtherY ** 2
NumX = NormP * Drop + NormQ * OtherY
NumX = NumX - NormS * TouchY
Wide = OtherX - TouchX
Back = A - OtherX
NumY = NormP * Wide + NormQ * Back
NumY = NumY + NormS * (TouchX - A)
CircX = NumX / Det
CircY = NumY / Det
Curve1 = 1.0 / A
Curve2 = 1.0 / B
Curve3 = 1.0 / C
Cross = Curve1 * Curve2
Cross = Cross + Curve2 * Curve3
Cross = Cross + Curve3 * Curve1
Root = Cross sqrt
Sum = Curve1 + Curve2 + Curve3
Inner = 1.0 / (Sum + 2 * Root)
ToA = A + Inner
ToB = B + Inner
InX = SideAB ** 2 + ToA ** 2 - ToB ** 2
InX = InX / (2 * SideAB)
InY = CenterX ** 2 + CenterY ** 2
InY = InY + ToA ** 2 - (C + Inner) ** 2
InY = InY - 2 * CenterX * InX
InY = InY / (2 * CenterY)
Dx = CircX - InX
Dy = CircY - InY
Dist = (Dx ** 2 + Dy ** 2) sqrt
Weight = Valid integer
Weighted = Dist * Weight
Total = Weighted sum
Count = Weight sum
Mean = Total / Count
Answer = Mean text ".8f"
Answer print
