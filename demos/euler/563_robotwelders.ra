rem Robot Welders
rem https://projecteuler.net/problem=563
use numbers
use sequences
use algo
use bits
use io
use cli
arg L integer = 60000000
arg K integer = 100
if L less 1 or K less 0
  .DomainError "invalid bounds" raise
end
Digits = L binary len
End = (L * 10 // 11) ** 2
rem Add one prime's allowable powers.
fun Values extend Prime
  Powers = Prime ** (0 till Digits)
  Bounds = L // Values
  Counts = Powers upperindex Bounds
  Ends = Counts scan +
  Begins = Ends - Counts
  Size = Counts sum
  Positions = 0 till Size copy
  Owners = Ends upperindex Positions
  Exponents = Positions - Begins Owners
  Factors = Powers Exponents
  return Values Owners * Factors
end
Primes = primes till 24 copy
Base = array 1
Smooth = Primes reduce extend with Base
Smooth = Smooth sort
rem Split bands above a million pairs.
rem Measured 256K, 512K and 1M on Mac;
rem 1M keeps sorting fast and RSS low.
Batch = 1048576
fun Low pairBand High
  Need = (10 * Low + 10) // 11
  Root = Need isqrt
  Round = Root * Root less Need integer
  Minimum = Root + Round
  Maximum = High - 1 isqrt
  Start = Smooth lowerindex Minimum
  Stop = Smooth upperindex Maximum
  Sides = Smooth (Start till Stop)
  Lower = (Low + Sides - 1) // Sides
  Lower = Lower max Sides
  Upper = 11 * Sides // 10
  Ceiling = (High - 1) // Sides
  Upper = Upper min Ceiling
  First = Smooth lowerindex Lower
  Last = Smooth upperindex Upper
  Counts = Last - First max 0
  Size = Counts sum
  if Size greater Batch
    if High greater Low + 1
      Middle = (Low + High) // 2
      return Low pairBand Middle
    end
  end
  return record
    .high = High
    .sides = Sides
    .first = First
    .counts = Counts
  end
end
rem Count complete disjoint area bands.
fun State step
  Low = State .low
  Minima = State .minima
  if Low at least End
    return State
  end
  High = Low * 4 min End
  Band = Low pairBand High
  High = Band .high
  Sides = Band .sides
  First = Band .first
  Counts = Band .counts
  Ends = Counts scan +
  Begins = Ends - Counts
  Size = Counts sum
  if Size greater 0
    Places = 0 till Size copy
    Owners = Ends upperindex Places
    Offsets = Places - Begins Owners
    Indices = First Owners + Offsets
    Long = Smooth Indices
    Areas = Sides Owners * Long
    Areas = Areas sort
    Grouped = Areas unique .counts
    unpack Areas Runs = Grouped
    Good = Runs at least 2
    Good = Good and (Runs at most K)
    Runs = Runs Good
    Areas = Areas Good
    Local = Areas min by Runs with Empty
    Positions = 0 till (Local len)
    Old = Minima Positions
    Minima Positions = Old min Local
  end
  Found = Minima less Empty integer sum
  return record
    .low = High
    .minima = Minima
    .found = Found
  end
end
fun Before done After
  Full = After .found equal (K + 1)
  Last = After .low at least End
  return Full or Last
end
Empty = End max 1
Minima = array shape (K + 1) fill Empty
Unused = 0 to (K min 1)
Minima Unused = 0
Known = Unused len
Seed = record
  .low = 1
  .minima = Minima
  .found = Known
end
Final = Seed step repeat End till done
Minima = Final .minima
Found = Final .found - 2
Found = Found max 0
if Found less (K - 1)
  .SearchError "increase L" raise
end
Answer = Minima sum
return Answer
