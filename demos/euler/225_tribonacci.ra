rem Tribonacci Non-divisors
rem https://projecteuler.net/problem=225
rem Find the Nth odd number that divides
rem no term of the tribonacci sequence

use numbers
use io
use cli

arg N integer = 124

rem Terms mod m repeat from (1, 1, 1),
rem so m divides a term exactly when the
rem walk reaches 0 before returning.
Found = 0
Answer = 0
for M in 3 to 100000 by 2
  A = 1
  B = 1
  C = 1
  Hit = 0
  for
    D = (A + B + C) mod M
    A = B
    B = C
    C = D
    if D equal 0
      Hit = 1
      break
    end
    if A + B + C equal 3
      break
    end
  end
  if Hit equal 0
    Found += 1
    if Found equal N
      Answer = M
      break
    end
  end
end
Answer print
