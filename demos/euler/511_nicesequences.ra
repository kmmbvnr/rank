rem Sequences with nice divisibility
rem properties
rem https://projecteuler.net/problem=511

use numbers
use sequences
use io
use cli

arg N integer = 1234567898765
arg K integer = 4321

rem Count the divisors of n by residue
rem mod k; n picks multiply in the
rem ring Z[x]/(x^k - 1), so raise that
rem vector to the n-th power by
rem squaring and read residue -n.
Md = 1000000000
rem Fold the polynomial product modulo
rem x^K - 1, using exact modular NTT.
fun F conv G
  Kk = G len
  Pr = F convolve G mod Md
  Pd = concat Pr (array 0)
  Mt = Pd reshape 2 Kk
  return Mt sum axis 0 mod Md
end
rem Divisors of N from its factors.
Ds = array 1
X = N
P = 2
for P * P at most X
  E = 0
  for X mod P equal 0
    X //= P
    E += 1
  end
  if E greater 0
    Pw = P ** (0 to E)
    Nd = Ds len
    Dm = (Ds reshape Nd 1) * Pw
    Ds = Dm reshape (Nd * (E + 1))
  end
  P += 1
end
if X greater 1
  Ds = concat Ds (Ds * X)
end
C = array shape K fill 0
for D in Ds
  C (D mod K) += 1
end
R = array shape K fill 0
R 0 = 1
E = N
for E greater 0
  if E mod 2 equal 1
    R = R conv C
  end
  C = C conv C
  E //= 2
end
Answer = R ((0 - N) mod K)
Answer print
