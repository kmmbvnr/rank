rem Maximum quadrilaterals
rem https://projecteuler.net/problem=538

use numbers
use sequences
use bits
use algo
use io
use cli

arg N integer = 3000000

rem For a fixed largest side the best
rem quadrilateral takes the three next
rem smaller values, so only consecutive
rem 4-blocks of the sorted prefix count,
rem scored by exact 16 * area^2. The
rem best only grows, and the prefix
rem changes the blocks only when a value
rem gets its 1st to 4th copy: step over
rem those events, testing the blocks
rem that hold the new copy. A sum tree
rem finds neighbours by prefix counts.
Answer = 0
if N at least 4
  Inputs = 1 to N copy
  Triple = 3 * Inputs popcount
  Bits = Inputs popcount
  Next = Inputs + 1 popcount
  Terms = 2 ** Triple + 3 ** Bits + Next
  Sides = Terms unique sort
  Keys = Sides lowerindex Terms
  unpack Rows Order = Keys sort .indexed
  Size = Rows len
  Positions = 0 till Size copy
  Tail = Rows (1 till Size)
  Head = Rows (0 till Size - 1)
  New = Tail greater Head
  Starts = concat (array true) New
  rem Sorted ranks are group numbers.
  First = Starts indices
  Copy = Positions - First Rows
  rem Keep four copies of each value.
  Keep = Copy less 4 indices
  Times = (Order Keep) + 1
  Owners = Rows Keep
  Events = Times argsort
  Times = Times Events
  Owners = Owners Events
  Length = Times len
  Distinct = Sides len
  Empty = array shape Distinct fill 0
  Counts = Empty segment +
  Perimeters = array shape Length fill 0
  Best = 0
  Perimeter = 0
  for Event in 0 till Length
    I = Owners Event
    Counts I += 1
    Copies = Counts I
    Before = 0
    if I greater 0
      Before = Counts 0 (I - 1) query
    end
    Start = Before - 3 max 0
    Last = Before + Copies + 2 min Event
    Places = Start to Last copy
    Query = Places + 1
    Nearby = Counts firstatleast Query
    Window = Sides Nearby
    Center = Before - Start
    Width = Window len
    if Width at least 4
      Slots = 0 to Width - 4 copy
      LastStart = Center + Copies - 1
      Fits = Slots at most LastStart
      EndsAt = Slots + 3
      Touches = EndsAt at least Center
      Fits = Fits and Touches
      Slots = Slots (Fits indices)
      A = Window Slots
      B = Window (Slots + 1)
      C = Window (Slots + 2)
      D = Window (Slots + 3)
      Area = A + B + C - D
      Area = Area * (A + B - C + D)
      Area = Area * (A - B + C + D)
      Area = Area * (B + C + D - A)
      Triangle = A + B + C
      Valid = D less Triangle
      Area = Valid choose Area 0
      Totals = A + B + C + D
      Largest = Area max
      Ties = Area equal Largest indices
      Longest = Totals Ties max
      Better = Largest equal Best
      Longer = Longest greater Perimeter
      Better = Better and Longer
      Larger = Largest greater Best
      Better = Better or Larger
      if Better
        Best = Largest
        Perimeter = Longest
      end
    end
    Perimeters Event = Perimeter
  end
  Later = Times (1 till Length)
  Ends = concat Later (array (N + 1))
  Weights = Ends - Times
  Answer = Perimeters * Weights sum
end
Answer print
