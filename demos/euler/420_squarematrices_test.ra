use testing

test "statement values"
  use "420_squarematrices"
  N = 50
  run
  Answer equal 7
  N = 1000
  run
  Answer equal 1019
end

test "brute force references"
  use "420_squarematrices"
  N = 10
  run
  Answer equal 0
  N = 20
  run
  Answer equal 1
  N = 30
  run
  Answer equal 3
end

test "bound 10^5"
  use "420_squarematrices"
  N = 100000
  run
  Answer equal 518497
end
