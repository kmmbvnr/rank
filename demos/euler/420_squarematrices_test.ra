use testing

test "statement values"
  use "420_squarematrices" as solve
  Answer = solve 50
  Answer equal 7
  Answer = solve 1000
  Answer equal 1019
end

test "brute force references"
  use "420_squarematrices" as solve
  Answer = solve 10
  Answer equal 0
  Answer = solve 20
  Answer equal 1
  Answer = solve 30
  Answer equal 3
end

test "bound 10^5"
  use "420_squarematrices" as solve
  Answer = solve 100000
  Answer equal 518497
end

test "small and empty bounds"
  use "420_squarematrices" as solve
  Answer = solve 0
  Answer equal 0
  Answer = solve 1
  Answer equal 0
  Answer = solve 2
  Answer equal 0
  Answer = solve 3
  Answer equal 0
  Answer = solve 11
  Answer equal 1
end
