rem Triangles Containing the Origin II
rem https://projecteuler.net/problem=456

use algo
use numbers
use sequences
use io
use cli

arg N integer = 2000000

rem Only the ray of a point matters:
rem merge equal primitive directions
rem into classes of weight w. Count
rem triples of distinct classes, less
rem those in one open half-plane (by
rem the first class in angle order)
rem and those with an opposite pair.
Is = 1 to N copy
X = 1248 Is 32323 powmod - 16161
Y = 8421 Is 30103 powmod - 15051
G = X gcd Y
Nz = G greater 0 indices
Dx = X Nz // G Nz
Dy = Y Nz // G Nz
Ky = (Dx + 20000) * 40000 + Dy + 20000
Od = Ky argsort
Ks = Ky Od
Pr = concat (array -1) Ks
Nk = Ks len
Nw = Ks not equal Pr (0 till Nk)
St = Nw indices
Sn = St (1 till St len)
Ed = concat Sn (array Nk)
W = Ed - St
RayX = (Dx Od) St * 1.0
RayY = (Dy Od) St * 1.0
Angles = RayY atan2 RayX
AngleOrder = Angles argsort
Angles = Angles AngleOrder
W = W AngleOrder
RayX = RayX AngleOrder
RayY = RayY AngleOrder
M = W len
rem Opposite ray of each class, in
rem the doubled circle after it.
Turn = 8 * (1.0 atan)
Back = 0 - RayY atan2 (0 - RayX)
Add = Back less Angles
Opposite = Add choose (Back + Turn) Back
Circle = concat Angles (Angles + Turn)
Ws = concat W W
Bounds = Circle lowerindex Opposite
P1 = Ws scan + with 0
P2 = Ws * Ws scan + with 0
I1 = (0 till M) + 1
A = P1 Bounds - P1 I1
Q = P2 Bounds - P2 I1
O = (W * (A * A - Q) // 2) sum
Probe = Bounds min (2 * M - 1)
Hit = Circle Probe equal Opposite
Wo = Hit choose (Ws Probe) 0
Tw = W sum
B = (W * Wo * (Tw - W - Wo)) sum // 2
S2 = W * W sum
S3 = W * W * W sum
T = Tw ** 3 - 3 * Tw * S2 + 2 * S3
T //= 6
Answer = T - O - B
return Answer
