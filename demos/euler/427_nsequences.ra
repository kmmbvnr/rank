rem n-sequences
rem https://projecteuler.net/problem=427

use numbers
use sequences
use io
use cli

arg N integer = 7500000
Prime = 1000000009

fun N tables
  Negative = Prime - N + 1
  Count = N // 2 max 1
  Factorials = array shape N fill 1
  Powers = array shape N fill 1
  Signs = array shape Count fill 1
  rem Include N^-1 after shifting P.
  Signs 0 = N (Prime - 2) Prime powmod
  for I in 1 till N
    Prior = I - 1
    Left = Factorials Prior
    Factorials I = Left * I mod Prime
    Left = Powers Prior
    Powers I = Left * N mod Prime
    if I less Count
      Left = Signs Prior
      Signs I = Left * Negative mod Prime
    end
  end
  return tuple Factorials Powers Signs
end
fun Factorials inverse
  Count = Factorials len
  Last = Count - 1
  Inverses = array shape Count fill 1
  Exponent = Prime - 2
  Value = Factorials Last
  Seed = Value Exponent Prime powmod
  Inverses Last = Seed
  for I in Last to 1 by -1
    Value = Inverses I
    Term = Value * I mod Prime
    Inverses (I - 1) = Term
  end
  return Inverses
end
fun N solve
  if N equal 0
    return 0
  end
  Table = N tables
  unpack Factorials Powers Signs = Table
  Inverses = Factorials inverse
  Negative = Prime - N + 1
  rem The unmatched p=0 terms.
  Tail = N - 1
  Total = Tail * Powers Tail
  Total = Total mod Prime
  P = 1
  K = 1
  Last = N // P - 1
  Weight = Signs 0
  Step = Negative
  Factor = Negative * (N - P) - P
  Factor = Factor mod Prime
  Sum = 0
  rem Fold two binomial sums into one.
  for P * 2 at most N
    if K greater Last
      Total = (Total + Sum) mod Prime
      Sum = 0
      P += 1
      K = 1
      Last = N // P - 1
      if Last less 1
        break
      end
      Left = Inverses P
      Right = Signs (P - 1)
      Weight = Left * Right mod Prime
      Step = Negative * P mod Prime
      Factor = Negative * (N - P) - P
      Factor = Factor mod Prime
      continue
    end
    Row = N - 1 - P * K
    Length = Row - P + 1
    Left = Factorials Row
    Right = Inverses Length
    Term = Left * Right mod Prime
    Term = Term * Powers Length mod Prime
    Term = Term * Weight mod Prime
    Term = Term * Factor mod Prime
    Sum += Term
    Factor = (Factor - Step) mod Prime
    K += 1
  end
  Top = N (N + 1) Prime powmod
  return (Top - N * Total) mod Prime
end
Answer = N solve
return Answer
