rem n-sequences
rem https://projecteuler.net/problem=427

use numbers
use sequences
use io
use cli

arg N integer = 7500000

rem f(n) = n^(n+1) - n (S1 - S2) with
rem S1 = sum over k of A(n-1, k) and
rem S2 = sum of A(n-1-k, k), where
rem A(m, k) = sum over p of
rem C(m - p k, p) n^(m - p (k+1))
rem (-(n-1))^p. Small k run over p,
rem large k run over k for each p.
Mod = 1000000009
Ng = Mod - N + 1
Fa = array shape (N + 1) fill 1
Pn = array shape (N + 1) fill 1
Ps = array shape (N + 1) fill 1
for I in 1 to N
  Fa I = Fa (I - 1) * I mod Mod
  Pn I = Pn (I - 1) * N mod Mod
  Ps I = Ps (I - 1) * Ng mod Mod
end
If = array shape (N + 1) fill 1
If N = Fa N (Mod - 2) Mod powmod
for I in N to 1 by -1
  If (I - 1) = If I * I mod Mod
end
Rt = N isqrt
K0 = Rt min (N - 1)
Tot = 0
for Pass in 0 to 1
  Sg = 1 - 2 * Pass
  for K in 1 to K0
    Mp = N - 1 - K * Pass
    Pt = Mp // (K + 1)
    Ac = 0
    for P in 0 to Pt
      Rm = Mp - P * K
      Ex = Mp - P * (K + 1)
      Tm = Fa Rm * (If P) mod Mod
      Tm = Tm * (If (Rm - P)) mod Mod
      Tm = Tm * (Pn Ex) mod Mod
      Tm = Tm * (Ps P) mod Mod
      Ac += Tm
    end
    Tot += (Ac mod Mod) * Sg
  end
  for Pq in 0 to N
    Kx = N - 1
    if Pq greater 0
      Kx = (N - 1) // Pq - 1
      Kx = Kx min (N - 1)
    end
    if Pass equal 1
      Kx = N // (Pq + 1) - 1
      Kx = Kx min (N - 1)
    end
    if Kx at most K0
      break
    end
    Ac = 0
    for Kk in K0 + 1 to Kx
      Mk = N - 1 - Kk * Pass
      Rk = Mk - Pq * Kk
      Ek = Mk - Pq * (Kk + 1)
      Tk = Fa Rk * (If Pq) mod Mod
      Tk = Tk * (If (Rk - Pq)) mod Mod
      Tk = Tk * (Pn Ek) mod Mod
      Tk = Tk * (Ps Pq) mod Mod
      Ac += Tk
    end
    Tot += (Ac mod Mod) * Sg
  end
end
Tot = Tot mod Mod
Top = N (N + 1) Mod powmod
Answer = (Top - N * Tot) mod Mod
Answer print
