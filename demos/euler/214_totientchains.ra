rem Totient Chains
rem https://projecteuler.net/problem=214
rem Sum primes below Limit with Len
rem terms in their totient chain.

use numbers
use io
use cli
arg Limit integer = 40000000
arg Len integer = 25
Answer = Limit totientchain_sum
Answer print

fun Bound totientchain_sum
  Total = 0
  rem Unprocessed cells hold phi(n).
  rem Processed cells hold chain lengths.
  rem Later primes only touch later cells.
  Phi = array shape Bound fill 0
  for N in 1 till Bound
    Phi N = N
  end
  for N in 2 till Bound
    Isprime = Phi N equal N
    if Isprime
      for K in N till Bound by N
        Phi K -= Phi K // N
      end
    end
    rem phi(N) < N: its length is ready.
    Steps = 1 + Phi (Phi N)
    Phi N = Steps
    if Isprime and Steps equal Len
      Total += N
    end
  end
  return Total
end
