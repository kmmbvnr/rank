rem Non-Abundant Sums
rem https://projecteuler.net/problem=23
rem Sum integers that cannot be formed
rem from two abundant numbers

use bits
use io
use cli

arg Limit integer = 28123

rem Sieve proper divisor sums.
Sums = array shape (Limit + 1) fill 0
for D in 1 to Limit // 2
  Sums (D * 2 to Limit by D) += D
end

N = 12 till Limit + 1
Ab = N (Sums N greater N)

rem A shift marks every pair with A.
Bits = 1 shl Ab reduce bor with 0
Pairs = Bits shl Ab reduce bor with 0
N = 1 to Limit
Answer = N (not (Pairs bit N)) sum
return Answer
