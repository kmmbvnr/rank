rem Non-Abundant Sums
rem https://projecteuler.net/problem=23
rem Sum positive integers that are not a sum
rem of two abundant numbers

use ranges
use sequences
use algo
use io
use cli

option Limit integer = 28123

Answer = Limit non_abundant_sum
Answer print


rem Sieve divisor sums, mark abundant pairs,
rem then total every unmarked value.
fun non_abundant_sum Limit
  DivisorSums = array shape (Limit + 1) pad 1
  DivisorSums 0 = 0
  DivisorSums 1 = 0

  for Divisor in 2 to Limit // 2
    for Multiple in Divisor * 2 to Limit by Divisor
      DivisorSums Multiple += Divisor
    end
  end

  Abundant = new queue
  AbundantSet = new set
  if Limit at least 12
    for N in 12 to Limit
      if DivisorSums N greater N
        Abundant push N
        AbundantSet add N
      end
    end
  end

  Total = 0
  for N in 1 to Limit
    IsSum = false
    for A in Abundant
      if A * 2 greater N
        break
      end
      B = N - A
      if B in AbundantSet
        IsSum = true
        break
      end
    end
    if not IsSum
      Total += N
    end
  end
  return Total
end
