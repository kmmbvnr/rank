rem Integer Angled Quadrilaterals
rem https://projecteuler.net/problem=177
rem Count convex quadrilaterals whose
rem diagonals cut the corners into eight
rem whole degree angles, up to turning
rem and flipping

use numbers
use sequences
use bits
use io

rem Corner pairs (a, p) (q, r) (s, c)
rem (U-c, V-a), U = p + q, V = 180 - U.
rem The sine rule closes the figure when
rem sin p sin r / (sin q sin s) equals
rem sin(U-c) sin a / (sin c sin(V-a)).
rem Key the left side by U and its rounded
rem log ratio. The right side is the same
rem table with p replaced by U-p and the
rem two index axes swapped. Sort once and
rem pair entries within each equal-key group.
rem The matches are closed
rem under the 8 symmetries, so the
rem orbits number the mean of matches
rem each symmetry leaves fixed.
Deg = 0 to 180 array
Rad = Deg * 3.141592653589793 / 180
Sn = Rad sin
Pos = (0 to 7 array) reshape 1 8
Shift = (0 to 3 array) * 2 reshape 4 1
Rot = (Pos + Shift) mod 8
Both = concat Rot (7 - Rot)
Perms = Both reshape 64
N = 179 * 178 * 177 // 6
Big = 100000000000
KX = array shape (N + 1) fill 0
XI = array shape N fill 0
Off = 0
for U in 2 to 178
  V = 180 - U
  Np = U - 1
  Nr = V - 1
  Cells = Np * Nr
  Pv = 1 to Np array
  Rv = 1 to Nr array
  Sp' = (Sn Pv) reshape Np 1
  Sq' = (Sn (U - Pv)) reshape Np 1
  Sr' = (Sn Rv) reshape 1 Nr
  Ss' = (Sn (V - Rv)) reshape 1 Nr
  Lk' = (Sp * Sr / (Sq * Ss)) log
  Fk' = (Lk * 1000000000 + 0.5) floor
  Kk' = Fk reshape Cells
  Rng = Off till Off + Cells
  KX Rng = Kk + U * Big
  Idx = 0 till Cells array
  XI Rng = Idx
  Off += Cells
end
KX N = Big * 1000
Ox = KX argsort
Xs = KX Ox
Xi = XI (Ox take N)
Tv = array shape 8 fill 0
Fixed = 0
Ix = 0
for Ix less N
  Kx = Xs Ix
  Ex = Ix
  for Xs Ex equal Kx
    Ex += 1
  end
  U = (Kx + Big // 2) // Big
  V = 180 - U
  Nr = V - 1
  for I in Ix to Ex - 1
    P = Xi I // Nr + 1
    Q = Xi I mod Nr + 1
    for J in Ix to Ex - 1
      Y = Xi J
      Tv 0 = Y mod Nr + 1
      Tv 1 = P
      Tv 2 = U - P
      Tv 3 = Q
      Tv 4 = V - Q
      Tv 5 = U - (Y // Nr + 1)
      Tv 6 = U - Tv 5
      Tv 7 = V - Tv 0
      Fixed += 1
      for G in 1 to 7
        Same = 1
        for H in 0 to 7
          At = Perms (G * 8 + H)
          if Tv At not equal Tv H
            Same = 0
            break
          end
        end
        Fixed += Same
      end
    end
  end
  Ix = Ex
end
Answer = Fixed // 8
Answer print
