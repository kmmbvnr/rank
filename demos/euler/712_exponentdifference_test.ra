use testing

test "statement values"
  use "712_exponentdifference" as solve
  Answer = solve 10
  Answer equal 210
  Answer = solve 100
  Answer equal 37018
end

test "default input"
  use "712_exponentdifference" as solve
  Answer = solve
  Answer equal 413876461
end

test "full-scale checkpoint"
  use "712_exponentdifference" as solve
  Answer = solve 100000000
  Answer equal 478653324
end
