use testing

test "statement value"
  use "627_countingproducts" as solve
  Answer = solve 2
  Answer equal 308
end

test "interpolated values"
  use "627_countingproducts" as solve
  Answer = solve 5
  Answer equal 31856
  Answer = solve 16
  Answer equal 139004019
end

test "default input"
  use "627_countingproducts" as solve
  Answer = solve
  Answer equal 220196142
end
