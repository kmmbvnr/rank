use testing

test "default input"
  use "129_repunitdiv"
  run

  Answer equal 1000023
end

test "statement value for ten"
  use "129_repunitdiv"
  Limit = 10
  run

  Answer equal 17
end

test "strict threshold"
  use "129_repunitdiv"
  Limit = 3
  run

  Answer equal 7
end

test "answer at the window boundary"
  use "129_repunitdiv"
  Limit = 10
  Window = 7
  run

  Answer equal 17
end
