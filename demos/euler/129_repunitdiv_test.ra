use testing

test "default input"
  use "129_repunitdiv" as solve
  Answer = solve

  Answer equal 1000023
end

test "statement value for ten"
  use "129_repunitdiv" as solve
  Answer = solve 10

  Answer equal 17
end

test "strict threshold"
  use "129_repunitdiv" as solve
  Answer = solve 3

  Answer equal 7
end

test "answer at the window boundary"
  use "129_repunitdiv" as solve
  Answer = solve 10 7

  Answer equal 17
end
