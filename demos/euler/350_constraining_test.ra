use testing

test "small constrained lists"
  use "350_constraining"
  10 100 1 constrained equal 91
  10 100 2 constrained equal 327
  10 100 3 constrained equal 1135
  10 100 1000 constrained equal 3286053
end

test "constrained boundaries"
  use "350_constraining"
  1 1 1000 constrained equal 1
  10 10 1000 constrained equal 1
  10 5 3 constrained equal 0
  1 2 2 constrained equal 4
end
