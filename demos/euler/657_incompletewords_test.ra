use testing

test "statement values"
  use "657_incompletewords" as solve
  Answer = solve 3 0
  Answer equal 1
  Answer = solve 3 2
  Answer equal 13
  Answer = solve 3 4
  Answer equal 79
end

test "default input"
  use "657_incompletewords" as solve
  Answer = solve 10000000 1000000000000
  Answer equal 219493139
end
