rem Uphill Paths
rem https://projecteuler.net/problem=411

use numbers
use sequences
use algo
use io
use cli

arg First integer = 1
arg Count integer = 30
arg Power integer = 5

Inputs = First to Count
Answers = Inputs ** Power uphill rank 0
Answer = Answers sum
return Answer

fun N strip P
  Exponent = 0
  for N mod P equal 0
    N //= P
    Exponent += 1
  end
  return tuple N Exponent
end

fun A order M
  if M equal 1
    return 1
  end
  Primes = M factors unique array
  Divisor = Primes reduce * with 1
  Parts = Primes - 1
  Multiplier = Parts reduce * with 1
  D = M // Divisor * Multiplier
  for Q in D factors unique array
    D = D reduceorder Q
  end
  return D

  fun D reduceorder Q
    for D mod Q equal 0
      if A (D // Q) M powmod not equal 1
        break
      end
      D //= Q
    end
    return D
  end
end

fun N stations Count
  Keys = array shape Count fill 0
  X = 1
  Y = 1
  for I in 0 till Count
    Keys I = X * N + Y
    X = X * 2 mod N
    Y = Y * 3 mod N
  end
  return Keys sort
end

rem Equal heights may extend the path;
rem repeated stations must not do so.
fun N longest Keys
  Size = Keys len
  Capacity = Size min 1024
  Tails = array shape Capacity fill N
  Length = 0
  Previous = -1
  for I in 0 till Size
    Key = Keys I
    if Key equal Previous
      continue
    end
    Previous = Key
    Value = Key mod N
    Slot = Tails upperindex Value
    if Slot equal (Tails len)
      More = array shape Capacity fill N
      Tails = concat Tails More copy
      Capacity *= 2
    end
    Tails Slot = Value
    if Slot equal Length
      Length += 1
    end
  end
  return Length
end

fun N uphill
  unpack Rest2 Twos = N strip 2
  unpack Rest3 Threes = N strip 3
  Period2 = 2 order Rest2
  if Rest3 equal 1
    rem All units form a flat path.
    return Period2
  end
  Period3 = 3 order Rest3
  Period = Period2 lcm Period3
  Prefix = Twos max Threes
  Reach = Prefix + Period
  Count = 2 * N + 1 min Reach
  Keys = N stations Count
  return N longest Keys
end
