rem Chinese Leftovers II
rem https://projecteuler.net/problem=552

use numbers
use sequences
use io
use cli

arg L integer = 300000

rem A(i) = A(i-1) + M(i-1) t with the
rem digit t below the next prime p, so
rem t needs only A and M mod p. Keep
rem both mod every prime q: A(q) = 0
rem marks q. Primes behind p stay in A
rem with A(q) nonzero; trim in bulk.
Primes = primes till L + 1 array
Count = Primes len
Q = Primes
A = Q * 0 + 1
M = 2 mod Q
Hit = Primes * 0
Offset = 0
for I in 1 till Count
  Zeros = A equal 0
  if Zeros any
    Slots = Zeros indices
    Hit (Slots + Offset) = 1
  end
  Pos = I - Offset
  P = Q Pos
  Residue = M Pos
  Inverse = Residue (P - 2) P powmod
  Delta = I + 1 - A Pos + P
  T = Delta * Inverse mod P
  A = (A + M * T) mod Q
  M = M * P mod Q
  if Pos greater 1000
    Q = Q drop Pos
    A = A drop Pos
    M = M drop Pos
    Offset = I
  end
end
Answer = Primes * Hit sum
Answer print
