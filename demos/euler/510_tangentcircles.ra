rem Tangent Circles
rem https://projecteuler.net/problem=510

use numbers
use sequences
use io
use cli

arg N integer = 1000000000

rem With g = gcd(a, b), sqrt(ab) and c
rem integral force a = t (m + n)^2
rem m^2, b = t (m + n)^2 n^2, c = t m^2
rem n^2 for coprime m <= n and t >= 1.
rem Each family sums (a + b + c) T(t
rem max), t max = N // b.
Nm = (N isqrt) isqrt + 2
Ix = (0 till Nm * Nm) copy
M = Ix // Nm + 1
Q = Ix mod Nm + 1
Cp = (M gcd Q) equal 1
Ok = (M at most Q) and Cp
M = M (Ok indices)
Q = Q (Ok indices)
S2 = (M + Q) * (M + Q)
B0 = S2 * Q * Q
Kp = (B0 at most N) indices
M = M Kp
Q = Q Kp
S2 = S2 Kp
B0 = B0 Kp
Tm = N // B0
Su = S2 * M * M + B0 + M * M * Q * Q
Answer = (Su * Tm * (Tm + 1) // 2) sum
Answer print
