use testing
use numbers

test "cutting rope"
  use "398_cuttingrope" as solve
  Answer = solve 3 2
  Answer equal 2.0
  Answer = solve 8 3
  Answer equal 2.28571
  Answer = solve 10000000 100
  Answer equal 2010.59096
end

test "cutting rope boundary cases"
  use "398_cuttingrope" as solve
  use numbers
  Answer = solve 2 2
  Answer equal 1.0
  Answer = solve 8 2
  Answer equal (40 / 7 round 5)
  Answer = solve 8 8
  Answer equal 1.0
  Answer = solve 100 99
  Answer equal 1.0
end
