use testing

test "default input"
  use "014_collatz" as solve
  Answer = solve

  Answer equal 837799
end

test "starts below fourteen"
  use "014_collatz" as solve

  Answer = solve 14

  Answer equal 9
end

test "smallest search with a Collatz step"
  use "014_collatz" as solve
  Answer = solve 3

  Answer equal 2
end
