rem Tricoloured Coin Fountains
rem https://projecteuler.net/problem=519
use numbers
use sequences
use bits
use io
use cli
arg N integer = 20000

rem Upper/Lower use q-series shifts
rem j(j+2) and j(j+1), respectively.
rem P=2*Upper-Lower, Q=Lower-2*x*P.
rem The fountain series is 3*x*P/Q.
Mod = 1000000000
Length = N + 1
Zeros = array shape Length fill 0
Rows = Zeros copy
Rows 0 = 1
Upper = Zeros copy
Lower = Zeros copy
Sign = 1
Order = 0
for Order * (Order + 1) at most N
  First = Order * (Order + 2)
  Last = Order * (Order + 1)
  if First at most N
    Part = Rows (0 till Length - First)
    Terms = Sign * Part
    Upper (First till Length) += Terms
  end
  Part = Rows (0 till Length - Last)
  Terms = Sign * Part
  Lower (Last till Length) += Terms
  rem Divide by 1-x^Step via prefixes.
  Step = Order + 1
  Height = (Length - 1) // Step + 1
  Size = Height * Step
  Extra = Size - Length
  Pad = array shape Extra fill 0
  Padded = concat Rows Pad copy
  Grid = Padded reshape Height Step
  Grid = (Grid scan + axis 0) mod Mod
  Flat = Grid reshape Size
  Rows = Flat take Length
  Sign = -Sign
  Order += 1
end
Numerator = (2 * Upper - Lower) mod Mod
Shifted = Numerator shift 1
Poly = (Lower - 2 * Shifted) mod Mod

rem Newton doubling works modulo a
rem composite too: the constant is 1.
fun Series grow
  Count = Series len
  Width = Count * 2 min Length
  Part = Poly take Width
  Full = Part convolve Series mod Mod
  Product = Full take Width
  Minus = (0 - Product) mod Mod
  Minus 0 = (2 - Product 0) mod Mod
  Next = Series convolve Minus mod Mod
  return Next take Width
end
Seed = array 1
Steps = N binary len
Inverse = Seed grow repeat Steps
Whole = Shifted convolve Inverse mod Mod
return 3 * Whole N mod Mod
