use testing

test "statement sums"
  use "752_powers"
  Limit = 100
  run
  Answer equal 28891
  Limit = 1000
  run
  Answer equal 13131583
end

test "no admissible modulus"
  use "752_powers"
  Limit = 2
  run
  Answer equal 0
  Limit = 4
  run
  Answer equal 0
end

test "first admissible moduli"
  use "752_powers"
  Limit = 5
  run
  Answer equal 12
  Limit = 7
  run
  Answer equal 19
end

test "prime powers and composites"
  use "752_powers"
  Limit = 343
  run
  Orders 5 equal 12
  Orders 7 equal 7
  Orders 25 equal 60
  Orders 49 equal 49
  Orders 343 equal 343
  35 period equal 84
end
