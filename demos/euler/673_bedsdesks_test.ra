use testing

test "statement examples"
  use "673_bedsdesks" as solve
  Answer = solve (
    "demos/euler/fixtures/"
    + "0673_beds_n4.txt"
  ) (
    "demos/euler/fixtures/"
    + "0673_desks_n4.txt"
  ) 4
  Answer equal 2
  Answer = solve (
    "demos/euler/fixtures/"
    + "0673_beds_n6.txt"
  ) (
    "demos/euler/fixtures/"
    + "0673_desks_n6.txt"
  ) 6
  Answer equal 8
end

test "default input"
  use "673_bedsdesks" as solve
  Answer = solve
  Answer equal 700325380
end
