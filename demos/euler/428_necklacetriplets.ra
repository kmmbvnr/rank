rem Necklace of Circles
rem https://projecteuler.net/problem=428

use numbers
use sequences
use bits
use io
use cli

arg N integer = 1000000000

rem A Steiner chain of k circles closes
rem when a c = t b (a + b + c) with
rem t = tan(pi / k)^2, rational only
rem for k = 3, 4, 6. Counting divisor
rem pairs gives tau(12 b^2) + tau(2 b^2)
rem + pairs d e = 4 b^2 with
rem both d and e = -b mod 3.
rem With b = 2^p 3^q m, m prime to 6,
rem T(N) needs S1(x) = sum of tau(m^2)
rem and S2(x) = sum of W(m), the same
rem with a mod 3 character, for
rem x = N // (2^p 3^q). Both are sums
rem over squarefree e of a count
rem D(x // e), so tables of D and of
rem squarefree counts at all N // t are
rem built first.
fun Z statistics Mobius
  R = Z isqrt
  Keys = 1 to R copy
  Q = Z // Keys
  Parity = Keys mod 2
  Residues = Keys mod 3
  Allowed = Parity * Residues greater 0
  Mask = Allowed choose 1 0
  Minus = 0 - 1
  Sign = Residues equal 1 choose 1 Minus
  Counts = Q - Q // 2 - Q // 3 + Q // 6
  High = (Q + 5) // 6
  Low = (Q + 1) // 6
  Bias = High - Low
  Count = R - R // 2 - R // 3 + R // 6
  Upper = (R + 5) // 6
  Lower = (R + 1) // 6
  Edge = Upper - Lower
  Left = Mask * Counts sum
  Divisor = 2 * Left - Count * Count
  Right = Mask * Bias sum
  Left = Mask * Sign * Counts sum
  Mixed = Left + Right - Count * Edge
  Q = Z // (Keys * Keys)
  Counts = Q - Q // 2 - Q // 3 + Q // 6
  High = (Q + 5) // 6
  Low = (Q + 1) // 6
  Bias = High - Low
  Weights = Mobius Keys * Mask
  Free = Weights * Counts sum
  Signed = Weights * Bias sum
  return array Divisor Mixed Free Signed
end

fun Indices Large Small lookup
  Bound = Large len - 2
  Keys = Indices min Bound
  Left = Large Keys
  Q = N // Indices
  Keys = Q min Bound
  Right = Small Keys
  Mask = Indices at most Bound
  return Mask choose Left Right
end

fun Bound mobius
  Size = Bound + 2
  Last = Bound + 1
  Mu = array shape Size fill 1
  Removed = array shape Size fill 1
  Root = Bound isqrt + 1
  Primes = primes to Root copy
  Count = Primes len
  Index = 0
  P = 2
  if Count greater 0
    P = Primes 0
  end
  Power = P
  for Index less Count
    Slots = Power to Last by Power
    Removed Slots *= P
    if Power equal P
      Mu Slots *= -1
    end
    Power *= P
    if Power greater Last
      Square = P * P
      Slots = Square to Last by Square
      Mu Slots = 0
      Index += 1
      if Index less Count
        P = Primes Index
        Power = P
      end
    end
  end
  Keys = 0 till Size copy
  Remaining = Keys // Removed greater 1
  Negative = 0 - Mu
  Mu = Remaining choose Negative Mu
  Mu 0 = 0
  return Mu
end

rem Coefficients at integers prime to 6.
fun N coefficients rank 0
  Factors = N factors unique .counts
  unpack Primes Counts = Factors
  Ways = Counts + 1
  Divisor = Ways reduce * with 1
  Flags = Counts mod 2 equal 0
  Parity = Flags choose 1 0
  Classes = Primes mod 3
  Mask = Classes equal 1
  Weights = Mask choose Ways Parity
  Mixed = Weights reduce * with 1
  return array Divisor Mixed
end

rem Prefix the divisor convolutions and
rem squarefree character counts once.
fun Mu small_tables
  Bound = Mu len - 2
  if Bound equal 0
    Zero = array 0 0
    return tuple Zero Zero Zero Zero
  end
  Keys = 1 to Bound copy
  Odd = Keys mod 2
  Residues = Keys mod 3
  Allowed = Odd * Residues greater 0
  Active = Keys Allowed
  Pairs = Active coefficients
  unpack Divisor Mixed = Pairs axis 1
  Size = Bound + 1
  Counts = array shape Size fill 0
  Characters = array shape Size fill 0
  Slots = Active - 1
  Counts Slots = Divisor
  Characters Slots = Mixed
  Mask = Allowed choose 1 0
  Values = Mu Keys
  Free = Values * Values * Mask
  Minus = 0 - 1
  Positive = Residues equal 1
  Sign = Positive choose 1 Minus
  Signed = Free * Sign
  Tail = array 0
  Values = concat Free Tail
  Free = Values scan + with 0
  Values = concat Signed Tail
  Signed = Values scan + with 0
  Divisor = Counts scan + with 0
  Mixed = Characters scan + with 0
  return tuple Divisor Mixed Free Signed
end

fun N large_tables Mu
  Root = N isqrt
  Size = Root + 2
  Divisor = array shape Size fill 0
  Mixed = array shape Size fill 0
  Free = array shape Size fill 0
  Signed = array shape Size fill 0
  for V in 1 to Root
    Values = N // V statistics Mu
    Divisor V = Values 0
    Mixed V = Values 1
    Free V = Values 2
    Signed V = Values 3
  end
  return tuple Divisor Mixed Free Signed
end

R = N isqrt
Mu = R mobius
Small = Mu small_tables
unpack Dds Kcs S6s Sxs = Small
Large = N large_tables Mu
unpack DdL KcL S6L SxL = Large
Minus = 0 - 1
Total = 0
Count = N binary len
Exponents = 0 till Count copy
Twos = 2 ** Exponents
Threes = 3 ** Exponents
Grid = Twos Threes outer *
Bases = Grid reshape #
Allowed = Bases at most N
Places = Allowed indices
Bases = Bases Places
Rows = Places // Count
Columns = Places mod Count
for I in 0 till (Bases len)
  A = Rows I
  B = Columns I
  Base = Bases I
  X = N // Base
  Root = X isqrt
  Keys = 1 to Root copy
  Parity = Keys mod 2
  Residues = Keys mod 3
  Allowed = Parity * Residues greater 0
  Free = Allowed choose 1 0
  Values = Mu Keys
  Free = Free * Values * Values
  Positive = Residues equal 1
  Character = Positive choose 1 Minus
  Terms = Base * Keys
  Divisors = Terms DdL Dds lookup
  Mixed = Terms KcL Kcs lookup
  S1 = Free * Divisors sum
  S2 = Free * Character * Mixed sum
  Count = X // (Root + 1)
  if Count greater 0
    Quotients = 1 to Count copy
    HighKeys = Base * Quotients
    LowKeys = Base * (Quotients + 1)
    HighFree = HighKeys S6L S6s lookup
    HighChar = HighKeys SxL Sxs lookup
    LowerBound = N // LowKeys
    LowFree = LowKeys S6L S6s lookup
    LowChar = LowKeys SxL Sxs lookup
    Floor = S6s Root
    Bias = Sxs Root
    Above = LowerBound at least Root
    LowFree = Above choose LowFree Floor
    LowChar = Above choose LowChar Bias
    SmallDivisors = Dds Quotients
    SmallMixed = Kcs Quotients
    Delta = HighFree - LowFree
    S1 += SmallDivisors * Delta sum
    Delta = HighChar - LowChar
    S2 += SmallMixed * Delta sum
  end
  Width = 2 * A + 3
  Height = 2 * B + 2
  First = Width * Height
  Second = First - Width - Height + 1
  Weight = 2 * (First + Second)
  if B greater 0
    Weight += 2 * (2 * B - 1) * Width
  else
    Weight += Width
  end
  Sign = 0
  if B equal 0
    Sign = -1
    if A mod 2 equal 1
      Sign = 1
    end
  end
  Total += Weight * S1 + Sign * S2
end
return Total // 2
