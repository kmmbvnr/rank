use testing

rem Full input, including exact integers above 2^53.
test "default input"
  use "276_primitivetriangles"
  run

  Answer equal 5777137137739632912
end

test "small limits"
  use "276_primitivetriangles"
  Limit = 10
  run

  Answer equal 8
  Limit = 100
  run

  Answer equal 6033
end

test "empty and first triangle"
  use "276_primitivetriangles"
  Limit = 0
  run
  Answer equal 0
  Limit = 1
  run
  Answer equal 0
  Limit = 2
  run
  Answer equal 0
  Limit = 3
  run
  Answer equal 1
end
