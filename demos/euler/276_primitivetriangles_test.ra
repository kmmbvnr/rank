use testing

rem Full input, including exact integers above 2^53.
test "default input"
  use "276_primitivetriangles" as solve
  Answer = solve

  Answer equal 5777137137739632912
end

test "small limits"
  use "276_primitivetriangles" as solve
  Answer = solve 10

  Answer equal 8
  Answer = solve 100

  Answer equal 6033
end

test "empty and first triangle"
  use "276_primitivetriangles" as solve
  Answer = solve 0
  Answer equal 0
  Answer = solve 1
  Answer equal 0
  Answer = solve 2
  Answer equal 0
  Answer = solve 3
  Answer equal 1
end
