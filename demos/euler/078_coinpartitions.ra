rem Coin Partitions
rem https://projecteuler.net/problem=78
rem Find the least n for which p(n) is
rem divisible by a million

use linalg
use numbers
use sequences
use io
use cli

option Modulus integer = 1000000
option Limit integer = 60000

rem Pentagonal recurrence: p(n) is the
rem signed sum of p(n - g) for the
rem pentagonal numbers g <= n, kept
rem modulo the divisor.
Root = Limit isqrt
K = 1 to Root array
Odd = K mod 2 * 2 - 1
Low = K * (3 * K - 1) // 2
High = K * (3 * K + 1) // 2
Size = K len * 2
Gens = stack Low High transpose
Gen = Gens reshape Size
Signs = stack Odd Odd transpose
Sign = Signs reshape Size
rem Reverse storage lets future terms be
rem zero padding, with no negative indices.
Keep = Gen at most Limit
Gen = Gen Keep copy
Sign = Sign Keep copy
Ways = array shape (2 * Limit + 1) fill 0
Ways Limit = 1
Answer = -1
for N in 1 to Limit
  Base = Limit - N
  Total = (Ways (Gen + Base)) Sign matmul
  Ways Base = Total mod Modulus
  if Ways Base equal 0
    Answer = N
    break
  end
end
rem Publish p(n) at index n as before.
Ways = Ways (Limit to 0 by -1) copy
Answer print
