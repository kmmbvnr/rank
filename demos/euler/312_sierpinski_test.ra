use testing

test "statement small value"
  use "312_sierpinski"
  Mod = 10 ** 15
  3 iterative Mod equal 8
  4 iterative Mod equal 13824
  5 iterative Mod equal 71328803586048
end

test "statement residues"
  use "312_sierpinski"
  Mod = 10 ** 8
  10000 iterative Mod equal 37652224
  10000 cycles 8 equal 617720485
end
