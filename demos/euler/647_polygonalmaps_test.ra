use testing

test "default input"
  use "647_polygonalmaps" as solve
  Answer = solve
  Answer equal 563132994232918611
end

test "statement and brute force"
  use "647_polygonalmaps" as solve
  Answer = solve 1000
  Answer equal 14993
  Answer = solve 1000000
  Answer equal 529205796
  Answer = solve 100000000
  Answer equal 549150579820
end
