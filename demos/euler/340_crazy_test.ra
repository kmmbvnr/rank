use testing

test "given crazy values"
  use "340_crazy"
  0 50 2000 40 value equal 3240
  2000 50 2000 40 value equal 2040
  M = 10 ** 18
  S = 50 2000 40 M crazy
  S equal 5204240
end

test "target crazy sum"
  use "340_crazy"
  A = 21 ** 7
  B = 7 ** 21
  C = 12 ** 7
  A B C 1000000000 crazy equal 291504964
end
