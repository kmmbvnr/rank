use testing

test "default input"
  use "188_hyperexponentiation" as solve
  Answer = solve

  Answer equal 95962097
end

test "small towers"
  use "188_hyperexponentiation" as solve
  Answer = solve 3 3

  Answer equal 97484987
  Answer = solve 2 4

  Answer equal 65536
  Answer = solve 2 5

  Answer equal 19156736
end
