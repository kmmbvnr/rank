use testing

test "default input"
  use "234_semidivisible" as solve
  Answer = solve

  Answer equal 1259187438574927161
end

test "small limits"
  use "234_semidivisible" as solve
  Answer = solve 15

  Answer equal 30
  Answer = solve 1000

  Answer equal 34825
  Answer = solve 100000

  Answer equal 36393008
end
