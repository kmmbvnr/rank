use testing

test "default input"
  use "260_stonegame" as solve
  Answer = solve

  Answer equal 167542057
end

test "small top"
  use "260_stonegame" as solve
  Answer = solve 10

  Answer equal 213
  Answer = solve 100

  Answer equal 173895
end

test "empty and narrow games"
  use "260_stonegame" as solve
  Answer = solve 0
  Answer equal 0
  Answer = solve 2
  Answer equal 3
  Answer = solve 3
  Answer equal 10
  Answer = solve 15
  Answer equal 645
end
