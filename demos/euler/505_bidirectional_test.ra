use testing

test "statement values"
  use "505_bidirectional" as solve
  Answer = solve 4
  Answer equal 8
  Answer = solve 10
  Answer equal 1152921504606846976 - 34
  Answer = solve 1000
  Answer equal 101881
end

test "n = 10^6, python port"
  use "505_bidirectional" as solve
  Answer = solve 1000000
  Answer equal 12541668533
end
