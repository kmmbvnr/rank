rem Slowly Converging Series
rem https://projecteuler.net/problem=722

use numbers
use io
use cli

arg Order integer = 15
arg Shift integer = 25

rem For k = 2m - 1 the series is an
rem Eisenstein series of weight 2m at
rem tau = i y, y = -ln(q) / 2 pi.
rem Its modular transform gives, up to
rem terms of size exp(-2 pi / y),
rem sum = |B_2m| / 4m (y^(-2m) - 1).
Half = (Order + 1) // 2
Bernoulli = 1 / 30.0
if Order equal 15
  Bernoulli = 3617 / 510.0
end
Small = 0.5 ** Shift
Terms = 1 to 12
Series = Small ** Terms / Terms
Angle = Series sum
Pi = 3.141592653589793
Height = Angle / (2 * Pi)
Power = Height ** (-2 * Half) - 1
Total = Bernoulli / (4 * Half) * Power
Ten = 10.0 log
Exponent = Total log / Ten floor
Mantissa = Total / 10.0 ** Exponent
Answer = (Mantissa text ".12f") + "e"
Answer += Exponent text
Answer print
