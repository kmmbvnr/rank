rem Sum of Digits Sequence
rem https://projecteuler.net/problem=551
use numbers
use sequences
use io
use cli
arg N integer = 1000000000000000
rem a(n) <= 36*n*digits(n).
Digits = N text len
Upper = N * 36 * Digits
Levels = Upper text len
MaxSum = 9 * Levels
Size = MaxSum + 1
Rows = 0 to MaxSum array
Column = Rows reshape Size 1
Index = Column * 0 + Rows
rem One unit boundary takes zero or one
rem sequence step, even after overshoot.
Steps = Index equal 0 integer
Steps 0 0 = 0
Rests = Index + Steps * Column - 1
Rests 0 0 = 0
rem Compose ten decimal blocks together.
fun State compose
  Previous = State .last
  History = State .tables
  Counts = Previous .steps
  Remainders = Previous .rests
  Cells = Size * Size
  FlatCounts = Counts reshape Cells
  FlatRests = Remainders reshape Cells
  Current = Index
  Total = Index * 0
  for Digit in 0 to 9
    Offset = Column + Digit min MaxSum
    Keys = Offset * Size + Current
    Total += FlatCounts Keys
    Current = FlatRests Keys
  end
  Added = record
    .steps = Total copy
    .rests = Current copy
  end
  Entry = array Added
  return record
    .last = Added
    .tables = concat History Entry
  end
end
First = record
  .steps = Steps
  .rests = Rests
end
Tables = record
  .last = First
  .tables = array First
end
Depth = Levels - 1
Built = Tables compose repeat Depth
History = Built .tables
rem Greedily consume nine per level.
fun State advance
  Stage = State .stage
  Q = State .q
  Sum = State .sum
  R = State .rest
  Left = State .left
  D = Levels - 1 - Stage // 9
  Table = History D
  Counts = Table .steps
  Remainders = Table .rests
  Count = Counts Sum R
  if Count at most Left
    Left -= Count
    R = Remainders Sum R
    Q += 10 ** D
    Sum += 1
  end
  return record
    .stage = Stage + 1
    .q = Q
    .sum = Sum
    .rest = R
    .left = Left
  end
end
Start = record
  .stage = 0
  .q = 0
  .sum = 0
  .rest = 1
  .left = N - 1
end
Stages = 9 * Levels
Result = Start advance repeat Stages
Q = Result .q
R = Result .rest
return Q + R
