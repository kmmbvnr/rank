rem Hopping Game
rem https://projecteuler.net/problem=391

use numbers
use io
use cli

arg Limit integer = 1000

rem Rotate offsets, not DP snapshots.
rem Rows map residues zero through N.
Stride = Limit + 1
Rows = Limit + 2
Size = Stride * Rows
Dp = array shape (2 * Size) fill 0
Src = 0
Dst = Size
for V in 0 to Limit
  Dp (Src + V) = V
  Dp (Dst + V) = V
end
Answer = 0
for N in 1 to Limit
  Step = N + 1
  for S in 1 to Step
    for M in 1 to S
      Add = S - M + 1
      Prev = Src + (M - 1) * Stride
      Cur = Dst + M * Stride
      Below = Cur - Stride
      for V in 0 to N
        X = Dp (Below + V) + Add
        if X at least Step
          X = 0
        end
        Dp (Cur + V) = Dp (Prev + X)
      end
    end
    Row = Dst + S * Stride
    Val = Dp Row
    Same = true
    for V in 1 to N
      if Dp (Row + V) not equal Val
        Same = false
        break
      end
    end
    if Same
      Answer += Val ** 3
      break
    end
    Swap = Src
    Src = Dst
    Dst = Swap
  end
end
Answer print
