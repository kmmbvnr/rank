rem Rigid Graphs
rem https://projecteuler.net/problem=434

use numbers
use sequences
use io
use cli

arg N integer = 100
Mod = 1000000033
Width = N + 1
Rows = array shape Width Width fill 0
Connected = Rows copy
Keys = 0 to N copy
Factors = 1 to N
Scan = Factors scan * with 1 mod Mod
Fact = Scan copy
Inverse = Fact (Mod - 2) Mod powmod

rem Divide coefficients by n! so each
rem binomial sum becomes a convolution.
fun M connected_row
  Result = Rows M copy
  Degree = M - 1
  Coeff = Degree binomial (0 to Degree)
  Coeff = Coeff mod Mod
  for I in 1 to Degree
    Left = Connected I
    Right = Rows (M - I)
    Full = Left convolve Right mod Mod
    Values = Full take Width
    Weight = Coeff (I - 1)
    Terms = Values * Weight mod Mod
    Result = (Result - Terms) mod Mod
  end
  return Result
end

for M in 1 to N
  Base = 2 M Mod powmod - 1
  Powers = Base Keys Mod powmod
  Rows M = Powers * Inverse mod Mod
  Connected M = M connected_row
end
Weights = Fact reshape 1 Width
Rg = Connected * Weights mod Mod
Selected = Rg (1 to N) (1 to N)
Answer = Selected sum mod Mod
Answer print
