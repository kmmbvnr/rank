rem Even Stevens
rem https://projecteuler.net/problem=709

use numbers
use sequences
use bits
use io
use cli

arg Order integer = 24680
arg Prime integer = 1020202009

rem f(n) is the Euler zigzag number,
rem n! [x^n] (1 + sin x) / cos x.
rem Factorials come from a prefix
rem product by doubling; 1 / cos x
rem from a Newton iteration.
Size = 2 ** (Order binary len)
Index = 0 to Size - 1
Fact = Index max 1
Jump = 1
for Jump less Size
  Low = (Index less Jump) integer
  Shifted = (Fact shift Jump) + Low
  Fact = Fact * Shifted mod Prime
  Jump = Jump * 2
end
Inverse = Fact (Prime - 2) Prime powmod
Sign = 1 - (Index // 2 mod 2) * 2
Even = ((Index mod 2) equal 0) integer
Cosine = Even * Sign * Inverse mod Prime
Odd = 1 - Even
Sine = Odd * Sign * Inverse mod Prime
Zero = (Index equal 0) integer
Sine = (Sine + Zero) mod Prime
Series = array 1
Length = 1
for Length less Size
  Length = Length * 2
  Part = Cosine take Length
  Full = Part convolve Series mod Prime
  Product = Full take Length
  Minus = (0 - Product) mod Prime
  Minus 0 = (2 - Product 0) mod Prime
  Next = Series convolve Minus mod Prime
  Series = Next take Length
end
Reversed = Series (Order to 0 by -1)
SinePart = Sine take (Order + 1)
Terms = SinePart * Reversed mod Prime
Summed = Terms sum
Total = Summed mod Prime
return Total * Fact Order mod Prime
