rem Coprime Nim
rem https://projecteuler.net/problem=560
use numbers
use sequences
use bits
use io
use cli
arg N integer = 10000000
arg K integer = 10000000

rem Even piles have Grundy value zero.
rem For odd piles, count least factors;
rem larger primes occur just once.
Limit = N - 1
Sieve = Limit primesieve
Count = Sieve len
Root = Limit isqrt
Primes = Sieve to Root array
Small = Primes len
Counts = array shape Count fill 1
Odd = (Limit + 1) // 2
Alive = array shape Odd fill 1
for I in 1 till Small
  Prime = Primes I
  First = (Prime - 1) // 2
  Slots = First till Odd by Prime
  Counts I = Alive Slots sum
  Alive Slots = 0
end

Bits = Count binary len
Width = 2 ** Bits
Values = array shape Width fill 0
Values 0 = Limit // 2
Values 1 = Limit at least 1 integer
Targets = 2 till Count + 1
Values Targets = Counts (1 till Count)
rem Walsh butterflies count XOR powers.
fun Values walsh Half
  Size = Values len
  Blocks = Size // (2 * Half)
  Cube = Values reshape Blocks 2 Half
  unpack Left Right = Cube axis 1
  Plus = Left + Right
  Minus = Left - Right
  Top = Plus reshape Blocks 1 Half
  Bottom = Minus reshape Blocks 1 Half
  Joined = concat Top Bottom axis 1
  return Joined reshape Size
end
Steps = 2 ** (0 till Bits)
Weights = Steps reduce walsh with Values
Mod = 1000000007
Residues = Weights mod Mod
Powers = Residues K Mod powmod
Exponent = Mod - 2
Inverse = Width Exponent Mod powmod
Total = Powers sum mod Mod
Answer = Total * Inverse mod Mod
return Answer
