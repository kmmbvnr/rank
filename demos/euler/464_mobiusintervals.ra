rem Möbius function and intervals
rem https://projecteuler.net/problem=464

use algo
use numbers
use sequences
use io
use cli

arg N integer = 20000000

rem Zero signs repeat a prefix value.
rem Count those repeats as one weight.
fun N signs
  Mu = array shape (N + 1) fill 1
  Mu 0 = 0
  Rest = 0 to N copy
  rem Square factors are already zero.
  Root = N isqrt
  for Prime in primes to Root
    Mu (Prime to N by Prime) *= -1
    Square = Prime * Prime
    Mu (Square to N by Square) = 0
    Rest (Prime to N by Prime) //= Prime
  end
  Mu = Rest greater 1 choose (0 - Mu) Mu
  Positions = Mu not equal 0 indices
  Signs = Mu Positions copy
  Starts = concat (array 0) Positions
  Tail = array (N + 1)
  Stops = concat Positions Tail
  Weights = Stops - Starts
  return tuple Signs Weights
end

rem Strictly increasing prefix pairs
rem are the intervals violating a bound.
fun Prefix bad Weights
  Floor = Prefix min
  Top = Prefix max
  Size = Top - Floor + 1
  Tree = Size fenwick
  Count = Prefix len
  Total = 0
  for I in 0 till Count
    Key = Prefix I - Floor
    Less = Tree sum (Key - 1)
    Weight = Weights I
    Total += Weight * Less
    Tree Key += Weight
  end
  return Total
end
fun Signs violations Weights
  Steps = (199 * Signs - 1) // 2
  Prefix = Steps scan + with 0
  Count = Prefix len
  rem The two increments add to -1.
  Other = 0 - Prefix - (0 till Count)
  Bad = Prefix bad Weights
  Bad += Other bad Weights
  return Bad
end
unpack Signs Weights = N signs
Bad = Signs violations Weights
Answer = N * (N + 1) // 2 - Bad
return Answer
