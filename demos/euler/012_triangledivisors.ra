rem Highly Divisible Triangular Number
rem https://projecteuler.net/problem=12
rem First triangular number with
rem more than the requested divisors

use numbers
use sequences
use io
use cli

option Min integer = 500

N = 1 to #
Triangles = N * (N + 1) // 2
Counts = Triangles divisors rank 0 count rank 0
Answer = Triangles (Counts greater Min) first
Answer print
