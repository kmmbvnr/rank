rem Highly Divisible Triangular Number
rem https://projecteuler.net/problem=12
rem Find the first triangular number with
rem more than the requested divisors

use numbers
use sequences
use io
use cli

option Minimum integer = 500

Answer = Minimum first_triangle
Answer print


rem Find the first triangular number whose
rem divisor count is greater than Minimum.
fun first_triangle Minimum
  N = 1
  for true
    Left = N
    Right = (N + 1) // 2
    if N even
      Left = N // 2
      Right = N + 1
    end

    Divisors = Left divisors count
    Divisors *= Right divisors count
    if Divisors greater Minimum
      return N * (N + 1) // 2
    end
    N += 1
  end
end
