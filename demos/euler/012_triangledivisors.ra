rem Highly Divisible Triangular Number
rem https://projecteuler.net/problem=12
rem First triangular number with
rem more than the requested divisors

use numbers
use sequences
use io
use cli

option Minimum integer = 500

N = 1 to #
Tri = N * (N + 1) // 2
Divs = Tri divisors rank 0 count rank 0
Answer = Tri (Divs greater Minimum) first
Answer print
