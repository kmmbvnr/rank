use testing

test "statement values"
  use "466_distinctproducts" as solve
  Answer = solve 3 4
  Answer equal 8
  Answer = solve 64 64
  Answer equal 1263
  Answer = solve 12 345
  Answer equal 1998
end

test "m = 32, n = 10^15"
  use "466_distinctproducts" as solve
  Answer = solve 32 1000000000000000
  Answer equal 13826382602124302
end
