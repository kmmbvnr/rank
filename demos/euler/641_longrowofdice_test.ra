use testing

test "statement values"
  use "641_longrowofdice" as solve
  Answer = solve 100
  Answer equal 2
  Answer = solve 100000000
  Answer equal 69
end

test "brute force and large cutoffs"
  use "641_longrowofdice" as solve
  Answer = solve 1000000
  Answer equal 20
  Answer = solve 1000000000000
  Answer equal 740
  Answer = solve 100000000000000000000
  Answer equal 78220
  Answer = solve 1000000000000000000000000000000
  Answer equal 25055676
end

test "default input"
  use "641_longrowofdice" as solve
  Answer = solve
  Answer equal 793525366
end
