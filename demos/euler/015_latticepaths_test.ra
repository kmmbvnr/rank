use testing

test "default input"
  use "015_latticepaths" as solve
  Answer = solve

  Answer equal 137846528820
end

test "two by two grid"
  use "015_latticepaths" as solve
  Answer = solve 2

  Answer equal 6
end

test "zero-sized grid"
  use "015_latticepaths" as solve
  Answer = solve 0

  Answer equal 1
end
