rem Permuted Matrices
rem https://projecteuler.net/problem=559
use numbers
use sequences
use io
use cli
arg N integer = 50000
Mod = 1000000123
Steps = 1 to N
Factorials = Steps scan * with 1 mod Mod
Exponent = Mod - 2
Inverse = Factorials Exponent Mod powmod
Powers = Inverse N Mod powmod

rem Double the known reciprocal prefix.
fun Series inverse Length
  if Length equal 1
    return array 1
  end
  Half = (Length + 1) // 2
  Prefix = Series inverse Half
  Terms = Series take Length
  Head = Terms convolve Prefix mod Mod
  rem The known prefix has zero error.
  Tail = Head drop Half
  Error = 0 - Tail take (Length - Half)
  Next = Prefix convolve Error mod Mod
  Added = Next take (Length - Half)
  return concat Prefix Added
end
fun K chains
  Size = N // K
  Rest = N mod K
  Indices = 0 to Size copy
  Signs = 1 - 2 * (Indices mod 2)
  Terms = Powers (Indices * K) * Signs
  Series = Terms mod Mod
  Reciprocal = Series inverse (Size + 1)
  if Rest equal 0
    return Reciprocal Size
  end
  Tail = Powers (Rest + Indices * K)
  Back = Reciprocal (Size - Indices)
  Product = Back * Tail * Signs mod Mod
  return Product sum mod Mod
end
rem Equal quotients share matrix rows.
fun Size batch
  First = N // (Size + 1) + 1
  Last = N // Size
  Keys = First to Last copy
  Width = Keys len
  Rows = 1 to Size copy
  Column = Rows reshape Size 1
  Places = Column * Keys
  Signs = 2 * (Column mod 2) - 1
  Terms = Powers Places * Signs mod Mod
  Reverse = Size - Rows
  Weights = Terms Reverse copy
  Height = Size + 1
  Shape = array Height Width
  Table = array shape Shape fill 0
  Table 0 = 1
  for I in 1 to Size
    Left = Table (0 till I)
    Right = Weights (Size - I till Size)
    Product = Left * Right mod Mod
    Table I = Product sum axis 0 mod Mod
  end
  All = 0 to Size copy
  Column = All reshape (Size + 1) 1
  Rest = N mod Keys
  Places = Rest + Column * Keys
  Tail = Powers Places
  Signs = 1 - 2 * (Column mod 2)
  Back = Table (Size - All)
  Product = Back * Tail * Signs mod Mod
  Values = Product sum axis 0 mod Mod
  Exact = Rest equal 0
  Full = Table Size
  Values = Exact choose Full Values
  return Values sum mod Mod
end
rem Batch the schoolbook-sized rows.
Cut = 64 min N
Sizes = 1 to Cut
Lower = N // (Sizes + 1)
Upper = N // Sizes
Small = Sizes (Lower less Upper)
Short = Small batch rank 0
Last = N // (Cut + 1)
Long = 1 to Last chains rank 0
Total = (Short sum) + (Long sum)
Total = Total mod Mod
Factor = Factorials N
Scale = Factor N Mod powmod
Answer = Total * Scale mod Mod
return Answer
