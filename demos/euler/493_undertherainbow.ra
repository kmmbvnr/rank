rem Under The Rainbow
rem https://projecteuler.net/problem=493

use numbers
use io
use cli

arg C integer = 7
arg B integer = 10
arg D integer = 20

rem Each colour is missing with chance
rem C((C-1)B, D) / C(CB, D); expected
rem colours = C (1 - that).
Q = ((C - 1) * B) binomial D
T = (C * B) binomial D
E = C * (1.0 - Q * 1.0 / T)
Answer = E text ".9f"
Answer print
