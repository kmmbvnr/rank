rem Special Pythagorean Triplet
rem https://projecteuler.net/problem=9
rem Find a*b*c where a+b+c=1000 and
rem a^2+b^2=c^2

use numbers
use sequences
use io
use cli

option Target integer = 1000

ALast = (Target - 1) // 3
As = 1 to ALast array
Bs = Target * (Target - 2 * As) / (2 * (Target - As))
Valid = Bs round 0 equal Bs
A = As Valid first
B = Bs Valid first
C = (A ** 2 + B ** 2) sqrt
Answer = A * B * C

Answer print
