rem Special Pythagorean Triplet
rem Find a*b*c where a+b+c=1000 and
rem a^2+b^2=c^2

use ranges
use io
use cli

option Target integer = 1000

Last = Target - 1

for a in 1 to Last
  for b in 1 to Last
    if b greater a
      C = Target - a - b
      if C greater b
        if a * a + b * b equal C * C
          Answer = a * b * C
        end
      end
    end
  end
end

Answer print
