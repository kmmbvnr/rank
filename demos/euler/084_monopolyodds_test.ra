use testing

test "default input"
  use "084_monopolyodds"
  run

  Answer equal 101524
end

test "six-sided dice from the statement"
  use "084_monopolyodds"
  Sides = 6
  run

  Answer equal 102400
end

test "landing distributions"
  use "084_monopolyodds"
  run

  Land 30 40 equal 1.0
  Land 2 2 equal 0.875
  Land 2 0 equal 0.0625
  Land 2 40 equal 0.0625
  Land 5 5 equal 1.0
  Land 36 5 equal 0.1875
  Land 36 12 equal 0.0625
end

test "transition rows are probabilities"
  use "084_monopolyodds"
  use numbers
  use sequences

  run

  Sums = Trans sum axis 1
  Off0 = Sums 0 - 1.0
  Off0 abs less 0.000001
  Off60 = Sums 60 - 1.0
  Off60 abs less 0.000001
  Off100 = Sums 100 - 1.0
  Off100 abs less 0.000001
end
