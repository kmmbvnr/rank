use testing

test "statement values"
  use "744_whatwherewhen" as solve
  Answer = solve 6 0.5
  Answer equal "0.2851562500"
  Answer = solve 10 0.42857142857142855
  Answer equal "0.2330040743"
  Answer = solve 10000 0.3
  Answer equal "0.2857499982"
end

test "default input"
  use "744_whatwherewhen" as solve
  Answer = solve
  Answer equal "0.0001999600"
end
