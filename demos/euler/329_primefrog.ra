rem Prime Frog
rem https://projecteuler.net/problem=329

use numbers
use sequences
use io

Croaks = "PPPPNNPPPNPPNPN"
Answer = 500 Croaks frog
Answer print

fun N Text frog
  Len = Text len
  Pos = 1 to N array
  Prime = Pos in (primes till N)
  Ways = array shape N fill 1
  for I in 0 till Len
    P = Text I equal "P"
    Hit = Prime equal P
    Ways *= Hit choose 2 1
    if I less (Len - 1)
      Next = array shape N fill 0
      for J in 0 till N
        if J equal 0
          Next 1 += Ways J * 2
        else
          if J equal N - 1
            Next (N - 2) += Ways J * 2
          else
            Next (J - 1) += Ways J
            Next (J + 1) += Ways J
          end
        end
      end
      Ways = Next
    end
  end
  Top = Ways sum
  Bottom = N * 3 ** Len
  Bottom *= 2 ** (Len - 1)
  Div = Top Bottom gcd
  A = Top // Div
  B = Bottom // Div
  return A B pair
end

fun A B pair
  Left = A text
  Right = B text
  return Left + "/" + Right
end
