rem Modular Inverses
rem https://projecteuler.net/problem=451

use numbers
use sequences
use io
use cli

arg N integer = 20000000

rem m^2 = 1 mod n. For odd n the roots
rem are x = 1 mod s, -1 mod L over the
rem coprime splits n = s L. For even
rem n = 2M use the odd lifts of each
rem root of M. Enumerate the small
rem factor s, using arrays for L > s.
fun Limit inverse_roots
  B = array shape (Limit + 1) fill 1
  rem The split with S = 1 is explicit.
  Even = 8 to Limit by 4 copy
  B Even = Even // 2 + 1
  Root = Limit isqrt
  for S in 2 to Root
    Residues = 0 till S copy
    Units = Residues gcd S equal 1
    rem Invert units with Euler powers.
    Exponent = Units count - 1
    Powers = Residues Exponent S powmod
    Twice = 2 * Powers mod S
    if S odd
      Last = Limit // S
      Large = S + 2 to Last by 2 copy
      Large = Large (Units (Large mod S) indices)
      Moduli = Large * S
      Roots = (Large * Twice (Large mod S) - 1) mod Moduli
      Best = Roots max (Moduli - Roots)
      B Moduli = B Moduli max Best
    end
    Last = Limit // (2 * S)
    Large = S + 1 to Last copy
    Large = Large (Units (Large mod S) indices)
    Moduli = Large * S
    Roots = (Large * Twice (Large mod S) - 1) mod Moduli
    First = Roots + Moduli
    Other = 2 * Moduli - Roots
    Upper = Roots less Moduli - 1
    Upper = First odd and Upper
    Lower = Roots greater 1
    Lower = Other odd and Lower
    Best = Upper choose First 1
    Best = Best max (Lower choose Other 1)
    Even = 2 * Moduli
    B Even = B Even max Best
  end
  B 0 = 0
  if Limit at least 1
    B 1 = 0
  end
  if Limit at least 2
    B 2 = 0
  end
  return B
end

B = N inverse_roots
Answer = B sum
Answer print
