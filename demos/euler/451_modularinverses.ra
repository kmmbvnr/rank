rem Modular Inverses
rem https://projecteuler.net/problem=451

use numbers
use sequences
use io
use cli

option N integer = 20000000

rem m^2 = 1 mod n. For odd n the roots
rem are x = 1 mod s, -1 mod L over the
rem coprime splits n = s L. For even
rem n = 2M the roots are the odd ones
rem of x and x + M over the roots x of
rem the splits of M. Loop over the
rem small side s, arrays over L > s.
B = array shape (N + 1) fill 1
Rt = N isqrt
for S in 1 to Rt
  R = (0 till S) copy
  U = (R gcd S) equal 1
  rem T r = 2 / r mod S by powering.
  Rs = R * 0 + 1
  Bs = R
  E = U count - 1
  for E greater 0
    if E mod 2 equal 1
      Rs = Rs * Bs mod S
    end
    Bs = Bs * Bs mod S
    E //= 2
  end
  T = 2 * Rs mod S
  if S odd and S greater 1
    Ls = (S + 2 to N // S by 2) copy
    Ls = Ls (U (Ls mod S) indices)
    M = Ls * S
    X = (Ls * T (Ls mod S) - 1) mod M
    C = X max (M - X)
    B M = (B M) max C
  end
  Lo = S + 1
  if S equal 1
    Lo = 1
  end
  Ls = (Lo to N // (2 * S)) copy
  Ls = Ls (U (Ls mod S) indices)
  M = Ls * S
  X = (Ls * T (Ls mod S) - 1) mod M
  A1 = X + M
  A2 = 2 * M - X
  V1 = A1 odd and (X less M - 1)
  V2 = A2 odd and (X greater 1)
  C1 = V1 choose A1 1
  C = C1 max (V2 choose A2 1)
  N2 = 2 * M
  B N2 = (B N2) max C
end
B 0 = 0
B 1 = 0
B 2 = 0
Answer = B sum
Answer print
