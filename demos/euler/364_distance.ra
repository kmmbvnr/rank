rem Comfortable Distance
rem https://projecteuler.net/problem=364

use numbers
use sequences
use io
use cli

arg N integer = 1000000
arg Mod integer = 100000007

F = 1 to N scan * with 1 mod Mod
Inv = F N (Mod - 2) Mod powmod
I = N to 1 by -1 scan * with Inv mod Mod
I = I reverse
Pow = array shape (N // 3 + 1) fill 2
Pow = Pow scan * with 1 mod Mod
Answer = 0
for S in 1 to 3
  L = N - S
  E = S - 1
  P = L mod 2 to L // 3 by 2 array
  K = 1 + (L - P) // 2
  Ways = F (K - 1)
  Ways = Ways * Ways mod Mod
  Ways = Ways * I (K - 1 - P) mod Mod
  Ways = Ways * Pow P mod Mod
  Ways = Ways * F K mod Mod
  if E at least 1
    Ways = Ways * (P + 1) mod Mod
  end
  if E equal 2
    Ways = Ways * (P + 2) mod Mod
  end
  if S equal 2
    Ways = 2 * Ways mod Mod
  end
  Answer += Ways sum
end
Answer mod= Mod
Answer print
