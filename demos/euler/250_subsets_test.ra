use testing

test "default input"
  use "250_subsets" as solve
  Answer = solve

  Answer equal 1425480602091519
end

test "small inputs"
  use "250_subsets" as solve
  Answer = solve 2500

  Answer equal 3576981783379967
  Answer = solve 10 10

  Answer equal 103
end

test "period boundaries and non-coprime residues"
  use "250_subsets" as solve
  Answer = solve 0 250

  Answer equal 0
  Answer = solve 16 8

  Answer equal 9215
  Answer = solve 17 8

  Answer equal 17407
  Answer = solve 25 8

  Answer equal 4259839
  Answer = solve 49 7

  Answer equal 80421421917695
  Answer = solve 92 7

  Answer equal 3074443470135295
  Answer = solve 46 9

  Answer equal 7818749345791
  Answer = solve 10 1

  Answer equal 1023
end

test "arbitrary count moduli"
  use "250_subsets" as solve
  Answer = solve 503 10 1

  Answer equal 0
  Answer = solve 503 10 2

  Answer equal 1
  Answer = solve 503 10 97

  Answer equal 15
  Answer = solve 503 10 -97

  Answer equal -82
  Answer = solve 503 10 1000000000000000000000000000000

  Answer equal 15349672881218145844855832575
end
