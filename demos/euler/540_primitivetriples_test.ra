use testing

test "brute force counts"
  use "540_primitivetriples" as solve
  Answer = solve 20
  Answer equal 3
  Answer = solve 1000000
  Answer equal 159139
end


test "short bounds and small batches"
  use "540_primitivetriples" as solve
  Answer = solve 0
  Answer equal 0
  Answer = solve 4
  Answer equal 0
  Answer = solve 1000 5 7
  Answer equal 158
end
