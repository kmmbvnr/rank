use testing

test "brute force counts"
  use "540_primitivetriples"
  N = 20
  run
  Answer equal 3
  N = 1000000
  run
  Answer equal 159139
end


test "short bounds and small batches"
  use "540_primitivetriples"
  N = 0
  run
  Answer equal 0
  N = 4
  run
  Answer equal 0
  N = 1000
  Table = 5
  Batch = 7
  run
  Answer equal 158
end
