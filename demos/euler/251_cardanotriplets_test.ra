use testing

test "default input"
  use "251_cardanotriplets"
  run

  Answer equal 18946051
end

test "small limits"
  use "251_cardanotriplets"
  Limit = 1000
  run

  Answer equal 149
  Limit = 20000
  run

  Answer equal 3312
  Limit = 1000000
  run

  Answer equal 171128
end

test "empty limits and candidate boundaries"
  use "251_cardanotriplets"
  Limit = 0
  run

  Answer equal 0
  Limit = 8
  run

  Answer equal 1
  Limit = 9
  run

  Answer equal 1
  Limit = 45
  run

  Answer equal 5
  Limit = 46
  run

  Answer equal 6
  Limit = 57
  run

  Answer equal 7
  Limit = 58
  run

  Answer equal 8
  Limit = 67
  run

  Answer equal 8
  Limit = 68
  run

  Answer equal 9
end
