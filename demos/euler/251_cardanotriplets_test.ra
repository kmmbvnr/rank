use testing

test "default input"
  use "251_cardanotriplets" as solve
  Answer = solve

  Answer equal 18946051
end

test "small limits"
  use "251_cardanotriplets" as solve
  Answer = solve 1000

  Answer equal 149
  Answer = solve 20000

  Answer equal 3312
  Answer = solve 1000000

  Answer equal 171128
end

test "empty limits and candidate boundaries"
  use "251_cardanotriplets" as solve
  Answer = solve 0

  Answer equal 0
  Answer = solve 8

  Answer equal 1
  Answer = solve 9

  Answer equal 1
  Answer = solve 45

  Answer equal 5
  Answer = solve 46

  Answer equal 6
  Answer = solve 57

  Answer equal 7
  Answer = solve 58

  Answer equal 8
  Answer = solve 67

  Answer equal 8
  Answer = solve 68

  Answer equal 9
end
