use testing

test "24 decimal places"
  use "751_concatenation" as solve
  Answer = solve
  Want = "2.223561019313554106173177"
  Answer equal Want
end

test "round down, up and carry"
  use "751_concatenation" as solve
  Answer = solve 3
  Answer equal "2.224"
  Answer = solve 4
  Answer equal "2.2236"
  Answer = solve 8
  Answer equal "2.22356102"
  Answer = solve 2
  Answer equal "2.22"
end

test "integer rounding"
  use "751_concatenation" as solve
  Answer = solve 0
  Answer equal "2"
end

test "beyond the requested precision"
  use "751_concatenation" as solve
  Answer = solve 30
  Want = "2.223561019313554106173177"
  Want += "195280"
  Answer equal Want
end
