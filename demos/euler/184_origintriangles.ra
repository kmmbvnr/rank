rem Triangles Containing the Origin
rem https://projecteuler.net/problem=184
rem Count the triangles with vertices at
rem lattice points inside the circle of
rem radius R that hold the origin
rem strictly inside

use algo
use numbers
use sequences
use io
use cli

option R integer = 105

rem Group the points by ray from the
rem origin, c points on each. Three
rem points hold the origin iff they lie
rem on three rays that no closed
rem half-plane covers. Count all triples
rem on three rays, e3 of the c values,
rem and take away those in a half-plane,
rem which start at a unique first ray i
rem with the other two in (angle i,
rem angle i + pi].
Axis = (0 - R + 1) to (R - 1) array
Cols = Axis len
X = Axis reshape Cols 1
Y = Axis reshape 1 Cols
Rad = X * X + Y * Y
Inside = Rad greater 0
Inside and= Rad less R * R
Xs = (X + Y * 0) filter Inside array
Ys = (X * 0 + Y) filter Inside array
G = Xs gcd Ys
Px' = Xs // G
Py' = Ys // G
Key = (Px + R) * (2 * R + 1) + Py + R
Seen = new counter Key
Rays = Key unique sort
C = Seen Rays
Qx' = Rays // (2 * R + 1) - R
Qy' = Rays mod (2 * R + 1) - R
Ang = Qy atan2 Qx
Ord = Ang argsort
Ang = Ang Ord
C = C Ord
M = Ang len
Pi = 3.141592653589793
Dbl' = concat Ang (Ang + 2 * Pi)
Cd = concat C C
Pc = Cd scan + with 0
Pq = (Cd * Cd) scan + with 0
Lim' = Ang + Pi + 0.000000001
Mix' = concat Dbl Lim
Om = Mix argsort
IsD = Om less 2 * M
Cum = (IsD choose 1 0) scan + with 0
Qp = (not IsD) indices
Hi = Cum Qp
Qi' = Om Qp - 2 * M
Ends = array shape M fill 0
Ends Qi = Hi
Idx = 0 till M array
S = Pc Ends - Pc (Idx + 1)
Q = Pq Ends - Pq (Idx + 1)
Bad' = (C * (S * S - Q) // 2) sum
S1 = C sum
S2' = (C * C) sum
S3' = (C * C * C) sum
Cube' = S1 * S1 * S1
All' = (Cube - 3 * S1 * S2 + 2 * S3) // 6
Answer = All - Bad
Answer print
