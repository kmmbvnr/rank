use testing

test "statement values"
  use "698_123numbers"
  Nn = 4
  run
  Answer equal 11
  Nn = 10
  run
  Answer equal 31
  Nn = 40
  run
  Answer equal 1112
  Nn = 1000
  run
  Answer equal 1223321
end

test "default input"
  use "698_123numbers"
  Nn = 111111111111222333
  run
  Answer equal 57808202
end
