use testing

test "statement values"
  use "698_123numbers" as solve
  Answer = solve 4
  Answer equal 11
  Answer = solve 10
  Answer equal 31
  Answer = solve 40
  Answer equal 1112
  Answer = solve 1000
  Answer equal 1223321
end

test "default input"
  use "698_123numbers" as solve
  Answer = solve 111111111111222333
  Answer equal 57808202
end
