rem Counting Summations
rem https://projecteuler.net/problem=76
rem Count ways to write N as a sum of at
rem least two positive integers

use linalg
use numbers
use sequences
use io
use cli

option Total integer = 100

rem Euler pentagonal recurrence: p(n)
rem sums signed p(n - g) terms for the
rem pentagonal numbers g <= n.
Root = Total isqrt
K = 1 to Root array
Odd = K mod 2 * 2 - 1
Low = K * (3 * K - 1) // 2
High = K * (3 * K + 1) // 2
Size = K len * 2
Gens = stack Low High transpose
Gen = Gens reshape Size
Signs = stack Odd Odd transpose
Sign = Signs reshape Size
Fit = Gen at most Total
Use = Gen Fit copy
Sgn = Sign Fit copy
rem Reverse storage keeps unused terms
rem in zero padding beyond p(0).
Ways = array shape (2 * Total + 1) fill 0
Ways Total = 1
for N in 1 to Total
  Base = Total - N
  Ways Base = (Ways (Use + Base)) Sgn matmul
end
Ways = Ways (Total to 0 by -1) copy
Answer = Ways Total - 1
Answer print
