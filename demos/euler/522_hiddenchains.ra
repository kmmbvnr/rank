rem Hilbert's Blackout
rem https://projecteuler.net/problem=522

use numbers
use sequences
use io
use cli

arg N integer = 12344321

Mod = 135707531
Block = 65536
Answer = 0
Carry = N mod Mod
rem With m=N-d, a term is
rem n! / m! * (m - 1)^m / d.
rem N<Mod; all divisors are units.
rem n! / m! is a descending product.
rem Batch inverses use one power per
rem block, with prefix/suffix products.
for Start in 2 to N - 2 by Block
  Last = N - 2 min (Start + Block - 1)
  Divisors = Start to Last copy
  Count = Divisors len
  Steps = N - Divisors + 1
  Scan = Steps scan * with Carry mod Mod
  Carry = Scan Count
  Weights = Scan drop 1
  Ahead = Divisors scan * with 1 mod Mod
  Product = Ahead Count
  Seed = Product (Mod - 2) Mod powmod
  Back = Divisors reverse
  Suffix = Back scan * with Seed mod Mod
  Suffix = Suffix reverse drop 1
  Ahead = Ahead take Count
  Inverse = Ahead * Suffix mod Mod
  Weights = Weights * Inverse mod Mod
  Exponents = N - Divisors
  Bases = Exponents - 1
  Powers = Bases Exponents Mod powmod
  Terms = Weights * Powers mod Mod
  Answer += Terms sum
  Answer = Answer mod Mod
end
if N greater 2
  Extra = (N - 2) (N - 1) Mod powmod
  Extra = Extra * N mod Mod
  Extra = Extra * (N - 1) mod Mod
  Answer = (Answer + Extra) mod Mod
end
return Answer
