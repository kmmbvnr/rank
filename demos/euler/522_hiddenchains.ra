rem Hidden Chains
rem https://projecteuler.net/problem=522

use numbers
use sequences
use io
use cli

arg N integer = 12344321

rem F(n) = n (n - 1) (n - 2)^(n - 1)
rem plus, over 2 <= m <= n - 2, the
rem terms n! / (m! (n - m)) (m - 1)^m
rem = C(n, m) (n - m - 1)! (m - 1)^m,
rem from factorial tables mod M.
M = 135707531
F = array shape N fill 1
for I in 1 till N
  F I = F (I - 1) * I mod M
end
Fl = F (N - 1)
Fn = Fl * N mod M
Fi = array shape N fill 1
Fi (N - 1) = Fl (M - 2) M powmod
for I in N - 1 to 1 by -1
  Fi (I - 1) = Fi I * I mod M
end
Ms = (2 to N - 2) copy
C = Fn * Fi Ms mod M * Fi (N - Ms) mod M
Pw = (Ms - 1) Ms M powmod
T = C * F (N - Ms - 1) mod M * Pw
Z = (N - 2) (N - 1) M powmod
Z = Z * N mod M * (N - 1) mod M
Answer = ((T mod M) sum + Z) mod M
Answer print
