use testing

test "default input"
  use "171_digitsquares" as solve
  Answer = solve

  Answer equal 142989277
end

test "smaller sizes"
  use "171_digitsquares" as solve
  Answer = solve 2

  Answer equal 726
  Answer = solve 3

  Answer equal 28083
  Answer = solve 5

  Answer equal 161887270
end
