rem GCD and Tiling
rem https://projecteuler.net/problem=440

use numbers
use sequences
use io
use cli

option L integer = 2000

rem T(n) = 10 T(n-1) + T(n-2) is a
rem Lucas sequence, so gcd(T(c^a),
rem T(c^b)) is T(c^d) when 2-adic
rem valuations of a and b agree and
rem d = gcd(a, b), else T(1) for odd
rem c and T(0) for even c. Pairs with
rem equal valuation and gcd d are odd
rem coprime pairs up to L // d, built
rem from phi. T has period Mod - 1.
Mod = 987898789
Pi = Mod - 1
Ph = (0 to L) copy
for P in primes to L
  Sl = P to L by P
  Ph Sl -= Ph Sl // P
end
Co = array shape (L + 1) fill 0
Co 1 = 1
for M in 2 to L
  Co M = Co (M - 1)
  if M mod 2 equal 1
    Co M += Ph M
  end
end
Ds = (1 to L) copy
Cd = Co (L // Ds)
Cdiff = L * L - (Cd sum)
Cs = (1 to L) copy
Odd = Cs mod 2 equal 1
Bs = (Odd choose 10 1) sum
Cur = Cs mod Pi
Ex = array shape (L * L) fill 0
for D in 1 to L
  Ex ((D - 1) * L to (D * L - 1)) = Cur
  Cur = Cur * Cs mod Pi
end
rem Doubling on (T(k), T(k-1)).
Tx = array shape (L * L) fill 1
Ty = array shape (L * L) fill 0
for Bit in 29 to 0 by -1
  Dx = (Tx * Tx + Ty * Ty) mod Mod
  Mid = (Mod - 10) * Ty mod Mod
  Dy = Ty * (2 * Tx + Mid) mod Mod
  Up = Ex // (2 ** Bit) mod 2 equal 1
  Nx = (10 * Dx + Dy) mod Mod
  Tx = Up choose Nx Dx
  Ty = Up choose Dx Dy
end
Wt = Cd mod Mod
Rw = Tx reshape L L
Wc = Wt reshape L 1
Pr = Rw * Wc mod Mod
Sm = (Pr sum) mod Mod
Answer = (Bs * Cdiff + Sm) mod Mod
Answer print
