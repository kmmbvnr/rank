rem Product-sum Numbers: explicit DFS
rem https://projecteuler.net/problem=88
rem Each stack frame holds product, sum,
rem factor count and smallest next factor.

use algo
use io
use sequences
use cli

option Limit integer = 12000

Big = Limit * 2
Best = array shape (Limit + 1) fill Big
Todo = new stack
Todo push array 1 0 0 2
for Todo len greater 0
  Frame = Todo pop
  unpack Prod Sum Cnt Low = Frame
  K = Prod - Sum + Cnt
  if Cnt greater 1 and K at most Limit
    if Prod less Best K
      Best K = Prod
    end
  end
  High = Big // Prod
  rem The next k is (Prod - 1) * F - Sum + Cnt + 1.
  rem Larger k cannot decrease by adding more factors.
  if Prod greater 1
    High = High min ((Limit + Sum - Cnt - 1) // (Prod - 1))
  end
  for F in Low to High
    Next = Prod * F
    Todo push array Next (Sum + F) (Cnt + 1) F
  end
end
Answer = (Best drop 2 unique) sum
Answer print
