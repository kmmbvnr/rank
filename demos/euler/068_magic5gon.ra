rem Magic 5-gon Ring
rem https://projecteuler.net/problem=68
rem Largest 16-digit string of a magic
rem 5-gon ring with numbers 1 to 10

use algo
use sequences
use text
use io

rem Ten stays outside, so the inner ring
rem takes five of 1 to 9; it fixes the
rem line sum.
Answer = 0
for Inner in (1 to 9) 5 combinations
  Total = Inner sum
  if Total mod 5 not equal 0
    continue
  end
  Side = (55 + Total) // 5
  Out = (1 to 10) filter not in Inner
  Rest = Out array
  for Ring in Inner permutations
    Tail = Ring drop 1
    Next = concat Tail (Ring take 1)
    Outer = Side - Ring - Next
    Sorted = Outer sort
    Same = Sorted Rest equal rank 1
    if not Same
      continue
    end
    rem Lines clockwise from the least
    rem outer node, as one integer.
    Cols = stack Outer Ring Next
    Rows = Cols transpose
    Start = Outer min .index
    Order = ((0 to 4) + Start) mod 5
    Picked = Rows Order
    Flat = Picked reshape 15
    Digits = Flat text rank 0
    Joined = Digits "" join
    Value = Joined integer
    Answer = Answer Value max
  end
end
Answer print
