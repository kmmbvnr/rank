use testing

test "no ladder pairs"
  use "309_ladders"
  Limit = 3
  run

  Answer equal 0
end

test "statement range"
  use "309_ladders"
  Limit = 200
  run

  Answer equal 5
end

test "larger range"
  use "309_ladders"
  Limit = 1000
  run

  Answer equal 76
end

test "many width groups"
  use "309_ladders"
  Limit = 10000
  run

  Answer equal 1438
end

test "strict ladder length boundary"
  use "309_ladders"
  Limit = 119
  run

  Answer equal 2
end

test "length 119 becomes eligible"
  use "309_ladders"
  Limit = 120
  run

  Answer equal 3
end
