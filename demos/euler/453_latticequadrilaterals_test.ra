use testing

test "statement grids"
  use "453_latticequadrilaterals" as solve
  Answer = solve 2 2 1000000007
  Answer equal 94
  Answer = solve 3 7 1000000007
  Answer equal 39590
  Answer = solve 12 3 1000000007
  Answer equal 309000
end

test "exact 123 by 45"
  use "453_latticequadrilaterals" as solve
  Answer = solve 123 45 1000000000000037
  Answer equal 70542215894646
end

test "default input"
  use "453_latticequadrilaterals" as solve
  Answer = solve
  Answer equal 104354107
end
