rem Yarra Gnisrever
rem https://projecteuler.net/problem=680

use numbers
use sequences
use io
use cli

arg Nn integer = 1000000000000000000
arg Kk integer = 1000000

rem The rope stores arithmetic runs.
rem Each reversal splits two paths,
rem flips the middle and joins them.
rem Reduce the final runs analytically;
rem never enumerate the logical array.
Md = 1000000000
Parts = Nn reversal_runs Kk
Rx = Parts # 0
Rd = Parts # 1
Rl = Parts # 2
Ps = (Rl scan +) - Rl
Pq = Ps mod Md
Xq = Rx mod Md
Lq = Rl mod Md
Ev = Rl mod 2 equal 0 integer
H1 = Ev * (Rl // 2) + (1 - Ev) * Rl
Rm1 = Rl - 1
H2 = Ev * Rm1 + (1 - Ev) * (Rm1 // 2)
S1 = (H1 mod Md) * (H2 mod Md) mod Md
Ca = Ev * (Rl // 2) + (1 - Ev) * Rl
Cb = H2
Cc = 2 * Rl - 1
Da = Ca mod 3 equal 0 integer
Db = Cb mod 3 equal 0 integer
Db = Db * (1 - Da)
Dc = 1 - Da - Db
Ca = Da * (Ca // 3) + (1 - Da) * Ca
Cb = Db * (Cb // 3) + (1 - Db) * Cb
Cc = Dc * (Cc // 3) + (1 - Dc) * Cc
S2 = (Ca mod Md) * (Cb mod Md) mod Md
S2 = S2 * (Cc mod Md) mod Md
T0 = Lq * Pq mod Md * Xq mod Md
Tw = (Pq * Rd + Xq + Md) mod Md
T1 = Tw * S1 mod Md
T2 = (Rd * S2 + Md) mod Md
Tt = T0 + T1 + T2
Answer = Tt sum mod Md
return Answer

fun Size reversal_runs Count
  Order = 0 till Size rope
  Fa = 1 mod Size
  Fb = 1 mod Size
  for J in 0 till Count
    Lo = Fa min Fb
    Hi = Fa max Fb
    Order = Order Lo Hi reverse
    Fc = (Fa + Fb) mod Size
    Fb = (Fc + Fb) mod Size
    Fa = Fc
  end
  return Order runs
end
