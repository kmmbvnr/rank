rem A Polynomial Modulo the Square of
rem a Prime
rem https://projecteuler.net/problem=457

use numbers
use sequences
use io
use cli

arg L integer = 10000000

rem Cipolla needs a^2 - 13 non-square.
fun Primes seed
  Count = Primes len
  Seeds = array shape Count fill 0
  Pending = 0 till Count copy
  Trial = 1
  for Pending len greater 0
    Values = Primes Pending
    Half = (Values - 1) // 2
    Square = Trial * Trial - 13
    Symbol = Square Half Values powmod
    Ready = Symbol equal (Values - 1)
    Seeds (Pending Ready) = Trial
    Pending = Pending (not Ready)
    Trial += 1
  end
  return Seeds
end

rem (a + w)^((p+1)/2), w^2 = a^2 - 13.
fun Primes cipolla
  Base = Primes seed
  Square = Base * Base - 13
  Square = Square mod Primes
  Power = (Primes + 1) // 2
  Real = Primes * 0 + 1
  Radical = Primes * 0
  Part = Real
  for Power greater 0 any
    Odd = Power mod 2 equal 1
    Mix = Radical * Part mod Primes
    Next = Real * Base + Mix * Square
    Pair = Real * Part + Radical * Base
    Next = Next mod Primes
    Pair = Pair mod Primes
    Real = Odd choose Next Real
    Radical = Odd choose Pair Radical
    Mix = Part * Part mod Primes
    Next = Base * Base + Mix * Square
    Part = 2 * Base * Part mod Primes
    Base = Next mod Primes
    Power //= 2
  end
  return Real
end

rem For p = 3 mod 4, a single power
rem suffices; Cipolla handles the rest.
fun Primes root
  Simple = Primes mod 4 equal 3
  Fast = Primes Simple
  Roots = Primes * 0
  Power = (Fast + 1) // 4
  Roots Simple = 13 Power Fast powmod
  Hard = not Simple
  Roots Hard = Primes Hard cipolla
  return Roots
end

rem Reciprocity: (13/p) = (p/13).
rem This also excludes 2 and 13.
Primes = primes to L array
Residues = array 1 3 4 9 10 12
Keep = Primes mod 13 in Residues
Primes = Primes Keep
Root = Primes root
Half = (Primes + 1) // 2
Start = (3 + Root) * Half mod Primes
rem Hensel lifts Start to Start + t*p.
Value = Start * Start - 3 * Start - 1
Value //= Primes
Slope = (2 * Start - 3) mod Primes
Exponent = Primes - 2
Inverse = Slope Exponent Primes powmod
Shift = (0 - Value) mod Primes * Inverse
Shift = Shift mod Primes
Lifted = Start + Shift * Primes
rem The other lifted root sums to 3.
Square = Primes * Primes
Other = (3 - Lifted) mod Square
return Lifted min Other sum
