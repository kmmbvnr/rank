use testing

test "default input"
  use "089_roman"
  run

  Answer equal 743
end

test "statement and mixed lines"
  use "089_roman"
  use io
  Input = "/tmp/euler089.txt"
  "XIIIIII\n" "/tmp/euler089.txt" write
  run

  Answer equal 4
  "XVI\n" "/tmp/euler089.txt" write
  run

  Answer equal 0
  "IIII\nXXXXVIIII\nMMMMDCLXXII\n" "/tmp/euler089.txt" write
  run

  Answer equal 7
  "DCCCC\nLXXXX\nCCCC" "/tmp/euler089.txt" write
  run

  Answer equal 8
  "IX\nXLIV\nCM\n" "/tmp/euler089.txt" write
  run

  Answer equal 0
end
