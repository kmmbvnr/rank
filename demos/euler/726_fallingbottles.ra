rem Falling Bottles
rem https://projecteuler.net/problem=726

use numbers
use sequences
use io
use cli

arg Nn integer = 10000
arg Pm integer = 1000000033

rem Removing all bottles counts the
rem linear extensions of the triangle
rem poset: by the hook formula
rem f(n) = T! prod over h of R_h^(n-h+1)
rem with T = n (n + 1) / 2 and R_h =
rem (2^h - 1) / (2h - 1). Prefix
rem products of R give Q, and of Q the
rem powers; T! is a prefix product too.
fun A mulp B = A * B mod Pm
Hs = 1 to Nn
Num = (2 Hs Pm powmod) - 1
Inv = (2 * Hs - 1) (Pm - 2) Pm powmod
Rr = Num * Inv mod Pm
Qq = Rr scan mulp
Pp = Qq scan mulp
Tn = Hs * (Hs + 1) // 2
Fa = (1 to Nn * (Nn + 1) // 2) scan mulp
Ff = (Fa (Tn - 1)) * Pp mod Pm
Answer = Ff sum mod Pm
Answer print
