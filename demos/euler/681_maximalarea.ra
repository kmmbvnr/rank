rem Maximal Area
rem https://projecteuler.net/problem=681

use numbers
use sequences
use algo
use io
use cli

arg Nn integer = 1000000

rem The best quadrilateral is cyclic, so
rem with x, y, z, w = s - a, s - b, s -
rem c, s - d the area m has m^2 = x y z
rem w, and a, b, c, d are positive and
rem the perimeter even when x >= y >= z
rem >= w, x < y + z + w, x + y + z + w
rem even. For each m take the divisors
rem D of m^2: w^4 <= m^2, z from D with
rem w z^3 <= m^2, w z | m^2 and r = m^2
rem / (w z). Then x y = r with y <= x <
rem y + z + w, so y lies in [sqrt(r) -
rem (z + w), sqrt(r)] among D; those
rem are found by a range search.
rem y > (sqrt((z+w)^2 + 4r) - z - w)/2
rem tightens that range. M runs in
rem blocks of Bk: divisors <= M of all
rem block members are kept as keys
rem owner * Bb + d, sorted together.
rem Keys fit Int32 while Bk * Bb <= 2^31
rem and Nn < Bb.
Sp = 1048575 factorsieve
Bk = 1024
Bb = 2 ** 21
Answer = 0
for Bi in 0 to ((Nn - 1) // Bk)
  M0 = Bi * Bk + 1
  Ms = M0 to ((M0 + Bk - 1) min Nn)
  N = Ms len
  Ow = 0 to (N - 1)
  Po = Ow
  D = array shape N fill 1
  X = Ms
  for (X max) greater 1
    Ia = (X greater 1) indices
    Xa = X Ia
    P = Sp Xa
    Ea = array shape (Ia len) fill 0
    Dm = Xa * 0 + 1
    for (Dm max) greater 0
      Dm = (Xa mod P equal 0) integer
      Xa = Xa // (P ** Dm)
      Ea += Dm
    end
    X (Ia) = Xa
    Pf = array shape N fill 1
    Pf (Ia) = P
    Ef = array shape N fill 0
    Ef (Ia) = Ea
    Cn = 2 * (Ef Po) + 1
    Tot = Cn sum
    Of = (Cn scan +) - Cn
    Mk = array shape Tot fill 0
    Mk (Of) = 1
    Pd = (Mk scan +) - 1
    Ko = (0 to (Tot - 1)) - Of Pd
    D = D Pd * (Pf (Po Pd)) ** Ko
    Po = Po Pd
    Kp = (D at most Ms Po) indices
    D = D Kp
    Po = Po Kp
  end
  Dk = (Po * Bb + D) sort
  Do = Dk // Bb
  Dd = Dk mod Bb
  Mo = Ms Do
  Rt = Ms isqrt
  We = Dk upperindex (Ow * Bb + Rt)
  Ix = 0 to (Dk len - 1)
  Wi = (Ix less We Do) indices
  Wm = Mo Wi
  Wv = Dd Wi
  Zq = (Wm * Wm // Wv * 1.0) ** (1 / 3)
  Zb = (Zq floor) integer + 2
  Zc = Zb min Wm
  Ze = Dk upperindex (Do Wi * Bb + Zc)
  Cw = Ze - Wi
  Of = (Cw scan +) - Cw
  Tot = Cw sum
  Mk = array shape Tot fill 0
  Mk (Of) = 1
  Pd = (Mk scan +) - 1
  Wr = Wi Pd
  Zr = (0 to (Tot - 1)) + (Wi - Of) Pd
  Wp = Dd Wr
  Zp = Dd Zr
  M2 = (Mo * Mo) Wr
  Z3 = Zp * Zp * Zp * Wp
  Ok = (Z3 at most M2) integer
  Wz = Wp * Zp
  Dz = (M2 mod Wz equal 0) integer
  Ok = Ok * Dz
  Fl = (Ok equal 1) indices
  Wr = Wr Fl
  Wp = Wp Fl
  Zp = Zp Fl
  Rr = M2 Fl // (Wp * Zp)
  Sq = Rr isqrt
  Ss = Zp + Wp
  Dc = (Ss * Ss + 4 * Rr) isqrt
  Yl = ((Dc - Ss) // 2) max Zp
  Ob = Do Wr * Bb
  Lo = Dk lowerindex (Ob + Yl)
  Hi = Dk upperindex (Ob + Sq)
  Cf = (Hi - Lo) max 0
  Tot = Cf sum
  Of = (Cf scan +) - Cf
  Mk = array shape Tot fill 0
  Pk = (Cf greater 0) indices
  Mk (Of Pk) = 1
  Pd = Pk ((Mk scan +) - 1)
  Ij = (0 to (Tot - 1)) + (Lo - Of) Pd
  Yv = Dd Ij
  Rv = Rr Pd
  Dv = (Rv mod Yv equal 0) indices
  Yv = Yv Dv
  Xv = (Rv Dv) // Yv
  Sm = Yv + Zp (Pd Dv) + Wp (Pd Dv)
  Gd = (Xv less Sm) integer
  Tt = Xv + Sm
  Gd = Gd * ((Tt mod 2 equal 0) integer)
  Answer += (Tt * Gd) sum
end
Answer print
