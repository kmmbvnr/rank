rem Retractions C
rem https://projecteuler.net/problem=447

use numbers
use sequences
use io
use cli
arg N integer = 100000000000000
arg Cut integer = 0

rem R(n) = unitary_sigma(n) - n.
rem Sum mu(t) t T(N // t^2), where T
rem is the prefix sum of divisor sums.
rem mu(2u) = -mu(u) for odd u;
rem multiples of four contribute zero.
Mod = 1000000007
Block = 131072
rem Odd t and twice odd t share a table.
Root = N isqrt
rem Balance the sieve and hyperbola.
Scale = Root isqrt
Chosen = Cut
if Chosen less 1
  Chosen = 2 * Scale max 1
end
Direct = Root min Chosen
PrefixBound = N // ((Direct + 1) ** 2)

fun Bound odd_mobius
  Size = (Bound + 1) // 2
  Mu = array shape Size fill 1
  Removed = array shape Size fill 1
  Top = Bound isqrt
  Primes = primes from 3 to Top copy
  Count = Primes len
  Index = 0
  Power = 3
  for Index less Count
    Prime = Primes Index
    Start = Power // 2
    PrimeSlots = Start till Size by Power
    Removed PrimeSlots *= Prime
    if Power equal Prime
      Mu PrimeSlots *= -1
    end
    Power *= Prime
    if Power greater Bound
      Square = Prime * Prime
      Start = Square // 2
      Squares = Start till Size by Square
      Mu Squares = 0
      Index += 1
      if Index less Count
        Power = Primes Index
      end
    end
  end
  Keys = 1 to Bound by 2 copy
  Large = Keys // Removed greater 1
  Mu = Large choose (0 - Mu) Mu
  return Mu
end

fun Bound sigma_prefix
  Size = Bound + 1
  Sigma = array shape Size fill 0
  PrimeBound = Bound isqrt
  for Divisor in 1 to PrimeBound
    Square = Divisor * Divisor
    Keys = Square to Bound by Divisor copy
    Values = Keys // Divisor + Divisor
    Sigma Keys += Values
    Sigma Square -= Divisor
  end
  return (Sigma scan +) mod Mod
end

Mu = Root odd_mobius
Prefix = PrefixBound sigma_prefix

fun Value divisor_sum
  if Value at most PrefixBound
    return Prefix Value
  end
  Bound = Value isqrt
  Total = 0
  for Start in 1 to Bound by Block
    Stop = Bound min (Start + Block - 1)
    Keys = Start to Stop copy
    Quotients = Value // Keys
    Even = Quotients mod 2 equal 0
    Half = Quotients // 2
    First = Even choose Half Quotients
    Next = Quotients + 1
    Second = Even choose Next (Next // 2)
    First = First mod Mod
    Second = Second mod Mod
    Triangles = First * Second mod Mod
    Products = Keys * Quotients mod Mod
    Terms = (Triangles + Products) mod Mod
    Part = Terms sum
    Total = (Total + Part) mod Mod
  end
  Base = Bound * (Bound + 1) // 2
  Base = Base mod Mod
  Factor = Bound mod Mod
  Correction = Factor * Base mod Mod
  return (Total - Correction) mod Mod
end

Total = 0
for Divisor in 1 to Direct by 2
  Coefficient = Mu (Divisor // 2)
  if Coefficient not equal 0
    Value = N // (Divisor * Divisor)
    First = Value divisor_sum
    Second = (Value // 4) divisor_sum
    Difference = First - 2 * Second
    Weight = Coefficient * Divisor
    Part = Weight * Difference mod Mod
    Total = (Total + Part) mod Mod
  end
end

fun Start remainder_sum
  Count = Mu len
  Total = 0
  for First in Start till Count by Block
    Stop = Count min (First + Block)
    Keys = First till Stop copy
    Times = 2 * Keys + 1
    Values = N // (Times * Times)
    High = Prefix Values
    Low = Prefix (Values // 4)
    Difference = High - 2 * Low
    Weights = Mu Keys * Times
    Terms = Weights * Difference mod Mod
    Part = Terms sum
    Total = (Total + Part) mod Mod
  end
  return Total
end

TailStart = (Direct + 1) // 2
Total += TailStart remainder_sum
Twice = 2 * Mod
Left = N mod Twice
Right = (N + 1) mod Twice
Triangle = Left * Right // 2
Answer = (Total - Triangle) mod Mod
return Answer
