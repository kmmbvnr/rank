rem Weighted Lattice Paths
rem https://projecteuler.net/problem=638

use numbers
use io
use cli

arg A integer = 0
arg B integer = 0
arg K integer = 0

rem The paths weighted by k^area sum to
rem the Gaussian binomial [a + b, a]_k
rem = prod (k^(b + i) - 1) / (k^i - 1),
rem i = 1 to a, and to C(a + b, a) for
rem k = 1. With A = 0 the answer is the
rem sum over k = 1 to 7 of C(10^k + k,
rem 10^k + k, k).
M = 1000000007
Ks = 1 to 7
if A greater 0
  Ks = K to K
end
Answer = 0
for Kk in Ks
  Aa = 10 ** Kk + Kk
  Bb = Aa
  if A greater 0
    Aa = A
    Bb = B
  end
  Nu = 1
  De = 1
  if Kk equal 1
    Hi = Bb + Aa
    Nu = (Bb + 1 to Hi) reduce * mod M
    De = (1 to Aa) reduce * mod M
  else
    Ks' = array shape Aa fill Kk
    Pw = Ks scan * with 1 mod M
    Pk = Pw (1 to Aa)
    Sh = Kk Bb M powmod
    Pn = Pk * Sh mod M
    Nu = (Pn - 1) reduce * mod M
    De = (Pk - 1) reduce * mod M
  end
  Iv = De (M - 2) M powmod
  Answer = (Answer + Nu * Iv) mod M
end
Answer print
