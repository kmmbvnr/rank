use testing

test "statement values"
  use "632_squareprimefactors" as solve
  Answer = solve 1000
  Answer equal 10010112
  Answer = solve 1000000
  Answer equal 547801427
  Answer = solve 100000000
  Answer equal 914160256
end

test "default input"
  use "632_squareprimefactors" as solve
  Answer = solve
  Answer equal 728378714
end
