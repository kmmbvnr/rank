use testing

test "default input"
  use "080_sqrtdigits" as solve
  Answer = solve

  Answer equal 40886
end

test "square root of two"
  use "080_sqrtdigits" as solve
  Answer = solve 2

  Answer equal 475
end

test "first digits only"
  use "080_sqrtdigits" as solve
  Answer = solve 10 1

  Answer equal 13
  Answer = solve 10 5

  Answer equal 123
end
