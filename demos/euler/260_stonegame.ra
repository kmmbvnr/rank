rem Stone Game
rem https://projecteuler.net/problem=260
rem Sum the losing positions X <= Y <= Z <= Top.
rem For fixed Y,Z there is at most one losing X:
rem the pair mark makes all later X winning.
rem Pr B stores bits A for fixed pairs A,B.
rem Dr C stores reversed bits Top-D for fixed
rem difference D and third pile C; Df is its transpose.
rem Eq B stores reversed bits Top-A for the two gaps.
rem Align those rows with X, union the forbidden
rem positions, then choose the least unmarked bit.
use numbers
use bits
use io
use cli
arg Top integer = 1000
W = Top + 1
Pr = array shape W fill 0
Dr = array shape W fill 0
Df = array shape W fill 0
Eq = array shape W fill 0
Sum = 0
for Z in 0 to Top
  for Y in 0 to Z
    if Pr Z bit Y
      continue
    end
    Gap = Z - Y
    Hit = Pr Y bor Pr Z
    Hit = Hit bor (Dr Z shr (Top - Y))
    Hit = Hit bor (Dr Y shr (Top - Z))
    Hit = Hit bor Df Gap
    Hit = Hit bor (Eq Gap shr (Top - Y))
    Free = (Hit bnot) band ((1 shl (Y + 1)) - 1)
    if Free not equal 0
      Low = Free band (-Free)
      X = (Low binary len) - 1
      Sum += X + Y + Z
      Bx = 1 shl X
      By = 1 shl Y
      Bz = 1 shl Z
      Pr Y = Pr Y bor Bx
      Pr Z = Pr Z bor Bx bor By
      Dr Z = Dr Z bor (1 shl (Top - Y + X))
      Dr Y = Dr Y bor (1 shl (Top - Z + X))
      Dr X = Dr X bor (1 shl (Top - Z + Y))
      Df (Y - X) = Df (Y - X) bor Bz
      Df (Z - X) = Df (Z - X) bor By
      Df Gap = Df Gap bor Bx
      Eq Gap = Eq Gap bor (1 shl (Top - Y + X))
    end
  end
end
Answer = Sum
Answer print
