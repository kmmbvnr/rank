use testing

test "small reflexive positions"
  use "305_reflexive" as entry
  Answer = entry 1

  rem The occurrences of 3 start at 3, 17, 37, ...
  Answer equal 37
end

test "published checkpoints"
  use "305_reflexive"
  5 solve equal 81
  12 solve equal 271
  7780 solve equal 111111365
end

test "overlaps and decimal width boundaries"
  use "305_reflexive"
  1 solve equal 1
  9 solve equal 169
  10 solve equal 214
  11 solve equal 235
  99 solve equal 18088
  101 solve equal 39715
end
