rem Sum of Digits - Experience 13
rem https://projecteuler.net/problem=377

use linalg
use io
use cli

arg Terms integer = 17

Mod = 10 ** 9
Mat = array shape 18 18 fill 0
for D in 1 to 9
  Mat 0 (D - 1) += 10
  Mat 0 (D + 8) += D
  Mat 9 (D + 8) = 1
end
for I in 1 to 8
  Mat I (I - 1) = 1
  Mat (I + 9) (I + 8) = 1
end
rem Only the count at sum zero is one.
rem Entry 0 9 gives the wanted sum.
Answer = 0
for I in 1 to Terms
  Mat = Mat matpow 13 mod Mod
  Answer += Mat 0 9
  Answer mod= Mod
end
return Answer
