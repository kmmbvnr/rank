rem Sum of Digits - Experience 13
rem https://projecteuler.net/problem=377

use io
use cli

option Terms integer = 17

Mod = 10 ** 9
Cnt = array shape 9 fill 0
Sum = array shape 9 fill 0
Cnt 0 = 1
for N in 1 to 8
  for D in 1 to 9
    if D at most N
      Cnt N += Cnt (N - D)
      Sum N += 10 * (Sum (N - D))
      Sum N += D * (Cnt (N - D))
    end
  end
  Cnt N = Cnt N mod Mod
  Sum N = Sum N mod Mod
end
Mat = array shape 18 18 fill 0
for D in 1 to 9
  Mat 0 (D - 1) += 10
  Mat 0 (D + 8) += D
  Mat 9 (D + 8) = 1
end
for I in 1 to 8
  Mat I (I - 1) = 1
  Mat (I + 9) (I + 8) = 1
end
State = array shape 18 fill 0
for I in 0 to 8
  State I = Sum (8 - I)
  State (I + 9) = Cnt (8 - I)
end
Answer = 0
Power = 13
for I in 1 to Terms
  V = Mat (Power - 8) State jump
  Answer += V 0
  Answer = Answer mod Mod
  Power *= 13
end
Answer print

fun A B mul
  C = array shape 18 18 fill 0
  for I in 0 to 17
    for K in 0 to 17
      X = A I K
      if X equal 0
        continue
      end
      for J in 0 to 17
        C I J += X * (B K J)
        C I J = C I J mod Mod
      end
    end
  end
  return C
end

fun A V apply
  W = array shape 18 fill 0
  for I in 0 to 17
    for J in 0 to 17
      W I += (A I J) * (V J)
      W I = W I mod Mod
    end
  end
  return W
end

fun A E V jump
  R = array shape 18 18 fill 0
  for I in 0 to 17
    R I I = 1
  end
  for E greater 0
    if E mod 2 equal 1
      R = R A mul
    end
    A = A A mul
    E //= 2
  end
  return R V apply
end
