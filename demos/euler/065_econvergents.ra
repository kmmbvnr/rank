rem Convergents of e
rem https://projecteuler.net/problem=65
rem Digit sum of the numerator of the
rem 100th convergent of e

use sequences
use io
use cli

option Count integer = 100

Start = record
  .prev = 1
  .num = 2
end
Steps = 1 till Count
Last = Steps scan next with Start last
Num = Last .num
Answer = Num text integer rank 0 sum
Answer print

rem Term k of e is 2(k + 1) / 3 on
rem every third place, else 1.
fun S K next
  Third = (K + 1) mod 3 equal 0
  Big = (K + 1) * 2 // 3
  Term = Third choose Big 1
  return record
    .prev = S .num
    .num = Term * S .num + S .prev
  end
end
