rem Polygonal Number Maps
rem https://projecteuler.net/problem=647

use numbers
use sequences
use io
use cli

arg N integer = 1000000000000

rem With m = k - 2 odd, 8 m P + (m -
rem 2)^2 is a square, and A P + B stays
rem k-gonal exactly for A = c^2, c =
rem 1 + 2 m t, B = t (m t + 1) (m -
rem 2)^2 / 2 with t >= 1. So F_k sums
rem A + B while both are at most N,
rem and the answer sums over odd m.
rem Pairs (m, t) have m t <= (sqrt N -
rem 1) / 2: t up to Tc is vectorized
rem over m, the rest over t for m.
Sq = N isqrt
Mt = (Sq - 1) // 2
Tc = Mt isqrt + 1
Answer = 0
Lm = N * 1.000001
for T in 1 to Tc
  Ms = 1 to (Mt // T) by 2
  Cq = (Ms - 2) * (Ms - 2)
  Bf = (T * (Ms * T + 1) * Cq) / 2.0
  Mk = Ms ((Bf at most Lm) indices)
  Cm = (Mk - 2) * (Mk - 2)
  Bb = T * (Mk * T + 1) * Cm // 2
  Ok = (Bb at most N) integer
  Cc = 1 + 2 * Mk * T
  Answer += ((Cc * Cc + Bb) * Ok) sum
end
for M in 1 to Tc by 2
  Tm = Mt // M
  if Tm greater Tc
    Ts = (Tc + 1) to Tm
    Cq = (M - 2) * (M - 2)
    Bf = (Ts * (M * Ts + 1) * Cq) / 2.0
    Tk = Ts ((Bf at most Lm) indices)
    Bb = Tk * (M * Tk + 1) * Cq // 2
    Ok = (Bb at most N) integer
    Cc = 1 + 2 * M * Tk
    Answer += ((Cc * Cc + Bb) * Ok) sum
  end
end
Answer print
