rem Standing on the Shoulders of Trolls
rem https://projecteuler.net/problem=732

use numbers
use sequences
use io
use cli

arg Trolls integer = 1000

rem With shoulder heights a, arm lengths
rem b and IQs w, a troll can finish a
rem stack at time s + a only up to the
rem deadline d = A + b + a - T, where
rem A = sum a and T = ceil(A / sqrt 2).
rem A set is feasible when it passes in
rem deadline order, so a knapsack over
rem the total height t keeps the best
rem total IQ for each t.
Index = 0 to 3 * Trolls - 1
Powers = 5 Index 1000000007 powmod
Values = Powers mod 101 + 50
Table = Values reshape Trolls 3
Heights = Table # 0
Reach = Table # 1
IQ = Table # 2
Total = Heights sum
Target = (Total * Total // 2) isqrt
Square = Total * Total
if 2 * Target * Target less Square
  Target += 1
end
Deadlines = Total + Reach
Deadlines = Deadlines - Target + Heights
Key = Deadlines * 1000 + Heights
Order = Key argsort
SortedD = Deadlines Order
SortedH = Heights Order
SortedIQ = IQ Order
Horizon = SortedD max
Size = Horizon + 1
Best = array shape Size fill -1000000
Best 0 = 0
for Step in 0 to Trolls - 1
  Height = SortedH Step
  Deadline = SortedD Step
  if Deadline at least Height
    Reach2 = Deadline - Height
    Gain = SortedIQ Step
    Shifted = Best (0 to Reach2) + Gain
    Window = Best (Height to Deadline)
    Both = Window max Shifted
    Best (Height to Deadline) = Both
  end
end
Answer = Best max
return Answer
