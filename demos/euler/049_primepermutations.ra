rem Prime Permutations
rem https://projecteuler.net/problem=49
rem Concatenate the second four-digit prime
rem permutation arithmetic sequence

use sequences
use io

Answer = 1000 10000 prime_permutation_sequence
Answer print


rem Search increasing prime pairs and derive
rem the only possible third arithmetic term.
fun prime_permutation_sequence Lower Upper
  Values = (primes from Lower) until Upper array
  for A in Values
    if A not equal 1487
      Key = A text sort
      for B in Values
        if B greater A
          C = 2 * B - A
          if C at least Upper
            break
          end
          if C in primes
            if B text sort equal Key
              if C text sort equal Key
                Result = A text + (B text)
                Result += C text
                return Result integer
              end
            end
          end
        end
      end
    end
  end
  return 0
end
