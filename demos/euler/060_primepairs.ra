rem Prime Pair Sets
rem https://projecteuler.net/problem=60
rem Minimum sum of five primes whose
rem pairwise concatenations are prime

use graph
use sequences
use io

Seed = 10000 build
Upper = Seed 50000 min_five
if Upper equal 50000
  raise "no five-prime set in seed"
end

rem A better set has every prime
rem below Upper.
Full = Upper build
Answer = Full Upper min_five
Answer print


rem Connect pairs when both decimal
rem concatenations are prime.
fun build Limit
  Candidates = primes from 3
  Vals = Candidates until Limit copy
  Keep = Vals not equal 5
  Vals = (Vals Keep) copy
  Graph = new graph Vals .undirected

  for P i in Vals
    Later = Vals (i + 1) drop
    for Q in Later
      Same = P % 3 equal Q % 3
      if P equal 3 or Q equal 3 or Same
        if P Q compatible
          Graph add P Q
        end
      end
    end
  end

  return record
    .primes = Vals
    .graph = Graph
  end
end


fun compatible P Q
  PQ = P Q concat
  if PQ not in primes
    return false
  end
  QP = Q P concat
  return QP in primes
end


fun concat A B
  Scale = 10
  for Scale at most B
    Scale *= 10
  end
  return A * Scale + B
end


rem Keep Best if no cheaper set exists.
rem Data holds ascending positive values
rem and their graph.
fun min_five Data Best
  Graph = Data .graph
  Vals = Data .primes
  Vals 5 0 search
  return Best

  fun search Rest Need Sum
    if Rest len less Need
      return Best
    end
    Small = Rest Need take
    if Sum + Small sum at least Best
      return Best
    end

    for P i in Rest
      Total = Sum + P
      if Total at least Best
        break
      end
      Left = Need - 1
      if Left equal 0
        Best = Total
        return Best
      end

      Later = Rest (i + 1) drop
      Neighbors = Graph P
      Mask = Later in Neighbors
      Next = (Later Mask) copy
      Next Left Total search
    end
    return Best
  end
end
