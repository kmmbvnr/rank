use testing

test "default input"
  use "290_digitalsignature"
  run

  Answer equal 20444710234716473
end

test "few digits"
  use "290_digitalsignature"
  N = 0
  run

  Answer equal 1
  N = 1
  run

  Answer equal 2
  N = 2
  run

  Answer equal 4
  N = 3
  run

  Answer equal 33
  N = 6
  run

  Answer equal 27955
end
