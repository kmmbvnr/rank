use testing

test "statement array values"
  use "150_subtriangle" as solve
  Out = solve 3
  T = Out .t

  T 0 equal 273519
  T 1 equal -153582
  T 2 equal 450905
end

test "smaller triangles"
  use "150_subtriangle" as solve
  Out = solve 7
  Answer = Out .answer

  Answer equal -488152
  Out = solve 100
  Answer = Out .answer

  Answer equal -38951741
  Out = solve 200
  Answer = Out .answer

  Answer equal -87957828
end


test "smallest triangles"
  use "150_subtriangle" as solve
  Out = solve 1
  Answer = Out .answer

  Answer equal 273519
  Out = solve 2
  Answer = Out .answer

  Answer equal -153582
end
