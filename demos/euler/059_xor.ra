rem XOR Decryption
rem https://projecteuler.net/problem=59

use bits
use text
use sequences
use io
use cli

argument Input path = "demos/euler/fixtures/0059_cipher.txt"

Cipher = Input read "," split integer rank 0
Weights = english_weights
Key = Cipher Weights best_key
Plain = Cipher Key decrypt
Answer = Plain sum
Answer print


rem Stream the three-letter keys without building a matrix.
fun keys
  for A in 97 to 122
    for B in 97 to 122
      for C in 97 to 122
        yield array A B C
      end
    end
  end
end


rem Gather repeats the key; bxor applies to corresponding bytes.
fun decrypt Cipher Key
  Size = Cipher len
  Positions = 0 till Size
  KeyLen = Key len
  Slots = Positions mod KeyLen
  KeyStream = Key Slots
  return Cipher KeyStream bxor
end


rem Prefer common English letters and spaces; penalize control bytes.
fun english_weights
  Weights = array shape 128 fill -100
  for Code in 32 to 126
    Weights Code = 0
  end
  Letters = "abcdefghijklmnopqrstuvwxyz"
  Frequencies = array 8 1 3 4 13 2 2 6 7 1 1 4 2 7 8 2 1 6 6 9 3 1 2 1 2 1
  for Letter I in Letters
    Code = Letter codepoint
    Weights Code = Frequencies I
    Weights (Code - 32) = Frequencies I
  end
  Weights 32 = 15
  Weights 9 = 0
  Weights 10 = 0
  Weights 13 = 0
  return Weights
end


rem Find the best single byte for a strided slice.
fun best_byte Bytes Weights
  BestScore = -101 * (Bytes len) - 1
  BestByte = 97
  for Byte in 97 to 122
    Plain = Bytes Byte bxor
    Score = Weights Plain sum
    if Score greater BestScore
      BestScore = Score
      BestByte = Byte
    end
  end
  return BestByte
end


rem Solve each byte of the repeating key independently.
fun best_key Cipher Weights
  Size = Cipher len
  B0 = (Cipher (0 till Size by 3)) Weights best_byte
  B1 = (Cipher (1 till Size by 3)) Weights best_byte
  B2 = (Cipher (2 till Size by 3)) Weights best_byte
  return array B0 B1 B2
end
