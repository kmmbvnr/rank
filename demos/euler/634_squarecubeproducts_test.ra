use testing

test "default input"
  use "634_squarecubeproducts" as solve
  Answer = solve
  Answer equal 4019680944
end

test "statement and brute force"
  use "634_squarecubeproducts" as solve
  Answer = solve 100
  Answer equal 2
  Answer = solve 20000
  Answer equal 130
  Answer = solve 3000000
  Answer equal 2014
  Answer = solve 100000000
  Answer equal 12434
  Answer = solve 1000000000
  Answer equal 40307
end
