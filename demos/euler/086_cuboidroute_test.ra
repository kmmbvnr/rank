use testing

test "default input"
  use "086_cuboidroute" as solve
  Out = solve
  Answer = Out .answer

  Answer equal 1818
end

test "statement counts for 99 and 100"
  use "086_cuboidroute" as solve
  Out = solve 1975 200
  Answer = Out .answer
  Run = Out .run_value

  Run 99 equal 1975
  Run 100 equal 2060
  Answer equal 100
end

test "counts for small sides"
  use "086_cuboidroute" as solve
  Out = solve 1 20
  Answer = Out .answer
  Run = Out .run_value

  Run 3 equal 2
  Run 5 equal 3
  Run 6 equal 6
  Answer equal 3
end
