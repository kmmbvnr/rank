rem Circular Logic II
rem https://projecteuler.net/problem=703

use numbers
use sequences
use algo
use bits
use io
use cli

arg Nn integer = 20
arg Pm integer = 1001001011

rem T is an independent set of the
rem functional graph x -> f(x). Trees
rem on each cycle fold into two weights
rem per node (W0 free, W1 chosen) in
rem waves: each wave merges one ready
rem child per parent. A cycle is a path
rem DP split on its first node.
Sz = 2 ** Nn
Xs = 0 to Sz - 1
Xo = Xs shr 1 bxor (Xs shr 2) band 1
Hi = Xs band Xo shl (Nn - 1)
Fx = Xs shr 1 + Hi
Pe = (new counter Fx) Xs
Sent = Xs less 0
W0 = array shape Sz fill 1
W1 = array shape Sz fill 1
Win = array shape Sz fill 0
Rd = Xs filter (Pe equal 0)
for Rd len greater 0
  Pr = Fx Rd
  Win Pr = Rd
  Pk = Rd filter ((Win Pr) equal Rd)
  Pp = Fx Pk
  Sent Pk = true
  Pe Pp = Pe Pp - 1
  E0 = W0 Pk
  W0 Pp = W0 Pp * (E0 + W1 Pk) mod Pm
  W1 Pp = W1 Pp * E0 mod Pm
  Ok = (Pe equal 0) and not Sent
  Rd = Xs filter Ok
end
rem Cycle nodes: Pe stays positive.
Lb = Xs
Jp = Fx
for K in 1 to Nn + 1
  Lb = Lb min (Lb Jp)
  Jp = Jp Jp
end
Ok = (Pe greater 0) and (Lb equal Xs)
Rs = Xs filter Ok
rem Walk every cycle at once from its
rem first node; A = first free, B =
rem first chosen; pairs: free, used.
Cu = Fx Rs
Aa = W0 Rs
Ab = Aa * 0
Ba = Aa * 0
Bb = W1 Rs
Ac = Cu not equal Rs
for Ac count greater 0
  F0 = W0 Cu
  F1 = W1 Cu
  Na = (Aa + Ab) * F0 mod Pm
  Nb = Aa * F1 mod Pm
  Ma = (Ba + Bb) * F0 mod Pm
  Mb = Ba * F1 mod Pm
  Aa = Ac choose Na Aa
  Ab = Ac choose Nb Ab
  Ba = Ac choose Ma Ba
  Bb = Ac choose Mb Bb
  Cu = Ac choose (Fx Cu) Cu
  Ac = Cu not equal Rs
end
Loop = Fx Rs equal Rs
Cm = (Aa + Ab + Ba) mod Pm
Cm = Loop choose (W0 Rs) Cm
rem Product of the cycle factors by
rem pairwise halving.
Ln = Cm len
Tp = 2 ** ((Ln - 1) binary len)
Pad = array shape (Tp - Ln) fill 1
Cm = concat Cm Pad
Hf = Tp // 2
for Hf greater 0
  Lo = Cm take Hf
  Cm = Lo * (Cm drop Hf) mod Pm
  Hf = Hf // 2
end
Answer = Cm 0
Answer print
