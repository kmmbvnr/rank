use testing

rem Keep the number checks independent
rem of the default four-result search.
test "practical numbers"
  use "263_engineersdream"
  use "263_engineersdream" as solve
  Out = solve 0
  Res = Out .res

  (6 practical) equal true
  (12 practical) equal true
  (20 practical) equal true
  (8 practical) equal true
  (10 practical) equal false
  (14 practical) equal false
  (28 practical) equal true
  Res len equal 2
  Res(0) equal 20
  Res(1) equal 820
end

test "bound just below the first paradise"
  use "263_engineersdream"
  use "263_engineersdream" as solve
  Out = solve 1 219869900 219869979
  Answer = Out .answer
  Found = Out .found

  Found equal 0
  Answer equal 0
end

test "inclusive lower bound at another paradise"
  use "263_engineersdream"
  use "263_engineersdream" as solve
  Out = solve 1 360613700 360613700
  Answer = Out .answer
  Found = Out .found

  Found equal 1
  Answer equal 360613700
end

test "bounded empty search"
  use "263_engineersdream"
  use "263_engineersdream" as solve
  Out = solve 4 210 10000
  Answer = Out .answer
  Found = Out .found

  Found equal 0
  Answer equal 0
end

test "first paradise within a bound"
  use "263_engineersdream"
  use "263_engineersdream" as solve
  Out = solve 1 219869900 219869980
  Answer = Out .answer
  Found = Out .found

  Found equal 1
  Answer equal 219869980
  (219869980 practical_neighbours) equal true
  (219869978 practical_neighbours) equal false
  (312501820 practical_neighbours) equal true
  (360613700 practical_neighbours) equal true
  (1146521020 practical_neighbours) equal true
end
