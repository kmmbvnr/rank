rem Palindromic Sums
rem https://projecteuler.net/problem=125
rem Sum the palindromes below a limit
rem that are sums of two or more
rem consecutive squares

use algo
use numbers
use sequences
use io
use cli

option Limit integer = 100000000

rem Positive squares only increase a run.
rem Stop once its sum reaches Limit and
rem keep distinct palindromes by value.
Top = Limit isqrt
Seen = new set
for Start in 1 to Top
  Next = Start + 1
  Total = Start * Start
  if Total + Next * Next at least Limit
    break
  end
  for Stop in Next to Top
    Total += Stop * Stop
    if Total at least Limit
      break
    end
    Rest = Total
    Reversed = 0
    for Rest greater 0
      Reversed = Reversed * 10 + Rest mod 10
      Rest = Rest // 10
    end
    if Reversed equal Total
      Seen add Total
    end
  end
end
Answer = Seen sum
Answer print
