rem Shortest Lattice Vector
rem https://projecteuler.net/problem=507

use numbers
use sequences
use io
use cli

arg N integer = 20000000
arg Lc integer = 20

rem Lattice n uses Tribonacci terms
rem 12n-11 .. 12n: v = (r1 - r2, r3 +
rem r4, r5 r6), w the same from r7.
rem Reduce like Gauss in the L1 norm:
rem w - t v is convex in t, least at
rem the median of w_i / v_i weighted
rem by |v_i|; try its floor and the
rem next integer. Generate and reduce
rem pairs in bounded scalar batches.
Md = 10000000
rem Each lattice owns scalar registers;
rem Active sets need no array copies.
fun X1 Y1 Z1 X2 Y2 Z2 shortest
  for true
    La = X1 abs + (Y1 abs) + (Z1 abs)
    Lb = X2 abs + (Y2 abs) + (Z2 abs)
    if Lb less La
      Tx = X1
      X1 = X2
      X2 = Tx
      Tx = Y1
      Y1 = Y2
      Y2 = Tx
      Tx = Z1
      Z1 = Z2
      Z2 = Tx
      Tx = La
      La = Lb
      Lb = Tx
    end
    W1 = X1 abs
    W2 = Y1 abs
    W3 = Z1 abs
    D1 = X1 equal 0 choose 1 X1
    D2 = Y1 equal 0 choose 1 Y1
    D3 = Z1 equal 0 choose 1 Z1
    Tt = W1 + W2 + W3
    Tm = Z2 // D3
    if 2 * W1 at least Tt
      Tm = X2 // D1
    elif 2 * W2 at least Tt
      Tm = Y2 // D2
    elif 2 * W3 less Tt
      Q1 = X2 * 1.0 / D1
      Q2 = Y2 * 1.0 / D2
      Q3 = Z2 * 1.0 / D3
      Mid = Q1 at least (Q2 min Q3)
      Hi = Q1 at most (Q2 max Q3)
      Mid = Mid and Hi
      if Mid
        Tm = X2 // D1
      else
        Mid = Q2 at least (Q1 min Q3)
        Hi = Q2 at most (Q1 max Q3)
        Mid = Mid and Hi
        if Mid
          Tm = Y2 // D2
        end
      end
    end
    Le = X2 - Tm * X1 abs
    Le += Y2 - Tm * Y1 abs
    Le += Z2 - Tm * Z1 abs
    T2 = Tm + 1
    Ld = X2 - T2 * X1 abs
    Ld += Y2 - T2 * Y1 abs
    Ld += Z2 - T2 * Z1 abs
    Tb = Ld less Le choose T2 Tm
    Lm = Ld min Le
    if Lm at least Lb
      if La equal 0
        return Lb
      end
      return La
    end
    X2 -= Tb * X1
    Y2 -= Tb * Y1
    Z2 -= Tb * Z1
  end
  return 0
end
rem Bound each partial by 64 lengths.
rem A length is below 10^14 + 3*10^7,
rem so every private partial is exact
rem as a Number. The final sum is an
rem arbitrary-precision integer.
fun N total Ch
  Ng = (N + Ch - 1) // Ch
  Parts = array shape Ng fill 0
  A = 0
  B = 1
  C = 1
  for G in 0 till Ng
    Part = 0
    Last = N min ((G + 1) * Ch)
    for J in G * Ch till Last
      R1 = A
      R2 = B
      R3 = C
      R4 = (R1 + R2 + R3) mod Md
      R5 = (R2 + R3 + R4) mod Md
      R6 = (R3 + R4 + R5) mod Md
      R7 = (R4 + R5 + R6) mod Md
      R8 = (R5 + R6 + R7) mod Md
      R9 = (R6 + R7 + R8) mod Md
      Ra = (R7 + R8 + R9) mod Md
      Rb = (R8 + R9 + Ra) mod Md
      Rc = (R9 + Ra + Rb) mod Md
      A = (Ra + Rb + Rc) mod Md
      B = (Rb + Rc + A) mod Md
      C = (Rc + A + B) mod Md
      X1 = R1 - R2
      Y1 = R3 + R4
      Z1 = R5 * R6
      X2 = R7 - R8
      Y2 = R9 + Ra
      Z2 = Rb * Rc
      Part += X1 Y1 Z1 X2 Y2 Z2 shortest
    end
    Parts G = Part
  end
  return Parts sum
end
Ch = 2 ** Lc min 64
Answer = 0
if N greater 0
  Answer = N total Ch
end
Answer print
