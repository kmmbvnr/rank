rem Diophantine Equation
rem https://projecteuler.net/problem=66
rem Find D with the largest least x of
rem x^2 - D y^2 = 1

use numbers
use io
use cli

option Limit integer = 1000

rem Walk the convergents of the sqrt D
rem fraction until x^2 - D y^2 = 1.
Best = 0
Answer = 0
for D in 2 to Limit
  Root = D isqrt
  if Root * Root equal D
    continue
  end
  Mid = 0
  Den = 1
  Term = Root
  PrevX = 1
  X = Root
  PrevY = 0
  Y = 1
  for X * X - D * Y * Y not equal 1
    Mid = Den * Term - Mid
    Den = (D - Mid * Mid) // Den
    Term = (Root + Mid) // Den
    NextX = Term * X + PrevX
    NextY = Term * Y + PrevY
    PrevX = X
    PrevY = Y
    X = NextX
    Y = NextY
  end
  if X greater Best
    Best = X
    Answer = D
  end
end
Answer print
