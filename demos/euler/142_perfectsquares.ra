rem Perfect Square Collection
rem https://projecteuler.net/problem=142
rem Find the least x + y + z, x > y > z,
rem with x +- y, x +- z and y +- z all
rem perfect squares

use sequences
use io
use cli

option Top integer = 1100

rem Let x + y = a^2, x + z = c^2 and
rem x - z = d^2. Then y - z = a^2 - c^2,
rem y + z = a^2 - d^2 and x - y =
rem c^2 + d^2 - a^2 must be squares too.
rem A sum is under 1.5 a^2, so search a
rem only while a^2 is below the best.
Root = 0 to Top array
Sq = array shape (Top * Top + 1) fill 0
Sq (Root * Root) = 1
Answer = Top * Top * 2
A = 3
for A * A less Answer and A at most Top
  A2 = A * A
  for C in 2 to A - 1
    C2 = C * C
    if Sq (A2 - C2) equal 1
      for D in C - 2 to 1 by -2
        D2 = D * D
        if C2 + D2 greater A2
          if Sq (C2 + D2 - A2) equal 1
            if Sq (A2 - D2) equal 1
              Sum = A2 + (C2 - D2) // 2
              if Sum less Answer
                Answer = Sum
              end
            end
          end
        end
      end
    end
  end
  A += 1
end
Answer print
