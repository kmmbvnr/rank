rem Total Inversion Count
rem https://projecteuler.net/problem=705

use numbers
use sequences
use algo
use bits
use linalg
use io
use cli

arg Limit integer = 10 ** 8
arg Prime integer = 1000000007

rem Positions i < j with digits a, b add
rem N(a, b) inversions over the divided
rem sequences: those with x | a, y | b,
rem x > y, times the choices elsewhere,
rem T / (tau(a) tau(b)). So only the 9 x
rem 9 counts C(a, b) of ordered digit
rem pairs matter. They come from running
rem digit counts, chunk by chunk.
Primes = (Limit - 1) primesieve
Digits = array shape 0 fill 0
for Size in 1 to 9
  Low = 10 ** (Size - 1)
  Above = Primes at least Low
  Below = Primes less 10 ** Size
  Both = Above and Below
  Block = Primes filter Both
  Depth = Size - 1 - (0 to Size - 1)
  Place = 10 ** Depth
  Rows = Block len
  Column2 = Block reshape Rows 1
  Matrix = Column2 // Place mod 10
  Flat = Matrix reshape (Rows * Size)
  Nonzero = Flat filter (Flat greater 0)
  Digits = concat Digits Nonzero
end
Faces = 1 to 9
Chunk = 1048576
Total2 = Digits len
Chunks = (Total2 + Chunk - 1) // Chunk
Pairs = array shape 81 fill 0
Seen = array shape 9 fill 0
for Index in 0 to Chunks - 1
  Head = Index * Chunk
  Last = Head + Chunk - 1
  Tail = Last min (Total2 - 1)
  Part = Digits (Head to Tail)
  Wide = Faces reshape 9 1
  Hot = Wide equal Part integer
  Total = Hot scan + axis 1
  Carry = Seen reshape 9 1
  Before = Total - Hot + Carry
  Cross = Before matmul (Hot transpose)
  Pairs = Pairs + (Cross reshape 81)
  Seen = Seen + (Hot sum axis 1)
end
rem Divisor table, tau and the weights.
Column = Faces reshape 9 1
Whole = Column mod Faces equal 0
Divides = Whole integer
Bigger = Column greater Faces
Larger = Bigger integer
Mixed = Divides matmul Larger
Moves = Mixed matmul (Divides transpose)
Tau = Divides sum axis 1
Inverse = Tau (Prime - 2) Prime powmod
Side = Inverse reshape 9 1
Weight = Moves * Side mod Prime
Weight = Weight * Inverse mod Prime
TwoPart = (Tau equal 4 integer) * 2
Twice = Tau equal 2 integer
TwoPart = TwoPart + Twice
ThreePart = Tau equal 3 integer
TwoExp = TwoPart * Seen sum
ThreeExp = ThreePart * Seen sum
TwoPow = 2 TwoExp Prime powmod
ThreePow = 3 ThreeExp Prime powmod
Choices = TwoPow * ThreePow mod Prime
Counts = Pairs reshape 9 9 mod Prime
Sum = Counts * Weight mod Prime sum
Answer = Choices * Sum mod Prime
Answer print
