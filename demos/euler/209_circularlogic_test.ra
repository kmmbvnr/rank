use testing

test "default input"
  use "209_circularlogic" as solve
  Answer = solve

  Answer equal 15964587728784
end

test "fewer inputs"
  use "209_circularlogic" as solve
  Answer = solve 3

  Answer equal 28
  Answer = solve 4

  Answer equal 1596
  Answer = solve 5

  Answer equal 2961596
end
