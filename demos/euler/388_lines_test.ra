use testing

test "distinct lines"
  use "388_lines" as solve
  Out = solve 1 1
  Answer = Out .answer
  Token = Out .token
  Answer equal 7
  Out = solve 40 40
  Answer = Out .answer
  Token = Out .token
  Answer equal 56335
  Out = solve (10 ** 6) (10 ** 6)
  Answer = Out .answer
  Token = Out .token
  Answer equal 831909254469114121
  Token equal "831909254469114121"
end

test "empty and small cutoff"
  use "388_lines" as solve
  Out = solve 0 0
  Answer = Out .answer
  Answer equal 0
  Out = solve 40 1
  Answer = Out .answer
  Answer equal 56335
  Out = solve (10 ** 6) 1
  Answer = Out .answer
  Answer equal 831909254469114121
end
