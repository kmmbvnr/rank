rem Substring Sums of Prime Concatenations
rem https://projecteuler.net/problem=603

use numbers
use sequences
use io
use cli

arg N integer = 1000000
arg K integer = 1000000000000

rem A digit at place o of a copy is in
rem o + 1 starts, and its ends add up
rem to a repunit (10^e - 1) / 9. Over
rem the K copies the powers x^e of x =
rem 10^m form a geometric series, so
rem the sum reduces to four digit sums.
M = 1000000007
Ps = primes till N * 18 array
Ps = Ps (0 till N array)
Bs = (1 to 8) * 0 + 10
Dm = Ps digits Bs
Pw = Bs scan * with 1
Pw = (Pw (0 till 8 array)) reverse
Mk = (Ps reshape 1 N) at least (Pw reshape 8 1)
Dg = (Dm transpose) reshape (8 * N)
Dg = Dg (((Mk transpose) reshape (8 * N)) indices)
L = Dg len
Os = 1 to L
Ia = 10 (M - 2) M powmod
Ak = Ia (Os - 1) M powmod
D1 = Dg * Ak mod M
S0 = D1 sum mod M
S1 = (D1 * Os mod M) sum mod M
S2 = Dg sum mod M
S3 = (Dg * Os) sum mod M
X = 10 L M powmod
Xk = X K M powmod
Iv = (X - 1) (M - 2) M powmod
G0 = X * (Xk - 1) mod M * Iv mod M
Ek = (1 - (K + 1) * Xk + K * Xk * X) mod M
T = X * Ek mod M * Iv mod M * Iv mod M
G1 = (K * G0 - T) mod M
H1 = K * (K - 1) // 2 mod M
I9 = 9 (M - 2) M powmod
V1 = L * G1 mod M * S0 mod M
V2 = G0 * S1 mod M
V3 = L * H1 mod M * S2 mod M
V4 = K * S3 mod M
Answer = (V1 + V2 - V3 - V4) mod M * I9 mod M
Answer print
