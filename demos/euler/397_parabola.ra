rem Triangle on Parabola
rem https://projecteuler.net/problem=397

use sequences
use numbers
use io
use cli

arg K integer = 1000000
arg X integer = 1000000000

Answer = 0
Spf = K factorsieve
rem For N = 2^A * product(P^E),
rem tau(2*N*N) = (2*A+2)*product(2*E+1)
rem is at most 2*N. Reuse one buffer.
Ds = array shape (2 * K + 2) fill 1
for N in 1 to K
  D0 = 2 * N * N
  Count = 1
  Rest = N
  P = 2
  Exponent = 1
  for P greater 0
    for Rest mod P equal 0
      Rest //= P
      Exponent += 2
    end
    Previous = Count
    Power = 1
    for E in 1 to Exponent
      Power *= P
      for J in 0 till Previous
        Ds Count = (Ds J) * Power
        Count += 1
      end
    end
    if Rest greater 1
      P = Spf Rest
    else
      P = 0
    end
    Exponent = 0
  end
  Total = 0
  Range = 2 * X
  for I in 0 till Count
    D = Ds I
    U = D0 // D
    S = N - U
    T = D - N
    Good = S at least (-Range)
    Good = Good and S at most Range
    Good = Good and T at least (-Range)
    Good = Good and T at most Range
    if Good
      Lo = (T - X) max (-X)
      Hi = (S + X) min X
      Hi = Hi min ((S - 1) // 2)
      if Hi at least Lo
        Total += 2 * (Hi - Lo + 1)
      end
      for Side in 0 to 1
        Den = 0
        Q = 0
        Weight = 0
        if Side equal 0
          Den = S + N
          Q = N * (S - N)
          Weight = 2
        else
          Den = N - T
          Q = N * (N + T)
          Weight = 1
        end
        if Den not equal 0
          if Q mod Den equal 0
            V = Q // Den
            if (S + T - V) mod 2 equal 0
              A = (S + T - V) // 2
              B = (S + V - T) // 2
              C = (T + V - S) // 2
              if A at least (-X) and A less B
                if B less C and C at most X
                  Total -= Weight
                end
              end
            end
          end
        end
      end
    end
    P = -(N + U)
    Q = N + D
    if P at least (-Range) and Q at most Range
      Lo = (P - X) max (-X)
      Lo = Lo max (Q - X)
      Lo = Lo max (P // 2 + 1)
      Hi = (P + X) min X
      Hi = Hi min ((Q - 1) // 2)
      if Hi at least Lo
        Total += Hi - Lo + 1
      end
    end
  end
  if Total not equal 0
    Answer += Total
  end
end
Answer print
