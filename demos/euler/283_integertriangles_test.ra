use testing

test "small top"
  use "283_integertriangles"
  Top = 1
  run

  Answer equal 192
  Top = 2
  run

  Answer equal 2796
  Top = 5
  run

  Answer equal 140098
  Top = 10
  run

  Answer equal 3781786
end

test "empty input and reduced factors"
  use "283_integertriangles"
  Top = 0
  run

  Answer equal 0
  Top = 3
  run

  Answer equal 17644
  Top = 100
  run

  Answer equal 289620027474
end
