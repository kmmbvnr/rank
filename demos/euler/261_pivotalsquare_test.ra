use testing

rem Small limits independently checked by direct square sums.
test "small limits"
  use "261_pivotalsquare"
  Limit = 110
  run

  Answer equal 355
  Limit = 200000
  run

  Answer equal 23434786
  Limit = 3000000
  run

  Answer equal 1305678503
end

test "boundary limits"
  use "261_pivotalsquare"
  Limit = 0
  run

  Answer equal 0
  Limit = 3
  run

  Answer equal 0
  Limit = 4
  run

  Answer equal 4
  Limit = 1000
  run

  Answer equal 9167
end
