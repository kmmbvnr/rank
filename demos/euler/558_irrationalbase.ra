rem Irrational Base
rem https://projecteuler.net/problem=558
use numbers
use sequences
use algo
use bits
use io
use cli
arg M integer = 5000000
Bound = M max 1
Bits = Bound binary len
Height = 4 * Bits + 2
Depth = 2 * Height + 20
Seed = record
  .first = array 1 0 0
  .second = array 0 1 0
  .third = array 0 0 1
end
rem Preserve identities in Z[r].
fun State forward Step
  return record
    .first = State .second
    .second = State .third
    .third = State .first + State .third
  end
end
fun State backward Step
  Third = State .third
  Difference = Third - State .second
  return record
    .first = Difference
    .second = State .first
    .third = State .second
  end
end
fun State value rank 0
  return State .first
end
Steps = 1 to Height
Back = 1 to Depth
Ahead = Steps scan forward with Seed
Behind = Back scan backward with Seed
Front' = Ahead value drop 1
Rear' = Behind value drop 1
FrontCells = concat unpack Front
Positive = FrontCells reshape Height 3
RearCells = concat unpack Rear
Negative = RearCells reshape Depth 3
Negative = Negative reverse
Unit = array 1 0 0
Identity = Unit reshape 1 3
Rows = concat Negative Identity
Rows = concat Rows Positive
rem Cubic norm bounds nonzero residues.
rem Scale exceeds five times Budget^3.
Magnitude = Rows abs sum
Budget = Bound * Bound + 2 * Magnitude
Precision = Budget binary len
Scale = 2 ** (3 * Precision + 4)
fun Bounds bisect
  Low = Bounds 0
  High = Bounds 1
  Sum = Low + High
  Middle = Sum // 2
  Square = Middle ** 2 * Scale
  Limit = Square + Scale ** 3
  if Middle ** 3 greater Limit
    return array Low Middle
  end
  return array Middle High
end
Bounds = array Scale (2 * Scale)
Digits = Scale binary len
Root = Bounds bisect repeat Digits
First = Root 0
Second = First * First // Scale
Basis = array Scale First Second
Powers = Rows * Basis sum axis 1
rem Bound temporary greedy arrays.
Block = 125000
Rest = array shape 0 fill 0
Start = 1
More = M greater 0
Answer = 0
for More
  if Rest len equal 0
    Last = Start + Block - 1 min M
    Inputs = Start to Last array
    Rest = Inputs * Inputs * Scale
    Start = Last + 1
  end
  Index = Powers upperindex Rest
  Index -= 1
  Rest = Rest - Powers Index
  Answer += Rest len
  Keep = Rest greater 0 indices
  Rest = Rest Keep
  Alive = Rest len greater 0
  More = Start at most M or Alive
end
return Answer
