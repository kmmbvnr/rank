rem Nontransitive Sets of Dice
rem https://projecteuler.net/problem=376

use algo
use bits
use io
use cli

option Limit integer = 30

Cur = new index
Keys = new queue
Cur 0 = 1
Keys push 0
for V in 1 to Limit
  Next = new index
  New = new queue
  Left = Limit - V
  for Key in Keys
    Ways = Cur Key
    Ua = Key 7 band
    Ub = (Key 3 shr) 7 band
    Uc = (Key 6 shr) 7 band
    Wba = (Key 9 shr) 31 band
    Wcb = (Key 14 shr) 31 band
    Wac = (Key 19 shr) 31 band
    for Aa in 0 to (6 - Ua)
      Na = Ua + Aa
      for Bb in 0 to (6 - Ub)
        Nb = Ub + Bb
        for Cc in 0 to (6 - Uc)
          Nc = Uc + Cc
          if Left equal 0
            if Na not equal 6
              continue
            end
            Full = Nb equal 6
            Full and= Nc equal 6
            if not Full
              continue
            end
          end
          Ba = Wba + Bb * Ua
          Cb = Wcb + Cc * Ub
          Ac = Wac + Aa * Uc
          Ba = Ba 19 min
          Cb = Cb 19 min
          Ac = Ac 19 min
          if Ba + 6 * (6 - Nb) less 19
            continue
          end
          if Cb + 6 * (6 - Nc) less 19
            continue
          end
          if Ac + 6 * (6 - Na) less 19
            continue
          end
          Nkey = Na (Nb 3 shl) bor
          Nkey = Nkey (Nc 6 shl) bor
          Nkey = Nkey (Ba 9 shl) bor
          Nkey = Nkey (Cb 14 shl) bor
          Nkey = Nkey (Ac 19 shl) bor
          if Nkey in Next
            Next Nkey = Next Nkey + Ways
          else
            Next Nkey = Ways
            New push Nkey
          end
        end
      end
    end
  end
  Cur = Next
  Keys = New
end
Term = 6 (6 3 shl) bor
Term = Term (6 6 shl) bor
Term = Term (19 9 shl) bor
Term = Term (19 14 shl) bor
Term = Term (19 19 shl) bor
Answer = Cur Term // 3
Answer print
