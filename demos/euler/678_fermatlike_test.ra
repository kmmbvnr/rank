use testing

test "statement values"
  use "678_fermatlike" as solve
  Answer = solve 1000
  Answer equal 7
  Answer = solve 100000
  Answer equal 53
  Answer = solve 10000000
  Answer equal 287
end

test "full-scale checkpoint"
  use "678_fermatlike" as solve
  Answer = solve 1000000000000
  Answer equal 16066
end
