rem Cutting Squares
rem https://projecteuler.net/problem=270
rem Count the ways to cut an N by N
rem square with straight, non crossing
rem cuts between integer points on
rem different sides until no cut is
rem left, modulo Mod

use bits
use numbers
use io
use cli

arg N integer = 30
arg Mod integer = 100000000

rem Number the 4 N integer points round
rem the edge. Every face of a finished
rem cutting is a triangle: two points
rem with a unit edge between them would
rem otherwise leave a legal cut. So the
rem cuttings are the triangulations of
rem this polygon whose chords join
rem points on no common side. T[i][j]
rem counts those of the points i to j
rem with the chord i j drawn.
Size = 4 * N
Two = 2 * N
Three = 3 * N
Side = array shape Size fill 0
for I in 0 till Size
  if I at most N
    Side I = 1
  end
  if I at least N and I at most Two
    Side I = Side I + 2
  end
  if I at least Two and I at most Three
    Side I = Side I + 4
  end
  if I at least Three or I equal 0
    Side I = Side I + 8
  end
end
T = array shape Size Size fill 0
for I in 0 till (Size - 1)
  T I (I + 1) = 1
end
for Len in 2 to (Size - 1)
  for I in 0 till (Size - Len)
    J = I + Len
    Si = Side I
    Sj = Side J
    Same = Si band Sj
    Last = Size - 1
    Whole = I equal 0 and J equal Last
    if Same equal 0 or Whole
      Sum = 0
      for K in (I + 1) to (J - 1)
        Left = T I K
        Right = T K J
        Sum += Left * Right mod Mod
      end
      T I J = Sum mod Mod
    end
  end
end
Answer = T 0 (Size - 1)
Answer print
