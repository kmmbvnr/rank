use testing

test "statement values"
  use "734_bitofprime" as solve
  Answer = solve 5 2
  Answer equal 5
  Answer = solve 100 3
  Answer equal 3355
  Answer = solve 1000 10
  Answer equal 2071632
end

test "default input"
  use "734_bitofprime" as solve
  Answer = solve 1000000 999983
  Answer equal 557988060
end
