use testing

test "statement values"
  use "734_bitofprime"
  Limit = 5
  Count = 2
  run
  Answer equal 5
  Limit = 100
  Count = 3
  run
  Answer equal 3355
  Limit = 1000
  Count = 10
  run
  Answer equal 2071632
end

test "default input"
  use "734_bitofprime"
  Limit = 1000000
  Count = 999983
  run
  Answer equal 557988060
end
