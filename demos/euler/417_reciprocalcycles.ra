rem Reciprocal Cycles II
rem https://projecteuler.net/problem=417

use numbers
use sequences
use io
use cli

arg N integer = 100000000

rem Store odd factors only; zero means
rem prime. Each later write is smaller.
fun N odd_factors
  Size = N // 2 + 1
  Factors = array shape Size fill 0
  R = N isqrt
  for P in (primes from 3 to R) reverse
    Start = P * P // 2
    Factors (Start till Size by P) = P
  end
  return Factors
end

fun X without P
  for X mod P equal 0
    X //= P
  end
  return X
end

fun Order P reduce_order Q
  for Order mod Q equal 0
    Trial = Order // Q
    if 10 Trial P powmod not equal 1
      break
    end
    Order = Trial
  end
  return Order
end

fun Factors prime_order P
  Rest = P - 1
  Order = Rest
  for Rest greater 1
    Q = 2
    if Rest mod 2 equal 1
      Q = Factors (Rest // 2)
      if Q equal 0
        Q = Rest
      end
    end
    Rest = Rest without Q
    Order = Order P reduce_order Q
  end
  return Order
end

fun Order P lift_order Power
  Current = P
  for Current less Power
    Current *= P
    Residue = 10 Order Current powmod
    if Residue not equal 1
      Order *= P
    end
  end
  return Order
end

fun Count Limits count_for M
  for M greater Limits (Count - 1)
    Count -= 1
  end
  return Count
end

rem L(m) is the order of 10 modulo m.
rem Strip 2 and 5; each smooth multiple
rem has the same recurring cycle.
fun Factors Smooth cycle_sum N
  Size = N // 2 + 1
  Orders = array shape Size fill 0
  Limits = N // Smooth
  Count = Smooth len
  Bound = N
  if Count greater 0
    Bound = Limits (Count - 1)
  end
  Total = 0
  for M in 3 to N by 2
    if M mod 5 not equal 0
      P = Factors (M // 2)
      if P equal 0
        P = M
      end
      Rest = M without P
      Power = M // Rest
      Order = 0
      if M equal P
        Order = Factors prime_order P
      elif Rest equal 1
        Base = Orders (P // 2)
        Order = Base P lift_order Power
      else
        Left = Orders (Power // 2)
        Right = Orders (Rest // 2)
        Order = Left lcm Right
      end
      Orders (M // 2) = Order
      if M greater Bound
        Count = Count Limits count_for M
        Bound = Limits (Count - 1)
      end
      Total += Order * Count
    end
  end
  return Total
end

Factors = N odd_factors
Twos = 2 ** (0 to 40 copy)
Fives = 5 ** (0 to 20 copy)
Products = Twos Fives outer *
Flat = Products reshape 861
Values = Flat (Flat at most N)
Smooth = Values sort
Answer = Factors Smooth cycle_sum N
Answer print
