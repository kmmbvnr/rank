rem Creative Numbers
rem https://projecteuler.net/problem=616

use numbers
use sequences
use io
use cli

arg N integer = 1000000000000

rem The creative numbers are the perfect
rem powers except p^q with p and q both
rem prime, and except 16. A perfect
rem power with largest exponent g is a
rem k-th power for each k | g, so the
rem sum of the distinct ones is the sum
rem over k >= 2 of -mu(k) times the sum
rem of a^k, 2 <= a <= N^(1/k).
Ks = 2 to 39
Mu = (Ks * 0) + 1
for P in primes to 39
  Mu (P - 2 to 37 by P) *= -1
  if P * P at most 39
    Mu (P * P - 2 to 37 by P * P) *= 0
  end
end
Rt = ((N * 1.0) ** (1.0 / Ks)) floor
Nx = (Rt + 1) ** Ks
Up = (Nx at most N) integer
Rt = Rt + Up
Dn = ((Rt ** Ks) greater N) integer
Rt = Rt - Dn
Answer = 0
for I in 0 to 37
  K = Ks I
  Ri = Rt I
  if Ri at least 2
    As = 2 to Ri
    Answer -= Mu I * ((As ** K) sum)
  end
end
Qs = primes to 39 array
for Q in Qs
  Rq = ((N * 1.0) ** (1.0 / Q)) floor
  if Rq at least 2
    Ps = primes to Rq array
    Answer -= (Ps ** Q) sum
  end
end
Answer -= (N at least 16) integer * 16
Answer print
