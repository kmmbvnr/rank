use testing

test "statement values"
  use "441_inversesum" as solve
  Answer = solve 2
  Answer equal 0.5
  Answer = solve 10
  Answer equal 6.9147
  Answer = solve 100
  Answer equal 58.2962
end

test "short direct harmonic tables"
  use "441_inversesum" as solve
  Answer = solve 2000
  Answer equal 1021.4946
  Answer = solve 5000 20
  Answer equal 2526.6219
end

test "empty and singleton bounds"
  use "441_inversesum" as solve
  Answer = solve 0
  Answer equal 0.0
  Answer = solve 1
  Answer equal 0.0
end

test "default bound"
  use "441_inversesum" as solve
  Answer = solve 10000000
  Answer equal 5000088.8395
end
