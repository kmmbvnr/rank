rem Modulo power identity
rem https://projecteuler.net/problem=536

use numbers
use sequences
use algo
use bits
use io
use cli

arg N integer = 1000000000000
arg U0 integer = 10000000
arg T integer = 2500
arg Batch integer = 262144

rem a^(m+4) = a mod m for all a iff m is
rem squarefree and p - 1 | m + 3 for
rem every p | m; besides 1, 2, 3, 5 such
rem m are odd. Fix the largest primes Q
rem of m, then m = Q u with u = r mod M
rem by CRT over (Q / p) u = -3 mod (p -
rem 1).
rem Branch on the next prime while too
rem many u remain; check u by tables of
rem lambda(u) = lcm(p - 1) up to U0, or
rem by 2^(m+3) = 1 mod u then exactly.
Cut = U0 min N max 1
fun Limit factor_tables
  Count = (Limit + 1) // 2 max 1
  Last = 2 * Count - 1
  Sieve = 1 to Last by 2 copy
  Root = Last isqrt
  OddPrimes = primes to Root array
  OddPrimes = OddPrimes drop 1
  for Prime in OddPrimes reverse
    Begin = (Prime * Prime - 1) // 2
    Slots = Begin till Count by Prime
    Sieve Slots = Prime
  end
  fun Work peel
    Places = Work 0
    Rest = Work 1
    Flags = Work 2
    Largest = Work 3
    Lambda = Work 4
    Factor = Sieve (Rest // 2)
    Next = Rest // Factor
    Repeated = Next mod Factor equal 0
    RepeatedSlots = Places Repeated
    Flags RepeatedSlots = false
    Largest Places = Factor
    Previous = Lambda Places
    Less = Factor - 1
    Divisor = Previous gcd Less
    Updated = Previous // Divisor * Less
    Lambda Places = Updated
    Keep = Next greater 1 indices
    Indices = Places Keep
    Remaining = Next Keep
    return (tuple Indices Remaining
      Flags Largest Lambda)
  end
  fun Before peeled After
    Places = After 0
    return Places len equal 0
  end
  Slots = 1 till Count copy
  Values = 2 * Slots + 1
  Valid = array shape Count fill true
  Ones = array shape Count fill 1
  Initial = (tuple Slots Values
    Valid Ones Ones)
  Steps = Limit binary len
  Done = (
    Initial peel repeat Steps
    till peeled
  )
  Validity = Done 2
  Maximal = Done 3
  Period = Done 4
  return tuple Validity Maximal Period
end
Table = Cut factor_tables
Squarefree = Table 0
Largest = Table 1
Periods = Table 2
rem Bound remaining factors by the
rem product of the first i, capped.
PrimeLimit = (N isqrt) + 4
Primes = primes to PrimeLimit array
Primes = Primes drop 1
PrimeCount = Primes len
PrefixCount = N binary len
PrefixCount = PrefixCount min PrimeCount
FirstPrimes = Primes take PrefixCount
Products = FirstPrimes scan * with 1
Upper = N + 1
Caps = Products min Upper
rem Inverse of A mod B (coprime, B > 1)
rem by Euclid over arrays.
fun A inv B
  fun Work euclid
    R0 = Work 0
    R1 = Work 1
    T0 = Work 2
    T1 = Work 3
    Saved = Work 4
    Slots = Work 5
    Finished = R1 equal 0 indices
    Saved (Slots Finished) = T0 Finished
    Active = R1 greater 0 indices
    Slots = Slots Active
    R0 = R0 Active
    R1 = R1 Active
    T0 = T0 Active
    T1 = T1 Active
    Quotient = R0 // R1
    Rest = R0 - Quotient * R1
    Coefficient = T0 - Quotient * T1
    return (tuple R1 Rest T1 Coefficient
      Saved Slots)
  end
  fun Before inverted After
    Rest = After 1
    return Rest len equal 0
  end
  Zero = B * 0
  One = Zero + 1
  Size = B len
  Indices = 0 till Size copy
  Initial = (tuple B (A mod B)
    Zero One Zero Indices)
  Done = (
    Initial euclid repeat 60
    till inverted
  )
  Result = Done 4
  return Result mod B
end

rem Carry the CRT into each child,
rem rather than rebuilding it from
rem a matrix of chosen prime factors.
fun State grow
  Q = State 0
  Smallest = State 1
  R = State 2
  M = State 3
  Matches = State 4
  TailProducts = State 5
  TailValues = State 6
  TailBounds = State 7
  rem Bound on u, and its candidates.
  Limits = N // Q
  Cap = Caps (Smallest min PrefixCount)
  Bound = Limits min Cap
  Starts = R equal 0 choose M R
  Counts = (Bound - Starts) // M + 1
  Outside = Starts greater Bound
  Counts = Outside choose 0 Counts
  WithinTable = Bound at most Cut
  Few = Counts at most (T max 1)
  Ready = WithinTable or Few
  Positive = Counts greater 0
  Select = Ready and Positive
  Selected = Select indices
  Sizes = Counts Selected
  Prefix = Sizes scan +
  Cells = Prefix last default 0
  fun Work evaluate
    Begin = Work 0
    End = Cells min (Begin + Batch)
    Visits = Begin till End
    Parents = Prefix upperindex Visits
    Origins = Prefix - Sizes
    Offsets = Visits - Origins Parents
    Nodes = Selected Parents
    InitialValues = Starts Nodes
    Stride = M Nodes
    Steps = Offsets * Stride
    Values = InitialValues + Steps
    Products = Q Nodes
    Bounds = Primes (Smallest Nodes)
    Small = Values at most Cut indices
    SmallValues = Values Small
    Cofactors = Products Small
    Numbers = Cofactors * SmallValues
    Lambda = Periods (SmallValues // 2)
    SmallBounds = Bounds Small
    Lookup = SmallValues // 2
    Square = Squarefree Lookup
    Maximum = Largest Lookup
    Below = Maximum less SmallBounds
    Accepted = Square and Below
    Shifted = Numbers + 3
    Residues = Shifted mod Lambda
    PeriodFits = Residues equal 0
    Accepted = Accepted and PeriodFits
    Hit = Numbers Accepted
    Prior = Work 1
    Found = concat Prior Hit
    Large = Values greater Cut indices
    LargeValues = Values Large
    LargeProducts = Products Large
    Whole = (
      LargeProducts * LargeValues
    )
    Coprime = (
      LargeValues gcd LargeProducts
    )
    Possible = Coprime equal 1
    Exponents = Whole + 3
    Powers = (
      2 Exponents LargeValues powmod
    )
    Fermat = Powers equal 1
    Possible = Possible and Fermat
    Passed = Possible indices
    Hit = LargeProducts Passed
    Prior = Work 2
    SavedProducts = concat Prior Hit
    Hit = LargeValues Passed
    Prior = Work 3
    SavedValues = concat Prior Hit
    RemainderBounds = Bounds Large
    Hit = RemainderBounds Passed
    Prior = Work 4
    SavedBounds = concat Prior Hit
    return (tuple End Found
      SavedProducts SavedValues
      SavedBounds)
  end
  Parts = (Cells + Batch - 1) // Batch
  Work = (tuple 0 Matches TailProducts
    TailValues TailBounds)
  Checked = Work evaluate repeat Parts
  Matches = Checked 1
  TailProducts = Checked 2
  TailValues = Checked 3
  TailBounds = Checked 4
  rem Children: primes below the
  rem smallest with Q q <= N.
  Branches = Ready equal false indices
  ChildLimits = Limits Branches
  UnderLimit = (
    Primes upperindex ChildLimits
  )
  UnderPrime = Smallest Branches
  Widths = UnderLimit min UnderPrime
  Prefix = Widths scan +
  Cells = Prefix last default 0
  Positions = 0 till Cells copy
  Owners = Prefix upperindex Positions
  Sources = Branches Owners
  Begins = Prefix - Widths
  Children = Positions - Begins Owners
  Next = Primes Children
  Product = Q Sources
  Residue = R Sources
  Modulus = M Sources
  Divisor = Next gcd Modulus
  Other = Next - 1
  Factor = Product gcd Other
  Valid = Residue mod Divisor equal 0
  Divides = 3 mod Factor equal 0
  Valid = Valid and Divides
  Keep = Valid indices
  ChildIndices = Children Keep
  Next = Next Keep
  Product = Product Keep
  Residue = Residue Keep
  Modulus = Modulus Keep
  Divisor = Divisor Keep
  Other = Other Keep
  Factor = Factor Keep
  FirstMod = Modulus // Divisor
  LeftBase = Next // Divisor
  First = Residue // Divisor
  Inverse = LeftBase inv FirstMod
  First = First * Inverse
  First = First mod FirstMod
  SecondMod = Other // Factor
  RightBase = Product // Factor
  Second = 0 - 3 // Factor
  Inverse = RightBase inv SecondMod
  Second = Second * Inverse
  Second = Second mod SecondMod
  Common = FirstMod gcd SecondMod
  Difference = Second - First
  Fits = Difference mod Common equal 0
  Keep = Fits indices
  FirstMod = FirstMod Keep
  SecondMod = SecondMod Keep
  Common = Common Keep
  Difference = Difference Keep
  FactorMod = SecondMod // Common
  Base = FirstMod // Common
  Shift = Difference // Common
  Inverse = Base inv FactorMod
  Shift = Shift * Inverse
  Shift = Shift mod FactorMod
  R = First Keep + FirstMod * Shift
  M = FirstMod * FactorMod
  Q = (Product Keep) * Next Keep
  Smallest = ChildIndices Keep
  return (tuple Q Smallest R M Matches
    TailProducts TailValues TailBounds)
end
fun Before exhausted After
  Frontier = After 0
  return Frontier len equal 0
end
Ok = Primes at least 7 indices
Seeds = Primes Ok
Empty = array shape 0 fill 0
Initial = (tuple Seeds Ok (Seeds - 4)
  (Seeds - 1) Empty Empty Empty Empty)
Depth = N binary len
Complete = (
  Initial grow repeat Depth
  till exhausted
)
Matches = Complete 4
TailProducts = Complete 5
TailValues = Complete 6
TailBounds = Complete 7
rem Finish the rare survivors exactly.
fun Row finish
  Product = Row 0
  Value = Row 1
  Bound = Row 2
  Factors = Value factors array
  Primes = Factors unique
  Count = Factors len
  Distinct = Primes len
  if Count not equal Distinct
    return false
  end
  if Distinct equal 0
    return true
  end
  Last = Primes last
  if Last at least Bound
    return false
  end
  Whole = Product * Value
  Shifted = Whole + 3
  Divisors = Primes - 1
  Residues = Shifted mod Divisors
  return Residues equal 0 all
end
Rows = (stack
  TailProducts TailValues TailBounds
  axis 1
)
Valid = Rows finish rank 1
Whole = TailProducts * TailValues
Matches = concat Matches (Whole Valid)
Solutions = Matches unique
Small = array 1 2 3 5
Base = Small (Small at most N)
Total = Solutions sum
Extra = Base sum
return Total + Extra
