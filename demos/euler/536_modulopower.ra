rem Modulo power identity
rem https://projecteuler.net/problem=536

use numbers
use sequences
use algo
use io
use cli

option N integer = 1000000000000
option U0 integer = 10000000
option T integer = 10000

rem a^(m+4) = a mod m for all a iff m is
rem squarefree and p - 1 | m + 3 for
rem every p | m; besides 1, 2, 3, 5 such
rem m are odd. Fix the largest primes Q
rem of m, then m = Q u with u = r mod M
rem by CRT over (Q / p) u = -3 mod (p -
rem 1).
rem Branch on the next prime while too
rem many u remain; check u by tables of
rem lambda(u) = lcm(p - 1) up to U0, or
rem by 2^(m+3) = 1 mod u then exactly.
Uz = U0 min N
rem Tables: least prime factor, then
rem peel it off to get squarefree, the
rem largest prime and lambda.
Sp = (0 to Uz) copy
Rz = Uz isqrt
for P in (primes to Rz array) reverse
  Sp (P * P to Uz by P) = P
end
Sf = (0 to Uz) mod 2 equal 1
Mp = array shape (Uz + 1) fill 1
Lm = Mp
Ix = (3 to Uz by 2) copy
Rr = Ix
for It in 1 to 30
  if (Ix len) equal 0
    break
  end
  Pq = Sp Rr
  Rn = Rr // Pq
  Sq = (Rn mod Pq) equal 0
  Sf (Ix (Sq indices)) = false
  Mp Ix = Pq
  La = Lm Ix
  P1 = Pq - 1
  Gc = La gcd P1
  Lm Ix = La // Gc * P1
  Kp = (Rn greater 1) indices
  Ix = Ix Kp
  Rr = Rn Kp
end
rem Odd primes to sqrt N and Cp(i), the
rem product of the first i, capped.
Nq = (N isqrt) + 4
Pr = primes from 3 to Nq array
Npr = Pr len
Cp = array shape (Npr + 1) fill (N + 1)
Cp 0 = 1
for I in 1 to Npr
  Cm = Cp (I - 1) * Pr (I - 1)
  N1 = N + 1
  Cp I = Cm min N1
  if Cp I greater N
    break
  end
end
rem Inverse of A mod B (coprime, B > 1)
rem by Euclid over arrays.
fun A inv B
  R0 = B
  R1 = A mod B
  T0 = R0 * 0
  T1 = T0 + 1
  Sv = T0
  Bn = B len
  Ix = (0 till Bn) copy
  for It in 1 to 60
    Dz = (R1 equal 0) indices
    Sv (Ix Dz) = T0 Dz
    Nz = (R1 greater 0) indices
    if (Nz len) equal 0
      break
    end
    Ix = Ix Nz
    R0 = R0 Nz
    R1 = R1 Nz
    T0 = T0 Nz
    T1 = T1 Nz
    Q = R0 // R1
    Nr = R0 - Q * R1
    Nt = T0 - Q * T1
    R0 = R1
    T0 = T1
    R1 = Nr
    T1 = Nt
  end
  return Sv mod B
end
rem Level by level: chosen primes Bm,
rem their product Q, Bi the index of
rem the smallest (the next ones lie
rem below it).
Ok = (Pr at least 7) indices
Q = Pr Ok
Bi = Ok
Bm = Q reshape (Q len) 1
D = 1
Mv = array shape 0 fill 0
Fq = Mv
Fu = Mv
Fb = Mv
for Q len greater 0
  Nn = Q len
  Bf = Bm reshape (Nn * D)
  Rw = (0 till Nn) copy
  R = Rw * 0
  M = R + 1
  V = R equal 0
  Cl = V equal false
  for C in 0 till D
    Pc = Bf (Rw * D + C)
    Md = Pc - 1
    A = (Q // Pc) mod Md
    G = A gcd Md
    V = V and (3 mod G equal 0)
    M2 = Md // G
    Rh = (0 - 3 // G) mod M2
    A2 = (A // G) mod M2
    Rp = Rh * (A2 inv M2) mod M2
    rem Merge with u = Rp mod M2.
    Ck = (R mod M2) equal Rp
    G2 = M gcd M2
    Dr = Rp - R
    Gd = Dr mod G2 equal 0
    M1 = M // G2
    Mg = M2 // G2
    Df = (Dr // G2) mod Mg
    Am = M1 mod Mg
    Iv = Am inv Mg
    Tt = Df * Iv mod Mg
    Nm = M1 * M2
    Nr = R + M * Tt
    Big = Nm greater N + 1
    Fit = Nr at most N
    Nb = Big equal false
    Vn = Gd and (Nb or Fit)
    rem Boolean choose returns numbers
    rem (#436), so mix with and / or.
    Nl = Cl equal false
    Xv = (Cl and Ck) or (Nl and Vn)
    V = V and Xv
    R = Cl choose R Nr
    N1 = N + 1
    Mn = Big choose N1 Nm
    M = Cl choose M Mn
    Cl = Cl or Big
  end
  rem Bound on u, and its candidates.
  Lq = N // Q
  Cb = Cp Bi
  Lt = Lq min Cb
  F0 = (R equal 0) choose M R
  Cn = (Lt - F0) // M + 1
  Cn = (F0 greater Lt) choose 0 Cn
  Cn = (V equal false) choose 0 Cn
  En = (Lt at most Uz) or (Cn at most T)
  Ei = (En and (Cn greater 0)) indices
  Ce = Cn Ei
  Cs = Ce scan +
  Tc = Cs last default 0
  if Tc greater 0
    Po = (0 till Tc) copy
    Jx = Cs upperindex Po
    Tk = Po - (Cs - Ce) Jx
    Ni = Ei Jx
    U = (F0 Ni) + Tk * (M Ni)
    Qn = Q Ni
    Bp = Pr (Bi Ni)
    Ts = (U at most Uz) indices
    Ut = U Ts
    Mt = (Qn Ts) * Ut
    Lu = Lm Ut
    Bt = Bp Ts
    Gt = (Sf Ut) and ((Mp Ut) less Bt)
    Dl = (Mt + 3) mod Lu
    Gt = Gt and (Dl equal 0)
    Mv = concat Mv (Mt (Gt indices))
    Fs = (U greater Uz) indices
    Uf = U Fs
    Qf = Qn Fs
    Mf = Qf * Uf
    Go = (Uf gcd Qf) equal 1
    Ex = Mf + 3
    Pw = 2 Ex Uf powmod
    Go = Go and (Pw equal 1)
    Gi = Go indices
    Fq = concat Fq (Qf Gi)
    Fu = concat Fu (Uf Gi)
    Fb = concat Fb ((Bp Fs) Gi)
  end
  rem Children: primes below the
  rem smallest with Q q <= N.
  Xi = ((En equal false) and V) indices
  Lx = Lq Xi
  Kp = Pr upperindex Lx
  Bx = Bi Xi
  Kc = Kp min Bx
  Cs = Kc scan +
  Tc = Cs last default 0
  Po = (0 till Tc) copy
  Jx = Cs upperindex Po
  Pj = Xi Jx
  Cj = Po - (Cs - Kc) Jx
  Nc = (Pr Cj) reshape Tc 1
  Bm = concat (Bm Pj) Nc axis 1
  Q = (Q Pj) * Pr Cj
  Bi = Cj
  D += 1
end
rem Survivors above U0: trial division
rem by the primes below b, exactly.
for K in 0 till Fu len
  Y = Fu K
  Mk = (Fq K) * Y
  Bk = Fb K
  Pb = Pr ((Pr less Bk) indices)
  Ds = Pb ((Y mod Pb equal 0) indices)
  Pd = Ds reduce * with 1
  Dv = (Mk + 3) mod (Ds - 1)
  Al = (Dv equal 0) all
  Fine = (Pd equal Y) and Al
  if Fine
    Mv = concat Mv (array Mk)
  end
end
Answer = ((Mv unique) sum) + 11
Answer print
