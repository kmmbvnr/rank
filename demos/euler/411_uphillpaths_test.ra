use testing

test "statement values"
  use "411_uphillpaths"
  Power = 1
  First = 22
  Count = 22
  run
  Answer equal 5
  First = 123
  Count = 123
  run
  Answer equal 14
  First = 10000
  Count = 10000
  run
  Answer equal 48
end

test "sums of fifth powers"
  use "411_uphillpaths"
  Count = 8
  run
  Answer equal 9052
  Count = 13
  run
  Answer equal 50705
end
