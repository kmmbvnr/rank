use testing

test "statement values"
  use "411_uphillpaths" as solve
  Answer = solve 22 22 1
  Answer equal 5
  Answer = solve 123 123 1
  Answer equal 14
  Answer = solve 10000 10000 1
  Answer equal 48
end

test "sums of fifth powers"
  use "411_uphillpaths" as solve
  Answer = solve 1 8
  Answer equal 9052
  Answer = solve 1 13
  Answer equal 50705
end
