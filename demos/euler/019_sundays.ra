rem Counting Sundays
rem https://projecteuler.net/problem=19
rem Count first-of-month Sundays in the
rem twentieth century

use numbers
use io
use cli

option First integer = 1901
option Last integer = 2000

rem Step month starts from Monday,
rem 1 January 1900.
Days = array shape 12
  31 28 31 30 31 30
  31 31 30 31 30 31
end
Day = 1
Answer = 0
for Year in 1900 to Last
  Leap = Year mod 4 equal 0
  Leap and= (
    not Year mod 100 equal 0
    or Year mod 400 equal 0
  )
  Days 1 = 28
  if Leap
    Days 1 = 29
  end
  for Month in 0 to 11
    if Year at least First
      if Day equal 0
        Answer += 1
      end
    end
    Day = (Day + Days Month) mod 7
  end
end
Answer print
