rem Maximal Perimeter
rem https://projecteuler.net/problem=562
use numbers
use algo
use sequences
use io
use cli
arg R integer = 10000000
arg Dm integer = 2000000
if R less 1 or Dm less 1
  Message = "positive radius and band"
  .domain Message raise
end
Bound = R * R
Diameter = 4 * Bound
Small = primes to 1000 array
Bad = Small mod 4 equal 3
Wheel = Small Bad reduce * with 1

rem Test integer translations of a
rem unimodular basis (A,B), (X,Y).
fun A B X Y placements Bound
  Norm = A * A + B * B
  Gap = 4 * Bound - Norm
  Length = Norm isqrt
  Root = Gap isqrt + 1
  Unit = 2 * Length
  Across = (B * Root + Unit - 1) // Unit
  Unit = 4 * Norm
  Along = (A * Gap + Unit - 1) // Unit
  Span = Across + Along + 1
  Center = 0 - A // 2
  First = Center - Span
  Last = Center + Span + 1
  Columns = First to Last
  Space = Bound - Columns * Columns
  Other = Columns + A
  Second = Bound - Other * Other
  Third = Columns + X
  Third = Bound - Third * Third
  Low = Space max 0 isqrt
  High = Second max 0 isqrt
  Lower = (0 - Low) max (0 - B - High)
  Upper = Low min (High - B)
  Height = Third max 0 isqrt
  Lower = Lower max (0 - Y - Height)
  Upper = Upper min (Height - Y)
  Valid = Space at least 0
  FitsFirst = Valid choose 1 0
  Valid = Second at least 0
  FitsSecond = Valid choose 1 0
  Valid = Third at least 0
  FitsThird = Valid choose 1 0
  Valid = Lower at most Upper
  FitsY = Valid choose 1 0
  Good = FitsFirst * FitsSecond
  Good = Good * FitsThird * FitsY
  return Good sum
end

rem Cornacchia reduces a square root
rem of -1 to a primitive lattice edge.
fun A B descend Cut
  if B at most Cut
    return B
  end
  return B (A mod B) descend Cut
end
fun Prime legendre Value rank 0 0
  Half = (Prime - 1) // 2
  return Value Half Prime powmod
end
memo Prime nonresidue
  Values' = 2 to #
  Powers' = Prime legendre Values
  Mask' = Powers equal (Prime - 1)
  Base = Values first where Mask
  return Base
end
fun Norm orientation Root rank 0 0
  Cut = Norm isqrt
  A = Norm Root descend Cut
  Space = Norm - A * A
  B = Space isqrt
  if B * B not equal Space
    return -1
  end
  if A gcd B not equal 1
    return -1
  end
  High = A max B
  Low = A min B
  Q = Root
  if High * Q mod Norm not equal Low
    Q = Norm - Q
  end
  if High * Q mod Norm not equal Low
    return -1
  end
  X = (High * Q - Low) // Norm
  Y = (Low * Q + High) // Norm
  Count = High Low X Y placements Bound
  if Count greater 0
    return Root
  end
  return -1
end
fun Norm roots
  if Norm less 2
    return array shape 0 fill 0
  end
  Rest = Norm mod 4
  if Rest equal 0 or Rest equal 3
    return array shape 0 fill 0
  end
  Grouped = Norm factors unique .counts
  Primes = Grouped 0
  Exponents = Grouped 1
  Bad = Primes mod 4 equal 3
  if Bad any
    return array shape 0 fill 0
  end
  rem CRT combines both roots for each
  rem odd prime power; 2 has one root.
  Moduli = Primes ** Exponents
  Phi = Moduli // Primes * (Primes - 1)
  Parts = Norm // Moduli
  Powers = Phi - 1
  Inverses = Parts Powers Moduli powmod
  Count = Primes len
  Bases = array shape Count fill 1
  Odd = Primes greater 2 indices
  Values = Primes Odd
  if Odd len greater 0
    Bases Odd = Values nonresidue rank 0
  end
  Powers = Phi // 4
  Values = Bases Powers Moduli powmod
  Terms = Parts * Inverses * Values
  Terms = Terms mod Norm
  Roots = array 0
  for I in 0 till Count
    Term = Terms I
    Plus = (Roots + Term) mod Norm
    if Primes I equal 2
      Roots = Plus
    else
      Minus = (Roots - Term) mod Norm
      Roots = concat Plus Minus
    end
  end
  Roots = Roots min (Norm - Roots)
  return Roots unique
end
fun Loss candidate
  if Loss mod 4 less 2
    return -1
  end
  Norm = Diameter - Loss
  if Norm less 2
    return -1
  end
  if Norm mod 8 equal 6
    return -1
  end
  Residue = Wheel mod Norm
  if Norm gcd Residue not equal 1
    return -1
  end
  Roots = Norm roots
  if Roots len equal 0
    return -1
  end
  Scores = Norm orientation Roots
  Good = Scores at least 0
  if Good any
    return Scores Good min
  end
  return -1
end
rem Larger squared edges win exactly;
rem equal edges prefer the smaller root.
Losses' = 1 to Dm
Score' = Losses candidate rank 0
Fits' = Score at least 0
Hit' = Losses first index where Fits
Index = Hit default -1
if Index less 0
  Message = "no triangle in search band"
  .search Message raise
end
Loss = Index + 1
Norm = Diameter - Loss
Q = Score Index
Other = Norm - Q
Numerator = (Q * Q + 1)
Numerator *= Other * Other + 1
Denominator = 4 * Norm * Bound
Floor = Numerator // Denominator isqrt
Midpoint = 2 * Floor + 1
Test = Midpoint * Midpoint * Denominator
Up = Test at most 4 * Numerator integer
Answer = Floor + Up
return Answer
