rem Unreachable Numbers
rem https://projecteuler.net/problem=718

use numbers
use sequences
use io
use cli

arg Exponent integer = 6
arg Prime integer = 1000000007

rem n = a x + b y + c z with x, y, z > 0
rem is reachable iff n - (a + b + c) is
rem in the semigroup S = <a, b, c>. So
rem the sum is s (s - 1) / 2 + s g + t
rem with g, t the gap count and sum of
rem S. Both follow from the Apery set
rem w (least element of S in each class
rem mod a): g = sum w / a - (a - 1) / 2
rem and t = sum w^2 / 2a - sum w / 2
rem + (a^2 - 1) / 12. A class r = k c
rem needs y = k c / b mod a copies of b,
rem so w_k = min over j of b y_(k-j)
rem + j c: two running minima.
Small = 17 ** Exponent
Middle = 19 ** Exponent
Large = 23 ** Exponent
Totient = 16 * 17 ** (Exponent - 1)
InvB = Middle (Totient - 1) Small powmod
Step = Large * InvB mod Small
Index = 0 to Small - 1
Shifts = Index * Step mod Small
Forward = Middle * Shifts
Offsets = Forward - Index * Large
Prefix = Offsets scan min
Suffix = (Offsets reverse) scan min
Suffix = (Suffix reverse) drop 1
Huge = array 1000000000000000000
Suffix = concat Suffix Huge
Direct = Index * Large + Prefix
Wrap = (Index + Small) * Large + Suffix
Apery = Direct min Wrap
Residues = Apery mod Prime
SumW = Residues sum mod Prime
Squares = Residues * Residues mod Prime
SumSq = Squares sum mod Prime
Values = array 2 12 17
Power = Prime - 2
Inverses = Values Power Prime powmod
InvA = Small mod Prime
InvA = InvA (Prime - 2) Prime powmod
Added = Small + Middle + Large
Total = Added mod Prime
Half = Inverses 0
Twelfth = Inverses 1
Gaps = (Small - 1) mod Prime * Half
Genus = (SumW * InvA - Gaps) mod Prime
Scaled = SumSq * InvA mod Prime
SqPart = Scaled * Half mod Prime
Cells = (Small * Small - 1) mod Prime
Cubic = Cells * Twelfth
Mixed = SqPart - SumW * Half + Cubic
GapSum = Mixed mod Prime
Pairs = Total * (Total - 1) mod Prime
Triangle = Pairs * Half
Sum = Triangle + Total * Genus + GapSum
return Sum mod Prime
