rem Unreachable Numbers
rem https://projecteuler.net/problem=718

use numbers
use sequences
use io
use cli

arg Pp integer = 6
arg Mm integer = 1000000007

rem n = a x + b y + c z with x, y, z > 0
rem is reachable iff n - (a + b + c) is
rem in the semigroup S = <a, b, c>. So
rem the sum is s (s - 1) / 2 + s g + t
rem with g, t the gap count and sum of
rem S. Both follow from the Apery set
rem w (least element of S in each class
rem mod a): g = sum w / a - (a - 1) / 2
rem and t = sum w^2 / 2a - sum w / 2
rem + (a^2 - 1) / 12. A class r = k c
rem needs y = k c / b mod a copies of b,
rem so w_k = min over j of b y_(k-j)
rem + j c: two running minima.
Aa = 17 ** Pp
Bb = 19 ** Pp
Cc = 23 ** Pp
Ph = 16 * 17 ** (Pp - 1)
Ib = Bb (Ph - 1) Aa powmod
Ke = Cc * Ib mod Aa
Ks = 0 to Aa - 1
Vv = Bb * (Ks * Ke mod Aa) - Ks * Cc
Pre = Vv scan min
Sf = (Vv reverse) scan min
Sf = (Sf reverse) drop 1
Big = array 1000000000000000000
Sf = concat Sf Big
Wa = Ks * Cc + Pre
Wb = (Ks + Aa) * Cc + Sf
Ww = Wa min Wb
Rw = Ww mod Mm
W1 = Rw sum mod Mm
W2 = Rw * Rw mod Mm sum mod Mm
Iv = (array 2 12 17) (Mm - 2) Mm powmod
Ia = Aa mod Mm
Ia = Ia (Mm - 2) Mm powmod
Ss = (Aa + Bb + Cc) mod Mm
I2 = Iv 0
I12 = Iv 1
Hg = (Aa - 1) mod Mm * I2
Ge = (W1 * Ia - Hg) mod Mm
Gp = W2 * Ia mod Mm * I2 mod Mm
Sq = (Aa * Aa - 1) mod Mm * I12
Tx = (Gp - W1 * I2 + Sq) mod Mm
Tr = Ss * (Ss - 1) mod Mm * I2
Answer = (Tr + Ss * Ge + Tx) mod Mm
Answer print
