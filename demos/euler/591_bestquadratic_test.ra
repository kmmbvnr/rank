use testing

test "default input"
  use "591_bestquadratic" as solve
  Answer = solve
  Answer equal 526007984625966
end

test "statement values"
  use "591_bestquadratic" as solve
  Answer = solve 10 2 2
  Answer equal 6
  Answer = solve 100 5 5
  Answer equal 55
  Answer = solve 1000000 7 7
  Answer equal 560323
end

test "brute-force sum"
  use "591_bestquadratic" as solve
  Answer = solve 1000
  Answer equal 47949
end
