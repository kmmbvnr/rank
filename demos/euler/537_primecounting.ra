rem Counting tuples
rem https://projecteuler.net/problem=537
use numbers
use sequences
use io
use cli
arg N integer = 20000
arg K integer = 20000

Mod = 1004535809
rem Prime gaps count choices for pi(x).
Length = N + 1
Primes = primes take Length array
Upper = Primes drop 1
Lower = Primes take N
Gaps = Upper - Lower
Base = concat (array 1) Gaps
Result = array 1
Power = K
for Power greater 0
  if Power mod 2 equal 1
    Next = Result convolve Base mod Mod
    Result = Next take Length
  end
  Power //= 2
  if Power greater 0
    Next = Base convolve Base mod Mod
    Base = Next take Length
  end
end
Answer = 0
if N less (Result len)
  Answer = Result N
end
return Answer
