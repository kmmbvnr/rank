use testing

test "default input"
  use "622_riffleshuffles" as solve
  Answer = solve
  Answer equal 3010983666182123972
end

test "statement and brute force"
  use "622_riffleshuffles" as solve
  Answer = solve 8
  Answer equal 412
  Answer = solve 12
  Answer equal 8628
  Answer = solve 16
  Answer equal 111032
end
