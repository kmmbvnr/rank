rem Pencils of Rays
rem https://projecteuler.net/problem=372

use numbers
use io
use cli

option Low integer = 2000000
option High integer = 1000000000

Answer = Low pencils High
Answer print

fun Low pencils High
  L = Low + 1
  K = (High * High) // (L * L)
  if K mod 2 equal 0
    K -= 1
  end
  Total = 0
  for I in 1 to K by 2
    Total += L High (I + 1) below
    Total -= L High I below
  end
  return Total
end

fun L U K below
  Side = U - L + 1
  B = 0
  Part = 0
  if K equal 1
    return Side * (Side - 1) // 2
  end
  R = K isqrt
  if R * R equal K
    B = U // R
    if B less L
      return Side * Side
    end
    B = B min U
    Cnt = B - L + 1
    Sum = (L + B) * Cnt // 2
    Part = R * Sum - L * Cnt
  else
    B = ((U * U - 1) // K) isqrt
    if B less L
      return Side * Side
    end
    B = B min U
    Cnt = B - L + 1
    Sum = 0 1 1 K B surdsum
    Sum -= 0 1 1 K (L - 1) surdsum
    Part = Sum - (L - 1) * Cnt
  end
  return Part + (U - B) * Side
end

fun A B C K N surdsum
  if N equal 0
    return 0
  end
  Q = A B C K surdfloor
  Base = Q * N * (N + 1) // 2
  A -= Q * C
  if B equal 0
    return Base
  end
  M = (A * N) (B * N) C K surdfloor
  if M equal 0
    return Base
  end
  unpack A B C = A B C K surdinv
  Rest = A B C K M surdsum
  return Base + N * M - Rest
end

fun A B C K surdfloor
  if B equal 0
    return A // C
  end
  BB = B abs
  S = (BB * BB * K) isqrt
  if B greater 0
    T = (A + S) // C
    U = (T + 1) * C - A
    if U at most 0
      return T + 1
    end
    if U * U at most BB * BB * K
      return T + 1
    end
    return T
  end
  T = (A - S - 1) // C
  D = A - (T + 1) * C
  Good = D at least 0
  Good and= D * D at least BB * BB * K
  if Good
    return T + 1
  end
  return T
end

fun A B C K surdinv
  X = A * C
  Y = -B * C
  Z = A * A - B * B * K
  if Z less 0
    X = -X
    Y = -Y
    Z = -Z
  end
  G = (X abs) gcd (Y abs)
  G = G gcd Z
  X //= G
  Y //= G
  Z //= G
  return array X Y Z
end
