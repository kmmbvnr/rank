use testing

test "default input"
  use "087_primepowertriples" as solve
  Out = solve
  Answer = Out .answer

  Answer equal 1097343
end

test "statement example below fifty"
  use "087_primepowertriples" as solve
  use sequences
  Out = solve 50
  Answer = Out .answer
  Few = Out .few

  Answer equal 4
  Vals = Few unique array
  Sorted = Vals sort
  Sorted (array 28 33 47 49) equal rank 1
end
