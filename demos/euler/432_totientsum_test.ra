use testing

test "small bounds against brute force"
  use "432_totientsum"
  N = 1
  run
  Answer equal 92160
  N = 10
  run
  Answer equal 5068800
  N = 1000
  run
  Answer equal 528791040
end

test "short table uses the recursion"
  use "432_totientsum"
  N = 1000000
  L = 1000
  run
  Answer equal 821125120
end
