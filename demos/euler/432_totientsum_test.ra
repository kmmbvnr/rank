use testing

test "small bounds against brute force"
  use "432_totientsum" as solve
  Answer = solve 1
  Answer equal 92160
  Answer = solve 10
  Answer equal 5068800
  Answer = solve 1000
  Answer equal 528791040
end

test "short table uses the recursion"
  use "432_totientsum" as solve
  Answer = solve 1000000 1000
  Answer equal 821125120
end

test "empty sum"
  use "432_totientsum" as solve
  Answer = solve 0
  Answer equal 0
end
