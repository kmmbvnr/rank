rem Nim Extreme
rem https://projecteuler.net/problem=409

use numbers
use sequences
use io
use cli

option N integer = 10000000

rem Heaps are distinct nonzero vectors
rem of F2^N, in order. All: (2^N - 1)
rem falling N. Losing (xor 0) is
rem (All + (2^N - 1) C) / 2^N, with
rem C = (-1)^ceil(N/2) N! binom(
rem 2^(N-1) - 1, N div 2). Products
rem are halved pairwise mod P.
fun V modprod P
  for V len greater 1
    if V len mod 2 equal 1
      V = concat V (array 1)
    end
    H = V len // 2
    Lo = V (0 to H - 1)
    Hi = V (H to 2 * H - 1)
    V = (Lo * Hi mod P) copy
  end
  return V 0
end

P = 1000000007
T = 2 N P powmod
Av = ((T - (1 to N)) mod P) copy
All = Av modprod P
Fact = (1 to N) copy modprod P
H = N // 2
Half = 2 (N - 1) P powmod
Top = 1
Fh = 1
if H greater 0
  Tv = (Half - 1 - (0 to H - 1)) mod P
  Top = Tv copy modprod P
  Fh = (1 to H) copy modprod P
end
Bin = Top * (Fh (P - 2) P powmod) mod P
Sign = 1
if (N + 1) // 2 mod 2 equal 1
  Sign = -1
end
Cn = Sign * Fact * Bin mod P
Lose = All + (T - 1) * Cn
Lose = Lose mod P * (T (P - 2) P powmod)
Answer = (All - Lose) mod P
Answer print
