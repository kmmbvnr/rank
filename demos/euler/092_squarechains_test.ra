use testing

test "default input"
  use "092_squarechains"
  run

  Answer equal 8581146
end

test "smaller numbers of digits"
  use "092_squarechains"
  Digits = 2
  run

  Answer equal 80
  Digits = 3
  run

  Answer equal 857
end

test "chains end at 1 or the 89 cycle"
  use "092_squarechains"
  run

  Ends 1 equal 1
  Ends 44 equal 1
  Ends 85 not equal 1
  Ends 89 not equal 1
end
