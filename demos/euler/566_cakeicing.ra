use numbers
use sequences
use io
use cli
use bits

arg N integer = 53

Ep = 0.000000000001
Wd = 1048576
Of = 524288
Hs = 4194304
Hk = array shape Hs fill 0
Wl = array shape 3000000 fill 0
Sl = array shape 3000000 fill 0
Hx = array shape Hs fill 0
Nt = 0
for A in 9 to N
  for B in (A + 1) to N
    Nt += N - B
  end
end
Ta = array shape Nt fill 0
Tb = array shape Nt fill 0
Tc = array shape Nt fill 0
Ni = 0
for A in 9 to N
  for B in (A + 1) to N
    for C in (B + 1) to N
      Ta Ni = A
      Tb Ni = B
      Tc Ni = C
      Ni += 1
    end
  end
end
Answer = 0
for Tr in 0 till Nt
  A = Ta Tr
  B = Tb Tr
  C = Tc Tr
  Rt = C isqrt
  Gx = A
  Gy = B
  for Gy greater 0
    Tg = Gx mod Gy
    Gx = Gy
    Gy = Tg
  end
  Dn = A * B // Gx
  Sc = (C * 1.0) sqrt
  Sp = array B A 0
  Sq = array 0 0 1
  Sqr = Rt * Rt equal C
  if Sqr
    Gx = Dn
    Gy = Rt
    for Gy greater 0
      Tg = Gx mod Gy
      Gx = Gy
      Gy = Tg
    end
    Dn = Dn // Gx * Rt
    Sp = array (Dn // A) (Dn // B) 0
    Sp 2 = Dn // Rt
    Sq = array 0 0 0
  else
    Dn = A * B
  end
  Nw = 0
  Rp = array shape 8 fill 0
  Rq = array shape 8 fill 0
  Rh = array shape 8 fill 0
  Rn = array shape 8 fill 0
  Hd = 0 - 1
  Go = 1
  for Go equal 1
    Nr = 0
    if Hd less 0
      for Ph in 0 to 2
        Rp Nr = 0
        Rq Nr = 0
        Rh Nr = Ph
        Rn Nr = 0
        Nr += 1
        Rp Nr = Sp Ph
        Rq Nr = Sq Ph
        Rh Nr = Ph
        Rn Nr = 0
        Nr += 1
      end
    else
      Kk = (Wl Hd) - 1
      Ph = Kk mod 3
      R0 = Kk // 3
      P = R0 // Wd
      Q = R0 mod Wd - Of
      S = Sp Ph
      T = Sq Ph
      Nx = (Ph + 1) mod 3
      Zr = (P equal 0) and (Q equal 0)
      Ie = (P equal S) and (Q equal T)
      if Zr or Ie
        Rp Nr = Dn - S
        Rq Nr = 0 - T
        Rh Nr = Nx
        Rn Nr = 1
        Nr += 1
        Rp Nr = 0
        Rq Nr = 0
        Rh Nr = Nx
        Rn Nr = 0
        Nr += 1
      else
        Vx = P / Dn + Q / Sc
        Vs = S / Dn + T / Sc
        if Vx less Vs
          Rp Nr = Dn - P
          Rq Nr = 0 - Q
        else
          Rp Nr = P - S
          Rq Nr = Q - T
        end
        Rh Nr = Nx
        Rn Nr = 1
        Nr += 1
      end
      Pp = (Ph + 2) mod 3
      S2 = Sp Pp
      T2 = Sq Pp
      Vr = (P + S2) / Dn + (Q + T2) / Sc
      if Vr less 1 - 0.000000000001
        Rp Nr = P + S2
        Rq Nr = Q + T2
        Rh Nr = Pp
        Rn Nr = 0
        Nr += 1
      end
      Vy = 1 - (P / Dn + Q / Sc)
      Vt = S2 / Dn + T2 / Sc
      Ok = Vy greater Ep
      Ok = Ok and (Vy less Vt - Ep)
      if Ok
        Rp Nr = Dn - P
        Rq Nr = 0 - Q
        Rh Nr = Pp
        Rn Nr = 0
        Nr += 1
      end
    end
    for I in 0 till Nr
      Cp = Rp I
      Cq = Rq I
      if (Rn I) equal 1
        if Cq equal 0
          Cp = Cp mod Dn
        else
          Nv = Cp / Dn + Cq / Sc + Ep
          Nf = Nv floor
          Cp -= (Nf integer) * Dn
        end
      end
      Ky = (Cp * Wd + Cq + Of) * 3
      Ky += Rh I + 1
      H = (Ky * 40503) mod Hs
      Pb = 1
      for Pb equal 1
        Hv = Hk H
        if Hv equal 0
          Hk H = Ky
          Wl Nw = Ky
          Sl Nw = H
          Nw += 1
          Pb = 0
        elif Hv equal Ky
          Pb = 0
        else
          H = (H + 1) mod Hs
        end
      end
    end
    Hd += 1
    if Hd less Nw
      Go = 1
    else
      Go = 0
    end
  end
  Mm = Nw // 3
  Ks = (Wl (0 till Nw array)) - 1
  Pa = Ks mod 3
  Rk = Ks // 3
  Pv = Rk // Wd
  Qv = Rk mod Wd - Of
  Vl = Pv / Dn + Qv / Sc
  Sk = array shape 3 Mm fill 0
  for Ph in 0 to 2
    Ix = (Pa equal Ph) indices
    Vp = Vl Ix
    Od = Vp argsort
    Sk Ph = (Wl (Ix Od))
  end
  for Ph in 0 to 2
    for I in 0 till Mm
      Ky = Sk Ph I
      H = (Ky * 40503) mod Hs
      for (Hk H) not equal Ky
        H = (H + 1) mod Hs
      end
      Hx H = I
    end
  end
  Nxt = array shape (3 * Mm) fill 0
  Fb = array shape (3 * Mm) fill 0
  for Ph in 0 to 2
    S = Sp Ph
    T = Sq Ph
    Nx = (Ph + 1) mod 3
    Vs = S / Dn + T / Sc
    for I in 0 till Mm
      Kk = (Sk Ph I) - 1
      R1 = Kk // 3
      Lp = R1 // Wd
      Lq = R1 mod Wd - Of
      Hp = Dn
      Hq = 0
      if I + 1 less Mm
        Kh = (Sk Ph (I + 1)) - 1
        R2 = Kh // 3
        Hp = R2 // Wd
        Hq = R2 mod Wd - Of
      end
      Vh = Hp / Dn + Hq / Sc
      Cp = 0
      Cq = 0
      Fl = 0
      if Vh less Vs + 0.000000000001
        Cp = Dn - Hp
        Cq = 0 - Hq
        Fl = 1
      else
        Cp = Lp - S
        Cq = Lq - T
      end
      if Cq equal 0
        Cp = Cp mod Dn
      else
        Nv = Cp / Dn + Cq / Sc + Ep
        Nf = Nv floor
        Cp -= (Nf integer) * Dn
      end
      Ky = (Cp * Wd + Cq + Of) * 3
      Ky += Nx + 1
      H = (Ky * 40503) mod Hs
      for (Hk H) not equal Ky
        H = (H + 1) mod Hs
      end
      Jx = Hx H
      Ix2 = Ph * Mm + I
      Nxt Ix2 = Nx * Mm + Jx
      Fb (Ph * Mm + I) = Fl
    end
  end
  Vis = array shape (3 * Mm) fill 0
  Fa = array shape (3 * Mm + 1) fill 0
  P0 = array shape (3 * Mm + 2) fill 0
  Tx = array shape (6 * Mm + 8) fill 0
  Fl2 = array shape (3 * Mm + 2) fill 0
  Mn1 = 0 - 1
  M3 = 3 * Mm
  Cq0 = array shape (M3 + 3) fill Mn1
  Cpd = array shape (3 * Mm + 3) fill 1
  Nc = 0
  for I0 in 0 till Mm
    if (Vis I0) equal 0
      Ln = 0
      St = I0
      Gw = 1
      for Gw equal 1
        Vis St = 1
        Fa Ln = Fb St
        Ln += 1
        St = Nxt St
        if St equal I0
          Gw = 0
        end
      end
      for I in 0 till Ln
        P0 (I + 1) = (P0 I) bxor (Fa I)
      end
      Wp = P0 Ln
      El = Ln // 3
      Mq = El * (1 + Wp)
      for Rr in 0 to 2
        Tl = El + Mq
        for J in 0 till Tl
          Tt = 3 * J + Rr
          Tp = Tt mod Ln
          Wq = Wp * ((Tt // Ln) mod 2)
          Tx J = (P0 Tp) bxor Wq
        end
        for J in 0 till El
          Tt = 3 * J
          Tp = Tt mod Ln
          Wq = Wp * ((Tt // Ln) mod 2)
          Fl2 J = (P0 Tp) bxor Wq
        end
        Fl2 El = 0
        Fi = array shape (El + 1) fill 0
        Kf = 0
        for J in 1 till El
          Aj = Fl2 J
          Cw = Kf greater 0
          if Cw
            Cw = Aj not equal (Fl2 Kf)
          end
          for Cw
            Kf = Fi (Kf - 1)
            Cw = Kf greater 0
            if Cw
              Cw = Aj not equal (Fl2 Kf)
            end
          end
          if (Fl2 J) equal (Fl2 Kf)
            Kf += 1
          end
          Fi J = Kf
        end
        Kf = 0
        Q0 = 0 - 1
        Q1 = 0 - 1
        for J in 0 till Tl
          Cm = 1
          for Cm equal 1
            Cm = 0
            if Kf greater 0
              Bad = Kf equal El
              Bj = Tx J
              Bk = Fl2 Kf
              Bd2 = Bj not equal Bk
              Bad = Bad or Bd2
              if Bad
                Kf = Fi (Kf - 1)
                Cm = 1
              end
            end
          end
          if (Tx J) equal (Fl2 Kf)
            Kf += 1
          end
          if Kf equal El
            Qm = J + 1 - El
            if Qm less Mq
              if Q0 less 0
                Q0 = Qm
              elif Q1 less 0
                Q1 = Qm
              end
            end
          end
        end
        Cq0 (Nc * 3 + Rr) = Q0
        Pd = Mq
        if Q1 greater 0
          Pd = Q1 - Q0
        end
        Cpd (Nc * 3 + Rr) = Pd
      end
      Nc += 1
    end
  end
  Best = 0 - 1
  for Rr in 0 to 2
    Rs = 0
    Md = 1
    Okk = 1
    for Cy in 0 till Nc
      Q0 = Cq0 (Cy * 3 + Rr)
      Pd = Cpd (Cy * 3 + Rr)
      if Q0 less 0
        Okk = 0
      elif Okk equal 1
        Gc = Md
        Gd = Pd
        for Gd greater 0
          Tg = Gc mod Gd
          Gc = Gd
          Gd = Tg
        end
        Df = Q0 - Rs
        if Df mod Gc not equal 0
          Okk = 0
        else
          M2 = Pd // Gc
          Ts = 0
          if M2 greater 1
            E0 = M2
            E1 = (Md // Gc) mod M2
            X0 = 0
            X1 = 1
            for E1 greater 0
              Qe = E0 // E1
              Te = E0 - Qe * E1
              E0 = E1
              E1 = Te
              Te = X0 - Qe * X1
              X0 = X1
              X1 = Te
            end
            Iv = X0 mod M2
            Df2 = (Df // Gc) mod M2
            Ts = (Df2 * Iv) mod M2
          end
          Rs = Rs + Md * Ts
          Md = Md // Gc * Pd
          Rs = Rs mod Md
        end
      end
    end
    if Okk equal 1
      Qs = Rs
      if (Qs equal 0) and (Rr equal 0)
        Qs = Md
      end
      Nn = 3 * Qs + Rr
      if (Best less 0) or (Nn less Best)
        Best = Nn
      end
    end
  end
  Answer += Best
  for I in 0 till Nw
    Hk (Sl I) = 0
  end
end
Answer print
