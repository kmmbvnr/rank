rem Cake Icing Puzzle
rem https://projecteuler.net/problem=566
use numbers
use sequences
use io
use cli
use bits
use algo
use text

arg N integer = 53

Tolerance = 0.000000000001
Width = 1048576
Bias = 524288
rem Cap temporary geometry storage.
Batch = 65536
rem Publish the dynamic work list once.
fun Queue listed Size
  Values = array shape Size fill 0
  for I in 0 till Size
    Values I = Queue I
  end
  return Values
end
rem Forward orbits include every cut.
fun Geometry boundaries
  Scale = Geometry .scale
  Root = Geometry .root
  Rational = Geometry .rational
  Irrational = Geometry .irrational
  Seen = new index
  Queue = new index
  Seed = (Scale * Width + Bias) * 3 + 1
  Seen Seed = 0
  Seen (Seed + 1) = 0
  Seen (Seed + 2) = 0
  Queue 0 = Seed
  Queue 1 = Seed + 1
  Queue 2 = Seed + 2
  Size = 3
  Cursor = 0
  for Cursor less Size
    Key = (Queue Cursor) - 1
    Phase = Key mod 3
    Raw = Key // 3
    P = Raw // Width
    Q = Raw mod Width - Bias
    StepP = Rational Phase
    StepQ = Irrational Phase
    Point = P / Scale + Q / Root
    Cut = StepP / Scale + StepQ / Root
    NextP = 0
    NextQ = 0
    if Point less Cut - Tolerance
      NextP = Scale - P
      NextQ = 0 - Q
    else
      NextP = P - StepP
      NextQ = Q - StepQ
    end
    NextPhase = (Phase + 1) mod 3
    Packed = NextP * Width + NextQ
    Target = (Packed + Bias) * 3
    Target += NextPhase + 1
    if Target not in Seen
      Seen Target = 0
      Queue Size = Target
      Size += 1
    end
    Cursor += 1
  end
  Seen = new index
  Cuts = Queue listed Size
  Queue = new index
  Cuts = Cuts (Cuts not equal Seed)
  Cuts = Cuts (Cuts not equal Seed + 1)
  Cuts = Cuts (Cuts not equal Seed + 2)
  return Cuts
end
fun Start orbit Next
  Size = Next len
  Nodes = array shape Size fill 0
  Node = Start
  Count = 0
  Again = true
  for Again
    Nodes Count = Node
    Count += 1
    Node = Next Node
    Again = Node not equal Start
  end
  Range = 0 till Count
  return Nodes Range copy
end
fun Value inverse Mod
  Remainder = Value mod Mod
  Previous = Mod
  Left = 0
  Right = 1
  for Remainder greater 0
    Quotient = Previous // Remainder
    Product = Quotient * Remainder
    Next = Previous - Product
    Previous = Remainder
    Remainder = Next
    Next = Left - Quotient * Right
    Left = Right
    Right = Next
  end
  return Left mod Mod
end
rem Agree exact cycle congruences.
fun State reconcile Pair rank 1 1
  Residue = State 0
  Mod = State 1
  Valid = State 2
  Offset = Pair 0
  Period = Pair 1
  if Valid equal 0 or Offset less 0
    return array 0 1 0
  end
  Common = Mod gcd Period
  Difference = Offset - Residue
  if Difference mod Common not equal 0
    return array 0 1 0
  end
  Factor = Period // Common
  Shift = 0
  if Factor greater 1
    Value = Mod // Common mod Factor
    Inverse = Value inverse Factor
    Reduced = Difference // Common
    Shift = Reduced * Inverse mod Factor
  end
  Result = Residue + Mod * Shift
  Multiple = Mod * Factor
  Result = Result mod Multiple
  return array Result Multiple 1
end
rem Parity words encode whole rotations.
fun Phase matches Cycle rank 0 0
  Prefix = Cycle .prefix
  Length = Cycle .length
  Parity = Cycle .parity
  Size = Length // 3
  Period = Size * (1 + Parity)
  Count = Size + Period
  Steps = 0 till Count copy
  Offset = 3 * Steps + Phase
  Places = Offset mod Length
  Turns = Offset // Length mod 2
  Flip = Parity * Turns
  TextBits = (Prefix Places) bxor Flip
  Text = TextBits join ""
  Steps = 0 till Size copy
  Offset = 3 * Steps
  Places = Offset mod Length
  Turns = Offset // Length mod 2
  Flip = Parity * Turns
  WordBits = (Prefix Places) bxor Flip
  Pattern = WordBits join ""
  Hits = Text findall Pattern
  Hits = Hits (Hits less Period)
  First = 0 - 1
  if Hits len greater 0
    First = Hits 0
  end
  if Hits len greater 1
    Period = (Hits 1) - First
  end
  return array First Period
end

rem Bound temporary geometry storage.
fun Keys permutation Geometry
  Scale = Geometry .scale
  Root = Geometry .root
  Rational = Geometry .rational
  Irrational = Geometry .irrational
  Size = Keys len
  Count = Size // 3
  Last = Count - 1
  Sorted = Keys sort .indexed
  unpack Ordered Positions = Sorted
  Next = array shape Size fill 0
  Flips = array shape Size fill 0
  for Start in 0 till Size by Batch
    Stop = Start + Batch min Size
    Range = Start till Stop copy
    Encoded = (Keys Range - 1) // 3
    LowP = Encoded // Width
    LowQ = Encoded mod Width - Bias
    Phases = Range // Count
    End = Range mod Count equal Last
    Ahead = (Range + 1) min (Size - 1)
    Raw = (Keys Ahead - 1) // 3
    HighP = Raw // Width
    HighQ = Raw mod Width - Bias
    HighP = End choose Scale HighP
    HighQ = End choose 0 HighQ
    CutsP = Rational Phases
    CutsQ = Irrational Phases
    High = HighP / Scale + HighQ / Root
    Cuts = CutsP / Scale + CutsQ / Root
    Flip = High less Cuts + Tolerance
    LeftP = LowP - CutsP
    LeftQ = LowQ - CutsQ
    MirrorP = Scale - HighP
    MirrorQ = 0 - HighQ
    NextP = Flip choose MirrorP LeftP
    NextQ = Flip choose MirrorQ LeftQ
    Turns = NextP / Scale + NextQ / Root
    Turns += Tolerance
    Shift = Turns floor integer
    NextP -= Shift * Scale
    NextPhases = (Phases + 1) mod 3
    Packed = NextP * Width + NextQ
    Targets = (Packed + Bias) * 3
    Targets += NextPhases + 1
    Slots = Ordered lowerindex Targets
    Next Range = Positions Slots
    Flips Range = Flip integer
  end
  return tuple Next Flips
end

fun Triple icing rank 1
  A = Triple 0
  B = Triple 1
  C = Triple 2
  ExactRoot = C isqrt
  Scale = A lcm B
  Root = C sqrt
  Square = ExactRoot * ExactRoot equal C
  if Square
    Scale = Scale lcm ExactRoot
  end
  First = Scale // A
  Second = Scale // B
  Rational = array First Second 0
  Irrational = array 0 0 1
  if Square
    Rational 2 = Scale // ExactRoot
    Irrational = array 0 0 0
  end
  Geometry = record
    .scale = Scale
    .root = Root
    .rational = Rational
    .irrational = Irrational
  end
  Cuts = Geometry boundaries
  Size = Cuts len
  Count = Size // 3
  Encoded = Cuts - 1
  Phases = Encoded mod 3
  Raw = Encoded // 3
  P = Raw // Width
  Q = Raw mod Width - Bias
  Angles = P / Scale + Q / Root
  SortKeys = Phases + Angles
  Order = SortKeys argsort
  Keys = Cuts Order
  Pair = Keys permutation Geometry
  unpack Next Flips = Pair
  Vis = array shape Size fill 0
  Row = array 0 1 1
  Current = Row reshape 1 3
  Zeros = array shape 3 1 fill 0
  Current += Zeros
  Phases = 0 to 2 copy
  Zero = array 0
  for I in 0 till Count
    if Vis I equal 0
      Nodes = I orbit Next
      Vis Nodes = 1
      Length = Nodes len
      Bits = Flips Nodes
      Prefix = Bits scan +
      Prefix = Prefix mod 2
      Prefix = concat Zero Prefix copy
      Parity = Prefix Length
      Cycle = record
        .prefix = Prefix
        .length = Length
        .parity = Parity
      end
      Found = Phases matches Cycle
      Current = Current reconcile Found
    end
  end
  Columns = Current transpose
  Offsets = Columns 0
  Moduli = Columns 1
  Valid = Columns 2
  ZeroResidue = Offsets equal 0
  Initial = Phases equal 0
  Positive = ZeroResidue and Initial
  Times = Positive choose Moduli Offsets
  Steps = 3 * Times + Phases
  Good = Valid equal 1
  Best = Steps Good min
  return Best
end
Answer = 0
if N at least 11
  Count = N - 8
  Values = 0 till Count copy
  First = Values reshape Count 1 1
  Second = Values reshape 1 Count 1
  Third = Values reshape 1 1 Count
  Before = First less Second
  After = Second less Third
  Mask = Before and After
  Rows = Mask indices
  Triples = Rows + 9
  Results = Triples icing
  Answer = Results sum
end
return Answer
