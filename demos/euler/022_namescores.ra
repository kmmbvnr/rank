rem Names Scores
rem https://projecteuler.net/problem=22
rem Sum alphabetical scores from the
rem official comma-separated names file

use text
use sequences
use io
use cli

arg Input path = "https://projecteuler.net/resources/documents/0022_names.txt"

rem Drop the quotes, split on commas.
Text = Input read
Names = Text "\"" "" translate split ","

rem Sort, then weight by position.
Sums' = Names sort name_value rank 0
Scores' = Sums * (1 to Names len)
Answer = Scores sum
Answer print

rem Map A through Z to 1 through 26
rem using Unicode code points.
fun Name name_value
  Base = "A" codepoint
  Codes' = Name codepoint rank 0
  Values' = Codes - Base + 1
  return Values sum
end
