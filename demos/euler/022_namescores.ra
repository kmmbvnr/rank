rem Names Scores
rem https://projecteuler.net/problem=22
rem Sum alphabetical scores from the
rem official comma-separated names file

use text
use sequences
use io
use cli

argument Input path

Text = Input read

rem Remove the surrounding quotes and split
rem the quoted comma-separated input.
Last = Text len - 1
Body = Text (1 till Last)
Names = Body split "\",\""

rem Sort names and multiply each letter sum
rem by its one-based position.
Sorted = Names sort
Values' = Sorted name_value rank 0
Count = Sorted len
Positions' = 1 to Count
Scores' = Values * Positions
Answer = Scores sum
Answer print

rem Convert A through Z to values 1 through
rem 26 using Unicode code points.
fun Name name_value
  Base = "A" codepoint
  Codes' = Name codepoint rank 0
  Values' = Codes - Base + 1
  return Values sum
end
