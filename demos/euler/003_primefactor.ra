rem Largest Prime Factor
rem https://projecteuler.net/problem=3
rem Largest prime factor of 600851475143

use io
use cli

rem Integer whose factors are inspected.
option N integer = 600851475143

D = 2
Step = 1
for N greater 1
  Rest = N // D
  if D greater Rest
    break
  elif Rest * D equal N
    N = Rest
  else
    D += Step
    Step = 2
  end
end
N print
