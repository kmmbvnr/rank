rem Perfect Right-angled Triangles
rem https://projecteuler.net/problem=218
rem Count the right triangles with whole
rem sides and a square hypotenuse whose
rem area is not divisible by both 6
rem and 28

use numbers
use sequences
use io
use cli

arg Mod integer = 168

rem A primitive triangle with a square
rem hypotenuse k^2 comes from coprime r,
rem s of opposite parity: legs m^2 - n^2
rem and 2 m n, with m = r^2 - s^2, n =
rem 2 r s. Its area is divisible by 6
rem and 28 when a b is divisible by
rem Mod = 168. That depends only on r
rem and s mod 168, so it is checked on
rem every residue pair that can come
rem from a coprime pair: none of them
rem fails, whatever the limit.
R = 0 till Mod array
Rc = R reshape Mod 1
Odd' = (Rc + R) mod 2 equal 1
R3' = R mod 3 equal 0
R7' = R mod 7 equal 0
Three' = (Rc mod 3 equal 0) and R3
Seven' = (Rc mod 7 equal 0) and R7
Both' = Three or Seven
Pair' = Odd and (not Both)
M = (Rc * Rc - R * R) mod Mod
N = 2 * Rc * R mod Mod
A' = (M * M - N * N) mod Mod
B' = 2 * M * N mod Mod
Bad' = (A * B mod Mod) not equal 0
Answer = (Pair and Bad) count
Answer print
