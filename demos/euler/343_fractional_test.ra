  run
  Answer equal 118937
end

test "fractional sieve boundaries"
  use "343_fractional"
  Limit = 2
  run
  Answer equal 3
  Limit = 3
  run
  Answer equal 9
  Limit = 1000
  run
  Answer equal 72421603
end
