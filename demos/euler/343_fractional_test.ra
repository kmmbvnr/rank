use testing

test "fractional last value"
  use "343_fractional"
  2 lpf equal 2
  4 lpf equal 2
  9 lpf equal 3
  49 lpf equal 7
  21 lpf equal 7
  1 lpf equal 1
  1000036000099 lpf equal 1000033
  Limit = 1
  run
  Answer equal 1
end

test "fractional sequence sum"
  use "343_fractional"
  Limit = 20
  run
  Answer equal 1371
  Limit = 100
  run
  Answer equal 118937
end

test "fractional sieve boundaries"
  use "343_fractional"
  Limit = 2
  run
  Answer equal 3
  Limit = 3
  run
  Answer equal 9
  Limit = 1000
  run
  Answer equal 72421603
end
