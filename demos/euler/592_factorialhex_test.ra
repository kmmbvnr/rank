use testing

test "default input"
  use "592_factorialhex" as solve
  Answer = solve
  Answer equal "13415DF2BE9C"
end

test "statement and exact factorials"
  use "592_factorialhex" as solve
  Answer = solve 20
  Answer equal "21C3677C82B4"
  Answer = solve 100
  Answer equal "02EA2735C61A"
  Answer = solve 70000
  Answer equal "43E723BEF344"
end
