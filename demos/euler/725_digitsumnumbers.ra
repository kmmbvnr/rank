rem Digit Sum Numbers
rem https://projecteuler.net/problem=725

use numbers
use sequences
use io
use cli

arg Nn integer = 2020
arg Pm integer = 10 ** 16

rem A DS-number has digit sum 2s and a
rem digit s, for exactly one s. Per s
rem track the prefixes by digit sum u
rem (0 to 18) and whether s was seen:
rem count A and value sum B. Appending
rem d gives A' = A and B' = 10 B + d A.
rem Each target state gathers its
rem sources through a padded table.
Ss = (0 to 9) reshape 10 1 1 1
Us = (0 to 18) reshape 1 19 1 1
Hs = (0 to 1) reshape 1 1 2 1
Ds = (0 to 9) reshape 1 1 1 10
Uo = Us - Ds
Ok = Uo at least 0
Ix0 = Ss * 38 + Uo * 2
Z0 = 380
Ix = Ix0 + Hs
Am = (Hs equal 1) or (Ds not equal Ss)
Sa = Ok and Am
Ta = Sa choose Ix Z0
Ge = (Hs equal 1) and (Ds equal Ss)
Ge = Ge and Ok
Tb = Ge choose Ix0 Z0
Ga = Ta reshape 380 10
Gb = Tb reshape 380 10
Dd = (Ds + Ta * 0) reshape 380 10
Dg = Dd integer
rem Layer 1: leading digits d <= 2 s.
Dl = 1 to 9
Ai = array shape 381 fill 0
Bi = array shape 381 fill 0
Sl = 0 to 9
Sc = Sl reshape 10 1
Hh = (Dl equal Sc) integer
Il = Sc * 38 + Dl * 2 + Hh
Vl = Dl at most (Sc * 2)
Ix2 = Il filter Vl
Dx = (Dl + Sc * 0) filter Vl
Ai Ix2 = 1
Bi Ix2 = Dx
Ts = Sl * 42 + 1
Answer = Bi Ts sum
for L in 2 to Nn
  Ca = Ai Ga
  Cb = Ai Gb
  Ba = Bi Ga
  Bb = Bi Gb
  An = (Ca sum axis 1) + (Cb sum axis 1)
  Bn = (Ba sum axis 1) + (Bb sum axis 1)
  Bn = 10 * Bn + (Ca * Dg sum axis 1)
  Bn = Bn + (Cb * Dg sum axis 1)
  Ai = concat (An mod Pm) (array 0)
  Bi = concat (Bn mod Pm) (array 0)
  Sm = Bi Ts sum
  Answer = (Answer + Sm) mod Pm
end
Answer print
