rem Digit Sum Numbers
rem https://projecteuler.net/problem=725

use numbers
use sequences
use io
use cli

arg Length integer = 2020
arg Modulus integer = 10 ** 16

rem A DS-number has digit sum 2s and a
rem digit s, for exactly one s. Per s
rem track the prefixes by digit sum u
rem (0 to 18) and whether s was seen:
rem count A and value sum B. Appending
rem d gives A' = A and B' = 10 B + d A.
rem Each target state gathers its
rem sources through a padded table.
Witness = (0 to 9) reshape 10 1 1 1
Sums = (0 to 18) reshape 1 19 1 1
Seen = (0 to 1) reshape 1 1 2 1
Digit = (0 to 9) reshape 1 1 1 10
Before = Sums - Digit
Valid = Before at least 0
Index0 = Witness * 38 + Before * 2
Nothing = 380
Index1 = Index0 + Seen
Marked = Seen equal 1
Other = Digit not equal Witness
Allowed = Marked or Other
Plain = Valid and Allowed
PlainSrc = Plain choose Index1 Nothing
Extra = Marked and (Digit equal Witness)
Extra = Extra and Valid
ExtraSrc = Extra choose Index0 Nothing
PlainTab = PlainSrc reshape 380 10
ExtraTab = ExtraSrc reshape 380 10
Spread = Digit + PlainSrc * 0
Digits = Spread reshape 380 10
DigitInt = Digits integer
rem Layer 1: leading digits d <= 2 s.
Leading = 1 to 9
Counts = array shape 381 fill 0
Values = array shape 381 fill 0
Witnesses = 0 to 9
WitCol = Witnesses reshape 10 1
Hit = (Leading equal WitCol) integer
Start = WitCol * 38 + Leading * 2 + Hit
Fits = Leading at most (WitCol * 2)
Slots = Start filter Fits
Spread2 = Leading + WitCol * 0
Firsts = Spread2 filter Fits
Counts Slots = 1
Values Slots = Firsts
Targets = Witnesses * 42 + 1
Answer = Values Targets sum
for Step in 2 to Length
  CountA = Counts PlainTab
  CountB = Counts ExtraTab
  ValueA = Values PlainTab
  ValueB = Values ExtraTab
  SumA = CountA sum axis 1
  SumB = CountB sum axis 1
  NewCount = SumA + SumB
  ValueSum = ValueA sum axis 1
  ValueTwo = ValueB sum axis 1
  ValueSum = ValueSum + ValueTwo
  WeightA = CountA * DigitInt sum axis 1
  WeightB = CountB * DigitInt sum axis 1
  Extra2 = WeightA + WeightB
  NewValue = 10 * ValueSum + Extra2
  Reduced = NewCount mod Modulus
  Counts = concat Reduced (array 0)
  Cut = NewValue mod Modulus
  Values = concat Cut (array 0)
  Added = Values Targets sum
  Answer = (Answer + Added) mod Modulus
end
Answer print
