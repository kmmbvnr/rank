rem Polar polygons
rem https://projecteuler.net/problem=465

use numbers
use sequences
use io
use cli

arg N integer = 96889010407
rem Positive Limit sets the prefix size.
arg Limit integer = 0

rem A primitive ray of level k (its
rem max |coordinate|) holds N // k
rem points, and each level has 4 phi(k)
rem pairs of opposite rays. A pair of
rem weight u gives (1 + u)^2 choices,
rem so all choices are H^2 with
rem H = prod (1 + u)^c(u). Choices in
rem a closed half-plane number
rem 1 + 2 H A1 - A2 for the moments
rem A1 = sum c u, A2 = sum c u^2.
fun Bound totients
  Size = Bound + 1
  Phi = 0 to Bound copy
  Removed = array shape Size fill 1
  Top = Bound isqrt
  Primes = primes to Top copy
  Count = Primes len
  Index = 0
  Power = 2
  for Index less Count
    Prime = Primes Index
    Slots = Power to Bound by Power
    Removed Slots *= Prime
    if Power equal Prime
      Phi Slots -= Phi Slots // Prime
    end
    Power *= Prime
    if Power greater Bound
      Index += 1
      if Index less Count
        Power = Primes Index
      end
    end
  end
  Keys = 0 to Bound copy
  Rest = Keys // Removed max 1
  Large = Rest greater 1
  Delta = Phi // Rest
  Phi = Large choose (Phi - Delta) Phi
  return Phi
end

rem Only residues of Phi(x) are needed.
rem Reduce the even numerator modulo 2M
rem before dividing, even for even M.
fun N totals Prefix Mod
  Bound = Prefix len - 1
  Count = N // (Bound + 1)
  Size = Count + 2
  Cached = array shape Size fill 0
  Twice = 2 * Mod
  for I in Count to 1 by -1
    X = N // I
    Root = X isqrt
    Last = X // (Bound + 1)
    Left = X mod Twice
    Right = (X + 1) mod Twice
    Total = Left * Right mod Twice
    Total //= 2
    if Last at least 2
      Divisors = 2 to Last copy
      Values = Cached (I * Divisors)
      Total -= Values sum
    end
    Divisors = Last + 1 to Root copy
    Values = Prefix (X // Divisors)
    Total -= Values sum
    Groups = 1 to X // (Root + 1) copy
    High = X // Groups
    Low = X // (Groups + 1)
    Span = High - Low
    Terms = Prefix Groups * Span mod Mod
    Total -= Terms sum
    Cached I = Total mod Mod
  end
  return Cached
end
fun N rays Phi Mod
  Prefix = Phi scan + mod Mod
  Cached = N totals Prefix Mod
  Count = Cached len - 2
  Bound = Prefix len - 1
  Root = N isqrt
  Last = N // (Root + 1)
  CountRays = N // (Last + 1)
  Low = 1 to Last
  High = N // (1 to CountRays)
  Values = concat Low High copy
  Next = Values + 1
  Left = Cached (Values min (Count + 1))
  Small = Prefix (N // Values min Bound)
  Mask = Values at most Count
  Left = Mask choose Left Small
  Right = Cached (Next min (Count + 1))
  Small = Prefix (N // Next min Bound)
  Mask = Next at most Count
  Right = Mask choose Right Small
  Counts = 4 * (Left - Right) mod Mod
  return tuple Values Counts
end
Mod = 1000000007
rem Any cutoff above sqrt(N) is valid.
rem Use half the usual n^(2/3) table.
Bound = N ** (2 / 3) floor
Bound = Bound // 2 + 10
Minimum = N isqrt + 1
Bound = Bound max Minimum min N max 1
if Limit greater 0
  Bound = Limit max Minimum min N max 1
end
Phi = Bound totients
unpack Weights Counts = N rays Phi Mod
Rays = Weights mod Mod
First = Counts * Rays mod Mod
Second = First * Rays mod Mod
Moment1 = First sum mod Mod
Moment2 = Second sum mod Mod
rem Exponents use the multiplicative
rem group order; moments use Mod.
Order = Mod - 1
unpack Weights Counts = N rays Phi Order
Exponents = (Counts - 1) mod Order + 1
Bases = (Weights + 1) mod Mod
Powers = Bases Exponents Mod powmod
Product = Powers reduce * with 1 mod Mod
Square = Product * Product
Moment = 2 * Product * Moment1
Bad = 1 + Moment - Moment2
return (Square - Bad) mod Mod
