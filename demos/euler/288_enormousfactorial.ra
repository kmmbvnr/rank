rem An Enormous Factorial
rem https://projecteuler.net/problem=288
rem Count the factors p in the factorial
rem of N = sum of T[n] p^n, n up to Q,
rem with T[n] = S[n] mod p, S[n+1] =
rem S[n]^2 mod 50515093, S[0] = 290797,
rem modulo p^Exp

use numbers
use io
use cli

arg P integer = 61
arg Q integer = 10000000
arg Exp integer = 10

rem Digit k contributes T[k] * W(k),
rem where W(k) = (p^k - 1) / (p - 1).
rem For k >= Exp all W(k) are equal
rem modulo p^Exp: only sum the tail.
S = 290797
Low = 0
Pw = 1
Weight = 0
for K in 0 to ((Exp - 1) min Q)
  T = S mod P
  Low += T * Weight
  Weight += Pw
  Pw *= P
  S = S * S mod 50515093
end
Tail = 0
for K in Exp to Q
  Tail += S mod P
  S = S * S mod 50515093
end
Answer = (Low + Tail * Weight) mod (P ** Exp)
Answer print
