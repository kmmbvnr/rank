rem Binary Circles
rem https://projecteuler.net/problem=265
rem Sum the numbers S of the circular
rem binary sequences of length 2^N that
rem start with N zeros and contain every
rem N-bit window once

use bits
use numbers
use sequences
use io
use cli

option N integer = 5

rem Grow the sequences one bit at a time
rem after the N zeros. Each keeps its
rem value, its last window, and the set
rem of windows used, as bits of an
rem integer. At the end the N - 1 wrap
rem windows, a tail of the value then
rem zeros, must be new too.
Len = 1 shl N
Full = Len - 1
Val = array 0
Win = array 0
Used = array 1
for T in 1 to (Len - N)
  Pair' = concat (Win * 2) (Win * 2 + 1)
  Win = Pair band Full
  Val = concat (Val * 2) (Val * 2 + 1)
  Old = concat Used Used
  Seen' = (Old shr Win) band 1
  Free = Seen equal 0
  Bit' = 1 shl Win
  Used = (Old bor Bit) filter Free array
  Val = Val filter Free array
  Win = Win filter Free array
end
for J in 1 to (N - 1)
  Tail' = Val mod (1 shl (N - J))
  Win = Tail shl J
  Seen' = (Used shr Win) band 1
  Free = Seen equal 0
  Bit' = 1 shl Win
  Next' = Used bor Bit
  Used = Next filter Free array
  Val = Val filter Free array
end
Answer = Val sum
Answer print
