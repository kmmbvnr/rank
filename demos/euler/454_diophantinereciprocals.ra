rem Diophantine Reciprocals III
rem https://projecteuler.net/problem=454
use numbers
use sequences
use io
use cli
arg L integer = 1000000000000

fun Bound mobius
  Signs = array shape (Bound + 1) fill 1
  Signs 0 = 0
  for Prime in primes to Bound
    Slots = Prime to Bound by Prime
    Signs Slots *= -1
    Square = Prime * Prime
    if Square at most Bound
      Slots = Square to Bound by Square
      Signs Slots = 0
    end
  end
  return Signs
end

rem Sum N // (a*b), a < b < 2a.
fun N pair_count
  rem This cutoff need not be exact.
  Cube = N ** (1 / 3) floor
  Factor = (Cube + 1) * (2 * Cube + 1)
  Last = N // Factor
  rem Sum full rows by their multiplier.
  Levels = 1 to Last copy
  Roots = 8 * (N // Levels) + 1 isqrt
  Ends = (Roots + 1) // 4
  Base = Cube * (Cube - 1)
  Sum = Ends * (Ends - 1) - Base sum
  Sum //= 2
  Tail = N // ((Cube + 1) * (Cube + 2))
  Last = Cube - 1 + Tail
  for I in 1 to Last
    if I less Cube
      Rows = I + 1 to Cube copy
      Sum += N // (Rows * (Rows + I)) sum
    else
      Scale = I - Cube + 1
      Quotient = N // Scale
      Root = 4 * Quotient + 1 isqrt
      End = (Root - 1) // 2
      Root = 8 * Quotient + 1 isqrt
      Start = (Root + 1) // 4 + 1
      Start = Start max (Cube + 1)
      if Start at most End
        Rows = Start to End copy
        Sum += (
          N // (Rows * Scale) - Rows
        ) sum
      end
    end
  end
  return Sum
end

rem Mobius inversion enforces gcd = 1.
Bound = L // 6 isqrt
Mu = Bound mobius
Prefix = Mu scan + copy
rem Split quotients near the cube root.
Split = L ** (1 / 3) floor
Split = Split min Bound
Keys = 1 to Split copy
Large = L // (Keys * Keys)
End = L // ((Split + 1) * (Split + 1))
Small = 6 to End copy
Limits = concat Large Small copy
High = L // Limits isqrt
Low = L // (Limits + 1) isqrt
Weights = Prefix High - Prefix Low
Keep = Weights not equal 0 indices
Limits = Limits Keep
Weights = Weights Keep
Answer = 0
if Limits len greater 0
  Counts = Limits pair_count rank 0
  Answer = (Weights * Counts) sum
end
return Answer
