rem Cuboid Layers
rem https://projecteuler.net/problem=126
rem Find the least layer count that
rem exactly Num cuboid layers share

use sequences
use io
use cli

option Num integer = 1000
option Limit integer = 20000

rem Walk cuboids a <= b <= c and add
rem each layer size to a tally. The next
rem layer is 4 (a + b + c + 2 n - 2)
rem cells larger than layer n.
Cnt = array shape (Limit + 1) fill 0
for A in 1 to Limit
  if 6 * A * A greater Limit
    break
  end
  for B in A to Limit
    if 2 * B * (2 * A + B) greater Limit
      break
    end
    for C in B to Limit
      Val = 2 * (A * B + B * C + C * A)
      Sum = A + B + C
      N = 1
      for Val at most Limit
        Cnt Val += 1
        Val += 4 * (Sum + 2 * N - 2)
        N += 1
      end
      if N equal 1
        break
      end
    end
  end
end
Answer = Cnt first index where equal Num
Answer print
