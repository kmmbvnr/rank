rem abc-hits
rem https://projecteuler.net/problem=127
rem Sum c over triples a + b = c with
rem gcd(a, b) = 1 and rad(abc) < c

use numbers
use sequences
use io
use cli

option Limit integer = 120000

rem Coprime hits satisfy rad(abc) =
rem rad(a) rad(b) rad(c). Sort by rad(a)
rem and stop when even rad(b) = 2 would
rem make the product too large.
Rad = array shape Limit fill 1
for P in primes till Limit
  Rad (P till Limit by P) *= P
end
Ord = (Rad drop 1) argsort

rem Test pairs as they are generated.
rem Compute gcd only after the cheap
rem order and radical-product checks.
Answer = 0
for C in 3 till Limit
  Quota = (C - 1) // (Rad C)
  Bound = Quota // 2
  for Index in Ord
    A = Index + 1
    if Rad A greater Bound
      break
    end
    if A * 2 at least C
      continue
    end
    B = C - A
    if (Rad A) * (Rad B) greater Quota
      continue
    end
    if (A gcd C) equal 1
      Answer += C
    end
  end
end
Answer print
