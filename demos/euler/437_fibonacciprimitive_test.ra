use testing

test "statement checkpoint"
  use "437_fibonacciprimitive" as solve
  Answer = solve 10000
  Answer equal 1480491
end

test "brute force over every residue"
  use "437_fibonacciprimitive" as solve
  Answer = solve 2000
  Answer equal 70549
end

test "primes below one million"
  use "437_fibonacciprimitive" as solve
  Answer = solve 1000000
  Answer equal 9990826718
end
