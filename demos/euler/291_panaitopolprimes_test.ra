use testing

test "default input"
  use "291_panaitopolprimes" as solve
  Answer = solve

  Answer equal 4037526
end

test "small limits"
  use "291_panaitopolprimes" as solve
  Answer = solve 1000000

  Answer equal 175
  Answer = solve 100000000

  Answer equal 1225
  Answer = solve 100000000000

  Answer equal 26516
end

test "strict upper limit"
  use "291_panaitopolprimes" as solve
  Answer = solve 0

  Answer equal 0
  Answer = solve 5

  Answer equal 0
  Answer = solve 6

  Answer equal 1
  Answer = solve 12

  Answer equal 1
  Answer = solve 13

  Answer equal 1
  Answer = solve 14

  Answer equal 2
end
