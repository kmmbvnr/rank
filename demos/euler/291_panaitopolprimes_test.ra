use testing

test "default input"
  use "291_panaitopolprimes"
  run

  Answer equal 4037526
end

test "small limits"
  use "291_panaitopolprimes"
  Limit = 1000000
  run

  Answer equal 175
  Limit = 100000000
  run

  Answer equal 1225
  Limit = 100000000000
  run

  Answer equal 26516
end

test "strict upper limit"
  use "291_panaitopolprimes"
  Limit = 0
  run

  Answer equal 0
  Limit = 5
  run

  Answer equal 0
  Limit = 6
  run

  Answer equal 1
  Limit = 12
  run

  Answer equal 1
  Limit = 13
  run

  Answer equal 1
  Limit = 14
  run

  Answer equal 2
end
