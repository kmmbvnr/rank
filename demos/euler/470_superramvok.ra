rem Super Ramvok
rem https://projecteuler.net/problem=470

use numbers
use sequences
use linalg
use io
use cli

arg N integer = 20

rem Subset indices are face bitmasks.
rem Each new half adds the next face.
fun Bound subset_stats
  Counts = array shape 1 fill 0
  Sums = Counts
  Largest = Counts
  for Face in 1 to Bound
    Size = Counts len
    Extra = array shape Size fill Face
    Counts = concat Counts (Counts + 1)
    Sums = concat Sums (Sums + Face)
    Largest = concat Largest Extra
  end
  return record
    .counts = Counts
    .sums = Sums
    .largest = Largest
  end
end
Width = N + 1

rem h_t = mean max(face, h_(t-1)).
rem Its gains shrink; profit at cost
rem c >= 1 is sum max(gain - c, 0).
rem A mask modulo 2^j keeps the faces
rem <= j, without a threshold table.
fun Bound gain_histograms
  Masks = 1 till 2 ** Bound copy
  Stats = Bound subset_stats
  Counts = Stats .counts
  Sums = Stats .sums
  Sizes = Counts Masks
  Totals = Sums Masks
  Largest = (Stats .largest) Masks
  Powers = 2 ** (0 to Bound copy)
  Groups = Sizes * Width + Largest
  Shape = Width ** 3
  Count = array shape Shape fill 0
  Sum = array shape Shape fill 0.0
  Values = Masks * 0.0
  for Step in 1 to Bound
    Threshold = Values floor min Bound
    Low = Masks mod Powers Threshold
    Below = Counts Low
    Next = Values * Below + Totals
    Next = (Next - Sums Low) / Sizes
    Gain = Next - Values
    Values = Next
    Keys = Gain floor min Bound
    Keys += Groups * Width
    Order = Keys argsort
    Sorted = Keys Order
    Gains = Gain Order
    After = Sorted shift -1 with -1
    Last = Sorted not equal After
    Ends = Last indices
    Cum = (Gains scan +) Ends
    Unique = Sorted Ends
    Lengths = Ends shift 1 with -1
    Count Unique += Ends - Lengths
    Before = Cum shift 1 with 0.0
    Sum Unique += Cum - Before
  end
  Cube = Count reshape Width Width Width
  Real = Sum reshape Width Width Width
  return record
    .counts = Cube
    .sums = Real
  end
end
Histograms = N gain_histograms
CountHist = Histograms .counts
SumHist = Histograms .sums
Costs = 0 to N copy

rem Mean profits over equal-size sets.
fun Faces mean_profits
  Net = array shape Faces Width fill 0.0
  for Size in 1 to Faces
    Rows = CountHist Size (1 to Faces)
    Count = Rows sum axis 0
    Gains = SumHist Size (1 to Faces)
    Sum = Gains sum axis 0
    Count = Count reverse scan + reverse
    Sum = Sum reverse scan + reverse
    Profit = Sum - Costs * Count
    rem Sum of maxima: k C(d+1, k+1).
    Next = Size + 1
    Choices = Faces + 1 binomial Next
    Profit 0 = Size * Choices * 1.0
    Choices = Faces binomial Size
    Net (Size - 1) = Profit / Choices
  end
  return Net
end
rem Birth-death walk on active faces:
rem x_k = a_k + k/d x_(k-1) +
rem (1 - k/d) x_(k+1), with x_0 = 0.
fun Faces super_game
  Sizes = (1 to Faces) * 1.0
  Lower = Sizes (1 till Faces) / Faces
  Lower (Faces - 2) = 1.0
  Upper = Sizes (0 till Faces - 1)
  Upper = 1.0 - Upper / Faces
  Matrix = Sizes * 0 + 1 diag
  Matrix -= Lower diag -1
  Matrix -= Upper diag 1
  Profits = Faces mean_profits
  Values = Matrix solve Profits
  return Values (Faces - 1)
end
Total = 0.0
Sd = Costs * 0.0
for Faces in 4 to N
  Sd = Faces super_game
  Total += Sd sum
end
Answer = Total + 0.5 floor
return record
  .answer = Answer
  .sd = Sd
end
