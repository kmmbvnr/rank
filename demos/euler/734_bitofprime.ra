rem A Bit of Prime
rem https://projecteuler.net/problem=734

use numbers
use sequences
use bits
use io
use cli

arg Nn integer = 10 ** 6
arg Kk integer = 999983
arg Pm integer = 1000000007

rem Over masks of B bits: the subset sum
rem A(S) counts primes inside S, so
rem A(S)^k counts k-tuples whose OR lies
rem in S; Moebius inversion gives the
rem tuples with OR exactly S. Each
rem subset transform is one pass per bit
rem on the array as (hi, bit, lo).
Bw = Nn binary len
Sz = 2 ** Bw
Pz = Nn primesieve
Aa = array shape Sz fill 0
Aa (Pz array) = 1
for J in 0 to Bw - 1
  Hi = Sz // 2 ** (J + 1)
  Lo = 2 ** J
  Cs = Aa reshape Hi 2 Lo
  Zs = Cs scan + axis 1
  Aa = Zs reshape Sz
end
Bb = Aa Kk Pm powmod
for J in 0 to Bw - 1
  Hi = Sz // 2 ** (J + 1)
  Lo = 2 ** J
  Cs = Bb reshape Hi 2 Lo
  X0 = Cs # 0 #
  X1 = (Cs # 1 # - X0) mod Pm
  Ms = stack X0 X1 axis 1
  Bb = Ms reshape Sz
end
Ee = Bb (Pz array)
Answer = Ee sum mod Pm
Answer print
