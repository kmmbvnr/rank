rem A Bit of Prime
rem https://projecteuler.net/problem=734

use numbers
use sequences
use bits
use io
use cli

arg Limit integer = 10 ** 6
arg Count integer = 999983
arg Prime integer = 1000000007

rem Over masks of B bits: the subset sum
rem A(S) counts primes inside S, so
rem A(S)^k counts k-tuples whose OR lies
rem in S; Moebius inversion gives the
rem tuples with OR exactly S. Each
rem subset transform is one pass per bit
rem on the array as (hi, bit, lo).
Bits = Limit binary len
Size = 2 ** Bits
Primes = Limit primesieve
Zeta = array shape Size fill 0
Zeta (Primes array) = 1
for Bit in 0 to Bits - 1
  High = Size // 2 ** (Bit + 1)
  Low = 2 ** Bit
  Cube = Zeta reshape High 2 Low
  Scanned = Cube scan + axis 1
  Zeta = Scanned reshape Size
end
Powers = Zeta Count Prime powmod
for Bit in 0 to Bits - 1
  High = Size // 2 ** (Bit + 1)
  Low = 2 ** Bit
  Cube = Powers reshape High 2 Low
  Without = Cube # 0 #
  Upper = Cube # 1 #
  With = (Upper - Without) mod Prime
  Merged = stack Without With axis 1
  Powers = Merged reshape Size
end
Exact = Powers (Primes array)
return Exact sum mod Prime
