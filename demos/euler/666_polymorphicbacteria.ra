rem Polymorphic Bacteria
rem https://projecteuler.net/problem=666

use numbers
use sequences
use io
use cli

arg Kk integer = 500
arg Mm integer = 10

rem Block i of the sequence r gives the
rem count c(i, q) of each action q for
rem type i. The extinction vector p is
rem the least fixed point of
rem   p_i = (c0 + c1 p_i^2 + c2 p_(2i)
rem     + c3 p_(i^2+1)^3
rem     + c4 p_i p_(i+1)) / m
rem (indices mod k), reached from p = 0
rem by monotone iteration.
Nn = Kk * Mm
Rs = array shape Nn fill 0
Rv = 306
for I in 0 to Nn - 1
  Rs I = Rv
  Rv = Rv * Rv mod 10007
end
Qs = (Rs mod 5) reshape Kk Mm
Ci = 0 to (Kk - 1)
Ia = 2 * Ci mod Kk
Ib = (Ci * Ci + 1) mod Kk
Ic = (Ci + 1) mod Kk
C0 = ((Qs equal 0) integer) sum axis 1
C1 = ((Qs equal 1) integer) sum axis 1
C2 = ((Qs equal 2) integer) sum axis 1
C3 = ((Qs equal 3) integer) sum axis 1
C4 = ((Qs equal 4) integer) sum axis 1
Pp = Ci * 0.0
Df = 1.0
for Df greater 0.0000000000001
  Pa = Pp Ia
  Pb = Pp Ib
  Pc = Pp Ic
  Nw = C0 + C1 * Pp * Pp + C2 * Pa
  Nw = Nw + C3 * Pb * Pb * Pb
  Nw = (Nw + C4 * Pp * Pc) / Mm
  Df = (Nw - Pp) abs max
  Pp = Nw
end
Answer = Pp 0 text ".8f"
Answer print
