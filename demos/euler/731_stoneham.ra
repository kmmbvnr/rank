rem A Stoneham Number
rem https://projecteuler.net/problem=731

use numbers
use sequences
use io
use cli

arg Start integer = 10 ** 16

rem The ten digits from n are
rem floor(10^(n+9) A) mod 10^10, with
rem A = sum 1 / (3^k 10^(3^k)).
rem Terms with 3^k > n + 9 are below 1.
rem For the rest, 10^(n+9-3^k) mod
rem (3^k 10^10) = s gives the quotient
rem s // 3^k (mod 10^10) and a remainder
rem r = s mod 3^k, whose fractions r/3^k
rem add up to a carry c.
Total = (Start + 9) real
Ratio = (Total log) / (3 real log)
Terms = (Ratio floor) integer
Bound = Start + 9
Extra = (3 ** (Terms + 1)) at most Bound
Terms = Terms + (Extra integer)
Index = 1 to Terms
Powers3 = 3 ** Index
Exponents = Start + 9 - Powers3
Modulus = Powers3 * 10 ** 10
Residues = 10 Exponents Modulus powmod
Quotients = Residues // Powers3
Remainders = Residues mod Powers3
Scale = 3 ** (Terms - Index)
Weighted = Remainders * Scale
Numerator = Weighted sum
Carry = Numerator // 3 ** Terms
Whole = Quotients sum
Digits = (Whole + Carry) mod 10 ** 10
return Digits text
