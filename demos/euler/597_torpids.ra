rem Torpids
rem https://projecteuler.net/problem=597

use numbers
use sequences
use io
use cli

option N integer = 13
option L integer = 1800

rem M is the course length in 40 m units.
rem K counts boats from rear to front.
fun N M K w_k
  DistanceSum = N * M - N * (N - 1) // 2
  return (M - K + 1) * 1.0 / DistanceSum
end

rem With m = L / 40 and X uniform, the
rem boat with the largest X^(1/(m-k+1))
rem settles first, with weight
rem (m-k+1) / (n m - n (n-1) / 2). The
rem expected sign Sg(n, m) of the final
rem permutation is the sum over k of
rem that weight times Sg(k, k-1) and
rem Sg(n-k, m-k); Sg(0) = Sg(1) = 1 and
rem Sg(n, n-1) = (-1)^(n-1) Sg(n-1,n-1)
rem and p = (1 + Sg) / 2.
Mm = L // 40
Wd = Mm + 1
Sg = array shape (N + 1) Wd fill 1.0
for Nb in 2 to N
  Bd = Sg (Nb - 1) (Nb - 1)
  Pr = 1 - 2 * ((Nb - 1) mod 2)
  Sg Nb (Nb - 1) = Pr * Bd
  Ks = (1 to Nb) array
  for Mx in Nb to Mm
    Wt = Nb Mx Ks w_k
    Sa = Sg Ks (Ks - 1) rank 0 0
    Sb = Sg (Nb - Ks) (Mx - Ks) rank 0 0
    Su = (Wt * Sa * Sb) sum
    Sg Nb Mx = Su
  end
end
Answer = (1 + Sg N Mm) / 2
Answer = Answer round 10
Answer print
