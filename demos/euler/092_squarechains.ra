rem Square Digit Chains
rem https://projecteuler.net/problem=92
rem Count starting numbers below 10 to
rem the Digits that arrive at 89

use numbers
use sequences
use io
use cli

option Digits integer = 7

rem Ways[s]: digit strings with square
rem sum s, built a digit at a time from
rem shifted copies.
Size = Digits * 81 + 1
Ways = array shape Size fill 0
Ways 0 = 1
Squares = (0 to 9) ** 2
for # in 1 to Digits
  Next = array shape Size fill 0
  for Sq in Squares
    Next += Ways Sq shift
  end
  Ways = Next
end

rem Every chain ends at 1 or in the 89
rem cycle, which never reaches 1.
Last = Size - 1
Start = 0 to Last array
Ends = Start
for # in 1 to 20
  Ds = Ends (array 10 10 10 10) digits
  Ends = (Ds * Ds) sum axis 0
end
Mask = Ends not equal 1
Mask and= Ends greater 0
Answer = (Ways Mask) sum
Answer print
