rem Odd Period Square Roots
rem https://projecteuler.net/problem=64
rem Count continued fractions of sqrt N
rem with odd period

use numbers
use io
use cli

option Limit integer = 10000

rem The period of sqrt N ends when a
rem term reaches 2 * a0. Squares have
rem none.
Answer = 0
for N in 2 to Limit
  Root = N isqrt
  if Root * Root equal N
    continue
  end
  Mid = 0
  Den = 1
  Term = Root
  Len = 0
  for Term not equal 2 * Root
    Mid = Den * Term - Mid
    Den = (N - Mid * Mid) // Den
    Term = (Root + Mid) // Den
    Len += 1
  end
  if Len odd
    Answer += 1
  end
end
Answer print
