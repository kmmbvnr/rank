use testing

rem Small limits keep reference checks practical.
rem The full compiled answer has a separate test.
test "small limits"
  use "272_modularcubes" as solve
  Answer = solve 10000000

  Answer equal 4222148009
  Answer = solve 1000000000

  Answer equal 316174709149021
end

test "first qualifying number"
  use "272_modularcubes" as solve
  Answer = solve 482390

  Answer equal 0
  Answer = solve 482391

  Answer equal 482391
end
