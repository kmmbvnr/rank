rem A Weird Recurrence Relation
rem https://projecteuler.net/problem=463

use numbers
use sequences
use bits
use io
use cli

option N integer = 450283905890997363

rem f(n) reverses the bits of the odd
rem part of n, so S(N) adds rev(u) for
rem odd u <= X = N / 2^j over all j.
rem For odd u of L bits, u = 2v + 1
rem with v >= 2^(L-2): bit b of v is
rem worth 2^(L-2-b) in rev(u), and the
rem low bit of u is worth 2^(L-1).
Md = 1000000000
J = (0 to 60) copy
X = N // (2 ** J)
Ls = (2 to 60) copy
Bs = (0 to 58) copy
P = 2 ** Bs
Hi = X (2 ** Ls - 1) outer min
V0 = 2 ** (Ls - 2)
V1 = ((Hi - 1) // 2) max (V0 - 1)
rem How many v below Y have bit b set.
Y1 = V1 + 1
R1 = Y1 (2 * P - 1) outer band
Q1 = Y1 (Bs + 1) outer shr
D1 = ((R1 - P) max 0) + Q1 * P
R0 = V0 (2 * P - 1) outer band
Q0 = V0 (Bs + 1) outer shr
D0 = ((R0 - P) max 0) + Q0 * P
Wx = (Ls - 2) Bs outer -
Wt = 2 ** (Wx max 0) mod Md
Wt = (Wx at least 0) choose Wt 0
Tt = ((D1 - D0) mod Md) * Wt mod Md
Lt = (V0 * 2 mod Md) * (V1 - V0 + 1)
Answer = Tt sum
Answer += Lt mod Md sum
rem u = 1 for every j with X >= 1.
Answer += (X at least 1) count
Answer = Answer mod Md
Answer print
