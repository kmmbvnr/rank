rem Dice Game
rem https://projecteuler.net/problem=205
rem Find the chance that Peter, rolling
rem Pn four-sided dice, beats Colin,
rem rolling Cn six-sided dice, to seven
rem decimal places

use numbers
use sequences
use io
use cli

option Pn integer = 9
option Cn integer = 6

rem Every die adds each face to every
rem total so far. Counting the totals
rem gives the ways to roll each one.
Mx = (Pn * 4) max (Cn * 6)
V = 0 to Mx array
Hp = V
Hc = V
for G in 0 to 1
  Sides = 4 + 2 * G
  Dice = Pn
  if G equal 1
    Dice = Cn
  end
  Faces = 1 to Sides array
  Tot = array 0
  for D in 1 to Dice
    R = Tot len
    Sum' = (Tot reshape R 1) + Faces
    Tot = Sum reshape (R * Sides)
  end
  Hit' = Tot equal (V reshape (Mx + 1) 1)
  if G equal 0
    Hp = Hit count axis 1
  else
    Hc = Hit count axis 1
  end
end
Vp = V reshape (Mx + 1) 1
Pair' = (Hp reshape (Mx + 1) 1) * Hc
Won' = Pair filter (Vp greater V)
Ways' = Won sum
All = 4 ** Pn * 6 ** Cn
Answer = Ways / All round 7
Answer print
