use testing

test "statement checkpoint"
  use "435_polynomialsfib" as solve
  Answer = solve 20 10
  Answer equal 1044074802100
end

test "small degree sums"
  use "435_polynomialsfib" as solve
  Answer = solve 7 11
  Answer equal 520417062
end

test "default input"
  use "435_polynomialsfib" as solve
  Answer = solve
  Answer equal 252541322550
end
