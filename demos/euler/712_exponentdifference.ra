rem Exponent Difference
rem https://projecteuler.net/problem=712

use numbers
use sequences
use io
use cli

arg Limit integer = 10 ** 12
arg Prime integer = 1000000007

rem Per prime p and level k, a pair has
rem one number divisible by p^k and the
rem other not: 2 q (n - q) pairs with
rem q = n // p^k. S = sum over p, k.
rem Primes up to sqrt(n) take all their
rem powers. Larger ones have k = 1 and
rem are grouped by q = n // p, using
rem prime counts pi(n // q) from a
rem Lucy sieve.
Root = Limit isqrt
Values = 0 to Root
Small = Values - 1
Small 0 = 0
Large = Limit // (Values max 1) - 1
Primes = primes to Root array
for P in Primes
  Before = Small (P - 1)
  Reach = Root min (Limit // (P * P))
  Index = 1 to Reach
  Product = P * Index
  Inside = Product at most Root
  FromLarge = Large (Product min Root)
  Where = Limit // Product min Root
  FromSmall = Small Where
  Low2 = FromLarge
  Chosen = Inside choose Low2 FromSmall
  Delta = Chosen - Before
  Large Index = Large Index - Delta
  Range = P * P to Root
  Parent = Small (Range // P)
  Gap = Parent - Before
  Small Range = Small Range - Gap
end
Count2 = Primes len
Quotient = array shape Count2 fill Limit
Answer = 0
for Quotient max greater 0
  Quotient = Quotient // Primes
  Positive = Quotient greater 0
  Levels = Quotient filter Positive
  Rest = (Limit - Levels) mod Prime
  Part = Levels mod Prime
  Gain = Part * Rest mod Prime
  Answer += Gain sum
end
Quotients = 1 to Limit // (Root + 1)
High = Large Quotients
Next = Limit // (Quotients + 1)
Upper = Large ((Quotients + 1) min Root)
Edge = Small Root
Above = Next greater Root
Low = Above choose Upper Edge
Count = (High - Low) mod Prime
RestQ = (Limit - Quotients) mod Prime
Part2 = Quotients mod Prime
GainQ = Part2 * RestQ mod Prime
Gains = Count * GainQ mod Prime
Answer += Gains sum
Answer = 2 * Answer mod Prime
Answer print
