rem Pseudo Square Root
rem https://projecteuler.net/problem=266
rem Find the largest divisor not above
rem the square root of the product of
rem the primes below Limit, modulo 10^16

use numbers
use sequences
use algo
use io
use cli

arg Limit integer = 190

rem Split the primes in two halves and
rem list their subset products a and b.
rem For each b, binary search finds the
rem largest a not above Root / b.
Ps = primes till Limit array
H = Ps len // 2
Total = Ps reduce *
Root = Total isqrt
A = array 1
for P in Ps take H
  A = concat A (A * P)
end
B = array 1
for P in Ps drop H
  B = concat B (B * P)
end
Sa = A sort
Where = (Sa upperindex (Root // B)) - 1
Ok = Where at least 0
Pick' = Sa (Where filter Ok array)
Mate' = B filter Ok array
Best = (Pick * Mate) max
Answer = Best mod 10000000000000000
Answer print
