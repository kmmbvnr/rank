rem Polynomials of Fibonacci Numbers
rem https://projecteuler.net/problem=435

use numbers
use sequences
use linalg
use io
use cli

arg N integer = 1000000000000000
arg Top integer = 100

rem State (a(k), a(k-1), F(k)) with
rem a(k) = f(k) x^k advances by a
rem 3 x 3 matrix, so F(n) is read off
rem T^(n-1) applied to (x, 0, x).
rem Matrix powers avoid division mod
rem 15!.
Mod = 1307674368000
Tot = 0
for X in 1 to Top
  X2 = X * X
  Fl = array X X2 0 1 0 0 X X2 1
  Tm = Fl reshape 3 3
  Id = array 1 0 0 0 1 0 0 0 1
  Rm = Id reshape 3 3
  Ex = N - 1
  for Ex greater 0
    if Ex mod 2 equal 1
      Rm = Rm matmul Tm mod Mod
    end
    Tm = Tm matmul Tm mod Mod
    Ex //= 2
  end
  V0 = array X 0 X
  Tot += (Rm matmul V0) 2
end
Answer = Tot mod Mod
Answer print
