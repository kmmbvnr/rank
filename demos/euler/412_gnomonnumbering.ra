rem Gnomon Numbering
rem https://projecteuler.net/problem=412

use numbers
use sequences
use io
use cli

arg M integer = 10000
arg K integer = 5000
arg Chunk integer = 4000000

rem Count standard Young tableaux of
rem the gnomon: (M^2 - K^2)! divided
rem by the hook product, which is
rem a ratio of products of factorials
rem t! with a corner block and two
rem arms of width K. Prime modulus,
rem so division is a power.
P = 76543217
Cells = M * M - K * K
rem Wilson gives the shorter product
rem when the factorial stops below P.
Tail = Cells greater (P - 1) // 2
if Cells at least P
  Tail = false
end
Start = 1
Last = Cells
if Tail
  Start = Cells + 1
  Last = P - 1
end
Fact = 1
for Lo in Start to Last by Chunk
  Hi = Last min (Lo + Chunk - 1)
  Part' = Lo to Hi
  Prod = Part reduce * with 1 mod P
  Fact = Fact * Prod mod P
end

if Tail
  Fact = P - Fact (P - 2) P powmod
end

Up' = 1 to 2 * M - 1
Fc = Up scan * with 1 mod P
W = M - K
Sl = Fc (M + K to 2 * M - 1)
An = Sl reduce * with 1 mod P
Sl = Fc (2 * K to M + K - 1)
Ad = Sl reduce * with 1 mod P
Sl = Fc (K to M - 1)
Bn = Sl reduce * with 1 mod P
Sl = Fc (0 to W - 1)
Bd = Sl reduce * with 1 mod P
Den = An * Bn mod P * Bn mod P
Num = Ad * Bd mod P * Bd mod P
Inv = Den (P - 2) P powmod
Answer = Fact * Num mod P * Inv mod P
Answer print
