use testing

test "default input"
  use "011_gridproduct"
  run

  Answer equal 70600674
end

test "horizontal run"
  use "011_gridproduct"
  use sequences
  Grid = array shape 20 20 fill 1
  Grid 4 5 = 2
  Grid 4 6 = 3
  Grid 4 7 = 5
  Grid 4 8 = 7

  Windows = Grid window 4 axis 1
  Windows reduce * rank 1 max equal 210
end

test "vertical run"
  use "011_gridproduct"
  use sequences
  Grid = array shape 20 20 fill 1
  Grid 4 5 = 2
  Grid 5 5 = 3
  Grid 6 5 = 5
  Grid 7 5 = 7

  Windows = Grid window 4 axis 0
  Windows reduce * rank 1 max equal 210
end

test "downward diagonal run"
  use "011_gridproduct"
  use sequences
  use linalg
  Grid = array shape 20 20 fill 1
  Grid 4 5 = 2
  Grid 5 6 = 3
  Grid 6 7 = 5
  Grid 7 8 = 7

  Blocks = Grid window 4 4
  Lines = Blocks diag rank 2
  Lines reduce * rank 1 max equal 210
end

test "upward diagonal run"
  use "011_gridproduct"
  use sequences
  use linalg
  Grid = array shape 20 20 fill 1
  Grid 7 5 = 2
  Grid 6 6 = 3
  Grid 5 7 = 5
  Grid 4 8 = 7

  Blocks = Grid window 4 4
  Lines = Blocks diag .anti rank 2
  Lines reduce * rank 1 max equal 210
end
