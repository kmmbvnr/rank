use testing

test "default input"
  use "011_gridproduct"
  run

  Answer equal 70600674
end

test "horizontal run"
  use "011_gridproduct"
  Grid = array shape 20 20 fill 1
  Grid 4 5 = 2
  Grid 4 6 = 3
  Grid 4 7 = 5
  Grid 4 8 = 7

  Grid greatest_product equal 210
end

test "vertical run"
  use "011_gridproduct"
  Grid = array shape 20 20 fill 1
  Grid 4 5 = 2
  Grid 5 5 = 3
  Grid 6 5 = 5
  Grid 7 5 = 7

  Grid greatest_product equal 210
end

test "downward diagonal run"
  use "011_gridproduct"
  Grid = array shape 20 20 fill 1
  Grid 4 5 = 2
  Grid 5 6 = 3
  Grid 6 7 = 5
  Grid 7 8 = 7

  Grid greatest_product equal 210
end

test "upward diagonal run"
  use "011_gridproduct"
  Grid = array shape 20 20 fill 1
  Grid 7 5 = 2
  Grid 6 6 = 3
  Grid 5 7 = 5
  Grid 4 8 = 7

  Grid greatest_product equal 210
end
