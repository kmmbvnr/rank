rem 10-substrings
rem https://projecteuler.net/problem=529

use numbers
use sequences
use bits
use algo
use io
use cli

arg N integer = 1000000000000000000
arg Sd integer = 10

Prime = 1000000007
Fermat = Prime - 2
Width = Sd + 1
Full = (1 shl Width) - 1
Digits = 0 till 10 copy

rem Small lookup tables replace scans
rem of every bit for each transition.
Masks = 0 to Full copy
Bases = array shape Width fill 2
Binary = Masks digits Bases
Positions = Sd - (0 till Width)
PositionGrid = Positions reshape Width 1
Set = Binary not equal 0
Weighted = Set choose PositionGrid 0
TailSums = Weighted max axis 0
Reverse = Binary reverse
Reversed = Reverse fromDigits Bases

rem Head records potential block starts;
rem Tail records the uncovered suffix.
fun Keys transition Digit
  Head = Keys shr Width
  Tail = Keys band Full
  Sum = TailSums Tail
  Total = Sum + Digit
  Capped = Total min Sd
  Mark = 1 shl Capped
  Added = Tail bor Mark
  Needed = Sd - Capped
  Closed = Head bit Needed
  Shifted = Head shl Capped band Full
  Reflected = Reversed Added shr Needed
  Covered = Shifted bor Reflected
  CloseKey = (Covered shl Width) + 1
  OpenKey = (Head shl Width) + Added
  Next = Closed choose CloseKey OpenKey
  Valid = Total at most Sd
  Missing = -1
  return Valid choose Next Missing
end

rem Breadth-first closure batches all
rem ten digits across the frontier.
fun Work grow
  unpack All Frontier = Work
  Count = Frontier len
  Grid = Frontier reshape Count 1
  Next = Grid transition Digits
  Cells = Count * 10
  Flat = Next reshape Cells
  Valid = Flat at least 0
  Unique = Flat Valid unique
  Fresh = Unique not in All
  Added = Unique Fresh
  All = concat All Added copy
  return tuple All Added
end
fun Before exhausted After
  Frontier = After 1
  return Frontier len equal 0
end
Start = (1 shl Width) + 1
Initial = array Start
Reach = tuple Initial Initial
Bits = 2 * Width
Maximum = 1 shl Bits
Closure = (
  Reach grow repeat Maximum
  till exhausted
)
Keys = Closure 0 sort
States = Keys len
StateCount = States + 1
Cells = States * 10
Grid = Keys reshape States 1
Next = Grid transition Digits
Targets = Keys lowerindex Next
Valid = Next at least 0
Targets = Valid choose Targets States
Flat = Targets reshape Cells
DeadRow = array shape 10 fill States
Transitions = concat Flat DeadRow copy
RawAccept = Keys band Full equal 1
RawAccept = (
  concat RawAccept (array false)
)

rem Refine by the ten successor classes.
fun Work split
  unpack Classes Labels Digit = Work
  End = StateCount * 10
  Picks = Digit till End by 10
  Successors = Transitions Picks
  Following = Classes Successors
  Combined = Labels * StateCount
  Combined = Combined + Following
  Ordered = Combined unique sort
  Labels = Ordered lowerindex Combined
  Digit += 1
  return tuple Classes Labels Digit
end
fun Work refine
  Classes = Work 0
  Columns = tuple Classes Classes 0
  Result = Columns split repeat 10
  Labels = Result 1
  Count = (Labels max) + 1
  return tuple Labels Count
end
fun Before stable After
  return Before 1 equal After 1
end
Initial = RawAccept integer
Groups = tuple Initial 2
Partition = (
  Groups refine repeat StateCount
  till stable
)
Classes = Partition 0
ClassCount = Partition 1
Rows = array shape ClassCount fill 0
Rows Classes = 0 till StateCount copy
Grid = Rows reshape ClassCount 1
Places = Grid * 10 + Digits
Targets = Classes (Transitions Places)
Cells = ClassCount * 10
Table = Targets reshape Cells
Sink = Classes States
Sources = (0 till Cells) // 10
Active = Table not equal Sink
Alive = Sources not equal Sink
Active = Active and Alive
From = Sources Active copy
Into = Table Active copy
Accept = RawAccept Rows integer
StartIndex = Keys lowerindex Start
StartClass = Classes StartIndex
FirstPlaces = StartClass * 10 + (1 to 9)
First = Table FirstPlaces
Needed = 2 * ClassCount + 10
TermCount = Needed min (N + 1)

rem Modular histograms keep counts
rem bounded throughout every DP step.
fun Count terms
  Values = array shape ClassCount fill 0
  Values First += 1 .accumulate
  Values Sink = 0
  Terms = array shape Count fill 0
  Total = 0
  for Length in 1 till Count
    Accepted = Values * Accept sum
    Total = (Total + Accepted) mod Prime
    Terms Length = Total
    Next = array shape ClassCount fill 0
    Counts = Values From
    Next Into += Counts .accumulate
    Values = Next mod Prime
  end
  return Terms
end
Terms = TermCount terms

rem Berlekamp-Massey identifies the
rem shortest exact modular recurrence.
fun Work identify
  Place = Work 0
  Current = Work 1
  Saved = Work 2
  Order = Work 3
  Gap = Work 4
  Last = Work 5
  Difference = Terms Place
  if Order greater 0
    Head = Current (1 to Order)
    Window = Place - Order till Place
    History = Terms Window reverse
    Dot = Head * History mod Prime sum
    Difference += Dot mod Prime
  end
  Next = Place + 1
  if Difference equal 0
    Gap += 1
    return (
      tuple Next Current Saved
      Order Gap Last
    )
  end
  Inverse = Last Fermat Prime powmod
  Scale = Difference * Inverse mod Prime
  Previous = Current
  End = (Saved len) + Gap
  Size = Current len
  if Size less End
    Padding = End - Size
    Zero = array shape Padding fill 0
    Current = concat Current Zero copy
  end
  Change = Scale * Saved mod Prime
  Span = Gap till End
  Current Span -= Change mod Prime
  if 2 * Order at most Place
    Order = Place + 1 - Order
    Saved = Previous
    Last = Difference
    Gap = 1
  else
    Gap += 1
  end
  return (
    tuple Next Current Saved
    Order Gap Last
  )
end
rem Bostan-Mori halves the exponent
rem with exact polynomial convolutions.
fun Work halve
  unpack Top Bottom Power = Work
  Length = Bottom len
  Places = 0 till Length copy
  Signs = 1 - 2 * (Places mod 2)
  Flip = Bottom * Signs mod Prime
  Product = Top convolve Flip mod Prime
  Even = Bottom convolve Flip mod Prime
  Length = Product len
  Parity = Power mod 2
  Picks = Parity till Length by 2
  Top = Product Picks
  Length = Even len
  Picks = 0 till Length by 2
  Bottom = Even Picks
  return tuple Top Bottom (Power // 2)
end
fun Exponent evaluate
  Count = Terms len
  if Exponent less Count
    return Terms Exponent
  end
  One = array 1
  Guess = tuple 0 One One 0 1 1
  Fit = Guess identify repeat Count
  Coefficients = Fit 1
  Degree = Fit 3
  if Degree equal 0
    return 0
  end
  Order = Degree + 1
  Lower = Coefficients take Order
  Upper = Terms take Degree
  Upper = Upper convolve Lower mod Prime
  Upper = Upper take Degree
  Fraction = tuple Upper Lower Exponent
  Iterations = Exponent binary len
  Result = (
    Fraction halve repeat Iterations
  )
  Top = Result 0
  Bottom = Result 1
  Value = Bottom 0
  Inverse = Value Fermat Prime powmod
  return Top 0 * Inverse mod Prime
end
Answer = N evaluate
rem Include the endpoint 10^N when
rem its digit sum is the target too.
if Sd equal 1
  Answer = (Answer + 1) mod Prime
end
return Answer
