rem Look and Say
rem https://projecteuler.net/problem=419

use numbers
use sequences
use linalg
use text
use io
use cli

option N integer = 1000000000000

rem Conway's 92 atoms: each term
rem splits into atoms that evolve
rem on their own. Pairs lists, for
rem every atom, the atoms it decays
rem into; Dg counts the digits 1, 2
rem and 3 in each atom. Term 8 is
rem the atoms 0 and 1. The table was
rem found by splitting look-and-say
rem strings where ten further
rem generations stay independent.
Mod = 1073741824

Pt = array shape 36 8
   0  2  1  3  2  4  3  5
   4  6  5  7  6  8  6  9
   6 10  7 11  8 12  8 13
   9 14 10 15 11 16 12 17
  13 18 14 19 15 20 16 12
  16 21 17 22 18 23 19 24
  20 25 20 26 21 27 21  9
  21 28 22 12 22 29 23 30
  24 31 25 32 26 33 27 34
  28 35 29 27 29  9 29 10
  30 36 30 37 30  9 30 10
  31 38 32 39 33 40 34 13
  34  9 34 41 35 42 36 43
  37 37 38 12 38 26 39 44
  40 13 40 45 41 46 42  8
  42 47 43 48 44 12 44 49
  44 37 44  9 44 10 45 50
  46 51 47 52 47 37 47  9
  47 28 48 53 49 54 50 55
  51 41 51 10 52 56 52 57
  53 58 54 59 55 60 56 61
  57 49 58 12 58 62 59 63
  60 64 61 65 62 27 62  9
  62 66 63 67 64 68 65 69
  66 13 66  1 67 70 68 71
  69 72 70 12 70 73 71 74
  72 75 73 76 74 77 74  9
  74 78 75 77 75 45 76 79
  77 12 77 80 78 81 79 13
  79 82 80 27 80  9 80 59
  80 37 80  9 80 41 81  0
  81 49 81 37 81  9 81 78
  82 83 83 84 84 85 85 86
  86 87 87 88 88 89 89 77
  89  9 89 90 90 91 91  0
  91 49 91 37 91  9 91 90
end

Dg = array shape 23 12
   3  1  1  3  1  1  3  1  2  5  2  1
   6  2  2  6  2  2  8  3  3  5  5  2
   4  3  2  1  1  0  2  2  1 11  4  3
   3  2  2  1  1  1  3  1  0  4  3  1
  13  7  4  7  3  2  4  1  1  2  1  1
   7  4  1 10  7  4  9  4  3  5  1  2
   3  2  1  2  1  2  3  3  1  3  3  1
   6  6  3  5  3  3  5  2  3  6  3  1
   4  2  2  5  4  1  2  1  3 10  6  4
   4  0  1  0  2  0  6  4  2  9  3  2
   4  3  3  1  1  1 15  8  5  4  0  2
   8  4  4  3  5  1  4  1  1 10  9  4
   4  2  2  1  0  1  6  4  2  5  1  2
   4  1  2  9  3  2  3  0  1  6  6  2
   4  2  1  0  0  1 10  5  3  2  0  2
   8  7  3  5  4  1  6  4  3  3  1  2
  11 11  2  7  6  1  3  3  1  6  2  2
  13 10  5  8  5  3  6  3  3 13 17  4
   8  9  3  3  2  2 20 14  8 13  8  5
   5  3  2 11  8  4 10 14  3  4  2  4
   6  6  5 14 12  6  3  4  2  6  3  3
   6  5  3  8  6  4 11 10  3 13  9  6
  13 16  5 20 13  9 10 13  4 14 11  7
end

Pd = Pt reshape 144 2
Dt = Dg reshape 92 3
Mx = array shape 92 92 fill 0
for I in 0 to 143
  Mx (Pd I 0) (Pd I 1) += 1
end
fun X mm Y
  Hi = X // 32768
  Lo = X mod 32768
  R = (Hi matmul Y) mod 1073741824
  R = R * 32768 + (Lo matmul Y)
  return R mod 1073741824
end
Vc = array shape 92 fill 0
Vc 0 = 1
Vc 1 = 1
Pw = Mx
Ex = N - 8
for Ex greater 0
  if Ex mod 2 equal 1
    Vc = Vc mm Pw
  end
  Pw = Pw mm Pw
  Ex //= 2
end
Cn = Vc mm Dt
C0 = Cn 0 text
C1 = Cn 1 text
C2 = Cn 2 text
Parts = array C0 C1 C2
Answer = Parts join ","
Answer print
