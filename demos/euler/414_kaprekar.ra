rem Kaprekar Constant
rem https://projecteuler.net/problem=414

use numbers
use sequences
use io
use cli

arg First integer = 2
arg Last integer = 300
arg Mod integer = 1000000000000000000

rem Sorted digits need two differences:
rem u = x4 - x0 and v = x3 - x1.
rem Count strings by these differences,
rem then memoize paths to the constant.
rem Only 0 <= v <= u needs storage.
Total = 0
for K in First to Last
  Base = 6 * K + 3
  Third = Base // 3
  Fixed = 2 * Third
  Sum = 0
  Size = Base * (Base + 1) // 2
  Steps = (0 till Size) * 0 copy
  Path = (0 till 8192) * 0 copy
  Center = Fixed * (Fixed + 1) // 2
  Steps (Center + Third) = 1
  for Outer in 1 to Base - 1
    for Inner in 0 to Outer
      Row = Outer * (Outer + 1) // 2
      State = Row + Inner
      if Steps State equal 0
        X = Outer
        Y = Inner
        Count = 0
        Next = State
        rem Greatest digit: Base - 1.
        for Steps Next equal 0
          Path Count = Next
          Count += 1
          Low = (Base - X) min X
          High = (Base - X) max X
          if Y greater 0
            Left = Base - 1 - Y
            Right = Y - 1
            Small = Left min Right
            Large = Left max Right
            Mid = Low max Small
            Middle = High min Large
            Mid = Mid min Middle
            Low = Low min Small
            X = Base - 1 - Low
            Y = (High max Large) - Mid
          else
            Left = Base - X
            Right = X - 1
            Low = Left min Right
            High = Left max Right
            X = Base - 1 - Low
            Y = Base - 1 - High
          end
          Next = X * (X + 1) // 2 + Y
        end
        Depth = Steps Next
        for J in 1 to Count
          Previous = Path (Count - J)
          Steps Previous = Depth + J
        end
      end
      Weight = 100 + 120 * (Inner - 1)
      Gap = Outer - Inner - 1
      Weight += 120 * Inner * Gap
      if Outer equal Inner
        Weight = 20 + 30 * (Outer - 1)
      end
      if Inner equal 0
        Weight = 10 + 20 * (Outer - 1)
      end
      Distance = Steps State
      Ways = Weight * (Base - Outer)
      Term = Ways * Distance
      Sum = (Sum + Term) mod Mod
    end
  end
  Total += ((Sum - 1) mod Mod)
end
Answer = Total mod Mod
Answer print
