rem Geoboard Shapes
rem https://projecteuler.net/problem=514

use numbers
use sequences
use io
use cli

arg N integer = 100

rem 2 E[area] = sum over oriented
rem edges u -> v of (u x v) times the
rem chance it is a hull edge: u, v
rem chosen, nothing right of the line
rem or beyond u, v on it, something
rem left. Per primitive direction,
rem sort the points by (line, place)
rem and sum pairs by prefix sums.
rem Centred coordinates: the four
rem rotations give equal shares.
Np = N + 1
P = 1.0 / Np
Q = 1.0 - P
Qp = Q ** ((0 to Np * Np) copy)
Ix = (0 till Np * Np) copy
X = Ix // Np
Y = Ix mod Np
Xc = X - N / 2.0
Yc = Y - N / 2.0
Tl = Np * Np
Tot = 0.0
rem Sn: below every line value.
Sn = -999999
for Dx in 1 to N
  for Dy in 0 to N
    if (Dx gcd Dy) equal 1
      S = Dy * X - Dx * Y
      T = Dx * X + Dy * Y
      Od = (S * 100000 + T) argsort
      Ss = S Od
      Ps = (0 till Tl) copy
      Pv = Ss shift 1 with Sn
      Nw = Ss not equal Pv
      St = (Nw choose Ps 0) scan max
      Nx = Ss shift -1 with Sn
      Ne = Ss not equal Nx
      Nr = Ne reverse
      Sr = (Nr choose Ps 0) scan max
      En = Tl - 1 - (Sr reverse)
      I = Ps - St
      K = En - St + 1
      Xs = Xc Od
      Ys = Yc Od
      Wx = (Qp I) * Xs
      Wy = (Qp I) * Ys
      Cx = (Wx scan +) - Wx
      Cy = (Wy scan +) - Wy
      Ax = Cx - Cx St
      By = Cy - Cy St
      Cr = Ys * Ax - Xs * By
      Cj = (Qp (K - 1 - I)) * Cr
      Rt = Qp (Tl - (St + K))
      Lf = Rt * (1.0 - Qp St)
      Tot += (Cj * Lf) sum
    end
  end
end
Answer = (2.0 * P * P * Tot) round 5
Answer print
