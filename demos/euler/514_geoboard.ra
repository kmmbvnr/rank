rem Geoboard Shapes
rem https://projecteuler.net/problem=514

use numbers
use sequences
use io
use cli

arg N integer = 100

rem Group hull edges by primitive
rem direction and supporting line.
rem A line of K pins contributes
rem F(K) = sum g(K-g) Q^(K-1-g).
rem Its cross product is constant
rem per unit gap along the line.
rem Count pins on each line directly;
rem no point sorting is needed.
Np = N + 1
Tl = Np * Np
P = 1.0 / Np
Q = 1.0 - P
Qp = Q ** (0 to Tl copy)
F = array shape (Np + 1) fill 0.0
for K in 2 to Np
  V = 0.0
  for G in 1 till K
    V += G * (K - G) * Qp (K - 1 - G)
  end
  F K = V
end

rem Each line starts on the bottom
rem or left strip of the square.
fun Dx direction Dy
  Hi = N * (Dx + Dy)
  Ks = array shape (Hi + 1) fill 0
  for X in 0 to N
    Ym = Dy - 1
    if X less Dx
      Ym = N
    end
    for Y in 0 to Ym
      K = (N - X) // Dx + 1
      if Dy greater 0
        K = K min ((N - Y) // Dy + 1)
      end
      S = Dy * X - Dx * Y + N * Dx
      Ks S = K
    end
  end
  rem St pins precede the line;
  rem Tl-St-K follow it.
  St = 0
  V = 0.0
  for S in 0 to Hi
    K = Ks S
    if K greater 1
      Sc = S - Hi / 2.0
      Rt = Qp (Tl - St - K)
      Lf = Rt * (1.0 - Qp St)
      V += Sc * (F K) * Lf
    end
    St += K
  end
  return V
end

Tot = 0.0
for Dx in 1 to N
  for Dy in 0 to N
    if Dx gcd Dy equal 1
      Tot += Dx direction Dy
    end
  end
end
return 2.0 * P * P * Tot round 5
