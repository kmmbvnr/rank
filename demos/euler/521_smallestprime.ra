rem Smallest prime factor
rem https://projecteuler.net/problem=521

use numbers
use sequences
use algo
use io
use cli

arg N integer = 1000000000000

Mod = 1000000000
Root = N isqrt
Small = 0 to Root copy
Indices = 1 to Root copy
Large = concat (array 0) (N // Indices)
rem Halve before multiplying modulo Mod.
fun Values triangle
  Even = Values mod 2 equal 0
  Half = Values // 2
  Left = Even choose Half Values
  Next = Values + 1
  Right = Even choose Next (Next // 2)
  Left = Left mod Mod
  Right = Right mod Mod
  Total = Left * Right
  return (Total - 1) mod Mod
end
LowCount = Small - 1 max 0
HighCount = Large - 1 max 0
LowSum = Small triangle
HighSum = Large triangle
LowSum 0 = 0
HighSum 0 = 0
rem Correct the floating cube-root seed.
Seed = N ** (1.0 / 3.0) floor
Candidates = Seed - 1 to Seed + 2 copy
Cubes = Candidates ** 3
Allowed = Candidates (Cubes at most N)
Cube = Allowed max
Answer = 0
rem Lucy's sieve removes composites
rem whose least prime factor is Prime.
for Prime in primes to Cube
  Square = Prime * Prime
  BeforeCount = LowCount (Prime - 1)
  BeforeSum = LowSum (Prime - 1)
  Count = HighCount Prime - BeforeCount
  Answer += Prime * Count mod Mod
  Limit = Root min (N // Square)
  Split = Root // Prime min Limit
  if Split greater 0
    Last = Split * Prime
    Slots = Prime to Last by Prime
    Counts = HighCount Slots
    Counts = Counts - BeforeCount
    HighCount (1 to Split) -= Counts
    Delta = HighSum Slots - BeforeSum
    Delta = Delta * Prime mod Mod
    Slots = 1 to Split
    Values = HighSum Slots - Delta
    HighSum Slots = Values mod Mod
  end
  if Limit greater Split
    Indices = Split + 1 to Limit copy
    Indices = N // (Indices * Prime)
    Counts = LowCount Indices
    Counts = Counts - BeforeCount
    Slots = Split + 1 to Limit
    HighCount Slots -= Counts
    Delta = LowSum Indices - BeforeSum
    Delta = Delta * Prime mod Mod
    Values = HighSum Slots - Delta
    HighSum Slots = Values mod Mod
  end
  if Square at most Root
    Indices = (Square to Root) // Prime
    Counts = LowCount Indices
    Counts = Counts - BeforeCount
    Slots = Square to Root
    LowCount Slots -= Counts
    Delta = LowSum Indices - BeforeSum
    Delta = Delta * Prime mod Mod
    Values = LowSum Slots - Delta
    LowSum Slots = Values mod Mod
  end
end
rem Above Cube, all source values are
rem final. Only the sum at N is needed;
rem do not expand unused (index, prime)
rem pairs to update the entire table.
Primes = primes from Cube + 1 to Root
Primes = Primes array
Counts = HighCount Primes
Counts = Counts - LowCount (Primes - 1)
Terms = Primes * (Counts mod Mod)
Answer += Terms mod Mod sum
Sums = HighSum Primes
Sums = Sums - LowSum (Primes - 1)
Terms = Sums * Primes mod Mod
Correction = Terms sum
if N greater 1
  Answer += HighSum 1 - Correction
  Answer = Answer mod Mod
else
  Answer = 0
end
Answer print
