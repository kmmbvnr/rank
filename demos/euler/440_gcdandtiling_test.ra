use testing

test "statement values"
  use "440_gcdandtiling" as solve
  Answer = solve 2
  Answer equal 10444
  Answer = solve 3
  Answer equal 862246950
  Answer = solve 4
  Answer equal 670616280
end

test "six terms"
  use "440_gcdandtiling" as solve
  Answer = solve 6
  Answer equal 509791024
end

test "empty and singleton bounds"
  use "440_gcdandtiling" as solve
  Answer = solve 0
  Answer equal 0
  Answer = solve 1
  Answer equal 10
end

test "default bound"
  use "440_gcdandtiling" as solve
  Answer = solve 2000
  Answer equal 970746056
end
