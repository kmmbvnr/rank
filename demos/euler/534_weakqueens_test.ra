use testing

test "statement value and brute force"
  use "534_weakqueens"
  N = 4
  run
  Answer equal 276
  N = 5
  run
  Answer equal 3347
end

test "small and impossible fronts"
  use "534_weakqueens"
  N = 1
  run
  Answer equal 1
  N = 2
  run
  Answer equal 4
  N = 3
  run
  Answer equal 29
end
