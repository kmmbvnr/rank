use testing

test "statement value and brute force"
  use "534_weakqueens" as solve
  Answer = solve 4
  Answer equal 276
  Answer = solve 5
  Answer equal 3347
end

test "small and impossible fronts"
  use "534_weakqueens" as solve
  Answer = solve 1
  Answer equal 1
  Answer = solve 2
  Answer equal 4
  Answer = solve 3
  Answer equal 29
end
