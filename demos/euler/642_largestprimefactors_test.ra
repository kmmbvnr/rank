use testing

test "statement values"
  use "642_largestprimefactors" as solve
  Answer = solve 10
  Answer equal 32
  Answer = solve 100
  Answer equal 1915
  Answer = solve 10000
  Answer equal 10118280
end

test "a larger cutoff"
  use "642_largestprimefactors" as solve
  Answer = solve 1000000000
  Answer equal 895017934
end
