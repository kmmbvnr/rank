rem Pythagorean Tree
rem https://projecteuler.net/problem=395

use numbers
use algo
use io

Tol = 0.000000000001
MinX = -1.0 support 0.0
MaxX = 1.0 support 0.0
MinY = 0.0 support -1.0
MaxY = 0.0 support 1.0
Answer = (MaxX + MinX) * (MaxY + MinY)
Answer = Answer round 10
Answer print

fun DX support DY
  Work = new heap .descending
  Item = array 0.0 DX DY
  Norm = (DX * DX + DY * DY) ** 0.5
  Work (5.0 * Norm) Item enqueue
  Best = -10.0
  for Work len greater 0
    unpack Off X Y = Work pop
    Here = 0.0
    Here = Here max X
    Here = Here max Y
    Here = Here max (X + Y)
    Best = Best max (Off + Here)
    Norm = (X * X + Y * Y) ** 0.5
    U = Off + 5.0 * Norm
    if U at most Best + Tol
      continue
    end
    A = 0.64 * X + 0.48 * Y
    B = -0.48 * X + 0.64 * Y
    V = Off + Y
    U = V + 5.0 * (A * A + B * B) ** 0.5
    if U greater Best + Tol
      Item = array V A B
      Work U Item enqueue
    end
    A = 0.36 * X - 0.48 * Y
    B = 0.48 * X + 0.36 * Y
    V = Off + 0.64 * X + 1.48 * Y
    U = V + 5.0 * (A * A + B * B) ** 0.5
    if U greater Best + Tol
      Item = array V A B
      Work U Item enqueue
    end
  end
  return Best
end
