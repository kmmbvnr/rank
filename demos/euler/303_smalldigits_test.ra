use testing

test "smallest multiples"
  use "303_smalldigits"

  2 smallest equal 2
  3 smallest equal 12
  7 smallest equal 21
  42 smallest equal 210
  9999 smallest equal 11112222222222222222
end

test "published sum"
  use "303_smalldigits" as solve
  Answer = solve 100

  Answer equal 11363107
end
