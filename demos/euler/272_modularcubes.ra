rem Modular Cubes, part 2
rem https://projecteuler.net/problem=272
rem Let C(n) count the x with 1 < x < n
rem and x^3 = 1 mod n. Find the sum of
rem the n up to Limit with C(n) = 242

use numbers
use sequences
use io
use cli

arg Limit integer = 100000000000

rem x^3 = 1 mod n has 3^t solutions,
rem where t counts the primes of n with
rem p = 1 mod 3 plus one when 9 divides
rem n, and 242 = 3^5 - 1 is for t = 5.
rem So n is a number u with exactly 5,
rem or 4 when 9 divides n, such primes,
rem each to any power, times v, a number
rem of 2 and primes p = 2 mod 3, and a
rem power of 3, which is 1 or 3 in the
rem first case and at least 9 in the
rem other. With A the product of the
rem distinct primes, u = A f with f made
rem of the same primes, and the v up to
rem Limit / u are summed from tables,
rem the sums of the numbers of 2 and
rem primes = 2 mod 3 with the powers of
rem 3 added. A is found by loops over
rem primes one inside the other.
rem Factor 9 out of mode 1. The smallest
rem base is 9 * 7 * 13 * 19 * 31.
Mm = Limit // 482391
Pm = Limit // 15561 + 10
Ps = primes till Pm
P1 = Ps filter (Ps mod 3 equal 1) array
Np = P1 len
Good = array shape (Mm + 1) fill 1
Good 0 = 0
for P in Ps
  if P greater Mm
    break
  end
  if P mod 3 less 2
    for J in P to Mm by P
      Good J = 0
    end
  end
end
Pre = array shape (Mm + 1) fill 0
Run = 0
for I in 1 to Mm
  if Good I equal 1
    Run += I
  end
  Pre I = Run
end
Va = array shape (Mm + 1) fill 0
Vb = array shape (Mm + 1) fill 0
for I in 1 to Mm
  Va I = Pre I + 3 * Pre (I // 3)
  rem Mode 1 keeps the remaining powers of 3.
  Pw = 1
  Sb = 0
  for
    if Pw greater I
      break
    end
    Sb += Pw * Pre (I // Pw)
    Pw = Pw * 3
  end
  Vb I = Sb
end
PrimeSum = array shape (Np + 1) fill 0
for I in 0 till Np
  PrimeSum (I + 1) = PrimeSum I + P1 I
end
Fl = array shape 400 fill 0
Fp = array shape 5 fill 1
Total = 0
for Mode in 0 to 1
  Vt = Va
  Lim = Limit
  if Mode equal 1
    Vt = Vb
    Lim = Limit // 9
  end
  for I1 in 0 till Np
    if I1 + 4 - Mode at least Np
      break
    end
    Minimum = P1 I1
    for Next in 1 to (4 - Mode)
      Minimum = Minimum * P1 (I1 + Next)
    end
    if Minimum greater Lim
      break
    end
    Fp 0 = P1 I1
    A1 = P1 I1
    for I2 in (I1 + 1) till Np
      if I2 + 3 - Mode at least Np
        break
      end
      Minimum = A1 * P1 I2
      for Next in 1 to (3 - Mode)
        Minimum = Minimum * P1 (I2 + Next)
      end
      if Minimum greater Lim
        break
      end
      Fp 1 = P1 I2
      A2 = A1 * P1 I2
      for I3 in (I2 + 1) till Np
        if I3 + 2 - Mode at least Np
          break
        end
        Minimum = A2 * P1 I3
        for Next in 1 to (2 - Mode)
          Minimum = Minimum * P1 (I3 + Next)
        end
        if Minimum greater Lim
          break
        end
        Fp 2 = P1 I3
        A3 = A2 * P1 I3
        rem Below cofactor 7 no selected prime
        rem can recur. Sum the last prime by
        rem quotient intervals instead of visits.
        if Mode equal 1
          for Qb in 1 to 6
            Low = (Lim // (A3 * (Qb + 1))) max (P1 I3)
            High = Lim // (A3 * Qb)
            Left = 0
            Right = Np
            for Left less Right
              Mid = (Left + Right) // 2
              if P1 Mid at most Low
                Left = Mid + 1
              else
                Right = Mid
              end
            end
            Start = Left
            Right = Np
            for Left less Right
              Mid = (Left + Right) // 2
              if P1 Mid at most High
                Left = Mid + 1
              else
                Right = Mid
              end
            end
            if Left greater Start
              Total += 9 * A3 * (Vt Qb) * (PrimeSum Left - PrimeSum Start)
            end
          end
        end
        for I4 in (I3 + 1) till Np
          if Mode equal 1 and A3 * P1 I4 greater Lim // 7
            break
          end
          if I4 + 1 - Mode at least Np
            break
          end
          Minimum = A3 * P1 I4
          for Next in 1 to (1 - Mode)
            Minimum = Minimum * P1 (I4 + Next)
          end
          if Minimum greater Lim
            break
          end
          Fp 3 = P1 I4
          A4 = A3 * P1 I4
          Lo5 = I4 + 1
          Hi5 = Np - 1
          if Mode equal 1
            Lo5 = 0
            Hi5 = 0
          end
          rem The same tail for five-prime bases.
          if Mode equal 0
            for Qb in 1 to 6
              Low = (Lim // (A4 * (Qb + 1))) max (P1 I4)
              High = Lim // (A4 * Qb)
              Left = 0
              Right = Np
              for Left less Right
                Mid = (Left + Right) // 2
                if P1 Mid at most Low
                  Left = Mid + 1
                else
                  Right = Mid
                end
              end
              Start = Left
              Right = Np
              for Left less Right
                Mid = (Left + Right) // 2
                if P1 Mid at most High
                  Left = Mid + 1
                else
                  Right = Mid
                end
              end
              if Left greater Start
                Total += 1 * A4 * (Vt Qb) * (PrimeSum Left - PrimeSum Start)
              end
            end
          end
          for I5 in Lo5 to Hi5
            if Mode equal 0 and A4 * P1 I5 greater Lim // 7
              break
            end
            P5 = P1 I5
            if Mode equal 1
              P5 = 1
            end
            Fp 4 = P5
            A5 = A4 * P5
            if A5 greater Lim
              break
            end
            M = Lim // A5
            Sm = 0
            if M less 7
              Sm = Vt M
            else
              Fl 0 = 1
              Nf = 1
              for K in 0 to 4
                Pk = Fp K
                if Pk greater 1
                  Old = Nf
                  for L in 0 till Old
                    Cur = Fl L * Pk
                    for
                      if Cur greater M
                        break
                      end
                      Fl Nf = Cur
                      Nf += 1
                      Cur = Cur * Pk
                    end
                  end
                end
              end
              for L in 0 till Nf
                Fq = Fl L
                Sm += Fq * Vt (M // Fq)
              end
            end
            if Mode equal 1
              Sm = 9 * Sm
            end
            Total += A5 * Sm
          end
        end
      end
    end
  end
end
Answer = Total
Answer print
