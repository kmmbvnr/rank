rem Bounded Sequences
rem https://projecteuler.net/problem=319

use numbers
use io
use cli

arg N integer = 10000000000
arg Limit integer = 4641589

Mod = 1000000000
Mu = array shape (Limit + 1) fill 2
Mu 0 = 0
Mu 1 = 1
PrimeSize = Limit // 2 + 1
Pr = array shape PrimeSize fill 0
Cnt = 0
for I in 2 to Limit
  if Mu I equal 2
    Pr Cnt = I
    Cnt += 1
    Mu I = -1
  end
  for J in 0 till Cnt
    V = I * Pr J
    if V greater Limit
      break
    end
    if I mod (Pr J) equal 0
      Mu V = 0
      break
    end
    Mu V = -(Mu I)
  end
end
for I in 1 to Limit
  Mu I += Mu (I - 1)
end
rem Dependencies have larger cache slots.
Top = N // (Limit + 1)
Cache = array shape (Top + 1) fill 0
for Slot in Top to 1 by -1
  X = N // Slot
  Total = 1
  Left = 2
  for Left at most X
    Q = X // Left
    Right = X // Q
    Part = 0
    if Q at most Limit
      Part = Mu Q
    else
      Part = Cache (N // Q)
    end
    Total -= (Right - Left + 1) * Part
    Left = Right + 1
  end
  Cache Slot = Total
end
Answer = 1
Before = 0
L = 1
for L at most N
  Q = N // L
  R = N // Q
  Current = R coeff
  A = Current - Before
  M = 0
  if Q at most Limit
    M = Mu Q
  else
    M = Cache (N // Q)
  end
  Answer = (Answer + A * M) mod Mod
  Before = Current
  L = R + 1
end
Answer print

fun M coeff
  if M at most 0
    return 0
  end
  Mod = 1000000000
  Twice = 2 * Mod
  P3 = 3 (M + 1) Twice powmod
  S3 = (P3 - 3) mod Twice
  S3 //= 2
  P2 = 2 (M + 1) Mod powmod
  S2 = (P2 - 2) mod Mod
  return (S3 - S2 - M) mod Mod
end

rem X must be a quotient N // K.
fun X mertens
  if X at most Limit
    return Mu X
  end
  return Cache (N // X)
end
