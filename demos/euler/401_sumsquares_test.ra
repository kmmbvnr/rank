use testing

test "statement values"
  use "401_sumsquares" as solve
  Answer = solve 6
  Answer equal 113
  Answer = solve 4
  Answer equal 37
end

test "reference value"
  use "401_sumsquares" as solve
  Answer = solve 1000
  Answer equal 401382971
end

test "multiple chunks of the root range"
  use "401_sumsquares" as solve
  Answer = solve 2000000000000
  Answer equal 679233331
end
