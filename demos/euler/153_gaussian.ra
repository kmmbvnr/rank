rem Investigating Gaussian Integers
rem https://projecteuler.net/problem=153
rem Sum the real parts of the Gaussian
rem divisors with positive real part of
rem every n up to a limit

use numbers
use sequences
use io
use cli

arg Limit integer = 100000000

rem S = T(N) + 2 C where T(x) is the
rem sum of d floor(x / d) and C sums
rem a T(N / (a^2 + b^2)) over coprime
rem a, b >= 1. Mobius turns C into
rem sums of H(M) over all pairs, and
rem H(M) = sum of sigma(m) L(M / m),
rem L(x) being the sum of a over
rem a^2 + b^2 <= x. Cut m at its root
rem so each sum has O(sqrt) terms.

rem T(x) by the hyperbola method.
fun X divsum
  S = X
  Y = (S + 1) // 2
  for Y less S
    S = Y
    Y = (S + X // S) // 2
  end
  Tot = 0
  for K in 1 to S
    Q = X // K
    Tot += K * Q + Q * (Q + 1) // 2
  end
  return Tot - S * (S * (S + 1) // 2)
end

rem L(x): walk b down as a goes up.
fun X lattice
  Tot = 0
  if X greater 1
    B = X - 1
    Y = (B + 1) // 2
    for Y less B
      B = Y
      Y = (B + (X - 1) // B) // 2
    end
    A = 1
    for B at least 1
      if A * A + B * B greater X
        B -= 1
      else
        Tot += A * B
        A += 1
      end
    end
  end
  return Tot
end

Root = Limit isqrt
Mu = array shape (Root + 1) fill 1
for P in primes to Root
  Mu (P to Root by P) *= -1
  if P * P at most Root
    Mu (P * P to Root by P * P) = 0
  end
end
Sig = array shape (Root + 1) fill 0
for D in 1 to Root
  Sig (D to Root by D) += D
end
Coprime = 0
for D in 1 to Root
  if Mu D not equal 0
    M = Limit // (D * D)
    Z = M isqrt
    H = 0
    for K in 1 to Z
      H += Sig K * (M // K lattice)
    end
    Lo = Z divsum
    for V in M // (Z + 1) to 1 by -1
      Hi = (M // V) divsum
      H += (V lattice) * (Hi - Lo)
      Lo = Hi
    end
    Coprime += Mu D * D * H
  end
end
Total = Limit divsum
Answer = Total + 2 * Coprime
Answer print
