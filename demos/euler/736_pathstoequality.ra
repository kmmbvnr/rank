rem Paths to Equality
rem https://projecteuler.net/problem=736

use numbers
use sequences
use io
use cli

arg Max integer = 98
arg Least integer = 2
arg Step integer = 2

rem A word of m steps with R letters r
rem and S letters s ends at x = y
rem exactly when D = x 2^(S-b) -
rem y 2^(R-a) hits 0
rem after a r's and b s's. Starting at
rem (45, 90), r adds 2^(S-b) to D and s
rem subtracts 2^(R-a). The number of
rem completions from (rr, ss, D) is
rem memoised (saturating at 2); states
rem outside the reachable interval count
rem 0. Lengths run in order (Lo, Sp: the
rem odd path lengths are even step
rem counts); the first unique word is
rem replayed to get the final value.
memo Packed cnt Diff
  Reds = Packed // 128
  Blues = Packed mod 128
  if Reds equal 0 and Blues equal 0
    return (Diff equal 0) integer
  end
  PowR = 2 ** Reds
  PowB = 2 ** Blues
  Floor = Diff + Reds - Blues * PowR
  Ceil = Diff + Reds * PowB - Blues
  if Floor greater 0 or Ceil less 0
    return 0
  end
  Count = 0
  if Reds greater 0
    Child = (Reds - 1) * 128 + Blues
    Next = Diff + 2 ** Blues
    Count = Child cnt Next
  end
  if Blues greater 0 and Count less 2
    Child = Reds * 128 + Blues - 1
    Next = Diff - 2 ** Reds
    Count += Child cnt Next
  end
  return Count min 2
end
Lengths = Least to Max by Step
Splits = 0 to Max
Total = Lengths len
LengthCol = Lengths reshape Total 1
GridLen = LengthCol + Splits * 0
GridR = LengthCol * 0 + Splits
Valid = GridR at most GridLen
FlatLen = (GridLen filter Valid) array
FlatR = (GridR filter Valid) array
Found = 0
BestR = 0
BestS = 0
for Index in 0 to FlatLen len - 1
  Reds = FlatR Index
  Blues = FlatLen Index - Reds
  Start = 45 * 2 ** Blues
  Diff = Start - 90 * 2 ** Reds
  Count = Reds * 128 + Blues cnt Diff
  if Count equal 1
    Found = 1
    BestR = Reds
    BestS = Blues
    break
  end
end
ValueX = 45
ValueY = 90
Reds = BestR
Blues = BestS
Diff = 45 * 2 ** Blues - 90 * 2 ** Reds
for Move in 1 to BestR + BestS
  Child = Reds * 128 + Blues - 128
  Ways = 0
  if Reds greater 0
    Ways = Child cnt (Diff + 2 ** Blues)
  end
  if Ways greater 0
    ValueX += 1
    ValueY *= 2
    Diff += 2 ** Blues
    Reds -= 1
  else
    ValueX *= 2
    ValueY += 1
    Diff -= 2 ** Reds
    Blues -= 1
  end
end
Answer = ValueX
return Answer
