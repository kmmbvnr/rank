use testing

test "given small counts"
  use "319_bounded" as bounded
  Answer = bounded 2 2
  Answer equal 5
end

test "large values with a small sieve"
  use "319_bounded" as bounded
  Answer = bounded 20 2
  Answer equal 227991891
end

test "given medium counts"
  use "319_bounded" as bounded
  Answer = bounded 20 20
  Answer equal 227991891
end
