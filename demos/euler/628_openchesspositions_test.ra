use testing

test "default input"
  use "628_openchesspositions" as solve
  Answer = solve
  Answer equal 210286684
end

test "statement and brute force"
  use "628_openchesspositions" as solve
  Answer = solve 3
  Answer equal 2
  Answer = solve 5
  Answer equal 70
  Answer = solve 9
  Answer equal 277406
end
