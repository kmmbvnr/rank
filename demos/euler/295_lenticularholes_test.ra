use testing

test "default input"
  use "295_lenticularholes"
  run

  Answer equal 4884650818
end

test "empty and smallest limits"
  use "295_lenticularholes"
  N = 0
  run

  Answer equal 0
  N = 1
  run

  Answer equal 1
  N = 2
  run

  Answer equal 1
end

test "small limits"
  use "295_lenticularholes"
  N = 10
  run

  Answer equal 30
  N = 100
  run

  Answer equal 3442
  N = 1000
  run

  Answer equal 393451
end
