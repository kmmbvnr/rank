use testing

test "default input"
  use "295_lenticularholes" as solve
  Answer = solve

  Answer equal 4884650818
end

test "empty and smallest limits"
  use "295_lenticularholes" as solve
  Answer = solve 0

  Answer equal 0
  Answer = solve 1

  Answer equal 1
  Answer = solve 2

  Answer equal 1
end

test "small limits"
  use "295_lenticularholes" as solve
  Answer = solve 10

  Answer equal 30
  Answer = solve 100

  Answer equal 3442
  Answer = solve 1000

  Answer equal 393451
end
