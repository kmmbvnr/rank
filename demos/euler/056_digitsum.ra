rem Powerful Digit Sum
rem https://projecteuler.net/problem=56

use io

Best = 0

for A in 1 until 100
  Power = 1

  for # in 1 until 100
    Power *= A
    Total = Power digit_sum
    Best = Best Total max
  end
end

Best print


fun digit_sum N
  Digits = N text
  Values = Digits integer rank 0
  return Values sum
end
