rem Chip Defects
rem https://projecteuler.net/problem=307

use numbers
use io
use cli

option Defects integer = 20000
option Chips integer = 1000000

Answer = 0.0
if Defects greater 2
  Js = 0 till Defects array
  Frac = Js * 1.0 / Chips
  LogP = (1.0 - Frac) log sum
  P = LogP exp
  Answer = 1.0 - P
  for I in 1 to (Defects // 2)
    Old = I - 1
    A = Defects - 2 * Old
    B = A - 1
    Top = A * B
    Bot = 2.0 * Chips * I
    J = Defects - I
    Part = J * 1.0 / Chips
    Rest = 1.0 - Part
    Gain = (Top / Bot) log
    Loss = Rest log
    LogP += Gain - Loss
    P = LogP exp
    Answer -= P
  end
end
Answer print
