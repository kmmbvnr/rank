use testing

test "small limits"
  use "457_polynomialmodulosquare" as solve
  Answer = solve 10
  Answer equal 5
  Answer = solve 100
  Answer equal 1752
  Answer = solve 1000
  Answer equal 6728355
end

test "limit 10^5"
  use "457_polynomialmodulosquare" as solve
  Answer = solve 100000
  Answer equal 3710903873569
end
