rem Jumping Flea
rem https://projecteuler.net/problem=702

use numbers
use io
use bits
use cli

arg Size integer = 123456789

rem S(N) = bulk term, minus the dyadic
rem corrections C(N, 2^d), plus a gap
rem correction. C(u, v) = (v-1)(v-2)
rem minus Phi(u, v); Phi recurses like
rem Euclid and is memoised.
memo Top phi Base
  Part = Top mod Base
  if Base less 2 or Part less 2
    return 0
  end
  Times = Base // Part
  Rest = Base mod Part
  Inner = Part phi Rest
  Outer = Part phi (Part - Rest)
  Next = Times + 1
  Edge = Part * (Part - 1)
  Pairs = Times * Next * Edge // 4
  Gain = Next * Inner
  return Pairs + Gain - Times * Outer
end

Bits = Size binary len
Bulk = Size * (3 * Size + 1) // 2
Answer = Bulk * (Bits + 1)
for Level in 2 to Bits
  Base = 2 ** Level
  Phi = Size phi Base
  Cut = (Base - 1) * (Base - 2)
  Answer -= Cut - Phi
end
Base = 2 ** Bits - Size
Phi = Size phi Base
Cut = (Base - 1) * (Base - 2)
Gap = Cut - Phi
Answer += 2 * Gap
return Answer
