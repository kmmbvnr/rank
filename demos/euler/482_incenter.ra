rem The incenter of a triangle
rem https://projecteuler.net/problem=482

use numbers
use algo
use sequences
use io
use cli

arg P integer = 10000000

rem Label each nonempty ragged row.
fun Counts expand
  Prefix = Counts scan + with 0
  Size = Prefix last
  Owner = array shape Size fill 0
  Mask = Counts greater 0
  Keep = Mask indices
  Owner (Prefix Keep) = Keep
  Owner = Owner scan max
  return tuple Owner Prefix
end

rem x = s-a, y = s-b, z = s-c and r
rem are integer legs of right triangles.
rem With leg x and hypotenuse h, the
rem least semiperimeter is (r+h)^2/x.
fun Limit triples
  Half = Limit // 2
  Square = Limit * Limit // 108
  Radius = Square isqrt
  Width = Half isqrt + 1
  Grid = 0 till Width * Width copy
  M = Grid // Width
  N = Grid mod Width
  Mask = N at least 1 and (M greater N)
  Odd = (M - N) mod 2 equal 1
  Mask = Mask and Odd
  Keep = Mask indices
  M = M Keep
  N = N Keep
  Mask = M gcd N equal 1
  Keep = Mask indices
  M = M Keep
  N = N Keep
  First = M * M - N * N
  Second = 2 * M * N
  Distance = M * M + N * N
  Radii = concat First Second
  Legs = concat Second First
  Distances = concat Distance Distance
  Base = Radii + Distances
  Copies = Half * Legs // (Base * Base)
  Copies = Copies min (Radius // Radii)
  Mask = Copies greater 0
  Keep = Mask indices
  Radii = Radii Keep
  Legs = Legs Keep
  Distances = Distances Keep
  Copies = Copies Keep
  unpack Owner Prefix = Copies expand
  Size = Owner len
  Scale = (1 to Size) - Prefix Owner
  Radii = Scale * Radii Owner
  Legs = Scale * Legs Owner
  Distances = Scale * Distances Owner
  Keys = Radii * (Half + 1) + Legs
  Order = Keys argsort
  Radii = Radii Order
  Legs = Legs Order
  Distances = Distances Order
  return tuple Radii Legs Distances
end

rem Perimeter bounds (2y-(H-x))^2 by
rem (H-x)^2 - 4H r^2/x. For z >= y,
rem y <= (r^2+r h)/x. Search the sorted
rem (radius, leg) keys within both.
fun Half windows Triples
  unpack Radii Legs Distances = Triples
  Keys = Radii * (Half + 1) + Legs
  Squares = Radii * Radii
  Mask = Legs * Legs at most 3 * Squares
  Query = Mask indices
  X = Legs Query
  Square = Squares Query
  Floor = Square // X
  Mask = Floor at most Half // 4
  Keep = Mask indices
  Query = Query Keep
  X = X Keep
  Square = Square Keep
  Floor = Floor Keep
  Left = Half - X
  Rest = Square mod X
  Carry = 4 * Half * Rest + X - 1
  Disc = Left * Left - 4 * Half * Floor
  Disc -= Carry // X
  Mask = Disc at least 0
  Keep = Mask indices
  Query = Query Keep
  X = X Keep
  Square = Square Keep
  Floor = Floor Keep
  Left = Left Keep
  Disc = Disc Keep
  Disc = Disc isqrt
  Lower = (Left - Disc + 1) // 2 - 1
  Floor = Floor max Lower
  Bound = Radii Query * Distances Query
  Top = (Square + Bound) // X
  Top = Top min (Left // 2)
  Start = Radii Query * (Half + 1)
  Low = Keys upperindex (Start + Floor)
  High = Keys upperindex (Start + Top)
  Low = Low max Query
  Counts = High - Low max 0
  Prefix = Counts scan + with 0
  return tuple Query Low Counts Prefix
end

rem Limit storage for candidate pairs.
fun Half total Triples Windows
  unpack Radii Legs Distances = Triples
  unpack Query Low Counts Sums = Windows
  Count = Query len
  Answer = 0
  Chunk = 4000000
  Start = 0
  for Start less Count
    Base = Sums Start
    Limit = Base + Chunk
    Stop = Sums upperindex Limit
    Stop = Stop - 1 max (Start + 1)
    Stop = Stop min Count
    Size = Sums Stop - Base
    if Size greater 0
      Copies = Counts (Start till Stop)
      unpack Rows Bases = Copies expand
      Right = (0 till Size) - Bases Rows
      Rows += Start
      Right += Low Rows
      Left = Query Rows
      X = Legs Left
      Y = Legs Right
      Square = Radii Left * Radii Left
      Divisor = X * Y - Square
      Product = Square * (X + Y)
      Mask = Product mod Divisor equal 0
      Keep = Mask indices
      Z = Product Keep // Divisor Keep
      X = X Keep
      Y = Y Keep
      Square = Square Keep
      Left = Left Keep
      Right = Right Keep
      Fits = X + Y + Z at most Half
      Fits = Fits and (Z at least Y)
      Keep = Fits indices
      Z = Z Keep
      X = X Keep
      Y = Y Keep
      Square = Square Keep
      Left = Left Keep
      Right = Right Keep
      Squared = Z * Z + Square
      Root = Squared isqrt
      Mask = Root * Root equal Squared
      Keep = Mask indices
      Values = 2 * (X + Y + Z) + Root
      Values += Distances Left
      Values += Distances Right
      Selected = Values Keep
      Answer += Selected sum
    end
    Start = Stop
  end
  return Answer
end

Half = P // 2
Triples = P triples
Windows = Half windows Triples
Answer = Half total Triples Windows
return Answer
