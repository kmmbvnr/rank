rem Summing a Multiplicative Function
rem https://projecteuler.net/problem=639

use numbers
use sequences
use algo
use io
use cli

arg N integer = 1000000000000
arg K integer = 50

rem f_k(n) is rad(n)^k, so f_k = g * h
rem with g(n) = n^k and h supported on
rem powerful m: h(p^e) = p^k - p^2k.
rem S_k(N) = sum over powerful m of
rem h(m) P_k(N // m), P_k the power
rem sum. The powerful m below N^(1/3)
rem in every prime are generated by
rem descending primes, each as a list
rem of its primes; a prime above that
rem enters once, squared. P_k(x) comes
rem from a table for x <= T and from
rem Faulhaber's formula above.
Md = 1000000007
Tl = 100000 min N
Cf = ((N * 1.0) ** (1.0 / 3.0)) floor
for (Cf + 1) ** 3 at most N
  Cf += 1
end
for Cf ** 3 greater N
  Cf -= 1
end
Rw = (0 to 7) reshape 8 1
Sm = (1 to 1) array
Pm = Rw * (0 to 0)
Nc = (0 to 0) * 0
Pd = (primes to Cf array) reverse
Qs = Sm copy
Qp = Pm copy
Qc = Nc copy
for P in Pd
  Pe = P * P
  Nw = 0
  for Pe at most N
    Ix = (Sm at most N // Pe) indices
    if Ix len greater 0
      Ms = Sm Ix * Pe
      Ho = (Rw equal (Nc Ix)) integer
      Pn = (Pm (0 to 7) Ix) + Ho * P
      Cn = Nc Ix + 1
      if Nw equal 0
        Qs = Ms
        Qp = Pn
        Qc = Cn
        Nw = 1
      else
        Qs = concat Qs Ms
        Qp = concat Qp Pn axis 1
        Qc = concat Qc Cn
      end
    end
    Pe *= P
  end
  if Nw equal 1
    Sm = concat Sm Qs
    Pm = concat Pm Qp axis 1
    Nc = concat Nc Qc
  end
end
Xm = N // Sm
Gs = (Xm at most Tl) indices
Gl = (Xm greater Tl) indices
Pg = Pm (0 to 7) Gs
Xg = Xm Gs
Nl = Gl len
Bn = (0 to K) * 0
Bn 0 = 1
for Mb in 1 to K
  Sb = 0
  for Jb in 0 to Mb - 1
    Cb = (Mb + 1) Jb Md binomialmod
    Sb = (Sb + Cb * Bn Jb) mod Md
  end
  Iv = (Mb + 1) (Md - 2) Md powmod
  Bn Mb = (Md - Sb) * Iv mod Md
end
Bn 1 = (Md - Bn 1) mod Md
Co = array shape K (K + 2) fill 0
for Kk in 1 to K
  Iv = (Kk + 1) (Md - 2) Md powmod
  for Jb in 0 to Kk
    Cb = (Kk + 1) Jb Md binomialmod
    Ee = Kk + 1 - Jb
    Cq = Cb * Bn Jb mod Md
    Co (Kk - 1) Ee = Cq * Iv mod Md
  end
end
Pf = array shape K Nl fill 0
if Nl greater 0
  Xl = (Xm Gl) mod Md
  Pw = Xl
  for Ee in 1 to K + 1
    Ck = Co (0 to (K - 1)) Ee
    Cc = Ck reshape K 1
    Pr = Pw reshape 1 Nl
    Pf = (Pf + Cc * Pr) mod Md
    Pw = Pw * Xl mod Md
  end
end
Lo = Cf + 1
Hi = N isqrt
Lq = primes from Lo to Hi array
Mq = (0 to 0) * 0
Lv = Mq * 1
Lm = Pm (0 to 7) (0 to 0)
Fq = 0
Lm2 = N // (Lo * Lo)
Ix1 = (Sm at most Lm2) indices
for Ia in Ix1
  Mo = Sm Ia
  Cn = Lq upperindex (N // Mo isqrt)
  if Cn greater 0
    Ps = Lq (0 till Cn)
    Mp = Ps * 0 + Mo
    Pc = (Pm (0 to 7) Ia) reshape 8 1
    On = (0 till Cn) * 0 + 1
    Cm = Pc * On
    if Fq equal 0
      Mq = Mp
      Lv = Ps
      Lm = Cm
      Fq = 1
    else
      Mq = concat Mq Mp
      Lv = concat Lv Ps
      Lm = concat Lm Cm axis 1
    end
  end
end
Jt = 0 to Tl
Jk = Jt * 0 + 1
Vt = 0 to Cf
Vk = Vt * 0 + 1
Lk = Lv * 0 + 1
Total = 0
for Kk in 1 to K
  Jk = Jk * Jt mod Md
  Vk = Vk * Vt mod Md
  Lk = Lk * Lv mod Md
  Pt = (Jk scan +) mod Md
  Av = (Vk - Vk * Vk mod Md) mod Md
  Av 0 = 1
  Hs = (Gs * 0) + 1
  for Jr in 0 to 7
    Hs = Hs * (Av (Pg Jr)) mod Md
  end
  Total += ((Hs * (Pt Xg)) mod Md) sum
  if Nl greater 0
    Hl = (Gl * 0) + 1
    Pl = Pm (0 to 7) Gl
    for Jr in 0 to 7
      Hl = Hl * (Av (Pl Jr)) mod Md
    end
    Pk = Pf (Kk - 1)
    Total += ((Hl * Pk) mod Md) sum
  end
  if Fq equal 1
    Hq = (Mq * 0) + 1
    for Jr in 0 to 7
      Hq = Hq * (Av (Lm Jr)) mod Md
    end
    Ap = (Lk - Lk * Lk mod Md) mod Md
    Xq = N // (Mq * Lv * Lv)
    Hp = Hq * Ap mod Md
    Total += ((Hp * (Pt Xq)) mod Md) sum
  end
  Total = Total mod Md
end
Answer = Total mod Md
Answer print
