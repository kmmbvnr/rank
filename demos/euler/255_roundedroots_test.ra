use testing

test "small inputs and exact totals"
  use "255_roundedroots" as solve
  Out = solve 1
  Answer = Out .answer
  Count = Out .count
  Total = Out .total

  Total equal 14
  Count equal 9
  Answer equal 1.5555555556
  Out = solve 2
  Answer = Out .answer
  Count = Out .count
  Total = Out .total

  Total equal 186
  Count equal 90
  Answer equal 2.0666666667
  Out = solve 3
  Answer = Out .answer
  Count = Out .count
  Total = Out .total

  Total equal 2362
  Count equal 900
  Answer equal 2.6244444444
  Out = solve 4
  Answer = Out .answer
  Count = Out .count
  Total = Out .total

  Total equal 25545
  Count equal 9000
  Answer equal 2.8383333333
  Out = solve 5
  Answer = Out .answer
  Count = Out .count
  Total = Out .total

  Total equal 288926
  Count equal 90000
  Answer equal 3.2102888889
  Out = solve 6
  Answer = Out .answer
  Count = Out .count
  Total = Out .total

  Total equal 3008866
  Count equal 900000
  Answer equal 3.3431844444
end
