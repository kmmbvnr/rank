rem Super Pandigital Numbers
rem https://projecteuler.net/problem=571

use numbers
use sequences
use bits
use io
use cli

option B integer = 12
option T integer = 10

rem The least B-super-pandigital numbers
rem have B digits in base B, all
rem different. Walk them in order in
rem blocks of (B-3)! permutations, one
rem per prefix of 3 digits, as sums of
rem place values. Keep those pandigital
rem in each lower base, read from digit
rem mask tables of base-b chunks.
Ls = B - 3
Bm = B - 1
Pm = array shape 1 1 fill 0
for N in 2 to Ls
  Nr = (Pm shape) 0
  Ac = array shape 0 N fill 0
  Nm = N - 1
  for A in 0 to Nm
    Fs = array shape Nr 1 fill A
    Mp = Pm + ((Pm at least A) integer)
    Ac = concat Ac (concat Fs Mp axis 1)
  end
  Pm = Ac
end
Rc = (Pm shape) 0
Rw = 0 till Rc array
Pf = array shape (Rc * Ls) fill 0
Tr = Pm transpose
for J in 0 till Ls
  Ix = Rw * Ls + (Tr J)
  Pf Ix = B ** (Ls - 1 - J)
end
Pw = Pf reshape Rc Ls
Xm = B ** B
Ta = array shape 0 fill 0
Of = array shape (B + 1) fill 0
Sz = array shape (B + 1) fill 0
Nc = array shape (B + 1) fill 0
for Bs in 2 to Bm
  K = 1
  for Bs ** (K + 1) at most 200000
    K += 1
  end
  Zs = Bs ** K
  Zm = Zs - 1
  V = 0 to Zm array
  Tf = V * 0
  Tt = V * 0
  for J in 0 till K
    Dg = (V // Bs ** J) mod Bs
    Bt = 1 shl Dg
    Tf = Tf bor Bt
    Tt = Tt bor (Bt * ((V at least Bs ** J) integer))
  end
  Of Bs = Ta len
  Sz Bs = Zs
  C = 1
  for Zs ** C at most Xm
    C += 1
  end
  Nc Bs = C
  Ta = concat Ta (concat Tf Tt)
end
Al = 0 to Bm array
Hits = array shape 0 fill 0
for D1 in 1 to Bm
  for D2 in 0 to Bm
    for D3 in 0 to Bm
      Ok = (D2 not equal D1) and (D3 not equal D1)
      Ok = Ok and (D3 not equal D2)
      if Ok and ((Hits len) less T)
        Ds = (Al not equal D1) and (Al not equal D2)
        Ds = Ds and (Al not equal D3)
        Dl = Al (Ds indices)
        Hv = ((D1 * B + D2) * B + D3) * B ** Ls
        Wd = Pw * Dl
        Sm = Wd reduce + axis 1
        X = Hv + Sm
        for Bs in Bm to 2 by -1
          Cur = X
          Mk = X * 0
          Zs = Sz Bs
          Ob = Of Bs
          Nb = Nc Bs
          for I in 1 to Nb
            R = Cur mod Zs
            Q = Cur // Zs
            Lead = (Q equal 0) integer
            Ix = Ob + R + Zs * Lead
            Mk = Mk bor (Ta Ix)
            Cur = Q
          end
          X = X ((Mk equal (2 ** Bs - 1)) indices)
        end
        Hits = concat Hits X
      end
    end
  end
end
Answer = (Hits (0 till T array)) sum
Answer print
