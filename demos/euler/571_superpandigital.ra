rem Super Pandigital Numbers
rem https://projecteuler.net/problem=571
use numbers
use algo
use sequences
use bits
use io
use cli

arg B integer = 12
arg T integer = 10

rem Visit base-B pandigitals in order.
Length = B min 3
Width = B - Length
Maximum = B ** B
Limit = Maximum binary len
Digits = 0 till B copy
Bases = B - 1 to 2 by -1 copy

rem Place weights for each permutation.
fun Permutations places
  Shape = Permutations shape
  Count = Shape 0
  Rows = 0 till Count copy
  Size = Count * Width
  Cells = array shape Size fill 0
  Columns = Permutations transpose
  for Position in 0 till Width
    Indices = Rows * Width
    Indices += Columns Position
    Power = B ** (Width - 1 - Position)
    Cells Indices = Power
  end
  return Cells reshape Count Width
end
Order = 0 till Width copy
Weights = Order permutations copy places

rem Ignore padding in the leading chunk.
fun Base table
  Powers = Base ** (0 to Limit copy)
  Small = Powers at most 200000
  Size = Powers Small max
  Count = Powers lowerindex Size
  Values = 0 till Size copy
  Full = Values * 0
  Partial = Values * 0
  for Position in 0 till Count
    Power = Base ** Position
    Digit = Values // Power mod Base
    Bits = 1 shl Digit
    Full = Full bor Bits
    Seen = Power at most Values integer
    Useful = Bits * Seen
    Partial = Partial bor Useful
  end
  Bound = Size ** (0 to Limit copy)
  Chunks = Bound upperindex Maximum
  return record
    .size = Size
    .chunks = Chunks
    .masks = concat Full Partial
  end
end
Tables = Bases table rank 0

fun Values check Base
  Entry = Tables (B - 1 - Base)
  Size = Entry .size
  Chunks = Entry .chunks
  Masks = Entry .masks
  Current = Values
  Mask = Values * 0
  for Chunk in 1 to Chunks
    Rest = Current mod Size
    Next = Current // Size
    Leading = Next equal 0 integer
    Indices = Rest + Size * Leading
    Mask = Mask bor (Masks Indices)
    Current = Next
  end
  Full = 2 ** Base - 1
  return Values (Mask equal Full)
end

rem Reject repeated prefix digits early.
fun Row distinct
  return Row unique len equal Length
end
Places = 0 till Length copy
Places = B ** (Length - 1 - Places)
Start = B ** (Length - 1)
End = B ** Length
Numbers = Start till End copy
Rows = Numbers reshape (Numbers len) 1
Prefixes = Rows // Places mod B
Valid = Prefixes distinct rank 1
Selected = Valid indices
Prefixes = Prefixes Selected
Hits = array shape 0 fill 0
for Prefix in Prefixes
  if Hits len at least T
    break
  end
  Free = Digits not in Prefix
  Remaining = Digits Free
  Head = Prefix * Places sum
  Head *= B ** Width
  Sums = Weights * Remaining sum axis 1
  Values = Head + Sums
  Found = Bases reduce check with Values
  Hits = concat Hits Found
end
Positions = 0 till T copy
Answer = Hits Positions sum
Answer print
