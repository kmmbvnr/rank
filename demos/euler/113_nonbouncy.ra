rem Non-bouncy Numbers
rem https://projecteuler.net/problem=113
rem Count the non-bouncy numbers below
rem ten to the power Digits

use numbers
use io
use cli

arg Digits integer = 100

rem Rising numbers are multisets of
rem Digits digits from 1 to 9 plus zero
rem padding, falling ones are multisets
rem from 0 to 9, each less the empty
rem one. Runs of one digit (9 per
rem length) and the number 0 count in
rem both, so subtract them.
Rising = (Digits + 9) binomial 9 - 1
Falling = (Digits + 10) binomial 10 - 1
Runs = Digits * 9
Both = Runs + Digits
Answer = Rising + Falling - Both
Answer print
