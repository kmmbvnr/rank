rem Lattice Paths
rem https://projecteuler.net/problem=15
rem Count right-and-down paths through an
rem N by N grid

use io
use cli

option Size integer = 20

Answer = Size lattice_paths
Answer print


rem Evaluate the central binomial coefficient
rem from equal-length numerator and denominator ranges.
fun lattice_paths Size
  Top = (Size + 1) to Size * 2
  Bottom = 1 to Size
  Numerator = Top * reduce with 1
  Denominator = Bottom * reduce with 1
  return Numerator // Denominator
end
