rem Maximum Path Sum II
rem https://projecteuler.net/problem=67
rem Largest top-to-bottom path sum in
rem a triangle of one hundred rows

use sequences
use text
use io
use cli

argument Input path = "demos/euler/fixtures/0067_triangle.txt"

rem Fold upward: each cell adds the
rem better of its two children.
Rows = Input readlines
Best = array shape (Rows len + 1) fill 0
for Line in Rows reverse
  Row = Line " " split integer rank 0
  Size = Row len
  Left = Best take Size
  Right = Best drop 1 take Size
  Best = Row + (Left Right max)
end
Answer = Best 0
Answer print
