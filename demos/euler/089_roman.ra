rem Roman Numerals
rem https://projecteuler.net/problem=89
rem Count characters saved by writing
rem each numeral in minimal form

use sequences
use text
use io
use cli

arg Input path = (
  "demos/euler/fixtures/"
  + "0089_roman.txt"
)

rem A letter below its successor is
rem subtracted. Newlines count zero, so
rem running sums there are line values.
Src = Input read
Face = array shape 128 fill 0
Face 73 = 1
Face 86 = 5
Face 88 = 10
Face 76 = 50
Face 67 = 100
Face 68 = 500
Face 77 = 1000
Text = Src + "\n"
Codes = Text codepoint rank 0
Val = Face Codes
Next' = concat (Val drop 1) (array 0)
Sign' = (Val less Next) choose (-1) 1
Sums = (Val * Sign) scan +
Ends = (Codes equal 10) indices
Tot = Sums Ends
Last = Tot len - 1
Head' = Tot take Last
Prev' = concat (array 0) Head
Num = Tot - Prev

rem Minimal letters per decimal digit,
rem and one M per thousand.
Cost = array 0 1 2 3 2 1 2 3 4 2
Hundreds' = Cost (Num // 100 mod 10)
Tens' = Cost (Num // 10 mod 10)
Ones' = Cost (Num mod 10)
Thou' = Num // 1000
Short' = Thou + Hundreds + Tens + Ones
Size = Codes len
Lines = Ends len
Kept = Short sum
Answer = Size - Lines - Kept
Answer print
