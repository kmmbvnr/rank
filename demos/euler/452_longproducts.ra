rem Long Products
rem https://projecteuler.net/problem=452
use numbers
use sequences
use cli
use io
arg M integer = 1000000000
arg N integer = 1000000000
Mod = 1234567891
Root = M isqrt
Primes = primes to Root copy

rem Count primes at the quotients M // k
rem and at every value up to sqrt M.
fun Limit prime_counts
  Bound = Limit isqrt
  Keys = 1 to Bound copy
  Low = array shape (Bound + 1) fill 0
  High = array shape (Bound + 1) fill 0
  Low Keys = Keys - 1
  High Keys = Limit // Keys - 1
  for Prime in Primes
    Before = Low (Prime - 1)
    Square = Prime * Prime
    Last = Bound min (Limit // Square)
    Slots = 1 to Last copy
    Keys = Slots * Prime
    Near = Keys min Bound
    Near = High Near
    Far = Limit // Keys min Bound
    Far = Low Far
    Small = Keys at most Bound
    Back = Small choose Near Far
    High Slots -= Back - Before
    Slots = Square to Bound copy
    Back = Low (Slots // Prime)
    Low Slots -= Back - Before
  end
  return tuple Low High
end
unpack Low High = M prime_counts

fun Value prime_count
  if Value at most Root
    return Low Value
  end
  return High (M // Value)
end

rem Each prime exponent is distributed
rem among N slots independently.
Width = 0
for 2 ** (Width + 1) at most M
  Width += 1
end
Ways = array shape (Width + 1) fill 0
Ways 0 = 1
if N greater 0
  Exponents = 1 to Width copy
  Choices = N + Exponents - 1
  Values = Choices binomial Exponents
  Ways Exponents = Values mod Mod
end
Length = N mod Mod

rem Group products by their least prime.
rem Count lone primes without visiting
rem them; expand only higher powers.
fun Value products First
  Count = Value prime_count - First
  if Count at most 0
    return 0
  end
  Total = Length * Count mod Mod
  Bound = Low (Value isqrt)
  Index = First
  if Index at least Bound
    return Total
  end
  Prime = Primes Index
  Power = Prime
  Order = 1
  for Index less Bound
    if Power at most Value // Prime
      Next = Value // Power
      Rest = Next products (Index + 1)
      Part = Ways Order * Rest mod Mod
      Total += Part + Ways (Order + 1)
      Total = Total mod Mod
      Power *= Prime
      Order += 1
    else
      Index += 1
      if Index less Bound
        Prime = Primes Index
        Power = Prime
        Order = 1
      end
    end
  end
  return Total
end
Subtotal = M products 0
Answer = (1 + Subtotal) mod Mod
if M equal 0
  Answer = 0
end
Answer print
