rem Badugi
rem https://projecteuler.net/problem=369

use bits
use io
use cli

arg Ranks integer = 13
arg Max integer = 13

Answer = Ranks badugi Max
Answer print

fun T cards
  A = T band 1
  B = (T band 2) // 2
  C = (T band 4) // 4
  D = (T band 8) // 8
  return A + B + C + D
end

fun R extend T
  Base = R
  if T band 1 not equal 0
    R = R bor ((Base band 21845) shl 1)
  end
  if T band 2 not equal 0
    R = R bor ((Base band 13107) shl 2)
  end
  if T band 4 not equal 0
    R = R bor ((Base band 3855) shl 4)
  end
  if T band 8 not equal 0
    R = R bor ((Base band 255) shl 8)
  end
  return R
end

fun Ranks table Max
  States = 2 ** 16
  Cells = (Max + 1) * States
  Cur = array shape Cells fill 0
  Cur 1 = 1
  for I in 1 to Ranks
    Next = array shape Cells fill 0
    for N in 0 to Max
      At = N * States
      for R in 0 till States
        Ways = Cur (At + R)
        if Ways not equal 0
          for T in 0 to 15
            Count = T cards
            if N + Count at most Max
              To = R extend T
              New = N + Count
              Pos = New * States + To
              Next Pos += Ways
            end
          end
        end
      end
    end
    Cur = Next
  end
  return Cur
end

fun Ranks Max N hands
  States = 2 ** 16
  T = Ranks table Max
  Sum = 0
  At = N * States
  for R in 0 till States
    if R band 32768 not equal 0
      Sum += T (At + R)
    end
  end
  return Sum
end

fun Ranks badugi Max
  T = Ranks table Max
  States = 2 ** 16
  Sum = 0
  for N in 4 to Max
    At = N * States
    for R in 0 till States
      if R band 32768 not equal 0
        Sum += T (At + R)
      end
    end
  end
  return Sum
end
