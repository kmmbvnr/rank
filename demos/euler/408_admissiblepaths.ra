rem Admissible Paths Through a Grid
rem https://projecteuler.net/problem=408

use numbers
use sequences
use io
use cli

arg N integer = 10000000

rem Forbidden points are (a^2, b^2)
rem with a^2 + b^2 a square. First I
rem counts paths whose first hit is
rem the I-th such point, sorted by
rem x then y. The answer is all
rem paths minus the paths that
rem first hit point I and go on.
P = 1000000007
Keys = N forbidden
X = Keys // (N + 1)
Y = Keys mod (N + 1)
Count = X len

rem Modular scans keep tables packed.
Last = 2 * N
Up' = 1 to Last
Factorial = Up scan * with 1 mod P
Seed = Factorial Last (P - 2) P powmod
Down' = Last to 1 by -1
Inverse = Down scan * with Seed mod P
Inverse = Inverse reverse

First = array shape Count fill 0
Total = Factorial Last * Inverse N mod P
Total = Total * Inverse N mod P
for I in 0 till Count
  Column = X I
  Row = Y I
  Ways = Factorial (Column + Row)
  Ways = Ways * Inverse Column mod P
  Ways = Ways * Inverse Row mod P
  if I greater 0
    Old = 0 till I copy
    Old = Old (Y Old at most Row) copy
    Width = Column - X Old
    Height = Row - Y Old
    Terms = Factorial (Width + Height)
    Terms = Terms * Inverse Width mod P
    Terms = Terms * Inverse Height mod P
    Terms = Terms * First Old mod P
    Ways -= Terms sum
  end
  First I = Ways mod P
  Right = N - Column
  Above = N - Row
  Paths = Factorial (Right + Above)
  Paths = Paths * Inverse Right mod P
  Paths = Paths * Inverse Above mod P
  Paths = Paths * First I mod P
  Total -= Paths
end
Answer = Total mod P

rem Primitive triples and their scales.
fun Bound forbidden
  Root = Bound isqrt
  if Root less 4
    return array shape 0 fill 0
  end
  Top = 2 * Root isqrt
  rem Unrank pairs m > n without a grid.
  Size = Top * (Top - 1) // 2
  Pairs = 0 till Size copy
  M = 1 + 8 * Pairs isqrt
  M = (M + 3) // 2
  N = Pairs - (M - 1) * (M - 2) // 2 + 1
  Keep = (M - N) mod 2 equal 1
  M = M Keep copy
  N = N Keep copy
  Keep = M gcd N equal 1
  M = M Keep copy
  N = N Keep copy
  Left = M * M - N * N
  Right = 2 * M * N
  Limit = Root // (Left max Right)
  Keep = Limit greater 0
  Left = Left Keep copy
  Right = Right Keep copy
  Limit = Limit Keep copy
  Count = Limit len
  Scale = 1 to Root // 4 copy
  Width = Scale len
  Grid = Scale reshape 1 Width
  Limits = Limit reshape Count 1
  Allowed = Grid at most Limits
  Flat = Allowed reshape (Count * Width)
  Index = Flat indices
  Parent = Index // Width
  Factor = Scale (Index mod Width)
  A = Left Parent * Factor
  B = Right Parent * Factor
  Key = A * A * (Bound + 1) + B * B
  Other = B * B * (Bound + 1) + A * A
  Keys = concat Key Other
  return Keys sort
end
return record
  .answer = Answer
  .x = X
  .y = Y
end
