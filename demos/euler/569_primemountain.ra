rem Prime Mountain Range
rem https://projecteuler.net/problem=569
use numbers
use sequences
use io
use cli

arg N integer = 2500000

rem Upper hull links bound the search.
fun X predecessors Y
  Count = X len
  Links = array shape Count fill 0
  Stack = array shape Count fill 0
  Top = 0
  Peak = 1
  for Peak less Count
    Pop = false
    if Top greater 1
      A = Stack (Top - 2)
      B = Stack (Top - 1)
      Across = X B - X A
      Above = Y B - Y A
      Ahead = X Peak - X B
      Rise = Y Peak - Y B
      Pop = (Rise * Across at least
        Above * Ahead)
    end
    if Pop
      Top -= 1
    else
      if Top greater 0
        Links Peak = Stack (Top - 1)
      end
      Stack Top = Peak
      Top += 1
      Peak += 1
    end
  end
  return Links
end

rem Query the hull before a linear walk.
fun X visible Y
  Links = X predecessors Y
  Count = X len
  Peak = 2
  Best = 1
  Candidate = 0
  Checking = true
  Answer = 0
  PeakX = 0
  PeakY = 0
  Across = 0
  Height = 0
  for Peak less Count
    if Candidate equal 0
      Answer += 1
      Peak += 1
      Best = Peak - 1
      Candidate = Best - 1
      Checking = true
      if Peak less Count
        PeakX = X Peak
        PeakY = Y Peak
        Across = PeakX - X Best
        Height = PeakY - Y Best
      end
    else
      Rise = PeakY - Y Candidate
      Distance = PeakX - X Candidate
      Below = (Rise * Across less
        Height * Distance)
      if Below
        Previous = Best - 1
        Far = Candidate less Previous
        if Checking and Far
          Candidate = Previous
          Checking = false
        else
          Answer += 1
          Best = Candidate
          Across = PeakX - X Best
          Height = PeakY - Y Best
          Candidate -= 1
          Checking = true
        end
      elif Checking
        Candidate = Links Candidate
      else
        Candidate -= 1
      end
    end
  end
  return Answer
end

Answer = 0
if N greater 1
  Size = 2 * N
  Bound = Size * 1.0 + 20
  Log = Bound log
  Extra = Log log
  Estimate = Bound * (Log + Extra) * 1.1
  Limit = Estimate floor integer
  Limit += 200
  Primes = Limit primesieve array
  Range = 0 till Size
  Primes = Primes Range
  Signs = 1 - 2 * (Range mod 2)
  X = Primes scan +
  Signed = Primes * Signs
  Y = Signed scan +
  Peaks = (0 till N) * 2
  X = X Peaks copy
  Y = Y Peaks copy
  X = concat (array 0) X
  Y = concat (array 0) Y
  Answer = X visible Y
end
Answer print
