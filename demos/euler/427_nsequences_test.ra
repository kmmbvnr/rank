use testing

test "statement values"
  use "427_nsequences" as solve
  Answer = solve 3
  Answer equal 45
  Answer = solve 7
  Answer equal 1403689
  Answer = solve 11
  Answer equal 496890792
end

test "small and large k loops"
  use "427_nsequences" as solve
  Answer = solve 60
  Answer equal 776548161
  Answer = solve 100
  Answer equal 54843257
end

test "empty and binary alphabets"
  use "427_nsequences" as solve
  Answer = solve 0
  Answer equal 0
  Answer = solve 1
  Answer equal 1
  Answer = solve 2
  Answer equal 6
end
