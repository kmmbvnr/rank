rem Prime Connection
rem https://projecteuler.net/problem=425

use numbers
use sequences
use io
use cli

option N integer = 10000000

rem Primes join when they differ in
rem one digit, or one is the other
rem plus a leading digit. Add each
rem prime's edges to smaller primes in
rem increasing order with union-find
rem and see whether it meets 2.
Pr = primes to N array
Ip = array shape (N + 1) fill 0
Ip Pr = 1
Hi = array shape 0 fill 0
Lo = array shape 0 fill 0
for J in 0 to 6
  Pw = 10 ** J
  Dg = Pr // Pw mod 10
  Lead = Pr // Pw less 10
  for D in 0 to 9
    Q = Pr + (D - Dg) * Pw
    Ok = Pr at least Pw choose 1 0
    Ok *= Dg greater D choose 1 0
    if D equal 0
      Ok *= Lead choose 0 1
    end
    Qc = (Q max 0) min N
    Ok = Ok * (Ip Qc)
    Ix = Ok greater 0 indices
    Hi = concat Hi (Pr Ix)
    Lo = concat Lo (Q Ix)
  end
end
rem Leading digit deleted.
for J in 1 to 6
  Pw = 10 ** J
  Top = Pr // Pw
  Q = Pr - Top * Pw
  Ok = Top greater 0 choose 1 0
  Ok *= Top less 10 choose 1 0
  Ok *= Q at least (Pw // 10) choose 1 0
  Qc = (Q max 0) min N
  Ok = Ok * (Ip Qc)
  Ix = Ok greater 0 indices
  Hi = concat Hi (Pr Ix)
  Lo = concat Lo (Q Ix)
end
Od = Hi argsort
Hs = (Hi Od) copy
Ls = (Lo Od) copy
Par = (0 to N) copy
Done = array shape (N + 1) fill 0
Done 2 = 1
Ne = Hs len - 1
for E in 0 to Ne
  A = Hs E
  B = Ls E
  for Par A not equal A
    Par A = Par (Par A)
    A = Par A
  end
  for Par B not equal B
    Par B = Par (Par B)
    B = Par B
  end
  if A not equal B
    Par A = B
  end
  Tp = Hs E
  Rt = Tp
  for Par Rt not equal Rt
    Par Rt = Par (Par Rt)
    Rt = Par Rt
  end
  Rs = 2
  for Par Rs not equal Rs
    Par Rs = Par (Par Rs)
    Rs = Par Rs
  end
  if Rt equal Rs
    Done Tp = 1
  end
end
Conn = Pr (Done Pr equal 1 indices)
Answer = Pr sum - (Conn sum)
Answer print
