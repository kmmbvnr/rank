rem Prime Connection
rem https://projecteuler.net/problem=425

use numbers
use sequences
use io
use cli

arg N integer = 10000000

rem A prime is relative to 2 only if its
rem component reaches 2 before any
rem larger prime is added. Keep 2 as
rem the smallest component root.
fun Parents root_of Node
  Current = Node
  for Parents Current not equal Current
    Current = Parents Current
  end
  return Current
end
fun Edges prime_flags Base
  Parents = 0 till Base copy
  Flags = array shape Base fill false
  if Base at least 3
    Flags 2 = true
  end
  for Edge in Edges
    High = Edge // Base
    Low = Edge mod Base
    rem High's parent is a root.
    Left = Parents High
    Right = Parents Low
    if Parents Right not equal Right
      Right = Parents root_of Right
    end
    Root = Left min Right
    if Left not equal Right
      Parents (Left max Right) = Root
    end
    Parents High = Root
    Parents Low = Root
    if Root equal 2
      Flags High = true
    end
  end
  return Flags
end
rem Store edges as High * Base + Low.
rem Completed blocks in a rope avoid
rem repeatedly copying earlier edges.
fun Primes edge_keys PrimeMask
  Base = PrimeMask len
  Limit = Base - 1
  rem 16K paid too much setup; 1M used
  rem more memory without a clear gain.
  rem Bound digit edits at 256K primes.
  Block = 262144
  Count = Primes len
  Blocks = (Count + Block - 1) // Block
  Width = 0
  if Count greater 0
    Last = Primes (Count - 1)
    Width = Last text len
  end
  Powers = 10 ** (0 till Width array)
  Empty = array shape 0 fill 0
  Edges = Empty rope
  Tasks = Blocks * Width * 11
  for Task in 0 till Tasks
    Start = Task mod Blocks * Block
    End = Start + Block min Count
    Batch = Primes (Start till End) copy
    Pass = Task // Blocks
    Power = Powers (Pass // 11)
    Digit = Pass mod 11
    Candidates = Batch
    Valid = Batch greater 0
    rem Edit 10 drops a leading digit.
    if Digit equal 10
      Prefix = Batch // Power
      Candidates = Batch mod Power
      Valid = Prefix greater 0
      Valid = Valid and Prefix less 10
      Cutoff = Power // 10
      Kept = Candidates at least Cutoff
      Valid = Valid and Kept
    else
      Original = Batch // Power mod 10
      Leading = Batch // Power less 10
      Delta = (Digit - Original) * Power
      Candidates = Batch + Delta
      Valid = Batch at least Power
      Lower = Original greater Digit
      Valid = Valid and Lower
      if Digit equal 0
        Valid = Valid and not Leading
      end
    end
    Clamped = Candidates max 0 min Limit
    Keep = Valid and PrimeMask Clamped
    Indices = Keep indices
    High = Batch Indices
    Low = Candidates Indices
    Keys = High * Base + Low
    Edges = concat Edges (Keys rope)
  end
  return Edges copy sort
end
Primes = primes to N array
Base = N + 1
PrimeMask = array shape Base fill false
PrimeMask Primes = true
Edges = Primes edge_keys PrimeMask
Flags = Edges prime_flags Base
Connected = Flags Primes
Missing = Primes (not Connected)
Answer = Missing sum
return Answer
