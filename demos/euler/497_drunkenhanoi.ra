rem Drunken Tower of Hanoi
rem https://projecteuler.net/problem=497

use numbers
use sequences
use io
use cli

option N integer = 10000

rem T(f, t, a) counts moves i -> j
rem when n disks go from f to t over
rem a: T_n = T_(n-1)(f, a, t) + {a ->
rem f, f -> t, t -> a} + T_(n-1)(a, t,
rem f). Six orientations, 9 counts
rem each. Walking x -> y costs (y - x)
rem (x + y - 2) forward and (x - y)
rem (2K - x - y) around the far side.
Md = 1000000000
Os = (0 till 9) copy
F = Os // 3
T = Os mod 3
Vo = (F not equal T) indices
F = F Vo
T = T Vo
A = 3 - F - T
Id = array shape 9 fill 0
Id (F * 3 + T) = (0 till 6) copy
O1 = Id (F * 3 + A)
O2 = Id (A * 3 + T)
rem Counts as rows of 9: i * 3 + j.
Ix = (0 till 6) copy * 9
Dl = array shape 54 fill 0
Dl (Ix + A * 3 + F) += 1
Dl (Ix + F * 3 + T) += 1
Dl (Ix + T * 3 + A) += 1
Tm = array shape 54 fill 0
Tm (Ix + F * 3 + T) = 1
O0 = Id 2
Gi = (O0 * 9 + (0 till 9)) copy
I3 = (0 till 9) // 3
J3 = (0 till 9) mod 3
Q1 = ((0 till 54) // 9) copy
Q2 = ((0 till 54) mod 9) copy
G1 = O1 Q1 * 9 + Q2
G2 = O2 Q1 * 9 + Q2
Answer = 0
P = array 1 1 1
Kp = 1
for Nn in 1 to N
  P = P * (array 3 6 9) mod Md
  Kp = Kp * 10 mod Md
  Pi = P I3
  Pj = P J3
  Fw = (Pj - Pi) * (Pi + Pj - 2) mod Md
  Bw = 2 * Kp - Pi - Pj
  Bk = (Pi - Pj) * Bw mod Md
  H = (I3 less J3) choose Fw Bk
  H = (I3 equal J3) choose 0 H
  Ec = (Tm Gi * H) mod Md sum
  Ec += H (1 * 3 + 0)
  Answer = (Answer + Ec) mod Md
  Tm = (Tm G1 + Dl + Tm G2) mod Md
end
Answer print
