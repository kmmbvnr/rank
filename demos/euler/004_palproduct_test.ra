use testing

test "default input"
  use "004_palproduct"
  run

  Answer equal 906609
end

test "two-digit factors"
  use "004_palproduct"
  Digits = 2
  run

  Answer equal 9009
end

test "one-digit factors"
  use "004_palproduct"
  Digits = 1
  run

  Answer equal 9
end


test "numeric palindrome boundaries"
  use "004_palproduct"

  0 palindrome
  9 palindrome
  1221 palindrome
  12321 palindrome
  not 10 palindrome
  not 1231 palindrome
  not (-11) palindrome
end
