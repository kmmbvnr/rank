rem Power Digit Sum
rem https://projecteuler.net/problem=16
rem Sum the decimal digits of 2 ** 1000

use io
use cli
use sequences

option Exponent integer = 1000

rem With big integers, a one-line solution:
rem Base ** Exponent text integer rank 0 sum
rem Here, double decimal text instead.
Value = "1"
for I in 1 to Exponent
  Value = Value double
end
Answer = Value integer rank 0 sum
Answer print


rem Multiply decimal text by two.
fun double Text
  Result = ""
  Carry = 0
  for C in Text reverse
    Digit = C integer
    D = Digit * 2 + Carry
    Result = D mod 10 text + Result
    Carry = D // 10
  end
  if Carry greater 0
    Result = Carry text + Result
  end
  return Result
end
