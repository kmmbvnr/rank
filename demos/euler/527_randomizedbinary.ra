rem Randomized Binary Search
rem https://projecteuler.net/problem=527

use numbers
use sequences
use bits
use io
use cli

option N integer = 10000000000

rem Midpoint search fills h = floor
rem log2 n levels and puts the rest on
rem level h: B = (h + 1) - (2^(h + 1)
rem - h - 2) / n. Random pivots give
rem n^2 R(n) = n^2 + 2 sum i R(i), and
rem telescoping n R / (n + 1) gives
rem R = (n + 1) / n (2 H + 3 / (n + 1)
rem - 3) with H the harmonic number.
H0 = (N binary) len - 1
Tl = 2 ** (H0 + 1) - H0 - 2
Bn = H0 + 1 - Tl / N
Nm = N min 1000000
Hn = (1.0 / (1 to Nm)) sum
if N greater 1000000
  Ga = 0.5772156649015329
  Lg = (N * 1.0) log + Ga
  Hn = Lg + 0.5 / N - 1 / (12.0 * N * N)
end
Rn = 2 * Hn + 3 / (N + 1) - 3
Rn = Rn * (N + 1) / N
Answer = (Rn - Bn) round 8
Answer print
