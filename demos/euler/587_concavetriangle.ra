rem Concave Triangle
rem https://projecteuler.net/problem=587

use numbers
use sequences
use io
use cli

option Eps real = 0.001

rem Scale the circles to radius 1. The
rem diagonal y = x / n meets the lower
rem arc y = 1 - sqrt(2x - x^2) at x =
rem n (n + 1 - sqrt(2n)) / (n^2 + 1).
rem With d = 1 - x the concave area is
rem x^2 / 2n + d - (d sqrt(1 - d^2)
rem + asin d) / 2, against the L-section
rem 1 - pi / 4.
Ns = (1 to 10000 array) * 1.0
Rt = (2.0 * Ns) sqrt
Xs = Ns * (Ns + 1 - Rt) / (Ns * Ns + 1)
Dl = 1 - Xs
Rd = (1 - Dl * Dl) sqrt
As = Dl asin
Ac = Xs * Xs / (2 * Ns) + Dl
Ac = Ac - (Dl * Rd + As) / 2
Al = 1 - 3.141592653589793 / 4
Ix = (Ac / Al less Eps) indices
Answer = Ix 0 + 1
Answer print
