use testing

test "statement values"
  use "676_matchingdigitsums" as solve
  Answer = solve 10 3 3
  Answer equal 18
  Answer = solve 100 3 3
  Answer equal 292
  Answer = solve 1000000 3 3
  Answer equal 19173952
end

test "default input"
  use "676_matchingdigitsums" as solve
  Answer = solve 10000000000000000 3 6
  Answer equal 3562668074339584
end
