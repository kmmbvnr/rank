use testing

test "statement values"
  use "649_lowprimenim" as solve
  Answer = solve 3 1
  Answer equal 4
  Answer = solve 3 2
  Answer equal 40
  Answer = solve 9 3
  Answer equal 450304
end

test "brute force"
  use "649_lowprimenim" as solve
  Answer = solve 20 3
  Answer equal 53901312
  Answer = solve 31 2
  Answer equal 758912
end

test "default input"
  use "649_lowprimenim" as solve
  Answer = solve
  Answer equal 924668016
end
