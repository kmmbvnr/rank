use testing

test "triangle triples"
  use "378_triangles" as solve
  Answer = solve 20
  Answer equal 14
  Answer = solve 100
  Answer equal 5772
  Answer = solve 1000
  Answer equal 11174776
end

test "no triples in short inputs"
  use "378_triangles" as solve
  Answer = solve 0
  Answer equal 0
  Answer = solve 1
  Answer equal 0
  Answer = solve 2
  Answer equal 0
end
