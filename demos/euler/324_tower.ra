rem Building a Tower
rem https://projecteuler.net/problem=324

use sequences
use numbers
use io
use cli

arg Exp integer = 5 * 10 ** 9999

Mod = 100000007
K = 23
A0 = array shape K
  1 229 117805
  64647289 69563725 96149360
  40041351 13625499 49444743
  7047816 63444149 71774943
  18904145 72062 58262981
  68125412 64015488 12253197
  9101639 63312159 47925805
  75412110 81862504
end
C = array shape K
  679 99923830 3519127
  14088452 35862961 76806653
  56470433 33422571 39262562
  84928070 25900794 74099213
  15071937 60737445 66577436
  43529574 23193354 64137046
  85911555 96480880 76177
  99999328 1
end
rem x^Period = 1 for this recurrence.
rem Factor degrees: 1, 2, 3, 3, 5, 5.
rem Mod also covers repeated factors.
rem Certificate: euler-324.test.ts.
Period = Mod * (Mod ** 2 - 1)
Period *= (Mod ** 3 - 1)
Period *= (Mod ** 5 - 1)
Period //= (Mod - 1) ** 2
Answer = Exp recurrence
Answer print

fun N recurrence
  if N less K
    return A0 N
  end
  N = N mod Period
  A = array shape K fill 0
  A 0 = 1
  B = array shape K fill 0
  B 1 = 1
  for N greater 0
    if N odd
      A = A combine B
    end
    B = B combine B
    N //= 2
  end
  return (A * A0) sum mod Mod
end

fun A combine B
  P = (A convolve B) mod Mod
  for I in (K * 2 - 2) to K by -1
    for J in 1 to K
      Add = P I * C (J - 1) mod Mod
      P (I - J) += Add
    end
  end
  return (P take K) copy
end
