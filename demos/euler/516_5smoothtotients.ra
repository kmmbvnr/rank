rem 5-smooth totients
rem https://projecteuler.net/problem=516

use numbers
use sequences
use algo
use io
use cli

arg L integer = 1000000000000

rem phi(n) is 5-smooth iff n = h q, h
rem 5-smooth, q a squarefree product
rem of primes p > 5 with p - 1 smooth.
rem S = sum q A(L // q), A(x) the sum
rem of the smooth numbers up to x.
H = array 1
for P in array 2 3 5
  Lp = L // P
  N = H
  for N len greater 0
    N = N (N at most Lp indices) * P
    H = concat H N copy
  end
end
H = H sort
Pr = H + 1
Ok = Pr in primes and (Pr greater 6)
Pr = (Pr (Ok indices)) reverse
rem Double the products by each prime,
rem largest first to keep Q small.
Q = array 1
for P in Pr
  Lp = L // P
  N = Q (Q at most Lp indices) * P
  Q = concat Q N copy
end
Cs = concat (array 0) (H scan +)
Cs = Cs copy
rem Bound temporary arrays by block.
Answer = 0
for I in 0 to (Q len - 1) by 65536
  J = (I + 65535) min (Q len - 1)
  B = Q (I to J) copy
  X = L // B
  A = Cs (H upperindex X) mod 2 ** 32
  T = B * A
  Answer += T mod 2 ** 32 sum
end
Answer = Answer mod 2 ** 32
return Answer
