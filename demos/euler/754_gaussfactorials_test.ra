use testing

test "statement value"
  use "754_gaussfactorials" as solve
  Answer = solve 10
  Answer equal 331358692
end

test "brute force values by chunks"
  use "754_gaussfactorials" as solve
  Answer = solve 1 128
  Answer equal 1
  Answer = solve 100 128
  Answer equal 777776709
  Answer = solve 1000 128
  Answer equal 297877340
  Answer = solve 5000 128
  Answer equal 834876368
end
