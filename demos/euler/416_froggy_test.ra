use testing

test "statement values"
  use "416_froggy" as solve
  Answer = solve 1 3
  Answer equal 4
  Answer = solve 1 4
  Answer equal 15
  Answer = solve 1 5
  Answer equal 46
  Answer = solve 2 3
  Answer equal 16
end

test "two trips, 100 squares"
  use "416_froggy" as solve
  Answer = solve 2 100
  Answer equal 429619151
end
