use testing

test "statement values"
  use "404_crazyellipses" as solve
  Answer = solve 1000
  Answer equal 7
  Answer = solve 10000
  Answer equal 106
  Answer = solve 1000000
  Answer equal 11845
end

test "first family starts at 209"
  use "404_crazyellipses" as solve
  Answer = solve 208
  Answer equal 0
  Answer = solve 209
  Answer equal 1
end
