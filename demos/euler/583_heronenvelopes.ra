rem Heron Envelopes
rem https://projecteuler.net/problem=583
use numbers
use sequences
use algo
use io
use cli
arg P integer = 10000000
arg Batch integer = 4096
Limit = P // 2
Base = Limit + 1
Width = Batch max 1

rem Flatten variable-length rows.
fun Counts expand
  Ends = Counts scan +
  Begins = Ends - Counts
  Size = Counts sum
  Places = 0 till Size copy
  Owners = Ends upperindex Places
  return record
    .rows = Owners
    .steps = Places - Begins Owners
  end
end

rem Keep primitive rows local to one m.
fun flaps
  Top = Limit isqrt
  for M in 2 to Top
    Start = M mod 2 + 1
    N = Start till M by 2 copy
    Good = M gcd N equal 1
    N = N Good
    X = M * M - N * N
    Y = 2 * M * N
    C = M * M + N * N
    Counts = Limit // (X + Y)
    Layout = Counts expand
    Parents = Layout .rows
    Scales = Layout .steps + 1
    X = X Parents * Scales
    Y = Y Parents * Scales
    C = C Parents * Scales
    Good = X + C at most Limit
    Other = Y + C at most Limit
    Keys = X Good * Base + Y Good
    More = Y Other * Base + X Other
    yield concat Keys More
  end
end
Flaps = concat unpack flaps
Flaps = Flaps sort

rem Fuse the per-pair geometry test.
fun A fits H
  Square = 4 * A * A + H * H
  Root = Square isqrt
  return Root * Root equal Square
end

rem Pair flaps with the same halfwidth.
fun Low subtotal
  High = Low + Width min (Flaps len)
  Keys = Flaps (Low till High)
  A = Keys // Base
  T = Keys - A * Base
  S = A * A + T * T isqrt
  Good = A + S + T less Limit
  A = A Good
  T = T Good
  S = S Good
  Lower = A * Base + 2 * T + 1
  Upper = A * Base + Limit - A - S + T
  First = Flaps lowerindex Lower
  Last = Flaps upperindex Upper
  Counts = Last - First
  Layout = Counts expand
  Owners = Layout .rows
  Steps = Layout .steps
  Other = Flaps (First Owners + Steps)
  Left = Keys Good
  Heights = Other - Left Owners
  Widths = A Owners
  Good = Widths fits Heights
  Rows = Owners Good
  A = A Rows
  S = S Rows
  H = Heights Good
  return 2 * (A + H + S) sum
end
Starts = 0 till (Flaps len) by Width
Totals = Starts subtotal rank 0
return Totals sum
