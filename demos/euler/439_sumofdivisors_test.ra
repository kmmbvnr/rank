use testing

test "statement values"
  use "439_sumofdivisors" as solve
  Answer = solve 3
  Answer equal 59
  Answer = solve 1000
  Answer equal 576517282
end

test "larger bound"
  use "439_sumofdivisors" as solve
  Answer = solve 100000
  Answer equal 215766508
end

test "short tables use the recursion"
  use "439_sumofdivisors" as solve
  Answer = solve 100000 400
  Answer equal 215766508
  Answer = solve 1000 40
  Answer equal 576517282
end

test "empty and singleton bounds"
  use "439_sumofdivisors" as solve
  Answer = solve 0
  Answer equal 0
  Answer = solve 1
  Answer equal 1
end
