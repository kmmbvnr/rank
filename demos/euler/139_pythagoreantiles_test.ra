use testing

test "default input"
  use "139_pythagoreantiles" as solve
  Answer = solve

  Answer equal 10057761
end

test "smaller limits"
  use "139_pythagoreantiles" as solve
  Answer = solve 100

  Answer equal 9
  Answer = solve 10000

  Answer equal 1003
  Answer = solve 1000000

  Answer equal 100574
end
