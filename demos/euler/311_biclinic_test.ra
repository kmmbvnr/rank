use testing

test "empty search"
  use "311_biclinic"
  Limit = 0
  run

  Answer equal 0
end

test "small block boundaries"
  use "311_biclinic"
  Limit = 10000
  Block = 97
  run

  Answer equal 49
end

test "published ten thousand"
  use "311_biclinic"
  Limit = 10000
  Block = 4000
  run

  Answer equal 49
end

test "published million"
  use "311_biclinic"
  Limit = 1000000
  Block = 400000
  run

  Answer equal 38239
end
