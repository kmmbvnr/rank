use testing

test "default input"
  use "064_oddperiod"
  run

  Answer equal 1322
end

test "statement example up to 13"
  use "064_oddperiod"
  Limit = 13
  run

  Answer equal 4
end

test "tiny limits"
  use "064_oddperiod"
  Limit = 2
  run

  Answer equal 1
  Limit = 4
  run

  Answer equal 1
end
