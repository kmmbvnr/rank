use testing

test "default input"
  use "064_oddperiod" as solve
  Answer = solve

  Answer equal 1322
end

test "statement example up to 13"
  use "064_oddperiod" as solve
  Answer = solve 13

  Answer equal 4
end

test "tiny limits"
  use "064_oddperiod" as solve
  Answer = solve 2

  Answer equal 1
  Answer = solve 4

  Answer equal 1
end
