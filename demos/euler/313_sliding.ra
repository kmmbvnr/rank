rem Sliding Game
rem https://projecteuler.net/problem=313

use sequences
use io
use cli

option PrimeLimit integer = 1000000

Ps = primes till PrimeLimit array
Sq' = Ps * Ps
H = (Sq + 13) // 2
Low = H // 4 + 1
High = (H - 2) // 3
Fit' = High at least Low
Count' = 2 * (High - Low + 1)
Ways' = Fit choose Count 0
Ways' = (Ps equal 2) choose 0 Ways
Answer = Ways sum
Answer print
