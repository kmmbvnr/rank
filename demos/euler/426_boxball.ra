rem Box-Ball System
rem https://projecteuler.net/problem=426

use numbers
use sequences
use io
use cli

arg Last integer = 10000000

rem Match balls to gaps as brackets.
rem Closing rounds r contribute 2r - 1.
rem A run closing at rounds v+1..v+k
rem contributes (v+k)^2 - v^2 directly.
fun Last solve
  rem Grow only the live run stack.
  Capacity = Last + 10 min 1024
  Rounds = array shape Capacity fill 0
  Counts = array shape Capacity fill 0
  Depth = 0
  State = 290797
  Modulus = 50515093
  Answer = 0
  Run = 0
  Gap = 0
  for true
    if Gap equal 0 or Depth equal 0
      if Run greater Last + 1
        break
      end
      if Depth + 1 at least Capacity
        Rounds = concat Rounds Rounds copy
        Counts = concat Counts Counts copy
        Capacity *= 2
      end
      Gap = 0
      if Run at most Last
        Length = State mod 64 + 1
        State = State * State mod Modulus
        if Run mod 2 equal 0
          Rounds Depth = 0
          Counts Depth = Length
          Depth += 1
        else
          Gap = Length
        end
      else
        Gap = Last * 64 + 64
      end
      Run += 1
    end
    if Gap equal 0 or Depth equal 0
      continue
    end
    Top = Depth - 1
    Round = Rounds Top
    Count = Counts Top
    Closed = Gap min Count
    Weight = 2 * Round + Closed
    Answer += Closed * Weight
    Gap -= Closed
    if Closed less Count
      Left = Count - Closed - 1
      Counts Top = Left
      if Left equal 0
        Depth -= 1
      end
      Rounds Depth = Round + Closed
      Counts Depth = 1
      Depth += 1
    else
      Depth -= 1
      if Depth greater 0
        Top = Depth - 1
        Previous = Rounds Top
        Merged = Round + Count
        if Merged greater Previous
          if Counts Top equal 1
            Rounds Top = Merged
          else
            Counts Top -= 1
            Rounds Depth = Merged
            Counts Depth = 1
            Depth += 1
          end
        end
      end
    end
  end
  return Answer
end
Answer = Last solve
Answer print
