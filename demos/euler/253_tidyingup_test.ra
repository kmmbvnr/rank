use testing

test "full default"
  use "253_tidyingup"
  run

  Answer equal 11.492847
end

test "fewer pieces"
  use "253_tidyingup"
  N = 1
  run

  Answer equal 1
  N = 2
  run

  Answer equal 1
  N = 3
  run

  Answer equal 1.333333
  N = 6
  run

  Answer equal 2.255556
  N = 10
  run

  Answer equal 3.400732
  N = 20
  run

  Answer equal 6.156946
end
