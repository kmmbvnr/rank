use testing

test "full default"
  use "253_tidyingup" as solve
  Answer = solve

  Answer equal 11.492847
end

test "fewer pieces"
  use "253_tidyingup" as solve
  Answer = solve 1

  Answer equal 1
  Answer = solve 2

  Answer equal 1
  Answer = solve 3

  Answer equal 1.333333
  Answer = solve 6

  Answer equal 2.255556
  Answer = solve 10

  Answer equal 3.400732
  Answer = solve 20

  Answer equal 6.156946
end
