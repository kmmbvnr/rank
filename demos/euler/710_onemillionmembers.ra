rem One Million Members
rem https://projecteuler.net/problem=710

use numbers
use sequences
use io
use cli

arg Lg integer = 21
arg Mm integer = 1000000

rem t(n) = 2^(n // 2) - a(n), where a
rem counts the palindromic sums without
rem a 2. The series of a is P / Q with
rem the recurrence polynomial Q; 1 / Q
rem comes from a Newton iteration.
Ln = 2 ** Lg
Qp = array 1 -1 -2 2 1 -1 -1 1
A0 = array 1 1 1 2 2 3 4
Pp = (A0 convolve Qp mod Mm) take 7
Bi = array 1
Cl = 1
for Cl less Ln
  Cl = Cl * 2
  Zp = array shape Cl fill 0
  Qc = (concat Qp Zp) take Cl
  Tm = (Qc convolve Bi mod Mm) take Cl
  Ng = (0 - Tm) mod Mm
  Ng 0 = (2 - Tm 0) mod Mm
  Bi = (Bi convolve Ng mod Mm) take Cl
end
Aa = (Pp convolve Bi mod Mm) take Ln
Ns = 0 to Ln - 1
Pw = 2 (Ns // 2) Mm powmod
Tt = (Pw - Aa) mod Mm
Ok = (Tt equal 0) and (Ns greater 42)
Hit = Ns filter Ok
Answer = Hit min
Answer print
