rem One Million Members
rem https://projecteuler.net/problem=710

use numbers
use sequences
use io
use cli

arg Bits integer = 21
arg Modulus integer = 1000000

rem t(n) = 2^(n // 2) - a(n), where a
rem counts the palindromic sums without
rem a 2. The series of a is P / Q with
rem the recurrence polynomial Q; 1 / Q
rem comes from a Newton iteration.
Length = 2 ** Bits
Poly = array 1 -1 -2 2 1 -1 -1 1
Start = array 1 1 1 2 2 3 4
Mixed = Start convolve Poly mod Modulus
Numerator = Mixed take 7
Series = array 1
Size = 1
for Size less Length
  Size = Size * 2
  Zeros = array shape Size fill 0
  Padded = (concat Poly Zeros) take Size
  Full = Padded convolve Series mod Modulus
  Product = Full take Size
  Negated = (0 - Product) mod Modulus
  First = 2 - Product 0
  Negated 0 = First mod Modulus
  Next = Series convolve Negated mod Modulus
  Series = Next take Size
end
Whole = Numerator convolve Series mod Modulus
Counts = Whole take Length
Terms = 0 to Length - 1
Powers = 2 (Terms // 2) Modulus powmod
Totals = (Powers - Counts) mod Modulus
Zero = Totals equal 0
Match = Zero and (Terms greater 42)
Found = Terms filter Match
Answer = Found min
Answer print
