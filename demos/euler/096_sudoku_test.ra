use testing

test "default input"
  use "096_sudoku"
  use sequences
  run

  Answer equal 24702
end

test "last solved grid is valid"
  use "096_sudoku"
  use sequences
  run

  Start = Grids 49
  Board = Grid reshape 9 9
  ((Board sum axis 1) equal 45) all
  ((Board sum axis 0) equal 45) all
  ((Start equal 0) or (Grid equal Start)) all
end

test "first puzzle is solved to 483"
  use "096_sudoku"
  use io
  use sequences
  Puzzle = "Grid 01\n003020600\n900305001\n001806400\n008102900\n700000008\n006708200\n002609500\n800203009\n005010300\n"
  Puzzle write "/tmp/euler096.txt"
  Input = "/tmp/euler096.txt"
  run

  Answer equal 483
  Grid 0 equal 4
  Grid sum equal 405
end
