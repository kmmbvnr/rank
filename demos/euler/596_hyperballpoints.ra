rem Lattice Points in a Hyperball
rem https://projecteuler.net/problem=596

use numbers
use sequences
use io
use cli
arg R integer = 100000000
rem Jacobi: T = 1 + 8 (S(Q) - 4 S(Q/4)).
rem Split S(M) at sqrt(M). Each paired
rem quotient contributes k*q + tri(q);
rem subtract s*tri(s) for the overlap.
Mod = 1000000007
rem Bound temporary array storage.
Block = 524288
fun Limit subtotal
  Root = Limit isqrt
  Total = 0
  for Start in 1 to Root by Block
    Last = Start + Block - 1 min Root
    Divisors = Start to Last copy
    Quotients = Limit // Divisors
    Values = Quotients mod Mod
    Next = Values + 1
    Products = Values * Next mod Mod
    rem Halve modulo the odd modulus.
    Odd = Products mod 2
    Halves = (Products + Mod * Odd) // 2
    Weighted = Divisors * Values mod Mod
    Terms = Halves + Weighted
    Chunk = Terms sum
    Total = (Total + Chunk) mod Mod
  end
  Triangle = Root * (Root + 1) // 2
  Correction = Root * (Triangle mod Mod)
  return (Total - Correction) mod Mod
end
Square = R * R
Limits = Square // (array 1 4)
Sums = Limits subtotal rank 0
Weights = array 1 -4
Total = Weights * Sums sum
Answer = (1 + 8 * Total) mod Mod
return Answer
