rem Weak Queens
rem https://projecteuler.net/problem=534

use numbers
use sequences
use bits
use io
use cli

arg N integer = 14

rem Cache columns for each free mask.
Full = (1 shl N) - 1
Powers = 2 ** (0 till N)
Masks = 0 to Full
Grid = Masks reshape (Full + 1) 1
Set = Grid bit (0 till N)
Flat = Set reshape ((Full + 1) * N)
Columns = Flat indices mod N
Choices = Masks popcount
Starts = Choices scan + with 0
Half = (1 shl ((N + 1) // 2)) - 1
Scale = 2 ** N
History = array 0
Ways = array 1
Vertical = array 0
Left = array 0
Right = array 0
Answer = N ** N
rem Keep only the last Depth queens.
rem Equal histories can merge only
rem after the first Depth rows.
for Turn in 0 till N * (N - 1)
  Depth = Turn // N + 1
  Row = Turn mod N
  Keep = N ** (Depth - 1)
  if Row equal 0
    History = array 0
    Ways = array 1
    Vertical = array 0
    Left = array 0
    Right = array 0
  end
  Blocked = Vertical bor Left
  Blocked = Blocked bor (Right // Scale)
  Free = Full - (Blocked band Full)
  if Row equal 0
    Free = array Half
  end
  Counts = Choices Free
  if Row equal N - 1
    Totals = Ways * Counts
    Answer += Totals sum
  else
    Active = Counts greater 0 indices
    Lengths = Counts Active
    Ends = Lengths scan +
    Begin = Ends - Lengths
    Size = Lengths sum
    if Size greater 0
      Marks = array shape Size fill 0
      Marks Begin = 1
      Owners = Marks scan +
      Owners = Owners - 1
      Source = Active Owners
      Offset = 0 till Size
      Offset = Offset - Begin Owners
      Lookup = Starts (Free Source)
      Column = Columns (Lookup + Offset)
      Past = History Source
      Child = Past mod Keep * N + Column
      Weight = Ways Source
      if Row equal 0
        Middle = 2 * Column equal N - 1
        Weight = Middle choose 1 2
      end
      if Row less Depth
        History = Child
        Ways = Weight
      else
        Order = Child argsort
        Sorted = Child Order
        Count = Sorted len
        Previous = 0 till Count
        Previous = (Previous - 1) max 0
        Prior = Sorted Previous
        Changes = Sorted not equal Prior
        Flags = Changes integer
        Flags 0 = 1
        Selected = Flags not equal 0
        First = Selected indices
        Group = Flags scan +
        Group = Group - 1
        History = Sorted First
        Groups = First len
        Ways = array shape Groups fill 0
        Weight = Weight Order
        Ways Group += Weight .accumulate
        Picks = Order First
        Source = Source Picks
        Column = Column Picks
        Past = Past Picks
      end
      Bit = Powers Column
      Straight = Vertical Source + Bit
      Forward = (Left Source + Bit) * 2
      Back = Right Source + Bit * Scale
      Back = Back // 2
      if Row at least Depth
        Old = Powers (Past // Keep)
        Straight = Straight - Old
        Ahead = 2 ** (Depth + 1)
        Forward = Forward - Old * Ahead
        Shift = N - Depth - 1
        Back = Back - Old * 2 ** Shift
      end
      Vertical = Straight
      Left = Forward
      Right = Back
    else
      History = array shape 0 fill 0
      Ways = array shape 0 fill 0
      Vertical = array shape 0 fill 0
      Left = array shape 0 fill 0
      Right = array shape 0 fill 0
    end
  end
end
Answer print
