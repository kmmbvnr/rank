use testing

test "default input"
  use "562_maximalperimeter" as solve
  Answer = solve
  Answer equal 51208732914368
end

test "statement values rounded"
  use "562_maximalperimeter" as solve
  Answer = solve 5 200
  Answer equal 20
  Answer = solve 10 200
  Answer equal 97
  Answer = solve 100 200
  Answer equal 9158
end
