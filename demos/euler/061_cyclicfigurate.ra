rem Cyclic Figurate Numbers
rem https://projecteuler.net/problem=61
rem Sum six cyclic 4-digit numbers, one
rem from each polygonal type 3 to 8

use sequences
use bits
use io

Sides = (3 to 8) reshape 6 1
Ns = (1 to 150) reshape 1 150
Edge' = Ns * (Sides - 2) - Sides + 4
Grid = Ns * Edge // 2
Mask = Grid at least 1000
Mask and= Grid at most 9999
Mask and= Grid mod 100 at least 10
Vals = Grid Mask array
Kind = Mask indices # 0
Bit = 1 Kind shl
Head = Vals // 100
Tail = Vals mod 100

rem Grow chains from the octagonal
rem numbers. Each step joins every
rem unused type whose number starts with
rem the last two digits.
Cur = (Kind equal 5) indices
First = Cur
Used = Bit Cur
Sum = Vals Cur
for # in 1 to 5
  Rows = Cur len
  Ends = Tail Cur
  Last = Ends reshape Rows 1
  Link' = Head equal Last
  Taken = Used reshape Rows 1
  Free' = (Taken Bit band) equal 0
  Pairs = (Link and Free) indices
  Old = Pairs # 0
  New = Pairs # 1
  First = First Old copy
  Used = (Used Old) + (Bit New) copy
  Sum = (Sum Old) + (Vals New) copy
  Cur = New copy
end
Closed' = Tail Cur equal Head First
Answer = (Sum Closed) first
Answer print
