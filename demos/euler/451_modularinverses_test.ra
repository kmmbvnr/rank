use testing

test "statement values"
  use "451_modularinverses" as solve
  Out = solve 100
  Answer = Out .answer
  B = Out .b
  B 7 equal 1
  B 15 equal 11
  B 100 equal 51
  Answer equal 2044
end

test "brute-force sum to 1000"
  use "451_modularinverses" as solve
  Out = solve 1000
  Answer = Out .answer
  Answer equal 278340
end

test "sum to 200000"
  use "451_modularinverses" as solve
  Out = solve 200000
  Answer = Out .answer
  Answer equal 14223825129
end
