use testing

test "default input"
  use "645_everydayholiday" as solve
  Answer = solve
  Answer equal "48894.2174"
end

test "statement values"
  use "645_everydayholiday" as solve
  Answer = solve 2
  Answer equal "1.0000"
  Answer = solve 5
  Answer equal "5.1667"
  Answer = solve 365
  Answer equal "1174.3501"
end
