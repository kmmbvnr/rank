use testing

test "smaller limits"
  use "136_singleton" as solve
  Answer = solve 100

  Answer equal 25
  Answer = solve 1000

  Answer equal 158
  Answer = solve 1000000

  Answer equal 67641
end

test "singletons up to twenty"
  use "136_singleton" as solve
  Answer = solve 21

  Answer equal 8
end


test "default input"
  use "136_singleton" as solve
  Answer = solve

  Answer equal 2544559
end

test "exclusive endpoints"
  use "136_singleton" as solve
  Answer = solve 4

  Answer equal 1
  Answer = solve 5

  Answer equal 2
  Answer = solve 16

  Answer equal 5
  Answer = solve 17

  Answer equal 6
end
