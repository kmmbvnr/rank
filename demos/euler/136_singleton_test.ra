use testing

test "smaller limits"
  use "136_singleton"
  Limit = 100
  run

  Answer equal 25
  Limit = 1000
  run

  Answer equal 158
  Limit = 1000000
  run

  Answer equal 67641
end

test "singletons up to twenty"
  use "136_singleton"
  Limit = 21
  run

  Answer equal 8
end


test "default input"
  use "136_singleton"
  run

  Answer equal 2544559
end

test "exclusive endpoints"
  use "136_singleton"
  Limit = 4
  run

  Answer equal 1
  Limit = 5
  run

  Answer equal 2
  Limit = 16
  run

  Answer equal 5
  Limit = 17
  run

  Answer equal 6
end
