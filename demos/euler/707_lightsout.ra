rem Lights Out
rem https://projecteuler.net/problem=707

use numbers
use sequences
use bits
use io
use cli

arg Width integer = 199
arg Count integer = 199
arg Prime integer = 1000000007

if (Width less 0) or (Count less 0)
  .DomainError raise
end

rem Integers encode GF(2) polynomials.
rem T has ones on three diagonals. Its
rem characteristic polynomial satisfies
rem P(n) = (x+1) P(n-1) + P(n-2).
fun Size characteristic
  Low = 1
  High = 3
  if Size equal 0
    return Low
  end
  for I in 2 to Size
    Next = High shl 1
    Next = Next bxor High bxor Low
    Low = High
    High = Next
  end
  return High
end

fun Value remainder Divisor
  Rest = Value
  Size = Divisor binary len
  for Rest greater 0
    Shift = (Rest binary len) - Size
    if Shift less 0
      break
    end
    Rest = Rest bxor (Divisor shl Shift)
  end
  return Rest
end

fun Left commonfactor Right
  First = Left
  Second = Right
  for Second greater 0
    Rest = First remainder Second
    First = Second
    Second = Rest
  end
  return First
end

Modulus = Width characteristic
Variable = 2 remainder Modulus

fun Left multiply Right
  Carry = Left
  Bits = Right
  Result = 0
  for Bits greater 0
    if Bits bit 0
      Result = Result bxor Carry
    end
    Bits = Bits shr 1
    Carry = Carry shl 1
    if Carry bit Width
      Carry = Carry bxor Modulus
    end
  end
  return Result
end

rem The first basis vector is cyclic
rem for T, so nullity of B(T) equals
rem degree(gcd(P, B)). This also holds
rem when P has repeated factors.
Initial = Modulus commonfactor Variable
Initial = (Initial binary len) - 1
Nullity = array shape Count fill Initial
Fibs = array shape Count fill 1
AHigh = 1
BHigh = Variable
ALow = 1
BLow = Variable
FibA = 1
FibB = 1

rem Same Fibonacci-height doubling
rem identities as the matrix solution.
for Step in 2 to Count - 1
  Prod = AHigh multiply ALow
  Cross1 = AHigh multiply BLow
  Cross2 = BHigh multiply ALow
  Both = BHigh multiply BLow
  Shifted = Variable multiply Prod
  ALow = AHigh
  BLow = BHigh
  Sum = Cross1 bxor Cross2
  AHigh = Sum bxor Shifted
  BHigh = Both bxor Prod
  Factor = Modulus commonfactor BHigh
  Nullity Step = (Factor binary len) - 1
  FibC = (FibA + FibB) mod (Prime - 1)
  FibA = FibB
  FibB = FibC
  Fibs Step = FibC
end
Cycle = Prime - 1
Total = Width * Fibs - Nullity
Exponent = Total mod Cycle
Powers = 2 Exponent Prime powmod
return Powers sum mod Prime
