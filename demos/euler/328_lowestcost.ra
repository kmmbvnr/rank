rem Lowest-cost Search
rem https://projecteuler.net/problem=328

use io

Answer = 200000 costs
Answer print

fun N costs
  Dp = array shape (N + 1) fill 0
  rem Only the root window needs trees.
  Bound = 1000000000000
  Start = ((4 * N) // 5 - 20) max 0
  Limit = (N - 1 - Start) max 100
  Cells = Limit + 1
  Depth = array shape Cells fill 0
  Long = array shape Cells fill 0
  Short = array shape Cells fill -Bound
  Height = 0
  Power = 1
  for Power * 2 at most Limit
    Power *= 2
    Height += 1
  end
  rem Only two paid depths occur.
  H = 1
  P = 2
  for Size in 2 to Limit
    if Size at least P * 2
      P *= 2
      H += 1
    end
    Depth Size = H
    L = 0
    R = 0
    if Size at least (P + P // 2)
      L = P - 1
      R = Size - 1 - L
    else
      R = P // 2 - 1
      L = Size - 1 - R
    end
    Left = -Bound
    Right = -Bound
    if (Depth L) equal (H - 1)
      Left = (Long L) + L + 1
    end
    if (Depth R) equal (H - 1)
      Right = (Long R)
      Right += H * (L + 1)
    end
    Long Size = Left max Right
    if H greater 1
      Left = Long L
      Right = Long R
      if (Depth L) equal (H - 1)
        Left = Short L
      end
      if (Depth R) equal (H - 1)
        Right = Short R
      end
      Left += L + 1
      Right += (H - 1) * (L + 1)
      Short Size = Left max Right
    end
  end
  rem Check the search stays monotone.
  Ordered = true
  for Size in 15 to Limit by 8
    H = Depth Size
    if H equal (Depth (Size - 8))
      Now = (Short Size) - H * Size
      Prev = Short (Size - 8)
      Prev -= H * (Size - 8)
      if Now greater Prev
        Ordered = false
      end
    end
  end
  Slots = Cells // 8
  Frontier = array shape Slots fill 0
  Levels = Height + 1
  Starts = array shape Levels fill 0
  Stops = array shape Levels fill 0
  Used = 0
  Next = 7
  Top = 0
  Sum = 0
  for I in 2 to N
    Best = Bound
    Start = ((4 * I) // 5 - 20) max 0
    Last = I - 1 - Start
    if I at most 100 or not Ordered
      First = 7
      Step = 8
      if I at most 100
        First = 0
        Step = 1
      end
      for Size in First to Last by Step
        K = I - 1 - Size
        H = Depth Size
        Right = (Long Size)
        Right += H * (K + 1)
        if H greater 0
          Other = (Short Size)
          Other += (H - 1) * (K + 1)
          Right = Right max Other
        end
        Left = Dp K
        Cost = K + 1 + (Left max Right)
        Best = Best min Cost
      end
    else
      rem Discard dominated sizes only
      rem when the new size is eligible.
      for Next at most Last
        H = Depth Next
        if H not equal Top
          Starts H = Used
          Top = H
        end
        A = (Long Next)
        A -= (H + 1) * Next
        Pop = true
        Base = Starts H
        for Used greater Base and Pop
          Size = Frontier (Used - 1)
          Old = (Long Size)
          Old -= (H + 1) * Size
          if Old at least A
            Used -= 1
          else
            Pop = false
          end
        end
        Frontier Used = Next
        Used += 1
        Stops H = Used
        Next += 8
      end
      for Level in 2 to Top
        rem Rising long costs cross the
        rem falling left/short costs.
        Begin = Starts Level
        End = Stops Level
        Low = Begin
        High = End
        for Low less High
          Mid = (Low + High) // 2
          Size = Frontier Mid
          K = I - Size
          A = (Long Size)
          A += (Level + 1) * K
          B = (Short Size) + Level * K
          Left = K + Dp (K - 1)
          if A at least (B max Left)
            High = Mid
          else
            Low = Mid + 1
          end
        end
        First = (Low - 1) max Begin
        LastIx = Low min (End - 1)
        for Ix in First to LastIx
          Size = Frontier Ix
          K = I - Size
          A = (Long Size)
          A += (Level + 1) * K
          B = (Short Size) + Level * K
          Left = K + Dp (K - 1)
          Cost = A max B max Left
          Best = Best min Cost
        end
      end
    end
    if Best less (Dp (I - 1))
      Ordered = false
    end
    Dp I = Best
    Sum += Best
  end
  return Sum
end
