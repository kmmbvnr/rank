rem Lowest-cost Search
rem https://projecteuler.net/problem=328

use io

Answer = 200000 costs
Answer print

fun N costs
  Dp = array shape (N + 1) fill 0
  rem Only these right subtree sizes can occur in the candidate window.
  Limit = N - 1 - (((4 * N) // 5 - 20) max 0)
  Limit = Limit max 100
  Heights = array shape (Limit + 1) fill 0
  LongOffsets = array shape (Limit + 1) fill 0
  ShortOffsets = array shape (Limit + 1) fill -1000000000000
  Height = 0
  Power = 1
  for Power * 2 at most Limit
    Power *= 2
    Height += 1
  end
  rem A path with D paid guesses costs D * Base + its stored offset.
  rem Retain the greatest offset at each depth, including shorter paths.
  Offsets = array shape (Limit + 1) (Height + 1) fill -1000000000000
  Offsets 0 0 = 0
  Offsets 1 0 = 0
  H = 1
  P = 2
  for Size in 2 to Limit
    if Size at least P * 2
      P *= 2
      H += 1
    end
    Heights Size = H
    L = 0
    R = 0
    if Size at least (P + P // 2)
      L = P - 1
      R = Size - 1 - L
    else
      R = P // 2 - 1
      L = Size - 1 - R
    end
    for D in 0 till H
      Left = (Offsets L D) + L + 1
      Right = (Offsets R D) + (D + 1) * (L + 1)
      Offsets Size (D + 1) = Left max Right
    end
    LongOffsets Size = Offsets Size H
    ShortOffsets Size = Offsets Size (H - 1)
  end
  Sum = 0
  for I in 2 to N
    Best = 1000000000000
    Start = ((4 * I) // 5 - 20) max 0
    Last = I - 1 - Start
    First = 7
    Step = 8
    if I at most 100
      First = 0
      Step = 1
    end
    rem The original Ok recurrence accepts exactly sizes 7 modulo 8.
    for Size in First to Last by Step
      K = I - 1 - Size
      H = Heights Size
      Right = (LongOffsets Size) + H * (K + 1)
      if H greater 0
        Short = (ShortOffsets Size) + (H - 1) * (K + 1)
        Right = Right max Short
      end
      Cost = K + 1 + ((Dp K) max Right)
      Best = Best Cost min
    end
    Dp I = Best
    Sum += Best
  end
  return Sum
end
