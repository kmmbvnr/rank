use testing

test "statement checkpoints"
  use "425_primeconnection" as solve
  Answer = solve 1000
  Answer equal 431
  Answer = solve 10000
  Answer equal 78728
end

test "union-find reference"
  use "425_primeconnection" as solve
  Answer = solve 200
  Answer equal 431
end

test "empty and single-digit graphs"
  use "425_primeconnection" as solve
  Answer = solve 0
  Answer equal 0
  Answer = solve 1
  Answer equal 0
  Answer = solve 2
  Answer equal 0
end

test "a path through a larger prime"
  use "425_primeconnection" as solve
  Answer = solve 11
  Answer equal 11
  Answer = solve 13
  Answer equal 11
  Answer = solve 101
  Answer equal 112
end
