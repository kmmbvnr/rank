rem Fleeting Medians
rem https://projecteuler.net/problem=593
use numbers
use stats
use sequences
use io
use cli
arg N integer = 10000000
arg K integer = 100000
if K less 1 or N less K
  .DomainError "need 1 <= K <= N" raise
end

rem A loose bound for the Nth prime.
Size = N * 1.0 + 6
Log = Size log
LogLog = Log log
Estimate = Size * (Log + LogLog) * 1.1
Bound = Estimate floor integer
Bound += 200
Primes = Bound primesieve copy
Primes = Primes (0 till N)
Ranks = 1 to N copy

rem Reduce exponents by Fermat; the
rem prime 10007 itself still gives zero.
Exponents = Ranks mod 10006
Terms = Primes Exponents 10007 powmod
Zeros = Primes equal 10007 indices
Terms Zeros = 0
Values = Terms + Terms (Ranks // 10000)

rem Overlapping windows share one scan.
Medians = Values window K median axis 1
Total = Medians sum
Answer = Total text ".1f"
return Answer
