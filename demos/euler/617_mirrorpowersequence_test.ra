use testing

test "default input"
  use "617_mirrorpowersequence" as solve
  Answer = solve
  Answer equal 1001133757
end

test "statement values"
  use "617_mirrorpowersequence" as solve
  Answer = solve 10
  Answer equal 2
  Answer = solve 100
  Answer equal 21
  Answer = solve 1000
  Answer equal 69
  Answer = solve 1000000
  Answer equal 1303
  Answer = solve 1000000000000
  Answer equal 1014800
end
