use testing

rem Small independent chain sums.
test "short chains"
  use "214_totientchains"
  Limit = 10
  Len = 3
  run

  Answer equal 3
  Len = 4
  run

  Answer equal 12
  Limit = 10000
  Len = 10
  run

  Answer equal 93430
  Limit = 100000
  Len = 15
  run

  Answer equal 162726509
end

test "two is prime and the upper bound is exclusive"
  use "214_totientchains"
  Limit = 3
  Len = 2
  run

  Answer equal 2
  Limit = 2
  run

  Answer equal 0
  Limit = 0
  run

  Answer equal 0
end
