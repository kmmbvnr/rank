rem Modulo Summations
rem https://projecteuler.net/problem=326

use io

Answer = 1000000000000 1000000 pairs
Answer print

fun N M pairs
  Period = 6 * M
  Whole = N // Period
  Rest = N mod Period
  Seen = array shape M fill 0
  Tail = array shape M fill 0
  Weight = 0
  Prefix = 0
  for I in 0 till Period
    Seen Prefix += 1
    if I at most Rest
      Tail Prefix += 1
    end
    K = I + 1
    A = 0
    if K equal 1
      A = 1
    else
      A = Weight mod K
    end
    Weight += K * A
    Prefix = (Prefix + A) mod M
  end
  Answer = 0
  for I in 0 till M
    Count = Whole * Seen I + Tail I
    Answer += Count * (Count - 1) // 2
  end
  return Answer
end
