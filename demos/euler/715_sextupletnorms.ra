rem Sextuplet Norms
rem https://projecteuler.net/problem=715

use numbers
use sequences
use io
use cli

arg Limit integer = 10 ** 12
arg Prime integer = 1000000007

rem The summand a is multiplicative
rem with a(p^e) = p^(3e) - x(p) p^(3e-3)
rem for the mod 4 character x. Lucy
rem tables give the prime sums of p^3
rem and x(p) at every Nn // k. Then,
rem from the largest prime down, each
rem prime (and exponent) adds its
rem composite terms to the tables.
Root = Limit isqrt
Values = 0 to Root
Above = Limit // (Values max 1)
All = concat Values Above
Evens = All + (All mod 2)
Odds = All + 1 - (All mod 2)
Half = Evens // 2 mod Prime
Odd1 = Odds mod Prime
Halves = Half * Odd1 mod Prime
Cubes = (Halves * Halves - 1) mod Prime
Mod4 = All mod 4
Mask = (Mod4 equal 1) or (Mod4 equal 2)
Chi1 = Mask integer
Chi = Chi1 - 1
Width = Root + 1
CubeLow = Cubes take Width
CubeBig = Cubes drop Width
ChiLow = Chi take Width
ChiBig = Chi drop Width
CubeLow 0 = 0
ChiLow 0 = 0
Primes = primes to Root array
for P in Primes
  Cube = P 3 Prime powmod
  One = (P mod 4 equal 1) integer
  Three = (P mod 4 equal 3) integer
  Sign = One - Three
  CBefore = CubeLow (P - 1)
  XBefore = ChiLow (P - 1)
  Reach = Root min (Limit // (P * P))
  Index = 1 to Reach
  Product = P * Index
  Inside = Product at most Root
  SmallAt = Limit // Product min Root
  LargeAt = Product min Root
  FromBig = CubeBig LargeAt
  FromLow = CubeLow SmallAt
  Pick = Inside choose FromBig FromLow
  CDelta = Pick - CBefore
  FromBig = ChiBig LargeAt
  FromLow = ChiLow SmallAt
  Pick2 = Inside choose FromBig FromLow
  XDelta = Pick2 - XBefore
  CDelta = CDelta mod Prime
  CDelta = Cube * CDelta mod Prime
  CNew = CubeBig Index - CDelta
  CubeBig Index = CNew mod Prime
  XNew = Sign * XDelta
  ChiBig Index = ChiBig Index - XNew
  Range = P * P to Root
  Parents = Range // P
  CUp = CubeLow Parents - CBefore
  CDelta = CUp mod Prime
  CCut = Cube * CDelta mod Prime
  CNew = CubeLow Range - CCut
  CubeLow Range = CNew mod Prime
  XDelta = ChiLow Parents - XBefore
  XNew = Sign * XDelta
  ChiLow Range = ChiLow Range - XNew
end
Gap = CubeLow - ChiLow
PrimeSmall = Gap mod Prime
GapL = CubeBig - ChiBig
SumBig = GapL mod Prime
SumLow = PrimeSmall copy
rem Primes with p^3 > N: e = 1 only.
Cubes3 = Primes ** 3
Isbig = Cubes3 greater Limit
Bigs = Primes filter Isbig
for P in Bigs reverse
  Cube = P 3 Prime powmod
  One = (P mod 4 equal 1) integer
  Three = (P mod 4 equal 3) integer
  Raw = Cube - One + Three
  Weight = Raw mod Prime
  Weight2 = Weight * Cube mod Prime
  Below = PrimeSmall P
  Reach = Root min (Limit // (P * P))
  Index = 1 to Reach
  Product = P * Index
  Inside = Product at most Root
  LargeAt = Product min Root
  SmallAt = Limit // Product min Root
  FromBig = SumBig LargeAt
  FromLow = SumLow SmallAt
  Pick = Inside choose FromBig FromLow
  Value = Pick - Below
  Value = Value mod Prime
  Value = Weight * Value mod Prime
  Gain = SumBig Index + Value + Weight2
  SumBig Index = Gain mod Prime
  if P * P at most Root
    Range = P * P to Root
    Over = SumLow (Range // P) - Below
    Over = Over mod Prime
    Scaled = Weight * Over mod Prime
    Part = Scaled + Weight2
    Fresh = SumLow Range + Part
    SumLow Range = Fresh mod Prime
  end
end
rem Smaller primes: every e with
rem p^(e+1) <= N, from a snapshot.
Small3 = Primes ** 3
Isless = Small3 at most Limit
Little = Primes filter Isless
Logs = Little real log
Ratio = (Limit real log) / Logs
Powers = Ratio floor - 1
Lift = Little ** (Powers + 2)
UpMask = Lift at most Limit
UpStep = UpMask integer
Powers = Powers + UpStep
Lower = Little ** (Powers + 1)
DownMask = Lower greater Limit
DownStep = DownMask integer
Powers = Powers - DownStep
Pairs = Powers sum
Ends = Powers scan +
Starts = Ends - Powers
Marks = array shape Pairs fill 0
Marks Starts = 1
Owner = (Marks scan +) - 1
Run = 0 to Pairs - 1
Exponent = Run - (Starts Owner) + 1
Exponent = Exponent reverse
PairPrime = (Little Owner) reverse
Last = Powers Owner reverse
First = (Exponent equal Last) integer
SnapBig = SumBig copy
SnapLow = SumLow copy
for Step in 0 to Pairs - 1
  P = PairPrime Step
  Power2 = Exponent Step
  if First Step equal 1
    SnapBig = SumBig copy
    SnapLow = SumLow copy
  end
  Cube = P 3 Prime powmod
  One = (P mod 4 equal 1) integer
  Three = (P mod 4 equal 3) integer
  Raw = Cube - One + Three
  Weight = Raw mod Prime
  Scale = Cube (Power2 - 1) Prime powmod
  WeightX = Weight * Scale mod Prime
  Weight3 = WeightX * Cube mod Prime
  Below = PrimeSmall P
  Power = P ** Power2
  Next = Power * P
  Reach = Root min (Limit // Next)
  Index = 1 to Reach
  Product = Power * Index
  Inside = Product at most Root
  LargeAt = Product min Root
  SmallAt = Limit // Product min Root
  FromBig = SnapBig LargeAt
  FromLow = SnapLow SmallAt
  Pick = Inside choose FromBig FromLow
  Value = Pick - Below
  Value = Value mod Prime
  Value = WeightX * Value mod Prime
  Gain = SumBig Index + Value + Weight3
  SumBig Index = Gain mod Prime
  if Power * P at most Root
    Range = Power * P to Root
    Which = Range // Power
    Over = SnapLow Which - Below
    Over = Over mod Prime
    Scaled = WeightX * Over mod Prime
    Part = Scaled + Weight3
    Fresh = SumLow Range + Part
    SumLow Range = Fresh mod Prime
  end
end
Answer = (1 + SumBig 1) mod Prime
Answer print
