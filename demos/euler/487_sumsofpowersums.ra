rem Sums of power sums
rem https://projecteuler.net/problem=487

use numbers
use sequences
use io
use cli

arg K integer = 10000
arg N integer = 1000000000000
arg Lo integer = 2000000000
arg Wd integer = 2000

rem S_k is a polynomial of degree K+2.
rem Its samples are two prefix sums.
Degree = K + 2
Nodes = 0 to Degree copy
Factors = 1 to Degree copy

fun Mod small
  Rest = N mod Mod
  Items = 1 to Mod copy
  Powers = Items K Mod powmod
  Terms = (Rest + 1 - Items) * Powers
  Cycle = Terms sum mod Mod
  Tail = Items at most Rest
  Values = Tail choose Terms 0
  Last = Values sum mod Mod
  Blocks = N // Mod mod Mod
  return (Blocks * Cycle + Last) mod Mod
end

fun Mod subtotal
  if Mod at most Degree
    return Mod small
  end
  Powers = Nodes K Mod powmod
  Powers 0 = 0
  Prefix = Powers scan + mod Mod
  Values = Prefix scan + mod Mod
  Point = N mod Mod
  if Point at most Degree
    return Values Point
  end
  Facts = Factors scan * with 1 mod Mod
  Top = Facts Degree
  Exponent = Mod - 2
  Seed = Top Exponent Mod powmod
  Back = Factors reverse
  Down = Back scan * with Seed mod Mod
  InvFacts = Down reverse
  Diff = Point - Nodes
  Before = Diff scan * with 1 mod Mod
  Ahead = Before (0 till Degree + 1)
  Behind = Diff reverse
  After = Behind scan * with 1 mod Mod
  Suffix = After reverse
  End = Degree + 2
  Tail = Suffix (1 till End)
  Weight = Ahead * Tail mod Mod
  Weight = Weight * InvFacts mod Mod
  Reverse = InvFacts reverse
  Weight = Weight * Reverse mod Mod
  Odd = (Degree - Nodes) mod 2 equal 1
  Opposite = Mod - Weight
  Weight = Odd choose Opposite Weight
  Terms = Weight * Values mod Mod
  return Terms sum mod Mod
end

Primes = primes from Lo to Lo + Wd copy
Answer = Primes subtotal rank 0 sum
Answer print
