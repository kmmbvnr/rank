rem Sum of Squares of Divisors
rem https://projecteuler.net/problem=401
use numbers
use sequences
use io
use cli
arg Limit integer = 1000000000000000
Mod = 1000000000
rem S2(q) mod Mod: reduce q mod 6 Mod,
rem then divide the polynomial by 6.
M6 = 6 * Mod
rem Hyperbola split at sqrt(Limit).
Root = Limit isqrt
Tot = 0
for L in 1 to Root by 65536
  Hi = Root min (L + 65535)
  D = L to Hi copy
  Q = Limit // D
  X = Q mod M6
  P = X * (X + 1) mod M6
  S = P * (2 * X + 1) mod M6 // 6
  Tot += (D * D mod Mod *
    (Q mod Mod) mod Mod + S) sum
end
R2 = Root * (Root + 1) * (2 * Root + 1)
Tot -= Root * (R2 // 6)
Answer = Tot mod Mod
return Answer
