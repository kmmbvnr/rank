use testing

test "statement values"
  use "714_duodigits"
  Count = 110
  Longest = 8
  run
  Answer equal "1.104700000000e4"
  Count = 150
  run
  Answer equal "5.331200000000e4"
  Count = 500
  run
  Answer equal "2.957098800000e7"
end

test "residue search for the long cases"
  use "714_duodigits"
  Count = 500
  Longest = 3
  run
  Answer equal "2.957098800000e7"
end
