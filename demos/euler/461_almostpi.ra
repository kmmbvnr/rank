rem Almost Pi
rem https://projecteuler.net/problem=461

use numbers
use sequences
use io
use cli

option N integer = 10000
option C integer = 4000000

rem Meet in the middle: a <= b <= c <=
rem d, so f(a) + f(b) is at most pi/2
rem and f(c) + f(d) at least pi/2, up
rem to the error. Sort both lists of
rem pair sums and merge them in chunks
rem to find near misses, then recover
rem the pairs and rank them exactly.
Pi = 4 * (1.0 atan)
Bm = (N * ((Pi + 1) log)) floor + 1
Ks = (0 to Bm) copy
F = (Ks * 1.0 / N) exp - 1
Ep = 0.000000001
H = Pi / 2
rem How many f(k) are at most T, for
rem the three bounds of every a.
T = concat (H + Ep - F) (H - Ep - F)
T = concat T (Pi + Ep - F)
M1 = Bm + 1
Cn = array shape (T len) fill 0
Sp = 1
for Sp less M1
  Sp *= 2
end
for Sp greater 0
  Ix = Cn + Sp
  Fv = F ((Ix - 1) Bm min)
  Up = (Fv at most T) choose Ix Cn
  Cn = (Ix at most M1) choose Up Cn
  Sp //= 2
end
Lo = Cn
Lb = Lo (0 till M1) - 1
Ua = Lo (M1 till 2 * M1) Ks max
Ub = Lo (2 * M1 till 3 * M1) - 1
Ll = (Lb - Ks + 1) 0 max
Lu = (Ub - Ua + 1) 0 max
Lv = array shape (Ll sum) fill 0.0
Uv = array shape (Lu sum) fill 0.0
Ol = 0
Ou = 0
for A in 0 to Bm
  La = Ll A
  if La greater 0
    Hb = Lb A
    Sl = F A + F (A to Hb)
    Lv (Ol till Ol + La) = Sl
    Ol += La
  end
  Lz = Lu A
  if Lz greater 0
    U0 = Ua A
    U1 = Ub A
    Su = F A + F (U0 to U1)
    Uv (Ou till Ou + Lz) = Pi - Su
    Ou += Lz
  end
end
Ls = Lv sort
Qs = Uv sort
Nl = Ls len
Nq = Qs len
rem Near misses: low sum S and query
rem Q = pi - upper sum within Tau;
rem the best miss is near 30 / N^4.
Tau = 1000.0 / (N ** 4)
Cl = array shape 0 fill 0.0
Cq = array shape 0 fill 0.0
Ce = array shape 0 fill 0.0
for St in 0 till Nq by C
  Se = (St + C) Nq min
  Qc = Qs (St till Se)
  Q0 = Qc 0
  Q1 = Qc last
  I0 = (Ls less Q0) count - 1
  I1 = (Ls at most Q1) count + 1
  I0 = I0 0 max
  I1 = I1 Nl min
  Lc = Ls (I0 till I1)
  Nc = Lc len
  Mg = concat Lc Qc
  Mo = Mg argsort
  Ms = Mg Mo
  Il = Mo less Nc
  Ps = (0 till Mg len) copy
  Pv = (Il choose Ps 0) scan max
  Lt = Mg len - 1
  Rv = (Il choose Ps Lt) reverse
  Nx = (Rv scan min) reverse
  Qp = (Il equal false) indices
  Qv = Ms Qp
  Pl = Ms (Pv Qp)
  Nl2 = Ms (Nx Qp)
  E1 = (Qv - Pl) abs
  E2 = (Nl2 - Qv) abs
  E1 = (Il (Pv Qp)) choose E1 1.0
  E2 = (Il (Nx Qp)) choose E2 1.0
  H1 = (E1 less Tau) indices
  H2 = (E2 less Tau) indices
  Cl = concat Cl (Pl H1) (Nl2 H2)
  Cq = concat Cq (Qv H1) (Qv H2)
  Ce = concat Ce (E1 H1) (E2 H2)
end
rem Keep those that rounding could
rem still make the best.
Cm = Ce min + 0.00000000000001
Kp = (Ce at most Cm) indices
Cl = Cl Kp
Cq = Cq Kp
rem Pairs with a given sum, then the
rem error to 40 digits by the series
rem of exp in integers.
Sc = 10 ** 40
Pw = 314159265358979323846 * 10 ** 20
Pw += 26433832795028841971
Be = -1
Answer = 0
for I in 0 till Cl len
  Pa = Ks (0 till 0)
  Pb = Pa
  Pc = Pa
  Pd = Pa
  for Sd in 0 to 1
    Tg = Cl I
    if Sd equal 1
      Tg = Pi - Cq I
    end
    Ar = (1 + Tg - F) 1.0 max
    Bb = (N * (Ar log) + 0.5) floor
    Bb = Bb 0 max Bm min
    Dv = (F + F Bb - Tg) abs
    Ok = Dv less 0.0000000000001
    Ok = Ok and (Bb at least Ks)
    if Sd equal 0
      Pa = Ks (Ok indices)
      Pb = Bb (Ok indices)
    else
      Pc = Ks (Ok indices)
      Pd = Bb (Ok indices)
    end
  end
  for J in 0 till Pa len
    for L in 0 till Pc len
      Q2 = array (Pa J) (Pb J)
      Q3 = array (Pc L) (Pd L)
      Q4 = concat Q2 Q3
      Tm = Q4 * 0 + Sc
      Sm = Tm
      for R in 1 to 80
        Tm = Tm * Q4 // (N * R)
        Sm += Tm
      end
      Er = (Sm sum - 4 * Sc - Pw) abs
      if Be less 0 or Er less Be
        Be = Er
        Answer = (Q4 * Q4) sum
      end
    end
  end
end
Answer print
