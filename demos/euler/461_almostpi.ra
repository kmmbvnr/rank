rem Almost Pi
rem https://projecteuler.net/problem=461

use algo
use numbers
use sequences
use io
use cli

arg N integer = 10000
arg C integer = 262144

Pi = 4 * (1.0 atan)
LastKey = N * (Pi + 1 log) floor + 1
Keys = 0 to LastKey copy
Values = Keys * 1.0 / N exp - 1
rem One term bounds the best error
rem of four terms, including zeros.
Slack = Values - Pi abs min + 1.0e-12
Half = Pi / 2
Roundoff = 1.0e-14

rem Keep only the smaller pair list.
Limit = Values upperindex (
  Half + Slack - Values)
fun Counts sums
  Ends = Counts scan +
  Offset = Keys - Ends + Counts
  Total = Counts sum
  Sums = array shape Total fill 0.0
  for Start in 0 till Total by C
    Stop = Start + C min Total
    Positions = Start till Stop copy
    Owner = Ends upperindex Positions
    Other = Positions + Offset Owner
    Sums (Start till Stop) = (
      Values Owner + Values Other)
  end
  return Sums
end
Counts = Limit - Keys max 0
Low = Counts sums
Low = Low sort
Last = Low len - 1

rem Stream the other list and find
rem both neighbors in the sorted one.
fun First near End
  Counts = End - First max 0
  Ends = Counts scan +
  Offset = First - Ends + Counts
  Total = Counts sum
  Kept = array shape 0 fill 0.0
  Queries = Kept
  Errors = Kept
  Best = Slack
  for Start in 0 till Total by C
    Stop = Start + C min Total
    Positions = Start till Stop copy
    Owner = Ends upperindex Positions
    Other = Positions + Offset Owner
    Query = Pi - Values Owner
    Query -= Values Other
    At = Low lowerindex Query
    Left = Low (At - 1 max 0)
    Right = Low (At min Last)
    Pairs = concat Left Right
    Targets = concat Query Query
    Misses = Pairs - Targets abs
    Error = Misses min
    Best = Best min Error
    Cutoff = Best + Roundoff
    Keep = Misses at most Cutoff
    Kept = concat Kept (Pairs Keep)
    Queries = concat Queries (
      Targets Keep)
    Errors = concat Errors (Misses Keep)
  end
  Keep = Errors at most Best + Roundoff
  Kept = Kept Keep
  Queries = Queries Keep
  return tuple Kept Queries
end
First = Values lowerindex (
  Half - Slack - Values)
First = First max Keys
End = Values upperindex (
  Pi + Slack - Values)
unpack Sums Queries = First near End

rem Recover pairs only for near misses.
fun Target pairs
  Rest = 1 + Target - Values max 1.0
  Other = N * (Rest log) + 0.5 floor
  Other = Other max 0 min LastKey
  Miss = Values + Values Other
  Miss = Miss - Target abs
  Ready = Miss less 0.0000000000001
  Ordered = Other at least Keys
  Ready = Ready and Ordered
  Left = Keys Ready
  Right = Other Ready
  return tuple Left Right
end
fun Sums candidates Queries
  All = array shape 0 fill 0
  for I in 0 till Sums len
    unpack Left Right = (Sums I) pairs
    Target = Pi - Queries I
    unpack Upper Lower = Target pairs
    LeftCount = Left len
    UpperCount = Upper len
    Width = LeftCount * UpperCount
    Flat = 0 till Width copy
    Row = Flat // UpperCount
    Col = Flat mod UpperCount
    Quad = concat (Left Row) (Right Row)
    Quad = concat Quad (Upper Col)
    Quad = concat Quad (Lower Col)
    Columns = Quad reshape 4 Width
    Matrix = Columns transpose
    Block = Matrix reshape (Width * 4)
    All = concat All Block
  end
  Rows = All len // 4
  return All reshape Rows 4
end
Quads = Sums candidates Queries

rem Rank close candidates to 40 digits.
Scale = 10 ** 40
High = 314159265358979323846
PiWide = High * 10 ** 20
PiWide += 26433832795028841971
fun Quads errors
  Term = Quads * 0 + Scale
  Sum = Term
  for Order in 1 to 80
    Term = Term * Quads // (N * Order)
    Sum += Term
  end
  Totals = Sum sum rank 1
  return Totals - 4 * Scale - PiWide abs
end
Errors = Quads errors
Best = Errors min
Winner = Errors first index where (
  Errors equal Best)
Winning = Quads Winner
Answer = Winning * Winning sum
Answer print
