use testing

test "default input"
  use "159_digitalrootsums" as solve
  Out = solve
  Answer = Out .answer

  Answer equal 14489159
end

test "smaller limits"
  use "159_digitalrootsums" as solve
  Out = solve 100
  Answer = Out .answer
  Best = Out .best

  Best 24 equal 11
  Answer equal 856
  Out = solve 1000
  Answer = Out .answer
  Best = Out .best

  Answer equal 10901
end
