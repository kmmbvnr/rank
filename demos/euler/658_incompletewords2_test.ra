use testing

test "statement values"
  use "658_incompletewords2" as solve
  Answer = solve 4 4
  Answer equal 406
  Answer = solve 8 8
  Answer equal 27902680
  Answer = solve 10 100
  Answer equal 983602076
end

test "default input"
  use "658_incompletewords2" as solve
  Answer = solve 10000000 1000000000000
  Answer equal 958280177
end
