rem Faulhaber's Formulas
rem https://projecteuler.net/problem=545

use numbers
use sequences
use io
use cli

arg Q integer = 100000

rem von Staudt-Clausen: the denominator
rem 20010 needs k = 308 m. Other primes
rem p forbid multiples of (p - 1) / g,
rem where g = gcd(p - 1, 308).
Base = 308
Groups = array 2 4 14 22 28 44 154 308
Other = Base // Groups

fun Count solve
  if Count equal 1
    return Base
  end
  fun State advance
    Limit = State 0
    Sieve = Base * Limit + 1 primesieve
    Size = Limit + 1
    Flags = array shape Size fill true
    Flags 0 = false
    rem m = 1 gives the required primes.
    rem Later m can only add bad primes.
    for M in 2 to Limit
      if Flags M
        Candidates = Groups * M + 1
        Forbidden = Candidates in Sieve
        Coprime = M gcd Other equal 1
        Bad = Forbidden and Coprime
        if Bad any
          Multiples = M to Limit by M
          Flags Multiples = false
        end
      end
    end
    Matches = Flags indices
    Value = 0
    if Matches len at least Count
      Value = Base * Matches (Count - 1)
    end
    return tuple (Limit * 2) Value
  end
  fun Previous done Next
    return Next 1 greater 0
  end
  rem Starting guess; double if needed.
  Initial = Count * 32 max 1024
  Seed = tuple Initial 0
  Final = (
    Seed advance repeat 32 till done
  )
  return Final 1
end

Answer = Q solve
Answer print
