use testing

test "default input"
  use "294_sumofdigits" as solve
  Answer = solve

  Answer equal 789184709
end

test "empty input and period boundary"
  use "294_sumofdigits" as solve
  Answer = solve 0 1000000000000000000

  Answer equal 0
  Answer = solve 21 1000000000000000000

  Answer equal 41240469344
  Answer = solve 22 1000000000000000000

  Answer equal 86617444562
  Answer = solve 23 1000000000000000000

  Answer equal 177511312014
end

test "moduli divisible by 23"
  use "294_sumofdigits" as solve
  Answer = solve 44 23

  Answer equal 1
  Answer = solve 44 529

  Answer equal 139
  Answer = solve 44 1

  Answer equal 0
end

test "problem examples"
  use "294_sumofdigits" as solve
  Answer = solve 9 1000000000000000000

  Answer equal 263626
  Answer = solve 42 1000000000000000000

  Answer equal 6377168878570056
end
