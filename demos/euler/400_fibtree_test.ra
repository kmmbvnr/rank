use testing
use sequences

test "Fibonacci tree checkpoints"
  use "400_fibtree" as solve
  Out = solve 5
  Answer = Out .answer
  Answer equal 1
  Out = solve 10
  Answer = Out .answer
  Answer equal 17
end

test "Grundy values"
  use "400_fibtree" as solve
  use sequences
  Out = solve 10
  Gs = Out .gs
  Want = array 0 0 1 3 6 3
  Want = concat Want (array 3 0 5 7 14)
  Gs equal Want
end

test "Fibonacci tree boundary cases"
  use "400_fibtree" as solve
  Out = solve 0
  Answer = Out .answer
  Answer equal 0
  Out = solve 1
  Answer = Out .answer
  Answer equal 0
  Out = solve 2
  Answer = Out .answer
  Answer equal 1
end

test "Exact Fibonacci tree counts"
  use "400_fibtree" as solve
  Out = solve 100
  Answer = Out .answer
  Answer equal 580893155023212545
end
