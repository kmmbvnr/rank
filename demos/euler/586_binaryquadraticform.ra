rem Binary Quadratic Form
rem https://projecteuler.net/problem=586

rem For x made of split primes, a norm
rem x * 5^t * u^2 has floor(tau(x)/2)
rem forms when u uses inert primes.
rem The exponent factors of tau(x) are
rem the exponents plus one.
rem Split residues are 1 and 4 mod 5.
rem Inert residues are 2 and 3 mod 5.
use numbers
use sequences
use bits
use algo
use io
use cli
arg N integer = 1000000000000000
arg R integer = 40

rem A power-of-two bound suffices.
fun Bound root_cap Power
  if Power equal 1 or (Bound less 2)
    return Bound
  end
  if Power equal 2
    return Bound isqrt
  end
  Bits = Bound binary len
  Shift = (Bits + Power - 1) // Power
  return 2 ** Shift
end

Base = 2 * R + 2
Depth = Base binary len
Radix = array shape Depth fill Base

fun Need patterns
  if Need equal 1
    return array 0
  end
  Choices' = Need divisors from 2
  fun Choice extend rank 0
    Rest = Need // Choice
    Tails = Rest patterns
    Codes = Tails * Base + Choice - 1
    return Codes
  end
  Parts' = Choices extend
  return concat unpack Parts copy
end

fun Code exponents
  Digits = Code digits Radix
  return Digits (Digits greater 0) copy
end

Prime' = primes
Residue' = Prime mod 5
SmallSide' = Residue equal 1
LargeSide' = Residue equal 4
Split' = SmallSide or LargeSide
First' = Prime filter Split
Tiny = First take Depth array

fun Code minimum rank 0
  Exps = Code exponents
  Count = Exps len
  Terms = Tiny (0 till Count) ** Exps
  return Terms reduce * with 1
end

fun Code prime_limit rank 0
  Exps = Code exponents
  Last = Exps len - 1
  Prefix = Exps (0 till Last)
  Terms = Tiny (0 till Last) ** Prefix
  Product = Terms reduce * with 1
  Bound = N // Product
  Power = Exps Last
  return Bound root_cap Power
end

Codes = array shape 0 fill 0
if R greater 0
  Even = 2 * R patterns
  Odd = 2 * R + 1 patterns
  Codes = concat Even Odd copy
end
Minima = Codes minimum
Good = Minima at most N
Codes = Codes Good
Minima = Minima Good
Least = N + 1
PrimeLimit = 0
if Codes len greater 0
  Least = Minima min
  Bounds = Codes prime_limit
  PrimeLimit = Bounds max
end
Primes = PrimeLimit primesieve array
Residues = Primes mod 5
Low = Residues equal 1
Good = Low or (Residues equal 4)
Primes = Primes Good
Limit = N // Least

fun X inert rank 0
  Factors = X factors array
  Residues = Factors mod 5
  Low = Residues equal 2
  Good = Low or (Residues equal 3)
  return Good all
end
Root = Limit isqrt
Bases = 1 to Root copy
Bases = Bases (Bases inert)
Squares = Bases * Bases
Width = Squares len
Column = Squares reshape Width 1
Bits = Limit binary len
Powers = 5 ** (0 to Bits // 2 copy)
Grid = Column * Powers
Size = Width * (Powers len)
Values = Grid reshape Size
Values = Values (Values at most Limit)
Inert = Values sort

fun Counts expand
  Ends = Counts scan +
  Begins = Ends - Counts
  Size = Counts sum
  Slots = 0 till Size copy
  Rows = Ends upperindex Slots
  return record
    .rows = Rows
    .steps = Slots - Begins Rows
  end
end

fun Exps minima Window
  Count = Exps len
  if Count equal 1
    return Window ** Exps 0 copy
  end
  Size = Window len - Count + 1
  Head = Window (0 till Size)
  Tail = Window (1 till (Window len))
  Rest = Exps (1 till Count)
  Suffix = Rest minima Tail
  return Head ** Exps 0 * Suffix copy
end

fun Exps walk State
  Products = State .products
  From = State .from
  Count = Exps len
  Power = Exps 0
  Bounds = N // Products
  Budget = Bounds max
  if Count equal 1
    Powers = Primes
    if Power greater 1
      Last = Budget root_cap Power
      End = Primes upperindex Last
      Slice = Primes (0 till End)
      Powers = Slice ** Power
    end
    rem Count the unit scale separately.
    Stops = Powers upperindex Bounds
    Total = Stops - From sum
    Caps = Bounds // Powers From
    Widths = Inert upperindex Caps
    Widths -= 1
    Layout = Widths expand
    Rows = Layout .rows
    Steps = Layout .steps + 1
    Targets = Bounds Rows // Inert Steps
    Stops = Powers upperindex Targets
    Extra = Stops - From Rows sum
    return Total + Extra
  end
  Weight = Exps sum
  rem Consecutive primes give the
  rem cheapest suffix at each offset.
  Last = Budget root_cap Weight
  End = Primes upperindex Last
  Size = Primes len
  Finish = End + Count - 1 min Size
  Window = Primes (0 till Finish)
  Minimum = Exps minima Window
  Stops = Minimum upperindex Bounds
  Widths = Stops - From max 0
  Layout = Widths expand
  Rows = Layout .rows
  Positions = From Rows + Layout .steps
  Powers = Primes Positions ** Power
  Products = Products Rows * Powers
  Next = record
    .products = Products
    .from = Positions + 1
  end
  Remain = Exps (1 till Count)
  return Remain walk Next
end

fun Code solve rank 0
  Exps = Code exponents
  Seed = record
    .products = array 1
    .from = array 0
  end
  return Exps walk Seed
end
Answer = Codes solve sum
return Answer
