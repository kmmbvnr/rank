rem Random Connected Area
rem https://projecteuler.net/problem=701

use bits
use sequences
use io
use cli

arg Width integer = 7
arg Height integer = 7

if Width less 1 or Height less 1
  raise "grid sides must be positive"
end
Span = Width min Height
Cells = Width * Height
if Span greater 7
  raise "frontier width exceeds 7"
end
if Cells greater 63
  raise "packed area exceeds 63"
end

Slots = 0 till Span
State = record
  .tags = array shape 1 Span fill 0
  .sizes = array shape 1 Span fill 0
  .best = array shape 1 fill 0
  .ways = array shape 1 fill 1
end
for Cell in 0 till Cells
  Row = Cell mod Span
  Empty = State blank Row
  Filled = State paint Row
  State = Empty coalesce Filled
end
Ways = State .ways
Best = State .best
Sum = Ways * Best sum
Answer = Sum real / (2 ** Cells)
Answer print

fun State blank Row
  Tags = State .tags
  Sizes = State .sizes
  Old = Tags # (array Row)

  rem Empty cells may rename a region.
  Keep = Slots not equal Row
  Clear = Keep choose Tags 0
  Match = Clear equal Old
  First = Match choose (Slots + 1) 8
  Root = First min rank 1 reshape # 1
  Move = Match and Old equal Row + 1
  Empty = Move choose Root Clear
  Small = Keep choose Sizes 0

  return record
    .tags = Empty
    .sizes = Small
    .best = State .best
    .ways = State .ways
  end
end

fun State paint Row
  Tags = State .tags
  Sizes = State .sizes
  Old = Tags # (array Row)
  Part = Sizes # (array Row)
  Near = (Row - 1) max 0
  Left = Tags # (array Near)
  Side = Sizes # (array Near)
  Up = (Row greater 0) choose Left 0
  Extra = (Row greater 0) choose Side 0

  rem Filled cells join both neighbors.
  Touch = Tags equal Old
  Neighbors = Touch or Tags equal Up
  Live = Neighbors and Tags greater 0
  Join = Live or Slots equal Row
  Above = (Old greater 0) choose Old 8
  Beside = (Up greater 0) choose Up 8
  Label = Above min Beside min (Row + 1)
  Full = Join choose Label Tags
  Same = Up equal Old
  More = Same choose 0 Extra
  Total = 1 + Part + More
  Large = Join choose Total Sizes
  Open = Total reshape #
  Peak = (State .best) max Open

  return record
    .tags = Full
    .sizes = Large
    .best = Peak
    .ways = State .ways
  end
end

fun Empty coalesce Filled
  rem Merge weights of equal states.
  Labels = (concat (Empty .tags)
    (Filled .tags))
  Areas = (concat (Empty .sizes)
    (Filled .sizes))
  Best = (concat (Empty .best)
    (Filled .best))
  Key = Labels Areas Best pack
  Weight = (concat (Empty .ways)
    (Filled .ways))
  Order = Key argsort
  Sorted = Key Order
  Prev = Sorted shift 1 with -1
  Change = Sorted not equal Prev
  Marks = Change integer
  Group = (Marks scan +) - 1
  Weights = Weight Order
  Counts = Weights sum by Group
  Unique = Sorted Change
  Frame = (Unique shr 6) reshape # 1
  Bits = Frame shr (3 * Span)
  Decoded = Bits shr (6 * Slots) band 63
  return record
    .tags = Frame shr (3 * Slots) band 7
    .sizes = Decoded
    .best = Unique band 63
    .ways = Counts
  end
end

fun Labels Areas Best pack
  Parts = Areas shl (6 * Slots)
  Sizes = Parts sum axis 1
  Packed = Sizes shl (3 * Span)
  Bits = Labels shl (3 * Slots)
  Tags = Bits sum axis 1
  Key = Tags + Packed
  return (Key shl 6) + Best
end
