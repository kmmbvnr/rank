rem High Powers of Irrational Numbers
rem https://projecteuler.net/problem=721

use numbers
use sequences
use bits
use io
use cli

arg Limit integer = 5000000
arg Prime integer = 999999937

rem With m = ceil(sqrt a), (m + s)^n and
rem (m - s)^n, s = sqrt a, sum to the
rem integer U = 2X, where (m + s)^n =
rem X + Y s. The conjugate lies in
rem (0, 1) unless a is a square, so the
rem floor is U - 1 (U for squares).
rem Every a is powered to n = a^2 at
rem once by binary exponentiation in
rem pairs (x, y) mod p.
Values = 1 to Limit
Ceil = (Values - 1) isqrt + 1
Roots = Values isqrt
Square = Roots ** 2 equal Values
Exponents = Values * Values
ResX = Values * 0 + 1
ResY = Values * 0
BaseX = Ceil
BaseY = Values * 0 + 1
for Bit in 0 to 45
  Digit = (Exponents shr Bit) band 1
  Take = Digit equal 1
  CrossY = ResY * BaseY mod Prime
  CrossX = ResX * BaseX mod Prime
  Mixed = CrossX + Values * CrossY
  NextX = Mixed mod Prime
  Cross = ResX * BaseY + ResY * BaseX
  NextY = Cross mod Prime
  ResX = Take choose NextX ResX
  ResY = Take choose NextY ResY
  SquareY = BaseY * BaseY mod Prime
  SquareX = BaseX * BaseX mod Prime
  Joined = SquareX + Values * SquareY
  NewX = Joined mod Prime
  BaseY = (2 * BaseX * BaseY) mod Prime
  BaseX = NewX
end
Trace = 2 * ResX mod Prime
NotSquare = (Square equal false) integer
Floors = Trace - NotSquare
Answer = Floors sum mod Prime
return Answer
