rem Bidirectional Recurrence
rem https://projecteuler.net/problem=505

use numbers
use sequences
use bits
use io
use cli

option N integer = 1000000000000

rem x_2k = 3 x_k + 2 x_(k/2), x_(2k+1)
rem = 2 x_k + 3 x_(k/2), mod 2^60. The
rem leaves n .. 2n-1 fold up by max
rem and min. Embed in a full layer of
rem 2^h leaves: dyadic blocks left of
rem 2n are subtrees, blocks right of
rem it are complements of subtrees one
rem level lower. Subtrees: alpha-beta,
rem better child first, as a loop with
rem an explicit stack (the search is
rem sequential).
Q = 1152921504606846976
Mk = Q - 1
fun K tree D
  rem Value of the depth-D subtree at K.
  X = 1
  Pr = 0
  if K equal 0
    X = 0
  end
  Hb = 0
  for 2 ** (Hb + 1) at most K
    Hb += 1
  end
  for I in Hb - 1 to 0 by -1
    if Hb equal 0
      break
    end
    Bt = (K // 2 ** I) mod 2
    Nx = (3 - Bt) * X + (2 + Bt) * Pr
    Nx = Nx mod Q
    Pr = X
    X = Nx
  end
  if D equal 0
    return X
  end
  rem Stack: node, parent, depth,
  rem alpha, beta, other child, stage.
  Sx = array shape (D + 1) fill 0
  Sp = Sx
  Sd = Sx
  Sa = Sx
  Sb = Sx
  Sr = Sx
  Sg = Sx
  Sx 0 = X
  Sp 0 = Pr
  Sd 0 = D
  Sa 0 = 0
  Sb 0 = Mk
  Sg 0 = 0
  T = 0
  Rv = 0
  Rt = false
  for T at least 0
    if Rt
      rem A child returned Rv.
      Mx = Sd T mod 2 equal 1
      if Sg T equal 1
        if Mx
          Sa T = Sa T max Rv
        else
          Sb T = (Sb T) min Rv
        end
        if Sa T at least Sb T
          Rv = Mx choose (Sa T) (Sb T)
          T -= 1
        else
          Sg T = 2
          Rt = false
          U = T + 1
          Sx U = Sr T
          Sp U = Sx T
          Sd U = Sd T - 1
          Sa U = Sa T
          Sb U = Sb T
          Sg U = 0
          T = U
        end
      else
        if Mx
          Rv = Sa T max Rv
        else
          Rv = (Sb T) min Rv
        end
        T -= 1
      end
    else
      X = Sx T
      Pr = Sp T
      L = (3 * X + 2 * Pr) mod Q
      R = (2 * X + 3 * Pr) mod Q
      Mx = Sd T mod 2 equal 1
      Lo = L min R
      Hi = L max R
      Fi = Mx choose Hi Lo
      Se = Mx choose Lo Hi
      if Sd T equal 1
        Rv = Fi
        Rt = true
        T -= 1
      else
        Sr T = Se
        Sg T = 1
        U = T + 1
        Sx U = Fi
        Sp U = X
        Sd U = Sd T - 1
        Sa U = Sa T
        Sb U = Sb T
        Sg U = 0
        T = U
      end
    end
  end
  return Rv
end
fun S D Bs Ll node
  rem A fully left or right block.
  J0 = Bs + S
  if S + 2 ** D at most Ll
    Kl = J0 // 2 ** D
    return Kl tree D
  end
  Dk = D max 1
  Ky = J0 // 2 ** Dk
  Dm = Dk - 1
  Tv = Ky tree Dm
  return Mk - Tv
end
Answer = 1
if N greater 1
  H = 0
  for 2 ** (H + 1) at most 2 * N - 1
    H += 1
  end
  Bs = 2 ** H
  Ll = 2 * N - Bs
  rem Walk down the one partial path,
  rem keeping the sibling blocks.
  Sv = array shape (H + 1) fill 0
  S = 0
  D = H
  Fl = S + 2 ** D at most Ll
  Fl = Fl or S at least Ll
  for Fl equal false
    Hf = 2 ** (D - 1)
    Dm = D - 1
    Sn = S + Hf
    if Ll at most Sn
      Sv D = Sn Dm Bs Ll node
    else
      Sv D = S Dm Bs Ll node
      S = Sn
    end
    D -= 1
    Fl = S + 2 ** D at most Ll
  Fl = Fl or S at least Ll
  end
  Z = S D Bs Ll node
  for E in D + 1 to H
    if E mod 2 equal 1
      Z = Z max (Sv E)
    else
      Z = Z min (Sv E)
    end
  end
  Answer = Z
  if H mod 2 equal 1
    Answer = Mk - Z
  end
end
Answer print
