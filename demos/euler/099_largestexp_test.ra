use testing

test "default input"
  use "099_largestexp"
  run

  Answer equal 709
end

test "statement pair and single line"
  use "099_largestexp"
  use io
  Input = "/tmp/euler099.txt"
  "2,11\n3,7\n" write "/tmp/euler099.txt"
  run

  Answer equal 2
  "3,7\n2,11\n" write "/tmp/euler099.txt"
  run

  Answer equal 1
  "5,5\n" write "/tmp/euler099.txt"
  run

  Answer equal 1
end
