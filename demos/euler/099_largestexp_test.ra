use testing

test "default input"
  use "099_largestexp"
  run

  Answer equal 709
end

test "statement pair"
  use "099_largestexp"

  Lines = array "2,11" "3,7"
  Lines largest_line equal 2
  Back = array "3,7" "2,11"
  Back largest_line equal 1
end

test "single line"
  use "099_largestexp"

  (array "5,5") largest_line equal 1
end
