use testing

test "brute force prefixes"
  use "538_maxquadrilaterals"
  N = 5
  run
  Answer equal 99
  N = 120
  run
  Answer equal 138648
  N = 3000
  run
  Answer equal 397768273
end


test "prefixes without four sides"
  use "538_maxquadrilaterals"
  N = 0
  run
  Answer equal 0
  N = 3
  run
  Answer equal 0
end
