use testing

test "brute force prefixes"
  use "538_maxquadrilaterals" as solve
  Answer = solve 5
  Answer equal 99
  Answer = solve 120
  Answer equal 138648
  Answer = solve 3000
  Answer equal 397768273
end


test "prefixes without four sides"
  use "538_maxquadrilaterals" as solve
  Answer = solve 0
  Answer equal 0
  Answer = solve 3
  Answer equal 0
end
