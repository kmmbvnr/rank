rem Squarefree Gaussian Integers
rem https://projecteuler.net/problem=556
use numbers
use sequences
use io
use cli
arg N integer = 100000000000000
rem Mobius weights of Gaussian norms.
fun Limit weights
  Root = Limit isqrt
  Last = Root max 2
  Primes = primes to Last copy
  Size = Limit + 1
  Weights = array shape Size fill 1
  Rest = 0 to Limit copy
  Map = array 0 -1 0 0 0 -2 1 0 0 0 -1 0
  for Prime in Primes
    Span = Prime to Limit by Prime array
    Quotient = Span // Prime
    Divides = Quotient mod Prime equal 0
    Exponent = 1 + (Divides integer)
    Square = Prime * Prime
    Cubed = Quotient mod Square equal 0
    Exponent += Cubed integer
    Class = 2
    if Prime equal 2
      Class = 0
    elif Prime mod 4 equal 1
      Class = 1
    end
    Row = Class * 4 + Exponent
    Factor = Map Row
    Weights Span = Weights Span * Factor
    Powers = Prime ** Exponent
    Rest Span = Rest Span // Powers
  end
  Tail = array 0 -2 0 0
  Factor = Tail (Rest mod 4)
  Factor = Rest equal 1 choose 1 Factor
  Result = Weights * Factor
  Result 0 = 0
  return Result
end
rem Count a quarter disc, without zero.
fun Norm disc
  Root = Norm isqrt
  Half = Norm // 2 isqrt
  Axis = 1 to Half copy
  Heights = Norm - Axis * Axis isqrt
  Area = Heights sum
  return Root + 2 * Area - Half * Half
end
Limit = N isqrt
Weights = Limit weights
Prefix = Weights scan +
rem Split at the approximate cube root.
Approx = (2.0 * N) ** 0.3333333333333333
Cut = Approx floor integer min Limit
Small = 1 to Cut copy
First = Weights Small
Quotients = N // (Small * Small)
Next = Cut + 1
Last = N // (Next * Next)
Tail = 1 to Last copy
Upper = N // Tail isqrt
Lower = N // (Tail + 1) isqrt
Lower = Lower max Cut
Grouped = Prefix Upper - Prefix Lower
Norms = concat Quotients Tail
Weights = concat First Grouped
Active = Weights not equal 0 indices
Norms = Norms Active
Weights = Weights Active
Counts = Norms disc rank 0
Answer = Weights * Counts sum
Answer print
