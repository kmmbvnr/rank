rem Poohsticks Marathon
rem https://projecteuler.net/problem=589
use numbers
use sequences
use linalg
use algo
use io
use cli
arg K integer = 100
arg D integer = 5

rem Sum expected minima without a scan.
fun X cost_sum U Q
  Cut = X - U max 0
  Triangle = X * (X + 1) / 2.0
  Subtract = Cut * (Cut + 1) * (Cut + 2)
  return Triangle - Subtract / (6.0 * Q)
end

rem Eliminate X and both means first.
rem The remaining system has V rows.
fun M expectation N rank 0 0
  V = M + D
  R = 1 to V copy
  U = N + D
  Q = M - N + 1
  Rate = 1.0 / Q
  Cube = 2.0 * Rate * Rate * Rate
  Scale = Cube / (Q - 1)
  First = U * 1.0
  Last = V * 1.0
  Width = Q * 1.0
  fun Row coefficient Column
    Small = Row min Column
    Large = Row max Column
    LowerBound = First - Small max 1.0
    End = Last - Large
    Extent = End - LowerBound + 1.0
    Overlap = Extent max 0.0
    Distance = Width - Row
    Corner = Distance - Column max 0.0
    Left = Row at least First integer
    High = Column at least First integer
    H = Left * High
    Count = Overlap + Corner + H
    LeftTail = Distance max 0.0
    RightTail = Width - Column max 0.0
    Cross = LeftTail * RightTail
    Diagonal = Row equal Column integer
    Scaled = Count * Rate * Rate
    Correction = Cross * Scale
    Main = Diagonal - Scaled
    return Main - Correction
  end
  rem Homogeneous real min/max operands.
  Real = R * 1.0
  Rows = Real reshape V 1
  Matrix = Rows coefficient Real
  Tail = Q - R max 0
  Cut = R - U max 0
  Penalty = Cut * (Cut + 1) * Rate
  Cost = R - Penalty / 2.0
  Average = Q * (U + V) / 2.0
  Spread = (Q * Q - 1) / 6.0
  SumCost = Average - Spread
  Upper = V - R
  Lower = U - R - 1 max 0
  HighCost = Upper cost_sum U Q
  LowCost = Lower cost_sum U Q
  Mean = (HighCost - LowCost) * Rate
  Boost = SumCost * Rate * Rate
  Extra = Boost / (Q - 1)
  Right = Cost + Mean + Tail * Extra
  Lead = Matrix solve Right
  Dot = Tail matmul Lead
  Dot *= 2.0 * Rate
  Even = (SumCost + Dot) / (Q - 1.0)
  Gaps = 1 till Q copy
  Early = Lead (0 till Q - 1)
  Terms = (Q - Gaps) * Early
  Future = Terms sum
  Steps = (Q - 1) * (2 * Q - 1)
  Opening = N + Steps / (6.0 * Q)
  Rest = 2 * Future + Q * Even
  return Opening + Rest * Rate * Rate
end

rem Expand pairs without nested loops.
High = 2 to K copy
Lengths = High - 1
Ends = Lengths scan +
Starts = Ends - Lengths
Size = Lengths sum
Slots = 0 till Size copy
Owners = Ends upperindex Slots
Low = Slots - Starts Owners + 1
High = High Owners
Values = High expectation Low
Total = Values sum
Answer = 0.0 + Total
Answer = Answer round 2
return Answer
