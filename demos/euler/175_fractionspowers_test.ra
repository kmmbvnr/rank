use testing

test "default input"
  use "175_fractionspowers" as solve
  Answer = solve

  Answer equal "1,13717420,8"
end

test "small fractions"
  use "175_fractionspowers" as solve
  Answer = solve 2 1

  Answer equal "1,1"
  Answer = solve 3 2

  Answer equal "2,1"
  Answer = solve 5 3

  Answer equal "1,1,1,1"
end
