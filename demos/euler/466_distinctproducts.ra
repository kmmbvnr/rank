rem Distinct multiplication-table terms
rem https://projecteuler.net/problem=466
use numbers
use sequences
use bits
use io
use cli
arg M integer = 64
arg N integer = 10000000000000000

rem Give products to their largest row.
rem Row e takes d*c if e/gcd(e,d)
rem divides c. Keep minimal blockers.
fun Row blockers Rows
  Later = Row + 1 to Rows copy
  Values = Later // (Later gcd Row)
  Values = Values unique sort
  Remainders = Values Values outer mod
  Divides = Remainders equal 0
  Counts = Divides count rank 1
  return Values (Counts equal 1)
end

rem Equal obstruction sets share work.
rem A scalar bitset is a memo key.
memo Limit avoiding Mask
  Text = Mask binary
  Width = Text len
  Positions = 0 till Width
  Flags = Mask bit Positions
  Factors = Flags indices + 1
  Keys = array 1
  Weights = array 1
  for Factor in Factors
    Next = Keys lcm Factor
    Valid = Next at most Limit indices
    Joined = concat Keys (Next Valid)
    Negative = 0 - Weights Valid
    Signed = concat Weights Negative
    Order = Joined argsort
    Joined = Joined Order
    Signed = Signed Order
    Next = Joined shift -1 with -1
    Ends = Joined not equal Next indices
    Totals = (Signed scan +) Ends
    Totals -= Totals shift 1
    Keep = Totals not equal 0 indices
    Keys = (Joined Ends) Keep
    Weights = Totals Keep
  end
  Terms = Weights * (Limit // Keys)
  return Terms sum
end

Rows = M min N
Limit = M max N
Answer = 0
for Row in 1 to Rows
  Factors = Row blockers Rows
  Bits = 1 shl (Factors - 1)
  Mask = Bits sum
  Answer += Limit avoiding Mask
end
Answer print
