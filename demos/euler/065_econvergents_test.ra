use testing

test "default input"
  use "065_econvergents" as solve
  Out = solve
  Answer = Out .answer

  Answer equal 272
end

test "tenth convergent from the statement"
  use "065_econvergents" as solve
  Out = solve 10
  Answer = Out .answer
  Num = Out .num

  Num equal 1457
  Answer equal 17
end

test "second convergent"
  use "065_econvergents" as solve
  Out = solve 2
  Num = Out .num

  Num equal 3
end
