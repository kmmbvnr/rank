use testing

rem Small cases and strict prime bounds.
test "small limits"
  use "273_sumofsquares"
  Limit = 20
  run

  Answer equal 80
  Limit = 40
  run

  Answer equal 12006
  Limit = 60
  run

  Answer equal 2579619
end

test "prime boundaries and full answer"
  use "273_sumofsquares"
  Limit = 5
  run
  Answer equal 0
  Limit = 6
  run
  Answer equal 1
  Limit = 150
  run
  Answer equal 2032447591196869022
end
