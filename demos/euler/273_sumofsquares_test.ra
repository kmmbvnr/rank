use testing

rem Small cases and strict prime bounds.
test "small limits"
  use "273_sumofsquares" as solve
  Answer = solve 20

  Answer equal 80
  Answer = solve 40

  Answer equal 12006
  Answer = solve 60

  Answer equal 2579619
end

test "prime boundaries"
  use "273_sumofsquares" as solve
  Answer = solve 5
  Answer equal 0
  Answer = solve 6
  Answer equal 1
end

test "full-scale checkpoint"
  use "273_sumofsquares" as solve
  Answer = solve 150
  Answer equal 2032447591196869022
end
