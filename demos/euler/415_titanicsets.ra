rem Titanic Sets
rem https://projecteuler.net/problem=415

use numbers
use sequences
use io
use cli

arg N integer = 100000000000
arg L integer = 5000000

rem A set is not titanic when it is
rem empty, one point or at least three
rem collinear points. With n = N + 1
rem and P(l) the number of point pairs
rem l primitive steps apart,
rem P(l) = 4 n^2 F0(m) - 6 n l F1(m) +
rem 2 l^2 F2(m), m = N // l, Fj the
rem sum of k^j phi(k), the count is
rem 1 + n^2 + sum of P(l) (2^(l-1) -
rem 1). Fj come from prefix tables up
rem to L and, above L, from
rem Fj(x) = T - sum over k >= 2 of
rem k^j Fj(x // k). Sums over l run by
rem blocks of equal m.
fun X triangle Mod
  Odd = X mod 2
  Left = X // (2 - Odd) mod Mod
  Right = (X + 1) // (1 + Odd) mod Mod
  return Left * Right mod Mod
end

fun X squares Mod
  Six = 6 * Mod
  Left = X mod Six
  Middle = (X + 1) mod Six
  Right = (2 * X + 1) mod Six
  Part = Left * Middle mod Six
  return Part * Right mod Six // 6
end

fun Limit prefixes Mod
  Root = Limit isqrt
  Primes = primes to Root copy
  Count = Primes len
  rem Four bits per decimal digit bound
  rem every prime-power exponent.
  Width = Limit text len
  Levels = 4 * Width
  Rows = Primes reshape Count 1
  Grid = Rows ** (1 to Levels copy)
  Flat = Grid reshape (Count * Levels)
  Keep = Flat at most Limit indices
  Powers = Flat Keep
  Bases = Primes (Keep // Levels)
  Phi = 0 to Limit copy
  Size = Limit + 1
  Smooth = array shape Size fill 1
  Count = Powers len
  for I in 0 till Count
    P = Bases I
    Q = Powers I
    Slots = Q to Limit by Q
    Smooth Slots *= P
    if Q equal P
      Phi Slots -= Phi Slots // P
    end
  end
  Integers = 0 to Limit copy
  Rest = Integers // Smooth
  Extra = Rest greater 1
  Prior = Phi
  Reduced' = Prior - Prior // Rest
  Phi = Extra choose Reduced Prior copy
  Phi 0 = 0
  Residues = Integers mod Mod
  F0 = Phi mod Mod
  F1 = Residues * F0 mod Mod
  F2 = Residues * F1 mod Mod
  Cs = (F0 scan + with 0) mod Mod
  C0 = Cs (1 to Limit + 1) copy
  Cs = (F1 scan + with 0) mod Mod
  C1 = Cs (1 to Limit + 1) copy
  Cs = (F2 scan + with 0) mod Mod
  C2 = Cs (1 to Limit + 1) copy
  return tuple C0 C1 C2
end

Mod = 100000000
Root = N isqrt + 2
Limit = L max Root min N
unpack C0 C1 C2 = Limit prefixes Mod
CacheSize = N // Limit
L0 = array shape (CacheSize + 2) fill 0
L1 = array shape (CacheSize + 2) fill 0
L2 = array shape (CacheSize + 2) fill 0
for I in CacheSize to 1 by -1
  X = N // I
  if X greater Limit
    R = X isqrt
    K0 = X // (Limit + 1) min R
    rem k <= K0: X // k > Limit, so the
    rem recursion tables L0, L1, L2.
    Pa0 = 0
    Pa1 = 0
    Pa2 = 0
    if K0 at least 2
      Ka = 2 to K0 copy
      Ia = I * Ka
      Va = L0 Ia
      Pa0 += Va sum
      Wa = L1 Ia
      Pa1 += Ka * Wa mod Mod sum
      Za = L2 Ia
      Ka2 = Ka * Ka mod Mod
      Pa2 += Ka2 * Za mod Mod sum
    end
    rem k > K0: X // k fits the prefix
    rem tables C0, C1, C2.
    if R greater K0
      Kb = K0 + 1 to R copy
      Yb = X // Kb
      Pa0 += C0 Yb sum
      Pa1 += Kb * C1 Yb mod Mod sum
      Kb2 = Kb * Kb mod Mod
      Pa2 += Kb2 * C2 Yb mod Mod sum
    end
    Qm = X // (R + 1)
    Qs = 1 to Qm copy
    Hi = X // Qs
    Lo = X // (Qs + 1) max R
    D0 = (Hi - Lo) mod Mod
    Ta = Hi triangle Mod
    Tb = Lo triangle Mod
    D1 = (Ta - Tb) mod Mod
    Sa = Hi squares Mod
    Sb = Lo squares Mod
    D2 = (Sa - Sb) mod Mod
    Pb0 = D0 * C0 Qs mod Mod sum
    Pb1 = D1 * C1 Qs mod Mod sum
    Pb2 = D2 * C2 Qs mod Mod sum
    X6 = X squares Mod
    X2 = X triangle Mod
    L0 I = (X2 - Pa0 - Pb0) mod Mod
    L1 I = (X6 - Pa1 - Pb1) mod Mod
    Square = X2 * X2 mod Mod
    L2 I = (Square - Pa2 - Pb2) mod Mod
  end
end
Nn = N + 1
Nm = Nn mod Mod
rem Single l up to the root.
R2 = N isqrt
Ls = 1 to R2 copy
Ms = N // Ls
Sk = Ms at most Limit
Mc = Ms min Limit
Ic = Ls min CacheSize
G0 = Sk choose (C0 Mc) (L0 Ic)
G1 = Sk choose (C1 Mc) (L1 Ic)
G2 = Sk choose (C2 Mc) (L2 Ic)
Lq = Ls mod Mod
Na = 4 * Nm * Nm mod Mod
Pl = Na * G0 mod Mod
Nb = 6 * Nm * Lq mod Mod
Pl = Pl - Nb * G1 mod Mod
Ls2 = Lq * Lq mod Mod
Pl = Pl + 2 * Ls2 * G2 mod Mod
Tw = 2 (Ls - 1) Mod powmod
Tm1 = (Tw - 1) mod Mod
Su1 = Pl mod Mod * Tm1 mod Mod sum
rem Blocks of equal m above the root.
Mc2 = N // (R2 + 1)
Mb = (1 to (Mc2 max 1)) copy
Hb = N // Mb
Lb = N // (Mb + 1) max R2
Ab = Lb + 1
Ca = Na * C0 Mb mod Mod
Cb = (0 - 6 * Nm * (C1 Mb)) mod Mod
Cc = 2 * C2 Mb mod Mod
Tb = 2 Hb Mod powmod
Ta = 2 (Ab - 1) Mod powmod
Bm = Hb mod Mod
Am = (Ab - 1) mod Mod
E0 = (Tb - Ta) mod Mod
E1b = (Bm - 1) * Tb + 1
E1a = (Am - 1) * Ta + 1
E1 = E1b - E1a
E2b = (Bm * Bm - 2 * Bm + 3) mod Mod
E2a = (Am * Am - 2 * Am + 3) mod Mod
E2 = E2b * Tb mod Mod
E2 = E2 - (E2a * Ta mod Mod)
Z0 = Hb - Ab + 1
High = Hb triangle Mod
Low = Ab - 1 triangle Mod
Z1 = High - Low
High = Hb squares Mod
Low = Ab - 1 squares Mod
Z2 = High - Low
Q0 = Ca * ((E0 - Z0) mod Mod) mod Mod
Q1 = Cb * ((E1 - Z1) mod Mod) mod Mod
Q2 = Cc * ((E2 - Z2) mod Mod) mod Mod
Su2 = (Q0 + Q1 + Q2) mod Mod sum
if Mc2 equal 0
  Su2 = 0
end
Nt = 1 + Nm * Nm + Su1 + Su2
Pw = 2 (Nn * Nn) Mod powmod
return (Pw - Nt) mod Mod
