use testing

test "default input"
  use "072_countfractions" as solve
  Answer = solve

  Answer equal 303963552391
end

test "statement example up to 8"
  use "072_countfractions" as solve
  Answer = solve 8

  Answer equal 21
end

test "limit ten thousand"
  use "072_countfractions" as solve
  Answer = solve 10000

  Answer equal 30397485
end

test "no fractions at limit one"
  use "072_countfractions" as solve
  Answer = solve 1

  Answer equal 0
end
