rem Cuboid Route
rem https://projecteuler.net/problem=86
rem Find the least M for which more than
rem a million cuboids up to M have an
rem integer shortest surface route

use numbers
use sequences
use io
use cli

option Target integer = 1000000
option Limit integer = 2000

rem Longest side c, s = a + b: the route
rem sqrt(s^2 + c^2) makes a triple. Use
rem primitive Euclid triples, legs as
rem (c, s) in both orders with s <= 2c,
rem and their multiples.
Top = Limit * 2
Root = Top isqrt + 1
Ms = 1 to Root array
M = Ms reshape Root 1
N = Ms reshape 1 Root
Gap' = M - N
Mask = M N gcd equal 1
Mask and= Gap mod 2 equal 1
Mask and= Gap at least 1
Sq' = M * M - N * N
Pr' = 2 * M * N
Odd = Sq Mask array
Even = Pr Mask array
Long = concat Odd Even
Wide = concat Even Odd
Twice' = 2 * Long
Keep = Long at most Limit
Keep and= Wide at most Twice
Cs = Long Keep array
Ss = Wide Keep array
Reps = Limit // Cs
Total = Reps sum
Starts = Reps scan + with 0
Marks = array shape Total fill 0
Marks (Starts take (Cs len)) += 1
Owner = (Marks scan +) - 1
Each' = 0 till Total
K = Each - (Starts Owner) + 1
C' = Cs Owner
Hi = K * (Ss Owner)
Big = K * C
Over' = (Hi - Big - 1) 0 max
Val' = Hi // 2 - Over
rem Total the values by side, by
rem sorting. Repeated indices in a
rem slice write keep the last value;
rem they do not accumulate each hit.
Order = Big argsort
Side = Big Order
Part = Val Order
Pre = Part scan + with 0
Left = Total - 1
Back' = Side take Left
Edge' = Side drop 1 not equal Back
Cut = concat (array true) Edge
Heads = Cut indices
Rest' = Heads drop 1
Tails = concat Rest (array Total)
Sums' = (Pre Tails) - (Pre Heads)
Cnt = array shape (Limit + 1) fill 0
Cnt (Side Heads) = Sums
Run' = Cnt scan +
Over2' = Run greater Target
Answer = Run first index where Over2
Answer print
