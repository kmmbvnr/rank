use testing

test "default input"
  use "616_creativenumbers" as solve
  Answer = solve
  Answer equal 310884668312456458
end

test "brute force"
  use "616_creativenumbers" as solve
  Answer = solve 100
  Answer equal 281
  Answer = solve 1000
  Answer equal 8769
  Answer = solve 1000000
  Answer equal 305249492
  Answer = solve 1000000000
  Answer equal 9715657253630
end
