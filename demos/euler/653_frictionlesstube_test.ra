use testing

test "statement values"
  use "653_frictionlesstube" as solve
  Answer = solve 5000 3 2
  Answer equal 5519
  Answer = solve 10000 11 6
  Answer equal 11780
  Answer = solve 100000 101 51
  Answer equal 114101
end

test "default input"
  use "653_frictionlesstube" as solve
  Answer = solve
  Answer equal 1130658687
end
