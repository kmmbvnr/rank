rem Path Sum: Two Ways
rem https://projecteuler.net/problem=81
rem Least path sum from top left to
rem bottom right, moving right or down

use graph
use numbers
use sequences
use text
use io
use cli

arg Input path = (
  "demos/euler/fixtures/"
  + "0081_matrix.txt"
)

rem Cells are vertices; entering a cell
rem costs its value, so each edge into a
rem cell carries that cell's weight.
Text = Input read
Commas = Text "\n" "," translate
Parts = Commas split ","
Count = Parts len - 1
Side = Count isqrt
Cells = Parts take Count integer
Id = 0 till Count array
Col' = Id mod Side
Last = Side - 1
Rows = Count - Side
Right = Id filter (Col less Last) copy
Down = Id filter less Rows copy
East = Right + 1
South = Down + Side
From = concat Right Down
To = concat East South
Cost' = Cells To
Edges' = stack From To Cost transpose
Net = new graph .directed
Net add Id
Net add Edges
Dist = (Net dijkstra 0) .distance
End = Count - 1
Answer = Cells 0 + Dist End
Answer print
