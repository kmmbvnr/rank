rem Random Rectangles
rem https://projecteuler.net/problem=695

use numbers
use sequences
use io
use cli

arg Gn integer = 24

rem Scale each axis by the span s of its
rem three coordinates: the gaps split
rem as (x, 1 - x) and (y, 1 - y), the
rem spans have mean 1/2, and the six
rem ways to match the x order with the
rem y order give areas that are linear
rem in y for fixed x. So E = 1/4 of the
rem mean over x, y, matching of the
rem median of the three areas. In y a
rem median is piecewise linear with
rem breaks at the pairwise crossings
rem (p + q x) / (r + s x), integrated
rem exactly. In x the break points are
rem roots of linear and quadratic
rem equations; Gauss-Legendre is used
rem between them.
rem Gauss-Legendre nodes on [0, 1].
Ep = 0.000000000001
Ks = 1 to Gn
Th = (Ks - 0.25) * 3.141592653589793
Xg = (Th / (Gn + 0.5)) cos
Dp = Xg * 0.0
for It in 1 to 10
  P0 = Xg * 0.0 + 1.0
  P1 = Xg
  for K in 2 to Gn
    Cq = (2 * K - 1) * Xg * P1
    P2 = (Cq - (K - 1) * P0) / K
    P0 = P1
    P1 = P2
  end
  Dp = Gn * (Xg * P1 - P0)
  Dp = Dp / (Xg * Xg - 1.0)
  Xg = Xg - P1 / Dp
end
Wg = 2.0 / ((1.0 - Xg * Xg) * Dp * Dp)
Xg = (Xg + 1.0) / 2.0
Wg = Wg / 2.0
rem Linear coefficients (c + d x) of the
rem area a + b y for the 6 matchings.
Ac = array shape 18 fill 0.0
Ad = Ac copy
Bc = Ac copy
Bd = Ac copy
Np = 0
for Ra in 1 to 3
  for Rb in 1 to 3
    Rc = 6 - Ra - Rb
    Ok = (Ra not equal Rb) integer
    Ok = Ok * ((Rc greater 0) integer)
    Ok = Ok * ((Rc less 4) integer)
    Nq = (Rc not equal Ra) integer
    Ok = Ok * Nq
    Nq = (Rc not equal Rb) integer
    Ok = Ok * Nq
    if Ok equal 1
      for I in 0 to 2
        Qa = Ra
        Qb = Rb
        if I equal 1
          Qa = Rb
          Qb = Rc
        end
        if I equal 2
          Qa = Ra
          Qb = Rc
        end
        Ty = Qa + Qb
        Xc = 1.0
        Xd = 0.0
        if I equal 0
          Xc = 0.0
          Xd = 1.0
        end
        if I equal 1
          Xc = 1.0
          Xd = -1.0
        end
        Ix = Np * 3 + I
        if Ty equal 3
          Bc Ix = Xc
          Bd Ix = Xd
        end
        if Ty equal 5
          Ac Ix = Xc
          Ad Ix = Xd
          Bc Ix = 0.0 - Xc
          Bd Ix = 0.0 - Xd
        end
        if Ty equal 4
          Ac Ix = Xc
          Ad Ix = Xd
        end
      end
      Np += 1
    end
  end
end
rem Crossing t(x) = (pc + pd x) /
rem (qc + qd x) of lines u and v.
Pc = Ac copy
Pd = Ac copy
Qc = Ac copy
Qd = Ac copy
Rt = array shape 400 fill 0.0
Nr = 0
for P in 0 to 5
  for E in 0 to 2
    U = 0
    V = 1
    if E equal 1
      V = 2
    end
    if E equal 2
      U = 1
      V = 2
    end
    Ia = P * 3 + U
    Ib = P * 3 + V
    Ie = P * 3 + E
    Pc Ie = Ac Ib - Ac Ia
    Pd Ie = Ad Ib - Ad Ia
    Qc Ie = Bc Ia - Bc Ib
    Qd Ie = Bd Ia - Bd Ib
  end
  for E in 0 to 2
    Ie = P * 3 + E
    Pe = Pd Ie
    if Pe abs greater Ep
      Rt Nr = 0.0 - Pc Ie / Pe
      Nr += 1
    end
    Qe = Pd Ie - Qd Ie
    if Qe abs greater Ep
      Rt Nr = (Qc Ie - Pc Ie) / Qe
      Nr += 1
    end
  end
  for E in 0 to 1
    for F in E + 1 to 2
      I1 = P * 3 + E
      I2 = P * 3 + F
      Qa = Pd I1 * Qd I2 - Pd I2 * Qd I1
      Qb = Pd I1 * Qc I2 + Pc I1 * Qd I2
      Qb = Qb - Pd I2 * Qc I1
      Qb = Qb - Pc I2 * Qd I1
      Qz = Pc I1 * Qc I2 - Pc I2 * Qc I1
      if Qa abs greater Ep
        Dc = Qb * Qb - 4.0 * Qa * Qz
        if Dc at least 0.0
          Sd = Dc sqrt
          Dv = 2.0 * Qa
          Rt Nr = (0.0 - Qb + Sd) / Dv
          Nr += 1
          Rt Nr = (0.0 - Qb - Sd) / Dv
          Nr += 1
        end
      end
      Za = (Qa abs at most Ep) integer
      Zb = (Qb abs greater Ep) integer
      if Za * Zb equal 1
        Rt Nr = 0.0 - Qz / Qb
        Nr += 1
      end
    end
  end
end
Rs = Rt (0 to Nr - 1)
Rs = Rs ((Rs greater 0.0) indices)
Rs = Rs ((Rs less 1.0) indices)
Zo = array shape 1 fill 0.0
Rs = concat (concat Zo Rs) (Zo + 1.0)
Rs = Rs sort
Na = Rs len
Lo = Rs (0 to Na - 2)
Hi = Rs (1 to Na - 1)
Hw = Hi - Lo
N1 = Na - 1
Lc = Lo reshape N1 1
Hc = Hw reshape N1 1
Xm = Lc + Hc * Xg
Ft = Xm * 0.0
for P in 0 to 5
  Ia = P * 3
  A0 = Ac Ia + Ad Ia * Xm
  A1 = Ac (Ia + 1) + Ad (Ia + 1) * Xm
  A2 = Ac (Ia + 2) + Ad (Ia + 2) * Xm
  B0 = Bc Ia + Bd Ia * Xm
  B1 = Bc (Ia + 1) + Bd (Ia + 1) * Xm
  B2 = Bc (Ia + 2) + Bd (Ia + 2) * Xm
  Dn = B0 - B1
  Mk = (Dn abs at least Ep) integer
  T1 = (A1 - A0) * Mk / (Dn + 1.0 - Mk)
  Dn = B0 - B2
  Mk = (Dn abs at least Ep) integer
  T2 = (A2 - A0) * Mk / (Dn + 1.0 - Mk)
  Dn = B1 - B2
  Mk = (Dn abs at least Ep) integer
  T3 = (A2 - A1) * Mk / (Dn + 1.0 - Mk)
  T1 = (T1 max 0.0) min 1.0
  T2 = (T2 max 0.0) min 1.0
  T3 = (T3 max 0.0) min 1.0
  S1 = (T1 min T2) min T3
  S3 = (T1 max T2) max T3
  S2 = T1 + T2 + T3 - S1 - S3
  Y0 = Xm * 0.0
  Y4 = Y0 + 1.0
  Su = A0 + A1 + A2
  Mn = (A0 min A1) min A2
  Mx = (A0 max A1) max A2
  V0 = Su - Mn - Mx
  Ya = S1
  Va0 = A0 + B0 * Ya
  Va1 = A1 + B1 * Ya
  Va2 = A2 + B2 * Ya
  Su = Va0 + Va1 + Va2
  Mn = (Va0 min Va1) min Va2
  Mx = (Va0 max Va1) max Va2
  Vm1 = Su - Mn - Mx
  Ya = S2
  Va0 = A0 + B0 * Ya
  Va1 = A1 + B1 * Ya
  Va2 = A2 + B2 * Ya
  Su = Va0 + Va1 + Va2
  Mn = (Va0 min Va1) min Va2
  Mx = (Va0 max Va1) max Va2
  Vm2 = Su - Mn - Mx
  Ya = S3
  Va0 = A0 + B0 * Ya
  Va1 = A1 + B1 * Ya
  Va2 = A2 + B2 * Ya
  Su = Va0 + Va1 + Va2
  Mn = (Va0 min Va1) min Va2
  Mx = (Va0 max Va1) max Va2
  Vm3 = Su - Mn - Mx
  Va0 = A0 + B0
  Va1 = A1 + B1
  Va2 = A2 + B2
  Su = Va0 + Va1 + Va2
  Mn = (Va0 min Va1) min Va2
  Mx = (Va0 max Va1) max Va2
  Vm4 = Su - Mn - Mx
  Tr = S1 * (V0 + Vm1)
  Tr = Tr + (S2 - S1) * (Vm1 + Vm2)
  Tr = Tr + (S3 - S2) * (Vm2 + Vm3)
  Tr = Tr + (Y4 - S3) * (Vm3 + Vm4)
  Ft = Ft + Tr / 12.0
end
Wm = Hc * Wg
Wf = Wm * Ft
Jj = Wf sum
Pp = Jj / 4.0
Answer = Pp text ".10f"
Answer print
