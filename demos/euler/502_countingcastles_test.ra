use testing

test "statement values"
  use "502_countingcastles" as solve
  Answer = solve 13 10 10 13 100 100
  rem 50584533 + 959702255 + 841913936
  Answer equal 852200717
end

test "huge width and huge height"
  use "502_countingcastles" as solve
  Answer = solve 1000000000000 100 4 1 4 1
  Answer equal 364553235
  Answer = solve 100 1000000000000 4 1 4 1
  Answer equal 635147632
end
