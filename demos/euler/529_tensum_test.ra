use testing

test "digit sum 4, brute force and dp"
  use "529_tensum" as solve
  Answer = solve 5 4
  Answer equal 504
  Answer = solve 2000 4
  Answer equal 603612384
end

test "official examples"
  use "529_tensum" as solve
  Answer = solve 2 10
  Answer equal 9
  Answer = solve 5 10
  Answer equal 3492
end
