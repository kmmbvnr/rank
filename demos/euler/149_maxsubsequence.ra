rem Searching for a Maximum-sum
rem Subsequence
rem https://projecteuler.net/problem=149
rem Find the greatest sum of adjacent
rem cells in a line of a lagged
rem Fibonacci table

use numbers
use sequences
use io
use cli

option N integer = 2000

rem Best run in each row of X: with
rem prefix sums P, the best run ending
rem at j is P[j] - min P[i < j]. A
rem column of huge negative cells ends
rem every row, so runs cannot join.
fun X best
  Rows = X len
  Pad = (X # 0) * 0 - 1000000000000
  End = Pad reshape Rows 1
  Flat = (concat X End axis 1) copy
  Row = X 0
  Count = Rows * (Row len + 1)
  Line = Flat reshape Count
  Sums = Line scan + with 0 copy
  Low = Sums scan min copy
  Ends = Sums drop 1
  Before = Low take Count
  Gain = Ends - Before
  return Gain max
end

rem Fill the table. Padding a column of
rem negatives and re-cutting the rows
rem makes each column a run of
rem diagonals split by the padding.
Cells = N * N
Len = Cells 55 max
S = array shape Len fill 0
Ks = 1 to 55 array
Seed = 100003 - 200003 * Ks
Seed += 300007 * Ks * Ks * Ks
M = 1000000
H = 500000
S (0 till 55) = Seed mod M - H
for K in 56 to Len
  Sum = S (K - 25) + S (K - 56)
  S (K - 1) = (Sum + M) mod M - H
end
G = (S take Cells) reshape N N
Gap = 0 - 1000000000000
Pad = Gap + (G # 0) * 0
End = Pad reshape N 1
Size = N * (N + 1)
Tall = N + 1
Wide = concat G End axis 1
Flat1 = Wide reshape Size
Skew = Flat1 reshape Tall N
Turn = (G transpose reverse) transpose
Wide2 = concat Turn End axis 1
Flat2 = Wide2 reshape Size
Skew2 = Flat2 reshape Tall N
Rows = G best
Cols = G transpose best
Down = Skew transpose best
Up = Skew2 transpose best
Answer = Rows Cols max
Answer = Answer Down max
Answer = Answer Up max
Answer print
