use testing

test "default input"
  use "600_equiangularhexagons" as solve
  Answer = solve
  Answer equal 2668608479740672
end

test "statement values"
  use "600_equiangularhexagons" as solve
  Answer = solve 6
  Answer equal 1
  Answer = solve 12
  Answer equal 10
  Answer = solve 100
  Answer equal 31248
end
