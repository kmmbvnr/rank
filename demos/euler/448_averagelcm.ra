rem Average Least Common Multiple
rem https://projecteuler.net/problem=448

use numbers
use sequences
use io
use cli

arg N integer = 99999999019
arg L integer = 10000000

rem A(n) = (1 + sum of k phi(k) over
rem k | n) / 2, so S(N) = (N + R) / 2
rem with R = sum of d phi(d) (N // d).
rem F(x) = sum of k phi(k) up to x is
rem a prefix table up to L, and for
rem x = N // i above L it follows
rem from F(x) = x(x+1)(2x+1)/6 -
rem sum over k >= 2 of k F(x // k).
Mod = 999999017
Minimum = N isqrt + 2
Bound = L max Minimum min N max 1
Inverse2 = (Mod + 1) // 2
Inverse6 = (Mod + 1) // 6
TwiceMod = 2 * Mod

rem Remove small prime powers together.
fun Bound weighted_phi
  Size = Bound + 1
  Phi = 0 to Bound copy
  Removed = array shape Size fill 1
  Top = Bound isqrt
  Primes = primes to Top copy
  Count = Primes len
  Index = 0
  Power = 2
  for Index less Count
    Prime = Primes Index
    Slots = Power to Bound by Power
    Removed Slots *= Prime
    if Power equal Prime
      Phi Slots -= Phi Slots // Prime
    end
    Power *= Prime
    if Power greater Bound
      Index += 1
      if Index less Count
        Power = Primes Index
      end
    end
  end
  Keys = 0 to Bound copy
  Rest = Keys // Removed max 1
  Large = Rest greater 1
  Phi = Large choose (Phi - Phi // Rest) Phi
  return Keys * Phi mod Mod
end

Weights = Bound weighted_phi
Prefix = (Weights scan +) mod Mod
Count = N // Bound
Sums = array shape (Count + 2) fill 0
for I in Count to 1 by -1
  X = N // I
  if X greater Bound
    Root = X isqrt
    Divisors = 2 to Root copy
    Quotients = X // Divisors
    Small = Prefix (Quotients min Bound)
    Keys = I * Divisors min Count
    Cached = Sums Keys
    Mask = Quotients at most Bound
    Values = Mask choose Small Cached
    Terms = Divisors * Values mod Mod
    Direct = Terms sum
    Groups = (1 to X // (Root + 1)) copy
    HighBound = X // Groups
    NextGroups = Groups + 1
    LowBound = X // NextGroups max Root
    rem n(n+1) mod 2M stays even.
    High = HighBound mod TwiceMod
    HighNext = (High + 1) mod TwiceMod
    HighSum = High * HighNext mod TwiceMod
    HighSum = HighSum // 2
    Low = LowBound mod TwiceMod
    LowNext = (Low + 1) mod TwiceMod
    LowSum = Low * LowNext mod TwiceMod
    LowSum = LowSum // 2
    Span = (HighSum - LowSum) mod Mod
    Terms = Span * Prefix Groups mod Mod
    Grouped = Terms sum
    Reduced = X mod Mod
    Next = (Reduced + 1) mod Mod
    Twice = (2 * Reduced + 1) mod Mod
    Product = Reduced * Next mod Mod
    Product = Product * Twice mod Mod
    Squares = Product * Inverse6 mod Mod
    Part = Squares - Direct - Grouped
    Sums I = Part mod Mod
  end
end
fun Values lookup Keys
  Small = Prefix (Values min Bound)
  Cached = Sums (Keys min Count)
  Mask = Values at most Bound
  return Mask choose Small Cached
end

Root = N isqrt
Divisors = 1 to Root copy
Factors = N // Divisors mod Mod
SmallWeights = Weights Divisors
DirectTerms = SmallWeights * Factors mod Mod
Groups = (1 to N // (Root + 1)) copy
HighBounds = N // Groups
HighValues = HighBounds lookup Groups
LowBounds = N // (Groups + 1) max Root
LowKeys = Groups + 1
LowValues = LowBounds lookup LowKeys
Delta = (HighValues - LowValues) mod Mod
GroupTerms = Groups * Delta mod Mod
GroupedTotal = GroupTerms sum
Total = (DirectTerms sum) + GroupedTotal
Reduced = (N + Total) mod Mod
Answer = Reduced * Inverse2 mod Mod
return Answer
