rem 3-Like Numbers
rem https://projecteuler.net/problem=706

use numbers
use sequences
use io
use cli

arg Digits integer = 100000
arg Prime integer = 1000000007

rem Since 10 = 1 mod 3, a substring is
rem divisible when two prefix digit sums
rem agree. State: prefix sum S, counts
rem A of prefixes per sum (mod 3) and
rem pairs T so far (mod 3): 243 states.
rem Each digit class moves states by a
rem permutation: a step is 3 scatters.
States = 0 to 242
Sums = States mod 3
Column = States reshape 243 1
Counts = Column // (3 ** (1 to 3)) mod 3
Pairs = States // 81
Sum1 = Sums reshape 243 1
Next = (Sum1 + (0 to 2)) mod 3
NextCol = Next reshape 243 3 1
Hot = NextCol equal (0 to 2) integer
Counts3 = Counts reshape 243 1 3
Added = Counts3 * Hot sum axis 2
Pair1 = Pairs reshape 243 1
NewPairs = (Pair1 + Added) mod 3
Bumped = (Counts3 + Hot) mod 3
Scaled = Bumped * 3 ** (0 to 2)
Packed = Scaled sum axis 2
Cell = Next + 3 * Packed
Where = Cell + 81 * NewPairs
Targets = Where transpose
Later = array 4 3 3
Current = array shape 243 fill 0
Current 3 = 1
First = array 3 3 3
Empty = array shape 243 fill 0
for Place in 1 to Digits
  Weight = First
  if Place greater 1
    Weight = Later
  end
  ByZero = Empty
  ByOne = Empty
  ByTwo = Empty
  Gain0 = Current * (Weight 0)
  Gain1 = Current * (Weight 1)
  Gain2 = Current * (Weight 2)
  ByZero (Targets 0) = Gain0
  ByOne (Targets 1) = Gain1
  ByTwo (Targets 2) = Gain2
  Sum2 = ByZero + ByOne + ByTwo
  Current = Sum2 mod Prime
end
Answer = Current (0 to 80) sum mod Prime
Answer print
