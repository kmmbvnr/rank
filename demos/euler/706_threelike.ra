rem 3-Like Numbers
rem https://projecteuler.net/problem=706

use numbers
use sequences
use io
use cli

arg Dd integer = 100000
arg Pm integer = 1000000007

rem Since 10 = 1 mod 3, a substring is
rem divisible when two prefix digit sums
rem agree. State: prefix sum S, counts
rem A of prefixes per sum (mod 3) and
rem pairs T so far (mod 3): 243 states.
rem Each digit class moves states by a
rem permutation: a step is 3 scatters.
Xs = 0 to 242
Ss = Xs mod 3
Cl = Xs reshape 243 1
Ar = Cl // (3 ** (1 to 3)) mod 3
Tt = Xs // 81
S2 = (Ss reshape 243 1 + (0 to 2)) mod 3
Sr = S2 reshape 243 3 1
Ht = Sr equal (0 to 2) integer
Ar1 = Ar reshape 243 1 3
Ac = Ar1 * Ht sum axis 2
T2 = (Tt reshape 243 1 + Ac) mod 3
Bd = (Ar1 + Ht) mod 3
Pk = Bd * 3 ** (0 to 2) sum axis 2
Sc = (S2 + 3 * Pk + 81 * T2) transpose
Wt = array 4 3 3
Cur = array shape 243 fill 0
Cur 3 = 1
Fs = array 3 3 3
Nx = array shape 243 fill 0
for K in 1 to Dd
  Wg = Fs
  if K greater 1
    Wg = Wt
  end
  N0 = Nx
  N1 = Nx
  N2 = Nx
  N0 (Sc 0) = Cur * (Wg 0)
  N1 (Sc 1) = Cur * (Wg 1)
  N2 (Sc 2) = Cur * (Wg 2)
  Cur = (N0 + N1 + N2) mod Pm
end
Answer = Cur (0 to 80) sum mod Pm
Answer print
