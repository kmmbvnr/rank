rem Minimum of Subsequences
rem https://projecteuler.net/problem=375

use sequences
use numbers
use io
use cli
arg Limit integer = 2000000000
arg Period integer = 6308948

N = Limit max 0
P = Period min (N max 1)
Mod = 50515093
A = array shape P fill 0
S = 290797
Low = Mod
K = 0
for I in 0 till P
  S = S * S mod Mod
  A I = S
  if S less Low
    Low = S
    K = I
  end
end
rem A zero excess resets suffix minima.
Cap = P min 64
St = array shape Cap fill 0
Top = 0
Sum = 0
Total = 0
First = 0
Prefix = 0
Warm = 0
WarmRest = 0
NextRest = 0
Full = N // P
Rest = N mod P
Cut = K min Rest
rem Warm the prefix before the minimum.
for I in 0 till P + K
  X = A (I mod P) - Low
  for Top greater 0
    J = St (Top - 1)
    Y = A (J mod P) - Low
    if Y less X
      break
    end
    Top -= 1
    Left = -1
    if Top greater 0
      Left = St (Top - 1)
    end
    Sum -= Y * (J - Left)
  end
  Left = -1
  if Top greater 0
    Left = St (Top - 1)
  end
  Sum += X * (I - Left)
  if Top at least Cap
    St = concat St St copy
    Cap *= 2
  end
  St Top = I
  Top += 1
  Total += Sum
  if I + 1 equal Rest
    Prefix = Total
  end
  if I + 1 equal K
    Warm = Total
  end
  if I + 1 equal Cut
    WarmRest = Total
  end
  if I + 1 equal P
    First = Total
  end
  if I + 1 equal P + Cut
    NextRest = Total - First
  end
end
rem Add the minimum once per subarray.
Answer = Low * N * (N + 1) // 2
Answer += Prefix
if Full greater 0
  Correction = Total - First - Warm
  Answer += Full * First
  Answer += (Full - 1) * Correction
  Answer += NextRest - WarmRest
end
Answer print
