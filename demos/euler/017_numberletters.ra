rem Number Letter Counts
rem https://projecteuler.net/problem=17
rem Count letters in British English names
rem from one through Limit

use io
use cli
use sequences

option Limit integer = 1000

Ones = array shape 9
  "one"
  "two"
  "three"
  "four"
  "five"
  "six"
  "seven"
  "eight"
  "nine"
end

Teens = array shape 10
  "ten"
  "eleven"
  "twelve"
  "thirteen"
  "fourteen"
  "fifteen"
  "sixteen"
  "seventeen"
  "eighteen"
  "nineteen"
end

Tens = array shape 8
  "twenty"
  "thirty"
  "forty"
  "fifty"
  "sixty"
  "seventy"
  "eighty"
  "ninety"
end

rem Every name, in order: 1-99, then
rem 100-999 as hundreds with an optional
rem "and" tail, then 1000.
Nil = array ""
Tail = concat Nil Ones axis 0
Dozens = Tens Tail outer + reshape 80
Under = concat Ones Teens Dozens axis 0
And = "and" + Under
Rest = concat Nil And axis 0
Hund = (Ones + "hundred") Rest outer +
Over = Hund reshape 900
Last = array "onethousand"
Words = concat Under Over Last axis 0
Counts = Words len rank 0 take Limit
Counts sum print
