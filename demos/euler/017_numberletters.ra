rem Number Letter Counts
rem https://projecteuler.net/problem=17
rem Count letters in British English names
rem from one through Limit

use io
use cli
use sequences
use text

arg Limit integer = 1000

Ones = "one two three four five six seven eight nine" split " "
Teens = "ten eleven twelve thirteen fourteen fifteen sixteen seventeen eighteen nineteen" split " "
Tens = "twenty thirty forty fifty sixty seventy eighty ninety" split " "

Tail = concat (array "") Ones
Dozens = Tens Tail outer + reshape #
Under = concat Ones Teens Dozens

Rest = concat (array "") ("and" + Under)
Over = (Ones + "hundred") Rest outer + reshape #

Last = array "onethousand"

Words = concat Under Over Last
Words len rank 0 take Limit sum print
