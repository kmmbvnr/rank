use testing

rem Preserve the full problem answer.
test "default input"
  use "247_hyperbolasquares"
  run

  Answer equal 782252
end

test "problem example"
  use "247_hyperbolasquares"
  Right = 1
  Up = 1
  run

  Answer equal 50
end

test "root and asymmetric indices"
  use "247_hyperbolasquares"
  Right = 0
  Up = 0
  run
  Answer equal 1

  Right = 0
  Up = 1
  run
  Answer equal 12

  Right = 1
  Up = 0
  run
  Answer equal 2
end
