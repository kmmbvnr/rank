use testing

rem Preserve the full problem answer.
test "default input"
  use "247_hyperbolasquares" as solve
  Answer = solve

  Answer equal 782252
end

test "problem example"
  use "247_hyperbolasquares" as solve
  Answer = solve 1 1

  Answer equal 50
end

test "root and asymmetric indices"
  use "247_hyperbolasquares" as solve
  Answer = solve 0 0
  Answer equal 1

  Answer = solve 0 1
  Answer equal 12

  Answer = solve 1 0
  Answer equal 2
end
