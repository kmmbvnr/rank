rem Silver Dollar Game
rem https://projecteuler.net/problem=344

use bits
use numbers
use io
use cli

arg N integer = 1000000
arg C integer = 100

M = 1000036000099
P0 = 1000003
P1 = 1000033

fun K R P ways
  At = 0 to K
  Even = At mod 2 equal 0
  Row = K binomial At mod P
  Left = Even choose Row 0
  Right = R binomial (0 to R) mod P
  return Left convolve Right mod P
end

fun S W P count
  Z = W len - 1
  D = array shape (Z + 1) fill 0
  D 0 = 1
  rem W 0 = 1: higher bits add nothing.
  for S greater 0
    E = array shape (Z + 1) fill 0
    Bit = S band 1
    for Carry in 0 to (Z min S)
      Value = D Carry
      if Value not equal 0
        First = (Bit - Carry) mod 2
        Last = Z min (S - Carry)
        for Ones in First to Last by 2
          Next = (Carry + Ones) // 2
          E Next += Value * W Ones
          E Next = E Next mod P
        end
      end
    end
    D = E
    S = S shr 1
  end
  return D 0
end

fun N C P solvep
  if C equal 0
    return N mod P
  end
  Coins = C + 1
  Empty = N - Coins
  K = (Coins + 1) // 2
  R = Coins - K + 1
  W0 = K R P ways
  L0 = Empty W0 P count
  Lose = 0
  if Coins mod 2 equal 0
    Lose = (Coins - 1) * L0
  else
    W1 = (K - 1) R P ways
    L1 = (Empty + 1) W0 P count
    L1 -= (Empty + 1) W1 P count
    Lose = L0 + (Coins - 2) * L1
  end
  Comb = N binomial Coins mod P
  Total = Coins * Comb
  return (Total - Lose) mod P
end

fun A crt B
  T = (B - A) mod P1
  I = P0 (P1 - 2) P1 powmod
  T = T * I mod P1
  return (A + P0 * T) mod M
end

A = N C P0 solvep
B = N C P1 solvep
Answer = A crt B
return Answer
