rem Coin Sums
rem https://projecteuler.net/problem=31
rem Count unordered ways to make Target
rem from the standard UK coin values

use sequences
use io
use cli

option Target integer = 200

Coins = array 1 2 5 10 20 50 100 200
Answer = Coins Target coin_sums
Answer print


rem Build each amount from coins already seen,
rem so permutations are never counted twice.
fun coin_sums Coins Target
  Ways = array shape (Target + 1) pad 0
  Ways 0 = 1

  for Coin in Coins
    if Coin at most Target
      for Amount in Coin to Target
        Previous = Amount - Coin
        Ways Amount += Ways Previous
      end
    end
  end

  return Ways Target
end
