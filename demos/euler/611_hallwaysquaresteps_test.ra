use testing

test "statement values"
  use "611_hallwaysquaresteps" as solve
  Answer = solve 5
  Answer equal 1
  Answer = solve 100
  Answer equal 27
  Answer = solve 1000
  Answer equal 233
  Answer = solve 1000000
  Answer equal 112168
end

test "brute force"
  use "611_hallwaysquaresteps" as solve
  Answer = solve 10000
  Answer equal 1812
end
