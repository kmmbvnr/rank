use testing

test "default input"
  use "269_integerroot" as solve
  Answer = solve

  Answer equal 1311109198529286
end

test "few digits"
  use "269_integerroot" as solve
  Answer = solve 3

  Answer equal 172
  Answer = solve 5

  Answer equal 14696
end

test "fewer digits than divisor degree"
  use "269_integerroot" as solve
  Answer = solve 1

  Answer equal 1
  Answer = solve 2

  Answer equal 33
end
