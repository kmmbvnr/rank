rem Cross Flips
rem https://projecteuler.net/problem=331

use numbers
use io

Sum = 0
for I in 3 to 31
  Sum += (2 ** I - I) turns
end
Sum print

fun N turns
  if N equal 5
    return 3
  end
  if N mod 2 equal 1
    return 0
  end
  Sq = N * N
  Par = array shape N fill 0
  Pre = array shape (N + 1) fill 0
  Ones = 0
  for X in 0 till N
    Lo = X N low
    Hi = (Sq - 1 - X * X) isqrt
    Bit = (Hi - Lo + 1) mod 2
    Par X = Bit
    Ones += Bit
    Pre (X + 1) = Ones
  end
  Adj = 0
  for X in 0 till N
    Lo = X N low
    Hi = (Sq - 1 - X * X) isqrt
    Hit = (Pre (Hi + 1)) - (Pre Lo)
    Len = Hi - Lo + 1
    if Par X equal 0
      Adj += Len - 2 * Hit
    else
      Adj += 2 * Hit - Len
    end
  end
  return 2 * Ones * (N - Ones) + Adj
end

fun X N low
  if X equal N - 1
    return 0
  end
  V = N * N - 2 * N - X * X
  return V isqrt + 1
end
