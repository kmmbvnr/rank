rem Cross Flips
rem https://projecteuler.net/problem=331

use io

Sum = 3
for I in 4 to 30 by 2
  Sum += (2 ** I - I) turns
end
Sum print

fun N turns
  if N mod 2 equal 1
    if N equal 5
      return 3
    end
    return 0
  end
  X = 0
  Y = N - 1
  R = 0
  C = 1
  Odd = 0
  Was = 0
  Fix = 0
  Edge = 2 * (N - 1)
  for X less Y
    if 2 * X less Edge - R
      R += X
      X += 1
      R += X
      C += 1
    else
      R -= Y
      Y -= 1
      R -= Y
      New = 1
      if R less 0
        R += X
        X += 1
        R += X
        New = 0
      end
      Was += New
      if C mod 2 equal 1
        Fix += 2 * (C - 2 * Was)
      else
        Fix -= 2 * (C - 2 * Was)
      end
      Odd += C + C mod 2 - Was
      Was = New
      C = 1
    end
  end
  if X equal Y
    Odd += 1 - Was
    if C greater 1
      Fix += 4 * Was - 1
    else
      Fix += 1
    end
  end
  return Fix + 2 * Odd * (N - Odd)
end
