rem Harshad Numbers
rem https://projecteuler.net/problem=387

use numbers
use sequences
use io
use cli

option Limit integer = 10 ** 14

Answer = 0
for N in 1 to 9
  Answer += N visit N
end
Answer print

rem N is Harshad; S is its digit sum.
fun N visit S
  Total = 0
  Q = N // S
  if Q in primes
    for D in array 1 3 7 9
      P = 10 * N + D
      if P less Limit
        if P in primes
          Total += P
        end
      end
    end
  end
  Top = (Limit - 1) // 10
  if N greater (Top // 10)
    return Total
  end
  for D in 0 to 9
    M = 10 * N + D
    T = S + D
    if M mod T equal 0
      Total += M visit T
    end
  end
  return Total
end
