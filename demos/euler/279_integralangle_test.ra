use testing

test "default input"
  use "279_integralangle" as solve
  Answer = solve

  Answer equal 416577688
end

test "small limits"
  use "279_integralangle" as solve
  Answer = solve 100

  Answer equal 84
  Answer = solve 200

  Answer equal 203
  Answer = solve 5000

  Answer equal 8891
end

test "empty and first triangle"
  use "279_integralangle" as solve
  Answer = solve 0
  Answer equal 0
  Answer = solve 1
  Answer equal 0
  Answer = solve 2
  Answer equal 0
  Answer = solve 3
  Answer equal 1
end
