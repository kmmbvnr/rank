rem Investigating a Prime Pattern
rem https://projecteuler.net/problem=146
rem Sum the n below a limit where n^2 +
rem 1, 3, 7, 9, 13, 27 are consecutive
rem primes

use sequences
use io
use cli

arg Limit integer = 150000000

rem n is a multiple of 10. Drop n whose
rem n^2 + k has a small prime factor,
rem first on residues mod 30030, then on
rem all candidates, and test the rest.
Off = (array 1 3 7 9 13 27) reshape 6 1
Wheel = 30030
R = 0 till Wheel by 10 array
for P in primes from 3 till 14
  Sq = 0 till P array
  Hit' = (Sq * Sq + Off) mod P equal 0
  Bad = Hit any axis 0
  R = R filter (not Bad (R mod P)) array
end
Blocks = Limit // Wheel + 1
J' = (0 till Blocks array) * Wheel
Cols = R len
Row' = R reshape 1 Cols
Col' = J reshape Blocks 1
Grid' = Row + Col
C = Grid reshape (Blocks * Cols)
C = C filter C less Limit array
for P in primes from 17 till 100
  Sq = 0 till P array
  Hit' = (Sq * Sq + Off) mod P equal 0
  Bad = Hit any axis 0
  C = C filter (not Bad (C mod P)) array
end
for K in array 1 3 7 9 13 27
  Q' = C * C + K
  C = C filter (Q in primes) array
end
for K in array 19 21
  Q' = C * C + K
  C = C filter (not Q in primes) array
end
Answer = C sum
Answer print
