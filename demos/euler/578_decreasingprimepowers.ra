rem Decreasing prime powers
rem https://projecteuler.net/problem=578
use numbers
use sequences
use bits
use algo
use io
use cli
arg N integer = 10000000000000
Root = N isqrt
fun Limit mobius
  Size = Limit + 1
  Mu = array shape Size fill 1
  Mu 0 = 0
  Rest = 0 to Limit copy
  Top = Limit isqrt
  for Prime in primes to Top array
    Slots = Prime to Limit by Prime
    Mu Slots *= -1
    Square = Prime * Prime
    Mu (Square to Limit by Square) = 0
    Rest Slots //= Prime
  end
  Mask = Rest greater 1
  Result = Mask choose (0 - Mu) Mu
  return Result copy
end
Mu = Root mobius
fun Weights prefix
  Squared = Weights * Weights
  Scanned = Squared scan + with 0
  return Scanned drop 1 copy
end
Prefix = Mu prefix
Primes = primes to Root array
fun Bound prime_counts
  Indices = 0 to Bound copy
  return Primes upperindex Indices
end
Pi = Root prime_counts
Sentinel = array (Root + 1)
Primes = concat Primes Sentinel
rem This table only bounds memory.
rem Larger queries use exact recursion.
Cut = Root min 10000
Depth = Primes len - 1 min 6
fun Previous sift Prime
  Count = Previous len
  Limit = Count - 1
  Bits = Limit binary len
  Steps = 0 to Bits copy
  Powers = Prime ** Steps
  Keep = Powers at most Limit
  Powers = Powers Keep copy
  Signs = 1 - 2 * (Steps Keep mod 2)
  Width = Powers len
  Indices = 0 to Limit copy
  Column = Indices reshape Count 1
  Places = Column // Powers
  Terms = Previous Places
  Weights = Signs reshape 1 Width
  Result = Terms * Weights sum axis 1
  return Result copy
end
Small = Primes take Depth copy
Initial = Prefix take (Cut + 1) copy
rem Store rows for tail queries.
Scanned = Small scan sift with Initial
Table = Scanned copy
rem Mobius inversion counts squarefree
rem tails without enumerating products.
fun Limit squarefree
  if Limit at most Root
    return Prefix Limit
  end
  End = Limit isqrt
  Total = 0
  for Divisor in 1 to End
    Square = Divisor * Divisor
    Count = Limit // Square
    Total += Mu Divisor * Count
  end
  return Total
end
fun Limit rough Start
  if Limit less 2
    return Limit
  end
  if Limit at most Cut
    if Start at most Depth
      return Table Start Limit
    end
  end
  if Start equal 0
    return Limit squarefree
  end
  if Limit at most Root
    Prime = Primes Start
    if Prime * Prime greater Limit
      Count = 1 + Pi Limit - Start
      return Count max 1
    end
  end
  Left = Limit rough (Start - 1)
  Next = Limit // Primes (Start - 1)
  Right = Next rough Start
  return Left - Right
end
rem Only the powerful prefix branches.
Cap = N binary len - 1
fun Low bracket High Degree
  if High - Low at most 1
    return Low
  end
  Middle = (Low + High) // 2
  Power = Middle ** Degree
  if Power at most N
    return Middle bracket High Degree
  end
  return Low bracket Middle Degree
end
fun Degree power_rows rank 0
  Bound = 0 bracket (Root + 1) Degree
  Count = Pi Bound
  Indices = 0 till Count copy
  Small = Primes Indices
  Values = Small ** Degree
  Degrees = Indices * 0 + Degree
  return stack Values Indices Degrees
end
fun prime_powers
  Exponents' = 2 to Cap
  Parts' = Exponents power_rows
  Seed = array shape 3 0 fill 0
  Rows = concat Seed unpack Parts axis 1
  Values = Rows 0
  Owners = Rows 1
  Degrees = Rows 2
  Order = Values argsort
  return record
    .powers = Values Order copy
    .owners = Owners Order copy
    .degrees = Degrees Order copy
  end
end
Rules = prime_powers
Powers = Rules .powers
Owners = Rules .owners
Degrees = Rules .degrees
RuleCount = Powers len
fun Limit solve Start Cap
  if Limit less 2
    return Limit
  end
  Total = Limit rough Start
  Prime = Primes Start
  if Prime * Prime greater Limit
    return Total
  end
  rem Power order bounds the scan.
  for Index in 0 till RuleCount
    Power = Powers Index
    if Power greater Limit
      break
    end
    Owner = Owners Index
    Degree = Degrees Index
    if Owner at least Start
      if Degree at most Cap
        Next = Limit // Power
        First = Owner + 1
        Total += Next solve First Degree
      end
    end
  end
  return Total
end
Answer = N solve 0 Cap
return Answer
