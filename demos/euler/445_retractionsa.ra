rem Retractions A
rem https://projecteuler.net/problem=445

use numbers
use sequences
use io
use cli

arg N integer = 10000000

Mod = 1000000007
Inverse = Mod - 2
Root = N isqrt
Half = N // 2
rem C(N, k) needs only prime exponents.
rem Sum C(N, k) separately as 2^N - 2.
Width = 32

fun Limit least_factors
  Table = 0 to Limit copy
  Small = primes to (Limit isqrt) copy
  Count = Small len
  for I in Count - 1 to 0 by -1
    Step = Small I
    Table (Step to Limit by Step) = Step
  end
  rem Zero ends each factor walk.
  if Limit greater 0
    Table 1 = 0
  end
  return Table
end

Smallest = N least_factors
Counts = array shape (Root + 1) fill 0
Rows = Root + 1
Keys = 0 to Root copy
Bases = Keys reshape Rows 1
Exponents = 0 till Width copy
Powers = Exponents reshape 1 Width
Grid = Bases Powers Mod powmod
Cells = Rows * Width
Factors = (Grid + 1) reshape Cells
Factors (Keys * Width) = 1
Inverses = Factors Inverse Mod powmod
Primes = primes from Root + 1 to N copy
Reciprocals = array shape (N + 1) fill 1
LargeFactors = Primes + 1
Values = LargeFactors Inverse Mod powmod
Reciprocals Primes = Values
rem Positive Part adds the numerator.
rem Negative Part removes denominator
rem factors before advancing the row.
Row = 1
Part = N
Prime = Smallest N
Count = 0
Value = 1
Total = 0
for Row at most Half
  if Prime greater 0
    Part //= Prime
    Count += 1
    NextPrime = Smallest (Part abs)
    if NextPrime not equal Prime
      if Prime at most Root
        Before = Counts Prime
        After = Before + Count
        if Part less 0
          After = Before - Count
        end
        Counts Prime = After
        Base = Prime * Width
        Offset = Base + Before
        Factor = Inverses Offset
        Value = Value * Factor mod Mod
        Factor = Factors (Base + After)
        Value = Value * Factor mod Mod
      else
        Factor = Prime + 1
        if Part less 0
          Factor = Reciprocals Prime
        end
        Value = Value * Factor mod Mod
      end
      Count = 0
    end
    Prime = NextPrime
  end
  if Prime equal 0
    if Part greater 0
      Part = -Row
    else
      Total += Value
      Row += 1
      Part = N - Row + 1
    end
    Prime = Smallest (Part abs)
  end
end
Even = N mod 2 equal 0
Middle = Even choose Value 0
Power = 2 N Mod powmod
Total = 2 * Total - Middle - Power + 2
Answer = Total mod Mod
Answer print
