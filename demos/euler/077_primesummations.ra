rem Prime Summations
rem https://projecteuler.net/problem=77
rem Find the first value writable as a
rem sum of primes in more than a target
rem number of ways

use linalg
use numbers
use sequences
use io
use cli

option Target integer = 5000
option Limit integer = 100

rem Euler transform: n a(n) is the sum
rem of b(k) a(n - k), where b(k) adds
rem the distinct primes dividing k.
Ps = primes to Limit array
Ids = 1 to Limit array
Row = Ids reshape Limit 1
Dividing' = Row mod Ps equal 0
Sums = (Dividing choose Ps 0) sum rank 1
rem Reverse storage gives zero for
rem terms beyond the current n.
Ways = array shape (2 * Limit + 1) fill 0
Ways Limit = 1
for N in 1 to Limit
  Base = Limit - N
  Sum = (Ways (Ids + Base)) matmul Sums
  Ways Base = Sum // N
end
Ways = Ways (Limit to 0 by -1) copy
Over' = Ways greater Target
Answer = Ways first index where Over
Answer print
