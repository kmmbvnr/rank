rem Divisibility of factorials
rem https://projecteuler.net/problem=549
use numbers
use sequences
use bits
use algo
use io
use cli
arg N integer = 100000000
Digits = N binary len
Maximum = Digits max 2
rem First write largest prime factors.
rem Then raise prime-power multiples.
Small = primes to (N isqrt) array
Exponents = 2 to Maximum copy
Bases = Small reshape (Small len) 1
Powers = Bases ** Exponents
Valid = Powers at most N
Jobs = Powers Valid
OrderGrid = Exponents + Bases * 0
Orders = OrderGrid Valid
BaseGrid = Bases + Exponents * 0
Factors = BaseGrid Valid
rem Invert Legendre valuations in bulk.
Row = 2 to Maximum copy
Grid = Row reshape (Row len) 1 1
Samples = 1 to Maximum copy
Steps = Samples reshape 1 Maximum 1
Width = Maximum binary len
Divisors = Grid ** (0 till Width)
Terms = Steps // Divisors
Counts = Terms sum axis 2
Height = Maximum - 1
Rows = Counts reshape Height 1 Maximum
Table = Rows lowerindex Samples rank 1 0
Size = Height * Maximum
Flat = Table reshape Size
rem Larger primes need exactly p*a.
Index = (Factors min Maximum) - 2
Index = Index * Maximum + Orders - 1
Scores = Factors * (Flat Index + 1)
Jobs = concat Small Jobs copy
Scores = concat Small Scores copy
Factors = concat Small Factors copy
rem Strip small prime factors per block.
rem The remaining factor is prime or 1.
fun Start subtotal Stop
  Size = Stop - Start + 1
  Sieve = array shape Size fill 0
  Rest = Start to Stop copy
  for Step I in Jobs
    First = (Start + Step - 1) // Step
    Offset = First * Step - Start
    Slots = Offset till Size by Step
    Prime = Factors I
    Need = Scores I
    Sieve Slots = Sieve Slots max Need
    Rest Slots //= Prime
  end
  Total = Sieve max Rest sum
  return Total
end
Block = 1048576
Starts = 2 to N by Block copy
Ends = Starts + Block - 1
Stops = Ends min N
Totals = Starts subtotal Stops rank 0 0
Answer = Totals sum
Answer print
