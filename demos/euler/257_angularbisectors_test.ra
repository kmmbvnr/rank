use testing

test "default input"
  use "257_angularbisectors" as solve
  Answer = solve

  Answer equal 139012411
end

test "small limits"
  use "257_angularbisectors" as solve
  Answer = solve 0

  Answer equal 0
  Answer = solve 3

  Answer equal 1
  Answer = solve 60

  Answer equal 26
  Answer = solve 120

  Answer equal 58
  Answer = solve 300

  Answer equal 160
  Answer = solve 1000000

  Answer equal 1078857
end
