use testing

test "default input"
  use "257_angularbisectors"
  run

  Answer equal 139012411
end

test "small limits"
  use "257_angularbisectors"
  Limit = 0
  run

  Answer equal 0
  Limit = 3
  run

  Answer equal 1
  Limit = 60
  run

  Answer equal 26
  Limit = 120
  run

  Answer equal 58
  Limit = 300
  run

  Answer equal 160
  Limit = 1000000
  run

  Answer equal 1078857
end
