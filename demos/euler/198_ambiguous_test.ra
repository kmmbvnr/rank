use testing

test "default input"
  use "198_ambiguous" as solve
  Answer = solve

  Answer equal 52374425
end

test "checkpoints"
  use "198_ambiguous" as solve
  Answer = solve 120

  Answer equal 10
  Answer = solve 200000

  Answer equal 100967
  Answer = solve 1000000

  Answer equal 509763
end

test "strict midpoint and odd limits"
  use "198_ambiguous" as solve
  Answer = solve -1

  Answer equal 0
  Answer = solve 0

  Answer equal 0
  Answer = solve 100

  Answer equal 0
  Answer = solve 101

  Answer equal 0
  Answer = solve 102

  Answer equal 1
  Answer = solve 103

  Answer equal 1
  Answer = solve 4095

  Answer equal 1997
end
