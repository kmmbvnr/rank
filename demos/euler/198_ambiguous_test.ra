use testing

test "default input"
  use "198_ambiguous"
  run

  Answer equal 52374425
end

test "checkpoints"
  use "198_ambiguous"
  Limit = 120
  run

  Answer equal 10
  Limit = 200000
  run

  Answer equal 100967
  Limit = 1000000
  run

  Answer equal 509763
end

test "strict midpoint and odd limits"
  use "198_ambiguous"
  Limit = -1
  run

  Answer equal 0
  Limit = 0
  run

  Answer equal 0
  Limit = 100
  run

  Answer equal 0
  Limit = 101
  run

  Answer equal 0
  Limit = 102
  run

  Answer equal 1
  Limit = 103
  run

  Answer equal 1
  Limit = 4095
  run

  Answer equal 1997
end
