rem Shifted Pythagorean Triples
rem https://projecteuler.net/problem=730

use numbers
use sequences
use io
use cli

arg Shifts integer = 100
arg Perimeter integer = 10 ** 8
arg Budget integer = 4000000

rem The Berggren maps keep r^2 - p^2 -
rem q^2 = k, preserve primitivity and
rem lead from every root to its
rem descendants. Roots are the primitive
rem solutions with p, q <= max(4m, 10)
rem and no positive parent. All ordered
rem solutions with p + q + r <= n are
rem grown from the roots in blocks taken
rem from the end of a pool; the p <= q
rem count is (all + those with p = q) / 2.
Span = (4 * Shifts) max 10
Ks = (0 to Shifts) reshape (Shifts + 1) 1 1
Ps = (1 to Span) reshape 1 Span 1
Qs = (1 to Span) reshape 1 1 Span
Total2 = Ps * Ps + Qs * Qs + Ks
Rs = Total2 isqrt
Square = (Rs * Rs) equal Total2
Common = ((Ps gcd Qs) gcd Rs) equal 1
A1 = Ps + 2 * Qs - 2 * Rs
B1 = 2 * Rs - 2 * Ps - Qs
C1 = 3 * Rs - 2 * Ps - 2 * Qs
B2 = 2 * Ps + Qs - 2 * Rs
A3 = 2 * Rs - Ps - 2 * Qs
Up1 = (A1 greater 0) and (B1 greater 0)
Up1 = Up1 and (C1 greater 0)
Up2 = (A1 greater 0) and (B2 greater 0)
Up2 = Up2 and (C1 greater 0)
Up3 = (A3 greater 0) and (B2 greater 0)
Up3 = Up3 and (C1 greater 0)
Root = Square and Common
Root = Root and (Up1 not equal true)
Root = Root and (Up2 not equal true)
Root = Root and (Up3 not equal true)
Small = (Ps + Qs + Rs) at most Perimeter
Root = Root and Small
Pool1 = (Ps + Qs * 0 + Ks * 0) filter Root
Pool2 = (Qs + Ps * 0 + Ks * 0) filter Root
Pool3 = Rs filter Root
All = 0
Diag = 0
for Pool1 len greater 0
  Size = Pool1 len
  Take = Size min Budget
  Keep = Size - Take
  P = Pool1 drop Keep
  Q = Pool2 drop Keep
  R = Pool3 drop Keep
  Pool1 = Pool1 take Keep
  Pool2 = Pool2 take Keep
  Pool3 = Pool3 take Keep
  All += Take
  Equal = P equal Q
  Diag += Equal count
  Pa = P - 2 * Q + 2 * R
  Qa = 2 * P - Q + 2 * R
  Ra = 2 * P - 2 * Q + 3 * R
  Pb = P + 2 * Q + 2 * R
  Qb = 2 * P + Q + 2 * R
  Rb = 2 * P + 2 * Q + 3 * R
  Pc = 2 * Q + 2 * R - P
  Qc = Q + 2 * R - 2 * P
  Rc = 2 * Q + 3 * R - 2 * P
  Fa = (Pa + Qa + Ra) at most Perimeter
  Fb = (Pb + Qb + Rb) at most Perimeter
  Fc = (Pc + Qc + Rc) at most Perimeter
  Pool1 = concat Pool1 (concat (Pa filter Fa) (concat (Pb filter Fb) (Pc filter Fc)))
  Pool2 = concat Pool2 (concat (Qa filter Fa) (concat (Qb filter Fb) (Qc filter Fc)))
  Pool3 = concat Pool3 (concat (Ra filter Fa) (concat (Rb filter Fb) (Rc filter Fc)))
end
Answer = (All + Diag) // 2
Answer print
