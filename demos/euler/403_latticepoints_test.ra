use testing

test "statement values"
  use "403_latticepoints" as solve
  Answer = solve 5
  Answer equal 344
  Answer = solve 100
  Answer equal 26709528
end

test "exact values below the modulus"
  use "403_latticepoints" as solve
  Answer = solve 20
  Answer equal 47021
end

test "default input"
  use "403_latticepoints" as solve
  Answer = solve
  Answer equal 18224771
end
