rem Triangle Containment
rem https://projecteuler.net/problem=102
rem Count triangles around the origin

use sequences
use text
use io
use cli

argument Input path = (
  "demos/euler/fixtures/"
  + "0102_triangles.txt"
)

rem The origin is inside when the cross
rem products of consecutive vertices all
rem have one sign.
Lines = Input readlines
Flat = Lines join ","
Parts = Flat split ","
Nums = Parts integer
Rows = Lines len
Grid = Nums reshape Rows 6
Xs = Grid # (array 0 2 4)
Ys = Grid # (array 1 3 5)
Next = array 1 2 0
Nx' = Xs # Next
Ny' = Ys # Next
Cross = Xs * Ny - Ys * Nx
Left' = (Cross greater 0) all axis 1
Right' = (Cross less 0) all axis 1
Inside' = Left or Right
Answer = Inside count
Answer print
