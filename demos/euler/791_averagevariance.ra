rem Average and Variance
rem https://projecteuler.net/problem=791

use numbers
use sequences
use io
use cli

arg Limit integer = 10 ** 8
arg Mod integer = 433494437

rem Quadruples with mean twice the
rem variance correspond to odd triples
rem (u, v, w) in a region with
rem R = 8 n. A triple adds
rem (u^2 + v^2 + w^2 + 2 (u + v + w)
rem + 3) / 2. For each odd u and v the
rem odd w form one interval, or two when
rem a central gap is cut out; interval
rem sums come in closed form.
fun Low sums High Weight Mod
  Count' = ((High - Low) // 2 + 1) max 0
  Linear' = Count * Low + Count * (Count - 1)
  Pairs' = Count * (Count - 1) // 2
  Previous' = Count - 1
  Product' = Previous * Count
  Cube' = Product * (2 * Count - 1) // 6
  Leading' = Count * Low * Low
  Square' = Leading + 4 * Low * Pairs
  Squares' = Square + 4 * Cube
  Base' = Count * Weight + Squares
  Total' = Base + 2 * Linear
  rem Each odd-w contribution is even.
  Terms' = (Total // 2) mod Mod
  return Terms sum
end
Reach = 8 * Limit
Last = ((Reach + 3) isqrt) - 2
Answer = 0
for Index in 0 to (Last - 1) // 2
  U = 1 + 2 * Index
  Flat = Reach - U * U - 4 * U
  Edge = (Flat - 1) max 0
  Top = U min ((Edge isqrt) - 2)
  Count = (Top + 1) // 2 + 1
  rem Top keeps every Rest nonnegative.
  Odds = (0 to Count - 1) * 2 - 1
  Used = U * U + 4 * U + 5
  Rest = Reach - Used - Odds * Odds
  Rest = Rest - 4 * Odds
  Radius = (Rest max 0) isqrt
  Lower = (0 - Radius) max (0 - Odds - 2)
  Upper = Radius min Odds
  Low = Lower + (Lower + 1) mod 2
  High = Upper - (Upper + 1) mod 2
  Gap = 11 - U * U - Odds * Odds
  On = Gap greater 0
  Cut = ((Gap - 1) max 0) isqrt + 1
  End = On choose (High min (0 - Cut)) High
  LastLeft = End - (End + 1) mod 2
  Begin = On choose (Low max Cut) (High + 2)
  FirstRight = Begin + (Begin + 1) mod 2
  Base = U * U + Odds * Odds + 2 * U
  Weight = Base + 2 * Odds + 3
  Part1 = Low sums LastLeft Weight Mod
  Part2 = FirstRight sums High Weight Mod
  Part = Part1 + Part2
  Answer = (Answer + Part) mod Mod
end
Answer print
