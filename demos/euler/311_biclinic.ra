rem Biclinic Integral Quadrilaterals
rem https://projecteuler.net/problem=311

use numbers
use sequences
use io
use cli

option Limit integer = 10 ** 10
option Block integer = 4000000

Top = Limit // 4
Answer = 0
for Low in 1 to Top by Block
  High = (Low + Block - 1) Top min
  Answer += Low High biclinic_block
end
Answer print

fun Low High biclinic_block
  Size = High - Low + 1
  Cnt = array shape Size fill 0
  Root = (High / 2) ** 0.5 floor
  for Y in 1 to Root
    Y2 = Y * Y
    Min = Y2 + (Y + 1) ** 2
    if Min greater High
      continue
    end
    X1 = Y + 1
    Need = Low - Y2
    if Need greater X1 * X1
      X1 = Need ** 0.5 floor
      if X1 * X1 less Need
        X1 += 1
      end
      if X1 at most Y
        X1 = Y + 1
      end
    end
    X2 = (High - Y2) ** 0.5 floor
    for X in X1 to X2
      T = Y2 + X * X
      Cnt (T - Low) += 1
    end
  end
  Answer = 0
  for I in 0 till Size
    R = Cnt I
    if R at least 2
      N = Low + I
      T3 = R * (R - 1) * (R - 2)
      Answer += T3 // 6
      if N mod 2 equal 0
        Half = N // 2
        Root = Half ** 0.5 floor
        if Root * Root equal Half
          Answer += R * (R - 1) // 2
        end
      end
    end
  end
  return Answer
end
