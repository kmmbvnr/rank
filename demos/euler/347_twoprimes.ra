rem Largest Integer with Two Primes
rem https://projecteuler.net/problem=347

use sequences
use io
use cli

option Limit integer = 10000000

fun Limit twoprimes
  Ps = primes till Limit array
  Sum = 0
  for I in 0 till (Ps len)
    P = Ps I
    if P * P greater Limit
      break
    end
    for J in (I + 1) till (Ps len)
      Q = Ps J
      if P * Q greater Limit
        break
      end
      Best = 0
      Power = P
      for Power * Q at most Limit
        Value = Power * Q
        for Value * Q at most Limit
          Value *= Q
        end
        Best = Best Value max
        Power *= P
      end
      Sum += Best
    end
  end
  return Sum
end

Answer = Limit twoprimes
Answer print
