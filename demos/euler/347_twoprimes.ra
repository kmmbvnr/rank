rem Largest Integer with Two Primes
rem https://projecteuler.net/problem=347

use algo
use sequences
use io
use cli

arg Limit integer = 10000000

fun Limit twoprimes
  Ps = primes to Limit // 2 array
  Sum = 0
  for I in 0 till (Ps len)
    P = Ps I
    if P * P greater Limit
      break
    end
    Hi = Ps upperindex (Limit // P)
    Lo = Ps upperindex (Limit // P // P)
    Lo = Lo max (I + 1)
    rem Higher powers stop before Lo.
    Sum += P * (Ps (Lo till Hi) sum)
    for J in I + 1 till Lo
      Q = Ps J
      Best = 0
      Power = P
      for Power * Q at most Limit
        Value = Power * Q
        for Value * Q at most Limit
          Value *= Q
        end
        Best = Best max Value
        Power *= P
      end
      Sum += Best
    end
  end
  return Sum
end

return Limit twoprimes
