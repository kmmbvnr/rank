use testing

test "default input"
  use "061_cyclicfigurate" as solve
  Out = solve
  Answer = Out .answer

  Answer equal 28684
end

test "figurate numbers"
  use "061_cyclicfigurate" as solve
  Out = solve
  Grid = Out .grid

  Grid 0 4 equal 15
  Grid 1 4 equal 25
  Grid 2 4 equal 35
  Grid 3 4 equal 45
  Grid 4 4 equal 55
  Grid 5 4 equal 65
end

test "example cycle from the statement"
  use "061_cyclicfigurate" as solve
  Out = solve
  Vals = Out .vals

  8128 in Vals
  8281 in Vals
  2882 in Vals
end
