rem Flipping Game
rem https://projecteuler.net/problem=459

use algo
use numbers
use sequences
use bits
use io
use cli

arg N integer = 1000000

rem The board is the nim product of
rem two coin games, heights (triangle
rem numbers) and widths (squares). On
rem one axis g_i = mex of x_(i-1) xor
rem x_(i-l), x the prefix xor of g,
rem and a move has nimber x_i xor
rem x_(i-l). Winning moves pair row
rem nimber a with column nimber b, a
rem times b equal to the board nimber.
fun N Lengths flips
  Prefix = array shape (N + 1) fill 0
  rem Mex is at most the move count;
  rem prefix xors need at most twice it.
  Size = Lengths len
  Capacity = 2 * Size + 2
  Seen = array shape Capacity fill 0
  Hits = array shape Capacity fill 0
  for I in 1 to N
    Count = Lengths upperindex I
    Old = Prefix (
      I - Lengths (0 till Count)) copy
    Last = Prefix (I - 1)
    Seen (Last bxor Old) = I
    Mex = Seen first index where (
      Seen not equal I)
    Now = Last bxor Mex
    Prefix I = Now
    Hits (Now bxor Old) += 1 .accumulate
  end
  return tuple Hits (Prefix N)
end

Root = 2 * N isqrt + 1
Steps = 1 to Root copy
Triangles = Steps * (Steps + 1) // 2
Squares = Steps * Steps
unpack Rows Row = N flips Triangles
unpack Cols Col = N flips Squares
RowKeys = Rows greater 0 indices
ColKeys = Cols greater 0 indices
Ends = array 1 Row Col
Used = concat Ends RowKeys ColKeys
Last = Used max
Size = Last + 1
Rows = Rows (0 till Size)
Cols = Cols (0 till Size)
rem Grow nim products from Base to
rem Base^2, using H^2 = 3H/2.
Table = array 0 0 0 1
Base = 2
for Base less Size
  Width = Base * Base min Size
  Flat = 0 till Width * Width copy
  RowIndex = Flat // Width
  ColIndex = Flat mod Width
  HighRow = RowIndex // Base
  LowRow = RowIndex mod Base
  HighCol = ColIndex // Base
  LowCol = ColIndex mod Base
  Top = Table (HighRow * Base + HighCol)
  Left = Table (HighRow * Base + LowCol)
  Side = Table (LowRow * Base + HighCol)
  Low = Table (LowRow * Base + LowCol)
  Twist = Table (Top * Base + Base // 2)
  Upper = Top bxor Left bxor Side
  Lower = Low bxor Twist
  Table = (Upper * Base + Lower) copy
  Base = Width
end
Nim = Table reshape Size Size
Goal = Table (Row * Size + Col)
Counts = Rows Cols outer *
return Counts (Nim equal Goal) sum
