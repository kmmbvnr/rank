use testing

test "default input"
  use "181_groupingtwocolours" as solve
  Answer = solve

  Answer equal 83735848679360680
end

test "smaller sets"
  use "181_groupingtwocolours" as solve
  Answer = solve 2 1

  Answer equal 4
  Answer = solve 5 7

  Answer equal 975
  Answer = solve 10 15

  Answer equal 508866
end
