use testing

test "default input"
  use "076_countsums" as solve
  Answer = solve

  Answer equal 190569291
end

test "statement example"
  use "076_countsums" as solve
  Answer = solve 5

  Answer equal 6
end

test "small totals"
  use "076_countsums" as solve
  Answer = solve 10

  Answer equal 41
  Answer = solve 2

  Answer equal 1
  Answer = solve 1

  Answer equal 0
end

test "exact beyond real precision"
  use "076_countsums" as solve
  Answer = solve 300

  Answer equal 9253082936723601
end
