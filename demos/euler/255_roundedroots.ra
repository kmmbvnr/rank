rem Rounded Square Roots
rem https://projecteuler.net/problem=255
rem Find the average number of
rem iterations of x -> (x + ceil(n / x))
rem // 2, from the start 2 10^((d -
rem 1)/2) for odd d and 7 10^((d - 2)/2)
rem for even d, until x stops changing,
rem over the n with d digits

use numbers
use io
use cli

arg Digits integer = 14

rem Count one iteration per active n
rem each time a group is visited. After
rem the first step, x is at least the
rem rounded root, so n > x (x - 1) is
rem already stable. Trim that suffix.
rem Process the last child directly;
rem keep only its siblings on the stack.
First = 10 ** (Digits - 1)
Last = 10 ** Digits - 1
X0 = 2 * 10 ** (Digits // 2)
if Digits mod 2 equal 0
  X0 = 7 * 10 ** (Digits // 2 - 1)
end
Cap = 400
Sx = array shape Cap fill 0
Sl = array shape Cap fill 0
Sh = array shape Cap fill 0
Total = Last - First + 1
C = (First + X0 - 1) // X0
Cend = (Last + X0 - 1) // X0
for
  if C greater Cend
    break
  end
  Y = (X0 + C) // 2
  C2 = 2 * Y + 1 - X0
  if Cend less C2
    C2 = Cend
  end
  Nlo = (C - 1) * X0 + 1
  if First greater Nlo
    Nlo = First
  end
  Nhi = C2 * X0
  if Last less Nhi
    Nhi = Last
  end
  if Y not equal X0
    X = Y
    Lo = Nlo
    Hi = Nhi
    Top = 0
    for
      Total += Hi - Lo + 1
      Bound = X * (X - 1)
      if Hi greater Bound
        Hi = Bound
      end
      if Lo at most Hi
        D1 = (Lo + X - 1) // X
        D2 = (Hi + X - 1) // X
        D = D1
        for
          Z = (X + D) // 2
          D3 = 2 * Z + 1 - X
          if D2 less D3
            D3 = D2
          end
          Mlo = (D - 1) * X + 1
          if Lo greater Mlo
            Mlo = Lo
          end
          Mhi = D3 * X
          if Hi less Mhi
            Mhi = Hi
          end
          if D3 equal D2
            X = Z
            Lo = Mlo
            Hi = Mhi
            break
          end
          Sx Top = Z
          Sl Top = Mlo
          Sh Top = Mhi
          Top += 1
          D = D3 + 1
        end
        continue
      end
      if Top equal 0
        break
      end
      Top -= 1
      X = Sx Top
      Lo = Sl Top
      Hi = Sh Top
    end
  end
  C = C2 + 1
end
Count = Last - First + 1
Answer = Total / Count round 10
Answer print
