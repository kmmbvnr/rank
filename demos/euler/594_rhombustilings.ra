rem Rhombus Tilings
rem https://projecteuler.net/problem=594

use numbers
use sequences
use io
use cli

arg A integer = 4
arg B integer = 2

rem O(a, b) is a zonogon of four edge
rem directions 0 .. 3 with a, b, a, b
rem parallel copies; a tiling is a
rem commutation class of adjacent swaps
rem taking the word 0^a 1^b 2^a 3^b to
rem its reverse. T(w) counts tilings
rem between path w and the last path:
rem every tiling has a non-empty set of
rem tiles on w (adjacent ascents that
rem flip, none overlapping), so by
rem inclusion-exclusion over those sets
rem T(w) = sum (-1)^(|S|+1) T(flip S).
Ln = 2 * A + 2 * B
Bs = 4 ** Ln
Tv = array shape Bs fill 0
Nw = 1
for I in 1 to Ln
  Nw *= I
end
for I in 1 to A
  Nw = Nw // I // I
end
for I in 1 to B
  Nw = Nw // I // I
end
Vc = array shape Nw fill 0
Dg = array shape Ln fill 0
Pos = 0
for Lt in 0 to 3
  Cnt = A
  if Lt mod 2 equal 1
    Cnt = B
  end
  for I in 0 till Cnt
    Dg Pos = Lt
    Pos += 1
  end
end
P4 = array shape Ln fill 1
for I in 1 till Ln
  P4 I = (P4 (I - 1)) * 4
end
rem Lexicographic multiset permutations enumerate exactly
rem the admissible words in increasing numeric-code order.
for Q in 0 till Nw
  Cd = 0
  for P in 0 till Ln
    Cd = Cd * 4 + (Dg P)
  end
  Vc Q = Cd
  if Q less Nw - 1
    P = Ln - 2
    for (Dg P) at least (Dg (P + 1))
      P -= 1
    end
    J = Ln - 1
    for (Dg J) at most (Dg P)
      J -= 1
    end
    X = Dg P
    Dg P = Dg J
    Dg J = X
    L = P + 1
    R = Ln - 1
    for L less R
      X = Dg L
      Dg L = Dg R
      Dg R = X
      L += 1
      R -= 1
    end
  end
end
rem Swapping an ascent reduces its code, so dependencies
rem have already been counted; no inversion sort is needed.
rem Each extension adds only a non-overlapping tile and
rem flips its inclusion-exclusion sign.
Sc = array shape (2 ** Ln) fill 0
Ss = array shape (2 ** Ln) fill 0
Sp = array shape (2 ** Ln) fill 0
for Q in 0 till Nw
  Cd = Vc Q
  Cu = Cd
  for P in 0 till Ln
    Dg P = Cu mod 4
    Cu = Cu // 4
  end
  Tt = 0
  if Q equal 0
    Tt = 1
  else
    Ns = 1
    Sc 0 = Cd
    Ss 0 = -1
    Sp 0 = -2
    for P in 0 till (Ln - 1)
      Wl = Dg P
      Wr = Dg (P + 1)
      if Wl less Wr
        Dl = (Wr - Wl) * 3 * (P4 P)
        Old = Ns
        for K in 0 till Old
          if (Sp K) less P - 1
            Nc = (Sc K) - Dl
            Sg = 0 - (Ss K)
            Tt += Sg * (Tv Nc)
            Sc Ns = Nc
            Ss Ns = Sg
            Sp Ns = P
            Ns += 1
          end
        end
      end
    end
  end
  Tv Cd = Tt
end
St = 0
Pw = 1
for Lt in 0 to 3
  Cnt = A
  if Lt mod 2 equal 1
    Cnt = B
  end
  for I in 1 to Cnt
    St += Lt * Pw
    Pw *= 4
  end
end
Answer = Tv St
Answer print
