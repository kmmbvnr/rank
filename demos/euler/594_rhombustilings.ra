rem Rhombus Tilings
rem https://projecteuler.net/problem=594

use numbers
use sequences
use io
use cli

arg A integer = 4
arg B integer = 2

rem O(a, b) is a zonogon of four edge
rem directions 0 .. 3 with a, b, a, b
rem parallel copies; a tiling is a
rem commutation class of adjacent swaps
rem taking the word 0^a 1^b 2^a 3^b to
rem its reverse. T(w) counts tilings
rem between path w and the last path:
rem every tiling has a non-empty set of
rem tiles on w (adjacent ascents that
rem flip, none overlapping), so by
rem inclusion-exclusion over those sets
rem T(w) = sum (-1)^(|S|+1) T(flip S).
Ln = 2 * A + 2 * B
Bs = 4 ** Ln
Tv = array shape Bs fill 0
Nw = 1
for I in 1 to Ln
  Nw *= I
end
for I in 1 to A
  Nw = Nw // I // I
end
for I in 1 to B
  Nw = Nw // I // I
end
Vc = array shape Nw fill 0
Rv = array shape Nw fill 0
Nk = 0
Dg = array shape Ln fill 0
for Cd in 0 till Bs
  C0 = 0
  C1 = 0
  C2 = 0
  C3 = 0
  Cu = Cd
  for P in 0 till Ln
    X = Cu mod 4
    Dg P = X
    Cu = Cu // 4
    if X equal 0
      C0 += 1
    elif X equal 1
      C1 += 1
    elif X equal 2
      C2 += 1
    else
      C3 += 1
    end
  end
  Ok = (C0 equal A) and (C1 equal B)
  Ok = Ok and (C2 equal A)
  Ok = Ok and (C3 equal B)
  if Ok
    Rm = 0
    for I in 0 till Ln
      for J in (I + 1) till Ln
        if (Dg I) less (Dg J)
          Rm += 1
        end
      end
    end
    Vc Nk = Cd
    Rv Nk = Rm
    Nk += 1
  end
end
Od = Rv argsort
for Q in 0 till Nw
  Id = Od Q
  Cd = Vc Id
  Cu = Cd
  for P in 0 till Ln
    Dg P = Cu mod 4
    Cu = Cu // 4
  end
  Tt = 0
  if (Rv Id) equal 0
    Tt = 1
  else
    Na = 0
    for P in 0 till (Ln - 1)
      if (Dg P) less (Dg (P + 1))
        Na += 1
      end
    end
    Ap = array shape Na fill 0
    Na = 0
    for P in 0 till (Ln - 1)
      if (Dg P) less (Dg (P + 1))
        Ap Na = P
        Na += 1
      end
    end
    for Mk in 1 till 2 ** Na
      Ok = 1
      Nc = Cd
      Sz = 0
      Pv = 0 - 5
      for I in 0 till Na
        if (Mk // 2 ** I) mod 2 equal 1
          P = Ap I
          if P equal Pv + 1
            Ok = 0
          end
          Pv = P
          Wl = Dg P
          Wr = Dg (P + 1)
          Dl = Wr - Wl
          Nc += Dl * 4 ** P
          Nc -= Dl * 4 ** (P + 1)
          Sz += 1
        end
      end
      if Ok equal 1
        if Sz mod 2 equal 1
          Tt += Tv Nc
        else
          Tt -= Tv Nc
        end
      end
    end
  end
  Tv Cd = Tt
end
St = 0
Pw = 1
for Lt in 0 to 3
  Cnt = A
  if Lt mod 2 equal 1
    Cnt = B
  end
  for I in 1 to Cnt
    St += Lt * Pw
    Pw *= 4
  end
end
Answer = Tv St
Answer print
