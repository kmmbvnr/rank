rem Twos Are All You Need
rem https://projecteuler.net/problem=708

use numbers
use sequences
use algo
use io
use cli

arg Limit integer = 10 ** 14

rem 2^Omega(n) = (tau * c)(n) with c
rem multiplicative, c(p) = 0 and c(p^e)
rem = 2^(e-2). So S(N) is the sum over
rem powerful q of c(q) D(N / q), where
rem D is the divisor summatory function.
rem Powerful q are grown in waves: a new
rem prime squared, or one more power of
rem the last prime. D comes from a tau
rem prefix table when N / q is below
rem sqrt(N), else from the hyperbola.
Root = Limit isqrt
Sieve = Root primesieve
Primes = Sieve array
Tau = array shape (Root + 1) fill 0
Squares = (1 to Root isqrt) ** 2
Tau Squares = 1
Reach = ((4 * Root + 1) isqrt - 1) // 2
for Step in 1 to Reach
  First = Step * Step + Step
  Tau (First to Root by Step) += 2
end
Table = Tau scan +
Powerful = array 1
LastIdx = array -1
Weight = array 1
SmallQ = array shape 0 fill 0
SmallW = array shape 0 fill 0
Answer = 0
Iota = 0 to Root * 4
for Powerful len greater 0
  IsSmall = Powerful at most Root
  KeepQ = Powerful filter IsSmall
  KeepW = Weight filter IsSmall
  SmallQ = concat SmallQ KeepQ
  SmallW = concat SmallW KeepW
  IsBig = Powerful greater Root
  BigQ = Powerful filter IsBig
  Values = Limit // BigQ
  BigW = Weight filter IsBig
  Divisors = Table Values
  Gains = BigW * Divisors
  Answer += Gains sum
  LastPrime = Primes (LastIdx max 0)
  Room = Limit // LastPrime
  Fits = Powerful at most Room
  Grow = (LastIdx at least 0) and Fits
  Product = Powerful * LastPrime
  UpQ = Product filter Grow
  UpL = LastIdx filter Grow
  UpW = (Weight * 2) filter Grow
  Bound = (Limit // Powerful) isqrt
  Allowed = Primes upperindex Bound
  Free = Allowed - LastIdx - 1
  Choices = Free max 0
  HasKids = Choices greater 0
  ParentQ = Powerful filter HasKids
  ParentL = LastIdx filter HasKids
  ParentW = Weight filter HasKids
  KidCount = Choices filter HasKids
  KidTotal = KidCount sum
  Ends = KidCount scan +
  Starts = Ends - KidCount
  Marks = array shape KidTotal fill 0
  Marks Starts = 1
  Owner = (Marks scan +) - 1
  Range = Iota take KidTotal
  Offset = Range - (Starts Owner)
  KidIdx = (ParentL Owner) + 1 + Offset
  KidPrime = Primes KidIdx
  Base = ParentQ Owner
  Square = KidPrime * KidPrime
  Powerful = concat UpQ (Base * Square)
  LastIdx = concat UpL KidIdx
  Weight = concat UpW (ParentW Owner)
end
for Index in 0 to SmallQ len - 1
  Value = Limit // (SmallQ Index)
  Side = Value isqrt
  Divs = 1 to Side
  Quotients = Value // Divs
  HyperSum = Quotients sum
  Gain = 2 * HyperSum - Side * Side
  Answer += (SmallW Index) * Gain
end
return Answer
