rem Repunit Divisibility
rem https://projecteuler.net/problem=129
rem Find the least n coprime to ten
rem whose shortest repunit multiple has
rem more than Limit digits

use sequences
use io
use cli

arg Limit integer = 1000000
arg Window integer = 30

rem A(n) is at most n, so start above
rem Limit. The mask is deferred: first
rem stops checking candidates at the hit.
Candidates = Limit + 1 to Limit + Window array
Long' = Candidates exceeds_limit rank 0
Answer = Candidates first where Long
Answer print

fun N exceeds_limit
  if N mod 2 equal 0 or N mod 5 equal 0
    return false
  end

  rem Append a digit without constructing
  rem the repunit itself. A zero remainder
  rem ends the search; Limit steps suffice
  rem to establish that A(n) is larger.
  R = 1
  K = 1
  for R not equal 0 and K at most Limit
    R = (10 * R + 1) mod N
    K += 1
  end
  return K greater Limit
end
