rem Digit Cancelling Fractions
rem https://projecteuler.net/problem=33
rem Multiply the four non-trivial two-digit
rem fractions and reduce their denominator

use numbers
use io

Answer = 10 99 digit_fraction_denominator
Answer print


rem Test every proper fraction once and keep
rem identities preserved by one cancellation.
fun digit_fraction_denominator Lower Upper
  NumeratorProduct = 1
  DenominatorProduct = 1

  for Numerator in Lower until Upper
    for Denominator in (Numerator + 1) to Upper
      if Numerator Denominator curious
        NumeratorProduct *= Numerator
        DenominatorProduct *= Denominator
      end
    end
  end

  Divisor = NumeratorProduct DenominatorProduct gcd
  return DenominatorProduct // Divisor
end


rem Check the four positions where one common
rem nonzero digit can be removed.
fun curious Numerator Denominator
  NLeft = Numerator // 10
  NRight = Numerator % 10
  DLeft = Denominator // 10
  DRight = Denominator % 10

  if NLeft equal DLeft
    if Numerator * DRight equal Denominator * NRight
      return true
    end
  end
  if NLeft equal DRight
    if Numerator * DLeft equal Denominator * NRight
      return true
    end
  end
  if NRight greater 0 and NRight equal DLeft
    if Numerator * DRight equal Denominator * NLeft
      return true
    end
  end
  if NRight greater 0 and NRight equal DRight
    if Numerator * DLeft equal Denominator * NLeft
      return true
    end
  end

  return false
end
