use testing

test "statement values"
  use "434_rigidgrid" as solve
  Out = solve 5
  Answer = Out .answer
  Rg = Out .rg
  Rg 2 3 equal 19
  Rg 5 5 equal 23679901
  Answer equal 25021721
end

test "small grids"
  use "434_rigidgrid" as solve
  Out = solve 3
  Rg = Out .rg
  Rg 2 2 equal 5
  Rg 3 2 equal Rg 2 3
  Rg 1 3 equal 1
end

test "empty and single squares"
  use "434_rigidgrid" as solve
  Out = solve 0
  Answer = Out .answer
  Rg = Out .rg
  Answer equal 0
  Out = solve 1
  Answer = Out .answer
  Rg = Out .rg
  Answer equal 1
  Rg 1 1 equal 1
end
