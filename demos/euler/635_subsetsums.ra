rem Subset Sums
rem https://projecteuler.net/problem=635

use numbers
use sequences
use algo
use io
use cli

arg L integer = 100000000

rem For an odd prime p, roots of unity
rem give A_q(p) = (C(q p, p) + q (p -
rem 1)) / p, and A_q(2) = q^2 - q. The
rem factorials needed are those at p,
rem 2 p and 3 p, taken from a running
rem k! mod M filled chunk by chunk.
M = 1000000009
Pr = primes from 3 till (L + 1) array
Np = Pr len
F1 = (0 to (Np - 1)) * 0
F2 = F1 * 1
F3 = F1 * 1
Wc = 4000000
Fk = 1
for A in 0 to 3 * L by Wc
  Fh = (0 to (Wc - 1)) * 0
  for K in A to A + Wc - 1
    if K greater 0
      Fk = Fk * K mod M
    end
    Fh (K - A) = Fk
  end
  for Fm in 1 to 3
    Ta = A + Fm - 1
    Tb = Ta + Wc
    Lo = Pr lowerindex (Ta // Fm)
    Hi = Pr lowerindex (Tb // Fm)
    if Hi greater Lo
      Ps = Pr (Lo till Hi)
      Vs = Fh (Fm * Ps - A)
      if Fm equal 1
        F1 (Lo till Hi) = Vs
      end
      if Fm equal 2
        F2 (Lo till Hi) = Vs
      end
      if Fm equal 3
        F3 (Lo till Hi) = Vs
      end
    end
  end
end
Sq = F1 * F1 mod M
D2 = Sq * Pr mod M
N2 = (F2 + 2 * (Pr - 1) * Sq) mod M
Ip = D2 (M - 2) M powmod
S2 = (N2 * Ip mod M) sum
Pq = F1 * F2 mod M
D3 = Pq * Pr mod M
N3 = (F3 + 3 * (Pr - 1) * Pq) mod M
Iq = D3 (M - 2) M powmod
S3 = (N3 * Iq mod M) sum
Answer = (S2 + S3 + 8) mod M
Answer print
