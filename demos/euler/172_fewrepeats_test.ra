use testing

test "default input"
  use "172_fewrepeats" as solve
  Answer = solve

  Answer equal 227485267000992000
end

test "smaller sizes"
  use "172_fewrepeats" as solve
  Answer = solve 4 2

  Answer equal 8667
  Answer = solve 5 2

  Answer equal 82296
  Answer = solve 6 3

  Answer equal 888570
end
