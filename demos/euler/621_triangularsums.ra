rem Triangular Number Sums
rem https://projecteuler.net/problem=621

use numbers
use sequences
use io
use cli

arg N integer = 17526000000000

rem 8 T + 1 = (2 k + 1)^2, so G(N) =
rem r3(8 N + 3) / 8 with every square
rem odd. Write 8 N + 3 = f^2 m, m
rem squarefree, so m = 3 mod 8, D =
rem -m is 5 mod 8 and
rem G = 6 h(D) S / w, w = 6 for m = 3
rem and 2 else, S the product over
rem p^e || f of sigma(p^e) -
rem (D / p) sigma(p^(e - 1)). The class
rem number h counts reduced forms
rem (a, b, c): for odd b with 3 b^2 <=
rem m, the divisors a of (b^2 + m) / 4
rem from b up to its square root, twice
rem unless a = b or a = c. a is odd and
rem has only primes with (D / p) not -1.
Q = 8 * N + 3
Pr = primes to (Q isqrt) array
Dv = Pr ((Q mod Pr equal 0) indices)
Nd = Dv len
Ex = Dv * 0
Rm = Q
for J in 0 to Nd - 1
  P = Dv J
  for Rm mod P equal 0
    Rm = Rm // P
    Ex J += 1
  end
end
M = Rm
for J in 0 to Nd - 1
  if Ex J mod 2 equal 1
    M *= Dv J
  end
end
H = 0
B = 1
Bm = (M // 3) isqrt
Am = ((Bm * Bm + M) // 4) isqrt + 1
Pa = primes from 3 to Am array
Lg = ((0 - M) mod Pa) ((Pa - 1) // 2) Pa powmod
Bd = Pa ((Lg equal Pa - 1) indices)
Bad = (0 to Am) * 0
for P in Bd
  Bad (P to Am by P) = 1
end
Od = (1 to Am by 2) * 1
Gd = Od ((Bad Od equal 0) indices)
for 3 * B * B at most M
  T = (B * B + M) // 4
  Rt = T isqrt
  Cs = Gd (((T mod Gd) equal 0) indices)
  Cs = Cs ((Cs at least B) indices)
  Cs = Cs ((Cs at most Rt) indices)
  Ge = ((Cs greater B) integer) * (((Cs * Cs) less T) integer)
  H += (1 + Ge) sum
  B += 2
end
S = 1
for J in 0 to Nd - 1
  P = Dv J
  Fe = Ex J // 2
  if Fe greater 0
    R = (0 - M) mod P
    R = R ((P - 1) // 2) P powmod
    Pl = (R equal 1) integer
    Mn = (R equal P - 1) integer
    Sy = Pl - Mn
    Sg = (P ** (Fe + 1) - 1) // (P - 1)
    Sh = (P ** Fe - 1) // (P - 1)
    S *= Sg - Sy * Sh
  end
end
W = 2 + 4 * ((M equal 3) integer)
Answer = 6 * H * S // W
Answer print
