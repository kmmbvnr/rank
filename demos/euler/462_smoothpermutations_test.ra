use testing

test "statement values"
  use "462_smoothpermutations" as solve
  Out = solve 6
  F = Out .f
  F equal 5
  Out = solve 8
  F = Out .f
  F equal 9
  Out = solve 20
  F = Out .f
  F equal 450
end

test "n = 1000"
  use "462_smoothpermutations" as solve
  Out = solve 1000
  Answer = Out .answer
  Answer equal "8.8521816557e21"
end
