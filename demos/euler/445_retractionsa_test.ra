test "empty rows and odd symmetry"
  use "445_retractionsa" as solve
  Answer = solve 0
  Answer equal 0
  Answer = solve 1
  Answer equal 0
  Answer = solve 2
  Answer equal 1
  Answer = solve 3
  Answer equal 2
end
