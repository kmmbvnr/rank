rem Integer Part of Polynomial Equation
rem https://projecteuler.net/problem=438

use numbers
use sequences
use io
use cli

arg N integer = 7

rem Write P(x) = sum of a_k times the
rem falling factorial x^(n-k), so
rem integer a_k match integer
rem coefficients. P must alternate in
rem sign at x = 1 .. n + 1, and so
rem must every forward difference. The
rem difference of order n - t at
rem x = 1 .. t + 1 uses a_0 .. a_t only
rem and bounds a_t on both sides. The
rem sum of |coefficients| is
rem |P(-1)| - 1. The last a_N only
rem shifts every P(K) by a_N, so the
rem strict sign alternation is an
rem interval of a_N (counted with a
rem closed sum); the few a_N that
rem make some P(K) zero are checked
rem in floats.
W = N + 2
Af = array shape (W * W) fill 0
for I in 0 to N + 1
  Af (I * W) = 1
  for J in 1 to I
    Pv = Af ((I - 1) * W + J - 1)
    Af (I * W + J) = Pv * I
  end
end
Ac = array shape W fill 0
Ac 0 = 1
Lo = array shape W fill 0
Hi = array shape W fill 0
Cu = array shape W fill 0
Vs = array shape W fill 0
Big = 1000000000000000000
Cnt = 0
Tot = 0
T = 1
Nb = 1
for T at least 1
  if Nb equal 1
    Lw = 0 - Big
    Hg = Big
    for X in 1 to T + 1
      S = 0
      for I in 0 to T - 1
        F1 = Af ((N - I) * W + N - T)
        F2 = Af (X * W + T - I)
        S -= Ac I * F1 * F2
      end
      S = S // Af ((N - T) * W + N - T)
      if X mod 2 not equal T mod 2
        if S greater Lw
          Lw = S
        end
      elif S less Hg
        Hg = S
      end
    end
    Lo T = Lw
    Hi T = Hg
    Cu T = Lw
    Nb = 0
    if T equal N
      Mno = Big
      Mxo = 0 - Big
      Mne = Big
      Mxe = 0 - Big
      for K in 1 to N + 1
        R = 0
        for I in 0 to N - 1
          R = R * (K + I - N) + Ac I
        end
        Bk = R * K
        Vs K = Bk
        if K mod 2 equal 1
          if Bk less Mno
            Mno = Bk
          end
          if Bk greater Mxo
            Mxo = Bk
          end
        else
          if Bk less Mne
            Mne = Bk
          end
          if Bk greater Mxe
            Mxe = Bk
          end
        end
      end
      R = 0
      for I in 0 to N - 1
        R = R * (I - 1 - N) + Ac I
      end
      Cm = 0 - R
      rem Odd positive, even negative.
      P1 = (1 - Mno) max Lw
      Q1 = (0 - Mxe - 1) min Hg
      rem Odd negative, even positive.
      P2 = (1 - Mne) max Lw
      Q2 = (0 - Mxo - 1) min Hg
      for Pt in 0 to 1
        P = P1
        Q = Q1
        if Pt equal 1
          P = P2
          Q = Q2
        end
        if P at most Q
          Nq = Q - P + 1
          U = Cm + P
          V = Cm + Q
          Sa = 0
          if U at least 0
            Sa = (U + V) * Nq // 2
          elif V at most 0
            Sa = 0 - (U + V) * Nq // 2
          else
            Sa = (0 - U) * (1 - U) // 2
            Sa += V * (V + 1) // 2
          end
          Cnt += Nq
          Tot += Sa - Nq
        end
      end
      rem a_N that zeroes some P(K).
      for K in 1 to N + 1
        A0 = 0 - Vs K
        Dup = 0
        for J in 1 to K - 1
          if Vs J equal Vs K
            Dup = 1
          end
        end
        if Dup equal 0
          if A0 at least Lw
            if A0 at most Hg
              Ok = 1
              for J in 1 to N
                Xr = J + 0.9999
                Rf = 0.0
                for I in 0 to N - 1
                  Qf = Xr + I - N
                  Rf = Rf * Qf + Ac I
                end
                Rf = Rf * Xr + A0
                Vj = Vs J + A0
                if Vj * Rf greater 0
                  Ok = 0
                end
              end
              if Ok equal 1
                Cnt += 1
                Tot += (Cm + A0) abs - 1
              end
            end
          end
        end
      end
      Cu T = Hi T + 1
    end
  end
  if Cu T greater Hi T
    T -= 1
    if T at least 1
      Cu T += 1
    end
  else
    Ac T = Cu T
    T += 1
    Nb = 1
  end
end
Answer = Tot
Answer print
