rem Integer Part of Polynomial Equation
rem https://projecteuler.net/problem=438

use numbers
use algo
use linalg
use sequences
use io
use cli

arg N integer = 7
Width = N + 2
Keys = 0 to N + 1 array
Facts = (1 to N + 1) scan * with 1
Facts = Facts copy
Row = Keys reshape Width 1
Col = Keys reshape 1 Width
Valid = Col at most Row
Safe = Valid choose Col Row
Binom = Row binomial Safe
Binom = Valid choose Binom 0
Falling = Binom * Facts
Points = 1 to N + 1 array
Powers = N to 1 by -1 array
Values = Falling Points Powers
ValueBasis = Values transpose
Sign = (0 - 1) ** N
Flip = (0 - 1) ** Powers
Weights = (Facts Powers) * Flip
Parity = (N + 1) mod 2
Positive = Points mod 2 equal Parity
Signs = Positive choose 1 (0 - 1)
Negative = not Positive

fun Size derivatives
  Count = Size + 1
  Values = array shape Count fill 1
  Slopes = array shape Count fill 0
  Table = array shape Count Width fill 0
  for Power in 1 to Size
    Factor = Points - Power + 1
    Slopes = Slopes * Factor + Values
    Values *= Factor
    Table # Power = Slopes
  end
  return Table
end
Slopes = N derivatives
SlopeBasis = (Slopes # Powers) transpose

rem Use all interlacing endpoint sets.
rem Every alternating set of nodes gives
rem a signed divided-difference bound.
fun Degree circuits
  Order = N - Degree
  Sets = Points combinations (Order + 1)
  Nodes = Sets copy
  Left = Nodes # (0 till Order)
  Right = Nodes # (1 to Order)
  Gaps = Right - Left
  Odd = Gaps mod 2 equal 1
  Keep = Odd all axis 1
  Nodes = (Nodes Keep #) copy
  Count = Nodes len
  First = Nodes # 0
  Parity = Degree mod 2
  Lower = First mod 2 not equal Parity
  Used = 0 till Degree array
  Values = Falling Nodes (N - Used)
  for Step in 1 to Order
    Span = Order + 1 - Step
    LeftCells = Values # (0 till Span) #
    RightCells = Values # (1 to Span) #
    End = Nodes # (Step to Order)
    Start = Nodes # (0 till Span)
    Scale = End - Start
    Scale3 = Scale reshape Count Span 1
    Change = RightCells - LeftCells
    Values = Change // Scale3
  end
  Basis = Values reshape Count Degree
  return tuple Basis Lower
end

fun N prepare_bounds
  Middle = (N + 1) // 2
  Cases = N + 1 binomial Middle
  Cuts = array shape N Cases N fill 0
  Low = array shape N Cases fill false
  Counts = array shape N fill 0
  for Degree in 1 to N - 1
    Plan = Degree circuits
    Basis = Plan 0
    Lower = Plan 1
    Count = Lower len
    Rows = 0 till Count
    Columns = 0 till Degree
    Cuts Degree Rows Columns = Basis
    Low Degree Rows = Lower
    Counts Degree = Count
  end
  return tuple Cuts Low Counts
end
Plans = N prepare_bounds
Cuts = Plans 0
LowCuts = Plans 1
CutCounts = Plans 2

fun Rows bounds Degree
  Count = CutCounts Degree
  Index = 0 till Count
  Used = 0 till Degree
  Basis = Cuts Degree Index Used
  Right = Basis transpose
  Numerator = Rows matmul Right
  Limits = 0 - Numerator
  Lower = LowCuts Degree Index
  Upper = not Lower
  Low = (Limits # Lower) max axis 1
  High = (Limits # Upper) min axis 1
  Count = Rows len
  First = Low reshape Count 1
  Last = High reshape Count 1
  Pair = concat First Last axis 1
  return Pair copy
end

rem Expand integer intervals with scans.
fun Rows extend Degree
  Ends = Rows bounds Degree
  Low = Ends # 0
  High = Ends # 1
  Keep = High at least Low
  Rows = (Rows Keep #) copy
  Low = Low Keep
  Counts = (High Keep) - Low + 1
  Stop = Counts scan +
  Start = Stop - Counts
  Total = Counts sum
  Mark = array shape Total fill 0
  Mark Start = 1
  Owner = (Mark scan +) - 1
  Offset = (0 till Total) - Start Owner
  Next = (Low Owner) + Offset
  Prefix = Rows Owner #
  Column = Next reshape Total 1
  Expanded = concat Prefix Column axis 1
  return Expanded copy
end

rem At a zero endpoint, the derivative
rem fixes the sign immediately to its
rem left. Repeated roots are excluded.
fun Rows score
  Values = Rows matmul ValueBasis
  Slopes = Rows matmul SlopeBasis
  Inclusive = Slopes * Signs less 0
  Edge = Inclusive choose 0 1
  Lower = Edge - Values
  Upper = 0 - Edge - Values
  Low = (Lower # Positive) max axis 1
  High = (Upper # Negative) min axis 1
  Ways = (High - Low + 1) max 0
  Constant = Rows matmul Weights
  Ends = 2 * Constant + Low + High
  Totals = Sign * Ends * Ways // 2
  Count = Ways sum
  Total = Totals sum
  Score = Total - Count
  return array Count Score
end

rem Keep every search frontier bounded.
fun Rows explore Degree
  if Degree equal N
    return Rows score
  end
  Count = Rows len
  Ways = 0
  Total = 0
  for Start in 0 till Count by 256
    Stop = Count min (Start + 256)
    Batch = Rows (Start till Stop) #
    Children = Batch extend Degree
    Next = Degree + 1
    Result = Children explore Next
    Ways += Result 0
    Total += Result 1
  end
  return array Ways Total
end

Rows = array shape 1 1 fill 1
Cnt = 1
Answer = 0
if N greater 0
  Result = Rows explore 1
  Cnt = Result 0
  Answer = Result 1
end
Answer print
