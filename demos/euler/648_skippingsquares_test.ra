use testing

test "smallest truncations"
  use "648_skippingsquares" as solve
  Answer = solve 1
  Answer equal 1
  Answer = solve 2
  Answer equal 1
  Answer = solve 3
  Answer equal 0
end

test "statement values"
  use "648_skippingsquares" as solve
  Answer = solve 10
  Answer equal 53964
  Answer = solve 50
  Answer equal 842418857
end

test "default input"
  use "648_skippingsquares" as solve
  Answer = solve
  Answer equal 301483197
end
