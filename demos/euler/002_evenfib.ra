rem Even Fibonacci Numbers
rem https://projecteuler.net/problem=2
rem Sum even Fibonacci terms <= 4e6

use numbers
use io
use cli

rem Upper boundary, included.
option Limit integer = 4000000

rem Builtin: `use sequences`
rem `fibonacci to Limit`.
Fib = fibs to Limit
Mask = Fib even
Answer = Fib Mask sum
Answer print


fun fibs
  Prev = 1
  Curr = 2
  for
    yield Prev
    Next = Prev + Curr
    Prev = Curr
    Curr = Next
  end
end
