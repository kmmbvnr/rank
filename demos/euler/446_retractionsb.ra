rem Retractions B
rem https://projecteuler.net/problem=446

use numbers
use sequences
use io
use cli
arg N integer = 10000000

rem R(m) is its unitary-divisor sum - m.
rem n^4 + 4 splits into (n-1)^2 + 1
rem and (n+1)^2 + 1. Their only shared
rem prime is 2, corrected by 5/9.
Mod = 1000000007
Top = N + 1

fun Primes roots
  Count = Primes len
  Result = array shape Count fill 0
  Slots = 0 till Count copy
  Powers = (Primes - 1) // 4
  Seed = 2
  for Primes len greater 0
    Values = Seed Powers Primes powmod
    Squared = Values * Values mod Primes
    Good = Squared equal Primes - 1
    Result (Slots Good) = Values Good
    Pending = Good equal false
    Primes = Primes Pending
    Powers = Powers Pending
    Slots = Slots Pending
    Seed += 1
  end
  return Result
end

Small = primes to Top copy
Small = Small (Small mod 4 equal 1)
Roots = Small roots
Primes = concat Small Small copy
Other = Small - Roots
Roots = concat Roots Other copy
Inverse = 9 (Mod - 2) Mod powmod
Correction = 5 * Inverse mod Mod

rem Expand runs without scalar callbacks.
fun Counts expand
  Ends = Counts scan +
  Starts = Ends - Counts
  Total = Counts sum
  Mark = array shape Total fill 0
  Mark Starts = 1
  Owner = (Mark scan +) - 1
  Offset = (0 till Total) - Starts Owner
  return tuple Owner Offset
end

rem Continue only the repeated factors.
fun Factors powers Slots
  Rest = (Slots * Slots + 1) // Factors
  Powers = Factors copy
  Pending = Rest mod Factors equal 0
  Active = Pending indices
  Rest = Rest Active
  Dividers = Factors Active
  for Active len greater 0
    Current = Powers Active
    Powers Active = Current * Dividers
    Rest = Rest // Dividers
    Pending = Rest mod Dividers equal 0
    Active = Active Pending
    Rest = Rest Pending
    Dividers = Dividers Pending
  end
  return Powers
end

rem Combine prime powers by position;
rem the unsieved remainder is prime.
fun Start block Stop
  Low = Start - 1
  High = Stop + 1
  Size = High - Low + 1
  First = Low + ((Roots - Low) mod Primes)
  Keep = First at most High
  Steps = Primes Keep
  First = First Keep
  Counts = (High - First) // Steps + 1
  unpack Owner Offset = Counts expand
  Factors = Steps Owner
  Slots = First Owner + Offset * Factors
  Keys = Slots - Low
  Powers = Factors powers Slots
  Divisors = Powers reduce * by Keys with 1 size Size
  Values = (Powers + 1) mod Mod
  Products = (Values reduce * by Keys with 1 size Size) mod Mod
  Range = Low to High copy
  Odd = Range mod 2 equal 1
  Twos = Odd choose 2 1
  Rest = (Range * Range + 1) // Twos
  Rest = Rest // Divisors
  Big = Rest greater 1
  Scale = Big choose (Rest + 1) 1
  Products = Products * Scale mod Mod
  Scale = Odd choose 3 1
  Products = Products * Scale mod Mod
  Length = Stop - Start + 1
  Left = Products (0 till Length)
  Right = Products (2 to Length + 1)
  Range = Start to Stop copy
  Pair = Left * Right mod Mod
  Even = Range mod 2 equal 0
  Scaled = Pair * Correction mod Mod
  Terms = Even choose Scaled Pair
  Square = Range * Range mod Mod
  Fourth = Square * Square mod Mod
  Total = (Terms - Fourth - 4) mod Mod
  return Total sum mod Mod
end

rem Bound temporary event storage.
Block = 131072
Answer = 0
for Start in 1 to N by Block
  Stop = N min (Start + Block - 1)
  Answer += Start block Stop
end
Answer = Answer mod Mod
Answer print
