rem Counting Rectangles
rem https://projecteuler.net/problem=85
rem Find the grid area whose rectangle
rem count is nearest to a target

use numbers
use sequences
use io
use cli

option Target integer = 2000000

rem A grid a by b holds T(a) * T(b)
rem rectangles, T(n) = n (n + 1) / 2.
rem Keep the short side below 100.
Reach = Target * 2 isqrt
A = 1 to 100 array
B = 1 to (Reach + 1) array
TA = A * (A + 1) // 2
TB = B * (B + 1) // 2
Count' = TA TB outer *
Gap' = (Count - Target) abs
Rows = A len
Cols = B len
Size = Rows * Cols
Flat = Gap reshape Size
Area' = A B outer *
Cells = Area reshape Size
Answer = Cells (Flat min .index)
Answer print
