rem Cutting Triangles
rem https://projecteuler.net/problem=557
use numbers
use sequences
use bits
use algo
use io
use cli
arg N integer = 10000
rem Equal reciprocal sums pair the
rem outer (a,T) with inner (a+b,a+c).
Bound = N max 1
Bits = Bound binary len
Base = 2 ** Bits
Radix = 2 * Base
Size = N * (N + 1) // 2
rem Bound transient pair matrices.
Block = 50
fun Start pairs rank 0
  Stop = Start + Block - 1 min N
  Rows = Stop - Start + 1
  Width = N - Start + 1
  Range = Start to Stop copy
  Column = Range reshape Rows 1
  Row = Start to N copy
  Mask = Row at least Column
  Flat = Mask reshape #
  Places = Flat indices
  Left = Start + Places // Width
  Right = Start + Places mod Width
  Sum = Left + Right
  Product = Left * Right
  Common = Sum gcd Product
  Den = Product // Common
  Num = Sum // Common
  Keys = Den * Radix + Num
  return Keys * Base + Left
end
Packed = array shape Size fill 0
Offset = 0
for Start in 1 to N by Block
  Part = Start pairs
  Length = Part len
  End = Offset + Length
  Packed (Offset till End) = Part
  Offset = End
end
Packed = Packed sort
rem Overlap windows to retain groups
rem that cross a window boundary.
Window = 1000000
fun Start matches rank 0
  Stop = Start + Window min Size
  Keys = Packed (Start - 1 till Stop)
  Keys = Keys // Base
  Count = Keys len
  Last = Count - 1
  Before = Keys take Last
  After = Keys drop 1
  Hits = Before equal After indices
  Hits += Start
  return concat (Hits - 1) Hits
end
Begins' = 1 till Size by Window
Matches' = Begins matches
Selected = concat unpack Matches
Selected = Selected unique sort
Values = Packed Selected
fun Values total
  Count = Values len
  if Count equal 0
    return 0
  end
  Keys = Values // Base
  Left = Values mod Base
  Den = Keys // Radix
  Num = Keys mod Radix
  Bottom = Num * Left - Den
  Right = Den * Left // Bottom
  unpack # Counts = Keys unique .counts
  Ends = Counts scan +
  Starts = Ends - Counts
  Positions = 0 till Count copy
  Owners = Ends upperindex Positions
  Rank = Positions - Starts Owners
  Later = Counts Owners - 1 - Rank
  return Right * Later sum
end
Answer = Values total
return Answer
