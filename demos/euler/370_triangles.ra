rem Geometric Triangles
rem https://projecteuler.net/problem=370

use numbers
use io
use cli

option Limit integer = 25000000000000

Answer = Limit triangles
Answer print

rem Small rows enumerate Q directly. Large rows group equal quotients and
rem reuse the square-free signed divisors of P for inclusion-exclusion.
fun Limit triangles
  Top = (Limit // 3) isqrt
  Spf = array shape (Top + 1) fill 0
  Spf 1 = 1
  for P in 2 to Top
    if Spf P equal 0
      Spf P = P
      for Q in P * P to Top by P
        if Spf Q equal 0
          Spf Q = P
        end
      end
    end
  end
  rem Square-free divisors are a subset of the at most 2 * sqrt(P) divisors.
  Scratch = 2 * (Top isqrt) + 1
  Fs = array shape Scratch fill 0
  Ds = array shape Scratch fill 0
  Cut = (Limit ** (1 / 3)) integer
  Sum = 0
  Small = Cut Top min
  for P in 1 to Small
    End = ((5 * P * P) isqrt + P) // 2
    Nq = ((4 * Limit - 3 * P * P) isqrt - P) // 2
    if Nq less End
      End = Nq
    end
    Count = 0
    X = P
    for X greater 1
      D = Spf X
      Fs Count = D
      Count += 1
      for X mod D equal 0
        X //= D
      end
    end
    for Q in P to End
      Cop = true
      for I in 0 till Count
        if Q mod Fs I equal 0
          Cop = false
          break
        end
      end
      if Cop
        Sum += Limit // (Q * Q + P * Q + P * P)
      end
    end
  end
  for P in Small + 1 to Top
    End = ((5 * P * P) isqrt + P) // 2
    Nq = ((4 * Limit - 3 * P * P) isqrt - P) // 2
    if Nq less End
      End = Nq
    end
    Ds 0 = 1
    Size = 1
    Phi = P
    X = P
    for X greater 1
      D = Spf X
      Phi = (Phi // D) * (D - 1)
      for J in 0 till Size
        Ds (J + Size) = 0 - D * Ds J
      end
      Size *= 2
      for X mod D equal 0
        X //= D
      end
    end
    Lo = P
    rem There are Phi(P) coprime positive integers below P.
    PrevCop = Phi
    for Lo at most End
      Norm = Lo * Lo + P * Lo + P * P
      Quot = Limit // Norm
      Bound = Limit // Quot
      Hi = ((4 * Bound - 3 * P * P) isqrt - P) // 2
      if Hi greater End
        Hi = End
      end
      CopCount = 0
      for I in 0 till Size
        D = Ds I
        if D greater 0
          CopCount += Hi // D
        else
          D = 0 - D
          CopCount -= Hi // D
        end
      end
      Sum += (CopCount - PrevCop) * Quot
      rem The next block starts immediately after this coprime prefix.
      PrevCop = CopCount
      Lo = Hi + 1
    end
  end
  return Sum
end
