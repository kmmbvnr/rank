use testing

test "default input"
  use "098_anagramsquares" as solve
  Answer = solve

  Answer equal 18769
end

test "statement pair"
  use "098_anagramsquares" as solve
  use io
  "\"CARE\",\"RACE\"" write "/tmp/euler098.txt"
  Answer = solve "/tmp/euler098.txt"

  Answer equal 9216
  "\"BOARD\",\"BROAD\",\"APPLE\"" write "/tmp/euler098.txt"
  Answer = solve "/tmp/euler098.txt"

  Answer equal 18769
end

test "pairs without square mapping"
  use "098_anagramsquares" as solve
  use io
  "\"ACT\",\"CAT\",\"TO\",\"OT\"" write "/tmp/euler098.txt"
  Answer = solve "/tmp/euler098.txt"

  Answer equal 0
end
