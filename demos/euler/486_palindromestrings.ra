rem Palindrome-containing strings
rem https://projecteuler.net/problem=486

use numbers
use sequences
use algo
use io
use cli

arg L integer = 1000000000000000000

rem Avoiding lengths 5 and 6 suffices.
rem For n = 9 + 6t + u, the cumulative
rem count is 2^(10+u)64^t - 200t - C_u.
Bias = array 182 216 252 286 318 350

fun Value inverse Mod
  if Mod equal 1
    return 0
  end
  Value = Value mod Mod
  if Value equal 1
    return 1
  end
  Rest = Mod mod Value
  Previous = Rest inverse Value
  Answer = (1 - Mod * Previous) // Value
  return Answer mod Mod
end

fun Mod prepare
  Trials = 1 till Mod copy
  Mask = 64 Trials Mod powmod equal 1
  Order = Trials Mask first
  Steps = 0 till Order copy
  Powers = 64 Steps Mod powmod
  Scale = 200 inverse Mod
  Back = Order inverse Mod
  Meta = tuple Mod Scale Back
  return tuple Steps Powers Meta
end

fun Table residues Offset
  unpack Steps Powers Meta = Table
  unpack Mod Scale Back = Meta
  Twos = 2 (10 + Offset) Mod powmod
  Target = Twos * Powers
  Target -= Bias Offset
  Target = Target * Scale mod Mod
  Order = Steps len
  Slot = (Target - Steps) * Back mod Mod
  Period = Order * Mod
  Values = Steps + Order * Slot
  return tuple Values Period
end

fun Left join Right
  unpack A Ma = Left
  unpack B Mb = Right
  Gcd = Ma gcd Mb
  Reduced = Mb // Gcd
  Back = Ma // Gcd inverse Reduced
  Width = B len
  Count = A len
  Size = Count * Width
  Slots = 0 till Size copy
  A = A (Slots // Width)
  B = B (Slots mod Width)
  Mask = (B - A) mod Gcd equal 0
  A = A Mask
  B = B Mask
  Index = (B - A) // Gcd * Back
  Index = Index mod Reduced
  Period = Ma * Reduced
  Values = (A + Ma * Index) mod Period
  return tuple Values Period
end

rem CRT pairs become cyclic intervals
rem Sort keys by compatibility class.
fun Left count_join Right Limit
  if Limit less 0
    return 0
  end
  unpack A Ma = Left
  unpack B Mb = Right
  Gcd = Ma gcd Mb
  Width = Mb // Gcd
  Back = Ma // Gcd inverse Width
  Keys = B // Gcd * Back mod Width
  Keys += (B mod Gcd) * Width
  Keys = Keys sort
  Base = (A mod Gcd) * Width
  Shift = A // Gcd * Back mod Width
  Period = Ma * Width
  Whole = Limit // Period
  Rest = Limit mod Period
  Bound = (Rest - A) // Ma
  Bound = Bound max -1 min (Width - 1)
  End = Shift + Bound
  Lower = Keys upperindex (Base - 1)
  Top = Base + Width - 1
  Upper = Keys upperindex Top
  Pairs = Upper - Lower
  Bottom = Base + Shift - 1
  Low = Keys upperindex Bottom
  Wrap = End - Width max -1
  End = End min (Width - 1)
  High = Keys upperindex (Base + End)
  Extra = Keys upperindex (Base + Wrap)
  Count = High - Low + Extra - Lower
  Total = Pairs sum
  Partial = Count sum
  return Whole * Total + Partial
end

Mods = array 9 1997 4877
Tables = Mods prepare rank 0

fun Offset subtotal
  Left = Tables 0 residues Offset
  Middle = Tables 1 residues Offset
  State = Left join Middle
  Right = Tables 2 residues Offset
  Limit = (L - 9 - Offset) // 6
  return State count_join Right Limit
end

Offsets = 0 to 5
Answer = Offsets subtotal rank 0 sum
return Answer
