rem Maximix Arrangements
rem https://projecteuler.net/problem=336

use sequences
use algo
use io

11 2011 maximix print

fun N Rank maximix
  Text = "ABCDEFGHIJK" (0 till N)
  Text = Text (N - 2) revsuffix
  All = array Text
  for I in (N - 3) to 0 by -1
    Next = new queue
    for Text in All
      After = Text I revsuffix
      for P in (I + 1) till (N - 1)
        Next push (After P revsuffix)
      end
    end
    All = Next array
  end
  All = All sort
  return All (Rank - 1)
end

fun Text I revsuffix
  Front = Text (0 till I)
  Size = Text len
  Back = Text (I till Size) reverse
  return Front + Back
end
