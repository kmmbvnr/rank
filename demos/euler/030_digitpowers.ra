rem Digit Fifth Powers
rem https://projecteuler.net/problem=30
rem Sum numbers equal to the sum of Power-th
rem powers of their decimal digits

use io
use cli

arg Power integer = 5

Answer = Power digit_power_numbers
Answer print


rem Six times the largest digit power safely
rem bounds the fourth- and fifth-power tasks.
fun Power digit_power_numbers
  Upper = 6 * 9 ** Power
  Total = 0
  for N in 2 to Upper
    Sum = N digit_power_sum Power
    if Sum equal N
      Total += N
    end
  end
  return Total
end


rem Apply the power to every decimal digit,
rem then reduce the resulting values.
fun N digit_power_sum Power
  Text = N text
  Digits' = Text integer rank 0
  Powers' = Digits ** Power
  return Powers sum
end
