use testing

rem Small limits keep reference-mode
rem corpus checks within their budget.
test "small limits"
  use "245_coresilience"
  Limit = 100000
  run

  Answer equal 595394
  Limit = 10000000
  run

  Answer equal 275069018
  Limit = 1000000000
  run

  Answer equal 145645009845
end

test "semiprime boundaries"
  use "245_coresilience"
  Limit = 14
  run

  Answer equal 0
  Limit = 15
  run

  Answer equal 15
  Limit = 84
  run

  Answer equal 15
  Limit = 85
  run

  Answer equal 100
end
