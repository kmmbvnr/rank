use testing

rem Small limits keep reference-mode
rem corpus checks within their budget.
test "small limits"
  use "245_coresilience" as solve
  Answer = solve 100000

  Answer equal 595394
end

test "semiprime boundaries"
  use "245_coresilience" as solve
  Answer = solve 14

  Answer equal 0
  Answer = solve 15

  Answer equal 15
  Answer = solve 84

  Answer equal 15
  Answer = solve 85

  Answer equal 100
end

test "full-scale checkpoint"
  use "245_coresilience" as solve
  Answer = solve 10000000

  Answer equal 275069018
  Answer = solve 1000000000

  Answer equal 145645009845
end
