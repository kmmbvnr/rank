rem Gozinta Chains
rem https://projecteuler.net/problem=548
use numbers
use sequences
use bits
use algo
use io
use cli

arg L integer = 10000000000000000

rem Bit length bounds total exponents.
Maximum = L binary len
Steps = 1 to Maximum copy
Rows = 0 to Maximum copy
Column = Rows reshape (Maximum + 1) 1
Top = Column + Steps - 1
Bottom = Steps - 1
Choose = Top binomial Bottom
rem Remove repeats from weak chains.
Weights = Steps reshape Maximum 1
Distance = Weights - Steps
Signs = 1 - 2 * (Distance mod 2)
Select = Steps min Weights
Terms = Weights binomial Select
Valid = Weights at least Steps integer
Terms = Terms * Signs * Valid
Scanned = Terms scan + axis 0 with 0
Coefficients = Scanned copy
Primes = primes take Maximum array
Power = Primes reshape (Primes len) 1
Power = Power ** Steps

rem Expand only prime powers that fit.
fun State grow
  Values = State .values
  Previous = State .previous
  Totals = State .totals
  Table = State .table
  Depth = State .depth
  Row = Power Depth
  Bounds = L // Values
  Counts = Row upperindex Bounds
  Counts = Counts min Previous
  Active = Counts greater 0 indices
  Lengths = Counts Active
  Ends = Lengths scan +
  Begin = Ends - Lengths
  Size = Lengths sum
  Positions = 0 till Size copy
  Owners = Ends upperindex Positions
  Source = Active Owners
  Starts = Begin Owners
  Exponent = Positions - Starts + 1
  Parent = Values Source
  Factor = Row (Exponent - 1)
  Children = Parent * Factor
  Weight = Totals Source + Exponent
  Parents = Table Source
  Factors = Choose Exponent
  Product = Parents * Factors copy
  Weights = Coefficients Weight
  Numbers = Weights * Product sum axis 1
  Good = Numbers at most L
  Large = Numbers at least Children
  Good = Good and Large
  Selected = Good indices
  Saved = Numbers Selected copy
  Smallest = Children Selected copy
  Found = State .candidates
  Minima = State .minima
  return record
    .values = Children copy
    .previous = Exponent copy
    .totals = Weight copy
    .table = Product
    .depth = Depth + 1
    .candidates = concat Found Saved
    .minima = concat Minima Smallest
  end
end
fun Previous done Next
  Values = Next .values
  return Values len equal 0
end
Seed = record
  .values = array 1
  .previous = array Maximum
  .totals = array 0
  .table = array shape 1 Maximum fill 1
  .depth = 0
  .candidates = array shape 0 fill 0
  .minima = array shape 0 fill 0
end
Levels = Primes len
Tree = Seed grow repeat Levels till done
Values = Tree .candidates
Patterns = Tree .minima

rem Least number with these exponents.
memo N canonical
  Grouped = N factors unique .counts
  Exponents = Grouped 1
  Sorted = Exponents sort .descending
  Bases = primes take (Sorted len) array
  Terms = Bases ** Sorted
  return Terms reduce * with 1
end
Actual = Values canonical rank 0
Matches = Actual equal Patterns
Answer = Values Matches sum
Answer += L greater 0 integer
return Answer
