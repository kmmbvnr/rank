use testing

test "statement values"
  use "767_windowmatrix" as solve
  Answer = solve 2 4
  Answer equal 65550
  Answer = solve 3 9
  Answer equal 87273560
end

test "larger widths against direct sums"
  use "767_windowmatrix" as solve
  Answer = solve 300 100000
  Answer equal 98747919
  Answer = solve 1000 (10 ** 12)
  Answer equal 309214136
end
