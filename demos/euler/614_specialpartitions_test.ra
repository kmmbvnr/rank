use testing

test "statement sums"
  use "614_specialpartitions" as solve
  Answer = solve 10
  Answer equal 20
  Answer = solve 100
  Answer equal 499397
  Answer = solve 1000
  Answer equal 514141877
end

test "larger sums"
  use "614_specialpartitions" as solve
  Answer = solve 3000
  Answer equal 75198867
  Answer = solve 1000000
  Answer equal 632194023
end
