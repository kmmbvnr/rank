rem Range of Periodic Sequence
rem https://projecteuler.net/problem=729

use numbers
use sequences
use bits
use io
use cli

arg Pp integer = 25

rem Each period-m orbit of a -> a - 1/a
rem is the fixed point of a composition
rem of the inverse branches
rem (y +- sqrt(y^2 + 4)) / 2 picked by a
rem primitive binary word. One word per
rem cyclic class (a Lyndon word) is
rem enough: its m rotations add m times
rem the range. Lyndon words come from
rem growing prenecklaces level by level.
rem The fixed points are found for all
rem words at once by Newton steps at the
rem end of each cycle.
Wd = array 0 1
Per = array 1 1
Lw = array shape 0 fill 0
Lm = array shape 0 fill 0
for K in 1 to Pp - 1
  Aa = (Wd shr (Per - 1)) band 1
  W1 = 2 * Wd + Aa
  Z0 = Aa equal 0
  W2 = (2 * Wd + 1) filter Z0
  P2 = (Wd * 0 + K + 1) filter Z0
  Wd = concat W1 W2
  Per = concat Per P2
  Ly = Per equal (K + 1)
  Nl = Wd filter Ly
  Lw = concat Lw Nl
  Lm = concat Lm (Nl * 0 + K + 1)
end
Ny = Lw len
Yy = Lw * 0.0
Y0 = Yy
Dd = Lw * 0.0 + 1.0
Tc = 6 * Pp
for T in 0 to Tc - 1
  Ix = T mod Lm
  Bt = (Lw shr (Lm - 1 - Ix)) band 1
  Sg = Bt * 2.0 - 1.0
  Rt = (Yy * Yy + 4.0) sqrt
  Dd = Dd * 0.5 * (1.0 + Sg * Yy / Rt)
  Yy = 0.5 * (Yy + Sg * Rt)
  En = Ix equal (Lm - 1)
  Nw = (T // Lm) at least 2
  Yn = Y0 - (Yy - Y0) / (Dd - 1.0)
  Ys = Nw choose Yn Yy
  Yy = En choose Ys Yy
  Y0 = En choose Yy Y0
  Dd = En choose 1.0 Dd
end
Mn = Yy
Mx = Yy
for T in Tc to Tc + Pp - 1
  Ix = T mod Lm
  Bt = (Lw shr (Lm - 1 - Ix)) band 1
  Sg = Bt * 2.0 - 1.0
  Rt = (Yy * Yy + 4.0) sqrt
  Yy = 0.5 * (Yy + Sg * Rt)
  Mn = Mn min Yy
  Mx = Mx max Yy
end
Rg = Lm * (Mx - Mn)
rem Sum by blocks of 64 for accuracy.
for Rg len greater 1
  Ln = Rg len
  Pd = (0 - Ln) mod 64
  Zp = array shape Pd fill 0.0
  Pg = concat Rg Zp
  Rw = (Ln + Pd) // 64
  Mt = Pg reshape Rw 64
  Rg = Mt sum axis 1
end
Answer = Rg 0 text ".4f"
Answer print
