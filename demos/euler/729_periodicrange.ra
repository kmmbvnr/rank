rem Range of Periodic Sequence
rem https://projecteuler.net/problem=729

use numbers
use sequences
use bits
use io
use cli

arg Period integer = 25

rem Each period-m orbit of a -> a - 1/a
rem is the fixed point of a composition
rem of the inverse branches
rem (y +- sqrt(y^2 + 4)) / 2 picked by a
rem primitive binary word. One word per
rem cyclic class (a Lyndon word) is
rem enough: its m rotations add m times
rem the range. Lyndon words come from
rem growing prenecklaces level by level.
rem The fixed points are found for all
rem words at once by Newton steps at the
rem end of each cycle.
Words = array 0 1
Periods = array 1 1
Lyndon = array shape 0 fill 0
Lengths = array shape 0 fill 0
for Level in 1 to Period - 1
  Shift = Periods - 1
  Probe = (Words shr Shift) band 1
  Same = 2 * Words + Probe
  Zeros = Probe equal 0
  Raised = (2 * Words + 1) filter Zeros
  Counts = Words * 0 + Level + 1
  NewPeriods = Counts filter Zeros
  Words = concat Same Raised
  Periods = concat Periods NewPeriods
  IsLyndon = Periods equal (Level + 1)
  Found = Words filter IsLyndon
  Lyndon = concat Lyndon Found
  Longer = Found * 0 + Level + 1
  Lengths = concat Lengths Longer
end
Point = Lyndon * 0.0
Start = Point
Slope = Lyndon * 0.0 + 1.0
Cycles = 6 * Period
for Time in 0 to Cycles - 1
  Phase = Time mod Lengths
  Shift = Lengths - 1 - Phase
  Bit = (Lyndon shr Shift) band 1
  Sign = Bit * 2.0 - 1.0
  Root = (Point * Point + 4.0) sqrt
  Turn = Sign * Point / Root
  Slope = Slope * 0.5 * (1.0 + Turn)
  Point = 0.5 * (Point + Sign * Root)
  AtEnd = Phase equal (Lengths - 1)
  Done = Time // Lengths
  UseNewton = Done at least 2
  Error = Point - Start
  Newton = Start - Error / (Slope - 1.0)
  Pick = UseNewton choose Newton Point
  Point = AtEnd choose Pick Point
  Start = AtEnd choose Point Start
  Slope = AtEnd choose 1.0 Slope
end
Lowest = Point
Highest = Point
Last = Cycles + Period - 1
for Time in Cycles to Last
  Phase = Time mod Lengths
  Shift = Lengths - 1 - Phase
  Bit = (Lyndon shr Shift) band 1
  Sign = Bit * 2.0 - 1.0
  Root = (Point * Point + 4.0) sqrt
  Point = 0.5 * (Point + Sign * Root)
  Lowest = Lowest min Point
  Highest = Highest max Point
end
Ranges = Lengths * (Highest - Lowest)
rem Sum by blocks of 64 for accuracy.
for Ranges len greater 1
  Size = Ranges len
  Pad = (0 - Size) mod 64
  Fill = array shape Pad fill 0.0
  Padded = concat Ranges Fill
  Rows = (Size + Pad) // 64
  Grid = Padded reshape Rows 64
  Ranges = Grid sum axis 1
end
Answer = Ranges 0 text ".4f"
Answer print
