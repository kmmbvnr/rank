use testing

test "statement values"
  use "410_circleandtangent" as solve
  Answer = solve 1 5
  Answer equal 20
  Answer = solve 2 10
  Answer equal 104
  Answer = solve 10 100
  Answer equal 6768
end

test "brute force reference"
  use "410_circleandtangent" as solve
  Answer = solve 12 20
  Answer equal 1648
end

test "blocks agree with one sieve"
  use "410_circleandtangent" as solve
  Answer = solve 200000 300000 70000
  Answer equal 479955026416
end
