use testing

test "small perimeters"
  use "292_pythagoreanpolygons"
  N = 4
  run

  Answer equal 1
  N = 30
  run

  Answer equal 3655
  N = 60
  run

  Answer equal 891045
end

test "empty and odd bounds"
  use "292_pythagoreanpolygons"
  N = 0
  run

  Answer equal 0
  N = 3
  run

  Answer equal 0
  N = 5
  run

  Answer equal 1
  N = 12
  run

  Answer equal 35
  N = 13
  run

  Answer equal 35
end
