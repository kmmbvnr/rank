use testing

test "small perimeters"
  use "292_pythagoreanpolygons" as solve
  Answer = solve 4

  Answer equal 1
  Answer = solve 30

  Answer equal 3655
  Answer = solve 60

  Answer equal 891045
end

test "empty and odd bounds"
  use "292_pythagoreanpolygons" as solve
  Answer = solve 0

  Answer equal 0
  Answer = solve 3

  Answer equal 0
  Answer = solve 5

  Answer equal 1
  Answer = solve 12

  Answer equal 35
  Answer = solve 13

  Answer equal 35
end
