rem The Ackermann function
rem https://projecteuler.net/problem=282
rem Find the sum of A(n, n) for n up to
rem 6, modulo 14^8

use numbers
use sequences
use io
use cli

option Base integer = 14
option Pow integer = 8

rem A(0,0), A(1,1), A(2,2), A(3,3) are
rem 1, 3, 7, 61. A(4,n) = 2^^(n+3) - 3
rem and A(5,n) = 2^^(A(5,n-1)+3) - 3 is
rem a tower too high for the modulus, as
rem is A(6,6): all need 2^^h mod m.
rem Each tower is taken down a chain of
rem totients m, phi(m), ... to 1, with
rem 2^e = 2^(e mod phi + phi) mod m for
rem tall towers, and exact values 2, 4,
rem 16, 65536 for heights 1 to 4.
Mod = Base ** Pow
Ms = array shape 66 fill 1
Chain = Mod
for Step in 0 to 64
  Ms Step = Chain
  if Chain greater 1
    Ps = Chain factors array unique
    Rad = Ps reduce *
    Tot = (Ps - 1) reduce *
    Chain = Chain // Rad * Tot
  end
end
Small = array 1 2 4 16 65536
Tows = array 7 100
Vals = Tows - Tows
for T in 0 to 1
  H = Tows T
  V = 0
  for I in 64 to 0 by -1
    Hi = H - I
    M = Ms I
    Next = Ms (I + 1)
    Pw = 2 (V + Next) M powmod
    Ix = (Hi max 0) min 4
    Ex = Small Ix mod M
    if Hi at most 4
      V = Ex
    else
      V = Pw
    end
  end
  Vals T = V
end
Seven = Vals 0
Tall = Vals 1
Answer = (63 + Seven + 2 * Tall) mod Mod
Answer print
