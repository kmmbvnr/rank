use testing

test "default input"
  use "093_arithmeticexpr"
  run

  Answer equal 1258
  Best equal 51
end

test "statement digits 1 2 3 4 reach 28"
  use "093_arithmeticexpr"
  run

  Set = Vals 30
  28.0 in Set
  1.0 in Set
  not 29.0 in Set
end

test "two digit sets"
  use "093_arithmeticexpr"
  run

  Pair = Vals 6
  3.0 in Pair
  1.0 in Pair
  0.5 in Pair
  not 5.0 in Pair
end
