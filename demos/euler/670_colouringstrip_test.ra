use testing

test "statement values"
  use "670_colouringstrip" as solve
  Answer = solve 2
  Answer equal 120
  Answer = solve 5
  Answer equal 45876
  Answer = solve 100
  Answer equal 53275818
end

test "default input"
  use "670_colouringstrip" as solve
  Answer = solve 10000000000000000
  Answer equal 551055065
end
