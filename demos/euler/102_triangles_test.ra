use testing

test "default input"
  use "102_triangles" as solve
  Answer = solve

  Answer equal 228
end

test "statement triangles"
  use "102_triangles" as solve
  use io
  "-340,495,-153,-910,835,-947\n" write "/tmp/euler102.txt"
  Answer = solve "/tmp/euler102.txt"

  Answer equal 1
  "-175,41,-421,-714,574,-645\n" write "/tmp/euler102.txt"
  Answer = solve "/tmp/euler102.txt"

  Answer equal 0
  "-340,495,-153,-910,835,-947\n-175,41,-421,-714,574,-645\n" write "/tmp/euler102.txt"
  Answer = solve "/tmp/euler102.txt"

  Answer equal 1
  "-1,-1,2,-1,-1,2\n" write "/tmp/euler102.txt"
  Answer = solve "/tmp/euler102.txt"

  Answer equal 1
end
