rem Birthday Problem Revisited
rem https://projecteuler.net/problem=584
use numbers
use sequences
use algo
use linalg
use io
use cli
arg N integer = 365
arg K integer = 4
arg D integer = 7

Bound = K ** D
Codes = 0 till Bound copy
Powers = K ** (0 till D) copy
Grid = Codes reshape Bound 1
Digits = Grid // Powers mod K
Sums = Digits sum axis 1
Good = Sums less K
Codes = Codes Good
Sums = Sums Good
Count = Codes len
Index = array shape Bound fill 0
Index Codes = 0 till Count copy
Limit = N * (K - 1) // (D + 1)
Counts = 1 till K copy
Facts = Counts scan *
Facts = concat (array 1) Facts

rem A(n) weights day counts by 1/c!;
rem expectation sums A(n) n! / N^n.
rem Sparse entries of the transfer.
EdgeCounts = K - Sums
Ends = EdgeCounts scan +
Begins = Ends - EdgeCounts
Edges = EdgeCounts sum
Positions = 0 till Edges copy
Owners = Ends upperindex Positions
Oldest = Positions - Begins Owners
Previous = Oldest * K ** (D - 1)
Previous = Previous + Codes Owners // K
Sources = Index Previous
Added = Codes Owners mod K
Slots = Owners * Count + Sources
Divisors = Facts Added

rem The trace generates A(n). Integrate
rem exp(-t) A(t/N): its moments are n!.
rem Order nodes cover its whole degree.
Order = Limit // 2 + 1
Range = 0 till Order copy
Size = Order * Order
Jacobi = array shape Size fill 0.0
Diagonal = Range * Order + Range
Jacobi Diagonal = 2.0 * Range + 1.0
Side = 1 till Order copy
Upper = (Side - 1) * Order + Side
Lower = Side * Order + Side - 1
Jacobi Upper = Side * 1.0
Jacobi Lower = Side * 1.0
Table = Jacobi reshape Order Order
Spectrum = Table eigh
Nodes = Spectrum 0

rem Recurrence preserves tiny weights.
rem Squared eigenvector entries do not.
Prior = array shape Order fill 1.0
Current = Prior - Nodes
for I in 1 to Order
  Term = 2 * I + 1 - Nodes
  Next = Term * Current - I * Prior
  Next = Next / (I + 1)
  Prior = Current
  Current = Next
end
Factor = (Order + 1) * Current
Weights = Nodes / (Factor * Factor)

fun X trace
  Terms = X ** Added / Divisors
  Size = Count * Count
  Matrix = array shape Size fill 0.0
  Matrix Slots = Terms
  Table = Matrix reshape Count Count
  Power = Table matpow N
  Diagonal = Power diag
  return Diagonal sum
end
Samples = Nodes / N
Values = Samples trace rank 0
Mass = Values * Weights
Answer = Mass sum
Answer = Answer round 8
return Answer
