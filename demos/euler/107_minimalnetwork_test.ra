use testing

test "default input"
  use "107_minimalnetwork"
  run

  Answer equal 259679
end

test "statement network"
  use "107_minimalnetwork"

  Net = array "-,16,12,21,-,-,-" "16,-,-,17,20,-,-" "12,-,-,28,-,31,-" "21,17,28,-,18,19,23" "-,20,-,18,-,-,11" "-,-,31,19,-,-,27" "-,-,-,23,11,27,-"
  Net saving equal 150
end

test "tree has nothing to save"
  use "107_minimalnetwork"

  (array "-,4" "4,-") saving equal 0
end
