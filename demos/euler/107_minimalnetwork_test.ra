use testing

test "default input"
  use "107_minimalnetwork"
  run

  Answer equal 259679
end

test "statement network"
  use "107_minimalnetwork"
  use io
  Raw = "-,16,12,21,-,-,-\n16,-,-,17,20,-,-\n12,-,-,28,-,31,-\n21,17,28,-,18,19,23\n-,20,-,18,-,-,11\n-,-,31,19,-,-,27\n-,-,-,23,11,27,-\n"
  Raw "/tmp/euler107.txt" write
  Input = "/tmp/euler107.txt"
  run

  Answer equal 150
end

test "tree has nothing to save"
  use "107_minimalnetwork"
  use io
  "-,4\n4,-\n" "/tmp/euler107.txt" write
  Input = "/tmp/euler107.txt"
  run

  Answer equal 0
end
