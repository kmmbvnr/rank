use testing

test "default input"
  use "016_powerdigits" as solve
  Answer = solve

  Answer equal 1366
end

test "official small power"
  use "016_powerdigits" as solve
  Answer = solve 15

  Answer equal 26
end

test "zero exponent"
  use "016_powerdigits" as solve
  Answer = solve 0

  Answer equal 1
end

test "doubling with carry"
  use "016_powerdigits"

  "99" double equal "198"
  "128" double equal "256"
end
