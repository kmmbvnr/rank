use testing

test "statement values"
  use "705_inversioncount"
  Limit = 20
  run
  Answer equal 3312
  Limit = 50
  run
  Answer equal 338079744
end

test "empty and decimal boundaries"
  use "705_inversioncount"
  Limit = 1
  run
  Answer equal 0
  Limit = 100
  run
  Answer equal 719294528
  Limit = 1000
  run
  Answer equal 461640134
end
