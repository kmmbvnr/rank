rem Ascending Subsequences
rem https://projecteuler.net/problem=733

use numbers
use sequences
use algo
use io
use cli

arg Length integer = 1000000
arg Prime integer = 1000000007

rem N(t, i) counts the increasing runs
rem of t terms ending at term i and W(t,
rem i) sums their elements. A run of
rem t - 1 terms ending earlier at a
rem smaller value extends: N(t, i) is a
rem prefix sum of N(t - 1) over smaller
rem ranks, W(t, i) = prefix of W(t - 1)
rem + a_i N(t, i). Fenwick trees over
rem value ranks keep the prefix sums.
Index = 1 to Length
Values = 153 Index 10000019 powmod
Distinct = Values sort unique
Ranks = Distinct lowerindex Values
Size = Distinct len
Runs1 = Size fenwick
Runs2 = Size fenwick
Runs3 = Size fenwick
Sums1 = Size fenwick
Sums2 = Size fenwick
Sums3 = Size fenwick
Answer = 0
for Step in 0 to Length - 1
  Rank = Ranks Step
  Value = Values Step
  Ways2 = Runs1 sum (Rank - 1) mod Prime
  Below = Rank - 1
  Part2 = Sums1 sum Below
  Mixed2 = Part2 + Value * Ways2
  Total2 = Mixed2 mod Prime
  Ways3 = Runs2 sum (Rank - 1) mod Prime
  Part3 = Sums2 sum Below
  Mixed3 = Part3 + Value * Ways3
  Total3 = Mixed3 mod Prime
  Ways4 = Runs3 sum (Rank - 1) mod Prime
  Part4 = Sums3 sum Below
  Mixed4 = Part4 + Value * Ways4
  Total4 = Mixed4 mod Prime
  Answer = (Answer + Total4) mod Prime
  Runs1 Rank += 1
  Sums1 Rank += Value
  Runs2 Rank += Ways2
  Sums2 Rank += Total2
  Runs3 Rank += Ways3
  Sums3 Rank += Total3
end
return Answer
