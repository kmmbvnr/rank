rem Strong Repunits
rem https://projecteuler.net/problem=346

use numbers
use algo
use io
use cli

arg Limit integer = 10 ** 12

fun Limit strong
  if Limit at most 1
    return 0
  end
  if Limit less 7
    return 1
  end
  rem Sum all three-digit repunits.
  B = (4 * Limit - 7 isqrt) - 1
  B = B // 2
  Total = B * (B + 1) * (B + 2) // 3
  Total += B - 2
  Seen = new set
  for Base in 2 to (Limit - 1 isqrt)
    Value = Base * Base + Base + 1
    Value = Value * Base + 1
    if Value at least Limit
      break
    end
    for Value less Limit
      rem Skip the three-digit overlaps.
      D = 4 * Value - 3
      Root = D isqrt
      if Root * Root not equal D
        Seen add Value
      end
      Value = Value * Base + 1
    end
  end
  return Total + (Seen sum)
end

Answer = Limit strong
return Answer
