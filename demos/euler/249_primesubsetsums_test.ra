use testing

rem Keep the full default in the manual lane.
test "small limits"
  use "249_primesubsetsums"
  Limit = 10
  run

  Answer equal 7
  Limit = 30
  run

  Answer equal 237
  Limit = 100
  run

  Answer equal 5253640
end

test "wrapped counts and arbitrary moduli"
  use "249_primesubsetsums"
  Limit = 300
  run

  Answer equal 9053434012630419
  Mod = 2
  run

  Answer equal 1
  Mod = 97
  run

  Answer equal 62
  Mod = 1000000000000000000000000000000
  run

  Answer equal 549053434012630419
end
