use testing

rem Keep the full default in the manual lane.
test "small limits"
  use "249_primesubsetsums" as solve
  Answer = solve 10

  Answer equal 7
  Answer = solve 30

  Answer equal 237
  Answer = solve 100

  Answer equal 5253640
end

test "wrapped counts and arbitrary moduli"
  use "249_primesubsetsums" as solve
  Answer = solve 300

  Answer equal 9053434012630419
  Answer = solve 300 2

  Answer equal 1
  Answer = solve 300 97

  Answer equal 62
  Answer = solve 300 1000000000000000000000000000000

  Answer equal 549053434012630419
end
