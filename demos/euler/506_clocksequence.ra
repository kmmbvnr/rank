rem Clock sequence
rem https://projecteuler.net/problem=506

use numbers
use sequences
use io
use cli

option N integer = 100000000000000

rem The stream 1 2 3 4 3 2 ... sums 15
rem per cycle and A_n = n(n+1)/2, so
rem v_n and v_(n+15) start at the same
rem place, and v_(n+15) = 10^6 v_n +
rem a_r (one more cycle of digits).
rem Each class r sums in closed form:
rem b P(K) + a Q(K), P = (B^K - 1) /
rem (B - 1), Q = (P - K) / (B - 1).
Md = 123454321
B = 1000000
Cy = array 1 2 3 4 3 2
St = Cy ((0 till 240) mod 6)
Cs = St scan + with 0
Ns = (1 to 30) copy
An = Ns * (Ns + 1) // 2
rem Stream position after term n.
Ky = concat (Cs * 2) (An * 2 + 1)
Od = Ky argsort
Nc = Cs len
Pb = ((Od less Nc) choose 1 0) scan +
Ps = array shape 30 fill 0
Qp = (Od at least Nc) indices
Ps (Od Qp - Nc) = Pb Qp - 1
Lo = concat (array 0) (Ps (0 till 29))
V = Ns * 0
for I in 0 till 30
  L0 = Lo I
  L1 = Ps I
  Dg = St (L0 till L1)
  V I = Dg (Dg * 0 + 10) fromDigits
end
Bv = V (0 till 15)
Av = V (15 till 30) - B * Bv
rem Md = 41^2 271^2: Euler's phi.
Ph = 41 * 40 * 271 * 270
Iv = (B - 1) (Ph - 1) Md powmod
Rs = (1 to 15) copy
K = ((N - Rs) // 15 + 1) 0 max
Bk = B K Md powmod
P = (Bk - 1) * Iv mod Md
Q = (P - K) mod Md * Iv mod Md
Tr = (Bv mod Md) * P + (Av mod Md) * Q
Answer = (Tr mod Md) sum mod Md
Answer print
