use testing

test "statement values"
  use "412_gnomonnumbering"
  M = 3
  K = 0
  run
  Answer equal 42
  M = 5
  K = 3
  run
  Answer equal 250250
  M = 6
  K = 3
  run
  Answer equal 43800432
end

test "modular value"
  use "412_gnomonnumbering"
  M = 10
  K = 5
  run
  Answer equal 61251715
end

test "chunked factorial"
  use "412_gnomonnumbering"
  M = 10
  K = 5
  Chunk = 7
  run
  Answer equal 61251715
end
