use testing

test "statement values"
  use "412_gnomonnumbering" as solve
  Answer = solve 3 0
  Answer equal 42
  Answer = solve 5 3
  Answer equal 250250
  Answer = solve 6 3
  Answer equal 43800432
end

test "modular value"
  use "412_gnomonnumbering" as solve
  Answer = solve 10 5
  Answer equal 61251715
end

test "chunked factorial"
  use "412_gnomonnumbering" as solve
  Answer = solve 10 5 7
  Answer equal 61251715
end
