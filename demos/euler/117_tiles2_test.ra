use testing

test "default input"
  use "117_tiles2" as solve
  Answer = solve

  Answer equal 100808458960497
end

test "statement row of five"
  use "117_tiles2" as solve
  Answer = solve 5

  Answer equal 15
end

test "short rows"
  use "117_tiles2" as solve
  Answer = solve 1

  Answer equal 1
  Answer = solve 4

  Answer equal 8
end
