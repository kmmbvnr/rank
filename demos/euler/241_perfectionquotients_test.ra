use testing

test "default input"
  use "241_perfectionquotients" as solve
  Answer = solve

  Answer equal 482316491800641154
end

test "small limits"
  use "241_perfectionquotients" as solve
  Answer = solve 1000000

  Answer equal 35234
  Answer = solve 10000000000

  Answer equal 8919474306
  Answer = solve 100000000000000

  Answer equal 17478354204802
end
