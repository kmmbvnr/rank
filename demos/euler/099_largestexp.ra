rem Largest Exponential
rem https://projecteuler.net/problem=99
rem Find the line of base,exponent pairs
rem with the greatest value

use numbers
use sequences
use text
use io
use cli

argument Input path = "demos/euler/fixtures/0099_base_exp.txt"

rem Compare exponent * log(base) instead
rem of the huge powers themselves.
Lines = Input readlines
Flat = Lines "," join
Parts = Flat "," split
Nums = Parts integer
Rows = Lines len
Pairs = Nums reshape Rows 2
Bases = Pairs # 0
Exps = Pairs # 1
Logs = Bases log
Size = Exps * Logs
Answer = (Size max .index) + 1
Answer print
