rem Efficient Exponentiation
rem https://projecteuler.net/problem=122
rem Sum the fewest multiplications that
rem build each power a^k up to a limit

use sequences
use io
use cli

option Limit integer = 200

rem Grow star chains level by level;
rem each new term is the last plus an
rem earlier one. Keep a chain only when
rem its end first appears at this level.
Best = array shape (Limit + 1) fill 99
Best 0 = 0
Best 1 = 0
Ch = (array 1) reshape 1 1
Lv = 0
for Ch len greater 0
  Lv += 1
  R = Ch len
  Last = Ch # (Lv - 1)
  New = (Last reshape R 1) + Ch
  Ok = New at most Limit
  Pos = Ok indices
  Rows = Ch (Pos # 0)
  Val = New filter Ok array
  Cur = Best Val
  Best Val = Cur Lv min
  Keep = (Best Val) equal Lv
  Ext = Val reshape (Val len) 1
  Nxt = concat Rows Ext axis 1
  Ch = Nxt (Keep indices)
end
Answer = Best sum
Answer print
