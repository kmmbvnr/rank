rem Lattice points in lattice cubes
rem https://projecteuler.net/problem=579
use numbers
use sequences
use algo
use io
use cli
arg N integer = 5000

rem Odd norm gives four frames per cube.
rem Sort parts to remove rotations.
fun A quaternions
  Width = A + 1
  Size = Width * Width
  Places = 0 till Size copy
  B = Places // Width
  C = Places mod Width
  Norm = A * A + B ** 2 + C ** 2
  Keep = C at most B
  Keep = Keep and (Norm at most N)
  Selected = Keep indices
  B = B Selected copy
  C = C Selected copy
  Norm = Norm Selected copy
  Last = N - Norm isqrt
  Last = Last min C
  First = 1 - Norm mod 2
  Counts = (Last - First) // 2 + 1
  Counts = Counts max 0
  Ends = Counts scan +
  Starts = Ends - Counts
  Size = Counts sum
  Places = 0 till Size copy
  Owners = Ends upperindex Places
  D = Places - Starts Owners
  D = 2 * D + First Owners
  B = B Owners copy
  C = C Owners copy
  Divisor = A gcd B
  Divisor = Divisor gcd C
  Divisor = Divisor gcd D
  Selected = Divisor equal 1 indices
  B = B Selected copy
  C = C Selected copy
  D = D Selected copy
  return stack B C D
end

rem Expand only scales fitting the box.
fun Spans cubes Side Edges Orbit
  Largest = Spans reduce max axis 0
  Keep = Largest at most N
  Keep = Keep and (Orbit greater 0)
  Selected = Keep indices
  Largest = Largest Selected copy
  Side = Side Selected copy
  Edges = Edges Selected copy
  Orbit = Orbit Selected copy
  X = Spans 0
  Y = Spans 1
  Z = Spans 2
  X = X Selected copy
  Y = Y Selected copy
  Z = Z Selected copy
  Counts = N // Largest
  Ends = Counts scan +
  Starts = Ends - Counts
  Size = Counts sum
  Places = 0 till Size copy
  Owners = Ends upperindex Places
  Scale = Places - Starts Owners + 1
  Length = Scale * Side Owners
  Points = Length ** 3 + 1
  Terms = (Length + 1) * Scale
  Points += Terms * Edges Owners
  X = N + 1 - Scale * X Owners
  Y = N + 1 - Scale * Y Owners
  Z = N + 1 - Scale * Z Owners
  Terms = X * Y * Z * Points
  Terms *= Orbit Owners
  return Terms sum
end

fun A batch rank 0
  Parts = A quaternions
  B = Parts 0
  C = Parts 1
  D = Parts 2
  Power = A * A
  PowerB = B * B
  PowerC = C * C
  PowerD = D * D
  Side = Power + PowerB
  Side += PowerC + PowerD
  R11 = 2 * (Power + PowerB) - Side abs
  R12 = 2 * (B * C - A * D) abs
  R13 = 2 * (B * D + A * C) abs
  R21 = 2 * (B * C + A * D) abs
  R22 = 2 * (Power + PowerC) - Side abs
  R23 = 2 * (C * D - A * B) abs
  R31 = 2 * (B * D - A * C) abs
  R32 = 2 * (C * D + A * B) abs
  R33 = 2 * (Power + PowerD) - Side abs
  X = R11 + R12 + R13
  Y = R21 + R22 + R23
  Z = R31 + R32 + R33
  Rows = stack X Y Z
  X = R11 gcd R21
  X = X gcd R31
  Y = R12 gcd R22
  Y = Y gcd R32
  Z = R13 gcd R23
  Z = Z gcd R33
  Edges = X + Y + Z
  rem Stabilizers shrink the orbit.
  Same = A equal B integer
  Multiplicity = 1 + Same
  Same = A equal C integer
  Same += B equal C integer
  Multiplicity *= 1 + Same
  Same = A equal D integer
  Same += B equal D integer
  Same += C equal D integer
  Multiplicity *= 1 + Same
  Zeros = B equal 0 integer
  Zeros += C equal 0 integer
  Zeros += D equal 0 integer
  Multiplicity *= 2 ** Zeros
  Orbit = 48 // Multiplicity
  rem Distinct parts have two orbits.
  Twin = A greater B
  Twin = Twin and (B greater C)
  Twin = Twin and (C greater D)
  Twin = Twin and (D greater 0)
  Copies = Twin integer
  Orbit //= Copies + 1
  First = Rows cubes Side Edges Orbit
  rem Transpose can change the count.
  X = R11 + R21 + R31
  Y = R12 + R22 + R32
  Z = R13 + R23 + R33
  Columns = stack X Y Z
  X = R11 gcd R12
  X = X gcd R13
  Y = R21 gcd R22
  Y = Y gcd R23
  Z = R31 gcd R32
  Z = Z gcd R33
  Edges = X + Y + Z
  Orbit *= Copies
  Other = Columns cubes Side Edges Orbit
  return First + Other
end

Root = N isqrt
Largest = 1 to Root
Totals = Largest batch
Answer = Totals sum
Answer = Answer mod 1000000000
Answer print
