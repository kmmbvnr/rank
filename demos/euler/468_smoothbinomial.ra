rem Smooth divisors of binomial
rem coefficients
rem https://projecteuler.net/problem=468

use numbers
use sequences
use io
use cli

arg N integer = 11111111

rem With primes p_1 < p_2 < ... and
rem gaps w_i = p_(i+1) - p_i (the last
rem up to N + 1), the sum over b of
rem S_b(C(N, r)) is T_r = 1 + sum w_i
rem G_i, G_i the p_i-smooth part. Each
rem prime is the affine map (A, w A),
rem A = p^a(r), and T_r - 1 is their
rem composition. Sum T_r for r <= N/2
rem and use C(N, r) = C(N, N - r).
Mod = 1000000993
Half = N // 2
Stride = Half + 1
AllPrimes = primes to N array
PrimeCount = AllPrimes len
Next = AllPrimes shift -1 with (N + 1)
Gaps = Next - AllPrimes
SmallCount = AllPrimes at most 30 count
rem For p, carry boundaries alternate
rem N mod p + 1, p, N mod p + 1 + p,
rem 2p, ... . Higher-power boundaries
rem are already present in this list.
fun Count tree_levels
  Width = 1
  Levels = 0
  for Width less Count
    Width *= 2
    Levels += 1
  end
  return Levels
end
fun Bound leaves
  Half = Bound // 2
  Stride = Half + 1
  Selected = SmallCount till PrimeCount
  Primes = AllPrimes Selected
  Count = Primes len
  Levels = Count tree_levels
  Width = 2 ** Levels
  Offsets = Bound mod Primes + 1
  End = Half + Primes - Offsets
  Up = End // Primes
  Counts = 1 + Half // Primes + Up
  Ends = Counts scan +
  Starts = Ends - Counts
  Size = Counts sum
  Groups = array shape Size fill 0
  Groups Starts = 0 till Count copy
  Groups = Groups scan max
  Slots = 0 till Size copy
  Steps = Slots - Starts Groups
  Bases = Primes Groups
  Times = (Steps // 2) * Bases
  Odd = Steps mod 2
  Times += Odd * Offsets Groups
  Keys = Groups * Stride + Times
  Residues = Times mod Bases
  Last = Bound mod Bases
  Carries = Residues greater Last
  Exponents = Carries choose 1 0
  Root = Bound isqrt
  Active = Bases at most Root indices
  Powers = Bases Active
  Powers *= Powers
  for Active len greater 0
    Values = Times Active mod Powers
    Last = Bound mod Powers
    Carry = Values greater Last
    Exponents Active += Carry choose 1 0
    Divisors = Bases Active
    Last = Bound // Divisors
    Keep = Powers at most Last indices
    Active = Active Keep
    Divisors = Divisors Keep
    Powers = (Powers Keep) * Divisors
  end
  Products = Bases Exponents Mod powmod
  Weights = Gaps (Groups + SmallCount)
  Totals = Weights * Products mod Mod
  Padding = Count till Width copy
  Keys = concat Keys (Padding * Stride)
  Ones = Padding * 0 + 1
  Products = concat Products Ones
  Totals = concat Totals (Padding * 0)
  return record
    .keys = Keys
    .product = Products
    .total = Totals
    .levels = Levels
  end
end
rem Compose sibling affine maps after
rem Take the latest event on each side.
fun State merge_maps
  Keys = State .keys
  Products = State .product
  Totals = State .total
  Nodes = Keys // Stride
  Joined = Nodes // 2 * Stride
  Joined += (Keys mod Stride)
  Joined = 2 * Joined + Nodes mod 2
  Order = Joined argsort
  Joined = Joined Order
  Right = Joined mod 2 equal 1
  Slots = 0 till Joined len copy
  Left = Right choose 0 Slots
  Left = Left scan max
  Last = Right choose Slots 0
  Last = Last scan max
  Keys = Joined // 2
  Next = Keys shift -1 with -1
  Ends = Keys not equal Next indices
  First = Order (Left Ends)
  Last = Order (Last Ends)
  Before = Products First
  After = Products Last
  Product = Before * After mod Mod
  After = Totals Last
  Cross = Before * After mod Mod
  Before = Totals First
  Total = Before + Cross mod Mod
  return record
    .keys = Keys Ends
    .product = Product
    .total = Total
    .levels = State .levels - 1
  end
end
fun State merged
  for State .levels greater 0
    State = State merge_maps
  end
  return State
end
fun Bound large_parts
  State = Bound leaves merged
  Keys = State .keys
  Size = Bound // 2 + 1
  Positions = array shape Size fill 0
  Positions Keys = 0 till Keys len copy
  Positions = Positions scan max
  return (State .total) Positions
end
rem Count carries at prime powers.
fun Prime carries Slots Bound
  Counts = Slots * 0
  Power = Prime
  for Power at most Bound
    Residues = Slots mod Power
    Last = Bound mod Power
    Flags = Residues greater Last
    Counts += Flags choose 1 0
    Power *= Prime
  end
  return Counts
end
fun Bound small_parts
  Rows = 0 to Bound // 2 copy
  Product = Rows * 0 + 1
  Total = Rows * 0
  for I in 0 till SmallCount
    Prime = AllPrimes I
    Exponents = Prime carries Rows Bound
    Power = Prime Exponents Mod powmod
    Product = Product * Power mod Mod
    Weight = Gaps I
    Term = Weight * Product mod Mod
    Total = Total + Term mod Mod
  end
  return record
    .product = Product
    .total = Total
  end
end
LargeTotal = N large_parts
Small = N small_parts
Product = Small .product
SmallTotal = Small .total
Term = Product * LargeTotal mod Mod
Values = 1 + SmallTotal + Term mod Mod
Answer = 2 * (Values sum)
if N mod 2 equal 0
  Answer -= Values Half
end
if N equal 0
  Answer = 0
end
Answer = Answer mod Mod
return Answer
