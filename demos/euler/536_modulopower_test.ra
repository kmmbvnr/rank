use testing

test "statement values, fallback check"
  use "536_modulopower" as solve
  Answer = solve 100 100
  Answer equal 32
  Answer = solve 1000000 1000000
  Answer equal 22868117
  Answer = solve 100000000 100000
  Answer equal 12718106902
end

test "small limits and tiny fallback table"
  use "536_modulopower" as solve
  Answer = solve 0 1 1 7
  Answer equal 0
  Answer = solve 1 1 1 7
  Answer equal 1
  Answer = solve 5 1 1 7
  Answer equal 11
  Answer = solve 21 1 1 7
  Answer equal 32
end
