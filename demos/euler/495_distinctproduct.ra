rem Distinct factors of a factorial
rem https://projecteuler.net/problem=495
use numbers
use sequences
use bits
use io
use cli
arg N integer = 10000
arg K integer = 30
Md = 1000000007

rem Expand rows by admissible counts.
fun State include Part
  Remaining = State # 0
  Counts = Remaining // Part + 1
  Prefix = Counts scan + with 0
  Size = Prefix last
  Groups = array shape Size fill 0
  Slots = 0 till Counts len
  Groups (Prefix Slots) = Slots
  Groups = Groups scan max
  Copies = 0 till Size
  Copies -= Prefix Groups
  Rows = State Groups copy
  Rows # 0 = Remaining Groups
  Rows # 0 -= Copies * Part
  Rows # Part = Copies
  return Rows
end

rem Each part adds a residue-class sum.
fun Parts coefficients Top
  Values = array shape (Top + 1) fill 0
  Values 0 = 1
  Slots = 0 to Top copy
  for Part in Parts
    Rows = (Top + Part) // Part
    Size = Rows * Part
    Pad = array shape Size fill 0
    Pad Slots = Values
    Matrix = Pad reshape Rows Part
    Scan = (Matrix scan + axis 0) mod Md
    Flat = Scan reshape #
    Values = Flat Slots
  end
  return Values
end

fun N solve K
  if N equal 0 or N equal 1
    Possible = K equal 0 or K equal 1
    return Possible integer
  end
  if K at most 0
    return 0
  end
  rem Legendre sums for all primes.
  Primes = primes to N array
  Width = N binary len
  Levels = 1 to Width copy
  Grid = Primes reshape (Primes len) 1
  Divisors = Grid ** Levels
  Quotients = N // Divisors
  Exponents = Quotients sum rank 1
  Sorted = Exponents sort
  Next = Sorted shift -1 with -1
  Ends = Sorted not equal Next indices
  Degrees = Sorted Ends
  Previous = Ends shift 1 with -1
  Weights = Ends - Previous
  Top = Degrees last
  Steps = 1 to K copy
  Products = Steps scan * with 1
  Factorials = Products mod Md

  rem Expand positive multiplicities.
  fun Counts contribution
    Active = Counts greater 0 indices
    Prefix = Counts scan + with 0
    Size = Prefix last
    Groups = array shape Size fill 0
    Groups (Prefix Active) = Active
    Groups = Groups scan max
    Expanded = Groups + 1
    Values = Expanded coefficients Top
    Selected = Values Degrees
    Powers = Selected Weights Md powmod
    Product = (Powers reduce *) mod Md
    Terms = Steps Counts Md powmod
    Terms *= Factorials Counts
    Denom = (Terms reduce *) mod Md
    Inverse = Denom (Md - 2) Md powmod
    Result = Product * Inverse mod Md
    if (K - Size) mod 2 equal 1
      return 0 - Result mod Md
    end
    return Result
  end

  rem Leave ones until all other parts.
  Seed = array shape 1 (K + 1) fill 0
  Seed 0 0 = K
  Parts = K to 2 by -1 copy
  Rows = Parts reduce include with Seed
  Rows # 1 = Rows # 0
  Columns = 1 to K copy
  Counts = Rows # Columns
  Totals = Counts contribution rank 1
  return Totals sum mod Md
end

Answer = N solve K
return Answer
