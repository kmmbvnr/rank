use testing

test "sphere of radius two"
  use "449_chocolatecoating" as solve
  Answer = solve 1 1 4096 10
  Answer equal 29.3215314335
end

test "statement checkpoint"
  use "449_chocolatecoating" as solve
  Answer = solve 2 1
  Answer equal 60.35475635
end

test "default input"
  use "449_chocolatecoating" as solve
  Answer = solve
  Answer equal 103.37870096
end
