rem Verifying Primes
rem https://projecteuler.net/problem=574
use numbers
use sequences
use algo
use io
use cli
arg N integer = 3800

rem Half-sized CRT sums stay small.
fun Weights subsets
  Width = Weights len
  Count = 2 ** Width
  Positions = 0 till Count copy
  Places = 2 ** (0 till Width copy)
  Rows = Positions reshape Count 1
  Bits = Rows // Places mod 2
  return Bits * Weights sum axis 1
end

rem Shared bases depend on the primes,
rem not on the number being verified.
fun Count basis
  Small = primes take Count array
  Product = Small reduce * with 1
  Other = Product // Small
  Residues = Other mod Small
  Powers = Small - 2
  Inverse = Residues Powers Small powmod
  Weights = Other * Inverse
  Half = Count // 2
  Left = Weights take Half copy
  Right = Weights drop Half copy
  Left = Left subsets mod Product
  Right = Right subsets mod Product
  return record
    .modulus = Product
    .left = Left copy
    .right = Right copy
  end
end

Root = N isqrt
Small = primes to Root array
Squares = Small * Small
Groups = 0 to (Small len) copy
Bases = Groups basis rank 0 copy

fun Prime verify
  Count = Squares upperindex Prime
  Basis = Bases Count
  Modulus = Basis .modulus
  Left = Basis .left
  Left = Prime * Left mod Modulus
  Right = Basis .right
  Right = Prime * Right mod Modulus
  Right = Right sort
  rem Search sums and differences alike.
  Start = (Prime + 1) // 2
  Targets = (Start - Left) mod Modulus
  Positions = Right lowerindex Targets
  Turns = (Start - Left) // Modulus
  Size = Right len
  Indices = Positions mod Size
  Shift = Turns + Positions // Size
  Candidates = Left + Right Indices
  Candidates += Shift * Modulus
  Remainders = Candidates mod Prime
  Invalid = Remainders equal 0
  Bad = Invalid indices
  rem Advance only inadmissible pairs.
  for Bad len greater 0
    Positions Bad += 1
    Indices = Positions Bad mod Size
    Cycles = Positions Bad // Size
    Shift = Turns Bad + Cycles
    Next = Left Bad + Right Indices
    Next += Shift * Modulus
    Candidates Bad = Next
    Remainders = Candidates mod Prime
    Invalid = Remainders equal 0
    Bad = Invalid indices
  end
  return Candidates min
end

Primes = primes till N array
Values = Primes verify rank 0
return Values sum
