use testing
use text

test "statement values"
  use "419_lookandsay" as solve
  Answer = solve 8
  Answer equal "6,2,2"
  Answer = solve 40
  Answer equal "31254,20259,11625"
end

test "direct string references"
  use "419_lookandsay" as solve
  Answer = solve 20
  Answer equal "155,91,56"
  Answer = solve 35
  Answer equal "8300,5366,3108"
end

test "default input"
  use "419_lookandsay" as solve
  use text
  Answer = solve
  A1 = "998567458"
  A2 = "1046245404"
  A3 = "43363922"
  Want = array A1 A2 A3
  Answer equal (Want join ",")
end
