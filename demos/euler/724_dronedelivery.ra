rem Drone Delivery
rem https://projecteuler.net/problem=724

use numbers
use sequences
use io
use cli

arg People integer = 10 ** 8

rem E(n) = n / 2 (H^2 + H2), where H and
rem H2 are the sums of 1 / k and 1 / k^2
rem to n. Small n are summed directly;
rem large n use the Euler-Maclaurin
rem series with Euler's constant.
Euler = 0.5772156649015329
Pi = 3.141592653589793
Real = People * 1.0
Terms = (1 to (People min 1000)) * 1.0
Harmonic = (1.0 / Terms) sum
HarmSq = (1.0 / Terms ** 2) sum
if People greater 1000
  Logged = Real log
  Harmonic = Logged + Euler + 0.5 / Real
  Harmonic -= 1.0 / (12 * Real ** 2)
  Harmonic += 1.0 / (120 * Real ** 4)
  HarmSq = Pi ** 2 / 6 - 1.0 / Real
  HarmSq += 0.5 / Real ** 2
  HarmSq -= 1.0 / (6 * Real ** 3)
end
Squared = Harmonic * Harmonic
Expected = Real / 2 * (Squared + HarmSq)
Rounded = Expected round 0
Answer = Rounded integer
Answer print
