use testing

test "default input"
  use "024_lexicographic"
  run

  Answer equal "2783915460"
end

test "fourth permutation"
  use "024_lexicographic"
  Position = 4
  run

  Answer equal "0123456897"
end

test "first permutation keeps leading zero"
  use "024_lexicographic"
  Position = 1
  run

  Answer equal "0123456789"
end
