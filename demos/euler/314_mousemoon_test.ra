use testing
use numbers

test "small lattice ratio"
  use "314_mousemoon" as solve
  use numbers
  Answer = solve 10

  Off = Answer - 5.28335868
  Off abs less 0.00000001
end

test "unit lattice ratio"
  use "314_mousemoon" as solve
  use numbers
  Answer = solve 1

  Off = Answer - 0.5
  Off abs less 0.000000000001
end
