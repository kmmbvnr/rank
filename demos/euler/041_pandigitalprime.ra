rem Pandigital Prime
rem https://projecteuler.net/problem=41
rem Find the largest prime using each digit
rem from 1 through N exactly once

use algo
use sequences
use io

Digits = "7654321"
Answer = Digits largest_pandigital_prime
Answer print


rem Descending input makes permutations arrive
rem from largest to smallest candidate.
fun largest_pandigital_prime Digits
  CandidateTexts = Digits permutations
  Candidates = CandidateTexts integer rank 0
  Prime = Candidates in primes
  return (Candidates first where Prime) default 0
end
