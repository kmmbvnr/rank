rem Number Spiral Diagonals
rem https://projecteuler.net/problem=28
rem Sum both diagonals in an odd square spiral

use io
use cli

option Size integer = 1001

Answer = Size spiral_diagonal_sum
Answer print


rem Add the four corners of every concentric
rem odd-sized layer around the center.
fun spiral_diagonal_sum Size
  Layers = 1 to (Size - 1) // 2
  Sides = Layers * 2 + 1
  Corners = 4 * Sides ** 2 - 6 * (Sides - 1)
  return 1 + (Corners sum)
end
