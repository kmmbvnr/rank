use testing

test "default input"
  use "126_cuboidlayers" as solve
  Out = solve
  Answer = Out .answer
  Cnt = Out .cnt
  Tot = Out .tot

  Answer equal 18522
  Tot equal 334886
  Cnt 19998 at least 1
end

test "statement values"
  use "126_cuboidlayers" as solve
  Out = solve 10 200
  Answer = Out .answer
  Cnt = Out .cnt

  Answer equal 154
  Cnt 22 equal 2
  Cnt 46 equal 4
  Cnt 78 equal 5
  Cnt 118 equal 8
end

test "two ways"
  use "126_cuboidlayers" as solve
  Out = solve 2 100
  Answer = Out .answer

  Answer equal 18
end
