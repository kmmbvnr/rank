rem Centaurs on a Chess Board
rem https://projecteuler.net/problem=554
use numbers
use sequences
use bits
use algo
use io
use cli
arg Top integer = 90
rem C(n)=8 binom(2n,n)-3n^2-2n-7.
rem Lucas uses one binomial per digit.
Prime = 100000007
Exponent = Prime - 2
fun Left multiply Right
  return Left * Right mod Prime
end
rem Fold only the gaps between queries.
fun Start gap End rank 0 0
  Span' = Start + 1 to End
  return Span reduce multiply with 1
end
rem Wilson reflects factorials past p/2.
fun Needed factorials
  Reverse = Prime - 1 - Needed
  Small = Needed min Reverse
  Targets = Small unique sort
  Starts = Targets shift 1
  Parts = Starts gap Targets
  Prefix = Parts scan multiply
  Places = Targets lowerindex Small
  Values = Prefix Places
  Inverse = Values Exponent Prime powmod
  Parity = Needed mod 2
  Signs = 2 * Parity - 1
  Reflected = Signs * Inverse mod Prime
  Mirror = Needed greater Small
  return Mirror choose Reflected Values
end
fun Top arrangements
  if Top less 2
    return 0
  end
  Size = Top - 1
  Values = fibonacci take Size array
  Doubled = Values * 2
  Largest = Doubled max
  Bits = Largest binary len
  Radix = Prime binary len - 1
  Width = Bits // Radix + 1
  Bases = array shape Width fill Prime
  Upper = Doubled digits Bases
  Lower = Values digits Bases
  Difference = (Upper - Lower) max 0
  Valid = Upper at least Lower integer
  Flat = concat Upper Lower Difference
  Needed = Flat reshape #
  Facts = Needed factorials
  Count = Width * Size
  Grid = Facts reshape 3 Count
  Numerator = Grid 0
  Bottom = Grid 1 * Grid 2 mod Prime
  Inverse = Bottom Exponent Prime powmod
  Terms = Numerator * Inverse mod Prime
  Digits = Terms reshape Width Size
  Digits = Digits * Valid
  Ways = Digits reduce multiply axis 0
  Residue = Values mod Prime
  Square = Residue * Residue mod Prime
  Offset = 3 * Square + 2 * Residue + 7
  Terms = (8 * Ways - Offset) mod Prime
  return Terms sum mod Prime
end
Answer = Top arrangements
Answer print
