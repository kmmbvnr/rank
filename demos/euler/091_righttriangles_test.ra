use testing

test "default input"
  use "091_righttriangles" as solve
  Answer = solve

  Answer equal 14234
end

test "statement two by two grid"
  use "091_righttriangles" as solve
  Answer = solve 2

  Answer equal 14
end

test "one by one grid"
  use "091_righttriangles" as solve
  Answer = solve 1

  Answer equal 3
end
