use testing

test "default input"
  use "023_abundantsums"
  run

  Answer equal 4179871
end

test "below the first abundant sum"
  use "023_abundantsums"

  Limit = 23
  run

  Answer equal 276
end

test "twenty-four is excluded"
  use "023_abundantsums"

  Limit = 24
  run

  Answer equal 276
end
