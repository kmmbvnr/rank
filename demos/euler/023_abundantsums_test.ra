  Answer = solve 23

  Answer equal 276
end

test "twenty-four is excluded"
  use "023_abundantsums" as solve

  Answer = solve 24

  Answer equal 276
end

test "empty positive range"
  use "023_abundantsums" as solve

  Answer = solve 0

  Answer equal 0
