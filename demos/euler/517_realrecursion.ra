rem A real recursion
rem https://projecteuler.net/problem=517

use numbers
use sequences
use io
use cli

option Lo integer = 10000000
option W integer = 10000

rem A leaf of g with k jumps of sqrt n
rem fixes when the jumps happen, a
rem multiset of k values from 0 to
rem T = n - ceil(k sqrt n), so G(n)
rem sums binomial(T + k, k) over k.
M = 1000000007
Ps = primes from Lo + 1 till Lo + W
P = Ps array
Mx = Lo + W
F = array shape (Mx + 1) fill 1
for I in 1 to Mx
  F I = F (I - 1) * I mod M
end
Fi = array shape (Mx + 1) fill 1
Fi Mx = (F Mx) (M - 2) M powmod
for I in Mx to 1 by -1
  Fi (I - 1) = Fi I * I mod M
end
rem Every (p, k) pair in one array.
Sq = P isqrt
Wd = (Sq max) + 1
I = (0 till (P len) * Wd) copy
J = I // Wd
K = I mod Wd
Ok = (K at most Sq J) indices
J = J Ok
K = K Ok
Pk = P J
rem p is no square, so k sqrt p never
rem is an integer.
Ce = (K * K * Pk) isqrt + 1
Ce = (K greater 0) choose Ce 0
N = Pk - Ce + K
T = F N * Fi K mod M * Fi (N - K) mod M
Answer = (T sum) mod M
Answer print
