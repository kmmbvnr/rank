rem A real recursion
rem https://projecteuler.net/problem=517

use numbers
use sequences
use io
use cli

arg Lo integer = 10000000
arg W integer = 10000

rem A leaf of g with k jumps of sqrt n
rem fixes when the jumps happen, a
rem multiset of k values from 0 to
rem T = n - ceil(k sqrt n), so G(n)
rem sums binomial(T + k, k) over k.
M = 1000000007
Ps = primes from Lo + 1 till Lo + W
P = Ps array
rem Every (p, k) pair in one array.
Sq = P isqrt
Wd = (Sq max) + 1
I = (0 till (P len) * Wd) copy
J = I // Wd
K = I mod Wd
Ok = (K at most Sq J) indices
J = J Ok
K = K Ok
Pk = P J
rem p is no square, so k sqrt p never
rem is an integer.
Ce = (K * K * Pk) isqrt + 1
Ce = (K greater 0) choose Ce 0
N = Pk - Ce + K
T = N K M binomialmod
Answer = (T sum) mod M
Answer print
