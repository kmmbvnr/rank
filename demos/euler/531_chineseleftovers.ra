rem Chinese leftovers
rem https://projecteuler.net/problem=531

use numbers
use sequences
use algo
use io
use cli

arg Lo integer = 1000000
arg Hi integer = 1005000

fun N totient
  Factors = N factors unique array
  Divisor = Factors reduce * with 1
  Terms = Factors - 1
  Product = Terms reduce * with 1
  return N // Divisor * Product
end

fun Low leftovers High
  Count = High - Low
  if Count less 2
    return 0
  end
  Numbers = Low till High copy
  Phi = Numbers totient rank 0
  Small = 1 till Count copy
  SmallPhi = Small totient rank 0
  rem Every pair has one positive gap.
  Answer = 0
  for Distance in 1 till Count
    Width = Count - Distance
    End = Low + Width
    Left = Low till End copy
    Right = Left + Distance
    First = Phi (0 till Width)
    Second = Phi (Distance till Count)
    Delta = Second - First
    Common = Left gcd Distance
    Valid = Delta mod Common equal 0
    Slots = Valid indices
    Left = Left Slots
    First = First Slots
    Delta = Delta Slots
    Common = Common Slots
    Gap = Distance // Common
    Modulus = (Right Slots) // Common
    Delta //= Common
    rem Invert the small reduced gap.
    Power = SmallPhi (Gap - 1)
    Power -= 1
    Inverse = Modulus Power Gap powmod
    rem Lift the inverse to m/g.
    Multiplier = (0 - Inverse) mod Gap
    Inverse = 1 + Modulus * Multiplier
    Inverse //= Gap
    Inverse = Modulus - Inverse
    Inverse mod= Modulus
    Step = Delta * Inverse mod Modulus
    Answer += First + Left * Step sum
  end
  return Answer
end
Answer = Lo leftovers Hi
Answer print
