use testing

test "default input"
  use "259_reachablenumbers"
  run

  Answer equal 20101196798
end

test "fewer digits"
  use "259_reachablenumbers"
  Top = 1
  run

  Answer equal 1
  Top = 2
  run

  Answer equal 17
  Top = 3
  run

  Answer equal 255
  Top = 4
  run

  Answer equal 4179
  Top = 5
  run

  Answer equal 74689
  Top = 6
  run

  Answer equal 1486823
end
