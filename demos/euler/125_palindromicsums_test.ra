use testing

test "default input"
  use "125_palindromicsums"
  run

  Answer equal 2906969179
end

test "statement value for 1000"
  use "125_palindromicsums"
  Limit = 1000
  run

  Answer equal 4164
end

test "exclude a sum equal to the limit"
  use "125_palindromicsums"
  Limit = 5
  run

  Answer equal 0
end

test "include the first sum of two squares"
  use "125_palindromicsums"
  Limit = 6
  run

  Answer equal 5
end
