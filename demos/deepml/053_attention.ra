rem Deep-ML 53: Self Attention
rem https://www.deep-ml.com/problems/53

use linalg
use numbers
use sequences

fun X Wq Wk Wv compute_qkv
  return record
    .q = X Wq matmul
    .k = X Wk matmul
    .v = X Wv matmul
  end
end

fun Q K V self_attention
  Width = Q len axis 1
  Kt' = K transpose
  Scores = (Q Kt matmul) / (Width sqrt)

  Tops = Scores max axis 1
  Shift' = Scores - Tops rank 1 0
  Exps = Shift exp
  Totals = Exps sum axis 1
  Weights' = Exps / Totals rank 1 0

  return Weights V matmul
end
