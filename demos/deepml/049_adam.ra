rem Deep-ML 49: Adam Optimizer
rem https://www.deep-ml.com/problems/49

use numbers
use ranges

rem Run ten standard Adam steps.
fun adam_optimizer Input
  X = Input .parameters
  Gradient = Input .gradient
  Rate = 0.001
  Beta1 = 0.9
  Beta2 = 0.999
  Epsilon = 0.00000001
  M = X * 0.0
  V = X * 0.0

  for T in 1 to 10
    G = X Gradient
    M = Beta1 * M + (1 - Beta1) * G
    V = Beta2 * V + (1 - Beta2) * G ** 2
    Mhat = M / (1 - Beta1 ** T)
    Vhat = V / (1 - Beta2 ** T)
    Denom = Vhat sqrt + Epsilon
    X -= Rate * Mhat / Denom
  end

  return X
end
