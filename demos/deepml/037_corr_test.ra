use testing

test "official perfect correlation"
  use "037_corr"
  X = array shape 3 2
    1 2
    3 4
    5 6
  end
  Expected = array shape 2 2 fill 1.0

  Actual = X correlation_matrix
  Actual Expected equal rank 2
end

test "official three features"
  use "037_corr"
  use numbers
  X = array shape 3 3
    1 2 3
    7 15 6
    7 8 9
  end
  Expected = array shape 3 3
    1.0 0.84298868 0.8660254
    0.84298868 1.0 0.46108397
    0.8660254 0.46108397 1.0
  end

  Actual = X correlation_matrix
  Match = Actual round 8 equal Expected
  Match and reduce with true
end

test "official cross correlation"
  use "037_corr"
  X = array shape 2 2
    1 0
    0 1
  end
  Y = array shape 2 2
    1 2
    3 4
  end
  Expected = array shape 2 2
    -1.0 -1.0
    1.0 1.0
  end

  Actual = X Y calculate_correlation
  Actual Expected equal rank 2
end

test "sample counts must match"
  use "037_corr"
  X = array shape 2 1 fill 1
  Y = array shape 3 1 fill 1
  Raised = false

  try
    Result = X Y calculate_correlation
  catch .DimensionMismatch Error
    Raised = true
  end

  Raised
end
