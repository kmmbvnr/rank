use testing

test "official weather example"
  use "020_tree"
  use json
  Data = "[
    {\"Outlook\":\"Sunny\",
     \"Wind\":\"Weak\",
     \"PlayTennis\":\"No\"},
    {\"Outlook\":\"Overcast\",
     \"Wind\":\"Strong\",
     \"PlayTennis\":\"Yes\"},
    {\"Outlook\":\"Rain\",
     \"Wind\":\"Weak\",
     \"PlayTennis\":\"Yes\"},
    {\"Outlook\":\"Sunny\",
     \"Wind\":\"Strong\",
     \"PlayTennis\":\"No\"},
    {\"Outlook\":\"Overcast\",
     \"Wind\":\"Weak\",
     \"PlayTennis\":\"Yes\"},
    {\"Outlook\":\"Rain\",
     \"Wind\":\"Strong\",
     \"PlayTennis\":\"No\"},
    {\"Outlook\":\"Rain\",
     \"Wind\":\"Weak\",
     \"PlayTennis\":\"Yes\"}
  ]" json
  Attrs = array "Outlook" "Wind"
  Target = "PlayTennis"
  Tree = Data Attrs Target learn_tree

  Outlook = Tree .branches
  Rain = Outlook "Rain"
  Wind = Rain .branches
  A = (Outlook "Overcast") .value equal "Yes"
  B = (Outlook "Sunny") .value equal "No"
  C = (Wind "Strong") .value equal "No"
  D = (Wind "Weak") .value equal "Yes"
  E = Tree .attribute equal "Outlook"
  F = Rain .attribute equal "Wind"
  G = Tree .value equal "Yes"
  H = Rain .value equal "Yes"
  A and B and C and D and E and F and G and H
end

test "pure data returns its class"
  use "020_tree"
  use json
  Data = "[
    {\"Color\":\"Red\",\"Class\":\"A\"},
    {\"Color\":\"Blue\",\"Class\":\"A\"}
  ]" json

  Attrs = array "Color"
  Result = Data Attrs "Class" learn_tree
  A = Result .leaf and (Result .value equal "A")
  B = Result .attribute equal ""
  Branches = Result .branches
  C = not "Red" in Branches
  A and B and C
end

test "majority ties are alphabetic"
  use "020_tree"
  use json
  Data = "[
    {\"Class\":\"B\"},
    {\"Class\":\"A\"}
  ]" json

  Attrs = array shape 0 fill 0
  Result = Data Attrs "Class" learn_tree
  A = Result .leaf and (Result .value equal "A")
  B = Result .attribute equal ""
  Branches = Result .branches
  C = not "Class" in Branches
  A and B and C
end

test "attribute ties keep input order"
  use "020_tree"
  use json
  Data = "[
    {\"First\":\"x\",\"Second\":\"m\",
     \"Class\":\"No\"},
    {\"First\":\"y\",\"Second\":\"n\",
     \"Class\":\"Yes\"}
  ]" json
  Attrs = array "First" "Second"
  Tree = Data Attrs "Class" learn_tree
  First = Tree .branches

  A = (First "x") .value equal "No"
  B = (First "y") .value equal "Yes"
  C = Tree .attribute equal "First"
  A and B and C
end
