rem Deep-ML 11: Jacobi Method
rem https://www.deep-ml.com/problems/11

use numbers
use ranges
use sequences

rem Approximate A X = B with N simultaneous Jacobi updates.
fun jacobi A B N
  Rows = A len axis 0
  Columns = A len axis 1
  Size = B len
  if Rows not equal Columns or Rows not equal Size
    .DimensionMismatch raise
  end

  X = array shape Size pad 0.0

  for Step in 0 until N
    Next = array shape Size pad 0.0

    for i in 0 until Size
      RowSum = (A i * X) sum
      Diagonal = A i i
      Next i = (
        B i - RowSum
        + Diagonal * X i
      ) / Diagonal
    end

    X = Next round 4
  end

  return X
end
