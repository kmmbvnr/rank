rem Deep-ML 11: Jacobi Method
rem https://www.deep-ml.com/problems/11

use numbers
use sequences

rem Approximate A X = B with N simultaneous Jacobi updates.
fun A B N jacobi
  unpack Rows Cols = A shape
  Size = B len
  if Rows not equal Cols or Rows not equal Size
    .DimensionMismatch raise
  end

  X = array shape Size fill 0.0

  fun X step
    Next = array shape Size fill 0.0

    for i in 0 till Size
      RowSum = A i * X sum
      Diagonal = A i i
      Residual = B i - RowSum + Diagonal * X i
      Next i = Residual / Diagonal
    end

    return Next round 4
  end

  return X step repeat N
end
