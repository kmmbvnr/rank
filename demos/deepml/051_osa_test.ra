use testing

test "official butterfly to dragonfly"
  use "051_osa"
  "butterfly" osa "dragonfly" equal 6
end

test "official caper to acer"
  use "051_osa"
  "caper" osa "acer" equal 2
end

test "official telescope to microscope"
  use "051_osa"
  "telescope" osa "microscope" equal 5
end

test "official london to paris"
  use "051_osa"
  "london" osa "paris" equal 6
end

test "adjacent transposition costs one"
  use "051_osa"
  "ab" osa "ba" equal 1
end

test "empty source needs insertions"
  use "051_osa"
  "" osa "rank" equal 4
end
