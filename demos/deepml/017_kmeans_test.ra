use testing

test "official example"
  use "017_kmeans"
  Points = array shape 6 2
    1 2
    1 4
    1 0
    10 2
    10 4
    10 0
  end
  Centroids = array shape 2 2
    1 1
    10 1
  end
  Expected = array shape 2 2
    1 2
    10 2
  end

  Result = Points 2 Centroids 10 k_means
  Result equal Expected
end

test "reassigns points after first update"
  use "017_kmeans"
  Points = array shape 4 1
    0
    2
    3
    10
  end
  Centroids = array shape 2 1
    0
    3
  end
  Expected = array shape 2 1
    1.6667
    10
  end

  Result = Points 2 Centroids 10 k_means
  Result equal Expected
end

test "empty clusters retain their centroid"
  use "017_kmeans"
  Points = array shape 2 1
    0
    10
  end
  Centroids = array shape 3 1
    0
    10
    100
  end

  Result = Points 3 Centroids 10 k_means
  Result equal Centroids
end
