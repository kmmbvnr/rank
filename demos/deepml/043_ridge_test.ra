use testing

test "official two coefficients"
  use "043_ridge"
  X = array shape 4 2
    1 1
    2 1
    3 1
    4 1
  end
  W = array 0.2 2.0
  Truth = array 2 3 4 5

  X W Truth 0.1 ridge_loss equal 2.204
end

test "official three coefficients"
  use "043_ridge"
  X = array shape 5 3
    1.0 1.0 4.0
    2.0 1.0 2.0
    3.0 1.0 0.1
    4.0 1.0 1.2
    1.0 2.0 3.0
  end
  W = array 0.2 2.0 5.0
  Truth = array 2 3 4 5 2

  X W Truth 0.1 ridge_loss equal 164.402
end

test "zero regularization is MSE"
  use "043_ridge"
  X = array shape 2 1
    1
    2
  end
  W = array 2
  Truth = array 1 5

  X W Truth 0 ridge_loss equal 1
end
