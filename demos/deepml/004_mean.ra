rem Deep-ML 4: Matrix Mean
rem https://www.deep-ml.com/problems/4

use algo

fun A matrix_mean Mode
  Queue = new queue
  if Mode equal "row"
    for Row in A
      Queue push Row sum / (Row len)
    end
  else
    for Col in A axis 0
      Queue push Col sum / (Col len)
    end
  end

  return Queue
end
