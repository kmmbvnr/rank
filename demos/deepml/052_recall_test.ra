use testing

test "official three of four"
  use "052_recall"
  Truth = array 1 0 1 1 0 1
  Predicted = array 1 0 1 0 0 1
  Truth Predicted recall equal 0.75
end

test "official one of three"
  use "052_recall"
  Truth = array 1 0 1 1 0 0
  Predicted = array 1 0 0 0 0 1
  Truth Predicted recall equal 0.333
end

test "official perfect recall"
  use "052_recall"
  Truth = array 1 0 1 1 0 0
  Predicted = array 1 0 1 1 0 0
  Truth Predicted recall equal 1.0
end

test "official half recall"
  use "052_recall"
  Truth = array 1 0 1 1 0 1
  Predicted = array 0 0 0 1 0 1
  Truth Predicted recall equal 0.5
end

test "official zero recall"
  use "052_recall"
  Truth = array 1 0 1 1 0 1
  Predicted = array 0 1 0 0 1 0
  Truth Predicted recall equal 0.0
end

test "no actual positives returns zero"
  use "052_recall"
  Truth = array 0 0
  Predicted = array 1 0
  Truth Predicted recall equal 0.0
end

test "lengths must match"
  use "052_recall"
  Truth = array 1 0
  Predicted = array 1
  try
    Truth Predicted recall
    false
  catch .DimensionMismatch Error
    true
  end
end
