use testing

test "official perfect line"
  use "014_linreg"
  X = array shape 3 2
    1 1
    1 2
    1 3
  end
  Y = array 1 2 3

  X Y linear_regression equal array 0.0 1.0
end

test "fits an intercept and slope"
  use "014_linreg"
  X = array shape 4 2
    1 0
    1 1
    1 2
    1 3
  end
  Y = array 1 3 5 7

  X Y linear_regression equal array 1.0 2.0
end

test "dependent features are singular"
  use "014_linreg"
  X = array shape 3 2
    1 1
    1 1
    1 1
  end
  Y = array 1 2 3
  Raised = false

  try
    Theta = X Y linear_regression
  catch .SingularMatrix Error
    Raised = true
  end

  Raised
end

test "target length must match observations"
  use "014_linreg"
  X = array shape 3 2 pad 1
  Y = array 1 2
  Raised = false

  try
    Theta = X Y linear_regression
  catch .DimensionMismatch Error
    Raised = true
  end

  Raised
end
