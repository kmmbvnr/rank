use testing

test "official example"
  use "015_gd"
  X = array shape 3 2
    1 1
    1 2
    1 3
  end
  Y = array 1 2 3

  Result = X Y 0.01 1000 linear_regression
  Result equal array 0.1107 0.9513
end

test "zero steps preserve zero coefficients"
  use "015_gd"
  X = array shape 2 3 pad 1
  Y = array 2 2
  Expected = array 0.0 0.0 0.0

  Result = X Y 0.1 0 linear_regression
  Result equal Expected
end

test "one update follows the gradient"
  use "015_gd"
  X = array shape 2 2
    1 1
    1 2
  end
  Y = array 1 2
  Expected = array 0.15 0.25

  Result = X Y 0.1 1 linear_regression
  Result equal Expected
end

test "target length must match observations"
  use "015_gd"
  X = array shape 3 2 pad 1
  Y = array 1 2
  Raised = false

  try
    Result = X Y 0.1 1 linear_regression
  catch .DimensionMismatch Error
    Raised = true
  end

  Raised
end
