rem Deep-ML 7: Matrix Transformation
rem https://www.deep-ml.com/problems/7

use numbers
use ranges
use sequences
use linalg

rem Transform A by T inverse times A times S.
fun transform_matrix A T S
  ARows = A len axis 0
  ACols = A len axis 1
  TRows = T len axis 0
  TCols = T len axis 1
  SRows = S len axis 0
  SCols = S len axis 1

  if TRows not equal TCols or SRows not equal SCols
    .DimensionMismatch raise
  end
  if TRows not equal ARows or SRows not equal ACols
    .DimensionMismatch raise
  end
  if T determinant equal 0 or S determinant equal 0
    .SingularMatrix raise
  end

  Inverse = T inverse
  Left = Inverse A matrix_multiply
  return Left S matrix_multiply
end

rem Multiply two rank-2 matrices.
fun matrix_multiply A B
  Rows = A len axis 0
  Inner = A len axis 1
  BRows = B len axis 0
  Cols = B len axis 1

  if Inner not equal BRows
    .DimensionMismatch raise
  end

  Result = array shape Rows Cols pad 0.0
  for i in 0 until Rows
    for j in 0 until Cols
      Sum = 0.0
      for k in 0 until Inner
        Sum += A i k * B k j
      end
      Result i j = Sum
    end
  end
  return Result
end

rem Compute a determinant on a private copy by elimination.
fun determinant A
  Rows = A len axis 0
  Cols = A len axis 1
  if Rows not equal Cols
    .DimensionMismatch raise
  end

  Work = array shape Rows Cols pad 0.0
  for i in 0 until Rows
    for j in 0 until Cols
      Work i j = A i j
    end
  end

  Result = 1.0
  for i in 0 until Rows
    Pivot = i
    for Row in i + 1 until Rows
      if Work Row i abs greater Work Pivot i abs
        Pivot = Row
      end
    end
    if Work Pivot i equal 0
      return 0.0
    end

    if Pivot not equal i
      for j in 0 until Cols
        Temp = Work i j * 1.0
        Work i j = Work Pivot j
        Work Pivot j = Temp
      end
      Result = -Result
    end

    Result *= Work i i
    for Row in i + 1 until Rows
      Factor = Work Row i / Work i i
      for j in i until Cols
        Work Row j = Work Row j - Factor * Work i j
      end
    end
  end
  return Result
end
