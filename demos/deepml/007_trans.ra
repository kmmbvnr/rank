rem Deep-ML 7: Matrix Transformation
rem https://www.deep-ml.com/problems/7

use numbers
use sequences
use linalg

rem Transform A by T inverse times A times S.
fun transform_matrix A T S
  unpack ARows ACols = A shape
  unpack TRows TCols = T shape
  unpack SRows SCols = S shape

  if TRows not equal TCols or SRows not equal SCols
    .DimensionMismatch raise
  end
  if TRows not equal ARows or SRows not equal ACols
    .DimensionMismatch raise
  end
  if T determinant equal 0 or S determinant equal 0
    .SingularMatrix raise
  end

  Inverse = T inverse
  Left = Inverse A matmul
  return Left S matmul
end

rem Compute a determinant on a private copy by elimination.
fun determinant A
  unpack Rows Cols = A shape
  if Rows not equal Cols
    .DimensionMismatch raise
  end

  Work = A * 1.0 copy

  Result = 1.0
  for i in 0 until Rows
    Pivot = i
    for Row in i + 1 until Rows
      if Work Row i abs greater Work Pivot i abs
        Pivot = Row
      end
    end
    if Work Pivot i equal 0
      return 0.0
    end

    if Pivot not equal i
      for j in 0 until Cols
        Temp = Work i j * 1.0
        Work i j = Work Pivot j
        Work Pivot j = Temp
      end
      Result = -Result
    end

    Result *= Work i i
    for Row in i + 1 until Rows
      Factor = Work Row i / Work i i
      for j in i until Cols
        Work Row j = Work Row j - Factor * Work i j
      end
    end
  end
  return Result
end
