rem Deep-ML 47: Descent Variants
rem https://www.deep-ml.com/problems/47

use linalg
use sequences

fun X Y W Rate Iter Size Mode descent
  N = Y len
  if X len not equal N
    .DimensionMismatch raise
  end
  if Iter less 0
    .DomainError raise
  end
  if Mode equal .mini_batch
    if Size at most 0
      .DomainError raise
    end
  end

  for # in 0 till Iter
    if Mode equal .batch
      Error = X matmul W - Y
      Gradient' = X matmul Error axis 0 0
      Gradient' = Gradient * 2 / N
      W -= Rate * Gradient
      continue
    end

    if Mode equal .stochastic
      for Row i in X
        Error = Row matmul W - Y i
        Gradient' = Row * Error * 2
        W -= Rate * Gradient
      end
      continue
    end

    if Mode equal .mini_batch
      for I in 0 till N by Size
        J = I + Size min N
        Xb = X (I till J)
        Yb' = Y (I till J)
        Error = Xb matmul W - Yb
        Gradient' = Xb matmul Error axis 0 0
        Gradient' = Gradient * 2 / Size
        W -= Rate * Gradient
      end
      continue
    end

    .UnknownMethod raise Mode
  end

  return W
end
