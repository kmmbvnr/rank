rem Deep-ML 29: Shuffle Dataset
rem https://www.deep-ml.com/problems/29

use random

rem Shuffle matching samples
rem with one shared order.
fun shuffle_data X Y
  Count = X len
  if Y len not equal Count
    .DimensionMismatch raise
  end

  Indices = 0 until Count
  Order = Indices shuffle

  ShuffledX = X Order
  ShuffledY = Y Order
  return array ShuffledX ShuffledY
end
