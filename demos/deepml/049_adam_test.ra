use testing

test "official equal parameters"
  use "049_adam"
  use numbers

  fun X gradient
    return X * 2
  end

  X = array 1.0 1.0
  Actual = X adam_optimizer gradient
  Expected = array 0.99000325 0.99000325
  Rounded = Actual round 8
  Rounded Expected equal rank 1
end

test "official unequal parameters"
  use "049_adam"
  use numbers

  fun X gradient
    return X * 2
  end

  X = array 0.2 12.3
  Actual = X adam_optimizer gradient
  Expected = array shape 2
    0.19001678 12.29000026
  end
  Rounded = Actual round 8
  Rounded Expected equal rank 1
end

test "zero gradient keeps parameters"
  use "049_adam"

  fun X zero_gradient
    return X * 0.0
  end

  X = array -2.0 4.0
  Actual = X adam_optimizer zero_gradient
  Actual X equal rank 1
end
