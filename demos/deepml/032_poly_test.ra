use testing

test "official degree two"
  use "032_poly"

  X = array shape 3 2
    2 3
    3 4
    5 6
  end
  A = X 2 polynomial_features
  E = array shape 3 6
    1 2 3 4 6 9
    1 3 4 9 12 16
    1 5 6 25 30 36
  end
  A equal E
end

test "official degree three"
  use "032_poly"

  X = array shape 3 2
    1 2
    3 4
    5 6
  end
  A = X 3 polynomial_features
  E = array shape 3 10
    1 1 1 1 2 2 2 4 4 8
    1 3 4 9 12 16 27 36 48 64
    1 5 6 25 30 36 125 150 180 216
  end
  A equal E
end

test "official three features"
  use "032_poly"

  X = array shape 3 3
    1 2 3
    3 4 5
    5 6 9
  end
  A = X 3 polynomial_features
  E = array shape 3 20
    1 1 1 1 2 2 2 3 3 3
    4 4 6 6 8 9 9 12 18 27
    1 3 4 5 9 12 15 16 20 25
    27 36 45 48 60 64 75 80 100 125
    1 5 6 9 25 30 36 45 54 81
    125 150 180 216 225 270 324
    405 486 729
  end
  A equal E
end

test "degree zero is the constant term"
  use "032_poly"

  X = array shape 2 2
    4 5
    6 7
  end
  A = X 0 polynomial_features
  E = array shape 2 1
    1.0
    1.0
  end
  A equal E
end

test "degree must be nonnegative"
  use "032_poly"

  X = array shape 1 1 pad 2
  try
    X (-1) polynomial_features
    false
  catch .DomainError Error
    true
  end
end
