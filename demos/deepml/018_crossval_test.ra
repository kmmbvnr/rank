use testing

test "official example"
  use "018_crossval"
  use ranges
  Result = 10 5 false cross_validation

  Pair = Result 0
  Train = (2 until 10) array
  Match = Pair 0 equal Train
  Ok = Match and reduce
  Expected = array 0 1
  Match = Pair 1 equal Expected
  Reduced = Match and reduce
  Ok and= Reduced

  Pair = Result 4
  Train = (0 until 8) array
  Match = Pair 0 equal Train
  Reduced = Match and reduce
  Ok and= Reduced
  Expected = array 8 9
  Match = Pair 1 equal Expected
  Reduced = Match and reduce
  Ok and= Reduced
  Ok
end

test "uneven folds put extras first"
  use "018_crossval"
  use ranges
  use sequences
  Result = 10 3 false cross_validation

  First = Result 0
  Second = Result 1
  Third = Result 2

  Ok = First 1 len equal 4
  Ok and= Second 1 len equal 3
  Ok and= Third 1 len equal 3
  Expected = (0 until 4) array
  Match = First 1 equal Expected
  Reduced = Match and reduce
  Ok and= Reduced
  Expected = (4 until 7) array
  Match = Second 1 equal Expected
  Reduced = Match and reduce
  Ok and= Reduced
  Expected = (7 until 10) array
  Match = Third 1 equal Expected
  Reduced = Match and reduce
  Ok and= Reduced
  Ok
end

test "shuffle visits every sample"
  use "018_crossval"
  Seen = array shape 11 pad false
  Result = 11 4 true cross_validation

  for Pair in Result
    Test = Pair 1
    for Sample in Test
      Seen Sample = true
    end
  end

  Seen and reduce
end

test "invalid fold counts are rejected"
  use "018_crossval"
  Raised = false

  try
    Result = 4 1 false cross_validation
  catch .DomainError Error
    Raised = true
  end

  Raised
end
