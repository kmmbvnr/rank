rem Deep-ML 34: One-Hot Encoding
rem https://www.deep-ml.com/problems/34

use sequences

rem Encode labels with a chosen width.
fun X to_categorical Columns
  if Columns less 0
    .DomainError raise
  end

  Rows = X len
  Out = array shape Rows Columns fill 0

  for Label in X
    if Label less 0
      .DomainError raise
    end
    if Label at least Columns
      .DomainError raise
    end
  end

  RowIndices = (0 till Rows) array
  Out RowIndices X rank 0 0 = 1

  return Out
end

rem Infer width from the largest label.
fun X categorical
  if X len equal 0
    .EmptyInput raise
  end

  Columns = X max + 1
  return X to_categorical Columns
end
