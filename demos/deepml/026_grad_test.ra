use testing

test "official arithmetic graph"
  use "026_grad"
  use algo
  Tape = new queue
  A = Tape value 2
  B = Tape value 3
  C = Tape value 10
  BC = Tape B C mul
  D = Tape A BC addnode
  E = Tape 7 2 mul
  F = Tape E D addnode
  G = Tape relu F

  Tape backward G

  Actual = array shape 7
    (A .grad) (B .grad) (C .grad)
    (D .grad) (E .grad) (F .grad)
    (G .grad)
  end
  Expected = array shape 7
    1.0 10.0 3.0 1.0 1.0 1.0 1.0
  end
  Actual equal Expected
end

test "official shared subgraph"
  use "026_grad"
  use algo
  Tape = new queue
  A = Tape value 2
  B = Tape value 3
  M = Tape A B mul
  Y = Tape M A addnode
  Z = Tape M B addnode
  W = Tape Y Z addnode

  Tape backward W

  Actual = array shape 6
    (A .grad) (B .grad) (M .grad)
    (Y .grad) (Z .grad) (W .grad)
  end
  Expected = array shape 6
    7.0 5.0 2.0 1.0 1.0 1.0
  end
  Actual equal Expected
end

test "negative relu blocks its gradient"
  use "026_grad"
  use algo
  Tape = new queue
  A = Tape value (-2.5)
  Out = Tape relu A

  Tape backward Out

  Out .data equal 0.0
  A .grad equal 0.0
end
