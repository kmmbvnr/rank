rem Deep-ML 51: String Alignment
rem https://www.deep-ml.com/problems/51

use numbers
use ranges
use sequences

fun osa Source Target
  M = Source len
  N = Target len
  D = array shape (M + 1) (N + 1) pad 0

  for I in 0 to M
    D I 0 = I
  end
  for J in 0 to N
    D 0 J = J
  end

  for I in 1 to M
    for J in 1 to N
      Cost = 0
      A = Source (I - 1)
      B = Target (J - 1)
      if A not equal B
        Cost = 1
      end

      Delete = D (I - 1) J + 1
      Insert = D I (J - 1) + 1
      Change = D (I - 1) (J - 1)
      Change += Cost
      Best = Delete min Insert
      Best = Best min Change

      if I greater 1 and J greater 1
        C = Target (J - 2)
        Dprev = Source (I - 2)
        CrossA = A equal C
        CrossB = Dprev equal B
        if CrossA and CrossB
          Swap = D (I - 2) (J - 2) + 1
          Best = Best min Swap
        end
      end

      D I J = Best
    end
  end

  return D M N
end
