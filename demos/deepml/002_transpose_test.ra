use testing

test "official example"
  use "002_transpose"
  A = array shape 2 3
    1 2 3
    4 5 6
  end
  Expected = array shape 3 2
    1 4
    2 5
    3 6
  end

  A transpose_matrix equal Expected
end

test "square matrix"
  use "002_transpose"
  A = array shape 2 2
    1 -2
    3 4
  end
  Expected = array shape 2 2
    1 3
    -2 4
  end

  A transpose_matrix equal Expected
end

test "empty leading axis"
  use "002_transpose"
  A = array shape 0 3 pad 0
  Expected = array shape 3 0 pad 0

  A transpose_matrix equal Expected
end
