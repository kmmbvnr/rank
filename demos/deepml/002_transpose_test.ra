use testing

test "official example"
  use "002_transpose"
  A = array shape 2 3
    1 2 3
    4 5 6
  end
  Expected = array shape 3 2
    1 4
    2 5
    3 6
  end

  A transpose_matrix equal Expected
end

test "square matrix"
  use "002_transpose"
  A = array shape 2 2
    1 -2
    3 4
  end
  Expected = array shape 2 2
    1 3
    -2 4
  end

  A transpose_matrix equal Expected
end

test "empty leading axis"
  use "002_transpose"
  A = array shape 0 3 fill 0
  Expected = array shape 3 0 fill 0

  A transpose_matrix equal Expected
end

test "empty trailing axis retains the other dimension"
  use "002_transpose"
  use sequences
  A = array shape 3 0 fill 0
  Result = A transpose_matrix
  (Result shape) equal array 0 3
end

test "one row becomes one column"
  use "002_transpose"
  A = array shape 1 3
    1 2 3
  end
  Expected = array shape 3 1
    1
    2
    3
  end
  A transpose_matrix equal Expected
end

test "one column becomes one row"
  use "002_transpose"
  A = array shape 3 1
    1
    2
    3
  end
  Expected = array shape 1 3
    1 2 3
  end
  A transpose_matrix equal Expected
end
