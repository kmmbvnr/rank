rem Deep-ML 14: Linear Regression
rem https://www.deep-ml.com/problems/14

use linalg
use numbers
use sequences

rem Fit coefficients with the normal equation without forming an inverse.
fun X linear_regression Y
  Xt' = X transpose
  A = Xt matmul X
  B = Xt matmul Y

  Theta = A solve B

  return Theta round 4
end
