rem Deep-ML 50: Lasso Regression
rem https://www.deep-ml.com/problems/50

use linalg
use numbers
use sequences
use stats

fun X Y L1 Lr N Eps lasso
  unpack Rows Cols = X shape
  if Y len not equal Rows
    .DimensionMismatch raise
  end

  W = array shape Cols fill 0.0
  Bias = 0.0

  for # in 0 till N
    Error = X matmul W + Bias - Y
    Grad = X matmul Error axis 0 0
    Grad /= Rows

    Pos = (W greater 0) 1.0 0.0 choose
    Neg = (W less 0) 1.0 0.0 choose
    Penalty = L1 * (Pos - Neg)
    Grad += Penalty

    W -= Lr * Grad
    ErrorMean = Error mean
    Bias -= Lr * ErrorMean

    if Grad abs sum less Eps
      break
    end
  end

  return record
    .weights = W
    .bias = Bias
  end
end
