rem Deep-ML 30: Batch Iterator
rem https://www.deep-ml.com/problems/30


rem Lazily split X along its first axis.
fun X batch_iterator Size
  if Size at most 0
    .InvalidBatchSize raise
  end

  N = X len

  for First in 0 till N by Size
    Last = First + Size
    Last = Last min N

    yield X (First till Last)
  end
end

rem Lazily split matching X and Y.
fun X Y Size batch_pairs
  if Size at most 0
    .InvalidBatchSize raise
  end

  N = X len
  if Y len not equal N
    .DimensionMismatch raise
  end

  for First in 0 till N by Size
    Last = First + Size
    Last = Last min N

    Batch = record
      .x = X (First till Last)
      .y = Y (First till Last)
    end

    yield Batch
  end
end
