use testing

test "official column example"
  use "004_mean"
  A = array shape 3 3
    1 2 3
    4 5 6
    7 8 9
  end

  A matrix_mean "column" equal array 4.0 5.0 6.0
end

test "rectangular row means"
  use "004_mean"
  A = array shape 2 3
    1 2 6
    -3 0 3
  end

  A matrix_mean "row" equal array 3.0 0.0
end

test "single row column means"
  use "004_mean"
  A = array shape 1 3
    -1 0 2
  end

  A matrix_mean "column" equal array -1.0 0.0 2.0
end
