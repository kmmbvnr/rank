rem Deep-ML 18: K-Fold Cross-Validation
rem https://www.deep-ml.com/problems/18

use algo
use random

rem Build train and test indices
rem for every fold.
fun cross_validation N K Shuffle
  Queue = new queue
  if N less 0
    .DomainError raise
  end
  if K less 2
    .DomainError raise
  end
  if K greater N
    .DomainError raise
  end

  Order = 0 till N array
  if Shuffle
    Order = Order shuffle
  end

  Base = N // K
  Extra = N mod K
  Positions = 0 till N array

  for Fold in 0 till K
    First = Fold * Base
    First += Fold Extra min

    Size = Base
    if Fold less Extra
      Size += 1
    end
    Last = First + Size

    Test = Order (First till Last)

    TrainMask = Positions less First
    After = Positions at least Last
    TrainMask or= After
    Train = (Order TrainMask) array

    Queue push array Train Test
  end

  return Queue
end
