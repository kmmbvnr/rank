Norm1 = X layernorm * G1 + B1
P = (Norm1 W linear) + QkvBias
Q = (P # # (0 till 6)) reshape 1 3 2 3
K = (P # # (6 till 12)) reshape 1 3 2 3
V = (P # # (12 till 18)) reshape 1 3 2 3
Q = Q transpose axis 0 2 1 3
K = K transpose axis 0 2 3 1
V = V transpose axis 0 2 1 3
Scores = Q matmul K rank 2 2 * Scale
Masked = Scores + Mask
Probabilities = Masked softmax
Context = Probabilities matmul V rank 2 2
Merged = Context transpose axis 0 2 1 3
Merged = Merged reshape 1 3 6
Attention = (Merged O linear) + OutBias
Residual1 = X + Attention
Norm2 = Residual1 layernorm * G2 + B2
Up = (Norm2 UpW linear) + UpB
Activated = Up gelu_new
Mlp = (Activated DownW linear) + DownB
Output = Residual1 + Mlp
return Output
