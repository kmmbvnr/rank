use ml
arg X .f32 shape 1 768
arg G2 .f32 shape 768
arg B2 .f32 shape 768
arg UpW .f32 shape 768 3072
arg UpB .f32 shape 3072
arg DownW .f32 shape 3072 768
arg DownB .f32 shape 768
gpu X normalized Gain Bias
return X layernorm * Gain + Bias
end
gpu X affine Weight Bias
return (X matmul Weight) + Bias
end
gpu X feedforward
Norm2 = X normalized G2 B2
Up = Norm2 affine UpW UpB
Activated = Up gelu_new
Mlp = Activated affine DownW DownB
return X + Mlp
end
return X feedforward
