use testing

test "official example"
  use "009_routes2"
  use graph
  use numbers
  Graph = new graph (1 to 4) .undirected
  Edges = array shape 3 3
    1 2 5
    1 3 9
    2 3 3
  end
  Graph add Edges
  Dist = Graph all_pairs 4
  Dist 1 2 equal 5
  Dist 2 1 equal 5
  Dist 1 3 equal 8
  Dist 1 4 equal infinity
  Dist 3 2 equal 3
end

test "chooses a parallel road"
  use "009_routes2"
  use graph
  Graph = new graph (1 to 3) .undirected
  Edges = array shape 3 3
    1 2 10
    1 2 4
    2 3 7
  end
  Graph add Edges
  Dist = Graph all_pairs 3
  Dist 1 3 equal 11
end

test "zero distance to each city"
  use "009_routes2"
  use graph
  Graph = new graph (1 to 3) .undirected
  Dist = Graph all_pairs 3
  Diagonal = array shape 3
    (Dist 1 1) (Dist 2 2) (Dist 3 3)
  end
  Diagonal equal array 0 0 0
end

test "finds a route through two cities"
  use "009_routes2"
  use graph
  Graph = new graph (1 to 4) .undirected
  Edges = array shape 3 3
    1 2 3
    2 3 4
    3 4 5
  end
  Graph add Edges
  Dist = Graph all_pairs 4
  Dist 1 4 equal 12
end

test "keeps large integer sums exact beside unreachable cells"
  use "009_routes2"
  use graph
  Graph = new graph (1 to 3) .undirected
  Price = 9007199254740993
  Graph add 1 2 Price
  Graph add 2 3 Price
  Dist = Graph all_pairs 3
  Dist 1 2 equal Price
  Dist 1 3 equal 18014398509481986
end

test "rebuilds after graph changes without changing the retained matrix"
  use "009_routes2"
  use graph
  Graph = new graph (1 to 3) .undirected
  Graph add 1 2 5
  Graph add 2 3 5
  First = Graph all_pairs 3
  Graph add 1 3 1
  Second = Graph all_pairs 3
  First 1 3 equal 10
  Second 1 3 equal 1
end
