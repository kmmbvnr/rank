use testing

test "official example"
  use "011_discount"
  Edges = array shape 4 3
    1 2 3
    2 3 1
    1 3 7
    2 1 5
  end
  Edges flight_discount 3 equal 2
end

test "discounts an expensive edge"
  use "011_discount"
  Edges = array shape 3 3
    1 2 2
    2 3 100
    1 3 60
  end
  Edges flight_discount 3 equal 30
end

test "uses one coupon on a longer path"
  use "011_discount"
  Edges = array shape 4 3
    1 2 9
    2 4 9
    1 3 5
    3 4 20
  end
  Edges flight_discount 4 equal 13
end

test "keeps large integer prices exact"
  use "011_discount"
  Edges = array shape 2 3
    1 2 9007199254740993
    2 3 9007199254740993
  end
  Expected = 13510798882111489
  Edges flight_discount 3 equal Expected
end
