rem CSES 1666: Building Roads
rem https://cses.fi/problemset/task/1666

use algo
use io
use sequences

Cities = stdin .integer
RoadCount = stdin .integer
Count = RoadCount * 2
Roads = stdin .integer Count array
Components = Cities Roads components

RoadsNeeded = Components len - 1
RoadsNeeded print
for Pair in Components window 2
  Pair print
end


rem Return one city from each component.
fun components Cities Roads
  Parent = 0 to Cities array
  Sizes = array shape (Cities + 1) fill 1

  fun findroot City
    for Parent City not equal City
      Next = Parent City
      Parent City = Parent Next
      City = Next
    end
    return City
  end

  fun unite A B
    A = A findroot
    B = B findroot
    if A equal B
      return false
    end

    if Sizes A less Sizes B
      Temp = A
      A = B
      B = Temp
    end

    Parent B = A
    Sizes A += Sizes B
    return true
  end

  Total = Roads len
  for i in 0 till Total by 2
    A = Roads i
    B = Roads (i + 1)
    A B unite
  end

  Roots = new queue
  for City in 1 to Cities
    if City findroot equal City
      Roots push City
    end
  end

  Length = Roots len
  return Roots (0 till Length)
end
