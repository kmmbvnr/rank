rem CSES 1666: Building Roads
rem https://cses.fi/problemset/task/1666

use algo
use io
use ranges
use sequences

Cities = stdin .integer
RoadCount = stdin .integer
Count = RoadCount * 2
Roads = stdin .integer Count array
Components = Cities Roads components

Components len - 1 print
for i in 1 until Components len
  A = Components (i - 1)
  B = Components i
  Pair = array A B
  Pair print
end


rem Return one city from each component.
fun components Cities Roads
  Parent = (0 to Cities) array
  Sizes = array shape (Cities + 1) pad 1

  fun find City
    for Parent City not equal City
      Parent City = Parent (Parent City)
      City = Parent City
    end
    return City
  end

  fun unite A B
    A = A find
    B = B find
    if A equal B
      return false
    end

    if Sizes A less Sizes B
      Temp = A
      A = B
      B = Temp
    end

    Parent B = A
    Sizes A += Sizes B
    return true
  end

  for i in 0 until (Roads len // 2)
    A = Roads (2 * i)
    B = Roads (2 * i + 1)
    A B unite
  end

  for City in 1 to Cities
    if City find equal City
      queue push City
    end
  end

  Shape = array (queue len)
  return queue Shape reshape
end
