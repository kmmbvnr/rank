rem CSES 1666: Building Roads
rem https://cses.fi/problemset/task/1666

use algo
use graph
use io
use sequences

Cities = stdin .integer
RoadCount = stdin .integer
Count = RoadCount * 2
Roads = stdin .integer Count array
Components = Cities Roads road_components

RoadsNeeded = Components len - 1
RoadsNeeded print
for Pair in Components window 2
  Pair print
end


rem Return one city from each component.
fun Cities Roads road_components
  Union = new dsu (1 to Cities)

  Total = Roads len
  for i in 0 till Total by 2
    A = Roads i
    B = Roads (i + 1)
    Union A B merge
  end

  Roots = new queue
  for City in 1 to Cities
    if Union findroot City equal City
      Roots push City
    end
  end

  Length = Roots len
  return Roots (0 till Length)
end
