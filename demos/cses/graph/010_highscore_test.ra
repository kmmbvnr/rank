use testing

test "official example"
  use "010_highscore"
  Edges = array shape 5 3
    1 2 3
    2 4 -1
    1 3 -2
    3 4 7
    1 4 4
  end
  Result = Edges 4 high_score
  Result .infinite equal false
  Result .score equal 5
end

test "positive cycle reaches target"
  use "010_highscore"
  Edges = array shape 4 3
    1 2 1
    2 3 1
    3 2 1
    3 4 1
  end
  Result = Edges 4 high_score
  Result .infinite equal true
end

test "irrelevant cycle stays finite"
  use "010_highscore"
  Edges = array shape 5 3
    1 2 1
    2 3 1
    3 2 1
    1 4 7
    4 5 2
  end
  Result = Edges 5 high_score
  Result .infinite equal false
  Result .score equal 9
end

test "unreachable cycle stays finite"
  use "010_highscore"
  Edges = array shape 4 3
    1 4 5
    2 3 10
    3 2 10
    3 4 1
  end
  Result = Edges 4 high_score
  Result .infinite equal false
  Result .score equal 5
end
