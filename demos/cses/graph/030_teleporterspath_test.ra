use testing

test "official example"
  use "030_teleporterspath"
  use graph
  use sequences
  Graph = new graph (1 to 5) .directed
  Edges = array shape 6 2
    1 2
    1 3
    2 4
    2 5
    3 1
    4 2
  end
  Graph add Edges
  Path = Graph 5 6 teleporters_path
  Path equal (array 1 3 1 2 4 2 5)
end

test "accepts one direct teleporter"
  use "030_teleporterspath"
  use graph
  use sequences
  Graph = new graph (1 to 2) .directed
  Graph add 1 2
  Path = Graph 2 1 teleporters_path
  Path equal (array 1 2)
end

test "rejects the wrong endpoint"
  use "030_teleporterspath"
  use graph
  use sequences
  Graph = new graph (1 to 3) .directed
  Graph add 1 2
  Graph add 2 1
  Path = Graph 3 2 teleporters_path
  Path len equal 0
end

test "rejects disconnected edges"
  use "030_teleporterspath"
  use graph
  use sequences
  Graph = new graph (1 to 4) .directed
  Graph add 1 4
  Graph add 2 3
  Path = Graph 4 2 teleporters_path
  Path len equal 0
end
