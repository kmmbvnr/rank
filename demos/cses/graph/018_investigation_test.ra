use testing

test "official example"
  use "018_investigation"
  use graph
  use ranges
  Graph = new graph (1 to 4) .directed
  Edges = array shape 5 3
    1 4 5
    1 2 4
    2 4 5
    1 3 2
    3 4 3
  end
  Graph add Edges
  Result = Graph 4 investigate
  Result equal (array 5 2 1 2)
end

test "counts parallel cheapest routes"
  use "018_investigation"
  use graph
  use ranges
  Graph = new graph (1 to 2) .directed
  Graph add 1 2 4
  Graph add 1 2 4
  Result = Graph 2 investigate
  Result equal (array 4 2 1 1)
end

test "tracks flight count bounds"
  use "018_investigation"
  use graph
  use ranges
  Graph = new graph (1 to 4) .directed
  Edges = array shape 5 3
    1 4 6
    1 2 2
    2 4 4
    1 3 1
    3 2 1
  end
  Graph add Edges
  Result = Graph 4 investigate
  Result equal (array 6 3 1 3)
end

test "keeps exact large prices"
  use "018_investigation"
  use graph
  use ranges
  Graph = new graph (1 to 3) .directed
  Price = 9007199254740993
  Graph add 1 2 Price
  Graph add 2 3 Price
  Result = Graph 3 investigate
  Total = 18014398509481986
  Result equal (array Total 1 2 2)
end
