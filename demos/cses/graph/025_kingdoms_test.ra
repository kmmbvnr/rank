use testing

test "official example"
  use "025_kingdoms"
  use graph
  use ranges
  Graph = new graph (1 to 5) .directed
  Edges = array shape 6 2
    1 2
    2 3
    3 1
    3 4
    4 5
    5 4
  end
  Graph add Edges
  Result = Graph 5 kingdoms
  Result .count equal 2
  Result .labels equal (array 1 1 1 2 2)
end

test "separates an acyclic graph"
  use "025_kingdoms"
  use graph
  use ranges
  Graph = new graph (1 to 3) .directed
  Graph add 1 2
  Graph add 2 3
  Result = Graph 3 kingdoms
  Result .count equal 3
  Result .labels equal (array 1 2 3)
end

test "joins one directed cycle"
  use "025_kingdoms"
  use graph
  use ranges
  Graph = new graph (1 to 4) .directed
  Graph add 1 2
  Graph add 2 3
  Graph add 3 4
  Graph add 4 1
  Result = Graph 4 kingdoms
  Result .count equal 1
  Result .labels equal (array 1 1 1 1)
end

test "keeps isolated planets"
  use "025_kingdoms"
  use graph
  use ranges
  Graph = new graph (1 to 3) .directed
  Result = Graph 3 kingdoms
  Result .count equal 3
  Result .labels equal (array 3 2 1)
end
