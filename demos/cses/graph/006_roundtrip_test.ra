use testing

test "official example"
  use "006_roundtrip"
  use graph
  Graph = new graph (1 to 5) .undirected
  Edges = array shape 6 2
    1 3
    1 2
    5 3
    1 5
    2 4
    4 5
  end
  Graph add Edges
  Cycle = Graph 5 find_cycle
  Cycle equal array 1 5 3 1
end

test "tree has no cycle"
  use "006_roundtrip"
  use graph
  Graph = new graph (1 to 5) .undirected
  Edges = array shape 4 2
    1 2
    1 3
    3 4
    3 5
  end
  Graph add Edges
  Cycle = Graph 5 find_cycle
  Cycle equal array shape 0 fill 0
end

test "finds a triangle"
  use "006_roundtrip"
  use graph
  Graph = new graph (1 to 3) .undirected
  Edges = array shape 3 2
    1 2
    2 3
    3 1
  end
  Graph add Edges
  Cycle = Graph 3 find_cycle
  Cycle equal array 1 3 2 1
end

test "searches disconnected components"
  use "006_roundtrip"
  use graph
  Graph = new graph (1 to 6) .undirected
  Edges = array shape 5 2
    1 2
    3 4
    4 5
    5 6
    6 3
  end
  Graph add Edges
  Cycle = Graph 6 find_cycle
  Cycle equal array 3 6 5 4 3
end
