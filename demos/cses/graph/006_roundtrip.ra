rem CSES 1669: Round Trip
rem https://cses.fi/problemset/task/1669

use algo
use graph
use io
use sequences

NodeCount = stdin .integer
EdgeCount = stdin .integer
Nodes = 1 to NodeCount
Graph = new graph Nodes .undirected

for i in 1 to EdgeCount
  A = stdin .integer
  B = stdin .integer
  Graph add A B
end

Cycle = Graph NodeCount find_cycle
if Cycle len equal 0
  "IMPOSSIBLE" print
else
  Cycle len print
  Cycle print
end


rem Return one simple undirected cycle.
fun Graph NodeCount find_cycle
  Size = NodeCount + 1
  State = array shape Size fill 0
  Parent = array shape Size fill 0

  Position = array shape Size fill 0
  Pending = new stack

  for Start in 1 to NodeCount
    if State Start not equal 0
      continue
    end
    State Start = 1
    Pending push Start

    for Pending len greater 0
      Node = Pending peek
      Neighbors = Graph Node
      Index = Position Node
      if Index at least (Neighbors len)
        State Node = 2
        Pending pop
        continue
      end

      Next = Neighbors Index
      Position Node += 1
      if Next equal Parent Node
        continue
      end
      if State Next equal 0
        Parent Next = Node
        State Next = 1
        Pending push Next
      elif State Next equal 1
        Path = new queue
        Path push Next
        Current = Node
        for Current not equal Next
          Path push Current
          Current = Parent Current
        end
        Path push Next
        return Path array
      end
    end
  end
  return array shape 0 fill 0
end
