rem CSES 1690: Hamiltonian Flights
rem https://cses.fi/problemset/task/1690

use bits
use graph
use io
use sequences

N = stdin .integer
M = stdin .integer
Count = M * 2
Values = stdin .integer Count array
Edges = Values reshape M 2
N hamiltonian_flights Edges print


rem Count routes by visited-city masks.
fun N hamiltonian_flights Edges
  Modulus = 1000000007
  States = 1 shl N
  Full = States - 1
  Last = N - 1
  Nodes' = 0 till N
  Back = new graph Nodes .directed
  for Edge in Edges
    unpack From To = Edge
    U = To - 1
    V = From - 1
    Back add U V
  end

  Ways = array shape States N fill 0
  Ways 1 0 = 1
  for Mask in 3 till States by 2
    HasLast = Mask bit Last
    if HasLast and Mask not equal Full
      continue
    end
    for City in 1 till N
      if not Mask bit City
        continue
      end
      Bit = 1 shl City
      Before = Mask bxor Bit
      Prevs = Back City
      Ways Mask City = (Ways Before Prevs) sum mod Modulus
    end
  end
  return Ways Full Last
end
