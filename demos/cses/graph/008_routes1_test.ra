use testing

test "official example"
  use "008_routes1"
  use graph
  use ranges
  Graph = new graph (1 to 3) .directed
  Edges = array shape 4 3
    1 2 6
    1 3 2
    3 2 3
    1 3 4
  end
  Graph add Edges
  Result = Graph 3 shortest
  Result equal (array 0 5 2)
end

test "skips an outdated heap entry"
  use "008_routes1"
  use graph
  use ranges
  Graph = new graph (1 to 4) .directed
  Edges = array shape 5 3
    1 2 100
    1 3 1
    3 2 1
    2 4 1
    3 4 20
  end
  Graph add Edges
  Result = Graph 4 shortest
  Result equal (array 0 2 1 3)
end

test "keeps exact large distances"
  use "008_routes1"
  use graph
  use ranges
  Graph = new graph (1 to 3) .directed
  Edges = array shape 2 3
    1 2 9007199254740993
    2 3 9007199254740993
  end
  Graph add Edges
  Result = Graph 3 shortest
  Expected = array shape 3
    0 9007199254740993
    18014398509481986
  end
  Result equal Expected
end

test "handles positive cycles"
  use "008_routes1"
  use graph
  use ranges
  Graph = new graph (1 to 4) .directed
  Edges = array shape 5 3
    1 2 5
    2 3 2
    3 2 1
    1 4 20
    3 4 3
  end
  Graph add Edges
  Result = Graph 4 shortest
  Result equal (array 0 5 7 10)
end
