use testing

test "official example"
  use "031_hamiltonian"
  use bits
  use graph
  Edges = array shape 6 2
    1 2
    1 3
    2 3
    3 2
    2 4
    3 4
  end
  4 Edges hamiltonian_flights equal 2
end

test "counts parallel flights"
  use "031_hamiltonian"
  use bits
  use graph
  Edges = array shape 3 2
    1 2
    1 2
    2 3
  end
  3 Edges hamiltonian_flights equal 2
end

test "rejects routes missing a city"
  use "031_hamiltonian"
  use bits
  use graph
  Edges = array shape 3 2
    1 4
    1 2
    2 4
  end
  4 Edges hamiltonian_flights equal 0
end

test "handles the smallest route"
  use "031_hamiltonian"
  use bits
  use graph
  Edges = array shape 1 2
    1 2
  end
  2 Edges hamiltonian_flights equal 1
end
