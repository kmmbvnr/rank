rem CSES 1202: Investigation
rem https://cses.fi/problemset/task/1202

use algo
use graph
use io
use numbers
use sequences

N = stdin .integer
M = stdin .integer
ValueCount = M * 3
Values = stdin .integer ValueCount array
Edges = Values reshape M 3
Graph = new graph (1 to N) .directed
Graph add Edges
Graph N investigate print


rem Describe all cheapest routes to N.
fun investigate Graph N
  Modulus = 1000000007
  Size = N + 1
  Dist = array shape Size fill infinity
  Ways = array shape Size fill 0
  MinFlights = array shape Size fill 0
  MaxFlights = array shape Size fill 0
  Dist 1 = 0
  Ways 1 = 1
  Pending = new heap
  Pending 0 (array 1 0) enqueue

  for Pending len greater 0
    unpack Current Distance = Pending pop
    if Distance not equal Dist Current
      continue
    end

    for Edge in Graph edges Current
      unpack Next Cost = Edge
      Candidate = Distance + Cost
      MinF = MinFlights Current + 1
      MaxF = MaxFlights Current + 1
      if Candidate less Dist Next
        Dist Next = Candidate
        Ways Next = Ways Current
        MinFlights Next = MinF
        MaxFlights Next = MaxF
        NextItem = array Next Candidate
        Pending Candidate NextItem enqueue
      elif Candidate equal Dist Next
        Ways Next += Ways Current
        Ways Next mod= Modulus
        MinFlights Next = MinF (MinFlights Next) min
        MaxFlights Next = MaxF (MaxFlights Next) max
      end
    end
  end

  DistN = Dist N
  WaysN = Ways N
  MinN = MinFlights N
  MaxN = MaxFlights N
  return array DistN WaysN MinN MaxN
end
