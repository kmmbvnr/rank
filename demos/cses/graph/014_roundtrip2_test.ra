use testing

test "official example"
  use "014_roundtrip2"
  use graph
  use ranges
  Graph = new graph (1 to 4) .directed
  Edges = array shape 5 2
    1 3
    2 1
    2 4
    3 2
    3 4
  end
  Graph add Edges
  Cycle = Graph round_trip
  Cycle equal (array 1 3 2 1)
end

test "acyclic graph has no trip"
  use "014_roundtrip2"
  use graph
  use ranges
  use sequences
  Graph = new graph (1 to 4) .directed
  Graph add 1 2
  Graph add 1 3
  Graph add 3 4
  Cycle = Graph round_trip
  Cycle shape equal (array 0)
end

test "finds a disconnected cycle"
  use "014_roundtrip2"
  use graph
  use ranges
  Graph = new graph (1 to 5) .directed
  Graph add 1 2
  Graph add 3 4
  Graph add 4 5
  Graph add 5 3
  Cycle = Graph round_trip
  Cycle equal (array 3 4 5 3)
end

test "finds a two-city cycle"
  use "014_roundtrip2"
  use graph
  use ranges
  Graph = new graph (1 to 3) .directed
  Graph add 1 2
  Graph add 2 1
  Cycle = Graph round_trip
  Cycle equal (array 1 2 1)
end
