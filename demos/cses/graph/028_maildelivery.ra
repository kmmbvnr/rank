rem CSES 1691: Mail Delivery
rem https://cses.fi/problemset/task/1691

use graph
use io
use sequences

N = stdin .integer
M = stdin .integer
Count = M * 2
Values = stdin .integer Count array
Edges = Values reshape M 2
Graph = new graph (1 to N) .undirected
Graph add Edges
Path = Graph mail_delivery M

if Path len equal 0
  "IMPOSSIBLE" print
else
  Path print
end


rem Walk every street and return.
fun Graph mail_delivery EdgeCount
  Path = Graph euler 1
  Valid = Path len equal EdgeCount + 1
  if Valid and Path last equal 1
    return Path
  end
  return array shape 0 fill 0
end
