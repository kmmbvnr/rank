rem CSES 1691: Mail Delivery
rem https://cses.fi/problemset/task/1691

use graph
use io
use sequences

N = stdin .integer
M = stdin .integer
Count = M * 2
Values = stdin .integer Count array
Edges = Values (array M 2) reshape
Graph = new graph (1 to N) .undirected
Graph add Edges
Path = Graph M mail_delivery

if Path len equal 0
  "IMPOSSIBLE" print
else
  Path print
end


rem Walk every street and return.
fun mail_delivery Graph EdgeCount
  Path = Graph 1 euler
  if Path len not equal EdgeCount + 1
    return array shape 0 fill 0
  end
  Last = Path len - 1
  if Path Last not equal 1
    return array shape 0 fill 0
  end
  return Path
end
