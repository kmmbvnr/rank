use testing

test "official example"
  use "012_cyclefinding"
  Edges = array shape 5 3
    1 2 1
    2 4 1
    3 1 1
    4 1 -3
    4 3 -2
  end
  Result = Edges 4 negative_cycle
  Result .found equal true
  Result .cycle equal array 4 1 2 4
end

test "acyclic graph has no cycle"
  use "012_cyclefinding"
  Edges = array shape 3 3
    1 2 -4
    1 3 2
    2 3 1
  end
  Result = Edges 3 negative_cycle
  Result .found equal false
end

test "positive cycle is ignored"
  use "012_cyclefinding"
  Edges = array shape 3 3
    1 2 1
    2 3 1
    3 1 1
  end
  Result = Edges 3 negative_cycle
  Result .found equal false
end

test "finds a disconnected cycle"
  use "012_cyclefinding"
  Edges = array shape 3 3
    1 2 5
    3 4 -2
    4 3 1
  end
  Result = Edges 4 negative_cycle
  Result .found equal true
  Result .cycle equal array 3 4 3
end
