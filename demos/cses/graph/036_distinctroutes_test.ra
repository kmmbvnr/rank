use testing

test "official example"
  use "036_distinctroutes"
  use algo
  use graph
  use ranges
  use sequences
  Edges = array shape 7 2
    1 2
    1 3
    2 6
    3 4
    3 5
    4 6
    5 6
  end
  Routes = 6 Edges distinct_routes
  Routes len equal 2
  Routes 0 equal (array 1 2 6)
  Routes 1 equal (array 1 3 4 6)
end

test "returns no route when separated"
  use "036_distinctroutes"
  use algo
  use graph
  use ranges
  use sequences
  Edges = array shape 1 2
    1 2
  end
  Routes = 3 Edges distinct_routes
  Routes len equal 0
end

test "uses direct parallel branches"
  use "036_distinctroutes"
  use algo
  use graph
  use ranges
  use sequences
  Edges = array shape 4 2
    1 2
    2 4
    1 3
    3 4
  end
  Routes = 4 Edges distinct_routes
  Routes len equal 2
end

test "does not share a teleporter"
  use "036_distinctroutes"
  use algo
  use graph
  use ranges
  use sequences
  Edges = array shape 5 2
    1 2
    1 3
    2 4
    3 4
    4 5
  end
  Routes = 5 Edges distinct_routes
  Routes len equal 1
  Routes 0 equal (array 1 2 4 5)
end
