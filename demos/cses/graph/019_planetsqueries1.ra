rem CSES 1750: Planets Queries I
rem https://cses.fi/problemset/task/1750

use io
use graph
use sequences

N = stdin .integer
Q = stdin .integer
Next = stdin .integer N array
ValueCount = Q * 2
Values = stdin .integer ValueCount array
Queries = Values (array Q 2) reshape
Next Queries planet_queries print


rem Answer functional-graph jumps.
fun planet_queries Next Queries
  Planets = Next functional
  Count = Queries len
  Answers = array shape Count fill 0
  for Query i in Queries
    unpack Planet Steps = Query
    End = Planets jump Planet Steps
    Answers i = End
  end
  return Answers
end
