rem CSES 1193: Labyrinth
rem https://cses.fi/problemset/task/1193

use algo
use io
use sequences
use text

Rows = stdin .integer
Columns = stdin .integer
Grid = stdin .word Rows array
Result = Grid labyrinth

if Result .found
  "YES" print
  Result .path len print
  Result .path print
else
  "NO" print
end


rem Find and rebuild a shortest path.
fun labyrinth Grid
  H = Grid len
  W = Grid 0 len
  DYs = array -1 1 0 0
  DXs = array 0 0 -1 1
  Moves = array "U" "D" "L" "R"
  Parent = array shape H W fill -1
  Start = -1
  Target = -1

  for Line Y in Grid
    for Cell X in Line
      if Cell equal "A"
        Start = Y * W + X
      elif Cell equal "B"
        Target = Y * W + X
      end
    end
  end

  StartY = Start // W
  StartX = Start mod W
  Parent StartY StartX = -2
  Pending = new queue
  Pending push Start

  for Position in Pending
    if Position equal Target
      break
    end
    Row = Position // W
    Column = Position mod W

    for DY Direction in DYs
      NY = Row + DY
      NX = Column + DXs Direction
      if NY less 0 or NY at least H
        continue
      end
      if NX less 0 or NX at least W
        continue
      end

      Neighbor = Grid NY
      if Neighbor NX equal "#"
        continue
      end
      if Parent NY NX not equal -1
        continue
      end

      Parent NY NX = Direction
      Pending push NY * W + NX
    end
  end

  TargetY = Target // W
  TargetX = Target mod W
  LastMove = Parent TargetY TargetX
  Found = LastMove not equal -1
  Path = ""

  if Found
    Position = Target
    for Position not equal Start
      Row = Position // W
      Column = Position mod W
      Direction = Parent Row Column
      Path += Moves Direction
      Row -= DYs Direction
      Column -= DXs Direction
      Position = Row * W + Column
    end
    Path = Path reverse
  end

  return record
    .found = Found
    .path = Path
  end
end
