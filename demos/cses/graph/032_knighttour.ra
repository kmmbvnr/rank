rem CSES 1689: Knight's Tour
rem https://cses.fi/problemset/task/1689

use algo
use io
use numbers
use sequences

X = stdin .integer
Y = stdin .integer
X Y knight_tour print


rem Search low-degree moves first.
fun StartX StartY knight_tour
  Board = array shape 8 8 fill 0
  DX = array 2 1 -1 -2 -2 -1 1 2
  DY = array 1 2 2 1 -1 -2 -2 -1

  fun X Y Board countopen
    if X less 0 or X at least 8
      return false
    end
    if Y less 0 or Y at least 8
      return false
    end
    return Board Y X equal 0
  end

  fun Position Board degree
    X = Position mod 8
    Y = Position // 8
    Count = 0
    for Move in 0 till 8
      NX = X + DX Move
      NY = Y + DY Move
      if NX NY Board countopen
        Count += 1
      end
    end
    return Count
  end

  fun X Y Step Board visit
    Board Y X = Step
    if Step equal 64
      return Board
    end

    Moves = new queue
    for Move in 0 till 8
      NX = X + DX Move
      NY = Y + DY Move
      Next = NY * 8 + NX
      if NX NY Board countopen
        Moves push Next
      end
    end
    Ordered = Moves sort by Board degree
    for Next in Ordered
      NX = Next mod 8
      NY = Next // 8
      NextStep = Step + 1
      Result = NX NY NextStep Board visit
      if Result len greater 0
        return Result
      end
    end
    return array shape 0 0 fill 0
  end

  Board = (StartX - 1) (StartY - 1) 1 Board visit
  if Board len equal 0
    .Failure "tour not found" raise
  end
  return Board
end


rem Verify numbering and knight moves.
fun Board valid_tour
  Xs = array shape 65 fill 0
  Ys = array shape 65 fill 0
  for Y in 0 till 8
    for X in 0 till 8
      Step = Board Y X
      if Step less 1 or Step greater 64
        return false
      end
      Xs Step = X
      Ys Step = Y
    end
  end

  DX = (Xs -1 shift - Xs) abs
  DY = (Ys -1 shift - Ys) abs
  Moves = DX * DY
  Inner = Moves drop 1 take 63
  Knight = Inner equal 2
  return Knight all
end
