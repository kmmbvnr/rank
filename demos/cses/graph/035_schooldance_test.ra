use testing

test "official example"
  use "035_schooldance"
  use algo
  use graph
  use ranges
  use sequences
  Pairs = array shape 4 2
    1 1
    1 2
    2 1
    3 1
  end
  Result = 3 2 Pairs school_dance
  Result .count equal 2
  Result .pairs len equal 2
end

test "matches every disjoint pair"
  use "035_schooldance"
  use algo
  use graph
  use ranges
  use sequences
  Pairs = array shape 3 2
    1 3
    2 1
    3 2
  end
  Result = 3 3 Pairs school_dance
  Result .count equal 3
  Matched = Result .pairs
  Matched 0 equal (array 1 3)
  Matched 1 equal (array 2 1)
  Matched 2 equal (array 3 2)
end

test "one student dances once"
  use "035_schooldance"
  use algo
  use graph
  use ranges
  use sequences
  Pairs = array shape 3 2
    1 1
    1 2
    1 3
  end
  Result = 1 3 Pairs school_dance
  Result .count equal 1
end

test "allows unmatched students"
  use "035_schooldance"
  use algo
  use graph
  use ranges
  use sequences
  Pairs = array shape 1 2
    2 2
  end
  Result = 3 3 Pairs school_dance
  Result .count equal 1
  Matched = Result .pairs
  Matched 0 equal (array 2 2)
end
