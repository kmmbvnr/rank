use testing

test "official example"
  use "016_longestroute"
  use graph
  use ranges
  Graph = new graph (1 to 5) .directed
  Edges = array shape 5 2
    1 2
    2 5
    1 3
    3 4
    4 5
  end
  Graph add Edges
  Result = Graph 5 longest_route
  Result .found equal true
  Result .path equal (array 1 3 4 5)
end

test "reports an unreachable target"
  use "016_longestroute"
  use graph
  use ranges
  Graph = new graph (1 to 4) .directed
  Graph add 1 2
  Graph add 3 4
  Result = Graph 4 longest_route
  Result .found equal false
end

test "uses a direct flight"
  use "016_longestroute"
  use graph
  use ranges
  Graph = new graph (1 to 2) .directed
  Graph add 1 2
  Result = Graph 2 longest_route
  Result .path equal (array 1 2)
end

test "chooses more cities"
  use "016_longestroute"
  use graph
  use ranges
  Graph = new graph (1 to 6) .directed
  Edges = array shape 6 2
    1 6
    1 2
    2 3
    3 4
    4 6
    2 5
  end
  Graph add Edges
  Result = Graph 6 longest_route
  Result .path equal (array 1 2 3 4 6)
end
