use testing

test "official starting square"
  use "032_knighttour"
  use algo
  use numbers
  use sequences
  Board = 2 knight_tour 1
  Board valid_tour
  Board 0 1 equal 1
end

test "starts in the upper left corner"
  use "032_knighttour"
  use algo
  use numbers
  use sequences
  Board = 1 knight_tour 1
  Board valid_tour
  Board 0 0 equal 1
end

test "starts in the board center"
  use "032_knighttour"
  use algo
  use numbers
  use sequences
  Board = 4 knight_tour 4
  Board valid_tour
  Board 3 3 equal 1
end

test "solves every starting square"
  use "032_knighttour"
  use algo
  use numbers
  use sequences
  for Y in 1 to 8
    for X in 1 to 8
      Board = X knight_tour Y
      Board valid_tour
    end
  end
end
