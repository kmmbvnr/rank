use testing

test "official example"
  use "021_planetscycles"
  use graph
  Next = array 2 4 3 1 4
  Result = Next planet_cycles
  Result equal (array 3 3 1 3 4)
end

test "counts self loops"
  use "021_planetscycles"
  use graph
  Next = array 1 2 3
  Result = Next planet_cycles
  Result equal (array 1 1 1)
end

test "adds tail and cycle lengths"
  use "021_planetscycles"
  use graph
  Next = array 2 3 4 3 4
  Result = Next planet_cycles
  Result equal (array 4 3 2 2 3)
end

test "handles separate cycles"
  use "021_planetscycles"
  use graph
  Next = array 2 1 4 5 3 5
  Result = Next planet_cycles
  Result equal (array 2 2 3 3 3 4)
end
