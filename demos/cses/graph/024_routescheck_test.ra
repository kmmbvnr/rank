use testing

test "accepts strong connectivity"
  use "024_routescheck"
  use graph
  Edges = array shape 3 2
    1 2
    2 3
    3 1
  end
  Result = 3 Edges routes_check
  Result .possible equal true
end

test "finds a missing forward route"
  use "024_routescheck"
  use graph
  Edges = array shape 2 2
    2 1
    3 2
  end
  Result = 3 Edges routes_check
  Result .possible equal false
  Result .source equal 1
  Result .target equal 2
end

test "finds a missing return route"
  use "024_routescheck"
  use graph
  Edges = array shape 2 2
    1 2
    2 3
  end
  Result = 3 Edges routes_check
  Result .possible equal false
  Result .source equal 2
  Result .target equal 1
end

test "one city is strongly connected"
  use "024_routescheck"
  use graph
  use sequences
  Edges = array shape 0 2 fill 0
  Result = 1 Edges routes_check
  Result .possible equal true
end
