use testing

test "official example"
  use "033_downloadspeed"
  use graph
  Edges = array shape 5 3
    1 2 3
    2 4 2
    1 3 4
    3 4 5
    4 1 3
  end
  4 download_speed Edges equal 6
end

test "adds parallel capacities"
  use "033_downloadspeed"
  use graph
  Edges = array shape 3 3
    1 2 4
    1 2 7
    2 3 20
  end
  3 download_speed Edges equal 11
end

test "is limited by a bottleneck"
  use "033_downloadspeed"
  use graph
  Edges = array shape 3 3
    1 2 100
    2 3 2
    1 3 1
  end
  3 download_speed Edges equal 3
end

test "returns zero without a route"
  use "033_downloadspeed"
  use graph
  Edges = array shape 1 3
    1 2 9
  end
  3 download_speed Edges equal 0
end
