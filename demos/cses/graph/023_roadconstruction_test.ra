use testing

test "official example"
  use "023_roadconstruction"
  use graph
  use numbers
  use sequences
  Roads = array shape 3 2
    1 2
    1 3
    4 5
  end
  Actual = 5 Roads road_progress
  Expected = array shape 3 2
    4 2
    3 3
    2 3
  end
  Actual equal Expected
end

test "ignores duplicate roads"
  use "023_roadconstruction"
  use graph
  use numbers
  use sequences
  Roads = array shape 3 2
    1 2
    2 1
    1 2
  end
  Actual = 3 Roads road_progress
  Expected = array shape 3 2
    2 2
    2 2
    2 2
  end
  Actual equal Expected
end

test "merges two larger components"
  use "023_roadconstruction"
  use graph
  use numbers
  use sequences
  Roads = array shape 3 2
    1 2
    3 4
    2 3
  end
  Actual = 4 Roads road_progress
  Expected = array shape 3 2
    3 2
    2 2
    1 4
  end
  Actual equal Expected
end

test "supports no roads"
  use "023_roadconstruction"
  use graph
  use numbers
  use sequences
  Roads = array shape 0 2 fill 0
  Actual = 3 Roads road_progress
  Actual shape equal array 0 2
end
