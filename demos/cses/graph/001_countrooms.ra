rem CSES 1192: Counting Rooms
rem https://cses.fi/problemset/task/1192

use algo
use io
use sequences

Rows = stdin .integer
Columns = stdin .integer
Grid = stdin .word Rows array
Grid count_rooms print


rem Count connected floor components.
fun count_rooms Grid
  H = Grid len
  W = Grid 0 len
  Seen = array shape H W fill false
  DYs = array -1 1 0 0
  DXs = array 0 0 -1 1

  rem Mark one component with BFS.
  fun flood Y X
    Line = Grid Y
    if Line X not equal "."
      return 0
    end
    if Seen Y X
      return 0
    end

    Seen Y X = true
    queue push Y * W + X
    Head = 0

    for queue len greater Head
      Position = queue Head
      Row = Position // W
      Column = Position % W

      for DY Direction in DYs
        NY = Row + DY
        NX = Column + DXs Direction
        Inside = NY at least 0
        Inside and= NY less H
        Inside and= NX at least 0
        Inside and= NX less W

        if not Inside
          continue
        end

        Neighbor = Grid NY
        if Neighbor NX not equal "."
          continue
        end
        if Seen NY NX
          continue
        end

        Seen NY NX = true
        Next = NY * W + NX
        queue push Next
      end

      Head += 1
    end

    return 1
  end

  Rooms = 0
  for Line Y in Grid
    for Cell X in Line
      Rooms += Y X flood
    end
  end

  return Rooms
end
