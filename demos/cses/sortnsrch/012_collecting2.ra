rem CSES 2217: Collecting Numbers II
rem https://cses.fi/problemset/task/2217

use io
use algo
use sequences

N = stdin .integer
M = stdin .integer
A = stdin .integer N array
Raw = stdin .integer (M * 2) array
Swaps = Raw (array M 2) reshape

A Swaps collecting_updates print


rem Update the round count after swaps.
fun collecting_updates Values Swaps
  Index = new index
  Queue = new queue
  A = Values copy
  N = A len

  for Value i in A
    Index Value = i
  end

  Rounds = 1

  for Value in 1 till N
    if Index Value greater Index (Value + 1)
      Rounds += 1
    end
  end

  for Swap in Swaps rank 1
    I = Swap 0 - 1
    J = Swap 1 - 1
    X = A I
    Y = A J

    PrevX = X - 1
    PrevY = Y - 1
    Edges = array X Y PrevX PrevY
    Edges = Edges unique

    for Value in Edges
      if Value less 1 or Value at least N
        continue
      end
      if Index Value greater Index (Value + 1)
        Rounds -= 1
      end
    end

    A I = Y
    A J = X
    Index X = J
    Index Y = I

    for Value in Edges
      if Value less 1 or Value at least N
        continue
      end
      if Index Value greater Index (Value + 1)
        Rounds += 1
      end
    end

    Queue push Rounds
  end

  return Queue
end
