use testing

test "official example"
  use "004_tickets"
  Prices = array 5 3 7 8 5
  Customers = array 4 8 3
  Actual = Prices Customers sell
  Actual equal array 3 8 -1
end

test "duplicate tickets sell separately"
  use "004_tickets"
  Prices = array 5 5 7
  Customers = array 5 6 5 9
  Actual = Prices Customers sell
  Actual equal array 5 5 -1 7
end

test "no ticket is affordable"
  use "004_tickets"
  Prices = array 10 20
  Customers = array 5 9
  Actual = Prices Customers sell
  Actual equal array -1 -1
end
