use testing

test "official example"
  use "022_rooms"
  Visits = array shape 3 2
    1 2
    2 4
    4 4
  end
  Result = Visits allocate_rooms
  Result .count equal 2
  Result .rooms equal array 1 2 1
end

test "disjoint visits share one room"
  use "022_rooms"
  Visits = array shape 3 2
    5 6
    1 2
    3 4
  end
  Result = Visits allocate_rooms
  Result .count equal 1
  Result .rooms equal array 1 1 1
end

test "overlapping visits need rooms"
  use "022_rooms"
  Visits = array shape 4 2
    1 8
    2 7
    3 6
    4 5
  end
  Result = Visits allocate_rooms
  Result .count equal 4
  Result .rooms equal array 1 2 3 4
end

test "departure on arrival day conflicts"
  use "022_rooms"
  Visits = array shape 3 2
    1 3
    3 5
    4 4
  end
  Result = Visits allocate_rooms
  Result .count equal 2
  Result .rooms equal array 1 2 1
end
