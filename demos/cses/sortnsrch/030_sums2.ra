rem CSES 1661: Subarray Sums II
rem https://cses.fi/problemset/task/1661

use io
use algo

N = stdin .integer
X = stdin .integer
A' = stdin .integer N

A count_subarray_sums X print


rem Count equal prefix-sum differences.
fun A' count_subarray_sums Target
  Index = new index
  Prefix = 0
  Answer = 0

  Index 0 = 1

  for Value in A
    Prefix += Value
    Need = Prefix - Target

    if Need in Index
      Answer += Index Need
    end

    Count = Index Prefix default 0
    Index Prefix = Count + 1
  end

  return Answer
end
