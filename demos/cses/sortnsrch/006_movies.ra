rem CSES 1629: Movie Festival
rem https://cses.fi/problemset/task/1629

use io
use algo
use sequences

N = stdin .integer
Movies = new queue

for # in 1 to N
  Start = stdin .integer
  Finish = stdin .integer
  Movies push Start movie Finish
end

Movies watch print


rem Describe one scheduled movie.
fun Start movie Finish
  Movie = record
    .start = Start
    .finish = Finish
  end
  return Movie
end


rem Choose movies by earliest finish.
fun Movies watch
  Sorted = Movies sort by .finish
  Last = 0
  Answer = 0

  for Movie in Sorted
    if Movie .start less Last
      continue
    end
    Last = Movie .finish
    Answer += 1
  end

  return Answer
end
