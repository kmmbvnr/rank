rem CSES 1642: Sum of Four Values
rem https://cses.fi/problemset/task/1642

use io
use algo
use sequences

N = stdin .integer
X = stdin .integer
A = stdin .integer N array

Answer = A X find_four

if Answer len equal 0
  "IMPOSSIBLE" print
else
  Answer print
end


rem Match each pair with an earlier pair.
fun find_four A Target
  Index = new index
  N = A len

  for i in 0 till N
    for j in i + 1 till N
      Need = Target - A i - A j

      if Need in Index
        Pair = Index Need
        P = Pair 0 + 1
        Q = Pair 1 + 1
        R = i + 1
        S = j + 1
        return array P Q R S
      end
    end

    for k in 0 till i
      Sum = A k + A i
      Index Sum = array k i
    end
  end

  return array shape 0
  end
end
