use testing

test "official example"
  use "023_factory"
  Machines = array 3 2 5
  Machines minimum_time 7 equal 8
end

test "one machine"
  use "023_factory"
  Machines = array 4
  Machines minimum_time 6 equal 24
end

test "parallel equal machines"
  use "023_factory"
  Machines = array 2 2 2
  Machines minimum_time 5 equal 4
end

test "large integer result"
  use "023_factory"
  Machines = array 1000000000
  Expected = 1000000000000000000
  Actual = Machines minimum_time 1000000000
  Actual equal Expected
end
