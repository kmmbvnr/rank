rem CSES: Distinct Values Subarrays
rem https://cses.fi/problemset/task/3420

use io
use algo

N = stdin .integer
A = stdin .integer N array

A distinct_subarrays print


rem Count subarrays with distinct values.
fun distinct_subarrays A
  Index = new index
  Left = 0
  Answer = 0

  for Value i in A
    if Value in Index
      Left = Left (Index Value + 1) max
    end

    Index Value = i
    Answer += i - Left + 1
  end

  return Answer
end
