use testing

test "official example"
  use "026_three"
  Values = array 2 7 5 1
  Values 8 find_three equal array 4 1 3
end

test "three equal values"
  use "026_three"
  Values = array 2 2 2
  Values 6 find_three equal array 1 2 3
end

test "no solution"
  use "026_three"
  Values = array 1 2 4 8
  Actual = Values 20 find_three
  Actual equal array shape 0
  end
end

test "supports negative values"
  use "026_three"
  Values = array -5 10 2 -1 7
  Values 4 find_three equal array 1 4 2
end
