use testing

test "official example"
  use "026_three"
  Values = array 2 7 5 1
  Values find_three 8 equal array 4 1 3
end

test "three equal values"
  use "026_three"
  Values = array 2 2 2
  Values find_three 6 equal array 1 2 3
end

test "no solution"
  use "026_three"
  Values = array 1 2 4 8
  Actual = Values find_three 20
  Actual equal array shape 0
  end
end

test "supports negative values"
  use "026_three"
  Values = array -5 10 2 -1 7
  Values find_three 4 equal array 1 4 2
end
