rem CSES 1085: Array Division
rem https://cses.fi/problemset/task/1085

use io

N = stdin .integer
K = stdin .integer
A = stdin .integer N array

A minimum_largest_sum K print


rem Find the smallest feasible part limit.
fun A minimum_largest_sum K
  Low = A max
  High = A sum

  for Low less High
    Mid = (Low + High) // 2

    Parts = 1
    Sum = 0

    for X in A
      if Sum + X greater Mid
        Parts += 1
        Sum = X
      else
        Sum += X
      end
    end

    if Parts at most K
      High = Mid
    else
      Low = Mid + 1
    end
  end

  return Low
end
