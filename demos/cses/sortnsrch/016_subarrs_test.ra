use testing

test "official example"
  use "016_subarrs"
  Values = array 1 2 1 3
  Values distinct_subarrays equal 8
end

test "all values differ"
  use "016_subarrs"
  Values = array 4 1 9 2
  Values distinct_subarrays equal 10
end

test "all values are equal"
  use "016_subarrs"
  Values = array 7 7 7 7
  Values distinct_subarrays equal 4
end

test "later duplicate moves left edge"
  use "016_subarrs"
  Values = array 1 2 3 2 4
  Values distinct_subarrays equal 11
end
