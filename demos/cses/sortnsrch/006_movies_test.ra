use testing

test "official example"
  use "006_movies"
  use algo
  Movies = new queue
  Movies push 3 movie 5
  Movies push 4 movie 9
  Movies push 5 movie 8
  Movies watch equal 2
end

test "touching movies are compatible"
  use "006_movies"
  use algo
  Movies = new queue
  Movies push 1 movie 2
  Movies push 2 movie 3
  Movies push 3 movie 4
  Movies watch equal 3
end

test "input order does not guide choice"
  use "006_movies"
  use algo
  Movies = new queue
  Movies push 5 movie 7
  Movies push 1 movie 10
  Movies push 2 movie 3
  Movies push 3 movie 5
  Movies watch equal 3
end

test "all movies overlap"
  use "006_movies"
  use algo
  Movies = new queue
  Movies push 1 movie 10
  Movies push 2 movie 9
  Movies push 3 movie 8
  Movies watch equal 1
end

test "empty movie collection"
  use "006_movies"
  use algo
  Movies = new queue
  Movies watch equal 0
end
