use testing

test "official example"
  use "030_sums2"
  Values = array 2 -1 3 5 -2
  Values count_subarray_sums 7 equal 2
end

test "repeated zero prefixes"
  use "030_sums2"
  Values = array 0 0 0
  Values count_subarray_sums 0 equal 6
end

test "negative target"
  use "030_sums2"
  Values = array -1 -2 3 -3
  Values count_subarray_sums (-3) equal 3
end

test "no matching sum"
  use "030_sums2"
  Values = array 2 4 8
  Values count_subarray_sums 7 equal 0
end
