use testing

test "official example"
  use "027_four"
  Values = array 3 2 5 8 1 3 2 3
  Expected = array 1 2 4 7
  Values find_four 15 equal Expected
end

test "four equal values"
  use "027_four"
  Values = array 2 2 2 2
  Values find_four 8 equal array 1 2 3 4
end

test "no solution"
  use "027_four"
  Values = array 1 2 4 8 16
  Actual = Values find_four 100
  Actual equal array shape 0
  end
end

test "supports negative values"
  use "027_four"
  Values = array -4 7 -1 5 9
  Expected = array 1 2 3 4
  Values find_four 7 equal Expected
end
