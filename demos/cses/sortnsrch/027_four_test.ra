use testing

test "official example"
  use "027_four"
  Values = array 3 2 5 8 1 3 2 3
  Expected = array 1 2 4 7
  Values 15 find_four equal Expected
end

test "four equal values"
  use "027_four"
  Values = array 2 2 2 2
  Values 8 find_four equal array 1 2 3 4
end

test "no solution"
  use "027_four"
  Values = array 1 2 4 8 16
  Actual = Values 100 find_four
  Actual equal array shape 0
  end
end

test "supports negative values"
  use "027_four"
  Values = array -4 7 -1 5 9
  Expected = array 1 2 3 4
  Values 7 find_four equal Expected
end
