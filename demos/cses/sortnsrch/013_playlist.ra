rem CSES 1141: Playlist
rem https://cses.fi/problemset/task/1141

use io
use algo

N = stdin .integer
A' = stdin .integer N

A longest_distinct print


rem Find the longest distinct segment.
fun A' longest_distinct
  Index = new index
  Left = 0
  Best = 0

  for Value i in A
    if Value in Index
      Left = Left max (Index Value + 1)
    end

    Index Value = i

    Size = i - Left + 1
    Best = Best max Size
  end

  return Best
end
