rem CSES 1643: Maximum Subarray Sum
rem https://cses.fi/problemset/task/1643

use io

N = stdin .integer
A = stdin .integer N array

A max_subarray print


rem Find the largest contiguous sum.
fun max_subarray A
  Current = A 0
  Best = A 0

  for Value i in A
    if i equal 0
      continue
    end
    Current = Value (Current + Value) max
    Best = Best Current max
  end

  return Best
end
