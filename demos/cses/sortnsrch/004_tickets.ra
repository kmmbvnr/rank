rem CSES 1091: Concert Tickets
rem https://cses.fi/problemset/task/1091

use io
use algo

N = stdin .integer
M = stdin .integer
Prices' = stdin .integer N
Customers' = stdin .integer M

Prices Customers sell print


rem Sell the best affordable ticket.
fun Prices' Customers' sell
  Queue = new queue
  Tickets = Prices multiset

  for Max in Customers
    Price = Tickets floor Max default -1
    Queue push Price

    if Price not equal -1
      Tickets remove Price
    end
  end

  return Queue
end
