use testing

test "official example"
  use "008_maxsubarray"
  A = array -1 3 -2 5 3 -5 2 2
  A max_subarray equal 9
end

test "all values are negative"
  use "008_maxsubarray"
  A = array -8 -2 -5 -4
  A max_subarray equal -2
end

test "best range is one value"
  use "008_maxsubarray"
  A = array -5 7 -8 2
  A max_subarray equal 7
end

test "one input value"
  use "008_maxsubarray"
  A = array -11
  A max_subarray equal -11
end
