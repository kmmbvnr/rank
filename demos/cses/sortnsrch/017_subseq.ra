rem CSES 3421: Distinct Values Subsequences
rem https://cses.fi/problemset/task/3421

use io
use algo

N = stdin .integer
A' = stdin .integer N

A distinct_subsequences print


rem Choose zero or one copy of each value.
fun A' distinct_subsequences
  Index = new index
  Seen = new set
  for Value in A
    Count = Index Value default 0
    Index Value = Count + 1
    Seen add Value
  end

  Answer = 1

  for Value in Seen
    Answer *= Index Value + 1
    Answer mod= 1000000007
  end

  return Answer - 1
end
