rem CSES 1073: Towers
rem https://cses.fi/problemset/task/1073

use io
use algo
use sequences

N = stdin .integer
A = stdin .integer N array

A tower_count print


rem Keep the smallest possible top for every tower.
fun tower_count A
  Towers = new multiset

  for Cube in A
    Need = Cube + 1
    Top = Towers ceiling Need pad 0

    if Top not equal 0
      Towers remove Top
    end

    Towers add Cube
  end

  return Towers len
end
