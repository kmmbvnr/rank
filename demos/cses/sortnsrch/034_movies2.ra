rem CSES 1632: Movie Festival II
rem https://cses.fi/problemset/task/1632

use io
use algo
use sequences

N = stdin .integer
K = stdin .integer
V = stdin .integer (N * 2) array

Data = V (array N 2) reshape
Data K maximum_movies print


rem Assign each movie to the latest free viewer.
fun maximum_movies Data K
  Begin = Data # 0
  Finish = Data # 1
  Order = Finish argsort
  Empty = array shape K pad 0
  Viewers = Empty multiset
  Answer = 0

  for i in Order
    Free = Viewers floor Begin i pad -1

    if Free equal -1
      continue
    end

    Viewers remove Free
    Viewers add Finish i
    Answer += 1
  end

  return Answer
end
