use testing

test "official example"
  use "032_dist2"
  Values = array 1 2 3 1 1
  Values count_distinct_windows 2 equal 10
end

test "one distinct value"
  use "032_dist2"
  Values = array 1 1 2
  Values count_distinct_windows 1 equal 4
end

test "all values fit"
  use "032_dist2"
  Values = array 4 1 9 2
  Values count_distinct_windows 4 equal 10
end

test "value can leave and return"
  use "032_dist2"
  Values = array 1 2 1 3
  Values count_distinct_windows 2 equal 8
end
