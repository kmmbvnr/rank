use testing

test "official example"
  use "029_sums1"
  Values = array 2 4 1 2 7
  Values count_positive_sums 7 equal 3
end

test "overlapping sums"
  use "029_sums1"
  Values = array 1 1 1
  Values count_positive_sums 2 equal 2
end

test "whole array"
  use "029_sums1"
  Values = array 2 3 4
  Values count_positive_sums 9 equal 1
end

test "no matching sum"
  use "029_sums1"
  Values = array 2 4 8
  Values count_positive_sums 7 equal 0
end
