rem CSES 1746: Array Description
rem https://cses.fi/problemset/task/1746

use io

N = stdin .integer
Maximum = stdin .integer
Description = stdin .integer N array

Description Maximum descriptions print


rem Keep counts for the prior position.
fun descriptions Description Maximum
  Modulus = 1000000007
  Size = Maximum + 2
  Previous = array shape Size fill 0
  First = Description 0

  if First equal 0
    for Value in 1 to Maximum
      Previous Value = 1
    end
  else
    Previous First = 1
  end

  for Wanted i in Description
    if i equal 0
      continue
    end
    Next = array shape Size fill 0

    for Value in 1 to Maximum
      if Wanted not equal 0 and Wanted not equal Value
        continue
      end
      Count = Previous (Value - 1)
      Count += Previous Value
      Count += Previous (Value + 1)
      Next Value = Count mod Modulus
    end

    Previous = Next
  end

  return Previous sum mod Modulus
end
