rem CSES 1745: Money Sums
rem https://cses.fi/problemset/task/1745

use algo
use io
use sequences

N = stdin .integer
Coins = stdin .integer N array
Sums = Coins money_sums

Sums len print
Sums print


rem Each shift reads the previous state, so every coin is used at most once.
fun Coins money_sums
  Maximum = Coins sum
  Reachable = array shape (Maximum + 1) fill false
  Reachable 0 = true

  for Coin in Coins
    Reachable = (Reachable or (Reachable Coin shift with false))
  end

  Reachable 0 = false
  return Reachable indices
end
