rem CSES 1744: Rectangle Cutting
rem https://cses.fi/problemset/task/1744

use io

Height = stdin .integer
Width = stdin .integer
Height rectangle_cuts Width print


rem Try each distinct first cut.
fun Height rectangle_cuts Width
  Rows = Height + 1
  Columns = Width + 1
  Cuts = array shape Rows Columns fill 0

  fun H best_cut W
    if H equal W
      return 0
    end

    Best = H * W
    for Split in 1 to H // 2
      Other = H - Split
      Candidate = Cuts Split W
      Candidate += Cuts Other W + 1
      Best = Best min Candidate
    end

    for Split in 1 to W // 2
      Other = W - Split
      Candidate = Cuts H Split
      Candidate += Cuts H Other + 1
      Best = Best min Candidate
    end

    return Best
  end

  for H in 1 to Height
    for W in 1 to Width
      Cuts H W = H best_cut W
    end
  end

  return Cuts Height Width
end
