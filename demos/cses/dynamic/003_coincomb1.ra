rem CSES 1635: Coin Combinations I
rem https://cses.fi/problemset/task/1635

use io

N = stdin .integer
Target = stdin .integer
Coins = stdin .integer N array

Coins Target ordered_coin_ways print


rem Count coin sequences for every sum.
fun ordered_coin_ways Coins Target
  Ways = array shape (Target + 1) fill 0
  Ways 0 = 1

  for Total in 1 to Target
    for Coin in Coins
      if Coin at most Total
        Previous = Total - Coin
        Ways Total += Ways Previous
        Ways Total %= 1000000007
      end
    end
  end

  return Ways Target
end
