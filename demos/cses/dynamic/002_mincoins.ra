rem CSES 1634: Minimizing Coins
rem https://cses.fi/problemset/task/1634

use io

N = stdin .integer
Target = stdin .integer
Coins = stdin .integer N array

Coins Target minimum_coins print


rem Find the fewest coins for every sum.
fun minimum_coins Coins Target
  Missing = Target + 1
  Best = array shape Missing fill Missing
  Best 0 = 0

  for Total in 1 to Target
    for Coin in Coins
      if Coin greater Total
        continue
      end
      Candidate = Best (Total - Coin) + 1
      Best Total = Best Total Candidate min
    end
  end

  Answer = Best Target
  if Answer equal Missing
    return -1
  end
  return Answer
end
