rem CSES 1634: Minimizing Coins
rem https://cses.fi/problemset/task/1634

use io

N = stdin .integer
Target = stdin .integer
Coins = stdin .integer N array

Coins Target minimum_coins print


rem Find the fewest coins for every sum.
fun minimum_coins Coins Target
  Missing = Target + 1
  Size = Target + 1
  Best = array shape Size fill Missing
  Best 0 = 0

  for Total in 1 to Target
    for Coin in Coins
      if Coin at most Total
        Previous = Total - Coin
        Candidate = Best Previous + 1
        Current = Best Total
        Minimum = Current Candidate min
        Best Total = Minimum
      end
    end
  end

  Answer = Best Target
  if Answer equal Missing
    return -1
  end
  return Answer
end
