rem CSES 2413: Counting Towers
rem https://cses.fi/problemset/task/2413

use io

Tests = stdin .integer
Heights = stdin .integer Tests array
Answers = Heights counting_towers

for Answer in Answers
  Answer print
end


rem Precompute both top-edge states
rem through the tallest query.
fun counting_towers Heights
  Modulus = 1000000007
  Maximum = Heights max
  Size = Maximum + 1
  Answers = array shape Size pad 0
  Together = 1
  Separate = 1
  Answers 1 = 2

  for Height in 2 to Maximum
    OldTogether = Together
    OldSeparate = Separate
    Together = 2 * OldTogether
    Together += OldSeparate
    Together %= Modulus
    Separate = OldTogether
    Separate += 4 * OldSeparate
    Separate %= Modulus
    Answer = Together + Separate
    Answers Height = Answer % Modulus
  end

  return Answers Heights
end
