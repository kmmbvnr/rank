rem CSES 1637: Removing Digits
rem https://cses.fi/problemset/task/1637

use io

N = stdin .integer
N removing_digits print


rem Reuse results for smaller values.
fun removing_digits N
  Steps = array shape (N + 1) fill (N + 1)
  Steps 0 = 0

  for Value in 1 to N
    Digits = Value text integer rank 0

    for Digit in Digits
      if Digit equal 0
        continue
      end
      Candidate = Steps (Value - Digit) + 1
      Steps Value = Steps Value Candidate min
    end
  end

  return Steps N
end
