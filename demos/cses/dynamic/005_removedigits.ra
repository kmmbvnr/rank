rem CSES 1637: Removing Digits
rem https://cses.fi/problemset/task/1637

use io
use numbers
use ranges
use text

N = stdin .integer
N removing_digits print


rem Reuse results for smaller values.
fun removing_digits N
  Size = N + 1
  Steps = array shape Size pad Size
  Steps 0 = 0

  for Value in 1 to N
    Digits = Value text integer rank 0

    for Digit in Digits
      if Digit greater 0
        Previous = Value - Digit
        Candidate = Steps Previous + 1
        Current = Steps Value
        Best = Current min Candidate
        Steps Value = Best
      end
    end
  end

  return Steps N
end
