rem CSES 1636: Coin Combinations II
rem https://cses.fi/problemset/task/1636

use io

N = stdin .integer
Target = stdin .integer
Coins = stdin .integer N array

Coins Target unordered_coin_ways print


rem Add each denomination once
rem to the dynamic program.
fun unordered_coin_ways Coins Target
  Ways = array shape (Target + 1) fill 0
  Ways 0 = 1

  for Coin in Coins
    if Coin greater Target
      continue
    end
    for Total in Coin to Target
      Ways Total += Ways (Total - Coin)
      Ways Total mod= 1000000007
    end
  end

  return Ways Target
end
