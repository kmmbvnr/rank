use testing

test "official example"
  use "010_editdistance"
  "LOVE" edit_distance "MOVIE" equal 2
end

test "equal texts"
  use "010_editdistance"
  "RANK" edit_distance "RANK" equal 0
end

test "all operation kinds"
  use "010_editdistance"
  A = "KITTEN"
  B = "SITTING"
  Actual = A edit_distance B
  Actual equal 3
end

test "empty left text"
  use "010_editdistance"
  "" edit_distance "ABC" equal 3
end
