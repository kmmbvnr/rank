rem CSES 1140: Projects
rem https://cses.fi/problemset/task/1140

use algo
use io
use sequences

N = stdin .integer
Projects = new queue

for Step in 1 to N
  Project = record
    .start = stdin .integer
    .finish = stdin .integer
    .reward = stdin .integer
  end
  Projects push Project
end

Projects maximum_reward print


rem Combine a project with its last
rem compatible prefix.
fun Jobs maximum_reward
  Sorted = Jobs sort by .finish .start
  Count = Sorted len
  Best = array shape (Count + 1) fill 0

  for Project i in Sorted
    Low = 0
    High = i

    for Low less High
      Middle = (Low + High) // 2
      Previous = Sorted Middle
      Finish = Previous .finish
      if Finish less Project .start
        Low = Middle + 1
      else
        High = Middle
      end
    end

    Skip = Best i
    Take = Best Low + Project .reward
    Best (i + 1) = Skip max Take
  end

  return Best Count
end


rem Build a project for direct callers.
fun Start Finish Reward project
  return record
    .start = Start
    .finish = Finish
    .reward = Reward
  end
end
