rem CSES 1140: Projects
rem https://cses.fi/problemset/task/1140

use algo
use io
use numbers
use ranges
use sequences

N = stdin .integer
Projects = new queue

for i in 1 to N
  Project = record
    .start = stdin .integer
    .finish = stdin .integer
    .reward = stdin .integer
  end
  Projects push Project
end

Projects maximum_reward print


rem Combine each project with the last compatible prefix.
fun maximum_reward Projects
  Sorted = Projects sort by .finish .start
  Count = Sorted len
  Best = array shape (Count + 1) pad 0

  for Project i in Sorted
    Low = 0
    High = i

    for Low less High
      Middle = (Low + High) // 2
      Previous = Sorted Middle
      if Previous .finish less Project .start
        Low = Middle + 1
      else
        High = Middle
      end
    end

    Take = Best Low + Project .reward
    Best (i + 1) = Best i max Take
  end

  return Best Count
end


rem Build one project value for direct callers and tests.
fun project Start Finish Reward
  return record
    .start = Start
    .finish = Finish
    .reward = Reward
  end
end
