rem CSES 3403: LCS
rem https://cses.fi/problemset/task/3403

use io
use sequences

N = stdin .integer
M = stdin .integer
A = stdin .integer N array
B = stdin .integer M array
Result = A B longest_common
Length = Result len

Length print
Result print


rem Build lengths, then trace one LCS.
fun longest_common A B
  N = A len
  M = B len
  R = N + 1
  C = M + 1
  Lengths = array shape R C fill 0

  for X i in A
    Row = i + 1
    for Y j in B
      Col = j + 1
      if X equal Y
        Lengths Row Col = (Lengths i j) + 1
      else
        Above = Lengths i Col
        Left = Lengths Row j
        Lengths Row Col = Above max Left
      end
    end
  end

  Size = Lengths N M
  Result = array shape Size fill 0
  Position = Size - 1
  Row = N
  Column = M

  for Row greater 0 and Column greater 0
    Rprev = Row - 1
    Cprev = Column - 1

    if A Rprev equal B Cprev
      Result Position = A Rprev
      Position -= 1
      Row = Rprev
      Column = Cprev
    else
      Above = Lengths Rprev Column
      Left = Lengths Row Cprev
      if Above greater Left
        Row = Rprev
      else
        Column = Cprev
      end
    end
  end

  return Result
end
