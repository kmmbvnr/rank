rem CSES 3314: Mountain Range
rem https://cses.fi/problemset/task/3314

use algo
use io

N = stdin .integer
Heights' = stdin .integer N
Heights mountain_route print


rem Collapse valleys into a stack.
fun Heights' mountain_route
  Mountains = new stack

  fun Height Mountains add_height
    Current = record
      .height = Height
      .path = 1
    end

    if Mountains len equal 0
      Mountains push Current
      return 0
    end

    Top = Mountains peek
    if Height less Top .height
      Mountains push Current
      return 0
    end
    if Height equal Top .height
      return 0
    end

    Lower = Mountains pop
    for Mountains len greater 0
      Top = Mountains peek
      if Height at most Top .height
        break
      end
      if Lower .path at least Top .path
        Top .path = Lower .path + 1
      end
      Lower = Mountains pop
    end

    Current .path += Lower .path

    if Mountains len equal 0
      Mountains push Current
      return 0
    end

    Top = Mountains peek
    if Height equal Top .height
      CurrentPath = Current .path
      Top .path = Top .path max CurrentPath
      return 0
    end

    Mountains push Current
    return 0
  end

  for Height in Heights
    Height Mountains add_height
  end

  for Mountains len greater 1
    Lower = Mountains pop
    Peak = Mountains peek
    if Lower .path at least Peak .path
      Peak .path = Lower .path + 1
    end
  end

  Peak = Mountains pop
  return Peak .path
end
