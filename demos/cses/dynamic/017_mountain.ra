rem CSES 3314: Mountain Range
rem https://cses.fi/problemset/task/3314

use algo
use io

N = stdin .integer
Heights = stdin .integer N array
Heights mountain_route print


rem Collapse valleys into a stack.
fun mountain_route Heights
  Mountains = new stack

  fun add_height Height
    Current = record
      .height = Height
      .path = 1
    end

    if Mountains len equal 0
      Mountains push Current
      return 0
    end

    Top = Mountains peek
    if Height less Top .height
      Mountains push Current
      return 0
    end
    if Height equal Top .height
      return 0
    end

    Lower = Mountains pop
    for Mountains len greater 0
      Top = Mountains peek
      if Height at most Top .height
        break
      end
      if Lower .path at least Top .path
        Top .path = Lower .path + 1
      end
      Lower = Mountains pop
    end

    Current .path += Lower .path

    if Mountains len equal 0
      Mountains push Current
      return 0
    end

    Top = Mountains peek
    if Height equal Top .height
      TopPath = Top .path
      CurrentPath = Current .path
      BestPath = TopPath max CurrentPath
      Top .path = BestPath
      return 0
    end

    Mountains push Current
    return 0
  end

  for Height in Heights
    Height add_height
  end

  for Mountains len greater 1
    Lower = Mountains pop
    Top = Mountains peek
    if Lower .path at least Top .path
      Top .path = Lower .path + 1
    end
  end

  Top = Mountains pop
  return Top .path
end
