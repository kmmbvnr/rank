rem CSES 2181: Counting Tilings
rem https://cses.fi/problemset/task/2181

use bits
use io

Height = stdin .integer
Width = stdin .integer
Height counting_tilings Width print


rem Carry occupied cells across columns.
fun Height counting_tilings Width
  Modulus = 1000000007
  States = 1 shl Height
  Current = array shape States fill 0
  Current 0 = 1

  for Column in 1 to Width
    Next = array shape States fill 0

    for Mask in 0 till States
      Ways = Current Mask
      if Ways equal 0
        continue
      end
      Next = Next 0 0 Mask Ways place
    end

    Current = Next
  end

  return Current 0

  rem Fill a column and emit its mask.
  fun Next Row NextMask Mask Ways place
    if Row equal Height
      Next NextMask += Ways
      Next NextMask mod= Modulus
      return Next
    end

    NextRow = Row + 1
    if Mask bit Row
      return Next NextRow NextMask Mask Ways place
    end

    Bit = 1 shl Row
    NewMask = NextMask bor Bit
    Next = Next NextRow NewMask Mask Ways place

    if NextRow equal Height
      return Next
    end
    if Mask bit NextRow equal false
      Next = Next (Row + 2) NextMask Mask Ways place
    end
    return Next
  end
end
