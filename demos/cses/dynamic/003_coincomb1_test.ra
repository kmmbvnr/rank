use testing

test "official example"
  use "003_coincomb1"
  Coins = array 2 3 5
  Coins ordered_coin_ways 9 equal 8
end

test "order distinguishes solutions"
  use "003_coincomb1"
  Coins = array 2 3
  Coins ordered_coin_ways 7 equal 3
end

test "empty sum has one sequence"
  use "003_coincomb1"
  Coins = array 4 9
  Coins ordered_coin_ways 0 equal 1
end

test "result is reduced modulo prime"
  use "003_coincomb1"
  Coins = array 1 2
  Actual = Coins ordered_coin_ways 50
  Actual equal 365010934
end
