rem CSES 2220: Counting Numbers
rem https://cses.fi/problemset/task/2220

use io
use numbers
use ranges
use text

Lower = stdin .integer
Upper = stdin .integer
Lower Upper count_numbers print


rem Subtract two inclusive digit-DP prefixes.
fun count_numbers Lower Upper
  return Upper valid_up_to - (Lower - 1) valid_up_to
end


rem Count values through Limit without equal adjacent digits.
fun valid_up_to Limit
  if Limit less 0
    return 0
  end

  Digits = Limit text integer rank 0
  Current = array shape 11 2 pad 0
  Current 10 1 = 1

  for Maximum in Digits
    Next = array shape 11 2 pad 0

    for Previous in 0 to 10
      for Tight in 0 to 1
        Ways = Current Previous Tight
        if Ways greater 0
          Last = 9
          if Tight equal 1
            Last = Maximum
          end

          for Digit in 0 to Last
            Leading = Previous equal 10 and Digit equal 0
            Repeated = Previous equal Digit

            if Leading or not Repeated
              NextPrevious = Digit
              if Leading
                NextPrevious = 10
              end

              NextTight = 0
              if Tight equal 1 and Digit equal Maximum
                NextTight = 1
              end

              Next NextPrevious NextTight += Ways
            end
          end
        end
      end
    end

    Current = Next
  end

  return Current sum
end
