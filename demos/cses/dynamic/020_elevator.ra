rem CSES 1653: Elevator Rides
rem https://cses.fi/problemset/task/1653

use bits
use io
use numbers
use ranges
use sequences

N = stdin .integer
Limit = stdin .integer
Weights = stdin .integer N array
Weights Limit elevator_rides print


rem Minimize rides, then weight in the final ride.
fun elevator_rides Weights Limit
  Count = Weights len
  States = 1 Count shl
  Rides = array shape States pad (Count + 1)
  Last = array shape States pad 0
  Rides 0 = 1

  for Mask in 1 until States
    for Person in 0 until Count
      if Mask Person bit
        Bit = 1 Person shl
        Previous = Mask Bit bxor
        NewRides = Rides Previous
        NewWeight = Last Previous + Weights Person

        if NewWeight greater Limit
          NewRides += 1
          NewWeight = Weights Person
        end

        BetterRides = NewRides less Rides Mask
        SameRides = NewRides equal Rides Mask
        BetterWeight = NewWeight less Last Mask

        if BetterRides or SameRides and BetterWeight
          Rides Mask = NewRides
          Last Mask = NewWeight
        end
      end
    end
  end

  return Rides (States - 1)
end
