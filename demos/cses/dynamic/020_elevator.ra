rem CSES 1653: Elevator Rides
rem https://cses.fi/problemset/task/1653

use bits
use io
use sequences

N = stdin .integer
Limit = stdin .integer
Weights = stdin .integer N array
Weights elevator_rides Limit print


rem Minimize rides, then final weight.
fun Weights elevator_rides Limit
  Count = Weights len
  States = 1 shl Count
  Missing = Count + 1
  Rides = array shape States fill Missing
  Last = array shape States fill 0
  Rides 0 = 1

  for Mask in 1 till States
    for Person in 0 till Count
      if not Mask bit Person
        continue
      end

      Bit = 1 shl Person
      Previous = Mask bxor Bit
      NewRides = Rides Previous
      Weight = Weights Person
      NewWeight = Last Previous + Weight

      if NewWeight greater Limit
        NewRides += 1
        NewWeight = Weight
      end

      if NewRides greater Rides Mask
        continue
      end
      if NewRides equal Rides Mask
        if NewWeight at least Last Mask
          continue
        end
      end

      Rides Mask = NewRides
      Last Mask = NewWeight
    end
  end

  return Rides (States - 1)
end
