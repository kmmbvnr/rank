use testing

test "official example"
  use "021_tilings"
  4 counting_tilings 7 equal 781
end

test "one square cannot be tiled"
  use "021_tilings"
  1 counting_tilings 1 equal 0
end

test "two by two square"
  use "021_tilings"
  2 counting_tilings 2 equal 2
end

test "two by three rectangle"
  use "021_tilings"
  2 counting_tilings 3 equal 3
end

test "odd area cannot be tiled"
  use "021_tilings"
  3 counting_tilings 3 equal 0
end
