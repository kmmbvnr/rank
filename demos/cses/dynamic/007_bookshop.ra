rem CSES 1158: Book Shop
rem https://cses.fi/problemset/task/1158

use io

N = stdin .integer
Budget = stdin .integer
Prices = stdin .integer N array
Pages = stdin .integer N array

Prices Pages Budget book_shop print


rem Visit budgets backwards so every
rem book is used at most once.
fun book_shop Prices Pages Budget
  Best = array shape (Budget + 1) fill 0

  for Price i in Prices
    if Price at most Budget
      for Cost in Budget to Price by -1
        Previous = Cost - Price
        PageCount = Pages i
        Base = Best Previous
        Candidate = Base + PageCount
        Current = Best Cost
        Maximum = Current max Candidate
        Best Cost = Maximum
      end
    end
  end

  return Best Budget
end
