rem CSES 1158: Book Shop
rem https://cses.fi/problemset/task/1158

use io
use numbers
use ranges

N = stdin .integer
Budget = stdin .integer
Prices = stdin .integer N array
Pages = stdin .integer N array

Prices Pages Budget book_shop print


rem Visit budgets backwards so each book is used once.
fun book_shop Prices Pages Budget
  Best = array shape (Budget + 1) pad 0

  for Price i in Prices
    if Price at most Budget
      for Cost in Budget to Price by -1
        Previous = Cost - Price
        Candidate = Best Previous + Pages i
        Best Cost = Best Cost max Candidate
      end
    end
  end

  return Best Budget
end
