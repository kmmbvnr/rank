use testing

test "official example"
  use "011_lcs"
  A = array 3 1 3 2 7 4 8 2
  B = array 6 5 1 2 3 4
  A B longest_common equal array 1 2 4
end

test "no common value"
  use "011_lcs"
  A = array 1 2 3
  B = array 4 5 6
  Expected = array shape 0 fill 0
  A B longest_common equal Expected
end

test "whole first array is shared"
  use "011_lcs"
  A = array 2 4 6
  B = array 1 2 3 4 5 6
  A B longest_common equal A
end

test "duplicates keep their positions"
  use "011_lcs"
  A = array 1 1 2
  B = array 1 2 2
  A B longest_common equal array 1 2
end
