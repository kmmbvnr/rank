use testing

test "official example"
  use "004_coincomb2"
  Coins = array 2 3 5
  Coins unordered_coin_ways 9 equal 3
end

test "order does not add solutions"
  use "004_coincomb2"
  Coins = array 1 2 5
  Coins unordered_coin_ways 5 equal 4
end

test "empty sum has one combination"
  use "004_coincomb2"
  Coins = array 4 9
  Coins unordered_coin_ways 0 equal 1
end

test "unreachable sum"
  use "004_coincomb2"
  Coins = array 4 6
  Coins unordered_coin_ways 7 equal 0
end
