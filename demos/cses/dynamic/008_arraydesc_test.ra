use testing

test "official example"
  use "008_arraydesc"
  Description = array 2 0 2
  Description descriptions 5 equal 3
end

test "one unknown value"
  use "008_arraydesc"
  Description = array 0
  Description descriptions 3 equal 3
end

test "fixed jump is too large"
  use "008_arraydesc"
  Description = array 1 3
  Description descriptions 3 equal 0
end

test "two unknown binary values"
  use "008_arraydesc"
  Description = array 0 0
  Description descriptions 2 equal 4
end
