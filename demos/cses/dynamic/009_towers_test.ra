use testing

test "official example"
  use "009_towers"
  Heights = array 2 6 1337
  Expected = array 8 2864 640403945
  Heights counting_towers equal Expected
end

test "first three heights"
  use "009_towers"
  Heights = array 1 2 3
  Expected = array 2 8 34
  Heights counting_towers equal Expected
end

test "queries may repeat"
  use "009_towers"
  Heights = array 3 1 3
  Expected = array 34 2 34
  Heights counting_towers equal Expected
end
