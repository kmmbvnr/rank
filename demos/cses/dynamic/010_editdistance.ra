rem CSES 1639: Edit Distance
rem https://cses.fi/problemset/task/1639

use io
use sequences

Left = stdin .word
Right = stdin .word
Left Right edit_distance print


rem Keep only the prior distance row.
fun edit_distance Left Right
  Width = Right len
  Previous = 0 to Width array

  Cols = Width + 1

  for A i in Left
    Current = array shape Cols fill 0
    Current 0 = i + 1

    for B j in Right
      if A equal B
        Current (j + 1) = Previous j
        continue
      end
      Delete = Previous (j + 1)
      Best = Delete (Current j) min
      Best = Best (Previous j) min
      Current (j + 1) = Best + 1
    end

    Previous = Current
  end

  return Previous Width
end
