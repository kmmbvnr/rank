use testing

test "official example"
  use "014_moneysums"
  Coins = array 4 2 5 2
  Expected = array 2 4 5 6 7 8 9 11 13
  Coins money_sums equal Expected
end

test "one coin"
  use "014_moneysums"
  Coins = array 7
  Coins money_sums equal array 7
end

test "equal coins remain distinct"
  use "014_moneysums"
  Coins = array 2 2 2
  Coins money_sums equal array 2 4 6
end

test "all consecutive sums"
  use "014_moneysums"
  Coins = array 1 2 3
  Coins money_sums equal array 1 2 3 4 5 6
end
