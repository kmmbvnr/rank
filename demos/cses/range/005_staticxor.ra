rem CSES 1650: Range Xor Queries
rem https://cses.fi/problemset/task/1650

use io
use algo
use bits
use ranges
use sequences

N = stdin .integer
Q = stdin .integer
Values = stdin .integer N array
Raw = stdin .integer (Q * 2) array
Queries = Raw (array Q 2) reshape

Values Queries range_xors print


rem Answer inclusive xor ranges.
fun range_xors Values Queries
  Tree = Values bxor segment
  Q = Queries len
  Answers = array shape Q pad 0

  for Query i in Queries
    unpack Left Right = Query
    L = Left - 1
    R = Right - 1
    Answers i = Tree L R query
  end

  return Answers
end
