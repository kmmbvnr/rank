rem CSES 2416
rem Increasing Array Queries
rem https://cses.fi/problemset/task/2416

use io
use algo
use graph
use sequences

N = stdin .integer
Q = stdin .integer
Values = stdin .integer N array
Raw = stdin .integer (Q * 2) array
Queries = Raw (array Q 2) reshape

Values Queries increase_costs print


rem Sum blocks of running maxima.
fun increase_costs Values Queries
  N = Values len
  Size = N + 1
  Next = array shape Size pad Size
  Stack = new stack

  for I in (N - 1) to 0 by -1
    for Stack len greater 0
      Top = Stack peek
      if Values Top greater Values I
        break
      end
      Stack pop
    end
    if Stack len greater 0
      Next I = Stack peek + 1
    end
    Stack push I
  end

  Cost = array shape Size pad 0
  for I in 0 until Size
    if I less N
      Span = Next I - I - 1
      Cost I = Span * Values I
    end
  end
  Path = Next Cost weighted

  Prefix = array shape Size pad 0
  Prefix (1 to N) = Values + scan
  Q = Queries len
  Answers = array shape Q pad 0
  for Query I in Queries
    First = Query 0 - 1
    Last = Query 1 - 1
    Start = First + 1
    Limit = Last + 1
    State = Path Start Limit upto
    Place = State .last - 1
    Raised = State .sum
    Span = Last - Place + 1
    Raised += Span * Values Place
    Original = Prefix (Last + 1)
    Original -= Prefix First
    Answers I = Raised - Original
  end
  return Answers
end
