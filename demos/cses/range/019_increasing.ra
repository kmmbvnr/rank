rem CSES 2416
rem Increasing Array Queries
rem https://cses.fi/problemset/task/2416

use io
use algo
use graph
use sequences

N = stdin .integer
Q = stdin .integer
Values = stdin .integer N array
Raw = stdin .integer (Q * 2) array
Queries = Raw reshape Q 2

Values Queries increase_costs print


rem Sum blocks of running maxima.
fun increase_costs Values Queries
  N = Values len
  Size = N + 1
  Next = array shape Size fill Size
  Stack = new stack

  for I in (N - 1) to 0 by -1
    for Stack len greater 0
      Top = Stack peek
      if Values Top greater Values I
        break
      end
      Stack pop
    end
    if Stack len greater 0
      Next I = Stack peek + 1
    end
    Stack push I
  end

  Cost = array shape Size fill 0
  for I in 0 till N
    Span = Next I - I - 1
    Cost I = Span * Values I
  end
  Path = Next Cost weighted

  Prefix = Values scan + with 0
  Answers = array shape (Queries len) fill 0
  for Query I in Queries
    unpack Start Limit = Query
    First = Start - 1
    Last = Limit - 1
    State = Path Start Limit upto
    Place = State .last - 1
    Raised = State .sum
    Span = Last - Place + 1
    Raised += Span * Values Place
    Original = Prefix Limit - Prefix First
    Answers I = Raised - Original
  end
  return Answers
end
