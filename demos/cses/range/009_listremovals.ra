rem CSES 1749: List Removals
rem https://cses.fi/problemset/task/1749

use io
use algo
use sequences

N = stdin .integer
Values = stdin .integer N array
Positions' = stdin .integer N

Values removals Positions print


rem Select by live prefix count.
fun Values removals Positions'
  N = Values len
  Alive = (array shape N fill 1) segment +
  Removed = array shape N fill 0

  for Order I in Positions
    Position = Alive firstatleast Order
    Removed I = Values Position
    Alive Position = 0
  end

  return Removed
end
