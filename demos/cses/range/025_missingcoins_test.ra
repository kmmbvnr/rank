use testing

test "official example"
  use "025_missingcoins"
  Values = array 2 9 1 2 7
  Queries = array shape 3 2
    2 4
    4 4
    1 5
  end
  Got = Values Queries missing_queries
  Got equal array 4 1 6
end

test "duplicates extend the prefix"
  use "025_missingcoins"
  Values = array 1 1 3 10
  Queries = array shape 3 2
    1 4
    4 4
    1 2
  end
  Got = Values Queries missing_queries
  Got equal array 6 1 3
end
