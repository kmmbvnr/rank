rem CSES 2184: Missing Coin Sum Queries
rem https://cses.fi/problemset/task/2184

use io
use algo
use sequences

N = stdin .integer
Q = stdin .integer
Values = stdin .integer N array
Raw = stdin .integer (Q * 2) array
Queries = Raw reshape Q 2

Values missing_queries Queries print


rem Grow the constructible prefix.
fun Values missing_queries Queries
  Data = Values wavelet
  return Data missing (Queries - 1)
end
