rem CSES 1649
rem Dynamic Range Minimum Queries
rem https://cses.fi/problemset/task/1649

use io
use algo
use sequences

N = stdin .integer
Q = stdin .integer
Values = stdin .integer N array
Raw = stdin .integer (Q * 3) array
Queries = Raw (array Q 3) reshape

Values Queries dynamic_mins print


rem Apply point assignments.
rem Answer inclusive one-based ranges.
fun dynamic_mins Values Queries
  Tree = Values segment min

  for Query in Queries
    unpack Type A B = Query
    if Type equal 1
      Tree (A - 1) = B
      continue
    end

    yield Tree (A - 1) (B - 1) query
  end
end
