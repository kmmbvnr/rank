use testing

test "official example"
  use "001_staticsum"
  Values = array 3 2 4 5 1 1 5 3
  Queries = array shape 4 2
    2 4
    5 6
    1 8
    3 3
  end
  Actual = Values Queries range_sums
  Actual equal array 11 2 24 4
end

test "single value and full range"
  use "001_staticsum"
  Values = array 9 -2 7
  Queries = array shape 3 2
    1 1
    3 3
    1 3
  end
  Actual = Values Queries range_sums
  Actual equal array 9 7 14
end
