use testing

test "overlapping queries"
  use "017_distinct"
  Values = array 3 2 3 1 2
  Queries = array shape 4 2
    1 3
    2 5
    3 3
    1 5
  end
  Actual = Values Queries distinct
  Actual equal array 2 3 1 3
end

test "all equal and all unique"
  use "017_distinct"
  Values = array 7 7 7 8 9
  Queries = array shape 3 2
    1 3
    1 5
    4 5
  end
  Actual = Values Queries distinct
  Actual equal array 1 3 2
end
