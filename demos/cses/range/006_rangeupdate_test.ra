use testing

test "official example"
  use "006_rangeupdate"
  Values = array 3 2 4 5 1 1 5 3
  Queries = array shape 4 4
    2 4 0 0
    1 2 5 1
    1 1 8 2
    2 4 0 0
  end
  Actual = Values Queries range_updates
  Actual equal array 5 8
end

test "update may reach the end"
  use "006_rangeupdate"
  Values = array 1 2 3
  Queries = array shape 5 4
    1 1 3 5
    2 1 0 0
    2 3 0 0
    1 2 2 -4
    2 2 0 0
  end
  Actual = Values Queries range_updates
  Actual equal array 6 8 3
end
