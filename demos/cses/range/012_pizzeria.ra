rem CSES 2206: Pizzeria Queries
rem https://cses.fi/problemset/task/2206

use io
use algo
use sequences

N = stdin .integer
Q = stdin .integer
Prices = stdin .integer N array
Queries = array shape Q 3 fill 0

for I in 0 till Q
  Type = stdin .integer
  Queries I 0 = Type
  Queries I 1 = stdin .integer
  if Type equal 1
    Queries I 2 = stdin .integer
  end
end

Prices Queries deliveries print


rem Split distance at the query point.
fun deliveries Prices Queries
  N = Prices len
  Indices = 0 till N array
  LeftPrices = Prices - Indices
  RightPrices = Prices + Indices
  FromLeft = LeftPrices segment min
  FromRight = RightPrices segment min
  Answers = array shape (Queries len) fill 0
  Count = 0

  for Query in Queries
    Type = Query 0
    Position = Query 1 - 1
    if Type equal 1
      Price = Query 2
      FromLeft Position = Price - Position
      FromRight Position = Price + Position
      continue
    end

    Left = FromLeft 0 Position query
    Left += Position
    Right = FromRight Position (N - 1) query
    Right -= Position
    Answers Count = Left Right min
    Count += 1
  end

  return Answers (0 till Count)
end
