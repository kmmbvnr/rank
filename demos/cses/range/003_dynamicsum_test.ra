use testing

test "official example"
  use "003_dynamicsum"
  Values = array 3 2 4 5 1 1 5 3
  Queries = array shape 3 3
    2 2 4
    1 3 1
    2 1 4
  end
  Values Queries dynamic_sums equal array 11 11
end

test "assignments replace rather than add"
  use "003_dynamicsum"
  Values = array 4 5 6
  Queries = array shape 4 3
    1 2 10
    2 2 2
    1 2 -3
    2 1 3
  end
  Values Queries dynamic_sums equal array 10 7
end
