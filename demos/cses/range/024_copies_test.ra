use testing

test "official example"
  use "024_copies"
  use algo
  Values = array 2 3 1 2 5
  Queries = new queue
  Queries push (array 3 1)
  Queries push (array 2 1 1 5)
  Queries push (array 2 2 1 5)
  Queries push (array 1 2 2 5)
  Queries push (array 2 1 1 5)
  Queries push (array 2 2 1 5)
  Actual = Values Queries copies
  Actual equal array 13 13 13 15
end

test "versions change independently"
  use "024_copies"
  use algo
  Values = array 1 2 3
  Queries = new queue
  Queries push (array 3 1)
  Queries push (array 1 1 1 9)
  Queries push (array 1 2 3 8)
  Queries push (array 3 2)
  Queries push (array 1 3 2 7)
  Queries push (array 2 1 1 3)
  Queries push (array 2 2 1 3)
  Queries push (array 2 3 1 3)
  Actual = Values Queries copies
  Actual equal array 14 11 16
end
