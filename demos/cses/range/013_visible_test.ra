use testing

test "official example"
  use "013_visible"
  Heights = array 4 1 2 2 3
  Queries = array shape 3 2
    1 5
    2 5
    3 4
  end
  Actual = Heights Queries visible
  Actual equal array 1 3 1
end

test "increasing and decreasing ranges"
  use "013_visible"
  Heights = array 1 2 3 3 2
  Queries = array shape 3 2
    1 5
    3 5
    4 5
  end
  Actual = Heights Queries visible
  Actual equal array 3 1 1
end
