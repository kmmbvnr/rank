rem CSES 1646: Static Range Sum Queries
rem https://cses.fi/problemset/task/1646

use io
use sequences

N = stdin .integer
Q = stdin .integer
Values = stdin .integer N array
Raw = stdin .integer (Q * 2) array
Queries = Raw (array Q 2) reshape

Values Queries range_sums print


rem Answer inclusive one-based ranges.
fun range_sums Values Queries
  Prefix = Values + scan with 0
  Left = Queries # 0
  Right = Queries # 1
  Before = Prefix (Left - 1)
  return Prefix Right - Before
end
