rem CSES 2166: Prefix Sum Queries
rem https://cses.fi/problemset/task/2166

use io
use algo
use sequences

N = stdin .integer
Q = stdin .integer
Values = stdin .integer N array
Raw = stdin .integer (Q * 3) array
Queries = Raw (array Q 3) reshape

Values Queries prefix_queries print


rem Query the built-in max-sum summary.
fun prefix_queries Values Queries
  Tree = Values segment maxsum

  for Query in Queries
    unpack Type A B = Query
    if Type equal 1
      Tree (A - 1) = B
      continue
    end

    Left = A - 1
    State = Tree Left (B - 1) query
    queue push State .prefix
  end

  return queue
end
