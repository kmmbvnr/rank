rem CSES 1739: Forest Queries II
rem https://cses.fi/problemset/task/1739

use io
use algo
use bits
use sequences
use text

N = stdin .integer
Q = stdin .integer
Grid = stdin .word N array
Queries = new queue
for I in 1 to Q
  Type = stdin .integer
  if Type equal 1
    Y = stdin .integer
    X = stdin .integer
    Queries push array Type Y X
  else
    Top = stdin .integer
    Left = stdin .integer
    Bottom = stdin .integer
    Right = stdin .integer
    Query = array shape 5
      Type Top Left Bottom Right
    end
    Queries push Query
  end
end

Grid Queries forest_updates print


rem Keep static and changed tree counts.
fun forest_updates Grid Queries
  Size = Grid len
  Side = Size + 1
  Trees = array shape Size Size fill 0
  Prefix = array shape Side Side fill 0

  Columns = 1 to Size

  for Row InitialRow in Grid
    Codes = Row codepoint rank 0
    Values = (46 - Codes) // 4
    Cells = Values array
    Trees InitialRow # = Cells
    Running = Cells + scan
    Above = Prefix InitialRow Columns
    Prefix (InitialRow + 1) Columns = Above + Running
  end

  Changes = new queue
  for Y in 0 to Size
    Changes push Side fenwick
  end

  Answers = array shape (Queries len) fill 0
  Count = 0
  for Query in Queries
    Type = Query 0
    if Type equal 1
      Y = Query 1
      X = Query 2
      ZeroY = Y - 1
      ZeroX = X - 1
      Old = Trees ZeroY ZeroX
      Delta = 1 - Old * 2
      Trees ZeroY ZeroX += Delta
      RowIndex = Y
      for RowIndex at most Size
        F = Changes RowIndex
        F X += Delta
        Step = RowIndex (-RowIndex) band
        RowIndex += Step
      end
      continue
    end

    Top = Query 1
    Left = Query 2
    Bottom = Query 3
    Right = Query 4
    Total = Prefix Bottom Right
    Prior = Top - 1
    Total -= Prefix Prior Right
    Before = Left - 1
    Total -= Prefix Bottom Before
    Total += Prefix Prior Before
    Total += Changes Bottom Right bit2sum
    Total -= Changes Prior Right bit2sum
    Total -= Changes Bottom Before bit2sum
    Total += Changes Prior Before bit2sum
    Answers Count = Total
    Count += 1
  end
  return Answers (0 till Count)
end


rem Sum a two-dimensional prefix.
fun bit2sum Rows Y X
  Total = 0
  for Y greater 0
    F = Rows Y
    Total += F sum X
    Y -= Y (-Y) band
  end
  return Total
end
