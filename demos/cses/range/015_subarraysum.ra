rem CSES 1190: Subarray Sum Queries
rem https://cses.fi/problemset/task/1190

use io
use algo
use sequences

N = stdin .integer
Q = stdin .integer
Values = stdin .integer N array
Raw = stdin .integer (Q * 2) array
Updates = Raw (array Q 2) reshape

Values Updates max_subarrays print


rem Report the best subarray or zero.
fun max_subarrays Values Updates
  Tree = Values maxsum segment
  Last = Values len - 1
  Q = Updates len
  Answers = array shape Q pad 0

  for Update I in Updates
    unpack Position Value = Update
    Tree (Position - 1) = Value
    State = Tree 0 Last query
    Answers I = State .best
  end

  return Answers
end
