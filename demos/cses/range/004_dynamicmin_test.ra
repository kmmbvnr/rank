use testing

test "official example"
  use "004_dynamicmin"
  Values = array 3 2 4 5 1 1 5 3
  Queries = array shape 3 3
    2 2 4
    1 3 1
    2 1 4
  end
  Actual = Values Queries dynamic_mins
  Actual equal array 2 1
end

test "updated minimum may disappear"
  use "004_dynamicmin"
  Values = array 8 1 6 3
  Queries = array shape 4 3
    2 1 4
    1 2 9
    2 1 4
    2 1 2
  end
  Actual = Values Queries dynamic_mins
  Actual equal array 1 3 8
end
