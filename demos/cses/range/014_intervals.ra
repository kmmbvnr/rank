rem CSES 3163: Range Interval Queries
rem https://cses.fi/problemset/task/3163

use io
use algo
use sequences

N = stdin .integer
Q = stdin .integer
Values = stdin .integer N array
Raw = stdin .integer (Q * 4) array
Queries = Raw reshape Q 4

Values Queries intervals print


rem Count each index-value rectangle.
fun intervals Values Queries
  Data = Values wavelet
  Answers = array shape (Queries len) fill 0
  for Query I in Queries
    unpack Left Right Low High = Query
    L = Left - 1
    R = Right - 1
    Answers I = Data L R Low High within
  end
  return Answers
end
