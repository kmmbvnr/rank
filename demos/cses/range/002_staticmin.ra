rem CSES 1647: Static Range Minimum Queries
rem https://cses.fi/problemset/task/1647

use io
use algo
use numbers
use sequences

N = stdin .integer
Q = stdin .integer
Values = stdin .integer N array
Raw = stdin .integer (Q * 2) array
Queries = Raw (array Q 2) reshape

Values Queries range_minimums print


rem Answer inclusive one-based ranges.
fun range_minimums Values Queries
  Tree = Values min segment
  Answers = array shape (Queries len) pad 0
  for Query i in Queries
    unpack Left Right = Query
    Answers i = Tree (Left - 1) (Right - 1) query
  end
  return Answers
end
