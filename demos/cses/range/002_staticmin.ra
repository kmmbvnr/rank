rem CSES 1647
rem Static Range Minimum Queries
rem https://cses.fi/problemset/task/1647

use io
use algo
use sequences

N = stdin .integer
Q = stdin .integer
Values = stdin .integer N array
Raw = stdin .integer (Q * 2) array
Queries = Raw reshape Q 2

Values Queries range_minimums print


rem Answer inclusive one-based ranges.
fun range_minimums Values Queries
  Tree = Values segment min
  Answers = array shape (Queries len) fill 0
  for Query i in Queries
    unpack Left Right = Query
    L = Left - 1
    Answers i = Tree L (Right - 1) query
  end
  return Answers
end
