rem CSES 1652: Forest Queries
rem https://cses.fi/problemset/task/1652

use io
use sequences
use text

N = stdin .integer
Q = stdin .integer
Grid = stdin .word N array
Raw = stdin .integer (Q * 4) array
Queries = Raw (array Q 4) reshape

Grid Queries forest_queries print


rem Build a two-dimensional prefix sum.
rem Answer inclusive rectangles.
fun forest_queries Grid Queries
  Size = Grid len
  Side = Size + 1
  Prefix = array shape Side Side pad 0

  for Row Y in Grid
    Codes = Row codepoint rank 0
    Trees = (46 - Codes) // 4
    Running = Trees + scan
    Columns = 1 to Size
    Above = Prefix Y Columns
    Current = Above + Running
    Prefix (Y + 1) Columns = Current
  end

  Q = Queries len
  Answers = array shape Q pad 0
  for Query I in Queries
    unpack Top Left Bottom Right = Query
    Answers I = Prefix Bottom Right
    Answers I -= Prefix (Top - 1) Right
    Before = Left - 1
    Answers I -= Prefix Bottom Before
    Answers I += Prefix (Top - 1) Before
  end
  return Answers
end
