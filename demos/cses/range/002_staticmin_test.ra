use testing

test "official example"
  use "002_staticmin"
  Values = array 3 2 4 5 1 1 5 3
  Queries = array shape 4 2
    2 4
    5 6
    1 8
    3 3
  end
  Actual = Values Queries range_minimums
  Actual equal array 2 1 1 4
end

test "overlapping sparse table blocks"
  use "002_staticmin"
  Values = array 8 6 7 5 3 0 9
  Queries = array shape 4 2
    1 1
    2 5
    4 7
    1 7
  end
  Actual = Values Queries range_minimums
  Actual equal array 8 3 0 0
end
