use testing

test "official example"
  use "007_forest"
  Grid = array shape 4
    ".*.." "*.**" "**.." "****"
  end
  Queries = array shape 3 4
    2 2 3 4
    3 1 3 1
    1 1 2 2
  end
  Actual = Grid Queries forest_queries
  Actual equal array 3 1 2
end

test "corners and complete grid"
  use "007_forest"
  Grid = array "*.." ".*." "..*"
  Queries = array shape 4 4
    1 1 3 3
    1 1 1 1
    1 3 3 3
    2 2 2 2
  end
  Actual = Grid Queries forest_queries
  Actual equal array 3 1 1 1
end
