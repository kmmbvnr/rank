rem CSES 1651: Range Update Queries
rem https://cses.fi/problemset/task/1651

use io
use algo
use sequences

N = stdin .integer
Q = stdin .integer
Values = stdin .integer N array
Queries = array shape Q 4 pad 0

for I in 0 until Q
  Type = stdin .integer
  Queries I 0 = Type
  Queries I 1 = stdin .integer
  if Type equal 1
    Queries I 2 = stdin .integer
    Queries I 3 = stdin .integer
  end
end

Values Queries range_updates print


rem Store only update differences.
rem Original values remain unchanged.
fun range_updates Values Queries
  Updates = Values len fenwick
  Q = Queries len
  Answers = array shape Q pad 0
  Count = 0

  for Query in Queries
    Type = Query 0
    if Type equal 1
      Left = Query 1 - 1
      Right = Query 2 - 1
      Change = Query 3
      Updates Left += Change
      if Right + 1 less Values len
        Updates (Right + 1) -= Change
      end
    else
      Position = Query 1 - 1
      Change = Updates sum Position
      Base = Values Position
      Answers Count = Base + Change
      Count += 1
    end
  end

  return Answers (0 until Count)
end
