use testing

test "official example"
  use "016_subarraysum2"
  Values = array 2 5 1 -2 3 -1 -7 1
  Queries = array shape 4 2
    2 4
    2 5
    6 7
    4 8
  end
  Actual = Values Queries range_max_sums
  Actual equal array 6 7 0 3
end

test "single positions and full range"
  use "016_subarraysum2"
  Values = array -2 4 -1 3
  Queries = array shape 3 2
    1 1
    2 2
    1 4
  end
  Actual = Values Queries range_max_sums
  Actual equal array 0 4 6
end
