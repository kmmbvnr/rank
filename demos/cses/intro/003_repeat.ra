rem CSES 1069: Repetitions
rem https://cses.fi/problemset/task/1069

use io
use sequences

Text = stdin .word

Text longest print


rem Find the longest run of one repeated character.
fun longest Text
  Chars = Text 1 window array
  Previous = Chars 1 shift with ""
  Changes = Chars not equal Previous
  Starts = Changes indices
  Total = Text len
  Ends = Starts -1 shift with Total
  Runs = Ends - Starts
  return Runs max
end
