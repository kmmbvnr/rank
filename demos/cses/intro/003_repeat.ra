rem CSES 1069: Repetitions
rem https://cses.fi/problemset/task/1069

use io
use sequences

Text = stdin .word

Text longest print


rem Find the longest run of one repeated character.
fun Text longest
  Chars = Text window 1 array
  Previous' = Chars shift 1 with ""
  Changes' = Chars not equal Previous
  Starts = Changes indices
  Ends' = Starts shift -1 with (Text len)
  Runs' = Ends - Starts
  return Runs max
end
