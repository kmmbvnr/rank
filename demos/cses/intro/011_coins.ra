rem CSES 1754: Coin Piles
rem https://cses.fi/problemset/task/1754

use io
use numbers

T = stdin .integer

for i in 1 to T
  A = stdin .integer
  B = stdin .integer

  if A B possible
    "YES" print
  else
    "NO" print
  end
end


rem Return true when both coin piles can be emptied.
fun possible A B
  Total = A + B
  Small = A min B
  Large = A max B

  Divisible = Total multiple by 3
  Balanced = Large at most 2 * Small

  return Divisible and Balanced
end
