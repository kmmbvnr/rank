rem CSES 1754: Coin Piles
rem https://cses.fi/problemset/task/1754

use io
use numbers

T = stdin .integer

for Step in 1 to T
  A = stdin .integer
  B = stdin .integer

  if A B possible
    "YES" print
  else
    "NO" print
  end
end


rem Return true when both coin piles can be emptied.
fun A B possible
  Total = A + B
  if Total mod 3 not equal 0
    return false
  end
  Small = A B min
  Large = A max B
  return Large at most 2 * Small
end
