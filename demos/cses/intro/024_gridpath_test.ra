use testing

test "official example"
  use "024_gridpath"
  Path = "??????R??????U??????????????????????????LD????D?"
  Path solve equal 201
end

test "fully specified Hamiltonian path"
  use "024_gridpath"
  Path = "RRRRRRDDDDDDLUUUUULDDDDDLUUUUULDDDDDLUUUUULDDDDD"
  Path solve equal 1
end

test "cannot leave the grid"
  use "024_gridpath"
  Path = "U???????????????????????????????????????????????"
  Path solve equal 0
end

test "cannot visit a cell twice"
  use "024_gridpath"
  Path = "RL??????????????????????????????????????????????"
  Path solve equal 0
end

test "cannot reach the destination early"
  use "024_gridpath"
  Path = "DDDDDD??????????????????????????????????????????"
  Path solve equal 0
end
