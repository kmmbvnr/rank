rem CSES 1092: Two Sets
rem https://cses.fi/problemset/task/1092

use io


N = stdin .integer


if N % 4 equal 1
  "NO" print
elif N % 4 equal 2
  "NO" print
else
  "YES" print

  if N % 4 equal 0
    N // 2 print
    N left print
    N // 2 print
    N right print
  else
    (N + 1) // 2 print
    N left print
    (N - 1) // 2 print
    N right print
  end
end


rem Generate the first equal-sum set.
fun left N
  if N % 4 equal 3
    yield 1
    yield 2
    I = 4
  else
    I = 1
  end

  for I at most N
    yield I
    yield I + 3
    I += 4
  end
end


rem Generate the second equal-sum set.
fun right N
  if N % 4 equal 3
    yield 3
    I = 5
  else
    I = 2
  end

  for I at most N
    yield I
    yield I + 1
    I += 4
  end
end
