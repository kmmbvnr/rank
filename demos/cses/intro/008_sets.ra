rem CSES 1092: Two Sets
rem https://cses.fi/problemset/task/1092

use io


N = stdin .integer


if N mod 4 equal 1 or N mod 4 equal 2
  "NO" print
else
  "YES" print

  if N mod 4 equal 0
    N // 2 print
    N left print
    N // 2 print
    N right print
  else
    (N + 1) // 2 print
    N left print
    (N - 1) // 2 print
    N right print
  end
end


rem Generate the first equal-sum set.
fun left N
  Start = 1
  if N mod 4 equal 3
    yield 1
    yield 2
    Start = 4
  end

  for I in Start to N by 4
    yield I
    yield I + 3
  end
end


rem Generate the second equal-sum set.
fun right N
  Start = 2
  if N mod 4 equal 3
    yield 3
    Start = 5
  end

  for I in Start to N by 4
    yield I
    yield I + 1
  end
end
