rem CSES 1755: Palindrome Reorder
rem https://cses.fi/problemset/task/1755

use algo
use io
use numbers
use sequences
use text

Text = stdin .word
Text palindrome print


rem Build an alphabetically deterministic palindrome rearrangement.
fun palindrome Text
  Counts = new counter
  Alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"

  for C in Text
    Counts add C
  end

  Odd = 0
  Middle = ""
  Left = ""

  for C in Alphabet
    Half = Counts C // 2

    if Counts C odd
      Odd += 1
      Middle = C
    end

    for # in 0 till Half
      Left += C
    end
  end

  if Odd greater 1
    return "NO SOLUTION"
  end

  Right = Left reverse
  return Left + Middle + Right
end
