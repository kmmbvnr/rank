use testing

test "official examples"
  use "011_coins"
  2 possible 1 equal true
  2 possible 2 equal false
  3 possible 3 equal true
end

test "unbalanced piles"
  use "011_coins"
  10 possible 1 equal false
end

test "zero piles"
  use "011_coins"
  0 possible 0 equal true
  0 possible 3 equal false
end
