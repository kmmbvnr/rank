rem CSES 1071: Number Spiral
rem https://cses.fi/problemset/task/1071

use io
use numbers

T = stdin .integer

for Step in 1 to T
  Y = stdin .integer
  X = stdin .integer
  Y spiral X print
end


rem Return the number at row Y and column X.
fun Y spiral X
  M = X max Y
  Answer = M * M - M + 1

  if M odd
    Answer += X - Y
  else
    Answer += Y - X
  end

  return Answer
end
