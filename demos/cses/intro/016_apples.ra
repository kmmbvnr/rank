rem CSES 1623: Apple Division
rem https://cses.fi/problemset/task/1623

use io
use numbers

N = stdin .integer
Weights = stdin .integer N array
Weights solve print


rem Find the minimum difference between the weights of two groups.
fun Weights solve
  Total = Weights sum
  N = Weights len

  return 1 divide (Weights 0)

  rem Try both groups for every apple after the first one.
  fun Pos divide Left
    if Pos equal N
      Difference = Total - 2 * Left
      return Difference abs
    end

    Weight = Weights Pos
    Next = Pos + 1

    Include = Next divide (Left + Weight)
    Exclude = Next divide Left
    return Include min Exclude
  end
end
