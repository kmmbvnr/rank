rem CSES 1072: Two Knights
rem https://cses.fi/problemset/task/1072

use io

N = stdin .integer

for K in 1 to N
  K knights print
end


rem Count nonattacking placements of two knights on a K by K board.
fun knights K
  Squares = K * K
  Total = Squares * (Squares - 1) // 2
  Attacking = 4 * (Squares - 3 * K + 2)

  return Total - Attacking
end
