rem CSES 3217: Knight Moves Grid
rem https://cses.fi/problemset/task/3217

use algo
use io
use sequences

N = stdin .integer
Distances = N solve

for Row in Distances
  Row print
end


rem Find every shortest distance with one breadth-first traversal of the board.
fun solve N
  DYs = array 1 1 -1 -1 2 2 -2 -2
  DXs = array 2 -2 2 -2 1 -1 1 -1

  Dist = array shape N N fill -1
  Dist 0 0 = 0

  Pending = new queue
  Pending push 0

  for Cell in Pending
    Y = Cell // N
    X = Cell mod N
    NextDist = Dist Y X + 1

    for DY k in DYs
      NY = Y + DY
      NX = X + DXs k

      if NY less 0 or NY at least N
        continue
      end
      if NX less 0 or NX at least N
        continue
      end
      if Dist NY NX not equal -1
        continue
      end

      Dist NY NX = NextDist
      Pending push NY * N + NX
    end
  end

  return Dist
end
