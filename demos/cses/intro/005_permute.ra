rem CSES 1070: Permutations
rem https://cses.fi/problemset/task/1070

use io
use ranges

N = stdin .integer

if N equal 1
  1 print
elif N less 4
  "NO SOLUTION" print
else
  N beautiful print
end


rem Generate all even values before all odd values for N at least 4.
fun beautiful N
  for I in 2 to N by 2
    yield I
  end

  for I in 1 to N by 2
    yield I
  end
end
