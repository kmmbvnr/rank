rem CSES 3311: Grid Coloring I
rem https://cses.fi/problemset/task/3311

use io
use numbers
use sequences

N = stdin .integer
M = stdin .integer
Grid = stdin .word N array
Answer = Grid solve

for Row in Answer
  Row print
end


rem Use disjoint two-color palettes on the two checkerboard parities.
fun solve Grid
  Rows = Grid len
  Answer = array shape Rows fill ""

  for Row i in Grid
    Colored = ""

    for Old j in Row
      Cell = i + j
      if Cell even
        Colored += (Old equal "A") "B" "A" choose
      else
        Colored += (Old equal "C") "D" "C" choose
      end
    end

    Answer i = Colored
  end

  return Answer
end
