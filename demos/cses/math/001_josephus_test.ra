use testing

test "official example"
  use "001_josephus"
  7 removed 1 equal 2
  7 removed 3 equal 6
  2 removed 2 equal 1
  1337 removed 1313 equal 1107
end

test "one child"
  use "001_josephus"
  1 removed 1 equal 1
end

test "odd circle wraps to first child"
  use "001_josephus"
  7 removed 4 equal 1
  7 removed 5 equal 5
end

test "large circle avoids simulation"
  use "001_josephus"
  1000000000 removed 1 equal 2
  N = 1000000000
  N removed N equal 926258177
end
