rem CSES 1079: Binomial Coefficients
rem https://cses.fi/problemset/task/1079

use algo
use io
use numbers
use sequences

N = stdin .integer
Raw = stdin .integer (N * 2) array
Queries = Raw reshape N 2

Queries binomials print


rem Reuse cached modular factorials.
fun binomials Queries
  Queue = new queue
  Mod = 1000000007

  for Query in Queries
    unpack A B = Query
    Value = A B Mod binomialmod
    Queue push Value
  end

  return Queue
end
