rem CSES 2185: Prime Multiples
rem https://cses.fi/problemset/task/2185

use bits
use io
use numbers

N = stdin .integer
K = stdin .integer
Primes = stdin .integer K array

N Primes divisible_count print


rem Apply inclusion-exclusion to primes.
fun divisible_count N Primes
  Subsets = 1 (Primes len) shl
  Answer = 0

  for Mask in 1 till Subsets
    Product = 1

    for Prime I in Primes
      if Mask I bit equal false
        continue
      end
      if Product greater N // Prime
        Product = N + 1
        break
      end
      Product *= Prime
    end

    if Product greater N
      continue
    end
    Part = N // Product
    if Mask popcount odd
      Answer += Part
    else
      Answer -= Part
    end
  end

  return Answer
end
