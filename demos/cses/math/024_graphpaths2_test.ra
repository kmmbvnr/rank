use testing

test "official example"
  use "024_graphpaths2"
  Edges = array shape 4 3
    1 2 5
    2 3 4
    3 1 1
    3 2 2
  end
  3 Edges 8 min_path equal 27
end

test "keeps large integer min-plus costs exact beside infinity"
  use "024_graphpaths2"
  Price = 9007199254740993
  Edges = array shape 3 3
    1 1 Price
    1 2 Price
    2 2 Price
  end
  2 Edges 2 min_path equal 18014398509481986
end

test "path must have exact length"
  use "024_graphpaths2"
  Edges = array shape 1 3
    1 2 7
  end
  2 Edges 1 min_path equal 7
  2 Edges 2 min_path equal -1
end

test "directed weighted cycle"
  use "024_graphpaths2"
  Edges = array shape 2 3
    1 2 5
    2 1 3
  end
  2 Edges 3 min_path equal 13
  2 Edges 2 min_path equal -1
end

test "parallel edge takes minimum"
  use "024_graphpaths2"
  Edges = array shape 2 3
    1 2 9
    1 2 4
  end
  2 Edges 1 min_path equal 4
end
