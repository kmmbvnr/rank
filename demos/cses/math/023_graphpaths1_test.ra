use testing

test "official example"
  use "023_graphpaths1"
  Edges = array shape 4 2
    1 2
    2 3
    3 1
    3 2
  end
  3 Edges 8 path_count equal 2
end

test "path must have exact length"
  use "023_graphpaths1"
  Edges = array shape 1 2
    1 2
  end
  2 Edges 1 path_count equal 1
  2 Edges 2 path_count equal 0
end

test "directed cycle"
  use "023_graphpaths1"
  Edges = array shape 2 2
    1 2
    2 1
  end
  2 Edges 5 path_count equal 1
  2 Edges 6 path_count equal 0
end

test "branching paths"
  use "023_graphpaths1"
  Edges = array shape 5 2
    1 2
    1 3
    2 4
    3 4
    2 3
  end
  4 Edges 2 path_count equal 2
  4 Edges 3 path_count equal 1
end
