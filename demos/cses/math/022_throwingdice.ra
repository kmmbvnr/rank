rem CSES 1096: Throwing Dice
rem https://cses.fi/problemset/task/1096

use io
use linalg
use numbers
use ranges

N = stdin .integer
N dice_ways print


rem Exponentiate the dice recurrence.
fun dice_ways N
  Mod = 1000000007
  Steps = array shape 6 6 pad 0

  for Column in 0 until 6
    Steps 0 Column = 1
  end
  for Row in 1 until 6
    Steps Row (Row - 1) = 1
  end

  Result = 6 identity
  for N greater 0
    if N odd
      Result = Result Steps matmul % Mod
    end
    Steps = Steps Steps matmul % Mod
    N //= 2
  end

  return Result 0 0
end


rem Construct an identity matrix.
fun identity Size
  Result = array shape Size Size pad 0
  for I in 0 until Size
    Result I I = 1
  end
  return Result
end
