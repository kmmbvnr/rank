rem CSES 1096: Throwing Dice
rem https://cses.fi/problemset/task/1096

use io
use linalg
use numbers

N = stdin .integer
N dice_ways print


rem Exponentiate the dice recurrence.
fun N dice_ways
  Mod = 1000000007
  Steps = array shape 6 6 fill 0

  for Column in 0 till 6
    Steps 0 Column = 1
  end
  for Row in 1 till 6
    Steps Row (Row - 1) = 1
  end

  Power = Steps matpow N mod Mod
  return Power 0 0
end
