rem CSES 1726: Moving Robots
rem https://cses.fi/problemset/task/1726

use io
use linalg
use numbers
use sequences

Steps = stdin .integer
Steps empty_text print


rem Format the expected empty cells.
fun Steps empty_text
  Expected = Steps empty_cells
  return Expected text ".6f"
end


rem Combine all absence chances.
fun Steps empty_cells
  Move = 8 transition_matrix
  Power = Move matrix_power Steps
  Absence' = 1.0 - (Power transpose)
  Empty' = Absence reduce * axis 1
  return Empty sum
end


rem Build the board transition matrix.
fun Board transition_matrix
  Cells = Board ** 2
  Move = array shape Cells Cells fill 0.0

  for Y in 0 till Board
    for X in 0 till Board
      Degree = 4
      L = Board - 1
      if X equal 0 or X equal L
        Degree -= 1
      end
      if Y equal 0 or Y equal L
        Degree -= 1
      end

      From = Y * Board + X
      for DY in -1 to 1
        for DX in -1 to 1
          Distance = DX abs + (DY abs)
          if Distance not equal 1
            continue
          end
          NX = X + DX
          NY = Y + DY
          if NX less 0 or NX greater L
            continue
          end
          if NY less 0 or NY greater L
            continue
          end
          To = NY * Board + NX
          Move From To = 1.0 / Degree
        end
      end
    end
  end

  return Move
end


rem Raise a real square matrix.
fun Base matrix_power Exponent
  Size = Base len
  Result = Size identity_real

  for Exponent greater 0
    if Exponent odd
      Result = Result matmul Base
    end
    Base = Base matmul Base
    Exponent //= 2
  end

  return Result
end


rem Construct a real identity matrix.
fun Size identity_real
  Result = array shape Size Size fill 0.0
  for I in 0 till Size
    Result I I = 1.0
  end
  return Result
end
