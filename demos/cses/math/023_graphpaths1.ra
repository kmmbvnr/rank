rem CSES 1723: Graph Paths I
rem https://cses.fi/problemset/task/1723

use io
use linalg
use numbers
use sequences

Nodes = stdin .integer
M = stdin .integer
Length = stdin .integer
Raw = stdin .integer (M * 2) array
Edges = Raw (array M 2) reshape
Nodes Edges Length path_count print


rem Count fixed-length walks by powers.
fun path_count Nodes Edges Length
  Mod = 1000000007
  Paths = array shape Nodes Nodes pad 0
  for Edge in Edges
    Paths unpack (Edge - 1) += 1
  end

  Power = Paths Length Mod matrix_power
  return Power 0 (Nodes - 1)
end


rem Raise a matrix modulo Mod.
fun matrix_power Base Exponent Mod
  Size = Base len
  Result = Size identity

  for Exponent greater 0
    if Exponent odd
      Result = Result Base matmul % Mod
    end
    Base = Base Base matmul % Mod
    Exponent //= 2
  end

  return Result
end


rem Construct an identity matrix.
fun identity Size
  Result = array shape Size Size pad 0
  for I in 0 until Size
    Result I I = 1
  end
  return Result
end
