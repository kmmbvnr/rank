rem CSES 1723: Graph Paths I
rem https://cses.fi/problemset/task/1723

use io
use linalg
use numbers
use sequences

Nodes = stdin .integer
M = stdin .integer
Length = stdin .integer
Raw' = stdin .integer (M * 2) array
Edges = Raw reshape M 2
Nodes Edges Length path_count print


rem Count fixed-length walks by powers.
fun Nodes Edges Length path_count
  Mod = 1000000007
  Paths = array shape Nodes Nodes fill 0
  for Edge in Edges
    Paths unpack (Edge - 1) += 1
  end

  Power = Paths matpow Length mod Mod
  return Power 0 (Nodes - 1)
end
