rem CSES 1724: Graph Paths II
rem https://cses.fi/problemset/task/1724

use io
use numbers
use sequences

Nodes = stdin .integer
M = stdin .integer
Length = stdin .integer
Raw' = stdin .integer (M * 3) array
Edges = Raw reshape M 3
Answer = Nodes Edges Length min_path
Answer print


rem Find an exact-length minimum walk.
fun Nodes Edges Length min_path
  Paths = array shape Nodes Nodes fill infinity
  for Edge in Edges
    unpack From To Cost = Edge
    I = From - 1
    J = To - 1
    Paths I J = (Paths I J) min Cost
  end

  Power = Paths minplus_power Length
  Answer = Power 0 (Nodes - 1)
  if Answer equal infinity
    return -1
  end
  return Answer
end


rem Raise a min-plus matrix.
fun Base minplus_power Exponent
  Size = Base len
  Result = Size minplus_identity

  for Exponent greater 0
    if Exponent odd
      Result = Result minplus Base
    end
    Base = Base minplus Base
    Exponent //= 2
  end

  return Result
end


rem Multiply min-plus matrices.
fun Left minplus Right
  Size = Left len
  Result = array shape Size Size fill infinity

  for K in 0 till Size
    Column' = Left # K
    Row' = Right K
    Candidate' = Column Row outer +
    Result = Result min Candidate
  end

  return Result
end


rem Construct a min-plus identity.
fun Size minplus_identity
  Result = array shape Size Size fill infinity
  for I in 0 till Size
    Result I I = 0
  end
  return Result
end
