use testing

test "official example"
  use "025_linearequations"
  A = array shape 3 4
    2 0 1 7
    1 2 0 0
    1 3 1 2
  end
  Expected = array 2 1000000006 3
  3 3 A solve_mod equal Expected
end

test "dependent equations"
  use "025_linearequations"
  A = array shape 2 3
    1 1 3
    2 2 6
  end
  2 2 A solve_mod equal array 3 0
end

test "inconsistent equations"
  use "025_linearequations"
  A = array shape 2 3
    1 1 3
    1 1 4
  end
  2 2 A solve_mod equal array -1
end

test "free leading variable"
  use "025_linearequations"
  A = array shape 1 3
    0 2 6
  end
  1 2 A solve_mod equal array 0 3
end
