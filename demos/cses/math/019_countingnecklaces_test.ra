use testing

test "official example"
  use "019_countingnecklaces"
  4 necklaces 3 equal 24
end

test "one pearl"
  use "019_countingnecklaces"
  1 necklaces 7 equal 7
end

test "binary necklaces"
  use "019_countingnecklaces"
  3 necklaces 2 equal 4
  6 necklaces 2 equal 14
end

test "ten pearls"
  use "019_countingnecklaces"
  10 necklaces 3 equal 5934
end
