rem CSES 2417: Counting Coprime Pairs
rem https://cses.fi/problemset/task/2417

use algo
use bits
use io
use numbers
use ranges
use sequences

N = stdin .integer
Values = stdin .integer N

Values coprime_pairs print


rem Count earlier coprimes by exclusion.
fun coprime_pairs Values
  Counts = new counter
  Answer = 0
  Seen = 0

  for Value in Values
    Factors = Value factors unique array
    Size = Factors len
    Subsets = 1 Size shl
    NotCoprime = 0

    for Mask in 1 until Subsets
      Product = 1
      for I in 0 until Size
        if Mask I bit
          Product *= Factors I
        end
      end

      Previous = Counts Product
      if Mask popcount odd
        NotCoprime += Previous
      else
        NotCoprime -= Previous
      end
      Counts add Product
    end

    Answer += Seen - NotCoprime
    Seen += 1
  end

  return Answer
end
