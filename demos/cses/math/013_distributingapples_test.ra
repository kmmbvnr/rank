use testing

test "official example"
  use "013_distributingapples"
  3 2 distributions equal 6
end

test "one child receives everything"
  use "013_distributingapples"
  1 100 distributions equal 1
end

test "one apple chooses a child"
  use "013_distributingapples"
  100 1 distributions equal 100
end

test "balanced counts reach the limit"
  use "013_distributingapples"
  3 3 distributions equal 10
  Actual = 1000000 1000000 distributions
  Actual equal 96075800
end
