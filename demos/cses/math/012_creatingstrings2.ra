rem CSES 1715: Creating Strings II
rem https://cses.fi/problemset/task/1715

use algo
use io
use numbers
use ranges
use sequences

Text = stdin .word
Text string_count print


rem Divide by repeated letter counts.
fun string_count Text
  Mod = 1000000007
  Length = Text len
  Fact = array shape (Length + 1) pad 1
  Counts = new counter

  for I in 1 to Length
    Fact I = Fact (I - 1) * I % Mod
  end
  for Letter in Text
    Counts add Letter
  end

  Answer = Fact Length
  Alphabet = "abcdefghijklm"
  Alphabet += "nopqrstuvwxyz"
  for Letter in Alphabet
    Repeats = Counts Letter
    Denom = Fact Repeats
    Inverse = Denom (Mod - 2) Mod powmod
    Answer = Answer * Inverse % Mod
  end

  return Answer
end
