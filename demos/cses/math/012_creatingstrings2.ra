rem CSES 1715: Creating Strings II
rem https://cses.fi/problemset/task/1715

use algo
use io
use numbers
use sequences

Text = stdin .word
Text string_count print


rem Divide by repeated letter counts.
fun string_count Text
  Mod = 1000000007
  Length = Text len
  Size = Length + 1
  Fact = array shape Size fill 1
  Counts = new counter

  for I in 1 to Length
    Prev = I - 1
    Fact I = Fact Prev * I mod Mod
  end
  for Letter in Text
    Counts add Letter
  end

  Answer = Fact Length
  InvExp = Mod - 2
  Alphabet = "abcdefghijklm"
  Alphabet += "nopqrstuvwxyz"
  for Letter in Alphabet
    Repeats = Counts Letter
    if Repeats at most 1
      continue
    end
    Denom = Fact Repeats
    Inverse = Denom InvExp Mod powmod
    Answer = Answer * Inverse mod Mod
  end

  return Answer
end
