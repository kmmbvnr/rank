use testing

test "official example"
  use "002_exponentiation"
  3 power 4 equal 81
  2 power 8 equal 256
  123 power 123 equal 921450052
end

test "zero exponent"
  use "002_exponentiation"
  987654321 power 0 equal 1
end

test "zero to zero is one"
  use "002_exponentiation"
  0 power 0 equal 1
end

test "reduces large powers"
  use "002_exponentiation"
  Base = 1000000000
  Exponent = 1000000000
  Actual = Base power Exponent
  Actual equal 312556845
end
