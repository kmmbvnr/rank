rem CSES 1729: Stick Game
rem https://cses.fi/problemset/task/1729

use algo
use io
use sequences
use text

N = stdin .integer
K = stdin .integer
Moves = stdin .integer K array
N Moves stick_game print


rem Gather all possible predecessors.
fun stick_game N Moves
  Winning = array shape (N + 1) fill false

  for Sticks in 1 to N
    Available = Moves at most Sticks
    Legal = Moves Available
    Previous = Sticks - Legal
    Losing = not Winning Previous
    Win = Losing any

    Winning Sticks = Win
    Outcome = Win "W" "L" choose
    queue push Outcome
  end

  return queue "" join
end
