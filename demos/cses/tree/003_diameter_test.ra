use testing

test "official example"
  use "003_diameter"
  use graph
  use sequences
  Tree = new graph (1 to 5) .undirected
  Edges = array shape 4 2
    1 2
    1 3
    3 4
    3 5
  end
  Tree add Edges
  Tree tree_diameter equal 3
end

test "single node"
  use "003_diameter"
  use graph
  use sequences
  Tree = new graph (array 1) .undirected
  Tree tree_diameter equal 0
end

test "path diameter is every edge"
  use "003_diameter"
  use graph
  use sequences
  Tree = new graph (1 to 7) .undirected
  for Node in 1 until 7
    Tree add Node (Node + 1)
  end
  Tree tree_diameter equal 6
end

test "star diameter crosses its center"
  use "003_diameter"
  use graph
  use sequences
  Tree = new graph (1 to 6) .undirected
  for Node in 2 to 6
    Tree add 1 Node
  end
  Tree tree_diameter equal 2
end
