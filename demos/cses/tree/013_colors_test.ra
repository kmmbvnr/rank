use testing

test "official example"
  use "013_colors"
  use algo
  use graph
  use sequences
  Tree = new graph (1 to 5) .undirected
  Edges = array shape 4 2
    1 2
    1 3
    3 4
    3 5
  end
  Tree add Edges
  Rooted = Tree root 1
  Colors = array 2 3 2 2 1
  Actual = Colors distinct_colors Rooted
  Actual equal array 3 1 2 1 1
end

test "one node has one color"
  use "013_colors"
  use algo
  use graph
  use sequences
  Nodes = array 1
  Tree = new graph Nodes .undirected
  Rooted = Tree root 1
  Colors = array 42
  Actual = Colors distinct_colors Rooted
  Actual equal array 1
end

test "equal colors stay distinct once"
  use "013_colors"
  use algo
  use graph
  use sequences
  Tree = new graph (1 to 4) .undirected
  Tree add 1 2
  Tree add 2 3
  Tree add 3 4
  Rooted = Tree root 1
  Colors = array 7 7 7 7
  Actual = Colors distinct_colors Rooted
  Actual equal array 1 1 1 1
end

test "branches merge overlapping colors"
  use "013_colors"
  use algo
  use graph
  use sequences
  Tree = new graph (1 to 7) .undirected
  Edges = array shape 6 2
    1 2
    1 3
    2 4
    2 5
    3 6
    3 7
  end
  Tree add Edges
  Rooted = Tree root 1
  Colors = array 1 2 2 3 1 3 4
  Actual = Colors distinct_colors Rooted
  Actual equal array 4 3 3 1 1 1 1
end
