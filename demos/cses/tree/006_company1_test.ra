use testing

test "official example"
  use "006_company1"
  use graph
  use sequences
  Bosses = array 1 1 3 3
  Company = Bosses prepare_company
  Company 4 1 ancestor equal 3
  Company 4 2 ancestor equal 1
  Missing = Company 4 3 ancestor default -1
  Missing equal -1
end

test "zero levels keeps employee"
  use "006_company1"
  use graph
  use sequences
  Bosses = array 1 1 2
  Company = Bosses prepare_company
  Company 4 0 ancestor equal 4
end

test "chain supports every depth"
  use "006_company1"
  use graph
  use sequences
  Bosses = array 1 2 3 4
  Company = Bosses prepare_company
  Company 5 4 ancestor equal 1
  Missing = Company 5 5 ancestor default -1
  Missing equal -1
end

test "branches keep their own ancestors"
  use "006_company1"
  use graph
  use sequences
  Bosses = array 1 1 2 2 3 3
  Company = Bosses prepare_company
  Company 5 1 ancestor equal 2
  Company 7 2 ancestor equal 1
end
