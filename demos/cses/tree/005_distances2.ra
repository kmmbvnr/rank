rem CSES 1133: Tree Distances II
rem https://cses.fi/problemset/task/1133

use graph
use io
use sequences

N = stdin .integer
Tree = new graph (1 to N) .undirected
for i in 1 till N
  A = stdin .integer
  B = stdin .integer
  Tree add A B
end
Tree distance_sums print


rem Reroot one known distance sum.
fun distance_sums Tree
  Walk = Tree 1 dfs
  Order = Walk .order
  Parents = Walk .parent
  Distances = Walk .distance

  N = Tree len
  Sizes = array shape (N + 1) fill 1
  RootSum = 0
  for Node in Order
    RootSum += Distances Node
  end

  Last = Order len - 1
  for Node in Order (Last to 1 by -1)
    Parent = Parents Node
    Sizes Parent += Sizes Node
  end

  Result = array shape (N + 1) fill 0
  Result 1 = RootSum
  Total = Order len
  for Node in Order (1 till Total)
    Parent = Parents Node
    Diff = 2 * Sizes Node
    Result Node = Result Parent + N - Diff
  end
  return Result drop 1
end
