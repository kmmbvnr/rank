rem CSES 1132: Tree Distances I
rem https://cses.fi/problemset/task/1132

use graph
use io
use sequences

N = stdin .integer
Tree = new graph (1 to N) .undirected
for i in 1 till N
  A = stdin .integer
  B = stdin .integer
  Tree add A B
end
Tree tree_distances print


rem Compare distances from both ends.
fun tree_distances Tree
  First = Tree 1 bfs
  A = First .order last
  FromA = Tree A bfs
  B = FromA .order last
  FromB = Tree B bfs

  N = Tree len
  Result = array shape N fill 0
  for Node i in 1 to N
    Left = FromA .distance Node
    Right = FromB .distance Node
    Result i = Left Right max
  end
  return Result
end
