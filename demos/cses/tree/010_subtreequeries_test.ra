use testing

test "official example"
  use "010_subtreequeries"
  use algo
  use graph
  use ranges
  use sequences
  Graph = new graph (1 to 5) .undirected
  Edges = array shape 4 2
    1 2
    1 3
    3 4
    3 5
  end
  Graph add Edges
  Values = array 4 2 5 2 1
  Queries = array shape 3 3
    2 3 0
    1 5 3
    2 3 0
  end
  Rooted = Graph 1 root
  Actual = Values Rooted Queries subtree
  Actual equal (array 8 10)
end

test "root query sums every node"
  use "010_subtreequeries"
  use algo
  use graph
  use ranges
  use sequences
  Graph = new graph (1 to 3) .undirected
  Graph add 1 2
  Graph add 1 3
  Rooted = Graph 1 root
  Query = array shape 1 3
    2 1 0
  end
  Values = array 2 4 8
  Actual = Values Rooted Query subtree
  Actual equal (array 14)
end

test "leaf update affects its ancestors"
  use "010_subtreequeries"
  use algo
  use graph
  use ranges
  use sequences
  Graph = new graph (1 to 3) .undirected
  Graph add 1 2
  Graph add 2 3
  Rooted = Graph 1 root
  Queries = array shape 3 3
    1 3 7
    2 2 0
    2 3 0
  end
  Values = array 1 2 3
  Actual = Values Rooted Queries subtree
  Actual equal (array 9 7)
end

test "chosen root defines the subtree"
  use "010_subtreequeries"
  use algo
  use graph
  use ranges
  use sequences
  Graph = new graph (1 to 3) .undirected
  Graph add 1 2
  Graph add 2 3
  Rooted = Graph 3 root
  Query = array shape 1 3
    2 2 0
  end
  Values = array 5 6 7
  Actual = Values Rooted Query subtree
  Actual equal (array 11)
end
