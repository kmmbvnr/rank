use testing

test "official example"
  use "005_distances2"
  use graph
  use sequences
  Tree = new graph (1 to 5) .undirected
  Edges = array shape 4 2
    1 2
    1 3
    3 4
    3 5
  end
  Tree add Edges
  Actual = Tree distance_sums
  Actual equal array 6 9 5 8 8
end

test "single node has zero sum"
  use "005_distances2"
  use graph
  use sequences
  Tree = new graph (array 1) .undirected
  Tree distance_sums equal array 0
end

test "path sums are symmetric"
  use "005_distances2"
  use graph
  use sequences
  Tree = new graph (1 to 5) .undirected
  for Node in 1 until 5
    Tree add Node (Node + 1)
  end
  Actual = Tree distance_sums
  Actual equal array 10 7 6 7 10
end

test "star center has the smallest sum"
  use "005_distances2"
  use graph
  use sequences
  Tree = new graph (1 to 5) .undirected
  for Node in 2 to 5
    Tree add 1 Node
  end
  Actual = Tree distance_sums
  Actual equal array 4 7 7 7 7
end
