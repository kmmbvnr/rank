use testing

test "official example"
  use "016_fixedpaths2"
  use graph
  use sequences
  Tree = new graph (1 to 5) .undirected
  Edges = array shape 4 2
    1 2
    2 3
    3 4
    3 5
  end
  Tree add Edges
  Tree 2 3 count_paths equal 6
end

test "single vertex has no pair"
  use "016_fixedpaths2"
  use graph
  use sequences
  Tree = new graph (array 1) .undirected
  Tree 1 4 count_paths equal 0
end

test "whole path range counts all pairs"
  use "016_fixedpaths2"
  use graph
  use sequences
  Tree = new graph (1 to 4) .undirected
  Tree add 1 2
  Tree add 2 3
  Tree add 3 4
  Tree 1 3 count_paths equal 6
end

test "equal bounds select one distance"
  use "016_fixedpaths2"
  use graph
  use sequences
  Tree = new graph (1 to 5) .undirected
  Tree add 1 2
  Tree add 1 3
  Tree add 1 4
  Tree add 1 5
  Tree 2 2 count_paths equal 6
end
