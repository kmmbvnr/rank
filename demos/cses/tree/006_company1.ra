rem CSES 1687: Company Queries I
rem https://cses.fi/problemset/task/1687

use graph
use io

N = stdin .integer
Q = stdin .integer
Bosses = stdin .integer (N - 1) array
Company = Bosses prepare_company
for i in 1 to Q
  X = stdin .integer
  K = stdin .integer
  Boss = Company X K ancestor default -1
  Boss print
end


rem Root the hierarchy for fast jumps.
fun Bosses prepare_company
  N = Bosses len + 1
  Tree = new graph (1 to N) .undirected
  for Boss i in Bosses
    Employee = i + 2
    Tree add Boss Employee
  end
  return Tree root 1
end
