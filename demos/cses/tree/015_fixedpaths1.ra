rem CSES 2080: Fixed-Length Paths I
rem https://cses.fi/problemset/task/2080

use graph
use io
use sequences

N = stdin .integer
K = stdin .integer
Tree = new graph (1 to N) .undirected
for i in 1 till N
  A = stdin .integer
  B = stdin .integer
  Tree add A B
end
Tree count_paths K print


rem Count unordered pairs K edges apart.
fun Tree count_paths K
  return (Tree pathlengths equal K) count
end
