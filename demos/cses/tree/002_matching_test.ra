use testing

test "official example"
  use "002_matching"
  use graph
  use ranges
  use sequences
  Tree = new graph (1 to 5) .undirected
  Edges = array shape 4 2
    1 2
    1 3
    3 4
    3 5
  end
  Tree add Edges
  Tree tree_matching equal 2
end

test "single node"
  use "002_matching"
  use graph
  use ranges
  use sequences
  Tree = new graph (array 1) .undirected
  Tree tree_matching equal 0
end

test "path uses alternating edges"
  use "002_matching"
  use graph
  use ranges
  use sequences
  Tree = new graph (1 to 6) .undirected
  for Node in 1 until 6
    Tree add Node (Node + 1)
  end
  Tree tree_matching equal 3
end

test "star matches one edge"
  use "002_matching"
  use graph
  use ranges
  use sequences
  Tree = new graph (1 to 6) .undirected
  for Node in 2 to 6
    Tree add 1 Node
  end
  Tree tree_matching equal 1
end
