use testing

test "official example"
  use "015_fixedpaths1"
  use graph
  use sequences
  Tree = new graph (1 to 5) .undirected
  Edges = array shape 4 2
    1 2
    2 3
    3 4
    3 5
  end
  Tree add Edges
  Tree 2 count_paths equal 4
end

test "single vertex has no pair"
  use "015_fixedpaths1"
  use graph
  use sequences
  Tree = new graph (array 1) .undirected
  Tree 1 count_paths equal 0
end

test "path counts exact distances"
  use "015_fixedpaths1"
  use graph
  use sequences
  Tree = new graph (1 to 4) .undirected
  Tree add 1 2
  Tree add 2 3
  Tree add 3 4
  Tree 1 count_paths equal 3
  Tree 3 count_paths equal 1
end

test "star pairs meet through center"
  use "015_fixedpaths1"
  use graph
  use sequences
  Tree = new graph (1 to 5) .undirected
  Tree add 1 2
  Tree add 1 3
  Tree add 1 4
  Tree add 1 5
  Tree 2 count_paths equal 6
end
