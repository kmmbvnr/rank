use testing

test "official example"
  use "014_centroid"
  use graph
  use ranges
  use sequences
  Tree = new graph (1 to 5) .undirected
  Tree add 1 2
  Tree add 2 3
  Tree add 3 4
  Tree add 3 5
  Rooted = Tree 1 root
  Tree Rooted centroid equal 3
end

test "single node is its centroid"
  use "014_centroid"
  use graph
  use sequences
  Nodes = array 1
  Tree = new graph Nodes .undirected
  Rooted = Tree 1 root
  Tree Rooted centroid equal 1
end

test "star center is its centroid"
  use "014_centroid"
  use graph
  use ranges
  use sequences
  Tree = new graph (1 to 6) .undirected
  for Node in 2 to 6
    Tree add 1 Node
  end
  Rooted = Tree 1 root
  Tree Rooted centroid equal 1
end

test "even path chooses one centroid"
  use "014_centroid"
  use graph
  use ranges
  use sequences
  Tree = new graph (1 to 4) .undirected
  Tree add 1 2
  Tree add 2 3
  Tree add 3 4
  Rooted = Tree 1 root
  Tree Rooted centroid equal 2
end
