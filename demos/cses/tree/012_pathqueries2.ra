rem CSES 2134: Path Queries II
rem https://cses.fi/problemset/task/2134

use algo
use graph
use io
use sequences

N = stdin .integer
Q = stdin .integer
Values = stdin .integer N array
Graph = new graph (1 to N) .undirected
for i in 1 until N
  A = stdin .integer
  B = stdin .integer
  Graph add A B
end
RawQueries = stdin .integer (Q * 3) array
Queries = RawQueries (array Q 3) reshape

Rooted = Graph 1 root
Answers = Values Rooted Queries maximums
Answers print


rem Query heavy segments of each path.
fun maximums Values Rooted Queries
  Entry = Rooted .entry
  Flat = array shape (Values len) fill 0
  for Node in Rooted .order
    Pos = Entry Node
    Flat Pos = Values (Node - 1)
  end
  Maxima = Flat max segment
  Answers = new queue

  for Query in Queries
    unpack Type A B = Query
    if Type equal 1
      Pos = Entry A
      Maxima Pos = B
    else
      Part = Rooted Maxima A B path_max
      Answers push Part
    end
  end
  return Answers
end


rem Climb one heavy path at a time.
fun path_max Rooted Maxima A B
  Heads = Rooted .head
  Depths = Rooted .depth
  Parents = Rooted .parent
  Entry = Rooted .entry
  Position = Entry A
  Best = Maxima Position
  HeadA = Heads A
  HeadB = Heads B

  for HeadA not equal HeadB
    if Depths HeadA less Depths HeadB
      Swap = A
      A = B
      B = Swap
      HeadA = Heads A
      HeadB = Heads B
    end
    First = Entry HeadA
    Last = Entry A
    Part = Maxima First Last query
    Best = Best Part max
    A = Parents HeadA
    HeadA = Heads A
  end

  PosA = Entry A
  PosB = Entry B
  First = PosA PosB min
  Last = PosA PosB max
  Part = Maxima First Last query
  return Best Part max
end
