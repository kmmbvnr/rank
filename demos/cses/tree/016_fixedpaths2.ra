rem CSES 2081: Fixed-Length Paths II
rem https://cses.fi/problemset/task/2081

use graph
use io
use sequences

N = stdin .integer
Low = stdin .integer
High = stdin .integer
Tree = new graph (1 to N) .undirected
for i in 1 till N
  A = stdin .integer
  B = stdin .integer
  Tree add A B
end
Tree Low High count_paths print


rem Count pairs within a distance range.
fun Tree Low High count_paths
  return (Tree pathlengths) Low High count_lengths
end


rem Keep the native snapshot available to planned comparisons.
fun Lengths' Low High count_lengths
  Mask' = (Lengths at least Low) and (Lengths at most High)
  return Mask count
end
