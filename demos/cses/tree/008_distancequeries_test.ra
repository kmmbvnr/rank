use testing

test "official example"
  use "008_distancequeries"
  use graph
  use ranges
  Tree = new graph (1 to 5) .undirected
  Edges = array shape 4 2
    1 2
    1 3
    3 4
    3 5
  end
  Tree add Edges
  Rooted = Tree 1 root
  Rooted 1 3 distance equal 1
  Rooted 2 5 distance equal 3
  Rooted 1 4 distance equal 2
end

test "same node is zero edges away"
  use "008_distancequeries"
  use graph
  Tree = new graph (array 1) .undirected
  Rooted = Tree 1 root
  Rooted 1 1 distance equal 0
end

test "path distance is its difference"
  use "008_distancequeries"
  use graph
  use ranges
  Tree = new graph (1 to 6) .undirected
  for Node in 1 until 6
    Tree add Node (Node + 1)
  end
  Rooted = Tree 3 root
  Rooted 2 6 distance equal 4
end

test "distance ignores selected root"
  use "008_distancequeries"
  use graph
  use ranges
  Tree = new graph (1 to 4) .undirected
  Tree add 1 2
  Tree add 1 3
  Tree add 1 4
  Rooted = Tree 4 root
  Rooted 2 3 distance equal 2
end
