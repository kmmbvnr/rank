use testing

test "official example"
  use "012_pathqueries2"
  use algo
  use graph
  use numbers
  use sequences
  Graph = new graph (1 to 5) .undirected
  Edges = array shape 4 2
    1 2
    1 3
    2 4
    2 5
  end
  Graph add Edges
  Values = array 2 4 1 3 3
  Queries = array shape 3 3
    2 3 5
    1 2 2
    2 3 5
  end
  Rooted = Graph 1 root
  Q = Queries
  Actual = Values Rooted Q maximums
  Actual equal (array 4 3)
end

test "single node path uses its value"
  use "012_pathqueries2"
  use algo
  use graph
  use numbers
  use sequences
  Nodes = array 1
  Graph = new graph Nodes .undirected
  Rooted = Graph 1 root
  Query = array shape 1 3
    2 1 1
  end
  Values = array 7
  Actual = Values Rooted Query maximums
  Actual equal (array 7)
end

test "update changes a later maximum"
  use "012_pathqueries2"
  use algo
  use graph
  use numbers
  use sequences
  Graph = new graph (1 to 4) .undirected
  Graph add 1 2
  Graph add 2 3
  Graph add 3 4
  Rooted = Graph 1 root
  Queries = array shape 3 3
    2 1 4
    1 3 9
    2 1 4
  end
  Values = array 1 2 3 4
  Q = Queries
  Actual = Values Rooted Q maximums
  Actual equal (array 4 9)
end

test "path crosses several heavy chains"
  use "012_pathqueries2"
  use algo
  use graph
  use numbers
  use sequences
  Graph = new graph (1 to 7) .undirected
  Edges = array shape 6 2
    1 2
    1 3
    2 4
    2 5
    3 6
    3 7
  end
  Graph add Edges
  Rooted = Graph 1 root
  Query = array shape 1 3
    2 5 7
  end
  Values = array 8 1 2 3 10 4 5
  Actual = Values Rooted Query maximums
  Actual equal (array 10)
end
