rem CSES 1139: Distinct Colors
rem https://cses.fi/problemset/task/1139

use algo
use graph
use io
use sequences

N = stdin .integer
Colors = stdin .integer N array
Tree = new graph (1 to N) .undirected
for i in 1 till N
  A = stdin .integer
  B = stdin .integer
  Tree add A B
end
Rooted = Tree 1 root
Colors Rooted distinct_colors print


rem Merge smaller color sets upward.
fun distinct_colors Colors Rooted
  Order = Rooted .order
  Parents = Rooted .parent
  Root = Rooted .root
  Bags = new index
  Size = Order len
  Result = array shape Size fill 0

  for Node in Order
    Bag = new set
    Id = Node - 1
    Bag add Colors Id
    Bags Node = Bag
  end

  for Node in Order reverse
    Bag = Bags Node
    Id = Node - 1
    Result Id = Bag len
    if Node not equal Root
      Parent = Parents Node
      ParentBag = Bags Parent
      if ParentBag len less Bag len
        Bags Parent = Bag
        Bag = ParentBag
        ParentBag = Bags Parent
      end
      for Color in Bag
        ParentBag add Color
      end
    end
  end
  return Result
end
