rem N-Queens
rem Place N queens so that none attack
rem each other.

use sequences
use text
use io

Size = 8
Cols = array 0 till Size

rem Start with one empty placement.
Init = array shape 1 0 fill 0
States = Init next repeat Size

fun Q avail
  Dy = Q len till 0 by -1
  Mask = Cols not in Q
  Mask and= Cols not in (Q + Dy)
  Mask and= Cols not in (Q - Dy)
  return Mask
end

fun States next
  Where = States avail rank 1 indices
  Prev = States (Where # 0)
  Col = Where # (array 1)
  return concat Prev Col axis 1
end

States len print
Mask' = States Cols outer equal
Boards' = Mask choose "Q" "."
for Board i in Boards
  i + 1 print
  for Row in Board
    Row join " " print
  end
  "" print
end
