rem N-Queens
rem Place N queens so that none attack each other.

use sequences
use text
use io

Size = 8

Cols = 0 till Size array

rem Each row of States is a board: States # Row is the column of the queen in
rem that row. Row 0 may hold a queen in any column, so start with Size boards.
States = array shape Size Size fill 0
States # 0 = Cols

rem Add a queen in the next row to every board, once per free column.
for Row in 1 till Size
  Dy = Row till 0 by -1
  Prefix = States # (0 till Row)
  Free = Prefix available rank 1
  Where = Free indices

  States = States (Where # 0) copy
  States # Row = Where # 1
end

States len print
Mask = States Cols outer equal
Boards = Mask choose "Q" "."
for Board i in Boards
  i + 1 print
  for Row in Board
    Row " " join print
  end
  "" print
end

fun available Q
  Blocked = concat Q (Q + Dy) (Q - Dy)
  return Cols not in Blocked
end
