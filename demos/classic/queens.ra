rem N-Queens
rem Place N queens so that none attack
rem each other.

use sequences
use bits
use text
use io

Size = 8
Cols = array 0 till Size

rem Start with one empty board. Each row
rem of States holds its queen columns.
States = array shape 1 0 fill 0

rem One integer mask per board for used
rem columns and attacks in the next row.
Used = array 0
Left = array 0
Right = array 0

for Row in 0 till Size
  Blocked = Used Left bor
  Blocked = Blocked Right bor
  Where = (not (Blocked Cols outer bit)) indices
  Parent = Where # 0
  Col = Where # 1

  rem Extend each board at every free column.
  States = concat (States Parent) (Where # (array 1)) axis 1

  rem Carry the masks to the new boards,
  rem shifting diagonal attacks one row ahead.
  Bit = 1 Col shl
  Used = (Used Parent) Bit bor
  Left = ((Left Parent) Bit bor) 1 shl
  Right = ((Right Parent) Bit bor) 1 shr
end

States len print
Mask = States Cols outer equal
Boards = Mask choose "Q" "."
for Board i in Boards
  i + 1 print
  for Row in Board
    Row " " join print
  end
  "" print
end
