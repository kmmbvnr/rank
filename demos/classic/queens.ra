rem N-Queens
rem Place N queens so that none attack
rem each other.

use sequences
use text
use io

Size = 8

Cols = 0 till Size array

rem Each row of States holds the columns
rem of the queens placed so far.
rem Start with Size placements of one
rem queen, one for each possible column.
States = Cols reshape Size 1

rem Add a queen in the next row to every
rem board, once per free column.
for Row in 1 till Size
  Dy = Row till 0 by -1

  rem A column must be free vertically
  rem and on both diagonals.
  fun avail Q
    Mask = Cols not in Q
    Mask and= Cols not in (Q + Dy)
    Mask and= Cols not in (Q - Dy)
    return Mask
  end

  Free = States avail rank 1
  Where = Free indices

  Prev = States (Where # 0)
  Col = (Where # 1) reshape (Where len) 1
  States = concat Prev Col axis 1
end

States len print
Mask = States Cols outer equal
Boards = Mask choose "Q" "."
for Board i in Boards
  i + 1 print
  for Row in Board
    Row " " join print
  end
  "" print
end
