rem N-Queens
rem No two queens attack each other.

use algo
use numbers
use sequences
use text
use io

Size = 8
Cols = array 0 till Size

rem Pass each search branch its board explicitly.
rem Save a copy only for a solution.
fun N solve
  Board = array shape N fill 0
  Results = new queue

  fun Row Board Results N visit
    if Row equal N
      Results push (Board copy)
      return 1
    end
    Count = 0
    for Col in 0 till N
      Safe = true
      for I in 0 till Row
        Dx = Board I - Col abs
        Dy = Row - I
        if Dx equal 0 or Dx equal Dy
          Safe = false
          break
        end
      end
      if Safe
        Board Row = Col
        Count += (Row + 1) Board Results N visit
      end
    end
    return Count
  end

  0 Board Results N visit
  return Results array
end

Solutions = Size solve
Placements = Solutions reshape (
  Solutions len
) Size
Placements len print

rem Turn placements into printed boards.
Mask' = Placements Cols outer equal
Boards' = Mask choose "Q" "."
for Board i in Boards
  i + 1 print
  for Row in Board
    Row " " join print
  end
  "" print
end
