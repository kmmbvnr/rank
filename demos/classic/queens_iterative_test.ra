use testing
use sequences

test "eight queens"
  use sequences
  use "queens_iterative"
  Solutions = 8 queens array
  (Solutions shape equal (array 92 8)) all
end

test "small boards and no solutions"
  use sequences
  use "queens_iterative"
  Empty = 0 queens array
  (Empty shape equal (array 1 0)) all
  Single = 1 queens array
  (Single shape equal (array 1 1)) all
  Single 0 0 equal 0
  (2 queens array) len equal 0
  (3 queens array) len equal 0
end

test "yielded boards retain their values during backtracking"
  use sequences
  use "queens_iterative"
  Solutions = 4 queens array
  (Solutions shape equal (array 2 4)) all
  (Solutions 0 equal (array 1 3 0 2)) all
  (Solutions 1 equal (array 2 0 3 1)) all
end
