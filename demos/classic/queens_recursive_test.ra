use testing
use sequences
use text

test "eight queens"
  use "queens_recursive"
  run

  Placements len equal 92
  (Placements shape equal (array 92 8)) all
  (Boards shape equal (array 92 8 8)) all
end

test "placements are safe and distinct"
  use "queens_recursive"
  use algo
  use numbers
  run

  Seen = new set
  Ok = true
  for Q in Placements
    Ok and= Q unique len equal Size
    Ok and= (Q in Cols) all
    Seen add (Q " " join)
    for I in 0 till Size
      for J in I + 1 till Size
        Ok and= (Q I - Q J) abs not equal J - I
      end
    end
  end
  Ok and Seen len equal 92
end

test "saved boards are independent"
  use "queens_recursive"
  run

  Small = 4 solve
  (Small shape equal (array 2 4)) all
  (Small 0 equal (array 1 3 0 2)) all
  (Small 1 equal (array 2 0 3 1)) all

  Small 0 0 = 0
  (Small 1 equal (array 2 0 3 1)) all
  Again = 4 solve
  (Again 0 equal (array 1 3 0 2)) all
end
