use testing
use sequences
use text

test "eight queens"
  use "queens"
  run

  States len equal 92
  (States shape equal (array 92 8)) all
  (Boards shape equal (array 92 8 8)) all
end

test "placements are safe and distinct"
  use "queens"
  use algo
  use numbers
  run

  Seen = new set
  Ok = true
  for Q in States
    Ok and= Q unique len equal Size
    Ok and= (Q in Cols) all
    Seen add (Q " " join)
    for I in 0 till Size
      for J in I + 1 till Size
        Ok and= (Q I - Q J) abs not equal J - I
      end
    end
  end
  Ok and Seen len equal 92
end

test "four queens"
  use "queens"
  Size = 4
  run

  (States reshape 8 equal (array 1 3 0 2 2 0 3 1)) all
end

test "four queens boards"
  use "queens"
  Size = 4
  run

  Expected = array shape 2 4 4
    "." "Q" "." "."
    "." "." "." "Q"
    "Q" "." "." "."
    "." "." "Q" "."

    "." "." "Q" "."
    "Q" "." "." "."
    "." "." "." "Q"
    "." "Q" "." "."
  end
  (Boards equal Expected) all
end

test "one queen"
  use "queens"
  Size = 1
  run

  (States shape equal (array 1 1)) all
  States 0 0 equal 0
  (Boards shape equal (array 1 1 1)) all
  Boards 0 0 0 equal "Q"
end

test "two queens have no solutions"
  use "queens"
  Size = 2
  run

  (States shape equal (array 0 2)) all
  (Boards shape equal (array 0 2 2)) all
end

test "no solutions"
  use "queens"
  Size = 3
  run

  (States shape equal (array 0 3)) all
  (Boards shape equal (array 0 3 3)) all
end

test "empty board"
  use "queens"
  Size = 0
  run

  (States shape equal (array 1 0)) all
  (Boards shape equal (array 1 0 0)) all
end
