use testing
use sequences
use text

test "eight queens"
  use "queens"
  run

  States len equal 92
  (States shape equal (array 92 8)) all
  (Boards shape equal (array 92 8 8)) all
end

test "placements are safe and distinct"
  use "queens"
  use algo
  use numbers
  run

  Seen = new set
  Ok = true
  for Q in States
    Ok and= Q unique len equal Size
    Ok and= (Q in Cols) all
    Seen add (Q " " join)
    for I in 0 till Size
      for J in I + 1 till Size
        Ok and= (Q I - Q J) abs not equal J - I
      end
    end
  end
  Ok and Seen len equal 92
end
