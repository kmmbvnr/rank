use testing
use sequences
use text

test "eight queens"
  use sequences
  use "queens" as queens
  States = queens

  States len equal 92
  (States shape equal (array 92 8)) all
  Cols = array 0 till 8
  Mask' = States Cols outer equal
  Boards' = Mask choose "Q" "."
  (Boards shape equal (array 92 8 8)) all
end

test "placements are safe and distinct"
  use text
  use sequences
  use "queens" as queens
  use algo
  use numbers
  States = queens
  Size = 8
  Cols = array 0 till Size

  Seen = new set
  Ok = true
  for Q in States
    Ok and= Q unique len equal Size
    Ok and= (Q in Cols) all
    Seen add (Q join " ")
    for I in 0 till Size
      for J in I + 1 till Size
        Ok and= (Q I - Q J) abs not equal J - I
      end
    end
  end
  Ok and Seen len equal 92
end
