use testing
use sequences

test "eight queens by permutations"
  use "queens_permutations" as solve
  use sequences
  Out = solve
  Boards = Out .boards
  Sols = Out .sols

  Sols len equal 92
  (Sols shape equal (array 92 8)) all
  (Boards shape equal (array 92 8 8)) all
end

test "matches prefix search"
  use "queens" as prefix
  use "queens_permutations" as permutations
  use sequences
  States = prefix
  Out = permutations
  Cols = array 0 till 8
  Mask' = States Cols outer equal
  Boards' = Mask choose "Q" "."

  ((Out .sols) equal States) all
  ((Out .boards) equal Boards) all
end
