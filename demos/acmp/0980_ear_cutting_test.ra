rem ACMP 0980: Ear Cutting tests
use testing
use text
use numbers
use sequences

test "Sample 1 (5 nodes, 8 edges)"
  use "0980_ear_cutting"
  Input = "5 8
1 2
2 3
3 5
5 1
2 4
4 1
3 4
4 5"
  run
  Lines = Result split "\n"
  NLines = Lines len
  D = (Lines 0) integer
  (D equal 4) and (NLines equal 5)
end

test "Sample 2 (tree has bridges)"
  use "0980_ear_cutting"
  Input = "3 2
1 2
1 3"
  run
  Result equal "-1"
end

test "ACMP 980: Simple 3-cycle"
  use "0980_ear_cutting"
  Input = "3 3
1 2
2 3
3 1"
  run
  Result equal "1\n3 1 2 3 1"
end

test "Two triangles with bridge"
  use "0980_ear_cutting"
  Input = "6 7
1 2
2 3
3 1
3 4
4 5
5 6
6 4"
  run
  Result equal "-1"
end

test "Two triangles sharing node"
  use "0980_ear_cutting"
  Input = "5 6
1 2
2 3
3 1
1 4
4 5
5 1"
  run
  Lines = Result split "\n"
  D = (Lines 0) integer
  D equal 2
end

test "ACMP 980: Default 8-node stress"
  use "0980_ear_cutting"
  run
  Lines = Result split "\n"
  D = (Lines 0) integer
  D equal 7
end
