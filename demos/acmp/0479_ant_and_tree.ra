rem Ant and Tree
rem https://acmp.ru/
rem   index.asp?main=task&id_task=479
rem Shortest path around circle obstacle

use io
use cli
use sequences
use numbers
use text

arg Input text = (
  "-10000 -10000 10000 10000 0 0 5000"
)

Lines = Input split "\n"
Tokens = (Lines join " ") split " "
Tokens = Tokens (Tokens not equal "")
Nums = Tokens real

X1 = Nums 0
Y1 = Nums 1
X2 = Nums 2
Y2 = Nums 3
Xc = Nums 4
Yc = Nums 5
R = Nums 6

rem Translate circle center to origin
A = array (X1 - Xc) (Y1 - Yc)
B = array (X2 - Xc) (Y2 - Yc)
V = B - A

SegLen2 = V * V sum
Intersects = false

if SegLen2 greater 0.0
  rem Projection t onto segment A -> B
  DotAV = A * V sum
  T = (0.0 - DotAV) / SegLen2
  if T greater 0.0 and (T less 1.0)
    P = A + V * T
    H2 = P * P sum
    R2 = R * R - 1e-9
    if H2 less R2
      Intersects = true
    end
  end
end

Answer = 0.0

if not Intersects
  Dist = SegLen2 sqrt
  Answer = Dist round 3
  Answer print
else
  SqA = A * A sum
  DA = SqA sqrt
  SqB = B * B sum
  DB = SqB sqrt
  DiffA = (DA * DA) - (R * R)
  LA = DiffA sqrt
  DiffB = (DB * DB) - (R * R)
  LB = DiffB sqrt
  RatioA = 1.0 min (R / DA)
  AlphaA = RatioA acos
  RatioB = 1.0 min (R / DB)
  AlphaB = RatioB acos
  DotAB = A * B sum
  NormAB = DA * DB
  CosVal = 1.0 min (DotAB / NormAB)
  CosTheta = -1.0 max CosVal
  Theta = CosTheta acos
  AngleSum = AlphaA + AlphaB
  DeltaDiff = Theta - AngleSum
  Delta = 0.0 max DeltaDiff
  Dist = LA + LB + R * Delta
  Answer = Dist round 3
  Answer print
end
return Answer
