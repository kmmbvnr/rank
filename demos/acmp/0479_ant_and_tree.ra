rem ACMP 0479 - Ant and Tree (Муравей и дерево)
rem Shortest path around a circular obstacle using 2D vector geometry and tangents.
rem
rem If the segment connecting start and goal does not intersect the disk interior,
rem the path is simply the straight Euclidean segment.
rem Otherwise, the shortest detour consists of two straight segments tangent to the circle
rem connected by an arc along the circle boundary.

use io
use cli
use sequences
use numbers
use text

arg Input text = "0 0 4 4 2 2 1"

Tokens = (Input split "\n" join " ") split " "
Tokens = Tokens (Tokens not equal "")
Nums = Tokens real

X1 = Nums 0
Y1 = Nums 1
X2 = Nums 2
Y2 = Nums 3
Xc = Nums 4
Yc = Nums 5
R = Nums 6

rem Translate circle center to origin
A = array (X1 - Xc) (Y1 - Yc)
B = array (X2 - Xc) (Y2 - Yc)
V = B - A

SegLen2 = V * V sum
Intersects = false

if SegLen2 greater 0.0
  rem Projection parameter t of circle center (origin) onto line segment A -> B
  rem t = - (A . V) / |V|^2
  T = (0.0 - (A * V sum)) / SegLen2
  if (T greater 0.0) and (T less 1.0)
    P = A + V * T
    H2 = P * P sum
    if H2 less (R * R - 1e-9)
      Intersects = true
    end
  end
end

Answer = 0.0

if not Intersects
  Dist = SegLen2 sqrt
  Answer = Dist round 3
  Answer print
else
  DA = (A * A sum) sqrt
  DB = (B * B sum) sqrt
  LA = (DA * DA - R * R) sqrt
  LB = (DB * DB - R * R) sqrt
  AlphaA = (1.0 min (R / DA)) acos
  AlphaB = (1.0 min (R / DB)) acos
  CosTheta = (-1.0) max (1.0 min ((A * B sum) / (DA * DB)))
  Theta = CosTheta acos
  Delta = 0.0 max (Theta - AlphaA - AlphaB)
  Dist = LA + LB + R * Delta
  Answer = Dist round 3
  Answer print
end
