rem ACMP 0610: Pipe Laying tests
use testing

test "ACMP 610: Sample 1 (4x4 => 6)"
  use "0610_pipes" as solve
  Ans = solve "4 4"
  Ans equal 6
end

test "ACMP 610: Sample 2 (5x7 => 0)"
  use "0610_pipes" as solve
  Ans = solve "5 7"
  Ans equal 0
end

test "ACMP 610: Sample 3 (2x8 => 1)"
  use "0610_pipes" as solve
  Ans = solve "2 8"
  Ans equal 1
end

test "ACMP 610: Sample 4 (12x8)"
  use "0610_pipes" as solve
  Ans = solve "12 8"
  Ans equal 102283239429
end
