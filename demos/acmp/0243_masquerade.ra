rem Masquerade
rem https://acmp.ru/
rem   index.asp?main=task&id_task=243
rem Min cost for L fabric with discounts

use io
use cli
use sequences
use text
use numbers

arg N integer = 5
arg L integer = 100
arg ShopsText text = (
  "12 25 9 30\n" +
  "10 20 8 30\n" +
  "15 30 11 35\n" +
  "14 20 10 25\n" +
  "13 15 9 20"
)

INF = 1000000000

Tokens = ShopsText words integer
StockIdx = (0 till N) * 4 + 3
Stocks = Tokens StockIdx
TotalStock = Stocks sum

Answer = -1

CapBound = L + 100
if not (TotalStock less L)
  MaxCap = TotalStock min CapBound
  DP = array shape (MaxCap + 1) fill INF
  DP 0 = 0

  for I in 0 till N
    Base = 4 * I
    P = Tokens Base
    R = Tokens (Base + 1)
    Q = Tokens (Base + 2)
    F = Tokens (Base + 3)

    CostVec = array 0
    if F greater 0
      X = 1 to F
      Disc = not (X less R)
      DiscMask = Disc integer
      NoDisc = 1 - DiscMask
      DiscPart = Q * DiscMask
      RegPart = P * NoDisc
      Price = DiscPart + RegPart
      Paid = X * Price
      CostVec = concat (array 0) Paid
    end

    CapP1 = MaxCap + 1
    NextDP = array shape CapP1 fill INF
    for M in 0 to MaxCap
      LimitX = M min F
      X = 0 to LimitX
      PrevM = M - X
      DPPrev = DP PrevM
      CostX = CostVec X
      Cand = DPPrev + CostX
      NextDP M = Cand min
    end
    DP = NextDP
  end

  TargetSlice = DP (L to MaxCap)
  Answer = TargetSlice min
end

Answer print
