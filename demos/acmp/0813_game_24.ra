rem Game of 24
rem https://acmp.ru/
rem   index.asp?main=task&id_task=813
rem Subset DP for reachable card values

use io
use text
use cli
use algo
use bits
use sequences

arg Input text = "30 29 28 27"

Txt = Input split "\r" join " "
Txt = Txt split "\n" join " "
Tok = Txt split " "
Toks = Tok (Tok not equal "")
Cards = Toks integer

Vals = new index
for Mask in 1 till 16
  Vals Mask = array shape 0 fill 0
  for I in 0 till 4
    BitI = 1 shl I
    BitMask = Mask band BitI
    if BitMask equal Mask
      Vals Mask = array (Cards I)
    end
  end
  for A in 1 till Mask
    BitA = A band Mask
    if BitA equal A
      X = Vals A
      MaskXor = Mask bxor A
      Y = Vals MaskXor
      Sums = (X Y outer +) reshape #
      Diffs = (X Y outer -) reshape #
      Prods = (X Y outer *) reshape #
      New = concat Sums Diffs
      New = concat New Prods
      OldVals = Vals Mask
      All = concat OldVals New
      SortedAll = All sort unique
      Vals Mask = SortedAll array
    end
  end
end

Ans = "NO"
Hits = ((Vals 15) equal 24) count
if Hits greater 0
  Ans = "YES"
end
return Ans
