rem ACMP 0468 - Number Sequence 2
rem N-th number with 3 set bits.
rem 2^P3 + 2^P2 + 2^P1 with P3>P2>P1.
rem Rank K = C(P3,3) + C(P2,2) + P1.

use io
use cli
use numbers
use bits

arg N integer = 2147483647

K = N - 1

rem Binary search for P3
Low = 2
High = 3000
P3 = 2
for Low less (High + 1)
  Mid = (Low + High) // 2
  C3 = Mid * (Mid - 1) * (Mid - 2) // 6
  if C3 greater K
    High = Mid - 1
  else
    P3 = Mid
    Low = Mid + 1
  end
end
C3Val = P3 * (P3 - 1) * (P3 - 2) // 6
K = K - C3Val

rem Binary search for P2
Low = 1
High = P3 - 1
P2 = 1
for Low less (High + 1)
  Mid = (Low + High) // 2
  C2 = Mid * (Mid - 1) // 2
  if C2 greater K
    High = Mid - 1
  else
    P2 = Mid
    Low = Mid + 1
  end
end
C2Val = P2 * (P2 - 1) // 2
K = K - C2Val

P1 = K

B3 = 1 shl P3
B2 = 1 shl P2
B1 = 1 shl P1
Answer = B3 + B2 + B1
return record
  .answer = Answer
  .p1 = P1
  .p2 = P2
  .p3 = P3
end
