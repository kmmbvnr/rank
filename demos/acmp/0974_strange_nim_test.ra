use testing

test "example 1: 1 2 3"
  use "0974_strange_nim"
  run

  Answer equal "Alice wins the game."
end

test "example 2: 1 3 5"
  use "0974_strange_nim"
  A = 1
  B = 3
  C = 5
  run

  Answer equal "Bob wins the game."
end

test "large inputs: 100 200 500"
  use "0974_strange_nim"
  A = 100
  B = 200
  C = 500
  run

  Answer equal "Alice wins the game."
end
