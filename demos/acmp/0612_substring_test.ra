use testing

test "sample 1: minimal word"
  use "0612_substring" as solve
  Answer = solve "abAaBBabbA\nAaBaba"

  Answer equal "aAaBabaAbA"
end

test "Y is substring of reduced X"
  use "0612_substring" as solve
  Answer = solve "aBab\nBa"

  Answer equal "aBab"
end

test "single char disjoint elements"
  use "0612_substring" as solve
  Answer = solve "a\nb"

  Answer equal "bBa"
end

test "identical words yield Y"
  use "0612_substring" as solve
  Answer = solve "aB\naB"

  Answer equal "aB"
end

test "Y self-cancels into empty"
  use "0612_substring" as solve
  Answer = solve "a\nBb"

  Answer equal "Bba"
end
