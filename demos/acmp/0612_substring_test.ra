use testing

test "sample 1: minimal word"
  use "0612_substring"
  Input = "abAaBBabbA\nAaBaba"
  run

  Answer equal "aAaBabaAbA"
end

test "Y is substring of reduced X"
  use "0612_substring"
  Input = "aBab\nBa"
  run

  Answer equal "aBab"
end

test "single char disjoint elements"
  use "0612_substring"
  Input = "a\nb"
  run

  Answer equal "bBa"
end

test "identical words yield Y"
  use "0612_substring"
  Input = "aB\naB"
  run

  Answer equal "aB"
end

test "Y self-cancels into empty"
  use "0612_substring"
  Input = "a\nBb"
  run

  Answer equal "Bba"
end
