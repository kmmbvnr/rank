rem Tournament 2 (Турнир - 2)
rem ACMP 921
rem Min chess matches c minimizing score

use io
use numbers
use cli
use sequences
use text

arg Input text = "60000 60 40 10"

Lines = Input split "\n"
Line = Lines join " "
Tokens = Line split " "
Tokens = Tokens (Tokens not equal "")

K = Tokens 0 integer
P1 = Tokens 1 integer
P2 = Tokens 2 integer
P3 = Tokens 3 integer

rem Score diff per match scaled by 100
A = (2 * P1) + P3 - 100
B = 100 - (2 * P2)

C = 1 till K
DiffTerm = (C * (A - B)) + (K * B)
Diffs = DiffTerm abs
MinDiff = Diffs min
BestC = (C (Diffs equal MinDiff)) 0

BestC text print
