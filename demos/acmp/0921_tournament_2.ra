rem Tournament 2 (Турнир - 2)
rem https://acmp.ru/index.asp?main=task&id_task=921
rem Find minimum number of chess matches c (1 <= c < K) minimizing difference in expected tournament scores.
rem Solved via vectorized arithmetic over the candidate match range 1 till K.

use io
use numbers
use cli
use sequences
use text

arg Input text = "3 50 50 50"

Tokens = Input split "\n" join " " split " "
Tokens = Tokens (Tokens not equal "")

K = (Tokens 0) integer
P1 = (Tokens 1) integer
P2 = (Tokens 2) integer
P3 = (Tokens 3) integer

rem Expected score diff per match scaled by 100:
rem A = 2 * P1 + P3 - 100 (chess)
rem B = 100 - 2 * P2 (volleyball)
A = (2 * P1) + P3 - 100
B = 100 - (2 * P2)

rem Vector of candidate chess match counts:
C = 1 till K
Diffs = ((C * (A - B)) + (K * B)) abs
MinDiff = Diffs min
BestC = (C (Diffs equal MinDiff)) 0

(BestC text) print
