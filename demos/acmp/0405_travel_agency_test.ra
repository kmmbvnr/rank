use testing

test "sample 1: 7 planets star of triangles"
  use "0405_travel_agency"
  run

  Answer equal (array 18 6 6 6 6 6 6)
end

test "path graph of 3 planets"
  use "0405_travel_agency"
  Input = "3 2\n1 2\n2 3"
  run

  Answer equal (array 2 3 2)
end

test "complete graph K4"
  use "0405_travel_agency"
  Input = "4 6\n1 2\n1 3\n1 4\n2 3\n2 4\n3 4"
  run

  Answer equal (array 3 3 3 3)
end

test "star graph S5"
  use "0405_travel_agency"
  Input = "5 4\n1 2\n1 3\n1 4\n1 5"
  run

  Answer equal (array 10 4 4 4 4)
end

test "two triangles connected by bridge"
  use "0405_travel_agency"
  Input = "6 7\n1 2\n2 3\n3 1\n3 4\n4 5\n5 6\n6 4"
  run

  Answer equal (array 5 5 11 11 5 5)
end
