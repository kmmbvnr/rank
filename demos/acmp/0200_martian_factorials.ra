rem Martian Factorials
rem acmp.ru: task 200
rem Trailing zeros of N! in base K

use numbers
use sequences
use algo
use io
use cli

arg N integer = 1000000000
arg K integer = 1000

Factors = K factors array
Primes = Factors unique array

Ks = new queue
for P in Primes
  EqualP = Factors equal P
  E = EqualP count
  Legendre = 0
  X = N // P
  for X greater 0
    Legendre += X
    X //= P
  end
  Ks push (Legendre // E)
end

return Ks array min
