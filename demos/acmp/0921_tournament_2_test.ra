use testing

test "sample 1: 3 50 50 50 -> 1"
  use "0921_tournament_2" as solve
  BestC = solve "3 50 50 50"

  BestC equal 1
end

test "sample 2: 4 0 0 100 -> 3"
  use "0921_tournament_2" as solve
  BestC = solve "4 0 0 100"

  BestC equal 3
end

test "K = 2 minimal: exactly 1 match"
  use "0921_tournament_2" as solve
  BestC = solve "2 40 40 20"

  BestC equal 1
end

test "large K = 60000"
  use "0921_tournament_2" as solve
  BestC = solve "60000 60 40 10"

  BestC greater 0
  BestC less 60000
end
