rem Iguana (Игуана)
rem ACMP 920
rem Chromatic number, N <= 18
rem Inclusion-exclusion over subsets

use io
use text
use cli
use bits
use numbers
use sequences

arg Input text = "5
0 1 1 1 1
1 0 1 1 1
1 1 0 1 1
1 1 1 0 1
1 1 1 1 0"

Txt = Input split "\r" join " "
Txt = Txt split "\n" join " "
Tok = Txt split " "
Tok = Tok (Tok not equal "")
Nums = Tok integer
N = Nums 0
N2 = N * N
Cells = Nums (1 till (N2 + 1))
Mat = Cells reshape N N
Full = 1 shl N
Sets = 0 till Full

rem Independent sets by bit
Ind = array shape Full fill 0
Ind 0 = 1
for I in 0 till N
  Lo = 0 till (1 shl I)
  Bits = 2 ** (0 till I)
  MatI = (Mat I) (0 till I)
  ProdBits = MatI * Bits
  Nb = ProdBits sum
  Free = ((Lo band Nb) equal 0) integer
  ShiftI = 1 shl I
  Ind (Lo + ShiftI) = (Ind Lo) * Free
end

rem Zeta transform
Cnt = Ind
for I in 0 till N
  Bit = 1 shl I
  Has = (Sets shr I) band 1
  PrevCnt = Cnt (Sets bxor Bit)
  Cnt = Cnt + (PrevCnt * Has)
end

SetPop = Sets popcount
Sign = 1 - (2 * ((N - SetPop) band 1))
Pw = array shape Full fill 1
Ans = N
for K in 1 to N
  Pw = Pw * Cnt
  Terms = Pw * Sign
  TermSum = Terms sum
  if TermSum greater 0
    Ans = K
    break
  end
end

(Ans text) print
