rem ACMP 0655 - Data Encoding
rem Decode N from code = N + cyclic(N,K)
rem N*(10^K+1) = code + A*(10^L-1)

use io
use cli
use sequences
use numbers
use text

arg Input text = "512\n1"

fun Coeff extGcd Mod
  G0 = Coeff
  G1 = Mod
  X0 = 1
  X1 = 0
  for G1 not equal 0
    Q = G0 // G1
    G2 = G0 mod G1
    G0 = G1
    G1 = G2
    X2 = X0 - Q * X1
    X0 = X1
    X1 = X2
  end
  return array G0 X0
end

Lines = Input split "\n"
Line = Lines join " "
Tokens = Line split " "
Tokens = Tokens (Tokens not equal "")
CodeText = Tokens 0
K = Tokens 1 integer

Code = CodeText integer
LenCode = CodeText len

TenKArr = array shape K fill "0"
TenKStr = "1" + (TenKArr join "")
TenK = TenKStr integer
Mod = TenK + 1

MinAArr = array shape (K - 1) fill "0"
MinAStr = "1" + (MinAArr join "")
MinA = MinAStr integer

Answer = ""
Found = false

MinL = K + 1
if LenCode - 1 greater MinL
  MinL = LenCode - 1
end

for L in (MinL to LenCode array reverse)
  if not Found
    TenLArr = array shape L fill "0"
    TenLStr = "1" + (TenLArr join "")
    TenL = TenLStr integer
    M = L - K
    TenMArr = array shape M fill "0"
    TenMStr = "1" + (TenMArr join "")
    TenM = TenMStr integer

    Coeff = (TenL - 1) mod Mod
    NegCode = 0 - Code
    NegMod = NegCode mod Mod + Mod
    Target = NegMod mod Mod

    T = Coeff extGcd Mod
    G = T 0
    X = T 1

    if Target mod G equal 0
      Step = Mod // G
      Prod = X * (Target // G)
      BaseA = Prod mod Step
      if BaseA less 0
        BaseA = BaseA + Step
      end

      if G equal Mod
        if M equal K
          SumAB = Code // Mod
          MaxB = TenK - 1
          ChosenA = MinA
          DiffAB = SumAB - ChosenA
          if DiffAB greater MaxB
            ChosenA = SumAB - MaxB
          end
          BaseA = ChosenA
          Step = TenK
        end
      end

      A = BaseA
      for A less TenK and (not Found)
        if A greater (MinA - 1)
          Num = Code + A * (TenL - 1)
          if Num mod Mod equal 0
            N = Num // Mod
            NText = N text
            if NText len equal L
              AActual = N // TenM
              if AActual equal A
                B = N mod TenM
                Cyclic = B * TenK + A
                if N + Cyclic equal Code
                  Answer = NText
                  Found = true
                end
              end
            end
          end
        end
        A = A + Step
      end
    end
  end
end

Answer print
