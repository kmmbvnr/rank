rem Lightbulbs
rem https://acmp.ru/index.asp?main=task&id_task=337
rem Count bulbs that are ON after K boys toggle multiples of their periods Pi up to N

use io
use cli
use sequences
use numbers
use text

arg Input text = "20 3\n2 3 8"

Tokens = Input split "\n" join " " split " "
Tokens = Tokens (Tokens not equal "")
N = Tokens 0 integer
K = Tokens 1 integer
P = (Tokens drop 2) take K integer

rem Count frequencies of periods 1..50
Counts = array shape 51 fill 0
for Period in P
  Counts Period = Counts Period + 1
end

OddP = (1 to 50) array
OddP = OddP (((Counts OddP) mod 2) equal 1)

TermsV = array shape 0 fill 0
TermsC = array shape 0 fill 0

for PVal in OddP
  if TermsV len equal 0
    TermsV = array PVal
    TermsC = array 1
  else
    NewV = TermsV lcm PVal
    Valid = not (NewV greater N)
    NewV = NewV Valid
    NewC = (0 - 2) * (TermsC Valid)

    AllV = concat TermsV NewV (array PVal)
    AllC = concat TermsC NewC (array 1)

    Idx = AllV argsort
    SortedV = AllV Idx
    SortedC = AllC Idx

    OutV = array shape (SortedV len) fill 0
    OutC = array shape (SortedC len) fill 0
    OutCount = 0

    LastV = 0 - 1
    LastC = 0

    for I in 0 to (SortedV len - 1)
      CurV = SortedV I
      CurC = SortedC I
      if CurV equal LastV
        LastC += CurC
      else
        if (LastV greater 0) and (LastC not equal 0)
          OutV OutCount = LastV
          OutC OutCount = LastC
          OutCount += 1
        end
        LastV = CurV
        LastC = CurC
      end
    end

    if (LastV greater 0) and (LastC not equal 0)
      OutV OutCount = LastV
      OutC OutCount = LastC
      OutCount += 1
    end

    TermsV = OutV take OutCount
    TermsC = OutC take OutCount
  end
end

Answer = 0
if TermsV len greater 0
  Answer = (TermsC * (N // TermsV)) sum
end

Answer print
