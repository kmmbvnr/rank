rem Lightbulbs
rem acmp.ru: task 337
rem Bulbs ON after K boys.

use io
use cli
use sequences
use numbers
use text

arg Input text = "1000000000 10
19 2 7 13 40 23 16 3 45 9"

Lines = Input split "\n"
Joined = Lines join " "
Tokens = Joined split " "
Tokens = Tokens (Tokens not equal "")
N = Tokens 0 integer
K = Tokens 1 integer
P = Tokens drop 2 take K integer

Counts = array shape 51 fill 0
for Period in P
  Counts Period = Counts Period + 1
end

OddP = 1 to 50 array
OddCounts = Counts OddP mod 2 equal 1
OddP = OddP OddCounts

TermsV = array shape 0 fill 0
TermsC = array shape 0 fill 0

for PVal in OddP
  if TermsV len equal 0
    TermsV = array PVal
    TermsC = array 1
  else
    NewV = TermsV lcm PVal
    Valid = not (NewV greater N)
    NewV = NewV Valid
    NewC = (0 - 2) * (TermsC Valid)

    PValArr = array PVal
    AllV = concat TermsV NewV PValArr
    AllC = concat TermsC NewC (array 1)

    Idx = AllV argsort
    SortedV = AllV Idx
    SortedC = AllC Idx

    M = SortedV len
    V1 = SortedV (1 till M)
    V0 = SortedV (0 till M - 1)
    VDiff = V1 not equal V0
    TrueArr = array true
    Diffs = concat TrueArr VDiff
    OutV = SortedV Diffs

    C_sums = SortedC scan +
    GroupEnds = concat VDiff TrueArr
    EndPositions = (0 till M) GroupEnds
    EndSums = C_sums EndPositions
    EndLen = EndSums len
    ZeroArr = array 0
    PrevCount = EndLen - 1
    EndPrev = EndSums (0 till PrevCount)
    PrevSums = concat ZeroArr EndPrev
    OutC = EndSums - PrevSums

    NonZero = OutC not equal 0
    TermsV = OutV NonZero
    TermsC = OutC NonZero
  end
end

TermsCount = N // TermsV
Contributions = TermsCount * TermsC
Answer = Contributions sum
return Answer
