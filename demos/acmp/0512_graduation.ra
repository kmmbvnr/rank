rem Graduation
rem https://acmp.ru/
rem   index.asp?main=task&id_task=512
rem Match K pairs from boys and girls

use io
use numbers
use cli
use sequences
use text
use bits

arg Input text = (
  "10 10 10\n" +
  "YYYYYYYYYY\n" +
  "YYYYYYYYYY\n" +
  "YYYYYYYYYY\n" +
  "YYYYYYYYYY\n" +
  "YYYYYYYYYY\n" +
  "YYYYYYYYYY\n" +
  "YYYYYYYYYY\n" +
  "YYYYYYYYYY\n" +
  "YYYYYYYYYY\n" +
  "YYYYYYYYYY"
)

Tokens = (
  (Input split "\n" join " ")
  split " "
)
Tokens = Tokens (Tokens not equal "")

N = Tokens 0 integer
M = Tokens 1 integer
K = Tokens 2 integer
Rows = Tokens drop 3

BoyMasks = array shape N fill 0
for I in 0 till N
  Row = Rows I
  Mask = 0
  for J in 0 till M
    Ch = Row drop J take 1
    if Ch equal "Y"
      Mask = Mask bor (1 shl J)
    end
  end
  BoyMasks I = Mask
end

NumMasks = 1 shl M
DP = array shape NumMasks fill 0
DP 0 = 1
AllMasks = 0 till NumMasks

for I in 0 till N
  BMask = BoyMasks I
  NextDP = 1 * DP
  for J in 0 till M
    Bit = 1 shl J
    CanDance = (
      BMask band Bit
    ) greater 0
    if CanDance
      Free = (
        AllMasks band Bit
      ) equal 0
      FromIdx = AllMasks Free
      ToIdx = FromIdx bor Bit
      Add = DP FromIdx
      CurTo = NextDP ToIdx
      NextDP ToIdx = CurTo + Add
    end
  end
  DP = NextDP
end

PopCounts = array shape NumMasks fill 0
for Mask in 1 till NumMasks
  PopCounts Mask = (
    PopCounts (Mask shr 1)
  ) + (Mask band 1)
end

MaskK = PopCounts equal K
return DP MaskK sum
