rem Graduation
rem https://acmp.ru/index.asp?main=task&id_task=512
rem Number of ways to form exactly K pairs from N boys and M girls given preference matrix

use io
use numbers
use cli
use sequences
use text
use bits

arg Input text = "3 4 3\nYYYY\nYYYY\nYYYY"

Tokens = Input split "\n" join " " split " "
Tokens = Tokens (Tokens not equal "")

N = (Tokens 0) integer
M = (Tokens 1) integer
K = (Tokens 2) integer
Rows = Tokens drop 3

rem Build bitmask of compatible girls for each boy
BoyMasks = array shape N fill 0
for I in 0 till N
  Row = Rows I
  Mask = 0
  for J in 0 till M
    Ch = Row drop J take 1
    if Ch equal "Y"
      Mask = Mask bor (1 shl J)
    end
  end
  BoyMasks I = Mask
end

NumMasks = 1 shl M
DP = array shape NumMasks fill 0
DP 0 = 1

rem Transitions: DP(mask) tracks ways to match subsets of girls using prefix of boys
for I in 0 till N
  BMask = BoyMasks I
  NextDP = array shape NumMasks fill 0
  for Mask in 0 till NumMasks
    WaysCur = DP Mask
    if WaysCur greater 0
      rem Option 1: boy I does not dance
      NextDP Mask = (NextDP Mask) + WaysCur
      rem Option 2: boy I dances with compatible unassigned girl J
      for J in 0 till M
        if not (((BMask shr J) band 1) equal 0)
          if ((Mask shr J) band 1) equal 0
            NewMask = Mask bor (1 shl J)
            NextDP NewMask = (NextDP NewMask) + WaysCur
          end
        end
      end
    end
  end
  DP = NextDP
end

rem Vectorized popcount table to select all masks with exactly K matched girls
PopCounts = array shape NumMasks fill 0
for Mask in 1 till NumMasks
  PopCounts Mask = (PopCounts (Mask shr 1)) + (Mask band 1)
end

MaskK = PopCounts equal K
Ways = (DP MaskK) sum

(Ways text) print
