use testing

test "sample 1: K=4 gives 3 shirts"
  use "0566_freebie" as solve
  Out = solve "2 2 2 4"
  Answer = Out .answer

  Answer equal 3
end

test "sample 2: 4 threes K=4 gives 2"
  use "0566_freebie" as solve
  Out = solve "0 0 4 4"
  Answer = Out .answer

  Answer equal 2
end

test "all cap combinations with K=5"
  use "0566_freebie" as solve
  rem 15 twos and 6 ones form 7 shirts
  Out = solve "6 15 0 5"
  Answer = Out .answer

  Answer equal 7
end

test "non-mixed bundles avoid overshoot"
  use "0566_freebie" as solve
  rem 3 twos and 6 threes K=6
  Out = solve "0 3 6 6"
  Answer = Out .answer

  Answer equal 4
end

test "small K closed form cases"
  use "0566_freebie" as solve

  rem K = 1: every cap gives a shirt
  Out = solve "5 7 11 1"
  Answer = Out .answer
  K = Out .k
  Answer equal 23

  rem K = 2: 3 and 2 give 1 shirt each
  Out = solve "7 4 3 2"
  Answer = Out .answer
  K = Out .k
  Answer equal (3 + 4 + (7 // 2))

  rem K = 3: pairs of (1, 2)
  Out = solve "5 3 2 3"
  Answer = Out .answer
  K = Out .k
  Answer equal (2 + 3 + ((5 - 3) // 3))
end

test "insufficient stars gives 0 shirts"
  use "0566_freebie" as solve
  Out = solve "1 1 1 10"
  Answer = Out .answer

  Answer equal 0
end

test "large constraints"
  use "0566_freebie" as solve
  Out = solve "100 100 100 5"
  Answer = Out .answer
  Answer equal 120

  Out = solve "100 100 100 10"
  Answer = Out .answer
  Answer equal 60

  Out = solve "100 100 100 100"
  Answer = Out .answer
  Answer equal 6
end
