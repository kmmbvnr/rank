rem Tests for ACMP 0812

use testing

test "default: N=1000 A=500"
  use "0812_sequence_compression" as solve
  Ans = solve

  AnsTxt = Ans text
  AnsTxt len equal 301
  AnsTxt take 10 equal "5357543035"
  AnsTxt drop 291 equal "4753465344"
end

test "sample 1: 2 1 -> 1"
  use "0812_sequence_compression" as solve
  Ans = solve "2 1"

  Ans equal 1
end

test "sample 2: 4 2 -> 5"
  use "0812_sequence_compression" as solve
  Ans = solve "4 2"

  Ans equal 5
end

test "edge: N=1 A=1 -> 1"
  use "0812_sequence_compression" as solve
  Ans = solve "1 1"

  Ans equal 1
end

test "all compositions: 10 10 -> 512"
  use "0812_sequence_compression" as solve
  Ans = solve "10 10"

  Ans equal 512
end

test "fibonacci: N=6 A=2 -> 13"
  use "0812_sequence_compression" as solve
  Ans = solve "6 2"

  Ans equal 13
end
