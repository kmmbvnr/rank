use testing

test "sample 1: bill 1 passes"
  use "0586_bill"
  Input = (
    "3 2 4\n" +
    "3 4 1 2\n" +
    "2 3 4 1\n" +
    "4 1 2 3"
  )
  run

  Answer equal "1"
end

test "sample 2: bill 3 passes"
  use "0586_bill"
  Input = (
    "3 2 4\n" +
    "3 1 4 2\n" +
    "1 3 4 2\n" +
    "4 2 3 1"
  )
  run

  Answer equal "3"
end

test "single bill immediately passes"
  use "0586_bill"
  Input = "3 2 1\n1\n1\n1"
  run

  Answer equal "1"
end

test "unanimous threshold reaches last"
  use "0586_bill"
  rem 3 deputies, threshold 3
  Input = "3 3 3\n1 2 3\n2 3 1\n3 1 2"
  run

  Answer equal "3"
end

test "bill 2 accepted by majority"
  use "0586_bill"
  Input = "3 2 3\n2 1 3\n2 3 1\n1 2 3"
  run

  Answer equal "2"
end
