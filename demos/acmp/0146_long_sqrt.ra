rem Long Square Root
rem acmp.ru: task 146
rem Exact floor(sqrt(A)) for large A

use text
use io
use cli

arg S text = (
  "999999999999999999999999999999" +
  "999999999999999999999999999999" +
  "999999999999999999999999999999"
)

A = S integer
Answer = 0

if A less 2
  Answer = A
else
  Len = S len
  Half = (Len + 1) // 2
  X = 10 ** Half

  for true
    Y = (X + (A // X)) // 2
    if not (Y less X)
      Answer = X
      break
    end
    X = Y
  end
end

return Answer
