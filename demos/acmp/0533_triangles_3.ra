rem Triangles - 3
rem https://acmp.ru/
rem   index.asp?main=task&id_task=533
rem Count isosceles triangles

use io
use numbers
use cli
use sequences
use text

arg Input text = (
  "16\n" +
  "0 0\n" +
  "0 100000000\n" +
  "0 200000000\n" +
  "0 300000000\n" +
  "100000000 0\n" +
  "100000000 100000000\n" +
  "100000000 200000000\n" +
  "100000000 300000000\n" +
  "200000000 0\n" +
  "200000000 100000000\n" +
  "200000000 200000000\n" +
  "200000000 300000000\n" +
  "300000000 0\n" +
  "300000000 100000000\n" +
  "300000000 200000000\n" +
  "300000000 300000000"
)

Tokens = (
  Input split "\n" join " " split " "
)
Tokens = Tokens (Tokens not equal "")
N = Tokens 0 integer
Coords = Tokens drop 1 integer

Idx = (0 till N) * 2
Xs = Coords Idx
Ys = Coords (Idx + 1)

Base = 4000000001
TotalTriangles = 0

for I in 0 till N
  XO = Xs I
  YO = Ys I

  MaskOther = 0 till N not equal I
  Dx = (Xs MaskOther) - XO
  Dy = (Ys MaskOther) - YO

  D = (Dx * Dx) + (Dy * Dy)
  M = D len

  OrderD = D argsort
  SortedD = D OrderD

  DropSorted = SortedD drop 1
  TakeSorted = SortedD take (M - 1)
  DiffD = (
    DropSorted not equal TakeSorted
  )
  IdxM = 0 till (M - 1)
  CutIdx = (IdxM DiffD) + 1
  LeftBound = concat (array 0) CutIdx
  Boundaries = (
    concat LeftBound (array M)
  )
  NumBoundaries = Boundaries len
  DropBound = Boundaries drop 1
  TakeBound = (
    Boundaries take (NumBoundaries - 1)
  )
  Counts = DropBound - TakeBound
  TermPairs = (
    (Counts * (Counts - 1)) // 2
  )
  PairsD = TermPairs sum

  IsDx0 = Dx equal 0
  IsDyNeg = Dy less 0
  IsNeg = (
    Dx less 0 or (IsDx0 and IsDyNeg)
  )
  Cx = Dx
  Cx IsNeg = 0 - (Dx IsNeg)
  Cy = Dy
  Cy IsNeg = 0 - (Dy IsNeg)

  Key = Cx * Base + Cy
  OrderKey = Key argsort
  SortedKey = Key OrderKey

  DropKey = SortedKey drop 1
  TakeKey = SortedKey take (M - 1)
  DiffKey = (
    DropKey not equal TakeKey
  )
  DiffCount = DiffKey count
  CollinearPairs = (M - 1) - DiffCount

  ValidPairs = (
    PairsD - CollinearPairs
  )
  TotalTriangles = (
    TotalTriangles + ValidPairs
  )
end

return TotalTriangles
