rem Stone Game
rem acmp.ru: task 404
rem Square-root subtraction game.

use io
use cli

arg N integer = 1000000000000

Answer = "WIN"

if N equal 2
  Answer = "LOSE"
else
  Osn = 2
  Bad = 2
  Running = true

  for Running and (Bad less N)
    NextBad = Bad + Osn
    if not (Osn * Osn greater NextBad)
      Osn += 1
      Bad += Osn
      if Bad equal N
        Answer = "LOSE"
        Running = false
      end
    else
      Target = Osn * (Osn - 1)
      K = (Target - Bad) // Osn
      if K greater 0
        Limit = Bad + K * Osn
        if not (Limit less N)
          Rem = (N - Bad) mod Osn
          if Rem equal 0
            Answer = "LOSE"
          end
          Running = false
        else
          Bad = Limit
        end
      else
        NextBad2 = Bad + Osn
        OsnSq = Osn * Osn
        if not (OsnSq greater NextBad2)
          Osn += 1
        end
        Bad += Osn
      end
    end
  end

  if Bad equal N
    Answer = "LOSE"
  end
end

return Answer
