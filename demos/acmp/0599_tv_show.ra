rem TV Show
rem https://acmp.ru/
rem   index.asp?main=task&id_task=599
rem Max circular score via prefix scans

use cli
use io
use numbers
use sequences
use text

arg Input text = (
  "52\n" +
  "a b c d e f g h i j k l m " +
  "n o p q r s t u v w x y z\n" +
  "a b c d e f g h i j k l m " +
  "n o p q r s t u v w x y z"
)

Raw = Input split "\n" join " "
Raw = Raw split "\r" join " "
Tok = Raw split " "
Tok = Tok (Tok not equal "")

N = Tok 0 integer
Letters = Tok (1 till (N + 1))
Chars = (Letters join "") bytes
V = (Chars integer) - 96

K = N // 2
J = 0 till N
Dj = J min (N - J)

Score = array shape N fill 0

Occ = array shape 26 fill false
for C in V
  Occ (C - 1) = true
end

Present = (0 till 26) Occ
I = 0 till (N - 1)
Zero = array 0

for C in Present
  Eq = V equal (C + 1)
  Mask = Eq integer
  Dbl = concat Zero Mask Mask
  P = Dbl scan +

  EqDj = Dj Eq
  S0 = EqDj sum

  P1 = P (I + N + 1)
  P2 = P (I + N - K + 1)
  Plus = P1 - P2

  P3 = P (I + K + 1)
  P4 = P (I + 1)
  Minus = P3 - P4

  Delta = Plus - Minus
  Cum = Delta scan +
  RestS = S0 + Cum
  S0Arr = array S0
  Sc = concat S0Arr RestS

  Weight = (V - (C + 1)) abs
  Score = Score + Weight * Sc
end

BestScore = 0
BestPos = 1
if N greater 1
  BestScore = Score max
  MaxIdx = (Score max .index) + 1
  BestPos = MaxIdx
end

BestScore print

StrScore = BestScore text
StrPos = BestPos text
Ans = StrScore + "\n" + StrPos
return record
  .best_pos = BestPos
  .best_score = BestScore
end
