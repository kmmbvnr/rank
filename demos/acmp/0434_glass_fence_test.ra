use testing

test "sample 1: L-shaped 6 vertices"
  use "0434_glass_fence" as solve
  Out = solve "6
0 0
2 0
2 1
1 1
1 2
0 2"
  AnswerCount = Out .answer_count
  AnswerVertices = Out .answer_vertices

  AnswerCount equal 6
  AnswerVertices equal (array shape 6 2
    0 0
    2 0
    2 1
    1 1
    1 2
    0 2
  end)
end

test "U-shaped swamp dent filled"
  use "0434_glass_fence" as solve
  I1 = "8\n0 0\n3 0\n3 2\n"
  I2 = "2 2\n2 1\n1 1\n1 2\n0 2"
  Out = solve (I1 + I2)
  AnswerCount = Out .answer_count
  AnswerVertices = Out .answer_vertices

  AnswerCount equal 4
  AnswerVertices equal (array shape 4 2
    0 0
    3 0
    3 2
    0 2
  end)
end

test "rectangle swamp unchanged"
  use "0434_glass_fence" as solve
  Out = solve "4\n0 0\n5 0\n5 3\n0 3"
  AnswerCount = Out .answer_count
  AnswerVertices = Out .answer_vertices

  AnswerCount equal 4
  AnswerVertices equal (array shape 4 2
    0 0
    5 0
    5 3
    0 3
  end)
end

test "staircase 3 steps"
  use "0434_glass_fence" as solve
  I1 = "8\n0 0\n3 0\n3 1\n"
  I2 = "2 1\n2 2\n1 2\n1 3\n0 3"
  Out = solve (I1 + I2)
  AnswerCount = Out .answer_count
  AnswerVertices = Out .answer_vertices

  AnswerCount equal 8
  AnswerVertices equal (array shape 8 2
    0 0
    3 0
    3 1
    2 1
    2 2
    1 2
    1 3
    0 3
  end)
end
