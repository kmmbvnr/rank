use io
use sequences
use linalg
use cli
use text

rem ACMP 723: Mushroom Delivery
rem Max delivery time from node 1 to
rem all nodes without revisiting target.

arg Input text = "6 7
1 2 2
2 3 3
1 3 1
3 4 1
4 5 2
5 3 1
3 6 1"

Tokens = Input words integer
N = Tokens 0
M = Tokens 1

NN = N * N
A = (
  (array shape NN fill false)
  reshape N N)
INF = 1000000000
W = (
  (array shape NN fill (-INF))
  reshape N N)

Idx = 2
for E in 0 to (M - 1)
  U = (Tokens Idx) - 1
  V = (Tokens (Idx + 1)) - 1
  Wt = Tokens (Idx + 2)
  A U V = true
  W U V = (W U V) max Wt
  Idx = Idx + 3
end

AT = (A transpose) integer
AInt = A integer

Ans = array shape (N - 1) fill (-1)

for D in 1 to (N - 1)
  Vis = array shape N fill false
  Vis 0 = true
  for Step in 0 to (N - 1)
    VisInt = (Vis integer) reshape 1 N
    NxtRow = (VisInt matmul AInt) 0
    Nxt = NxtRow greater 0
    Nxt D = false
    NewVis = Vis or Nxt
    Eq = (NewVis equal Vis) reduce and
    if Eq
      break
    end
    Vis = NewVis
  end

  Rev = array shape N fill false
  Rev D = true
  for Step in 0 to (N - 1)
    RevInt = (Rev integer) reshape 1 N
    RevRow = (RevInt matmul AT) 0
    NxtR = RevRow greater 0
    NxtR D = false
    NewRev = Rev or NxtR
    EqR = (NewRev equal Rev) reduce and
    if EqR
      break
    end
    Rev = NewRev
  end

  CanReach = Rev 0
  if not CanReach
    Ans (D - 1) = -1
  else
    InSub = Vis and Rev
    RowM = InSub reshape N 1
    ColM = InSub reshape 1 N
    SubA = (A and RowM and ColM) integer
    InDeg = SubA reduce + axis 0
    Rem = InSub
    DP = array shape N fill (-INF)
    DP 0 = 0
    HasDirect = (W 0 D) greater (-INF)
    W0D = W 0 D
    Best = HasDirect choose W0D (-INF)

    for Step in 0 to (N - 1)
      ZeroIn = InDeg equal 0
      Front = Rem and ZeroIn
      if (Front count) equal 0
        break
      end
      FrontInt = (Front integer)
      FrontRow = FrontInt reshape 1 N
      Decr = (FrontRow matmul SubA) 0
      InDeg = InDeg - Decr
      Rem = Rem and (not Front)

      DPF = Front choose DP (-INF)
      Cand = (DPF reshape N 1) + W
      MaxCand = Cand reduce max axis 0
      SubCand = (
        InSub choose MaxCand (-INF))
      DP = DP max SubCand
      Best = Best max (MaxCand D)
    end

    HasCycle = (Rem count) greater 0
    Res = HasCycle choose (-1) Best
    Ans (D - 1) = Res
  end
end

return Ans
