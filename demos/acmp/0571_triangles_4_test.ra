rem ACMP 0571: Triangles - 4 tests
use testing

test "Sample polygon (8)"
  use "0571_triangles_4" as solve
  Total = solve "8
1 1 3 2 4 4 6 5"
  Total equal 8
end

test "Single unit triangle UP (1)"
  use "0571_triangles_4" as solve
  Total = solve "3
1 3 5"
  Total equal 1
end

test "Equilateral triangle size 2 UP"
  use "0571_triangles_4" as solve
  Total = solve "6
1 1 3 3 5 5"
  Total equal 5
end

test "Rhombus / Parallelogram (3)"
  use "0571_triangles_4" as solve
  Total = solve "4
1 2 4 5"
  Total equal 2
end
