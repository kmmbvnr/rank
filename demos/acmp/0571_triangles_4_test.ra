rem ACMP 0571: Triangles - 4 tests
use testing

test "ACMP 571: Sample polygon (8)"
  use "0571_triangles_4"
  Input = "8
1 1 3 2 4 4 6 5"
  run
  Total equal 8
end

test "ACMP 571: Single unit triangle UP (1)"
  use "0571_triangles_4"
  Input = "3
1 3 5"
  run
  Total equal 1
end

test "ACMP 571: Equilateral triangle size 2 UP (5)"
  use "0571_triangles_4"
  Input = "6
1 1 3 3 5 5"
  run
  Total equal 5
end

test "ACMP 571: Rhombus / Parallelogram (3)"
  use "0571_triangles_4"
  Input = "4
1 2 4 5"
  run
  Total equal 2
end
