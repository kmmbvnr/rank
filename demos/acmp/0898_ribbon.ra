rem Ribbon
rem https://acmp.ru/
rem   index.asp?main=task&id_task=898
rem Fold crease orientations via D&C

use io
use numbers
use cli
use sequences
use text
use bits

arg Input text = (
  "20\n" +
  "PZPZPZPZPZPZPZPZPZPZ\n" +
  "10 " +
  "1 2 524288 100 200 1000 50000 " +
  "1048575 500000 750000"
)

Raw = (
  (Input split "\n" join " ")
  split "\r" join " "
)
Tok = Raw split " "
Tokens = Tok (Tok not equal "")

N = Tokens 0 integer
S = Tokens 1
KCount = Tokens 2 integer

QEnd = 3 + KCount
Queries = (
  Tokens (3 till QEnd)
) integer

SChars = S split ""
SRev = SChars reverse

TotalLen = 1 shl N

OutChars = array shape KCount fill ""

for QIdx in 0 till KCount
  Q = Queries QIdx
  X = TotalLen - Q
  Inv = 0
  AnsChar = "?"

  for Step in 0 till N
    CurN = N - Step
    Shift = CurN - 1
    Mid = 1 shl Shift
    if X equal Mid
      Base = "O"
      if (SRev Shift) equal "Z"
        Base = "K"
      end
      if (Inv mod 2) equal 1
        if Base equal "K"
          Base = "O"
        else
          Base = "K"
        end
      end
      AnsChar = Base
      break
    end
    if X greater Mid
      X = (Mid * 2) - X
      Inv = Inv + 1
    end
  end

  OutChars QIdx = AnsChar
end

return OutChars join ""
