rem Tests for ACMP 0998: Bike Paths

use testing

test "ACMP 998: Sample 1"
  use "0998_bike_paths"
  Input = "20 5
5 0 5 20
2 1"
  run

  (Result - 16.575734) abs less 0.0001
end

test "ACMP 998: Sample 2"
  use "0998_bike_paths"
  Input = "20 5
-5 0 5 20
2 1"
  run

  (Result - 17.204052) abs less 0.0001
end

test "ACMP 998: Default input"
  use "0998_bike_paths"
  run

  Result greater 0.0
end
