rem Maharaja
rem https://acmp.ru/index.asp?main=task&id_task=101
rem Count non-attacking maharajas

use io
use cli
use numbers
use sequences

arg N integer = 3
arg K integer = 1

fun Free solve Need
  if Need equal 0
    return 1
  end
  if Need equal 1
    return Free len
  end
  Rows = Free // N
  if Rows unique len less Need
    return 0
  end

  Row = Rows first
  Tail = Free (Rows greater Row)
  Dr = Tail // N - Row
  rem Also count placements skipping Row
  Total = Tail solve Need

  rem Place one piece in the first row
  for Cell in Free (Rows equal Row)
    Col = Cell mod N
    Dc = Tail mod N - Col abs
    Valid = Dc not equal 0
    Valid and= Dr not equal Dc
    rem A knight move has Dr * Dc = 2
    Valid and= Dr * Dc not equal 2
    Total += Tail Valid solve (Need - 1)
  end
  return Total
end

Free = 0 till (N * N)
Answer = Free solve K
Answer print
