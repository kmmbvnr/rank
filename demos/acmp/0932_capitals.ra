rem ACMP 0932: Capitals
rem Equidistant triples on a tree via
rem Long-Path Decomposition (O(N))
use io
use cli
use numbers
use sequences
use text

arg Input text = "7 2
1 2
1 3
1 4
5 1
5 6
5 7"

Clean = Input split "\r" join " "
Clean = Clean split "\n" join " "
Tokens = Clean split " "
Tokens = Tokens (Tokens not equal "")
Nums = Tokens integer

N = Nums 0
D = Nums 1
RemD = D mod 2

TotalAns = 0
if (RemD equal 0) and (N greater 2)
  R = D // 2
  M = N - 1
  EdgeNums = Nums (2 till (2 + (2 * M)))
  Edges = EdgeNums reshape M 2
  EdgesT = Edges transpose
  EU = EdgesT 0
  EV = EdgesT 1

  Head = array shape (N + 1) fill -1
  To = array shape (2 * M) fill 0
  Nxt = array shape (2 * M) fill -1

  Vis = array shape (N + 1) fill 0
  Par = array shape (N + 1) fill 0
  Order = array shape N fill 0
  Queue = array shape N fill 0
  Height = array shape (N + 1) fill 0
  Heavy = array shape (N + 1) fill 0

  SubCnt = array shape N fill 0
  Base = array shape (N + 1) fill 0
  S2Arr = array shape (N + 1) fill 0
  UpR = array shape (N + 1) fill 0
  CurPos = 0

  Phase = 0
  Step = 0
  QHead = 0
  QTail = 1
  Queue 0 = 1
  Vis 1 = 1
  H = -1
  U = 1
  W = 1
  J = 0
  WLen = 0
  BU = 0
  BW = 0
  CW = 0
  S1 = 0
  S2 = 0
  CntR = 0
  CurV = 1
  PrvV = 0
  DistK = 1
  RemK = 0
  UpC = 0

  for Phase less 10
    if Phase equal 0
      if Step less M
        U0 = EU Step
        V0 = EV Step
        H0 = 2 * Step
        H1 = H0 + 1
        To H0 = V0
        Nxt H0 = Head U0
        Head U0 = H0
        To H1 = U0
        Nxt H1 = Head V0
        Head V0 = H1
        Step = Step + 1
      else
        Phase = 1
      end
    elif Phase equal 1
      if QHead less QTail
        U0 = Queue QHead
        Order QHead = U0
        QHead = QHead + 1
        H = Head U0
        Phase = 2
      else
        Step = N - 1
        Phase = 3
      end
    elif Phase equal 2
      if H greater -1
        V0 = To H
        H = Nxt H
        if (Vis V0) equal 0
          Vis V0 = 1
          Par V0 = Queue (QHead - 1)
          Queue QTail = V0
          QTail = QTail + 1
        end
      else
        Phase = 1
      end
    elif Phase equal 3
      if Step greater -1
        U0 = Order Step
        P0 = Par U0
        HU = Height U0
        if P0 greater 0
          HP = Height P0
          if (HU + 1) greater HP
            Height P0 = HU + 1
            Heavy P0 = U0
          end
        end
        Step = Step - 1
      else
        Step = 0
        Phase = 4
      end
    elif Phase equal 4
      if Step less N
        U0 = Order Step
        P0 = Par U0
        if (P0 equal 0) or (
          (Heavy P0) not equal U0
        )
          Base U0 = CurPos
          CurPos = (
            CurPos + ((Height U0) + 1)
          )
        else
          Base U0 = (Base P0) + 1
        end
        Step = Step + 1
      else
        Step = N - 1
        Phase = 5
      end
    elif Phase equal 5
      if Step greater -1
        U = Order Step
        HV = Heavy U
        BU = Base U
        SubCnt BU = 1
        if HV equal 0
          Step = Step - 1
        else
          CntR = 0
          if (Height U) greater (R - 1)
            CntR = SubCnt (BU + R)
          end
          S1 = CntR
          S2 = 0
          H = Head U
          Phase = 6
        end
      else
        Step = 1
        Phase = 8
      end
    elif Phase equal 6
      if H greater -1
        W = To H
        H = Nxt H
        if (W not equal (Par U)) and (
          W not equal (Heavy U)
        )
          BW = Base W
          WLen = (Height W) + 1
          CW = 0
          if WLen greater (R - 1)
            CW = SubCnt (BW + (R - 1))
          end
          TotalAns = TotalAns + (
            S2 * CW
          )
          S2 = S2 + (S1 * CW)
          S1 = S1 + CW
          J = 0
          Phase = 7
        end
      else
        S2Arr U = S2
        Step = Step - 1
        Phase = 5
      end
    elif Phase equal 7
      if J less WLen
        IdxU = BU + (J + 1)
        IdxW = BW + J
        SubCnt IdxU = (
          (SubCnt IdxU) + (SubCnt IdxW)
        )
        J = J + 1
      else
        Phase = 6
      end
    elif Phase equal 8
      if Step less N
        U = Order Step
        if (S2Arr U) greater 0
          PrvV = U
          CurV = Par U
          DistK = 1
          UpC = 0
          Phase = 9
        else
          Step = Step + 1
        end
      else
        Phase = 10
      end
    elif Phase equal 9
      if (CurV greater 0) and (
        DistK less (R + 1)
      )
        RemK = R - DistK
        BV = Base CurV
        if (Height CurV) greater (
          RemK - 1
        )
          UpC = UpC + (
            SubCnt (BV + RemK)
          )
        end
        if RemK greater 0
          BP = Base PrvV
          if (Height PrvV) greater (
            RemK - 2
          )
            UpC = UpC - (
              SubCnt (
                BP + (RemK - 1)
              )
            )
          end
        end
        PrvV = CurV
        CurV = Par CurV
        DistK = DistK + 1
      else
        TotalAns = TotalAns + (
          (S2Arr U) * UpC
        )
        Step = Step + 1
        Phase = 8
      end
    end
  end
end

Result = TotalAns text
Result print
