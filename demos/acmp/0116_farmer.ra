rem Farmer 2
rem https://acmp.ru/index.asp?main=task&id_task=116
rem Largest rectangle of free cells

use sequences
use text
use io
use cli

arg Grid text = "1011011111 0111111110 1111111111 1011111111 1101110111"

Rows = Grid split " "
M = Rows first len
Cols = 1 to M

Heights = array shape M fill 0
Left = array shape M fill 0
Right = array shape M fill (M + 1)
Answer = 0

for Row in Rows
  On = Row split "" integer rank 0
  Off = 1 - On
  Heights = (Heights + 1) * On

  rem Nearest zeros bound each row's run
  Starts = Cols * Off scan max
  Ends = Cols * Off + (M + 1) * On
  Limits = (Ends reverse) scan min
  Stops = Limits reverse

  rem Intersect bounds over each height
  Left = (Left max Starts) * On
  Right = Right min Stops
  Right (Off equal 1) = M + 1

  Areas = (Right - Left - 1) * Heights
  Answer = Answer max (Areas max)
end

Answer print
