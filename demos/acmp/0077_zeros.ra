rem Zeros
rem acmp.ru: task 77
rem Count numbers with K binary zeros

use io
use cli
use sequences
use numbers
use bits

arg N integer = 1000000000
arg K integer = 15

Bits = N binary integer rank 0
L = Bits len

rem Count numbers shorter than N
Shorter = K till L - 1 binomial K sum

rem Count same-length numbers below N
Tail = Bits drop 1
Rest = L - 2 to 0 by -1
Need = K - 1 - (1 - Tail scan +)

Valid = Tail equal 1
Valid and= Need at least 0
Valid and= Need at most Rest

Terms = Rest Valid binomial Need Valid
Same = Terms sum

Answer = Shorter + Same
ZerosCount = 1 - Bits sum
if ZerosCount equal K
  Answer += 1
end

Answer print
