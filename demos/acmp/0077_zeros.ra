rem Zeros
rem https://acmp.ru/index.asp?main=task&id_task=77
rem Count numbers with K binary zeros

use io
use cli
use sequences
use numbers
use bits

arg N integer = 8
arg K integer = 1

Bits = N binary integer rank 0
L = Bits len

rem Count numbers shorter than N
Shorter = K till (L - 1) binomial K sum

rem Count same-length numbers below N
Tail = Bits drop 1
Rest = L - 2 to 0 by -1
Need = K - 1 - (1 - Tail scan +)

Valid = Tail equal 1
Valid and= Need at least 0
Valid and= Need at most Rest

Same = Rest Valid binomial (Need Valid) sum

Answer = Shorter + Same
if 1 - Bits sum equal K
  Answer += 1
end

Answer print
