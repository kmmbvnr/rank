rem Tests for ACMP 0599 TV Show

use testing

test "default N = 20"
  use "0599_tv_show"
  run

  BestScore equal 1250
  BestPos equal 1
end

test "sample 1: 4 r e a r"
  use "0599_tv_show"
  Input = "4
r e a r"
  run

  BestScore equal 55
  BestPos equal 3
end

test "single sector"
  use "0599_tv_show"
  Input = "1
z"
  run

  BestScore equal 0
  BestPos equal 1
end

test "two sectors"
  use "0599_tv_show"
  Input = "2
a z"
  run

  BestScore equal 25
  BestPos equal 1
end
