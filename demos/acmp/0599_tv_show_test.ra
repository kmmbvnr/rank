rem Tests for ACMP 0599 TV Show

use testing

test "default N = 20"
  use "0599_tv_show" as solve
  Out = solve (
    "20\n" +
    "a z a z a z a z a z\n" +
    "a z a z a z a z a z"
  )
  BestPos = Out .best_pos
  BestScore = Out .best_score

  BestScore equal 1250
  BestPos equal 1
end

test "sample 1: 4 r e a r"
  use "0599_tv_show" as solve
  Out = solve "4
r e a r"
  BestPos = Out .best_pos
  BestScore = Out .best_score

  BestScore equal 55
  BestPos equal 3
end

test "single sector"
  use "0599_tv_show" as solve
  Out = solve "1
z"
  BestPos = Out .best_pos
  BestScore = Out .best_score

  BestScore equal 0
  BestPos equal 1
end

test "two sectors"
  use "0599_tv_show" as solve
  Out = solve "2
a z"
  BestPos = Out .best_pos
  BestScore = Out .best_score

  BestScore equal 25
  BestPos equal 1
end
