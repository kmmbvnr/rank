use testing

test "sample 1: 20 bulbs, boys 2 3 8"
  use "0337_lightbulbs" as solve
  Answer = solve "20 3\n2 3 8"

  Answer equal 8
end

test "sample 2: 172 bulbs, 10 boys"
  use "0337_lightbulbs" as solve
  I1 = "172 10\n19 2 7 13 40 "
  I2 = "23 16 1 45 9"
  Answer = solve (I1 + I2)

  Answer equal 99
end

test "duplicate periods cancel out"
  use "0337_lightbulbs" as solve
  Answer = solve "10 2\n3 3"

  Answer equal 0
end

test "large N 10^9 with periods 2 4"
  use "0337_lightbulbs" as solve
  Answer = solve "1000000000 2\n2 4"

  Answer equal 250000000
end
