rem 2-3 Tree (2-3 Дерево)
rem ACMP 752
rem Count 2-3 trees with L leaves mod R
rem Rolling Pascal row mod R

use io
use text
use cli
use sequences

arg Input text = "6 1000000000"

Lines = Input split "\n"
Line = Lines join " "
Tokens = Line split " "
Tokens = Tokens (Tokens not equal "")

L = (Tokens 0) integer
R = (Tokens 1) integer

T = array shape (3 * L + 3) fill 0
T 1 = 1 mod R

Zero = array shape 1 fill 0
Row = array shape 2 fill 1

Limit = L // 2 + 1
for M in 1 till Limit
  Spots = (2 * M) till (3 * M + 1)
  AddRow = (T M) * Row
  NewVal = (T Spots) + AddRow
  T Spots = NewVal mod R
  R1 = concat Row Zero
  R2 = concat Zero Row
  Row = (R1 + R2) mod R
end

(T L text) print
return T
