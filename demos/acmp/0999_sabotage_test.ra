rem Tests for ACMP 0999: Sabotage

use testing

test "ACMP 999: Sample 1"
  use "0999_sabotage"
  Input = "6 7
1 2 1
2 3 1
1 4 0
3 4 1
4 5 1
3 6 0
5 6 1"
  run

  Result equal 4
end

test "ACMP 999: Triangle"
  use "0999_sabotage"
  Input = "3 3
1 2 1
2 3 1
1 3 0"
  run

  Result equal 2
end

test "ACMP 999: Double cover"
  use "0999_sabotage"
  Input = "4 5
1 2 1
2 3 1
3 4 1
1 4 0
2 4 0"
  run

  Result equal 1
end

test "ACMP 999: Disjoint dirt covers"
  use "0999_sabotage"
  Input = "5 6
1 2 1
2 3 1
3 4 1
4 5 1
1 3 0
3 5 0"
  run

  Result equal 4
end
