rem New Year (Cinema for Elves)
rem https://acmp.ru/
rem   index.asp?main=task&id_task=615
rem Min weight edge cover in bipartite

use io
use numbers
use cli
use sequences
use text

arg Input text = (
  "8 8\n" +
  "20\n" +
  "1 1 5\n" +
  "1 2 4\n" +
  "2 2 6\n" +
  "2 3 3\n" +
  "3 3 7\n" +
  "3 4 2\n" +
  "4 4 8\n" +
  "4 5 5\n" +
  "5 5 9\n" +
  "5 6 4\n" +
  "6 6 6\n" +
  "6 7 3\n" +
  "7 7 8\n" +
  "7 8 2\n" +
  "8 8 7\n" +
  "8 1 4\n" +
  "1 5 10\n" +
  "2 6 9\n" +
  "3 7 8\n" +
  "4 8 11"
)

Tokens = (
  (Input split "\n" join " ")
  split " "
)
Tokens = Tokens (Tokens not equal "")
N = Tokens 0 integer
M = Tokens 1 integer
R = Tokens 2 integer

EdgeData = Tokens drop 3 integer
Idx = (0 till R) * 3
Uarr = EdgeData Idx
Varr = EdgeData (Idx + 1)
Warr = EdgeData (Idx + 2)

INF = 1000000000

Cu = array shape (N + 1) fill INF
BestEu = array shape (N + 1) fill 0
Cv = array shape (M + 1) fill INF
BestEv = array shape (M + 1) fill 0

for I in 0 till R
  Eid = I + 1
  U = Uarr I
  V = Varr I
  W = Warr I

  if W less (Cu U)
    Cu U = W
    BestEu U = Eid
  end
  if W less (Cv V)
    Cv V = W
    BestEv V = Eid
  end
end

Dim = (N + 1) * (M + 1)
ZeroMat = array shape Dim fill 0
BestS = ZeroMat reshape (N + 1) (M + 1)
ZeroIdx = array shape Dim fill 0
BestIdx = (
  ZeroIdx reshape (N + 1) (M + 1)
)

for I in 0 till R
  Eid = I + 1
  U = Uarr I
  V = Varr I
  W = Warr I
  S = (Cu U) + (Cv V) - W
  if S greater (BestS U V)
    BestS U V = S
    BestIdx U V = Eid
  end
end

MatchB = array shape (N + 1) fill 0
MatchG = array shape (M + 1) fill 0

NegINF = 0 - INF
for Step in 0 till N
  DB = array shape (N + 1) fill NegINF
  DG = array shape (M + 1) fill NegINF
  PrevG = array shape (M + 1) fill 0

  for U in 1 till (N + 1)
    if MatchB U equal 0
      DB U = 0
    end
  end

  MaxIters = N + M + 2
  for Iter in 0 till MaxIters
    Updated = false

    for U in 1 till (N + 1)
      if DB U greater -100000000
        for V in 1 till (M + 1)
          Gain = BestS U V
          Unm = not (MatchB U equal V)
          if (Gain greater 0) and Unm
            CandG = (DB U) + Gain
            if CandG greater (DG V)
              DG V = CandG
              PrevG V = U
              Updated = true
            end
          end
        end
      end
    end

    for V in 1 till (M + 1)
      HasMG = MatchG V greater 0
      DGV = DG V greater -100000000
      if HasMG and DGV
        U = MatchG V
        CostUV = BestS U V
        CandB = (DG V) - CostUV
        if CandB greater (DB U)
          DB U = CandB
          Updated = true
        end
      end
    end

    if not Updated
      break
    end
  end

  BestV = 0
  BestGain = 0
  for V in 1 till (M + 1)
    UnmG = MatchG V equal 0
    BigG = DG V greater BestGain
    if UnmG and BigG
      BestGain = DG V
      BestV = V
    end
  end

  Stop1 = BestV equal 0
  Stop2 = not (BestGain greater 0)
  if Stop1 or Stop2
    break
  end

  CurrV = BestV
  for true
    if CurrV equal 0
      break
    end
    U = PrevG CurrV
    NextV = MatchB U
    MatchB U = CurrV
    MatchG CurrV = U
    CurrV = NextV
  end
end

Chosen = array shape (R + 1) fill 0

for U in 1 till (N + 1)
  if MatchB U greater 0
    V = MatchB U
    Eid = BestIdx U V
    Chosen Eid = 1
  end
end

for U in 1 till (N + 1)
  if MatchB U equal 0
    Eid = BestEu U
    Chosen Eid = 1
  end
end

for V in 1 till (M + 1)
  if MatchG V equal 0
    Eid = BestEv V
    Chosen Eid = 1
  end
end

AllEids = 1 till (R + 1)
ChosenMask = Chosen drop 1 equal 1
ChosenIdx = AllEids ChosenMask
NumChosen = ChosenIdx len

ChosenW = Warr (ChosenIdx - 1)
TotalCost = ChosenW sum

TotalCost print
AnswerEdges = ChosenIdx join " "
return record
  .answer_edges = AnswerEdges
  .num_chosen = NumChosen
  .total_cost = TotalCost
end
