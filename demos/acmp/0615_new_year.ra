rem New Year (Cinema for Elves)
rem https://acmp.ru/index.asp?main=task&id_task=615
rem Minimum weight edge cover in bipartite graph via maximum savings matching

use io
use numbers
use cli
use sequences
use text

arg Input text = "3 3\n7\n1 1 3\n1 2 2\n1 3 4\n2 1 3\n2 2 9\n3 1 2\n3 3 11"

Tokens = Input split "\n" join " " split " "
Tokens = Tokens (Tokens not equal "")
N = (Tokens 0) integer
M = (Tokens 1) integer
R = (Tokens 2) integer

EdgeData = (Tokens drop 3) integer
Idx = (0 till R) * 3
Uarr = EdgeData Idx
Varr = EdgeData (Idx + 1)
Warr = EdgeData (Idx + 2)

INF = 1000000000

Cu = array shape (N + 1) fill INF
BestEu = array shape (N + 1) fill 0
Cv = array shape (M + 1) fill INF
BestEv = array shape (M + 1) fill 0

for I in 0 till R
  Eid = I + 1
  U = Uarr I
  V = Varr I
  W = Warr I

  if W less (Cu U)
    Cu U = W
    BestEu U = Eid
  end
  if W less (Cv V)
    Cv V = W
    BestEv V = Eid
  end
end

Dim = (N + 1) * (M + 1)
BestS = (array shape Dim fill 0) reshape (N + 1) (M + 1)
BestIdx = (array shape Dim fill 0) reshape (N + 1) (M + 1)

for I in 0 till R
  Eid = I + 1
  U = Uarr I
  V = Varr I
  W = Warr I
  S = (Cu U) + (Cv V) - W
  if S greater (BestS U V)
    BestS U V = S
    BestIdx U V = Eid
  end
end

MatchB = array shape (N + 1) fill 0
MatchG = array shape (M + 1) fill 0

for Step in 0 till N
  DB = array shape (N + 1) fill (0 - INF)
  DG = array shape (M + 1) fill (0 - INF)
  PrevG = array shape (M + 1) fill 0

  for U in 1 till (N + 1)
    if (MatchB U) equal 0
      DB U = 0
    end
  end

  MaxIters = N + M + 2
  for Iter in 0 till MaxIters
    Updated = false

    for U in 1 till (N + 1)
      if (DB U) greater -100000000
        for V in 1 till (M + 1)
          Gain = BestS U V
          if (Gain greater 0) and (not ((MatchB U) equal V))
            CandG = (DB U) + Gain
            if CandG greater (DG V)
              DG V = CandG
              PrevG V = U
              Updated = true
            end
          end
        end
      end
    end

    for V in 1 till (M + 1)
      if ((MatchG V) greater 0) and ((DG V) greater -100000000)
        U = MatchG V
        CandB = (DG V) - (BestS U V)
        if CandB greater (DB U)
          DB U = CandB
          Updated = true
        end
      end
    end

    if not Updated
      break
    end
  end

  BestV = 0
  BestGain = 0
  for V in 1 till (M + 1)
    if ((MatchG V) equal 0) and ((DG V) greater BestGain)
      BestGain = DG V
      BestV = V
    end
  end

  if (BestV equal 0) or (not (BestGain greater 0))
    break
  end

  CurrV = BestV
  for true
    if CurrV equal 0
      break
    end
    U = PrevG CurrV
    NextV = MatchB U
    MatchB U = CurrV
    MatchG CurrV = U
    CurrV = NextV
  end
end

Chosen = array shape (R + 1) fill 0

for U in 1 till (N + 1)
  if (MatchB U) greater 0
    V = MatchB U
    Eid = BestIdx U V
    Chosen Eid = 1
  end
end

for U in 1 till (N + 1)
  if (MatchB U) equal 0
    Eid = BestEu U
    Chosen Eid = 1
  end
end

for V in 1 till (M + 1)
  if (MatchG V) equal 0
    Eid = BestEv V
    Chosen Eid = 1
  end
end

AllEids = 1 till (R + 1)
ChosenMask = (Chosen drop 1) equal 1
ChosenIdx = AllEids ChosenMask
NumChosen = ChosenIdx len

ChosenW = Warr (ChosenIdx - 1)
TotalCost = ChosenW sum

TotalCost print
NumChosen print
AnswerEdges = ChosenIdx join " "
AnswerEdges print
