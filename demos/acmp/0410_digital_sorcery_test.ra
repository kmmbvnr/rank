use testing

test "sample 1: N = 5, M = 8"
  use "0410_digital_sorcery"
  run

  Answer equal "11"
end

test "sample 2: N = 6, M = 15"
  use "0410_digital_sorcery"
  N = 6
  M = 15
  run

  Answer equal "24"
end

test "already divisible: N = 0, M = 8"
  use "0410_digital_sorcery"
  N = 0
  M = 8
  run

  Answer equal "0"
end

test "power of 10 solution: N = 2, M = 7"
  use "0410_digital_sorcery"
  N = 2
  M = 7
  run

  Answer equal "100000"
end

test "single digit solution: N = 7, M = 10"
  use "0410_digital_sorcery"
  N = 7
  M = 10
  run

  Answer equal "3"
end
