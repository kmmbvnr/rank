rem String Computer
rem https://acmp.ru/
rem   index.asp?main=task&id_task=734
rem Max non-redundant set size and count

use io
use cli
use numbers
use text

arg Input text = "100 26"

Tokens = (
  (Input split "\n" join " ")
  split " "
)
Tokens = Tokens (Tokens not equal "")
N = Tokens 0 integer
K = Tokens 1 integer

M = N // 2
MaxStrings = 0
CountSets = 0

NMod2 = N mod 2
if K equal 1
  MaxStrings = N - M
  if NMod2 equal 0
    CountSets = 2
  else
    CountSets = 1
  end
else
  Kn1 = K ** (N + 1)
  Km1 = K ** (M + 1)
  KDiff = K - 1
  NumDiff = Kn1 - Km1
  MaxStrings = NumDiff // KDiff
  if NMod2 equal 0
    CountSets = (K ** M) + 1
  else
    CountSets = 1
  end
end

MaxStrings print
CountSets print
