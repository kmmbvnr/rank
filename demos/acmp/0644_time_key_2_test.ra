  run

  Ans equal 22
end

test "sample 3: N = 2, K = 3 -> 7"
  use "0644_time_key_2"
  Input = "2 3"
  run

  Ans equal 7
end

test "boundary: N = 6, K = 1 -> 8"
  use "0644_time_key_2"
  Input = "6 1"
  run

  Ans equal 8
end

test "stress test: N = 1, K = 2000000000 -> 34179892637"
  use "0644_time_key_2"
