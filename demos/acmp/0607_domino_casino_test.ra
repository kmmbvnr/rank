rem Tests for ACMP 0607: Domino Casino

use testing

test "ACMP 607: Sample 1 (2x2 board)"
  use "0607_domino_casino"
  Input = "2 2 2
1 4
3 2"
  run

  Result equal 11
end

test "ACMP 607: Single domino"
  use "0607_domino_casino"
  Input = "1 2 1
5 6"
  run

  Result equal 30
end

test "ACMP 607: 1x3 with 1 domino"
  use "0607_domino_casino"
  Input = "1 3 1
2 10 5"
  run

  Result equal 50
end

test "ACMP 607: Default input 4x4"
  use "0607_domino_casino"
  Input = (
    "4 4 4\n" +
    "1 4 2 5\n" +
    "3 2 6 1\n" +
    "7 2 3 4\n" +
    "1 5 2 6"
  )
  run

  Result greater 0
end
