use testing
use sequences
use text

test "sample 1: single road -> 1 color"
  use "0741_wonderful_roads" as solve
  Out = solve "2 1
1 2"
  K = Out .k

  K equal 1
end

test "sample 2: path of two roads"
  use "0741_wonderful_roads" as solve
  Out = solve "3 2
1 2
2 3"
  K = Out .k
  Nc = Out .nc

  K equal 1
  Nc equal 2
end

test "sample 3: triangle -> 3 colors"
  use "0741_wonderful_roads" as solve
  use sequences
  Out = solve "3 3\n1 2\n2 3\n3 1"
  Color = Out .color
  K = Out .k
  Nc = Out .nc

  K equal 3
  Nc equal 1
  (Color sort) equal (array 1 2 3)
end

test "two triangles sharing a vertex"
  use "0741_wonderful_roads" as solve
  Out = solve "5 6
1 2
2 3
3 1
3 4
4 5
5 3"
  K = Out .k
  Nc = Out .nc

  K equal 3
  Nc equal 2
end

test "K4 is one block of 6 edges"
  use "0741_wonderful_roads" as solve
  Out = solve "4 6
1 2
1 3
1 4
2 3
2 4
3 4"
  K = Out .k
  Nc = Out .nc

  K equal 6
  Nc equal 1
end

test "triangle with tail and component"
  use "0741_wonderful_roads" as solve
  Out = solve "7 6
1 2
2 3
3 1
3 4
5 6
6 7"
  K = Out .k
  Nc = Out .nc

  K equal 3
  Nc equal 4
end

test "square with chord and bridge"
  use "0741_wonderful_roads" as solve
  Out = solve "5 6
1 2
2 3
3 4
4 1
1 3
4 5"
  K = Out .k
  Nc = Out .nc

  K equal 5
  Nc equal 2
end

test "cycle of 50000 vertices"
  use text
  use "0741_wonderful_roads" as solve
  Idx = 0 till 50000
  Flat = array shape 100000 fill 0
  Flat (Idx * 2) = Idx + 1
  NextIdx = (Idx + 1) mod 50000
  Flat ((Idx * 2) + 1) = NextIdx + 1
  EdgesStr = Flat join " "
  Out = solve ("50000 50000 " + EdgesStr)
  K = Out .k
  Nc = Out .nc

  K equal 50000
  Nc equal 1
end
