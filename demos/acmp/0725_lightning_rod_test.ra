rem Tests for ACMP 0725: Rod

use testing
use numbers

test "ACMP 725: Sample 1"
  use "0725_lightning_rod" as solve
  use numbers
  Result = solve "2 30
0 0 3 3 1
3 3 4 4 1"

  (Result - 4.898979) abs less 0.01
end

test "ACMP 725: Single building"
  use "0725_lightning_rod" as solve
  use numbers
  Result = solve "1 45
0 0 2 2 1"

  (Result - 1.414213) abs less 0.01
end

test "ACMP 725: Default input 10 boxes"
  use "0725_lightning_rod" as solve
  Result = solve

  Result greater 0.0
end
