rem Problem About XOR
rem https://acmp.ru/
rem   index.asp?main=task&id_task=563
rem Compute XOR sum of all pairs

use io
use numbers
use cli
use sequences
use text
use bits

arg Input text = (
  "30\n" +
  "2147483647\n1000000000\n" +
  "500000000\n" +
  "250000000\n125000000\n62500000\n" +
  "31250000\n15625000\n7812500\n" +
  "3906250\n1953125\n976562\n" +
  "488281\n244140\n122070\n" +
  "61035\n30517\n15258\n" +
  "7629\n3814\n1907\n" +
  "953\n476\n238\n" +
  "119\n59\n29\n" +
  "14\n7\n3"
)

Tokens = (
  Input split "\n" join " " split " "
)
Tokens = Tokens (Tokens not equal "")
N = Tokens 0 integer
A = Tokens drop 1 integer

Axor = 0
for I in 0 till N
  Axor = Axor bxor (A I)
end

Two32 = 4294967296
Half32 = Two32 // 2

U = A
NegMask = A less 0
U NegMask = (A NegMask) + Two32

Fxor = 0

for P in 0 till 32
  Mask = 0
  if P less 31
    Mask = (1 shl (P + 1)) - 1
  else
    Mask = Two32 - 1
  end

  Masked = U band Mask
  Order = Masked argsort
  S = Masked Order

  DropS = S drop 1
  TakeS = S take (N - 1)
  Diff = DropS not equal TakeS
  IdxCut = (0 till (N - 1)) Diff
  CutIdx = IdxCut + 1
  LeftB = concat (array 0) CutIdx
  Boundaries = concat LeftB (array N)
  NumCuts = Boundaries len
  DropB = Boundaries drop 1
  TakeB = (
    Boundaries take (NumCuts - 1)
  )
  Counts = DropB - TakeB
  Parities = Counts shr 1 band 1
  BitP = Parities sum mod 2

  if BitP equal 1
    if P less 31
      Fxor = Fxor bor (1 shl P)
    else
      Fxor = Fxor bor Half32
    end
  end
end

TotalXor = Axor bxor Fxor
if TotalXor at least Half32
  TotalXor = TotalXor - Two32
end

return TotalXor
