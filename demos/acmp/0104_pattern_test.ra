use testing

test "official example"
  use "0104_pattern" as solve
  Answer = solve

  Answer equal "YES"
end

test "mismatch"
  use "0104_pattern" as solve
  Answer = solve "ABBCDA" "A*Z"

  Answer equal "NO"
end

test "exact letters match"
  use "0104_pattern" as solve
  Answer = solve "HELLO" "HELLO"

  Answer equal "YES"
end

test "star matches empty"
  use "0104_pattern" as solve
  Answer = solve "A*B*C" "ABC"

  Answer equal "YES"
end
