rem Tests for ACMP 0622 Division

use testing

test "default 8 overlapping rectangles"
  use "0622_rectangular_division"
  run

  Ans equal 18
end

test "sample 1: 3 rectangles -> 6"
  use "0622_rectangular_division"
  Input = "3
10 20 50 30
40 10 50 25
40 25 80 30"
  run

  Ans equal 6
end

test "single rectangle -> 2"
  use "0622_rectangular_division"
  Input = "1
0 0 10 10"
  run

  Ans equal 2
end

test "two disjoint rectangles -> 3"
  use "0622_rectangular_division"
  Input = "2
0 0 10 10
20 20 30 30"
  run

  Ans equal 3
end

test "two intersecting rectangles -> 4"
  use "0622_rectangular_division"
  Input = "2
0 0 20 20
10 10 30 30"
  run

  Ans equal 4
end
