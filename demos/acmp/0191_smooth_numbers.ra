rem ACMP 191 - Smooth Numbers
rem Combinatorial ranking of digits.
rem Digits ordered: 1 <= d_i <= 9.
rem For length L, count is C(L + 8, 8).

use io
use cli
use numbers
use sequences

arg N integer = 2147483647

rem Counts of each length up to 70
Lengths = 1 to 70
Counts = Lengths + 8 binomial 8
PrefixSeq = Counts scan + with 0
PrefixCounts = PrefixSeq array

LessN = PrefixCounts less N
L = LessN count
PrevL = PrefixCounts (L - 1)
RemN = N - PrevL

AnswerText = ""
D = 1

for Pos in 1 to L
  RemLen = L - Pos
  Candidates = D to 9
  DiffCand = RemLen + 9 - Candidates
  Ways = DiffCand binomial RemLen
  WaysSeq = Ways scan + with 0
  CumWays = WaysSeq array
  LessRemN = CumWays less RemN
  Skip = LessRemN count
  Chosen = Candidates (Skip - 1)
  ChosenText = Chosen text
  AnswerText = AnswerText + ChosenText
  PrevSkip = CumWays (Skip - 1)
  RemN = RemN - PrevSkip
  D = Chosen
end

Answer = AnswerText integer
return Answer
