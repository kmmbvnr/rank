rem Fraction Multiplication
rem https://acmp.ru/
rem   index.asp?main=task&id_task=455
rem Multiply periodic decimal by N

use io
use cli
use sequences
use numbers
use text

arg Input text = "12.345(6789)\n99999"

Lines = Input split "\n"
Lines = Lines (Lines not equal "")
QText = Lines 0
N = Lines 1 integer

Dot = QText find "."
Open = QText find "("
Close = QText find ")"

IntPart = QText take Dot
NonPer = QText (Dot + 1 till Open)
Per = QText (Open + 1 till Close)

K = NonPer len
P = Per len

D = Per integer
NinesArr = array shape P fill "9"
Denom9 = (NinesArr join "") integer

Prod = D * N
Carry = Prod // Denom9
Rem = Prod mod Denom9

PrefixStr = IntPart + NonPer
PrefixVal = PrefixStr integer
NewPrefixVal = (
  PrefixVal * N + Carry
)
NewPrefixStr = NewPrefixVal text

PrefixLen = NewPrefixStr len
if PrefixLen less (K + 1)
  PadCount = (K + 1) - PrefixLen
  ZerosArr = (
    array shape PadCount fill "0"
  )
  PadZeros = ZerosArr join ""
  NewPrefixStr = PadZeros + NewPrefixStr
end

SplitIdx = (NewPrefixStr len) - K
NewIntPart = NewPrefixStr take SplitIdx
NewFracPart = NewPrefixStr drop SplitIdx

Answer = ""

if Rem equal 0
  for NewFracPart len greater 0
    L = NewFracPart len
    LastCh = NewFracPart (L - 1)
    if LastCh not equal "0"
      break
    end
    NewFracPart = (
      NewFracPart take (L - 1)
    )
  end
  if NewFracPart len greater 0
    Answer = (
      NewIntPart + "." + NewFracPart
    )
  else
    Answer = NewIntPart
  end
else
  RemStr = Rem text
  RemLen = RemStr len
  if RemLen less P
    PadRemCount = P - RemLen
    ZerosP = (
      array shape PadRemCount fill "0"
    )
    PadStr = ZerosP join ""
    RemStr = PadStr + RemStr
  end

  Divs = (1 to P array)
  Divs = Divs (P mod Divs equal 0)

  MinP = P
  for CandLen in Divs
    Candidate = RemStr take CandLen
    CandReps = P // CandLen
    Reps = CandReps
    CandArr = (
      array shape Reps fill Candidate
    )
    Reconstructed = CandArr join ""
    if Reconstructed equal RemStr
      MinP = CandLen
      break
    end
  end
  PerStr = RemStr take MinP

  for NewFracPart len greater 0
    FracL = NewFracPart len
    PerL = PerStr len
    LastFrac = NewFracPart (FracL - 1)
    LastPer = PerStr (PerL - 1)
    if LastFrac not equal LastPer
      break
    end
    NewFracPart = (
      NewFracPart take (FracL - 1)
    )
    RestPer = PerStr take (PerL - 1)
    PerStr = LastPer + RestPer
  end

  if NewFracPart len greater 0
    MidPart = "." + NewFracPart + "("
    PerClose = PerStr + ")"
    Answer = (
      NewIntPart + MidPart + PerClose
    )
  else
    Answer = (
      NewIntPart + ".(" + PerStr + ")"
    )
  end
end

Answer print
