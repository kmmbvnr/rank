use testing

test "sample 1: 5 radii -> 1"
  use "0558_packing" as solve
  Ans = solve "5\n2 1 5 10 20"

  Ans equal 1
end

test "n less than 4 gives 0"
  use "0558_packing" as solve
  Ans = solve "3
5 10 20"

  Ans equal 0
end

test "four equal-step radii without fit"
  use "0558_packing" as solve
  Ans = solve "4
10 11 12 13"

  Ans equal 0
end

test "small circle easily fits"
  use "0558_packing" as solve
  Ans = solve "4
1 50 100 200"

  Ans equal 1
end

test "max n = 250 (1 to 250)"
  use text
  use "0558_packing" as solve
  AllR = 1 to 250
  Ans = solve ("250 " + (AllR join " "))

  Ans equal 36472103
end
