use testing

test "sample 1: 3 stops width 1"
  use "0560_bus_stops" as solve
  Answer = solve "3 1 5\n0 1\n3 7 1 5 2"

  Answer equal "6"
end

test "sample 2: 2 stops width 3"
  use "0560_bus_stops" as solve
  Answer = solve (
    "2 3 9\n1 2\n" +
    "8 1 2 3 7 4 3 1 11"
  )

  Answer equal "14"
end

test "sample 3: impossible gap"
  use "0560_bus_stops" as solve
  Answer = solve "1 1 1\n10 10\n239"

  Answer equal "No solution."
end

test "single stop zero gaps"
  use "0560_bus_stops" as solve
  Answer = solve "1 3 3\n0 0\n5 10 15"

  Answer equal "30"
end

test "single stop variable pos"
  use "0560_bus_stops" as solve
  Answer = solve "1 1 3\n0 2\n100 1 100"

  Answer equal "1"
end

test "insufficient total length"
  use "0560_bus_stops" as solve
  Answer = solve "2 5 8\n0 5\n1 2 3 4 5 6 7 8"

  Answer equal "No solution."
end
