use testing

test "sample 1: 3 stops of width 1 along 5 meters"
  use "0560_bus_stops"
  run

  Answer equal "6"
end

test "sample 2: 2 stops of width 3 along 9 meters"
  use "0560_bus_stops"
  Input = "2 3 9\n1 2\n8 1 2 3 7 4 3 1 11"
  run

  Answer equal "14"
end

test "sample 3: impossible gap constraints yields No solution"
  use "0560_bus_stops"
  Input = "1 1 1\n10 10\n239"
  run

  Answer equal "No solution."
end

test "single stop fitting exactly with zero gaps"
  use "0560_bus_stops"
  Input = "1 3 3\n0 0\n5 10 15"
  run

  Answer equal "30"
end

test "single stop with variable positioning picks cheaper location"
  use "0560_bus_stops"
  Input = "1 1 3\n0 2\n100 1 100"
  run

  Answer equal "1"
end

test "insufficient total length yields No solution"
  use "0560_bus_stops"
  Input = "2 5 8\n0 5\n1 2 3 4 5 6 7 8"
  run

  Answer equal "No solution."
end
