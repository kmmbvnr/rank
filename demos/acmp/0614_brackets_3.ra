rem Brackets 3
rem https://acmp.ru/
rem   index.asp?main=task&id_task=614
rem Distinct regular bracket subseqs

use io
use cli
use sequences
use numbers
use text

arg S text = (
  "((())())(()())(())((()))" +
  "((())())(()())(())((()))"
)

N = S len
Chars = S split ""

N1 = N + 1
NextOpen = array shape N1 fill -1
NextClose = array shape N1 fill -1
RemClose = array shape N1 fill 0

LastOpen = -1
LastClose = -1
CloseCount = 0

RevN = (0 till N array) reverse
for I in RevN
  Ch = Chars I
  if Ch equal ")"
    CloseCount = CloseCount + 1
    LastClose = I
  else
    LastOpen = I
  end
  NextOpen I = LastOpen
  NextClose I = LastClose
  RemClose I = CloseCount
end

MaxBal = (N // 2) + 1
BalDim = MaxBal + 1
DP = array shape N1 BalDim fill 0

RevN1 = (0 to N array) reverse
for Pos in RevN1
  MaxB = RemClose Pos
  if MaxB greater MaxBal
    MaxB = MaxBal
  end
  for Bal in 0 to MaxB
    Res = 0
    if Bal equal 0
      Res = 1
    end

    NO = NextOpen Pos
    if NO greater -1
      NextP = NO + 1
      NextB = Bal + 1
      if NextB less BalDim
        RemP = (RemClose NextP) + 1
        if NextB less RemP
          AddO = DP NextP NextB
          Res = Res + AddO
        end
      end
    end

    if Bal greater 0
      NC = NextClose Pos
      if NC greater -1
        NextP = NC + 1
        NextB = Bal - 1
        RemP = (RemClose NextP) + 1
        if NextB less RemP
          AddC = DP NextP NextB
          Res = Res + AddC
        end
      end
    end

    DP Pos Bal = Res
  end
end

Answer = DP 0 0
return Answer
