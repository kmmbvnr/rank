rem Keys (Ключи)
rem ACMP 740
rem Overlapping holes under translation

use io
use text
use cli
use algo
use sequences

arg Input text = "10 10
2
1 1 2 2
3 3 4 4
1
1 1 3 3"

Txt = Input split "\r" join " "
Txt = Txt split "\n" join " "
Tok = Txt split " "
Tokens = Tok (Tok not equal "")

N = Tokens 0 integer
M = Tokens 1 integer
K1 = Tokens 2 integer

Raw1 = (Tokens drop 3 take (4 * K1))
Raw1Int = Raw1 integer
Idx1 = 0 till K1
Ax1 = Raw1Int (Idx1 * 4)
Ay1 = Raw1Int (Idx1 * 4 + 1)
Ax2 = Raw1Int (Idx1 * 4 + 2)
Ay2 = Raw1Int (Idx1 * 4 + 3)

PosK2 = 3 + (4 * K1)
K2 = Tokens PosK2 integer

Len2 = 4 * K2
Drop2 = PosK2 + 1
Raw2 = (Tokens drop Drop2 take Len2)
Raw2Int = Raw2 integer
Idx2 = 0 till K2
Bu1 = Raw2Int (Idx2 * 4)
Bv1 = Raw2Int (Idx2 * 4 + 1)
Bu2 = Raw2Int (Idx2 * 4 + 2)
Bv2 = Raw2Int (Idx2 * 4 + 3)

TotalPairs = K1 * K2

DX1 = Ax1 Bu2 outer -
DiffX1 = DX1 reshape TotalPairs
DX2 = Ax2 Bu1 outer -
DiffX2 = DX2 reshape TotalPairs
DY1 = Ay1 Bv2 outer -
DiffY1 = DY1 reshape TotalPairs
DY2 = Ay2 Bv1 outer -
DiffY2 = DY2 reshape TotalPairs

LX = (DiffX1 * 2) + 1
RX = (DiffX2 * 2) - 1
LY = (DiffY1 * 2) + 1
RY = (DiffY2 * 2) - 1

Valid = (LX at most RX) and (
  LY at most RY
)
LX = LX Valid
RX = RX Valid
LY = LY Valid
RY = RY Valid
NumRects = LX len

MaxHoles = 0

if NumRects greater 0
  AllY = concat LY RY
  SortedY = AllY sort unique
  NumY = SortedY len

  QL = SortedY lowerindex LY
  QR = SortedY lowerindex RY

  EventX = concat LX (RX + 1)
  O1 = array shape NumRects fill 1
  Om1 = array shape NumRects fill -1
  EventType = concat O1 Om1
  EventQL = concat QL QL
  EventQR = concat QR QR
  NumEvents = EventX len

  XMin = EventX min
  XOffset = 0
  if XMin less 0
    XOffset = 0 - XMin
  end

  OffX = EventX + XOffset
  EvSign = (1 - EventType) // 2
  EventKey = (OffX * 2) + EvSign
  Order = EventKey argsort
  EventX = EventX Order
  EventType = EventType Order
  EventQL = EventQL Order
  EventQR = EventQR Order

  P = 1
  for Step in 0 till 30
    if P at least NumY
      break
    end
    P = P * 2
  end

  TreeSize = 2 * P
  Cover = array shape TreeSize fill 0
  MaxVal = array shape TreeSize fill 0

  for EvIdx in 0 till NumEvents
    Val = EventType EvIdx
    L = P + (EventQL EvIdx)
    R = P + (EventQR EvIdx)
    L0 = L
    R0 = R
    for Up in 0 till 35
      if L greater R
        break
      end
      if L mod 2 equal 1
        Cover L = (Cover L) + Val
        MaxVal L = (MaxVal L) + Val
        L = L + 1
      end
      if R mod 2 equal 0
        Cover R = (Cover R) + Val
        MaxVal R = (MaxVal R) + Val
        R = R - 1
      end
      L = L // 2
      R = R // 2
    end

    CurrL = L0 // 2
    for Up in 0 till 35
      if CurrL less 1
        break
      end
      C2 = 2 * CurrL
      MC2 = MaxVal C2
      MC21 = MaxVal (C2 + 1)
      CM = MC2 max MC21
      MaxVal CurrL = (Cover CurrL) + CM
      CurrL = CurrL // 2
    end

    CurrR = R0 // 2
    for Up in 0 till 35
      if CurrR less 1
        break
      end
      C2 = 2 * CurrR
      MC2 = MaxVal C2
      MC21 = MaxVal (C2 + 1)
      CM = MC2 max MC21
      MaxVal CurrR = (Cover CurrR) + CM
      CurrR = CurrR // 2
    end

    CurAns = MaxVal 1
    if CurAns greater MaxHoles
      MaxHoles = CurAns
    end
  end
end

MaxHoles text print
