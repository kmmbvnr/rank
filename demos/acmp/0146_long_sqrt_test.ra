use testing

test "example 17 -> 4"
  use "0146_long_sqrt"
  S = "17"
  run

  Answer equal 4
end

test "perfect square 144 -> 12"
  use "0146_long_sqrt"
  S = "144"
  run

  Answer equal 12
end

test "10^40 -> 10^20"
  use "0146_long_sqrt"
  P1 = "100000000000000000000"
  P2 = "00000000000000000000"
  S = P1 + P2
  run

  Answer equal (10 ** 20)
end
