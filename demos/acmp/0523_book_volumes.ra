rem Book in Volumes
rem https://acmp.ru/
rem   index.asp?main=task&id_task=523
rem Partition N chapters into K volumes

use io
use cli
use sequences
use text

arg Input text = (
  "30\n" +
  "1000 2000 3000 4000 5000 " +
  "6000 7000 8000 9000 10000 " +
  "11000 12000 13000 14000 15000 " +
  "16000 17000 18000 19000 20000 " +
  "21000 22000 23000 24000 25000 " +
  "26000 27000 28000 29000 30000\n" +
  "10"
)

Tokens = (
  Input split "\n" join " " split " "
)
Tokens = Tokens (Tokens not equal "")

N = Tokens 0 integer
Pages = (Tokens drop 1 take N) integer
K = Tokens (N + 1) integer

Low = Pages max
High = Pages sum

for Low less High
  Mid = (Low + High) // 2
  Vols = 1
  Cur = 0
  for P in Pages
    if Cur + P greater Mid
      Vols += 1
      Cur = P
    else
      Cur += P
    end
  end

  if not (Vols greater K)
    High = Mid
  else
    Low = Mid + 1
  end
end

Answer = Low
Answer print
