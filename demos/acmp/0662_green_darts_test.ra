rem Tests for ACMP 0662: Green Darts
use testing
use text

test "ACMP 662: Sample 1 (N = 3)"
  use "0662_green_darts" as solve
  Result = solve
  Result equal 3
end

test "ACMP 662: Single player"
  use "0662_green_darts" as solve
  Result = solve "1\n10 20 30"
  Result equal 1
end

test "ACMP 662: Two identical players"
  use "0662_green_darts" as solve
  Result = solve (
    "2\n" +
    "50 50 50\n" +
    "50 50 50"
  )
  Result equal 1
end

test "ACMP 662: Two crossing players"
  use "0662_green_darts" as solve
  Result = solve (
    "2\n" +
    "0 100 0\n" +
    "0 0 50"
  )
  Result equal 3
end

