rem Tests for ACMP 0917: Fence - 3

use testing
use numbers

test "ACMP 917: Sample 1 (3 4 5)"
  use "0917_fence_3"
  Input = "3
3 4 5"
  run

  (Result - 6.0) abs less 0.01
end

test "ACMP 917: Center outside (3 4 6)"
  use "0917_fence_3"
  Input = "3
3 4 6"
  run

  (Result - 5.33268) abs less 0.01
end

test "ACMP 917: Square (4 4 4 4)"
  use "0917_fence_3"
  Input = "4
4 4 4 4"
  run

  (Result - 16.0) abs less 0.01
end

test "ACMP 917: Default 100 blocks"
  use "0917_fence_3"
  run

  Result greater 1000.0
end
