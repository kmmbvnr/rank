rem Tests for ACMP 0632 Segments

use testing
use sequences

test "default max cuts"
  use "0632_segments" as solve
  use sequences
  Ans = solve

  (Ans shape 0) equal 30
  (Ans reduce +) equal 100000000
end

test "sample 1: 3x3 with 3 cuts"
  use "0632_segments" as solve
  Ans = solve "3 3
3
1 3 1 1
1 2 4 2
2 0 2 8"

  Ans equal (array 5 2 1 1)
end

test "no cuts N=0"
  use "0632_segments" as solve
  Ans = solve "10 20
0"

  Ans equal 200
end

test "full vertical cut"
  use "0632_segments" as solve
  Ans = solve "4 4
1
2 0 2 4"

  Ans equal (array 8 8)
end

test "partial non-cutting segment"
  use "0632_segments" as solve
  Ans = solve "4 4
1
1 1 3 1"

  Ans equal 16
end
