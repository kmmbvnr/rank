rem Tram
rem https://acmp.ru/
rem   index.asp?main=task&id_task=532
rem Maximize passengers satisfaction

use io
use numbers
use cli
use sequences
use text

arg Input text = (
  "20 5 15\n" +
  "50 -20 1 10\n" +
  "45 -15 2 12\n" +
  "40 -10 3 14\n" +
  "60 -30 1 8\n" +
  "55 -25 4 15\n" +
  "30 -5 5 11\n" +
  "35 -10 6 13\n" +
  "25 -5 7 15\n" +
  "70 -40 2 9\n" +
  "65 -35 3 10\n" +
  "50 -20 8 14\n" +
  "45 -15 9 15\n" +
  "40 -10 1 6\n" +
  "35 -10 4 12\n" +
  "30 -5 6 14\n" +
  "55 -25 5 13\n" +
  "60 -30 7 15\n" +
  "20 -5 2 8\n" +
  "25 -5 3 9\n" +
  "50 -20 10 15"
)

Tokens = (
  (Input split "\n" join " ")
  split " "
)
Tokens = Tokens (Tokens not equal "")

N = Tokens 0 integer
M = Tokens 1 integer
P = Tokens 2 integer
Raw = Tokens drop 3 integer

Idx = (0 till N) * 4
A = Raw Idx
B = Raw (Idx + 1)
C = Raw (Idx + 2)
D = Raw (Idx + 3)

Hops = D - C
HopHappiness = B * Hops
BaseHappiness = HopHappiness sum

Gains = A - B
PosMask = Gains greater 0

TotalGains = 0

if PosMask any
  PosG = Gains PosMask
  PosC = C PosMask
  PosD = D PosMask

  for S in 1 till P
    InAfterStart = not (PosC greater S)
    InBeforeEnd = PosD greater S
    Active = (
      InAfterStart and InBeforeEnd
    )
    if Active any
      ActiveG = PosG Active
      RevG = ActiveG sort reverse
      TopM = RevG take M
      HopSum = TopM sum
      TotalGains = TotalGains + HopSum
    end
  end
end

MaxSatisfaction = (
  BaseHappiness + TotalGains
)

MaxSatisfaction print
