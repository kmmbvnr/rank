use testing

test "sample 1: base 5"
  use "0588_self_describing_number" as solve
  Answer = solve "5"

  Answer equal "1\n2\n0\n0\n2"
end

test "sample 2: base 2"
  use "0588_self_describing_number" as solve
  Answer = solve "2"

  Answer equal "-1"
end

test "base 3"
  use "0588_self_describing_number" as solve
  Answer = solve "3"

  Answer equal "-1"
end

test "base 4"
  use "0588_self_describing_number" as solve
  Answer = solve "4"

  Answer equal "2\n1\n0\n1"
end

test "base 6"
  use "0588_self_describing_number" as solve
  Answer = solve "6"

  Answer equal "-1"
end

test "base 7"
  use "0588_self_describing_number" as solve
  Answer = solve "7"

  Answer equal "2\n1\n1\n0\n0\n0\n3"
end

test "base 8"
  use "0588_self_describing_number" as solve
  Answer = solve "8"

  Answer equal "2\n1\n0\n1\n0\n0\n0\n4"
end

test "base 10"
  use "0588_self_describing_number" as solve
  Answer = solve "10"

  Exp = (
    "2\n1\n0\n0\n0\n" +
    "1\n0\n0\n0\n6"
  )
  Answer equal Exp
end
