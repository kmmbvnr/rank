rem Chocolate Bar
rem ACMP 510
rem Domino tilings of 3 x N rectangle

use io
use cli

arg N integer = 30

Answer = 0
if N mod 2 equal 0
  K = N // 2
  DP = array shape (K + 1) fill 0
  DP 0 = 1
  if K greater 0
    DP 1 = 3
    for I in 2 to K
      P1 = DP (I - 1)
      P2 = DP (I - 2)
      DP I = 4 * P1 - P2
    end
  end
  Answer = DP K
end

Answer print
