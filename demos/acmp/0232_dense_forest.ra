rem Dense Forest 2
rem https://acmp.ru/
rem   index.asp?main=task&id_task=232
rem Dense forest via tangent duality

use io
use cli
use sequences
use text
use numbers

arg N integer = 8
arg TreesText text = (
  "50.0 0.0 25.0 " +
  "35.36 35.36 25.0 " +
  "0.0 50.0 25.0 " +
  "-35.36 35.36 25.0 " +
  "-50.0 0.0 25.0 " +
  "-35.36 -35.36 25.0 " +
  "0.0 -50.0 25.0 " +
  "35.36 -35.36 25.0"
)

Pi = -1 acos
Eps = 1e-7

RawT = TreesText split "\n"
TP = (RawT join " ") split " "
Tokens = (TP (not (TP equal ""))) real

X = array shape N fill 0.0
Y = array shape N fill 0.0
R = array shape N fill 0.0

for I in 0 till N
  X I = Tokens (3 * I)
  Y I = Tokens (3 * I + 1)
  R I = Tokens (3 * I + 2)
end

Answer = "YES"

if N greater 1
  rem Inner common tangent angles
  Angles = array shape 0 fill 0.0
  for I in 0 till N
    XI = X I
    YI = Y I
    RI = R I
    for J in I + 1 till N
      DX = (X J) - XI
      DY = (Y J) - YI
      DistSq = (DX * DX) + (DY * DY)
      Dist = DistSq sqrt
      RadSum = RI + (R J)
      if Dist greater RadSum
        CosVal = RadSum / Dist
        if not (CosVal greater 1.0)
          Alpha = CosVal acos
          Base = DY atan2 DX
          Ang1 = Base + Alpha
          for Ang1 less 0.0
            Ang1 = Ang1 + Pi
          end
          for not (Ang1 less Pi)
            Ang1 = Ang1 - Pi
          end

          Ang2 = Base - Alpha
          for Ang2 less 0.0
            Ang2 = Ang2 + Pi
          end
          for not (Ang2 less Pi)
            Ang2 = Ang2 - Pi
          end

          PairAng = array Ang1 Ang2
          Angles = concat Angles PairAng
        end
      end
    end
  end

  AllAngles = Angles sort
  NumAngles = AllAngles len

  TestAngles = array shape 0 fill 0.0
  if NumAngles equal 0
    TestAngles = array 0.0
  else
    for K in 0 till NumAngles
      A1 = AllAngles K
      NextK = (K + 1) mod NumAngles
      A2 = AllAngles NextK
      Diff = A2 - A1
      if Diff less 0.0
        Diff = Diff + Pi
      end
      Mid = A1 + (Diff / 2.0)
      for Mid less 0.0
        Mid = Mid + Pi
      end
      for not (Mid less Pi)
        Mid = Mid - Pi
      end
      MidArr = array Mid
      TestAngles = (
        concat TestAngles MidArr
      )
    end
  end

  CanSeparate = false
  for Th in TestAngles
    UX = Th cos
    UY = Th sin
    Proj = (X * UX) + (Y * UY)
    Starts = Proj - R
    Ends = Proj + R

    Order = Starts argsort
    SStarts = Starts Order
    SEnds = Ends Order

    FirstEnd = SEnds 0
    ScanM = (
      SEnds scan max with FirstEnd
    )
    M = ScanM array
    PrevMax = (M (1 till N)) + Eps
    DropStarts = SStarts (1 till N)
    Gaps = DropStarts greater PrevMax
    if Gaps count greater 0
      CanSeparate = true
      break
    end
  end

  if CanSeparate
    Answer = "NO"
  else
    Answer = "YES"
  end
end

return Answer
