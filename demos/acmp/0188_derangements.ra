rem Derangements (Guest Seating)
rem acmp.ru: task 188
rem Permutations with no fixed points

use io
use cli

arg N integer = 20

Answer = 0
if N equal 1
  Answer = 0
elif N equal 2
  Answer = 1
else
  D = array shape (N + 1) fill 0
  D 2 = 1
  for I in 3 to N
    PrevSum = D (I - 1) + D (I - 2)
    D I = (I - 1) * PrevSum
  end
  Answer = D N
end

Answer print
