rem ACMP 289 - Divisors
rem Prime factor exponent partition.
rem Branch-and-bound search.

use io
use cli
use sequences
use numbers
use algo

arg D integer = 60

Limit = 1000000000000000
Best = Limit + 1

P1 = array 2 3 5 7 11 13 17
P2 = array 19 23 29 31 37 41
Primes = concat P1 P2

S = new stack
S push (array D 0 2 D 1)

for S len greater 0
  State = S pop
  RemD = State 0
  PIdx = State 1
  CurD = State 2
  MaxD = State 3
  CurN = State 4

  if RemD equal 1
    Best = Best min CurN
  else
    if PIdx less 13
      P = Primes PIdx
      HiD = MaxD min RemD
      if CurD less HiD
        NextSibling = CurD + 1
        Item1 = array RemD PIdx
        Item2 = array NextSibling
        Item3 = array MaxD CurN
        Item23 = concat Item2 Item3
        S push (concat Item1 Item23)
      end
      Divides = RemD mod CurD equal 0
      InBound = not (CurD greater HiD)
      if InBound and Divides
        PPow = P ** (CurD - 1)
        NextN = CurN * PPow
        if NextN less Best
          NextRemD = RemD // CurD
          NextP = PIdx + 1
          C1 = array NextRemD NextP
          C2 = array 2 CurD NextN
          S push (concat C1 C2)
        end
      end
    end
  end
end

Answer = 0
if not (Best greater Limit)
  Answer = Best
end
Answer print
