rem Digital Sorcery
rem acmp.ru: task 410
rem Minimal K: (N + K) mod M == 0.

use io
use cli
use sequences
use text
use algo

arg N integer = 5
arg M integer = 8

Answer = "0"
if N mod M not equal 0
  TargetRem = (M - (N mod M)) mod M
  INF = 1000000
  Dist = array shape M fill INF
  Q = new deque

  for D in 1 to 9
    R = D mod M
    if D less (Dist R)
      Dist R = D
      Q push (array R D 0)
    end
  end

  for Q len greater 0
    Item = Q pop
    U = Item 0
    C = Item 1
    D = Item 2

    if not (C greater (Dist U))
      if U equal TargetRem
        break
      end

      if D equal 0
        V0 = (U * 10) mod M
        if C less (Dist V0)
          Dist V0 = C
          Q pushfront (array V0 C 0)
        end
        Q pushfront (array U C 1)
      else
        V = (U * 10 + D) mod M
        NextC = C + D
        if NextC less (Dist V)
          Dist V = NextC
          Q push (array V NextC 0)
        end
        if D less 9
          NextD = D + 1
          Q pushfront (array U C NextD)
        end
      end
    end
  end

  MinSum = Dist TargetRem

  rem Step 2: BFS by length
  NumStates = M * (MinSum + 1)
  NStates = NumStates
  Minus1 = array shape NStates fill -1
  ParentState = Minus1
  ParentDigit = Minus1
  F = false
  FalseArr = array shape NStates fill F
  Reached = FalseArr
  TargetState = TargetRem * (MinSum + 1)
  TargetState = TargetState + MinSum

  InitD = 1 to (9 min MinSum)
  InitR = InitD mod M
  InitStates = InitR * (MinSum + 1)
  InitStates = InitStates + InitD
  Reached InitStates = true
  ParentDigit InitStates = InitD
  ParentState InitStates = -2
  Frontier = InitStates

  TargetReached = Reached TargetState
  HasFrontier = Frontier len greater 0
  SearchMore = not TargetReached
  for SearchMore and HasFrontier
    FLen = Frontier len
    Ones10 = array shape 10 fill 1
    AllStates = Frontier Ones10 outer *
    OnesF = array shape FLen fill 1
    AllDs = OnesF (0 to 9) outer *

    CurRem = AllStates // (MinSum + 1)
    CurSum = AllStates mod (MinSum + 1)
    NextSum = CurSum + AllDs
    Valid = not (MinSum less NextSum)

    CurRemV = CurRem Valid
    NextSumV = NextSum Valid
    CurStateV = AllStates Valid
    DsV = AllDs Valid

    NextRemV = (CurRemV * 10 + DsV)
    NextRemV = NextRemV mod M
    NextStateV = NextRemV * (MinSum + 1)
    NextStateV = NextStateV + NextSumV
    Unvisited = not (Reached NextStateV)

    NewStates = NextStateV Unvisited
    Reached NewStates = true
    Parent = CurStateV Unvisited
    ParentState NewStates = Parent
    DigitUnv = DsV Unvisited
    ParentDigit NewStates = DigitUnv
    Frontier = NewStates
    TargetReached = Reached TargetState
    HasFrontier = Frontier len greater 0
  end

  rem Reconstruct digits
  Digits = array shape 0 fill 0
  Curr = TargetState
  for Curr not equal -2
    P = ParentDigit Curr
    PArr = array P
    Digits = concat PArr Digits
    Curr = ParentState Curr
  end

  Answer = Digits join ""
end

return Answer
