rem Inscribed Circle
rem https://acmp.ru/
rem   index.asp?main=task&id_task=342
rem Inscribed circle in convex polygon

use io
use cli
use sequences
use numbers
use text

arg Input text = (
  "4\n" +
  "0 0\n" +
  "10000 0\n" +
  "10000 10000\n" +
  "0 10000"
)

Tokens = (
  Input split "\n" join " " split " "
)
Tokens = Tokens (Tokens not equal "")
N = Tokens 0 integer
Coords = Tokens drop 1 integer

Idx = 0 till N array
Xs = Coords (Idx * 2)
Ys = Coords (Idx * 2 + 1)

NextIdx = concat (1 till N) (array 0)
XNext = Xs NextIdx
YNext = Ys NextIdx

DX = XNext - Xs real
DY = YNext - Ys real
LenSq = (DX * DX) + (DY * DY)
L = LenSq sqrt

Nx = (0 - DY) / L
Ny = DX / L
ProjX = Nx * (Xs real)
ProjY = Ny * (Ys real)
C = 0 - (ProjX + ProjY)

A1 = (Nx 1) - (Nx 0)
B1 = (Ny 1) - (Ny 0)
C1 = 0 - ((C 1) - (C 0))

A2 = (Nx 2) - (Nx 0)
B2 = (Ny 2) - (Ny 0)
C2 = 0 - ((C 2) - (C 0))

Det = A1 * B2 - A2 * B1

Answer = "NO"
HasCircle = false
X = 0.0
Y = 0.0
R = 0.0

if Det abs greater 0.000000001
  X = (C1 * B2 - C2 * B1) / Det
  Y = (A1 * C2 - A2 * C1) / Det
  R = (Nx 0) * X + (Ny 0) * Y + (C 0)

  Dists = Nx * X + Ny * Y + C
  Diffs = Dists - R abs

  PosR = R greater 0.000001
  AllIn = (Dists greater 0.000001) all
  AllEq = (Diffs less 0.0001) all
  if PosR and AllIn and AllEq
    HasCircle = true
  end
end

if HasCircle
  Answer = "YES"
  Answer print
  X = X round 3
  Y = Y round 3
  R = R round 3
  OutX = X text
  OutY = Y text
  OutR = R text
  OutLine = (
    OutX + " " + OutY + " " + OutR
  )
  OutLine print
else
  Answer print
end
return record
  .answer = Answer
  .r = R
  .x = X
  .y = Y
end
