rem Tests for ACMP 0587 Expedition

use testing

test "default: 10 engines"
  use "0587_expedition_to_mors" as expedition
  Out = expedition (
    "10\n" +
    "10000.00 0.00\n" +
    "8500.50 35.20\n" +
    "9200.00 70.15\n" +
    "7400.00 110.00\n" +
    "9900.00 160.40\n" +
    "8800.00 200.50\n" +
    "9100.00 250.00\n" +
    "6500.00 290.30\n" +
    "8700.00 320.00\n" +
    "9500.00 350.10"
  )

  Out equal "6\n1 2 3 8 9 10"
end

test "sample 1: 3 engines -> 1 3"
  use "0587_expedition_to_mors" as expedition
  Out = expedition "3
5.00 0.00
3.00 90.00
4.00 270.00"

  Out equal "2\n1 3"
end

test "sample 2: opposite engines"
  use "0587_expedition_to_mors" as expedition
  Out = expedition "2
10.63 228.81
10.63 48.81"

  Out equal "1\n2"
end

test "single engine"
  use "0587_expedition_to_mors" as expedition
  Out = expedition "1
100.0 45.0"

  Out equal "1\n1"
end
