use testing

test "sample 1: 5x6 maze with mirrors"
  use "0230_ray_of_light" as solve
  G1 = "..*...\n......\n.....*\n"
  G2 = "*X...*\n....*."
  Answer = solve 5 6 (G1 + G2)

  E1 = "./*./\\\n/..X./\n\\./.X*\n"
  E2 = "*X.//*\n/\\X/*."
  Expected = E1 + E2
  Answer equal Expected
end

test "sample 2: 3x3 open room"
  use "0230_ray_of_light" as solve
  Answer = solve 3 3 "...\n.X.\n..."

  Expected = "\\./\n.X.\n/.\\"
  Answer equal Expected
end

test "ACMP 230: single cell room"
  use "0230_ray_of_light" as solve
  Answer = solve 1 1 "X"

  Answer equal "X"
end
