use testing

test "sample 1: 5x6 maze with mirrors"
  use "0230_ray_of_light"
  N = 5
  M = 6
  G1 = "..*...\n......\n.....*\n"
  G2 = "*X...*\n....*."
  GridText = G1 + G2
  run

  E1 = "./*./\\\n/..X./\n\\./.X*\n"
  E2 = "*X.//*\n/\\X/*."
  Expected = E1 + E2
  Answer equal Expected
end

test "sample 2: 3x3 open room"
  use "0230_ray_of_light"
  N = 3
  M = 3
  GridText = "...\n.X.\n..."
  run

  Expected = "\\./\n.X.\n/.\\"
  Answer equal Expected
end

test "ACMP 230: single cell room"
  use "0230_ray_of_light"
  N = 1
  M = 1
  GridText = "X"
  run

  Answer equal "X"
end
