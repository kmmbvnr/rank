rem Tests for ACMP 0891 Rubik's Cube

use testing
use sequences

test "default: Example 3 -> 9 moves"
  use "0891_rubiks_cube" as solve
  Ans = solve

  (Ans in (array "Solved")) equal false
  ((Ans text) not equal "") equal true
end

test "sample 1: already solved"
  use "0891_rubiks_cube" as solve
  Ans = solve "RR GG RR GG BB BB
RR GG RR GG BB BB"

  Ans equal "Solved"
end

test "sample 2: 2 moves"
  use "0891_rubiks_cube" as solve
  use sequences
  Ans = solve "RR BG GR GB GR BB
GG BR GR RB BB GR"

  AnsLen = (Ans bytes) shape 0
  AnsLen equal 4
end

test "1-move scramble: F' -> F"
  use "0891_rubiks_cube" as solve
  Ans = solve "RR GB RR BG BB GG
RR GB RR BG GG BB"

  Ans equal "F"
end
