rem ACMP 0110: Beautiful Numbers tests
use testing

test "ACMP 110: Sample 1"
  use "0110_beautiful_numbers"
  Input = "69 3"
  run
  Result equal "69=3+33+33"
end

test "ACMP 110: Sample 2"
  use "0110_beautiful_numbers"
  Input = "6 5"
  run
  Result equal "6=0.5+5.5"
end

test "ACMP 110: Sample 3"
  use "0110_beautiful_numbers"
  Input = "10 9"
  run
  Result equal "10=9.(9)"
end

test "ACMP 110: K=6 mixed period"
  use "0110_beautiful_numbers"
  Input = "1 6"
  run
  Expected = "1=0.0(6)+0.0(6)+0.0(6)+" + (
    "0.0(6)+0.0(6)+0.(6)"
  )
  Result equal Expected
end

test "ACMP 110: Default stress K=7"
  use "0110_beautiful_numbers"
  run
  M greater 0
end
