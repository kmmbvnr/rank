rem Self-Describing Number
rem https://acmp.ru/
rem   index.asp?main=task&id_task=588
rem B-digit self-describing number in B

use io
use numbers
use cli
use sequences
use text

arg Input text = "100"

Tokens = (
  (Input split "\n" join " ")
  split " "
)
Tokens = Tokens (Tokens not equal "")
B = Tokens 0 integer

Answer = "-1"

if B equal 4
  Answer = (array 2 1 0 1) join "\n"
else
  if B equal 5
    P5 = array 1 2 0 0 2
    Answer = P5 join "\n"
  else
    if B greater 6
      Digits = array shape B fill 0
      Digits 0 = 2
      Digits 1 = 1
      Digits (B - 5) = 1
      Digits (B - 1) = B - 4
      Answer = Digits join "\n"
    end
  end
end

Answer print
