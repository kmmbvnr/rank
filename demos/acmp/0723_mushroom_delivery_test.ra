rem Tests for ACMP 0723

use testing

test "ACMP 723: sample test"
  use "0723_mushroom_delivery" as solve
  Ans = solve

  Ans equal (array 2 5 6 8 (-1))
end

test "ACMP 723: 2-node cycle"
  use "0723_mushroom_delivery" as solve
  Ans = solve "2 2\n1 2 5\n2 1 3"

  Ans equal (array 5)
end

test "ACMP 723: simple DAG"
  use "0723_mushroom_delivery" as solve
  Ans = solve "3 3\n1 2 10\n2 3 20\n1 3 15"

  Ans equal (array 10 30)
end

test "ACMP 723: cycle before target"
  use "0723_mushroom_delivery" as solve
  Ans = solve "3 3\n1 2 5\n2 1 3\n1 3 4"

  Ans equal (array 5 (-1))
end

test "ACMP 723: unreachable target"
  use "0723_mushroom_delivery" as solve
  Ans = solve "3 1\n1 2 4"

  Ans equal (array 4 (-1))
end

test "ACMP 723: 10-node multi-branch"
  use "0723_mushroom_delivery" as solve
  Ans = solve (
    "10 15\n1 2 4\n1 3 2\n" +
    "2 4 3\n3 4 5\n4 5 1\n" +
    "5 6 2\n6 7 3\n7 5 1\n" +
    "6 8 4\n8 9 2\n9 10 3\n" +
    "2 5 6\n3 7 4\n7 9 5\n" +
    "4 8 7")

  Expected = (
    array 4 2 7 10 12 15 (-1) (-1) (-1))
  Ans equal Expected
end
