use testing

test "sample 1: 3 boys 4 girls -> 24"
  use "0512_graduation"
  Input = (
    "3 4 3\n" +
    "YYYY\n" +
    "YYYY\n" +
    "YYYY"
  )
  run

  Ways equal 24
end

test "sample 2: 1 boy 5 girls K=1 -> 3"
  use "0512_graduation"
  Input = "1 5 1\nYYNNY"
  run

  Ways equal 3
end

test "impossible K > boys -> 0"
  use "0512_graduation"
  Input = "2 3 3\nYYY\nYYY"
  run

  Ways equal 0
end

test "impossible K > girls -> 0"
  use "0512_graduation"
  Input = "3 2 3\nYY\nYY\nYY"
  run

  Ways equal 0
end

test "no compatible pairs yields 0"
  use "0512_graduation"
  Input = "2 2 2\nNN\nNN"
  run

  Ways equal 0
end

test "unique diagonal pairing yields 1"
  use "0512_graduation"
  Input = "3 3 3\nYNN\nNYN\nNNY"
  run

  Ways equal 1
end

test "full 10x10 complete matching"
  use "0512_graduation"
  Input = (
    "10 10 10\n" +
    "YYYYYYYYYY\n" +
    "YYYYYYYYYY\n" +
    "YYYYYYYYYY\n" +
    "YYYYYYYYYY\n" +
    "YYYYYYYYYY\n" +
    "YYYYYYYYYY\n" +
    "YYYYYYYYYY\n" +
    "YYYYYYYYYY\n" +
    "YYYYYYYYYY\n" +
    "YYYYYYYYYY"
  )
  run

  Ways equal 3628800
end
