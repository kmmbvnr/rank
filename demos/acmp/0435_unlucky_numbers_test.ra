test "boundary: N = 2, K = 1"
  use "0435_unlucky_numbers"
  N = 2
  K = 1
  run

  rem Numbers: 00 (lucky), 01 (unlucky), 10 (unlucky), 11 (lucky 1=1)
  Answer equal 2
end
