use testing

test "sample 1: 3x3x3 colored cube with holes"
  use "0240_cubic_hotel"
  run

  Answer equal 11
end

test "sample 2: solid 2x2x2 cube"
  use "0240_cubic_hotel"
  Input = "2\nZZ ZZ ZZ ZZ ZZ ZZ\nZZ ZZ ZZ ZZ ZZ ZZ"
  run

  Answer equal 8
end

test "empty 1x1x1 cube"
  use "0240_cubic_hotel"
  Input = "1\n. . . . . .\n"
  run

  Answer equal 0
end
