use testing

test "sample 1: 3 points forming 1 isosceles triangle"
  use "0533_triangles_3"
  run

  TotalTriangles equal 1
end

test "sample 2: 4 vertices of a square"
  use "0533_triangles_3"
  Input = "4\n0 0\n1 1\n1 0\n0 1"
  run

  TotalTriangles equal 4
end

test "3 collinear points form 0 triangles"
  use "0533_triangles_3"
  Input = "3\n0 0\n1 1\n2 2"
  run

  TotalTriangles equal 0
end

test "5 symmetric cross points"
  use "0533_triangles_3"
  Input = "5\n0 0\n-2 0\n2 0\n0 3\n0 -3"
  run

  TotalTriangles equal 4
end

test "large coordinates"
  use "0533_triangles_3"
  Input = "3\n0 0\n1000000000 0\n500000000 866025403"
  run

  TotalTriangles equal 1
end
