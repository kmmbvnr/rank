use testing

test "sample 1: 2x3 box yields 8"
  use "0722_chocolates" as solve
  Combinations = solve "2 3"

  Combinations equal 8
end

test "1x1 box yields 2 configs"
  use "0722_chocolates" as solve
  Combinations = solve "1 1"

  Combinations equal 2
end

test "2x2 box yields 6 configs"
  use "0722_chocolates" as solve
  Combinations = solve "2 2"

  Combinations equal 6
end

test "3x3 box yields 10 configs"
  use "0722_chocolates" as solve
  Combinations = solve "3 3"

  Combinations equal 10
end

test "4x4 box yields 18 configs"
  use "0722_chocolates" as solve
  Combinations = solve "4 4"

  Combinations equal 18
end

test "asymmetric 1x5 box yields 16"
  use "0722_chocolates" as solve
  Combinations = solve "1 5"

  Combinations equal 16
end

test "large 1000x1000 box BigInt"
  use "0722_chocolates" as solve
  Combinations = solve "1000 1000"

  Expected = (
    "281321470845691263287341019508" +
    "734199080725079345434930970419" +
    "620348618148472787734318968997" +
    "978250446933951001796967063964" +
    "352745453061800894588424048213" +
    "496485095469356444792557492502" +
    "395070760367608980981293614002"
  )
  (Combinations text) equal Expected
end
