rem Plot Distribution
rem ACMP 727
rem Pure Nash equilibrium greedy match

use io
use text
use cli
use sequences

arg Input text = "6
5 4 4 3 2 1
5 2 3 4 5 1
2 1 2 5 4 3
4 5 1 2 3 4
1 2 3 4 5 5
3 4 5 1 2 3"

Txt = Input split "\r" join " "
Txt = Txt split "\n" join " "
Tok = Txt split " "
Tokens = Tok (Tok not equal "")

N = (Tokens 0) integer
N2 = N * N
ValTok = Tokens (1 till (N2 + 1))
Vals = ValTok integer
Pos = 0 till N2

rem Ties to smaller company number
Key = (Vals * 512) + (511 - (Pos // N))
NegKey = 0 - Key
Order = NegKey argsort

Assign = array shape N fill -1
Taken = array shape N fill 0
Left = N

for P in Order
  I = P // N
  J = P mod N
  FreeI = (Assign I) less 0
  FreeJ = (Taken J) equal 0
  if FreeI and FreeJ
    Assign I = J
    Taken J = 1
    Left = Left - 1
  end
  if Left equal 0
    break
  end
end

Answer = (Assign + 1) join " "
return record
  .assign = Assign
  .n = N
  .taken = Taken
  .vals = Vals
  .answer = Answer
end
