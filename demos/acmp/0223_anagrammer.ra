rem ACMP 223 - Anagrammer
rem Dyck-path decomposition DP.
rem Flat 1D loop over pairs (L, Step).

use io
use cli
use numbers
use sequences
use text

arg S text = "ABCDEFGHIJKLMNO"
arg T text = "ONMLKJIHGFEDCBA"

N = S len
Dim = N + 2
DP = array shape Dim Dim Dim fill 0
DP 0 = array shape Dim Dim fill 1

SArr = S split ""
TArr = T split ""

Total = N * (N + 1) // 2
for Idx in 0 till Total
  Disc = 8 * Idx + 1
  SqrtD = Disc isqrt
  L = (SqrtD + 1) // 2
  Tri = (L - 1) * L // 2
  Step = Idx - Tri

  MaxI = N - L
  Rows = 0 to MaxI
  Cols = 0 to MaxI
  SChars = SArr Rows
  K = Step to (Step + MaxI)
  TChars = TArr K
  Eq = SChars TChars outer equal
  EqInt = Eq integer

  Len1 = Step
  Len2 = L - 1 - Step
  Row1 = 1 to (MaxI + 1)
  Col1 = Cols
  ShiftStep = Step + 1
  Row2 = ShiftStep to (ShiftStep + MaxI)
  Col2 = ShiftStep to (ShiftStep + MaxI)
  W1 = DP Len1 Row1 Col1
  W2 = DP Len2 Row2 Col2
  Term = EqInt * W1 * W2

  CurDP = DP L Rows Cols
  DP L Rows Cols = CurDP + Term
end

return DP N 0 0
