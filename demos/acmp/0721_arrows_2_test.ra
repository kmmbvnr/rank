rem Tests for ACMP 0721 Arrows 2

use testing

test "default 8x8 grid: 1 min, 24 max"
  use "0721_arrows_2" as solve
  Out = solve
  MaxCycles = Out .max_cycles
  MinCycles = Out .min_cycles

  MinCycles equal 1
  MaxCycles equal 24
end

test "sample 1: 3x4 grid: 1 min, 5 max"
  use "0721_arrows_2" as solve
  Out = solve "3 4
????
????
.??."
  MaxCycles = Out .max_cycles
  MinCycles = Out .min_cycles

  MinCycles equal 1
  MaxCycles equal 5
end

test "two disconnected 2x2 components"
  use "0721_arrows_2" as solve
  Out = solve "2 5
??.??
??.??"
  MaxCycles = Out .max_cycles
  MinCycles = Out .min_cycles

  MinCycles equal 2
  MaxCycles equal 4
end

test "odd path of 3 arrows"
  use "0721_arrows_2" as solve
  Out = solve "1 3
???"
  MaxCycles = Out .max_cycles
  MinCycles = Out .min_cycles

  MinCycles equal 1
  MaxCycles equal 1
end
