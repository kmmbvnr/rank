use io
use numbers
use sequences
use text
use cli

rem ACMP 618: Young Diagrams
rem Max subdiagrams in Young diagram.

arg Input text = "100"

fun solve_young Input
  Raw1 = Input split "\r" join " "
  Raw2 = Raw1 split "\n" join " "
  RawToks = Raw2 split " "
  ToksStr = RawToks (
    not (RawToks equal ""))
  N = (ToksStr 0) integer

  T = array shape 94 fill ""
  T 0 = "1;1 1;2 1;2 1 1;3 1 1;3 2 1;"
  T 1 = "3 2 1 1;4 2 1 1;4 2 1 1 1;4 "
  T 2 = "2 2 1 1;4 3 2 1 1;5 3 2 1 1;"
  T 3 = "5 3 2 1 1 1;6 3 2 1 1 1;6 4 "
  T 4 = "2 1 1 1;6 4 2 2 1 1;6 4 3 2 "
  T 5 = "1 1;6 4 3 2 1 1 1;7 4 3 2 1 "
  T 6 = "1 1;7 5 3 2 1 1 1;7 4 3 2 2 "
  T 7 = "1 1 1;7 5 3 2 2 1 1 1;8 5 3 "
  T 8 = "2 2 1 1 1;8 5 3 2 2 1 1 1 1;"
  T 9 = "8 5 4 3 2 1 1 1;8 5 4 3 2 1 "
  T 10 = "1 1 1;8 5 4 3 2 2 1 1 1;9 5 "
  T 11 = "4 3 2 2 1 1 1;9 6 4 3 2 2 1 "
  T 12 = "1 1;10 6 4 3 2 2 1 1 1;10 6 "
  T 13 = "4 3 2 2 1 1 1 1;10 6 4 3 2 2"
  T 14 = " 1 1 1 1 1;10 6 4 3 3 2 2 1 "
  T 15 = "1 1;9 6 5 4 3 2 2 1 1 1;10 6"
  T 16 = " 5 4 3 2 2 1 1 1;10 7 5 4 3 "
  T 17 = "2 2 1 1 1;11 7 5 4 3 2 2 1 1"
  T 18 = " 1;11 7 5 4 3 2 2 1 1 1 1;12"
  T 19 = " 7 5 4 3 2 2 1 1 1 1;11 7 5 "
  T 20 = "4 3 2 2 2 1 1 1 1;11 7 5 4 3"
  T 21 = " 3 2 2 1 1 1 1;12 7 5 4 3 3 "
  T 22 = "2 2 1 1 1 1;11 8 6 4 3 3 2 2"
  T 23 = " 1 1 1 1;12 8 6 4 3 3 2 2 1 "
  T 24 = "1 1 1;12 8 6 5 4 3 2 2 1 1 1"
  T 25 = ";12 8 6 5 4 3 2 2 1 1 1 1;13"
  T 26 = " 8 6 5 4 3 2 2 1 1 1 1;12 8 "
  T 27 = "6 5 4 3 2 2 2 1 1 1 1;12 8 6"
  T 28 = " 5 4 3 3 2 2 1 1 1 1;13 9 6 "
  T 29 = "5 4 3 2 2 2 1 1 1 1;13 9 6 5"
  T 30 = " 4 3 3 2 2 1 1 1 1;13 9 7 5 "
  T 31 = "4 3 3 2 2 1 1 1 1;13 9 7 5 4"
  T 32 = " 3 3 2 2 1 1 1 1 1;14 9 7 5 "
  T 33 = "4 3 3 2 2 1 1 1 1 1;14 9 7 5"
  T 34 = " 4 3 3 2 2 2 1 1 1 1;14 10 7"
  T 35 = " 5 4 3 3 2 2 2 1 1 1 1;15 10"
  T 36 = " 7 5 4 3 3 2 2 2 1 1 1 1;14 "
  T 37 = "9 7 6 5 4 3 2 2 2 1 1 1 1;14"
  T 38 = " 10 7 6 5 4 3 2 2 2 1 1 1 1;"
  T 39 = "14 10 8 6 5 4 3 2 2 2 1 1 1 "
  T 40 = "1;14 10 8 6 5 4 3 3 2 2 1 1 "
  T 41 = "1 1;14 10 8 6 5 4 3 3 2 2 1 "
  T 42 = "1 1 1 1;15 10 8 6 5 4 3 3 2 "
  T 43 = "2 1 1 1 1 1;15 11 8 6 5 4 3 "
  T 44 = "3 2 2 1 1 1 1 1;15 10 8 6 5 "
  T 45 = "4 3 3 2 2 2 1 1 1 1 1;15 11 "
  T 46 = "8 6 5 4 3 3 2 2 2 1 1 1 1 1;"
  T 47 = "16 11 8 6 5 4 3 3 2 2 2 1 1 "
  T 48 = "1 1 1;17 11 8 6 5 4 3 3 2 2 "
  T 49 = "2 1 1 1 1 1;16 11 9 7 5 4 3 "
  T 50 = "3 2 2 2 1 1 1 1 1;17 11 9 7 "
  T 51 = "5 4 3 3 2 2 2 1 1 1 1 1;15 1"
  T 52 = "1 8 7 6 5 4 3 3 2 2 1 1 1 1 "
  T 53 = "1;15 11 9 7 6 5 4 3 3 2 2 1 "
  T 54 = "1 1 1 1;16 11 9 7 6 5 4 3 3 "
  T 55 = "2 2 1 1 1 1 1;16 12 9 7 6 5 "
  T 56 = "4 3 3 2 2 1 1 1 1 1;16 11 9 "
  T 57 = "7 6 5 4 3 3 2 2 2 1 1 1 1 1;"
  T 58 = "16 12 9 7 6 5 4 3 3 2 2 2 1 "
  T 59 = "1 1 1 1;17 12 9 7 6 5 4 3 3 "
  T 60 = "2 2 2 1 1 1 1 1;17 12 9 7 6 "
  T 61 = "5 4 3 3 2 2 2 1 1 1 1 1 1;18"
  T 62 = " 12 9 7 6 5 4 3 3 2 2 2 1 1 "
  T 63 = "1 1 1 1;17 12 9 7 6 5 4 4 3 "
  T 64 = "3 2 2 1 1 1 1 1 1;17 12 9 7 "
  T 65 = "6 5 4 4 3 3 2 2 2 1 1 1 1 1;"
  T 66 = "18 12 9 7 6 5 4 4 3 3 2 2 2 "
  T 67 = "1 1 1 1 1;19 13 10 8 6 5 4 3"
  T 68 = " 3 2 2 2 1 1 1 1 1 1;18 12 1"
  T 69 = "0 8 6 5 4 4 3 3 2 2 2 1 1 1 "
  T 70 = "1 1;18 13 10 8 6 5 4 4 3 3 2"
  T 71 = " 2 2 1 1 1 1 1;18 13 10 8 6 "
  T 72 = "5 4 4 3 3 2 2 2 1 1 1 1 1 1;"
  T 73 = "19 13 10 8 6 5 4 4 3 3 2 2 2"
  T 74 = " 1 1 1 1 1 1;18 13 10 8 7 6 "
  T 75 = "5 4 3 3 2 2 2 1 1 1 1 1;19 1"
  T 76 = "3 10 8 7 6 5 4 3 3 2 2 2 1 1"
  T 77 = " 1 1 1;19 13 10 8 7 6 5 4 3 "
  T 78 = "3 2 2 2 1 1 1 1 1 1;19 14 10"
  T 79 = " 8 7 6 5 4 3 3 2 2 2 1 1 1 1"
  T 80 = " 1 1;18 13 10 8 7 6 5 4 4 3 "
  T 81 = "3 2 2 2 1 1 1 1 1;19 13 10 8"
  T 82 = " 7 6 5 4 4 3 3 2 2 2 1 1 1 1"
  T 83 = " 1;19 13 10 8 7 6 5 4 4 3 3 "
  T 84 = "2 2 2 1 1 1 1 1 1;19 14 10 8"
  T 85 = " 7 6 5 4 4 3 3 2 2 2 1 1 1 1"
  T 86 = " 1 1;19 14 11 9 7 6 5 4 4 3 "
  T 87 = "3 2 2 2 1 1 1 1 1;19 14 11 9"
  T 88 = " 7 6 5 4 4 3 3 2 2 2 1 1 1 1"
  T 89 = " 1 1;20 14 11 9 7 6 5 4 4 3 "
  T 90 = "3 2 2 2 1 1 1 1 1 1;20 14 11"
  T 91 = " 9 7 6 5 4 4 3 3 2 2 2 1 1 1"
  T 92 = " 1 1 1 1;20 14 11 9 7 6 5 4 "
  T 93 = "4 3 3 2 2 2 2 1 1 1 1 1 1"
  Full = T join ""
  Entries = Full split ";"
  Entry = Entries (N - 1)
  M = (Entry split " ") integer

  K = M len
  W = M 0
  DP = (0 to W) * 0 + 1
  if K greater 1
    for I in 1 to (K - 1)
      Suf = (DP reverse) scan + (
        reverse)
      DP = Suf (0 to (M I))
    end
  end
  Total = (DP reduce +) - 1
  return (Total text) + "\n" + Entry
end

Result = solve_young Input
return Result
