use testing

test "sample 1: 3 villages, target 2"
  use "0212_villages"
  N = 3
  P = 2
  EdgesText = "1 2 3 2"
  run

  Answer equal 1
end

test "sample 2: 11 villages, target 6"
  use "0212_villages"
  N = 11
  P = 6
  E1 = "1 2 1 3 1 4 1 5 2 6 "
  E2 = "2 7 2 8 4 9 4 10 4 11"
  EdgesText = E1 + E2
  run

  Answer equal 2
end

test "full tree kept: target 5"
  use "0212_villages"
  N = 5
  P = 5
  EdgesText = "1 2 1 3 1 4 1 5"
  run

  Answer equal 0
end

test "single village: target 1"
  use "0212_villages"
  N = 5
  P = 1
  EdgesText = "1 2 1 3 1 4 1 5"
  run

  Answer equal 1
end
