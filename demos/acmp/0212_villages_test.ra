use testing

test "sample 1: 3 villages, target 2"
  use "0212_villages" as solve
  Answer = solve 3 2 "1 2 3 2"

  Answer equal 1
end

test "sample 2: 11 villages, target 6"
  use "0212_villages" as solve
  E1 = "1 2 1 3 1 4 1 5 2 6 "
  E2 = "2 7 2 8 4 9 4 10 4 11"
  Answer = solve 11 6 (E1 + E2)

  Answer equal 2
end

test "full tree kept: target 5"
  use "0212_villages" as solve
  Answer = solve 5 5 "1 2 1 3 1 4 1 5"

  Answer equal 0
end

test "single village: target 1"
  use "0212_villages" as solve
  Answer = solve 5 1 "1 2 1 3 1 4 1 5"

  Answer equal 1
end
