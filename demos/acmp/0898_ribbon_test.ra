use testing

test "sample 1: 2 PP 1 1 -> K"
  use "0898_ribbon"
  run

  Ans equal "K"
end

test "sample 2: 2 ZZ 2 1 2 -> OK"
  use "0898_ribbon"
  Input = "2\nZZ\n2 1 2"
  run

  Ans equal "OK"
end

test "single fold P: 1 P 1 1 -> O"
  use "0898_ribbon"
  Input = "1\nP\n1 1"
  run

  Ans equal "O"
end

test "single fold Z: 1 Z 1 1 -> K"
  use "0898_ribbon"
  Input = "1\nZ\n1 1"
  run

  Ans equal "K"
end

test "three folds PZP: all middle creases -> OOK"
  use "0898_ribbon"
  Input = "3\nPZP\n3 2 4 6"
  run

  Ans equal "OOK"
end
