rem ACMP 0981: Median tests
use testing
use text
use sequences
use numbers

test "ACMP 981: Sample (x&y|y&z|x&z)"
  use "0981_median" as solve
  Result = solve "x&y|y&z|x&z"
  Result equal "<z<yyx><yxy>>"
end

test "ACMP 981: Single variable a"
  use "0981_median" as solve
  Result = solve "a"
  Result equal "a"
end

test "ACMP 981: Double negation !!x"
  use "0981_median" as solve
  Result = solve "!!x"
  Result equal "x"
end

test "ACMP 981: Parenthesized majority"
  use "0981_median" as solve
  Result = solve "(a|b)&(b|c)&(c|a)"
  Result equal "<c<bba><bab>>"
end

test "ACMP 981: 5-variable majority"
  use "0981_median" as solve
  use text
  Result = solve "(a&b&c)|(a&b&d)|(a&b&e)|
(a&c&d)|(a&c&e)|(a&d&e)|
(b&c&d)|(b&c&e)|(b&d&e)|(c&d&e)"
  Exp = "<e<d<cc<bba>><c<bba><bab>>>"
  Result startswith Exp
end
