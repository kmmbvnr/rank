rem Guess the Number
rem ACMP 631
rem Min candies with costs 2 and 1

use io
use numbers
use cli
use sequences
use text

arg Input text = "100000"

Lines = Input split "\n"
Line = Lines join " "
Tokens = Line split " "
Tokens = Tokens (Tokens not equal "")
N = Tokens 0 integer

rem Fibonacci sequence F: F_C max items
F = array shape 40 fill 0
F 0 = 1
F 1 = 1
for I in 2 till 40
  F I = (F (I - 1)) + (F (I - 2))
end

LessN = F less N
return LessN count
