rem Radio
rem https://acmp.ru/
rem   index.asp?main=task&id_task=538
rem Maximize transmitter coverage radius

use io
use cli
use sequences
use numbers
use text

arg Input text = (
  "10\n" +
  "-10000 -10000\n" +
  "-10000 0\n" +
  "-10000 10000\n" +
  "0 -10000\n" +
  "0 0\n" +
  "0 10000\n" +
  "10000 -10000\n" +
  "10000 0\n" +
  "10000 10000\n" +
  "5000 5000"
)

Lines = Input split "\n"
Tokens = (Lines join " ") split " "
Tokens = Tokens (Tokens not equal "")
Nums = Tokens real

N = Nums 0 integer
Idxs = 0 till N array
X = Nums (Idxs * 2 + 1)
Y = Nums (Idxs * 2 + 2)

DX = X X outer -
DY = Y Y outer -
D2 = DX * DX + DY * DY

Low = 0.0
High = 40000.0

FinalColors = array shape N fill 1

for Iter in 0 till 45
  Mid = (Low + High) / 2.0
  Mid2 = Mid * Mid

  Colors = array shape N fill 0
  Q = array shape N fill 0
  IsBipartite = true

  for I in 0 till N
    IsZero = Colors I equal 0
    if IsZero and IsBipartite
      Colors I = 1
      Head = 0
      Tail = 0
      Q Tail = I
      Tail = Tail + 1

      for Head less Tail and IsBipartite
        U = Q Head
        Head = Head + 1
        ColU = Colors U
        NextCol = 3 - ColU

        Row = D2 U
        MaskMid = Row less Mid2
        MaskPos = Row greater 0.0
        Mask = MaskMid and MaskPos
        Neighs = Idxs Mask

        for V in Neighs
          ColV = Colors V
          if ColV equal 0
            Colors V = NextCol
            Q Tail = V
            Tail = Tail + 1
          else
            if ColV equal ColU
              IsBipartite = false
              break
            end
          end
        end
      end
    end
  end

  if IsBipartite
    Low = Mid
    FinalColors = Colors
  else
    High = Mid
  end
end

rem Fill unvisited nodes with color 1
ZeroMask = FinalColors equal 0
FinalColors ZeroMask = 1

R = Low / 2.0
OutR = R text
OutCols = FinalColors join " "
Answer = OutR + "\n" + OutCols
return record
  .final_colors = FinalColors
  .r = R
  .answer = Answer
end
