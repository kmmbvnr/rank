use testing

test "sample 1: 4 boxes with K=3 yields 8 partitions"
  use "0646_sweet_treats"
  run

  Ways equal 8
end

test "sample 2: 5 boxes with K=67 yields 6 partitions"
  use "0646_sweet_treats"
  Input = "5 67\n10 22 30 41 50"
  run

  Ways equal 6
end

test "sample 3: insufficient candies yields 0 partitions"
  use "0646_sweet_treats"
  Input = "3 6\n4 1 5"
  run

  Ways equal 0
end

test "exact boundary: total sum equals 2*K"
  use "0646_sweet_treats"
  Input = "2 5\n5 5"
  run

  Ways equal 2
end

test "all boxes exceed K individually"
  use "0646_sweet_treats"
  Input = "3 10\n20 30 40"
  run

  Ways equal 6
end

test "single box cannot satisfy both children"
  use "0646_sweet_treats"
  Input = "1 5\n10"
  run

  Ways equal 0
end

test "uniform boxes combinatorial subset sums"
  use "0646_sweet_treats"
  Input = "6 3\n1 1 1 1 1 1"
  run

  Ways equal 20
end
