rem Morphism (Морфизм)
rem acmp.ru: 963
rem Keep table of first 20 letters
rem of f^(2^i)(c) and square per bit.

use io
use text
use cli
use bits
use sequences

arg Input text = "3 1 5
ABC
ABC
A
BC"

Txt = Input split "\r" join ""
Lines = Txt split "\n"
Lines = Lines (Lines not equal "")
Head = (Lines 0) split " " integer
N = Head 0
K = Head 1
P = Head 2
Pad = array shape 20 fill -1

rem Apply a table to a word, keep 20.
fun Tab step Word
  Flat = (Tab Word) reshape #
  Keep = Flat (Flat at least 0)
  return Keep take 20
end

B = (Lines 1) bytes integer
Word = (B - 65) take 20
Tab = array shape N 20 fill -1
for C in 0 till N
  Line = Lines (C + 2)
  Chars = Line bytes integer
  Img = (Chars - 65) take 20
  Tab C = (concat Img Pad) take 20
end

for Bit in 0 till 30
  if (K band (1 shl Bit)) greater 0
    Word = Tab step Word
  end
  Next = Tab
  for C in 0 till N
    Row = Tab C
    Valid = Row (Row at least 0)
    Step = Tab step Valid
    Next C = (concat Step Pad) take 20
  end
  Tab = Next
end

Ans = "-"
if P at most (Word len)
  Ch = (Word (P - 1)) + 65
  Ans = Ch character
end
Ans print
