rem Sweet Treats
rem https://acmp.ru/
rem   index.asp?main=task&id_task=646
rem Number of fair candy partitions

use io
use numbers
use cli
use sequences
use text

arg Input text = (
  "30 300\n" +
  "20 25 30 15 10 35 40 45 50 55 " +
  "20 25 30 15 10 35 40 45 50 55 " +
  "20 25 30 15 10 35 40 45 50 55"
)

Tokens = (
  (Input split "\n" join " ")
  split " "
)
Tokens = Tokens (Tokens not equal "")

N = Tokens 0 integer
K = Tokens 1 integer
A = Tokens drop 2 integer

TotalSum = A sum
Ways = 0

NeedTotal = 2 * K
if not (TotalSum less NeedTotal)
  DP = array shape K fill 0
  DP 0 = 1

  Items = A (A less K)
  for V in Items
    CurSlice = DP (V till K)
    PrevSlice = DP (0 till (K - V))
    DP (V till K) = CurSlice + PrevSlice
  end

  Under = DP sum
  Total = 2 ** N
  TwoUnder = 2 * Under
  Ways = Total - TwoUnder
end

return Ways
