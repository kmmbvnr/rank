rem ACMP 0807: Game with Graph tests
use testing

test "ACMP 807: N = 1"
  use "0807_game_with_graph" as solve
  Result = solve "1"
  Result equal "1"
end

test "ACMP 807: N = 2"
  use "0807_game_with_graph" as solve
  Result = solve "2"
  Result equal "3"
end

test "ACMP 807: N = 3 (Sample)"
  use "0807_game_with_graph" as solve
  Result = solve "3"
  Result equal "25"
end

test "ACMP 807: N = 4"
  use "0807_game_with_graph" as solve
  Result = solve "4"
  Result equal "543"
end

test "ACMP 807: N = 5"
  use "0807_game_with_graph" as solve
  Result = solve "5"
  Result equal "29281"
end

test "ACMP 807: N = 6"
  use "0807_game_with_graph" as solve
  Result = solve "6"
  Result equal "3781503"
end

test "ACMP 807: N = 7"
  use "0807_game_with_graph" as solve
  Result = solve "7"
  Result equal "1138779265"
end

test "ACMP 807: N = 12 (BigInt)"
  use "0807_game_with_graph" as solve
  Result = solve "12"
  Exp = "521939651343829405020504063"
  Result equal Exp
end

test "N = 100 max constraint"
  use "0807_game_with_graph" as solve
  Result = solve "100"
  Len = Result len
  (Len greater 1500) equal true
end
