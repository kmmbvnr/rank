rem Expedition to Mors
rem https://acmp.ru/
rem   index.asp?main=task&id_task=587
rem Max thrust via 2-pointer half-plane

use cli
use io
use numbers
use sequences
use text

arg Input text = (
  "20\n" +
  "10000.00 0.00\n" +
  "9500.00 15.00\n" +
  "9200.00 35.00\n" +
  "8800.00 55.00\n" +
  "9100.00 75.00\n" +
  "8500.00 95.00\n" +
  "9900.00 115.00\n" +
  "8700.00 135.00\n" +
  "7400.00 155.00\n" +
  "6500.00 175.00\n" +
  "9600.00 195.00\n" +
  "9300.00 215.00\n" +
  "8900.00 235.00\n" +
  "9400.00 255.00\n" +
  "8200.00 275.00\n" +
  "7800.00 295.00\n" +
  "9000.00 315.00\n" +
  "8600.00 335.00\n" +
  "9100.00 345.00\n" +
  "9800.00 355.00"
)

Seps = array " " "\n" "\r"
Raw = Input split Seps
Tokens = (Raw (Raw not equal "")) real
N = (Tokens 0) integer
Rest = Tokens drop 1
I0 = 0 till N
R = Rest (I0 * 2)
Deg = Rest ((I0 * 2) + 1)

PI = 1.0 atan * 4.0
Rad = Deg * PI / 180.0
X = (Rad cos) * R
Y = (Rad sin) * R
Ids = 1 to N

O = Deg argsort
DegS = Deg O
XS = X O
YS = Y O
IdS = Ids O

Deg2 = concat DegS (DegS + 360.0)
X2 = concat XS XS
Y2 = concat YS YS
Id2 = concat IdS IdS

PrefX = X2 scan + with 0.0 array
PrefY = Y2 scan + with 0.0 array

BestMag = -1.0
BestI = 0
BestJ = 0

I = 0
J = 0
LimitStep = 3 * N
for Step in 0 till LimitStep
  EndI = I equal N
  EndJ = J equal (2 * N)
  Stop = EndI or EndJ
  if Stop
    break
  end

  DegDiff = (Deg2 J) - (Deg2 I)
  AdvCond = DegDiff less 179.999999999
  InSpan = J less (I + N)
  CanAdv = InSpan and AdvCond

  if CanAdv
    J = J + 1
  else
    I = I + 1
    if not (J greater I)
      J = I
    end
  end

  DX = (PrefX J) - (PrefX I)
  DY = (PrefY J) - (PrefY I)
  MagSq = (DX * DX) + (DY * DY)

  if MagSq greater BestMag
    BestMag = MagSq
    BestI = I
    BestJ = J
  end
end

Chosen = Id2 (BestI till BestJ)
ChosenSort = Chosen sort
AnsK = ChosenSort shape 0
AnsStr = ChosenSort join " "

Ans = array (AnsK text) AnsStr
AnsK print
AnsStr print
