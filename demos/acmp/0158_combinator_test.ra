use testing
use text

test "sample 15 rubles, 2 children"
  use "0158_combinator"
  X = 15
  K = 2
  run

  Answer equal 10
end

test "ACMP 158: 0 rubles, 0 children"
  use "0158_combinator"
  X = 0
  K = 0
  run

  Answer equal 1
end

test "1 banknote, 1 child (2 people)"
  use "0158_combinator"
  X = 5
  K = 1
  run

  Answer equal 2
end

test "maximum inputs X=500, K=100"
  use "0158_combinator"
  X = 500
  K = 100
  run

  P1 = "905485146561032811654041770774"
  P2 = "84163874504589675413336841320"
  ExpText = P1 + P2
  Expected = ExpText integer
  Answer equal Expected
end
