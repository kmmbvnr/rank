rem Pattern
rem https://acmp.ru/
rem   index.asp?main=task&id_task=239
rem Exact-cover room tiling with DP

use io
use cli
use sequences
use text
use numbers
use bits

arg N integer = 4
arg M integer = 3
arg K integer = 3
arg GridText text = (
  "2 2 2\n" +
  "2 0 0\n" +
  "2 1 2\n" +
  "2 2 2"
)
arg TilesText text = (
  "2 10 0 0\n" +
  "1 5 1\n" +
  "4 6 0 0 1"
)

INF = 1000000000

RawGP = GridText split "\n"
GP = (RawGP join " ") split " "
GT = (GP (not (GP equal ""))) integer

TargetR = array shape 0 fill 0
TargetC = array shape 0 fill 0
TargetColor = array shape 0 fill 0
NM = N * M
TargetLookup = array shape NM fill -1

for R in 0 till N
  for C in 0 till M
    Idx = R * M + C
    Val = GT Idx
    if Val not equal 2
      Tid = TargetR len
      RArr = array R
      TargetR = concat TargetR RArr
      CArr = array C
      TargetC = concat TargetC CArr
      VArr = array Val
      TargetColor = (
        concat TargetColor VArr
      )
      TargetLookup Idx = Tid
    end
  end
end

U = TargetR len
Answer = -1

if U equal 0
  Answer = 0
else
  TileLines = TilesText split "\n"
  NumTiles = TileLines len

  PlacementsCost = array shape 0 fill 0
  PlacementsMask = array shape 0 fill 0

  for TIdx in 0 till NumTiles
    TLine = TileLines TIdx
    RawParts = TLine split " "
    NonEmpty = RawParts not equal ""
    Parts = RawParts NonEmpty
    Words = Parts integer
    Form = Words 0
    Cost = Words 1
    NumColors = (Words len) - 2
    Colors = Words (2 till (Words len))

    BaseR = array 0
    BaseC = array 0
    if Form equal 2
      BaseR = array 0 0
      BaseC = array 0 1
    end
    if Form equal 3
      BaseR = array 0 0 0
      BaseC = array 0 1 2
    end
    if Form equal 4
      BaseR = array 0 0 1
      BaseC = array 0 1 1
    end

    CurR = BaseR
    CurC = BaseC
    for Rot in 0 to 3
      if Rot greater 0
        NewR = CurC
        NewC = 0 - CurR
        CurR = NewR
        CurC = NewC
      end

      MinR = CurR min
      MinC = CurC min
      CurR = CurR - MinR
      CurC = CurC - MinC

      for R0 in 0 till N
        for C0 in 0 till M
          CanPlace = true
          PMask = 0
          for Cell in 0 till NumColors
            NR = R0 + (CurR Cell)
            NC = C0 + (CurC Cell)
            BadNR = NR less 0
            BigNR = NR at least N
            BadNR = BadNR or BigNR
            BadNC = NC less 0
            BigNC = NC at least M
            BadNC = BadNC or BigNC
            if BadNR or BadNC
              CanPlace = false
            else
              NIdx = NR * M + NC
              Tid = TargetLookup NIdx
              if Tid equal -1
                CanPlace = false
              else
                ReqCol = TargetColor Tid
                TileCol = Colors Cell
                EqCol = (
                  ReqCol equal TileCol
                )
                if not EqCol
                  CanPlace = false
                else
                  ShT = 1 shl Tid
                  PMask = PMask bor ShT
                end
              end
            end
          end

          if CanPlace
            CArr = array Cost
            PlacementsCost = (
              concat PlacementsCost CArr
            )
            MArr = array PMask
            PlacementsMask = (
              concat PlacementsMask MArr
            )
          end
        end
      end
    end
  end

  NumPlacements = PlacementsMask len
  TotalStates = 1 shl U
  DP = array shape TotalStates fill INF
  DP 0 = 0

  for Mask in 0 till TotalStates
    CurCost = DP Mask
    if CurCost less INF
      Low = 0
      for Bit in 0 till U
        if not (Mask bit Bit)
          Low = Bit
          break
        end
      end

      LowBitMask = 1 shl Low

      for P in 0 till NumPlacements
        PM = PlacementsMask P
        HasLow = PM band LowBitMask
        if HasLow not equal 0
          if Mask band PM equal 0
            NMask = Mask bor PM
            CostP = PlacementsCost P
            NewCost = CurCost + CostP
            OldCost = DP NMask
            MinCost = (
              OldCost min NewCost
            )
            DP NMask = MinCost
          end
        end
      end
    end
  end

  FinalCost = DP (TotalStates - 1)
  if FinalCost less INF
    Answer = FinalCost
  else
    Answer = -1
  end
end

Answer print
