use testing

test "ACMP 232: sample 1 open forest -> NO"
  use "0232_dense_forest"
  N = 3
  TreesText = "0 10 2 5 11 2 12.04 7 2"
  run

  Answer equal "NO"
end

test "ACMP 232: sample 2 dense forest triangle -> YES"
  use "0232_dense_forest"
  N = 3
  TreesText = "0 0 1 2.05 0 1 1.02 -1.9 1"
  run

  Answer equal "YES"
end

test "ACMP 232: single tree cannot have trees on both sides -> YES"
  use "0232_dense_forest"
  N = 1
  TreesText = "0 0 1"
  run

  Answer equal "YES"
end

test "ACMP 232: two disjoint trees always separable -> NO"
  use "0232_dense_forest"
  N = 2
  TreesText = "0 0 1 10 10 1"
  run

  Answer equal "NO"
end
