rem Tests for ACMP 0555: Complexity
use testing
use text

test "ACMP 555: Default 100 loops"
  use "0555_complexity" as solve
  Ans = solve
  Ans equal 235688956
end

test "ACMP 555: Sample 1"
  use "0555_complexity" as solve
  Ans = solve "2
1 100
-1 100"
  Ans equal 5050
end

test "ACMP 555: Sample 2"
  use "0555_complexity" as solve
  Ans = solve "2
4 6
-1 3"
  Ans equal 0
end

test "ACMP 555: Sample 3 (2^32 mod)"
  use "0555_complexity" as solve
  Ans = solve (
    "4
1 256
1 256
1 256
1 256"
  )
  Ans equal 0
end

test "ACMP 555: Sample 4"
  use "0555_complexity" as solve
  Ans = solve (
    "4
1 1000
1 1000
1 1000
1 1000"
  )
  Ans equal 3567587328
end
