use testing
use bits

test "sample 1: first term is 7"
  use "0468_sequence_2" as solve
  Out = solve 1
  Answer = Out .answer

  Answer equal 7
end

test "first 8 terms match"
  use "0468_sequence_2" as solve

  Expected = (
    array 7 11 13 14 19 21 22 25)
  for I in 1 to 8
    Out = solve I
    Answer = Out .answer
    Answer equal (Expected (I - 1))
  end
end

test "large N power of two"
  use "0468_sequence_2" as solve
  rem N = C(5,3) + 1 = 11 -> 35
  Out = solve 11
  Answer = Out .answer

  Answer equal 35
end

test "maximum N = 2^31 - 1"
  use "0468_sequence_2" as solve
  use bits
  Out = solve 2147483647
  Answer = Out .answer
  P1 = Out .p1
  P2 = Out .p2
  P3 = Out .p3

  rem Check exactly 3 set bits
  P3Bit = 1 shl P3
  P2Bit = 1 shl P2
  P1Bit = 1 shl P1
  Answer equal (P3Bit + P2Bit + P1Bit)
  P3 greater P2
  P2 greater P1
  P1 greater -1
end
