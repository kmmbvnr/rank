use testing

test "sample 1: 4x3 room partial tiling"
  use "0239_pattern"
  N = 4
  M = 3
  K = 3
  G1 = "2 2 2\n2 0 0\n"
  G2 = "2 1 2\n2 2 2"
  GridText = G1 + G2
  T1 = "2 10 0 0\n1 5 1\n"
  T2 = "4 6 0 0 1"
  TilesText = T1 + T2
  run

  Answer equal 15
end

test "all cells already tiled -> 0"
  use "0239_pattern"
  N = 2
  M = 2
  K = 1
  GridText = "2 2\n2 2"
  TilesText = "1 5 0"
  run

  Answer equal 0
end

test "impossible tiling -> -1"
  use "0239_pattern"
  N = 2
  M = 2
  K = 1
  GridText = "0 0\n0 0"
  TilesText = "2 10 1 1"
  run

  Answer equal -1
end

test "2x2 grid tiled by two dominoes"
  use "0239_pattern"
  N = 2
  M = 2
  K = 1
  GridText = "0 0\n0 0"
  TilesText = "2 10 0 0"
  run

  Answer equal 20
end
