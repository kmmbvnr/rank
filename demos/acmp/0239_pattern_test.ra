use testing

test "sample 1: 4x3 room partial tiling"
  use "0239_pattern" as solve
  G1 = "2 2 2\n2 0 0\n"
  G2 = "2 1 2\n2 2 2"
  T1 = "2 10 0 0\n1 5 1\n"
  T2 = "4 6 0 0 1"
  Answer = solve 4 3 3 (G1 + G2) (T1 + T2)

  Answer equal 15
end

test "all cells already tiled -> 0"
  use "0239_pattern" as solve
  Answer = solve 2 2 1 "2 2\n2 2" "1 5 0"

  Answer equal 0
end

test "impossible tiling -> -1"
  use "0239_pattern" as solve
  Answer = solve 2 2 1 "0 0\n0 0" "2 10 1 1"

  Answer equal -1
end

test "2x2 grid tiled by two dominoes"
  use "0239_pattern" as solve
  Answer = solve 2 2 1 "0 0\n0 0" "2 10 0 0"

  Answer equal 20
end
