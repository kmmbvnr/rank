rem Chocolates
rem ACMP 722
rem 2-colored grids without 3 mono-cells

use io
use numbers
use cli
use sequences
use text

arg Input text = "1000 1000"

Lines = Input split "\n"
Line = Lines join " "
Tokens = Line split " "
Tokens = Tokens (Tokens not equal "")

N = Tokens 0 integer
M = Tokens 1 integer

rem Total = 2*F_(N+1) + 2*F_(M+1) - 2
MaxDim = (N max M) + 5

F = array shape MaxDim fill 0
F 1 = 1
F 2 = 1
for I in 3 till MaxDim
  F I = (F (I - 1)) + (F (I - 2))
end

FN = F (N + 1)
FM = F (M + 1)
return (2 * FN) + (2 * FM) - 2
