rem ACMP 0592: Skyscraper tests
use testing

test "ACMP 592: Sample 1"
  use "0592_skyscraper"
  Input = "8
2 1 1 4 6
2 1 1 6 6
2 1 4 6 6
2 1 1 6 6
3 1 1 4 6 8 8
2 1 1 8 8
2 1 3 7 8
1 6 6"
  run
  Exp = array 5 5 5 5 6 6 6 1
  (FinalAns equal Exp) all
end

test "ACMP 592: Single column stack"
  use "0592_skyscraper"
  Input = "1
3 3 4 7 9 15 20"
  run
  Exp = array 11
  (FinalAns equal Exp) all
end

test "ACMP 592: Archway C-shape"
  use "0592_skyscraper"
  Input = "2
2 3 4 8 9
1 3 9"
  run
  Exp = array 7 7
  (FinalAns equal Exp) all
end

test "ACMP 592: Overhang bridge"
  use "0592_skyscraper"
  Input = "3
1 1 5
1 5 6
1 5 10"
  run
  Exp = array 5 6 10
  (FinalAns equal Exp) all
end

test "ACMP 592: Default stress test"
  use "0592_skyscraper"
  run
  Exp = array 12 17 22 27 32 37 (
    42
  ) 47 52 57 99997 500012
  (FinalAns equal Exp) all
end
