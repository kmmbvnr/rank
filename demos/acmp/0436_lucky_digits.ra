rem Lucky Digits
rem acmp.ru: task 436
rem Maximize trailing digits K.

use io
use cli
use sequences
use text

arg N integer = 100000000000
arg K integer = 0

BestL = 0
BestD = 2
if K greater 1
  BestD = K + 1
end

StartD = 2
if K greater 1
  StartD = K + 1
end

fun D countTrailing
  Temp = N
  CurL = 0
  for Temp greater 0
    if not (Temp mod D equal K)
      break
    end
    CurL += 1
    Temp //= D
  end
  return CurL
end

rem 1. Check small bases up to 5000
CheckLimit = 5000
for D in StartD to CheckLimit
  CurL = D countTrailing
  if CurL greater BestL
    BestL = CurL
    BestD = D
  end
end

rem 2. Check Q = 0 for L = 2
if (K greater 0) and (N greater K)
  DiffK = N - K
  if (DiffK mod K) equal 0
    D = DiffK // K
    AboveK = D greater K
    AtLeast2 = not (D less 2)
    ValidD = AboveK and AtLeast2
    if ValidD
      CurL = D countTrailing
      if CurL greater BestL
        BestL = CurL
        BestD = D
      end
    end
  end
end

rem 3. Check divisors of N - K
if N greater K
  Diff = N - K
  Limit = Diff ** 0.5 integer
  for D in StartD to Limit
    if Diff mod D equal 0
      CurL = D countTrailing
      if CurL greater BestL
        BestL = CurL
        BestD = D
      end

      D2 = Diff // D
      AboveK2 = D2 greater K
      AtLeast2_2 = not (D2 less 2)
      ValidD2 = AboveK2 and AtLeast2_2
      if ValidD2
        CurL2 = D2 countTrailing
        if CurL2 greater BestL
          BestL = CurL2
          BestD = D2
        end
      end
    end
  end
end

rem 4. Check L = 1
if BestL equal 0
  if N greater K
    D = N - K
    AboveK = D greater K
    AtLeast2 = not (D less 2)
    ValidD = AboveK and AtLeast2
    if ValidD
      BestL = 1
      BestD = D
    end
  end
end

(tuple BestD BestL) print
