rem ACMP 242 - Tile Coloring (Раскраска плиток)
rem Solved in Euler 1-15 style with array-oriented line covering and cascade analysis.
rem
rem Tom Sawyer wants to repaint an N x N yard into a single color C (1 <= K < N).
rem A row or column can only be repainted if it currently has at least 2 tiles of that color.
rem Every tile must be painted with the new paint, so either all N rows or all N columns
rem must be painted.
rem
rem Since two perpendicular painted lines intersect every parallel line, any 2 painted
rem lines immediately satisfy all lines of the opposite orientation.
rem Thus the minimum operations L can only be:
rem   1. L = N: if all rows or all columns already have >= 2 tiles of color C.
rem   2. L = N + 1: if 1 column (or row) with >= 2 tiles gives all rows (or cols) >= 2 tiles.
rem   3. L = N + 2: if a cascade reaches at least 2 rows or 2 columns of color C.
rem If no color works, the answer is "0 0".

use io
use cli
use sequences
use text
use numbers

arg N integer = 3
arg K integer = 2
arg GridText text = "1 2 1\n2 1 1\n1 2 2"

GP = (GridText split "\n" join " ") split " "
GT = (GP (not (GP equal ""))) integer
Grid = GT reshape N N

BestL = 1000000000
BestC = 0

for C in 1 to K
  ColorMask = Grid equal C
  RowCnt = (ColorMask integer) sum axis -1
  ColCnt = (ColorMask integer) sum axis 0

  rem Check L = N
  RowsOk = (RowCnt greater 1) count equal N
  ColsOk = (ColCnt greater 1) count equal N

  if RowsOk or ColsOk
    if N less BestL
      BestL = N
      BestC = C
    end
  else
    rem Check L = N + 1
    CanN1 = false

    ColCand = (ColCnt greater 1) indices
    for J in ColCand
      ColSlice = ColorMask # J
      ColInc = (not ColSlice) integer
      NewRowCnt = RowCnt + ColInc
      if (NewRowCnt greater 1) count equal N
        CanN1 = true
        break
      end
    end

    if not CanN1
      RowCand = (RowCnt greater 1) indices
      for I in RowCand
        RowSlice = ColorMask I
        RowInc = (not RowSlice) integer
        NewColCnt = ColCnt + RowInc
        if (NewColCnt greater 1) count equal N
          CanN1 = true
          break
        end
      end
    end

    if CanN1
      if (N + 1) less BestL
        BestL = N + 1
        BestC = C
      end
    else
      rem Check L = N + 2 via cascade
      CurMask = ColorMask integer
      PaintedR = array shape N fill 0
      PaintedC = array shape N fill 0

      Changed = true
      for Changed
        Changed = false
        CurRowCnt = CurMask sum axis -1
        CurColCnt = CurMask sum axis 0

        for I in 0 till N
          if ((PaintedR I) equal 0) and ((CurRowCnt I) greater 1)
            PaintedR I = 1
            CurMask I = array shape N fill 1
            Changed = true
          end
        end

        for J in 0 till N
          if ((PaintedC J) equal 0) and ((CurColCnt J) greater 1)
            PaintedC J = 1
            for I in 0 till N
              CurMask I J = 1
            end
            Changed = true
          end
        end
      end

      if ((PaintedR sum) greater 1) or ((PaintedC sum) greater 1)
        if (N + 2) less BestL
          BestL = N + 2
          BestC = C
        end
      end
    end
  end
end

Answer = "0 0"
if BestL less 1000000000
  Answer = (BestL text) + " " + (BestC text)
end

Answer print
