use testing

test "square (-1,-1) to (1,1)"
  use "0209_lattice_points"
  run

  Answer equal 1
end

test "triangle (0,0), (0,2), (2,0)"
  use "0209_lattice_points"
  XsText = "0 0 2"
  YsText = "0 2 0"
  run

  Answer equal 0
end

test "larger square 0 to 4"
  use "0209_lattice_points"
  XsText = "0 0 4 4"
  YsText = "0 4 4 0"
  run

  Answer equal 9
end
