use testing

test "square (-1,-1) to (1,1)"
  use "0209_lattice_points" as solve
  Answer = solve "-1 -1 1 1" "-1 1 1 -1"

  Answer equal 1
end

test "triangle (0,0), (0,2), (2,0)"
  use "0209_lattice_points" as solve
  Answer = solve "0 0 2" "0 2 0"

  Answer equal 0
end

test "larger square 0 to 4"
  use "0209_lattice_points" as solve
  Answer = solve "0 0 4 4" "0 4 4 0"

  Answer equal 9
end
