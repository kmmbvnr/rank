use testing

test "sample 1: 2x2 table, max sum 3"
  use "0219_cute_tables" as solve
  Answer = solve 2 2 "2 2" "1 2" "1 -1\n-1 -1"

  Answer equal 3
end

test "impossible config returns -1"
  use "0219_cute_tables" as solve
  Answer = solve 2 2 "2 2" "1 2" "5 -1\n-1 -1"

  Answer equal -1
end

test "ACMP 219: fully prefilled table"
  use "0219_cute_tables" as solve
  Answer = solve 2 2 "5 5" "5 5" "1 2\n1 1"

  Answer equal 5
end

test "all empty 3x3 symmetric limits"
  use "0219_cute_tables" as solve
  Answer = solve 3 3 "10 10 10" "10 10 10" "-1 -1 -1\n-1 -1 -1\n-1 -1 -1"

  Answer equal 30
end
