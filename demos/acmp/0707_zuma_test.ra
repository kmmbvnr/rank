use testing

test "sample 1: ABBBAA -> 1 B1"
  use "0707_zuma" as solve
  Ans = solve "ABBBAA"

  Ans equal "1 B1"
end

test "sample 3: BAAA -> 3 B0 B0 A0"
  use "0707_zuma" as solve
  Ans = solve "BAAA"

  Ans equal "3 B0 B0 A0"
end

test "sample 2: ACMNEERC -> 10 shots"
  use "0707_zuma" as solve
  Ans = solve "ACMNEERC"

  Exp = (
    "10 A0 A0 C0 M2 M2 " +
    "N2 N2 E2 R2 R2"
  )
  Ans equal Exp
end

test "trivial: AA -> 1 A0"
  use "0707_zuma" as solve
  Ans = solve "AA"

  Ans equal "1 A0"
end

test "already triple: AAA -> 1 A0"
  use "0707_zuma" as solve
  Ans = solve "AAA"

  Ans equal "1 A0"
end
