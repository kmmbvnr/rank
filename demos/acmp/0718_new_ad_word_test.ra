rem Tests for ACMP 0718: New Ad Word

use testing
use text

test "ACMP 718: Sample 1 (zenit)"
  use "0718_new_ad_word" as solve
  Result = solve "3 4
tiet
oink
ezin
zenit"

  Result equal "3
1 2 3"
end

test "ACMP 718: Sample 2 (sam)"
  use "0718_new_ad_word" as solve
  use text
  Result = solve "2 11
sillysample
happysample
sam"

  Lines = Result split "\n"
  (Lines 0) equal "1"
end

test "ACMP 718: Sample 3 (bb)"
  use "0718_new_ad_word" as solve
  use text
  Result = solve "2 3
baa
aab
bb"

  Lines = Result split "\n"
  (Lines 0) equal "2"
end

test "ACMP 718: Sample 4 (impossible)"
  use "0718_new_ad_word" as solve
  Result = solve "2 3
aaa
bbb
cc"

  Result equal "-1"
end

test "ACMP 718: Default input"
  use "0718_new_ad_word" as solve
  use text
  Result = solve

  Lines = Result split "\n"
  (Lines 0) equal "1"
end
