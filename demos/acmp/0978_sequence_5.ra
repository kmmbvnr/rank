rem Sequence 5
rem ACMP 978
rem Max k such that n^k divides n!

use numbers
use sequences
use algo
use io
use cli

arg N integer = 1000000000

fun N legendreSum P
  Leg = 0
  X = N // P
  for X greater 0
    Leg += X
    X //= P
  end
  return Leg
end

Factors = N factors array
Primes = Factors unique array

Ks = new queue
for P in Primes
  EqP = Factors equal P
  E = EqP count
  Leg = N legendreSum P
  Ks push (Leg // E)
end

AnsArr = Ks array
return AnsArr min
