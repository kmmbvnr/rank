use testing

test "sample 1: TROT -> TORT (2 ways)"
  use "0223_anagrammer" as solve
  Answer = solve "TROT" "TORT"

  Answer equal 2
end

test "sample 2: MADAM -> ADAMM (4 ways)"
  use "0223_anagrammer" as solve
  Answer = solve "MADAM" "ADAMM"

  Answer equal 4
end

test "sample 3: LONG -> GONG (0 ways)"
  use "0223_anagrammer" as solve
  Answer = solve "LONG" "GONG"

  Answer equal 0
end

test "sample 4: Catalan C_8 = 1430"
  use "0223_anagrammer" as solve
  Answer = solve "AAAAAAAA" "AAAAAAAA"

  Answer equal 1430
end
