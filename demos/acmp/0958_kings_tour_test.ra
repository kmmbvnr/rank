use testing
use text

test "sample: merge two routes"
  use "0958_kings_tour"
  run

  Ans equal "1 3 2 4 5 6 7"
end

test "single route stays as is"
  use "0958_kings_tour"
  Input = "4 1
.---
+.--
++.-
+++.
1 2 3 4"
  run

  Ans equal "1 2 3 4"
end

test "three routes, 12 cities"
  use "0958_kings_tour"
  Input = "12 3
.+---+---++-
-.-+-++--+-+
++.--+---++-
+-+.+++-++++
+++-.-------
----+.+-++--
+-+-+-.-++--
+++++++.---+
+++-+--+.-+-
----+--++.++
-+--++++--.-
+-+-+++-+-+.
1 4 2 8 11 12
1 5 10 7 12
1 3 9 6 12"
  run

  Ans equal "1 3 5 9 10 7 6 4 2 8 11 12"
end

test "three single-city routes"
  use "0958_kings_tour"
  Input = "5 3
.----
+.-+-
++.--
+-+.-
++++.
1 2 5
1 3 5
1 4 5"
  run

  Ans equal "1 4 2 3 5"
end
