rem Strings - 3 (Строки - 3)
rem https://acmp.ru/index.asp?main=task&id_task=829
rem Count substrings of A that are cyclic shifts of B.
rem Solved in O(|A| + |B|) via double polynomial rolling hash (MOD 10^9+7 and 10^9+9) with a hash set.

use io
use numbers
use cli
use sequences
use text
use algo

arg Input text = "abcabc\nabc"

RawLines = Input split "\n"
Lines = RawLines (RawLines not equal "")
A = Lines 0
B = Lines 1

N = A len
M = B len

Matches = 0

if not (M greater N)
  BytesA = A bytes integer
  BytesB = B bytes integer
  BytesBB = concat BytesB BytesB

  MOD1 = 1000000007
  MOD2 = 1000000009
  BASE = 313

  P1 = 1
  P2 = 1
  for I in 0 till (M - 1)
    P1 = (P1 * BASE) mod MOD1
    P2 = (P2 * BASE) mod MOD2
  end

  ShiftSet = new set

  CurH1 = 0
  CurH2 = 0
  for I in 0 till M
    Code = BytesBB I
    CurH1 = ((CurH1 * BASE) + Code) mod MOD1
    CurH2 = ((CurH2 * BASE) + Code) mod MOD2
  end
  ShiftSet add ((CurH1 * 2000000000) + CurH2)

  for I in M till ((2 * M) - 1)
    OutCode = BytesBB (I - M)
    InCode = BytesBB I
    CurH1 = ((((CurH1 + MOD1) - ((OutCode * P1) mod MOD1)) * BASE) + InCode) mod MOD1
    CurH2 = ((((CurH2 + MOD2) - ((OutCode * P2) mod MOD2)) * BASE) + InCode) mod MOD2
    ShiftSet add ((CurH1 * 2000000000) + CurH2)
  end

  AH1 = 0
  AH2 = 0
  for I in 0 till M
    Code = BytesA I
    AH1 = ((AH1 * BASE) + Code) mod MOD1
    AH2 = ((AH2 * BASE) + Code) mod MOD2
  end

  InitKey = (AH1 * 2000000000) + AH2
  if InitKey in ShiftSet
    Matches = Matches + 1
  end

  for I in M till N
    OutCode = BytesA (I - M)
    InCode = BytesA I
    AH1 = ((((AH1 + MOD1) - ((OutCode * P1) mod MOD1)) * BASE) + InCode) mod MOD1
    AH2 = ((((AH2 + MOD2) - ((OutCode * P2) mod MOD2)) * BASE) + InCode) mod MOD2
    Key = (AH1 * 2000000000) + AH2
    if Key in ShiftSet
      Matches = Matches + 1
    end
  end
end

(Matches text) print
