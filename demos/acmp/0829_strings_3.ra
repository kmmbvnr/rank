rem Strings 3
rem https://acmp.ru/
rem   index.asp?main=task&id_task=829
rem Count substrings cyclic shifts of B

use io
use numbers
use cli
use sequences
use text
use algo

arg Input text = (
  "abcdefghabcdefghabcdefghabcdefgh" +
  "abcdefghabcdefghabcdefghabcdefgh" +
  "abcdefghabcdefghabcdefghabcdefgh\n" +
  "efghabcd"
)

RawLines = Input split "\n"
Lines = RawLines (RawLines not equal "")
A = Lines 0
B = Lines 1

N = A len
M = B len

Matches = 0

if not (M greater N)
  BytesA = A bytes integer
  BytesB = B bytes integer
  BytesBB = concat BytesB BytesB

  MOD1 = 1000000007
  MOD2 = 1000000009
  BASE = 313

  P1 = 1
  P2 = 1
  for I in 0 till (M - 1)
    P1 = P1 * BASE mod MOD1
    P2 = P2 * BASE mod MOD2
  end

  ShiftSet = new set

  CurH1 = 0
  CurH2 = 0
  for I in 0 till M
    Code = BytesBB I
    H1_Next = (CurH1 * BASE) + Code
    CurH1 = H1_Next mod MOD1
    H2_Next = (CurH2 * BASE) + Code
    CurH2 = H2_Next mod MOD2
  end
  KeyBase = CurH1 * 2000000000
  ShiftSet add (KeyBase + CurH2)

  LimitBB = (2 * M) - 1
  for I in M till LimitBB
    OutCode = BytesBB (I - M)
    InCode = BytesBB I

    Sub1 = OutCode * P1 mod MOD1
    H1_diff = (CurH1 + MOD1) - Sub1
    H1_next = (H1_diff * BASE) + InCode
    CurH1 = H1_next mod MOD1

    Sub2 = OutCode * P2 mod MOD2
    H2_diff = (CurH2 + MOD2) - Sub2
    H2_next = (H2_diff * BASE) + InCode
    CurH2 = H2_next mod MOD2

    KBase = CurH1 * 2000000000
    ShiftSet add (KBase + CurH2)
  end

  AH1 = 0
  AH2 = 0
  for I in 0 till M
    Code = BytesA I
    H1_next = (AH1 * BASE) + Code
    AH1 = H1_next mod MOD1
    H2_next = (AH2 * BASE) + Code
    AH2 = H2_next mod MOD2
  end

  InitBase = AH1 * 2000000000
  InitKey = InitBase + AH2
  if InitKey in ShiftSet
    Matches = Matches + 1
  end

  for I in M till N
    OutCode = BytesA (I - M)
    InCode = BytesA I

    Sub1 = OutCode * P1 mod MOD1
    H1_diff = (AH1 + MOD1) - Sub1
    H1_next = (H1_diff * BASE) + InCode
    AH1 = H1_next mod MOD1

    Sub2 = OutCode * P2 mod MOD2
    H2_diff = (AH2 + MOD2) - Sub2
    H2_next = (H2_diff * BASE) + InCode
    AH2 = H2_next mod MOD2

    KBase = AH1 * 2000000000
    Key = KBase + AH2
    if Key in ShiftSet
      Matches = Matches + 1
    end
  end
end

return Matches
