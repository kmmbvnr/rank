rem Circular Highway
rem https://acmp.ru/
rem   index.asp?main=task&id_task=714
rem Equidistant circle to 4 points

use io
use cli
use numbers
use sequences
use text

arg Input text = (
  "-500 -300\n" +
  "-200 400\n" +
  "600 200\n" +
  "100 -700"
)

Tokens = (
  (Input split "\n" join " ")
  split " "
)
Tokens = Tokens (Tokens not equal "")
Coords = Tokens real

Xs = Coords (array 0 2 4 6)
Ys = Coords (array 1 3 5 7)

CandX = array 0.0
CandX = CandX drop 1
CandY = array 0.0
CandY = CandY drop 1
CandR = array 0.0
CandR = CandR drop 1

IsInfinity = false

Ta = array 1 0 0 0
Tb = array 2 2 1 1
Tc = array 3 3 3 2
Td = array 0 1 2 3

for K in 0 till 4
  Ax = Xs (Ta K)
  Ay = Ys (Ta K)
  Bx = Xs (Tb K)
  By = Ys (Tb K)
  Cx = Xs (Tc K)
  Cy = Ys (Tc K)
  Dx = Xs (Td K)
  Dy = Ys (Td K)

  Cross1 = (Bx - Ax) * (Cy - Ay)
  Cross2 = (By - Ay) * (Cx - Ax)
  Cross = Cross1 - Cross2
  CrossAbs = Cross abs
  if CrossAbs greater 0.000000001
    D1 = Ax * (By - Cy)
    D2 = Bx * (Cy - Ay)
    D3 = Cx * (Ay - By)
    Denom = 2.0 * (D1 + D2 + D3)
    DenomAbs = Denom abs
    if DenomAbs greater 0.000000001
      A2 = Ax * Ax + Ay * Ay
      B2 = Bx * Bx + By * By
      C2 = Cx * Cx + Cy * Cy

      NumUx = (
        A2 * (By - Cy) +
        B2 * (Cy - Ay) +
        C2 * (Ay - By)
      )
      Ux = NumUx / Denom
      NumUy = (
        A2 * (Cx - Bx) +
        B2 * (Ax - Cx) +
        C2 * (Bx - Ax)
      )
      Uy = NumUy / Denom

      DAx = Ax - Ux
      DAy = Ay - Uy
      DDx = Dx - Ux
      DDy = Dy - Uy
      DistSq1 = DAx * DAx + DAy * DAy
      DistSq2 = DDx * DDx + DDy * DDy
      R1 = DistSq1 sqrt
      R2 = DistSq2 sqrt

      CandX = concat CandX (array Ux)
      CandY = concat CandY (array Uy)

      DiffR = R1 - R2
      DiffRAbs = DiffR abs
      if DiffRAbs less 0.0000001
        IsInfinity = true
        CandR = concat CandR (array 0.0)
      else
        AvgR = (R1 + R2) / 2.0
        ArrAvg = array AvgR
        CandR = concat CandR ArrAvg
      end
    end
  end
end

Pa = array 0 0 0
Pb = array 1 2 3
Pc = array 2 1 1
Pd = array 3 3 2

for K in 0 till 3
  Ax = Xs (Pa K)
  Ay = Ys (Pa K)
  Bx = Xs (Pb K)
  By = Ys (Pb K)
  Cx = Xs (Pc K)
  Cy = Ys (Pc K)
  Dx = Xs (Pd K)
  Dy = Ys (Pd K)

  A1 = Bx - Ax
  B1 = By - Ay
  C1 = (
    Bx * Bx - Ax * Ax +
    By * By - Ay * Ay
  ) / 2.0

  A2 = Dx - Cx
  B2 = Dy - Cy
  C2 = (
    Dx * Dx - Cx * Cx +
    Dy * Dy - Cy * Cy
  ) / 2.0

  Det = A1 * B2 - A2 * B1
  Det1 = C1 * B2 - C2 * B1
  Det2 = A1 * C2 - A2 * C1

  DetAbs = Det abs
  if DetAbs less 0.000000001
    D1Abs = Det1 abs
    D2Abs = Det2 abs
    Deg1 = D1Abs less 0.000000001
    Deg2 = D2Abs less 0.000000001
    if Deg1 and Deg2
      IsInfinity = true
      M1x = (Ax + Bx) / 2.0
      M1y = (Ay + By) / 2.0
      M2x = (Cx + Dx) / 2.0
      M2y = (Cy + Dy) / 2.0

      LenAB = A1 * A1 + B1 * B1
      LenCD = A2 * A2 + B2 * B2
      SqrtAB = LenAB sqrt
      SqrtCD = LenCD sqrt
      D1 = SqrtAB / 2.0
      D2 = SqrtCD / 2.0

      LnormSq = A1 * A1 + B1 * B1
      Lnorm = LnormSq sqrt
      Uxdir = (0.0 - B1) / Lnorm
      Uydir = A1 / Lnorm

      T0 = (
        (M2x - M1x) * Uxdir +
        (M2y - M1y) * Uydir
      )
      T0Abs = T0 abs
      if T0Abs greater 0.000000001
        T0Sq = T0 * T0
        NumT = D2 * D2 - D1 * D1 + T0Sq
        DenT = 2.0 * T0
        Tstar = NumT / DenT
        StarX = M1x + Tstar * Uxdir
        StarY = M1y + Tstar * Uydir
        CandX = concat CandX (
          array StarX
        )
        CandY = concat CandY (
          array StarY
        )
        CandR = concat CandR (
          array 0.0
        )
      else
        CandX = concat CandX (array M1x)
        CandY = concat CandY (array M1y)
        AvgD = (D1 + D2) / 2.0
        ArrAvg = array AvgD
        CandR = concat CandR ArrAvg
      end
    end
  else
    Ox = Det1 / Det
    Oy = Det2 / Det
    DAx = Ax - Ox
    DAy = Ay - Oy
    DCx = Cx - Ox
    DCy = Cy - Oy
    DistSq1 = DAx * DAx + DAy * DAy
    DistSq2 = DCx * DCx + DCy * DCy
    R1 = DistSq1 sqrt
    R2 = DistSq2 sqrt

    CandX = concat CandX (array Ox)
    CandY = concat CandY (array Oy)

    DiffR = R1 - R2
    DiffRAbs = DiffR abs
    if DiffRAbs less 0.0000001
      IsInfinity = true
      CandR = concat CandR (array 0.0)
    else
      AvgR = (R1 + R2) / 2.0
      CandR = concat CandR (array AvgR)
    end
  end
end

NCand = CandX len
Keep = (0 till NCand) * 0 + 1
for I in 0 till NCand
  NextI = I + 1
  for J in NextI till NCand
    DiffX = CandX I - CandX J
    DiffY = CandY I - CandY J
    DiffR = CandR I - CandR J
    DXAbs = DiffX abs
    DYAbs = DiffY abs
    DRAbs = DiffR abs
    EqX = DXAbs less 0.00001
    EqY = DYAbs less 0.00001
    EqR = DRAbs less 0.00001
    if EqX and EqY and EqR
      Keep J = 0
    end
  end
end
UniqueCount = Keep sum

Order = CandR argsort
BestIdx = Order 0
BestX = CandX BestIdx
BestY = CandY BestIdx
BestR = CandR BestIdx

Answer1 = UniqueCount text
if IsInfinity
  Answer1 = "Infinity"
end

Answer1 print
BXTxt = BestX text
BYTxt = BestY text
BRTxt = BestR text
PosTxt = BXTxt + " " + BYTxt
Answer2 = PosTxt + " " + BRTxt
Answer2 print
