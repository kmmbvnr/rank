rem Time Key 2
rem ACMP 644
rem N <- N + popcount(N) for K steps
rem Binary lifting over bit blocks

use io
use numbers
use cli
use sequences
use text
use bits

arg Input text = "2000000000 2000000000"

Lines = Input split "\n"
Line = Lines join " "
Tokens = Line split " "
Tokens = Tokens (Tokens not equal "")
N = Tokens 0 integer
K = Tokens 1 integer

MaxB = 36
MaxP = 42
MaxRem = 64
NPR = (MaxP + 1) * MaxRem
TotalSize = (MaxB + 1) * NPR

Sz = TotalSize
CrossSteps = array shape Sz fill 0
CrossOver = array shape Sz fill 0

Idx = 0 till NPR
P = Idx // MaxRem
Rem = Idx mod MaxRem

Cur = Rem
S = array shape NPR fill 0

for Step in 0 till 64
  Active = Cur less 64
  PCount = Cur popcount
  Delta = P + PCount
  NextCur = Cur + Delta
  NextS = S + 1
  Cur = Active choose NextCur Cur
  S = Active choose NextS S
end

IdBase = (6 * NPR) + Idx
CrossSteps IdBase = S
CrossOver IdBase = Cur - 64

for B in 7 to MaxB
  BasePrev = (B - 1) * NPR
  BaseCur = B * NPR
  Id1 = BasePrev + Idx
  S1 = CrossSteps Id1
  R1 = CrossOver Id1
  P2 = (P + 1) min MaxP
  Id2 = BasePrev + (P2 * MaxRem) + R1
  S2 = CrossSteps Id2
  R2 = CrossOver Id2
  IdCur = BaseCur + Idx
  CrossSteps IdCur = S1 + S2
  CrossOver IdCur = R2
end

AllB = (6 to MaxB) reverse
AllMask = (1 shl AllB) - 1

for Iter in 0 till 2000000000
  if K equal 0
    break
  end
  RemN = N band 63
  Base = N - RemN
  IsZero = (Base band AllMask) equal 0
  CandB = AllB IsZero
  U = N shr CandB
  PPop = (U popcount) min MaxP
  Id = (CandB * NPR) + (PPop * MaxRem)
  Id = Id + RemN
  S = CrossSteps Id
  CanJump = S at most K
  JumpB = CandB CanJump
  if JumpB len greater 0
    BestB = JumpB 0
    BestU = (U CanJump) 0
    BestId = (Id CanJump) 0
    BestS = (S CanJump) 0
    Over = CrossOver BestId
    N = (BestU + 1 shl BestB) + Over
    K = K - BestS
  else
    PopN = N popcount
    N = N + PopN
    K = K - 1
  end
end

return N
