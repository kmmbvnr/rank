use testing
use numbers

test "sample 1: general quad -> 7"
  use "0714_circular_highway" as solve
  use numbers
  Out = solve "0 0\n0 1\n1 0\n2 2"
  Answer1 = Out .answer1
  BestR = Out .best_r

  Answer1 equal "7"
  (BestR round 4) equal 1.1441
end

test "sample 2: unit square -> Inf"
  use "0714_circular_highway" as solve
  use numbers
  Out = solve "0 0\n0 1\n1 0\n1 1"
  Answer1 = Out .answer1
  BestR = Out .best_r
  BestX = Out .best_x
  BestY = Out .best_y

  Answer1 equal "Infinity"
  (BestX round 4) equal 0.5
  (BestY round 4) equal 0.5
  (BestR round 4) equal 0.0
end

test "collinear points with midpoint"
  use "0714_circular_highway" as solve
  use numbers
  Out = solve "0 0\n1 0\n2 0\n3 0"
  Answer1 = Out .answer1
  BestR = Out .best_r
  BestX = Out .best_x
  BestY = Out .best_y

  Answer1 equal "Infinity"
  (BestX round 4) equal 1.5
  (BestY round 4) equal 0.0
  (BestR round 4) equal 1.0
end

test "collinear vertical points"
  use "0714_circular_highway" as solve
  use numbers
  Out = solve "0 0\n0 2\n0 4\n0 6"
  Answer1 = Out .answer1
  BestR = Out .best_r
  BestX = Out .best_x
  BestY = Out .best_y

  Answer1 equal "Infinity"
  (BestX round 4) equal 0.0
  (BestY round 4) equal 3.0
  (BestR round 4) equal 2.0
end

test "rectangle with origin center"
  use "0714_circular_highway" as solve
  use numbers
  Out = solve "-2 -1\n2 -1\n2 1\n-2 1"
  Answer1 = Out .answer1
  BestR = Out .best_r
  BestX = Out .best_x
  BestY = Out .best_y

  Answer1 equal "Infinity"
  (BestX round 4) equal 0.0
  (BestY round 4) equal 0.0
  (BestR round 4) equal 0.0
end
