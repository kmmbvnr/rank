rem Tests for ACMP 0815 Maze Walker

use testing

test "sample 1 from statement"
  use "0815_maze_walker"
  run

  Status equal "OK"
  Count equal 2
  Result equal "3 4"
end

test "sample 2 hangs"
  use "0815_maze_walker"
  Input = "4 6 2
1 2 1
1 2 2
1 3 1
1 3 2
3 4 1
3 3 1
2
1 2
1"
  run

  Status equal "Hangs"
  Count equal 0
end

test "single node self loop"
  use "0815_maze_walker"
  Input = "1 1 1
1 1 1
3
1 1 1
1"
  run

  Status equal "OK"
  Count equal 1
  Result equal "1"
end

test "no edges hangs"
  use "0815_maze_walker"
  Input = "2 0 1
1
1
1"
  run

  Status equal "Hangs"
  Count equal 0
end

test "two steps cycle"
  use "0815_maze_walker"
  Input = "3 3 2
1 2 1
1 3 2
2 1 1
2
1 1
1"
  run

  Status equal "OK"
  Count equal 1
  Result equal "1"
end
