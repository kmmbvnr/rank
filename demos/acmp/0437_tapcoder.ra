rem ACMP 0437: Tapcoder
rem Compressed tournament bracket tree
rem with bottom-up DP and top-down push
use io
use cli
use numbers
use sequences
use text
use bits
use algo

arg Input text = "4 10 8
1 2
3 4
1 3
5 6
7 8
5 7
1 5
9 10
11 12
9 13
1 2 3 4 5 8 9 16"

Clean = Input split "\r" join " "
Clean = Clean split "\n" join " "
Tokens = Clean split " "
Tokens = Tokens (Tokens not equal "")
TokInts = Tokens integer

K = TokInts 0
N = TokInts 1
M = TokInts 2

QBase = 3 + (2 * N)
QEnd = QBase + M
QSlice = TokInts (QBase till QEnd)
Queries = QSlice - 1

Win = array 0
Lose = array 0
AllPlayers = Queries

if N greater 0
  Pairs = (TokInts (3 till QBase)) - 1
  Idx2 = (0 till N) * 2
  Win = Pairs Idx2
  Lose = Pairs (Idx2 + 1)
  AllLoss = concat Win Lose
  AllPlayers = concat AllLoss Queries
end

SortedPlayers = AllPlayers sort
UPlayers = SortedPlayers unique
S = UPlayers len
MaxNodes = ((2 * S) * (K + 1)) + 4
MaxItems = MaxNodes + 4

NodeCode = array shape MaxNodes fill 0
NodeStep = array shape MaxNodes fill 0
LeftCh = array shape MaxNodes fill -1
RightCh = array shape MaxNodes fill -1
StartV = array shape MaxNodes fill 0
EndV = array shape MaxNodes fill 0
ItemP = array shape MaxItems fill 0
OkV = array shape MaxItems fill 0

LeafIds = 0 till S
NodeCode LeafIds = UPlayers
StartV LeafIds = LeafIds
EndV LeafIds = LeafIds + 1
ItemP LeafIds = LeafIds
NumNodes = S
NumItems = S

LayStart = array shape (K + 2) fill 0
LayEnd = array shape (K + 2) fill 0
LayStart 0 = 0
LayEnd 0 = S

LKeys = array -1
if N greater 0
  WinLeaf = UPlayers lowerindex Win
  LoseLeaf = UPlayers lowerindex Lose
  LoseRaw = (LoseLeaf * S) + WinLeaf
  LKeys = LoseRaw sort
end

MaxRound = array shape S fill 1

Phase = 0
Step = 0
I = 0
R0 = S
CurV = 0

for Phase less 2
  if Phase equal 0
    if Step less K
      if I less R0
        Code0 = NodeCode I
        ParC = Code0 shr 1
        Bit0 = Code0 mod 2
        HasPair = false
        if (I + 1) less R0
          Code1 = NodeCode (I + 1)
          if (Code1 shr 1) equal ParC
            HasPair = true
          end
        end

        V = NumNodes
        NumNodes = NumNodes + 1
        NodeCode V = ParC
        NodeStep V = Step + 1
        StartV V = NumItems

        if HasPair
          U1 = I
          U2 = I + 1
          LeftCh V = U1
          RightCh V = U2
          S1 = StartV U1
          E1 = EndV U1
          S2 = StartV U2
          E2 = EndV U2
          Len1 = E1 - S1
          Len2 = E2 - S2
          Has1 = Len1 greater 0
          Has2 = Len2 greater 0
          LenBoth = Has1 and Has2
          if LenBoth
            P1 = ItemP (S1 till E1)
            P2 = ItemP (S2 till E2)

            P1S = P1 * S
            Q12 = P1S P2 outer +
            L12 = LKeys lowerindex Q12
            U12 = LKeys upperindex Q12
            H12 = U12 - L12
            C1 = H12 sum axis 1
            Pass1 = P1 (C1 less Len2)
            NPass1 = Pass1 len
            if NPass1 greater 0
              End1 = NumItems + NPass1
              Dst1 = NumItems till End1
              ItemP Dst1 = Pass1
              NumItems = End1
            end

            P2S = P2 * S
            Q21 = P2S P1 outer +
            L21 = LKeys lowerindex Q21
            U21 = LKeys upperindex Q21
            H21 = U21 - L21
            C2 = H21 sum axis 1
            Pass2 = P2 (C2 less Len1)
            NPass2 = Pass2 len
            if NPass2 greater 0
              End2 = NumItems + NPass2
              Dst2 = NumItems till End2
              ItemP Dst2 = Pass2
              NumItems = End2
            end
          end
          EndV V = NumItems
          I = I + 2
        else
          U1 = I
          if Bit0 equal 0
            LeftCh V = U1
          else
            RightCh V = U1
          end
          S1 = StartV U1
          E1 = EndV U1
          Len1 = E1 - S1
          if Len1 greater 0
            P1 = ItemP (S1 till E1)
            End1 = NumItems + Len1
            Dst1 = NumItems till End1
            ItemP Dst1 = P1
            NumItems = End1
          end
          EndV V = NumItems
          I = I + 1
        end
      else
        LayEnd (Step + 1) = NumNodes
        OldStep = Step
        Step = Step + 1
        LayStart Step = LayEnd OldStep
        I = LayStart Step
        R0 = LayEnd Step
      end
    else
      RootV = NumNodes - 1
      SR = StartV RootV
      ER = EndV RootV
      if ER greater SR
        OkV (SR till ER) = 1
      end
      CurV = RootV
      Phase = 1
    end
  elif Phase equal 1
    if CurV greater (S - 1)
      SV = StartV CurV
      EV = EndV CurV
      Stp = NodeStep CurV
      U1 = LeftCh CurV
      U2 = RightCh CurV

      HasU1 = U1 greater -1
      HasU2 = U2 greater -1
      if HasU1 and HasU2
        S1 = StartV U1
        E1 = EndV U1
        S2 = StartV U2
        E2 = EndV U2
        Len1 = E1 - S1
        Len2 = E2 - S2
        LenBoth = (Len1 greater 0) and (
          Len2 greater 0
        )
        if LenBoth
          P1 = ItemP (S1 till E1)
          P2 = ItemP (S2 till E2)

          HasAct = false
          ActP = 0 till 0
          if EV greater SV
            PV = ItemP (SV till EV)
            OkSub = OkV (SV till EV)
            ActP = PV (OkSub equal 1)
            HasAct = ActP len greater 0
          end

          if HasAct
            rem Split ActP into U1, U2
            MaxP1 = P1 (Len1 - 1)
            MaxP1_1 = MaxP1 + 1
            In1 = ActP less MaxP1_1
            Act1 = ActP In1
            Act2 = ActP (not In1)
            NAct1 = Act1 len
            NAct2 = Act2 len

            if NAct1 greater 0
              Pos1 = P1 lowerindex Act1
              OkV (S1 + Pos1) = 1
              rem Valid opponents in P2
              A1S = Act1 * S
              Q12 = A1S P2 outer +
              L12 = LKeys lowerindex Q12
              U12 = LKeys upperindex Q12
              H12 = U12 - L12
              Cnt12 = H12 sum axis 0
              Can2 = Cnt12 less NAct1
              All2 = 0 till Len2
              Idx2 = All2 Can2
              NIdx2 = Idx2 len
              if NIdx2 greater 0
                OkV (S2 + Idx2) = 1
              end
            end

            if NAct2 greater 0
              Pos2 = P2 lowerindex Act2
              OkV (S2 + Pos2) = 1
              rem Valid opponents in P1
              A2S = Act2 * S
              Q21 = A2S P1 outer +
              L21 = LKeys lowerindex Q21
              U21 = LKeys upperindex Q21
              H21 = U21 - L21
              Cnt21 = H21 sum axis 0
              Can1 = Cnt21 less NAct2
              All1 = 0 till Len1
              Idx1 = All1 Can1
              NIdx1 = Idx1 len
              if NIdx1 greater 0
                OkV (S1 + Idx1) = 1
              end
            end
          end

          Ok1 = OkV (S1 till E1)
          Good1 = P1 (Ok1 equal 1)
          NGood1 = Good1 len
          if NGood1 greater 0
            Cur1 = MaxRound Good1
            Cand1 = (Cur1 * 0) + Stp
            Upd1 = Cand1 max Cur1
            MaxRound Good1 = Upd1
          end

          Ok2 = OkV (S2 till E2)
          Good2 = P2 (Ok2 equal 1)
          NGood2 = Good2 len
          if NGood2 greater 0
            Cur2 = MaxRound Good2
            Cand2 = (Cur2 * 0) + Stp
            Upd2 = Cand2 max Cur2
            MaxRound Good2 = Upd2
          end
        end
      else
        UOnly = U1 max U2
        SO = StartV UOnly
        EO = EndV UOnly
        LenO = EO - SO
        if LenO greater 0
          PO = ItemP (SO till EO)
          if EV greater SV
            OkSV = OkV (SV till EV)
            OkV (SO till EO) = OkSV
          end
          OkO = OkV (SO till EO)
          GoodO = PO (OkO equal 1)
          NGoodO = GoodO len
          if NGoodO greater 0
            CurO = MaxRound GoodO
            CandO = (CurO * 0) + Stp
            UpdO = CandO max CurO
            MaxRound GoodO = UpdO
          end
        end
      end
      CurV = CurV - 1
    else
      Phase = 2
    end
  end
end

QLeaf = UPlayers lowerindex Queries
Ans = MaxRound QLeaf
Result = Ans join " "
return Result
