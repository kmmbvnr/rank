rem Zuma
rem https://acmp.ru/
rem   index.asp?main=task&id_task=707
rem Min shots to clear Zuma row via BFS

use io
use numbers
use cli
use sequences
use text
use algo

arg Input text = "AABBCCAABBAA"

fun S C Pos simulate_shot
  LeftPart = S (0 till Pos)
  RightPart = S (Pos till (S len))
  Parts = array LeftPart C RightPart
  TextChars = Parts join ""
  Chars = TextChars split ""
  N = Chars len
  L = Pos
  R = Pos

  for Step in 0 till N
    LeftEnd = L equal 0
    PrevChar = ""
    if not LeftEnd
      PrevChar = Chars (L - 1)
    end
    DiffL = PrevChar not equal C
    if LeftEnd or DiffL
      break
    end
    L = L - 1
  end

  for Step in 0 till N
    RightEnd = R equal (N - 1)
    NextChar = ""
    if not RightEnd
      NextChar = Chars (R + 1)
    end
    DiffR = NextChar not equal C
    if RightEnd or DiffR
      break
    end
    R = R + 1
  end

  Span1 = R - L + 1
  if Span1 less 3
    return TextChars
  end

  for Chain in 0 till 20
    OldN = N
    LeftSlice = Chars (0 till L)
    NextR = R + 1
    RightSlice = Chars (NextR till N)
    Chars = concat LeftSlice RightSlice
    N = Chars len

    L0 = L equal 0
    ROld = R equal (OldN - 1)
    N0 = N equal 0
    if L0 or ROld or N0
      break
    end

    LeftChar = Chars (L - 1)
    RightChar = Chars L
    if LeftChar not equal RightChar
      break
    end

    C2 = LeftChar
    NewL = L - 1
    NewR = L

    for Step in 0 till N
      LeftEnd = NewL equal 0
      PrevC2 = ""
      if not LeftEnd
        PrevC2 = Chars (NewL - 1)
      end
      DiffC = PrevC2 not equal C2
      if LeftEnd or DiffC
        break
      end
      NewL = NewL - 1
    end

    for Step in 0 till N
      RightEnd = NewR equal (N - 1)
      NextC2 = ""
      if not RightEnd
        NextC2 = Chars (NewR + 1)
      end
      DiffC = NextC2 not equal C2
      if RightEnd or DiffC
        break
      end
      NewR = NewR + 1
    end

    Span2 = NewR - NewL + 1
    if Span2 less 3
      break
    end

    L = NewL
    R = NewR
  end

  return Chars join ""
end

fun Initial solve_zuma
  if Initial equal ""
    return "0"
  end

  MaxStates = 15000
  NodeStr = (
    array shape MaxStates fill ""
  )
  NodeParent = (
    array shape MaxStates fill -1
  )
  NodeMove = (
    array shape MaxStates fill ""
  )

  NodeStr 0 = Initial
  NodeParent 0 = -1
  NodeMove 0 = ""
  NodeCount = 1

  Visited = new set
  Visited add Initial

  Q = new queue
  Q push 0

  TargetNode = -1
  Found = 0

  for Step in 0 till MaxStates
    if (Q len) equal 0
      break
    end

    CurId = Q pop
    CurS = NodeStr CurId

    if CurS equal ""
      TargetNode = CurId
      Found = 1
      break
    end

    CurLen = CurS len
    Chars = CurS split ""
    I = 0

    for BlockStep in 0 till CurLen
      if not (I less CurLen)
        break
      end
      J = I
      CurChar = Chars I
      for ForwardStep in 0 till CurLen
        EndJ = J equal CurLen
        DiffChar = false
        if not EndJ
          CharsJ = Chars J
          DiffChar = (
            CharsJ not equal CurChar
          )
        end
        if EndJ or DiffChar
          break
        end
        J = J + 1
      end

      NextS = (
        CurS CurChar I simulate_shot
      )
      if not (NextS in Visited)
        Visited add NextS
        NodeStr NodeCount = NextS
        NodeParent NodeCount = CurId
        ITxt = I text
        MoveTxt = CurChar + ITxt
        NodeMove NodeCount = MoveTxt
        Q push NodeCount
        if NextS equal ""
          TargetNode = NodeCount
          Found = 1
          NodeCount = NodeCount + 1
          break
        end
        NodeCount = NodeCount + 1
      end

      I = J
    end

    if Found equal 1
      break
    end
  end

  Curr = TargetNode
  Moves = array shape 0 fill ""
  for Step in 0 till 20
    if Curr equal 0
      break
    end
    CurMove = array (NodeMove Curr)
    Moves = concat CurMove Moves
    Curr = NodeParent Curr
  end

  NumMoves = Moves len
  if NumMoves equal 0
    return "0"
  end
  NM_Txt = NumMoves text
  M_Txt = Moves join " "
  return NM_Txt + " " + M_Txt
end

RawTokens = (
  (Input split "\n" join " ")
  split " "
)
Tokens = (
  RawTokens (RawTokens not equal "")
)
StartStr = Tokens 0

return StartStr solve_zuma
