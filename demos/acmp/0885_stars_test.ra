rem Tests for ACMP 0885 Stars

use testing

test "sample 2 winning search"
  use "0885_stars" as solve
  Out = solve
  Ans = Out .ans
  NumMoves = Out .num_moves
  Won = Out .won

  Won equal true
  NumMoves equal 3
  Ans equal "3\n4 6\n3 6\n3 6"
end

test "sample 1 impossible"
  use "0885_stars" as solve
  Out = solve "5
..........t
.......t...
O......t...
t..........
.........tO
..t..+.....
...........
...O.....Ot
...O.......
....t......
..t..O....."
  Ans = Out .ans
  Won = Out .won

  Won equal false
  Ans equal "IMPOSSIBLE"
end

test "zero enemies initially"
  use "0885_stars" as solve
  Out = solve "1
...
.+.
..."
  Ans = Out .ans
  NumMoves = Out .num_moves
  Won = Out .won

  Won equal true
  NumMoves equal 0
  Ans equal "0"
end

test "single enemy shot immediately"
  use "0885_stars" as solve
  Out = solve "1
.t.
.+.
..."
  Ans = Out .ans
  NumMoves = Out .num_moves
  Won = Out .won

  Won equal true
  NumMoves equal 1
  Ans equal "1\n1 1"
end
