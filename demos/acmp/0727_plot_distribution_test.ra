use testing
use text

test "sample: 3 companies -> 1 3 2"
  use "0727_plot_distribution"
  Input = "3
5 4 4
5 2 3
2 1 2"
  run

  Assign equal (array 0 2 1)
end

test "single company"
  use "0727_plot_distribution"
  Input = "1
7"
  run

  Assign equal (array 0)
end

test "Nash equilibrium (ties, 5x5)"
  use "0727_plot_distribution"
  Input = "5
3 3 3 3 3
3 3 3 3 3
1 9 1 9 1
9 1 9 1 9
5 5 5 5 5"
  run

  Ok = 1
  for I in 0 till N
    Now = 0
    EqI = Assign equal (Assign I)
    if (EqI count) equal 1
      Now = (Vals (I * N + (Assign I)))
    end
    rem Winner of plot J
    for J in 0 till N
      Best = Vals (I * N + J)
      Wins = 1
      for K in 0 till N
        DiffK = K not equal I
        ClaimJ = (Assign K) equal J
        if DiffK and ClaimJ
          Other = Vals (K * N + J)
          DiffVal = Other greater Best
          EqVal = Other equal Best
          LessVal = K less I
          TieVal = EqVal and LessVal
          Beats = DiffVal or TieVal
          if Beats
            Wins = 0
          end
        end
      end
      Gain = Best * Wins
      if Gain greater Now
        Ok = 0
      end
    end
  end

  Ok equal 1
end

test "max n = 400 perfect matching"
  use text
  use "0727_plot_distribution"
  Idx400 = 0 till 160000
  P400 = (Idx400 * 7919) mod 1000003
  Cells = P400 + 1
  Input = "400 " + (Cells join " ")
  run

  (Taken sum) equal 400
  (Assign min) at least 0
end
