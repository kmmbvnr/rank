use testing
use text

test "sample: 3 companies -> 1 3 2"
  use "0727_plot_distribution"
  Input = "3
5 4 4
5 2 3
2 1 2"
  run

  Assign equal (array 0 2 1)
end

test "single company"
  use "0727_plot_distribution"
  Input = "1
7"
  run

  Assign equal (array 0)
end

test "result is a Nash equilibrium (ties, 5x5)"
  use "0727_plot_distribution"
  Input = "5
3 3 3 3 3
3 3 3 3 3
1 9 1 9 1
9 1 9 1 9
5 5 5 5 5"
  run

  Ok = 1
  for I in 0 till N
    Now = 0
    if ((Assign equal (Assign I)) count) equal 1
      Now = (Vals (I * N + (Assign I)))
    end
    rem Winner of plot J when I claims J.
    for J in 0 till N
      Best = Vals (I * N + J)
      Wins = 1
      for K in 0 till N
        if K not equal I and (Assign K) equal J
          Other = Vals (K * N + J)
          if Other greater Best or (Other equal Best and K less I)
            Wins = 0
          end
        end
      end
      Gain = Best * Wins
      if Gain greater Now
        Ok = 0
      end
    end
  end

  Ok equal 1
end

test "maximum n = 400 is a perfect matching"
  use text
  use "0727_plot_distribution"
  Cells = (((0 till 160000) * 7919) mod 1000003) + 1
  Input = "400 " + (Cells join " ")
  run

  (Taken sum) equal 400
  (Assign min) at least 0
end
