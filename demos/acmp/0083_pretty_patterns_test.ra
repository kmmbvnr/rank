use testing

test "default input 3x3"
  use "0083_pretty_patterns" as solve
  Answer = solve 3 3

  Answer equal 322
end

test "official example 2x2"
  use "0083_pretty_patterns" as solve
  Answer = solve 2 2

  Answer equal 14
end

test "thin grid 1x10"
  use "0083_pretty_patterns" as solve
  Answer = solve 1 10

  Answer equal 1024
end
