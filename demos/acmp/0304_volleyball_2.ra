rem Volleyball 2
rem https://acmp.ru/
rem   index.asp?main=task&id_task=304
rem Count volleyball point trajectories

use io
use cli
use sequences
use text
use numbers
use bits

arg N integer = 5
arg MatchesText text = (
  "30:28 28:30 25:22 23:25 18:16"
)

Tokens = MatchesText words integer
TotalWays = 1

for SIdx in 0 till N
  A = Tokens (2 * SIdx)
  B = Tokens (2 * SIdx + 1)

  Target = 25
  if SIdx equal 4
    Target = 15
  end
  T = Target - 1

  MaxScore = A max B
  MinScore = A min B
  SetWays = 0

  NormalLead = Target - 2
  IsTarget = MaxScore equal Target
  NotLead = not (
    MinScore greater NormalLead
  )
  if IsTarget and NotLead
    PrevTotal = MaxScore + MinScore - 1
    SetWays = (
      PrevTotal binomial MinScore
    )
  else
    BaseWays = (2 * T) binomial T
    Shift = MinScore - T
    Power = 1 shl Shift
    SetWays = BaseWays * Power
  end

  TotalWays = TotalWays * SetWays
end

return TotalWays
