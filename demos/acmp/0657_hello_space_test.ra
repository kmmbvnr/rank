use testing

test "sample 1: 110 and ERROR"
  use "0657_hello_space" as signal
  Out = signal (
    "2\n" +
    "5\n" +
    "42\n" +
    "43\n" +
    "39\n" +
    "93\n" +
    "44\n" +
    "5\n" +
    "10\n" +
    "10\n" +
    "22\n" +
    "10\n" +
    "30"
  )

  Out equal "110\nERROR"
end

test "single bit 10 signal"
  use "0657_hello_space" as signal
  Out = signal "1\n3\n50\n100\n50"

  Out equal "10"
end

test "longer valid signal: 1010"
  use "0657_hello_space" as signal
  Out = signal (
    "1\n" +
    "5\n" +
    "100\n" +
    "200\n" +
    "200\n" +
    "200\n" +
    "100"
  )

  Out equal "1010"
end

test "error: invalid starting bit"
  use "0657_hello_space" as signal
  Out = signal "1\n3\n100\n100\n100"

  Out equal "ERROR"
end

test "error: noise exceeds tolerance"
  use "0657_hello_space" as signal
  Out = signal (
    "1\n" +
    "5\n" +
    "100\n" +
    "100\n" +
    "125\n" +
    "200\n" +
    "100"
  )

  Out equal "ERROR"
end
