use testing

test "default example 5x10"
  use "0116_farmer" as solve
  Answer = solve

  Answer equal 21
end

test "all ones 3x3"
  use "0116_farmer" as solve
  Answer = solve "111 111 111"

  Answer equal 9
end

test "checkerboard 2x2"
  use "0116_farmer" as solve
  Answer = solve "10 01"

  Answer equal 1
end

test "single row with hole"
  use "0116_farmer" as solve
  Answer = solve "11011"

  Answer equal 2
end
