use testing

test "default input 4"
  use "0100_lucky_tickets" as solve
  Answer = solve 4

  Answer equal 670
end

test "6 digits"
  use "0100_lucky_tickets" as solve
  Answer = solve 6

  Answer equal 55252
end

test "12 digits"
  use "0100_lucky_tickets" as solve
  Answer = solve 12

  Answer equal 39581170420
end
