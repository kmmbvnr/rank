use testing

test "sample 1: unit square"
  use "0342_inscribed_circle" as solve
  Out = solve "4\n0 0\n1 0\n1 1\n0 1"
  Answer = Out .answer
  R = Out .r
  X = Out .x
  Y = Out .y

  Answer equal "YES"
  X equal 0.5
  Y equal 0.5
  R equal 0.5
end

test "sample 2: rectangle 1x2"
  use "0342_inscribed_circle" as solve
  Out = solve "4\n0 0\n1 0\n1 2\n0 2"
  Answer = Out .answer

  Answer equal "NO"
end

test "triangle 3-4-5"
  use "0342_inscribed_circle" as solve
  Out = solve "3\n0 0\n3 0\n0 4"
  Answer = Out .answer
  R = Out .r
  X = Out .x
  Y = Out .y

  Answer equal "YES"
  X equal 1.0
  Y equal 1.0
  R equal 1.0
end

test "rhombus with center at origin"
  use "0342_inscribed_circle" as solve
  Out = solve "4\n0 -5\n12 0\n0 5\n-12 0"
  Answer = Out .answer
  R = Out .r
  X = Out .x
  Y = Out .y

  Answer equal "YES"
  X equal 0.0
  Y equal 0.0
  R equal 4.615
end
