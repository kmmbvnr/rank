rem Programming Technology
rem https://acmp.ru/
rem   index.asp?main=task&id_task=572
rem Maximize persuaded friends

use io
use cli
use sequences
use numbers
use text

arg Input text = (
  "20 10\n" +
  "5 15\n" +
  "10 20\n" +
  "15 25\n" +
  "20 30\n" +
  "25 35\n" +
  "30 40\n" +
  "35 45\n" +
  "40 50\n" +
  "45 55\n" +
  "50 60\n" +
  "100 -20\n" +
  "120 -25\n" +
  "140 -30\n" +
  "160 -35\n" +
  "180 -40\n" +
  "200 -45\n" +
  "220 -50\n" +
  "240 -55\n" +
  "260 -60\n" +
  "280 -65"
)

Tokens = (
  (Input split "\n" join " ")
  split " "
)
Tokens = Tokens (Tokens not equal "")
Nums = Tokens integer

N = Nums 0
P = Nums 1

Idxs = 0 till N array
Idx2 = Idxs * 2
A = Nums (Idx2 + 2)
B = Nums (Idx2 + 3)

PosMask = B greater -1
NegMask = B less 0

PosIdx = Idxs PosMask
NegIdx = Idxs NegMask

SortedPos = array shape 0 fill 0
PosLen = PosIdx len
if PosLen greater 0
  PosA = A PosIdx
  PosOrder = PosA argsort
  SortedPos = PosIdx PosOrder
end

SortedNeg = array shape 0 fill 0
NegLen = NegIdx len
if NegLen greater 0
  NegA = A NegIdx
  NegB = B NegIdx
  SumAB = NegA + NegB
  Key = SumAB * 10000000 + NegA
  InvKey = 0 - Key
  NegOrder = InvKey argsort
  SortedNeg = NegIdx NegOrder
end

Order = concat SortedPos SortedNeg

CurrentP = P
Chosen = array shape 0 fill 0

for Idx in Order
  Req = A Idx
  Delta = B Idx
  if CurrentP greater (Req - 1)
    CurrentP = CurrentP + Delta
    NextCh = array (Idx + 1)
    Chosen = concat Chosen NextCh
  end
end

Count = Chosen len
Answer = "0"
if Count greater 0
  CntTxt = Count text
  ChTxt = Chosen join " "
  Answer = CntTxt + "\n" + ChTxt
end

return Answer
