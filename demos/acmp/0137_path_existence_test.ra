use testing

test "example 1 with negative cycle"
  use "0137_path_existence" as solve
  Answer = solve

  (Answer 0 0) equal 1
  (Answer 0 3) equal 0
  (Answer 3 3) equal 2
  (Answer 3 4) equal 2
end

test "simple DAG without neg cycles"
  use "0137_path_existence" as solve
  Answer = solve "0 5 0 0 0 2 0 0 0" 3

  (Answer 0 1) equal 1
  (Answer 0 2) equal 1
  (Answer 2 0) equal 0
end
