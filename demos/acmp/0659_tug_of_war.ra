rem Tug of War
rem https://acmp.ru/
rem   index.asp?main=task&id_task=659
rem Max internal cohesion via B&B cut

use io
use cli
use sequences
use text

arg Input text = (
  "16 8 24\n" +
  "1 2\n" +
  "2 3\n" +
  "3 4\n" +
  "4 1\n" +
  "5 6\n" +
  "6 7\n" +
  "7 8\n" +
  "8 5\n" +
  "9 10\n" +
  "10 11\n" +
  "11 12\n" +
  "12 9\n" +
  "13 14\n" +
  "14 15\n" +
  "15 16\n" +
  "16 13\n" +
  "1 5\n" +
  "2 6\n" +
  "3 7\n" +
  "4 8\n" +
  "9 13\n" +
  "10 14\n" +
  "11 15\n" +
  "12 16"
)

Tokens = (
  (Input split "\n" join " ")
  split " "
)
Tokens = Tokens (Tokens not equal "")
Nums = Tokens integer

N = Nums 0
K = Nums 1
M = Nums 2

Swapped = false
TargetK = K
DiffNK = N - K
if K greater DiffNK
  TargetK = DiffNK
  Swapped = true
end
DiffNK = N - TargetK

Adj = array shape N N fill 0

if M greater 0
  EdgeIdxs = 0 till M array
  IdxU = 3 + EdgeIdxs * 2
  IdxV = 4 + EdgeIdxs * 2
  U = (Nums IdxU) - 1
  V = (Nums IdxV) - 1
  for E in 0 till M
    NodeU = U E
    NodeV = V E
    RowU = Adj NodeU
    RowU NodeV = 1
    Adj NodeU = RowU
    RowV = Adj NodeV
    RowV NodeU = 1
    Adj NodeV = RowV
  end
end

Deg = Adj sum axis 1
InvDeg = 0 - Deg
Order = InvDeg argsort
Perm = array shape N fill 0
for I in 0 till N
  Orig = Order I
  Perm Orig = I
end

Rows = Adj Order
NewAdj = Rows # Order

Best = 0
BestAssignment = array shape N fill 0

for I in 0 till TargetK
  BestAssignment I = 1
end

for I in 0 till N
  RowI = NewAdj I
  NextI = I + 1
  for J in NextI till N
    if RowI J equal 1
      ILess = I less TargetK
      JLess = J less TargetK
      BothIn1 = ILess and JLess
      if BothIn1
        Best = Best + 1
      end
      Neither1 = (not ILess) and (
        not JLess
      )
      if Neither1
        Best = Best + 1
      end
    end
  end
end

To1 = array shape N fill 0
To2 = array shape N fill 0
CurAssignment = array shape N fill 0

N1 = N + 1
State = array shape N1 fill 0
FirstBranch = array shape N1 fill 0
SecondBranch = array shape N1 fill 0
CutAdded = array shape N1 fill 0

CurCut = 0
CurK = 0
Vtx = 0

for not (Vtx less 0)
  if Vtx equal N
    TotalInt = M - CurCut
    if TotalInt greater Best
      Best = TotalInt
      for I in 0 till N
        BestAssignment I = (
          CurAssignment I
        )
      end
    end
    Vtx = Vtx - 1
  else
    St = State Vtx
    RowV = NewAdj Vtx
    Cut1 = To2 Vtx
    Cut2 = To1 Vtx

    if St equal 0
      RemNeeded1 = TargetK - CurK
      VtxPast = Vtx - CurK
      RemNeeded2 = DiffNK - VtxPast

      Neg1 = RemNeeded1 less 0
      Neg2 = RemNeeded2 less 0
      Valid = not (Neg1 or Neg2)

      if Valid
        FutureCut = 0
        if Vtx less N
          MinTo = To1 min To2
          RestMin = MinTo (Vtx till N)
          FutureCut = RestMin sum
        end
        BestPoss = M - (
          CurCut + FutureCut
        )
        if not (BestPoss greater Best)
          Valid = false
        end
      end

      if not Valid
        Vtx = Vtx - 1
      else
        B1 = 0
        B2 = 0
        if not (Cut1 greater Cut2)
          if RemNeeded1 greater 0
            B1 = 1
          end
          if RemNeeded2 greater 0
            B2 = 2
          end
        else
          if RemNeeded2 greater 0
            B1 = 2
          end
          if RemNeeded1 greater 0
            B2 = 1
          end
        end
        FirstBranch Vtx = B1
        SecondBranch Vtx = B2

        NextChoice = B1
        if NextChoice equal 0
          NextChoice = B2
        end

        if NextChoice equal 0
          Vtx = Vtx - 1
        else
          IsB1 = NextChoice equal B1
          HasB2 = B2 greater 0
          if IsB1 and HasB2
            State Vtx = 1
          else
            State Vtx = 2
          end

          CAdd = Cut2
          if NextChoice equal 1
            CAdd = Cut1
          end
          CutAdded Vtx = CAdd
          CurCut = CurCut + CAdd

          if NextChoice equal 1
            CurAssignment Vtx = 1
            CurK = CurK + 1
            To1 = To1 + RowV
          else
            CurAssignment Vtx = 0
            To2 = To2 + RowV
          end
          Vtx = Vtx + 1
        end
      end
    else
      if St equal 1
        PrevChoice = FirstBranch Vtx
        SubCut = CutAdded Vtx
        CurCut = CurCut - SubCut
        if PrevChoice equal 1
          CurK = CurK - 1
          To1 = To1 - RowV
        else
          To2 = To2 - RowV
        end

        NextChoice = SecondBranch Vtx
        State Vtx = 2
        CAdd = Cut2
        if NextChoice equal 1
          CAdd = Cut1
        end
        CutAdded Vtx = CAdd
        CurCut = CurCut + CAdd

        if NextChoice equal 1
          CurAssignment Vtx = 1
          CurK = CurK + 1
          To1 = To1 + RowV
        else
          CurAssignment Vtx = 0
          To2 = To2 + RowV
        end
        Vtx = Vtx + 1
      else
        PrevChoice = SecondBranch Vtx
        FB = FirstBranch Vtx
        HasFB = FB greater 0
        NoSB = SecondBranch Vtx equal 0
        if HasFB and NoSB
          PrevChoice = FirstBranch Vtx
        end
        SubCut = CutAdded Vtx
        CurCut = CurCut - SubCut
        if PrevChoice equal 1
          CurK = CurK - 1
          To1 = To1 - RowV
        else
          To2 = To2 - RowV
        end
        State Vtx = 0
        Vtx = Vtx - 1
      end
    end
  end
end

OrigIsTeam1 = BestAssignment Perm
if Swapped
  OrigIsTeam1 = 1 - OrigIsTeam1
end
AllOrig = 1 to N array
IsT1 = OrigIsTeam1 equal 1
Team1 = AllOrig IsT1
Answer = Team1 join " "

return record
  .answer = Answer
  .best = Best
  .team1 = Team1
end
