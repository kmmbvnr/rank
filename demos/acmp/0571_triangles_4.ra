rem ACMP 0571: Triangles - 4
rem Count all equilateral triangles
rem in triangular chocolate polygon
use io
use cli
use sequences
use text

arg Input text = (
  "12\n" +
  "1 1 1 1 3 3 3 3 5 5 5 5"
)

Clean = Input split "\r" join " "
Clean = Clean split "\n" join " "
Tokens = Clean split " "
Tokens = Tokens (Tokens not equal "")
Nums = Tokens integer

N = Nums 0
Steps = Nums drop 1

DVU = array 0 1 0 -1 -1 0 1
DVV = array 0 0 1 1 0 -1 -1

DXU = DVU Steps
DXV = DVV Steps

CumU = DXU scan + with 0 array
CumV = DXV scan + with 0 array

MinU = CumU min
MinV = CumV min
MaxU = CumU max
MaxV = CumV max

ShiftU = (0 - MinU) + 2
ShiftV = (0 - MinV) + 2

U0 = (CumU take N) + ShiftU
V0 = (CumV take N) + ShiftV
U1 = (CumU drop 1) + ShiftU
V1 = (CumV drop 1) + ShiftV

W = (MaxU - MinU) + 6
H = (MaxV - MinV) + 6

UP = array shape H W fill 0
DN = array shape H W fill 0

IsUp = (V1 equal (V0 + 1)) integer
IsDn = (V0 equal (V1 + 1)) integer

S2 = (Steps equal 2) integer
S3 = (Steps equal 3) integer
S5 = (Steps equal 5) integer
S6 = (Steps equal 6) integer

U2 = 2 * U0
PosUp = (S2 * U2) + (S3 * (U2 - 1))
PosDn = (S5 * U2) + (S6 * (U2 + 1))

EdgeV = (IsUp * V0) + (IsDn * V1)
EdgeP = (IsUp * PosUp) + (IsDn * PosDn)
Valid = (IsUp + IsDn) greater 0

EdgeV = EdgeV Valid
EdgeP = EdgeP Valid
EdgeN = EdgeV len

Key = (EdgeV * 100000) + EdgeP
Ord = Key argsort
EdgeV = EdgeV Ord
EdgeP = EdgeP Ord

H2 = W * 2
RowGrid = array shape H2 fill 0

for I in 0 till (EdgeN // 2)
  Idx0 = I * 2
  Idx1 = Idx0 + 1
  VRow = EdgeV Idx0
  PStart = EdgeP Idx0
  PEnd = EdgeP Idx1
  for Hf in PStart till PEnd
    UCell = Hf // 2
    if (Hf mod 2) equal 0
      UP VRow UCell = 1
    else
      DN VRow UCell = 1
    end
  end
end

Total = 0

for VRow in (H - 2) till -1 by -1
  VR1 = VRow + 1
  for UCell in (W - 2) till 0 by -1
    UC1 = UCell + 1
    UCM1 = UCell - 1
    if (UP VRow UCell) equal 1
      U1V = UP VR1 UCell
      U1U = UP VRow UC1
      D1V = DN VRow UCell
      M1 = U1V min U1U
      MinU = M1 min D1V
      ValU = MinU + 1
      UP VRow UCell = ValU
      Total = Total + ValU
    end
    if (DN VRow UCell) equal 1
      D1V = DN VR1 UCell
      D1U = DN VR1 UCM1
      U1V = UP VR1 UCell
      M2 = D1V min D1U
      MinD = M2 min U1V
      ValD = MinD + 1
      DN VRow UCell = ValD
      Total = Total + ValD
    end
  end
end

return Total
