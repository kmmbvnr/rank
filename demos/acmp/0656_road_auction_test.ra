rem Tests for ACMP 0656: Road Auction
use testing
use sequences
use text

test "ACMP 656: Sample 1 (9 8 4)"
  use "0656_road_auction"
  run
  Lines = Result split "\n"
  (Lines len) equal 4
  OutNums = Lines integer
  Has1 = (OutNums equal 1) any
  Has3 = (OutNums equal 3) any
  Has4 = (OutNums equal 4) any
  Has8 = (OutNums equal 8) any
  (
    Has1 and Has3 and Has4 and Has8
  ) equal true
end

test "ACMP 656: Star graph (K = 2)"
  use "0656_road_auction"
  Input = (
    "5 4 2\n" +
    "1 2 5\n" +
    "1 3 2\n" +
    "1 4 8\n" +
    "1 5 1"
  )
  run
  Lines = Result split "\n"
  (Lines len) equal 2
  OutNums = Lines integer
  Has2 = (OutNums equal 2) any
  Has4 = (OutNums equal 4) any
  (Has2 and Has4) equal true
end

test "ACMP 656: K = 1 cheapest edge"
  use "0656_road_auction"
  Input = (
    "3 2 1\n" +
    "1 2 10\n" +
    "2 3 5"
  )
  run
  Result equal "2"
end

test "ACMP 656: Unicyclic graph (K = 3)"
  use "0656_road_auction"
  Input = (
    "8 8 3\n" +
    "1 2 10\n" +
    "2 3 10\n" +
    "3 4 10\n" +
    "4 1 10\n" +
    "1 5 1\n" +
    "2 6 2\n" +
    "3 7 3\n" +
    "4 8 4"
  )
  run
  Lines = Result split "\n"
  (Lines len) equal 3
  OutNums = Lines integer
  Has1 = (OutNums equal 1) any
  Has5 = (OutNums equal 5) any
  Has6 = (OutNums equal 6) any
  (Has1 and Has5 and Has6) equal true
end

test "ACMP 656: Full cycle (K = 5)"
  use "0656_road_auction"
  Input = (
    "8 8 5\n" +
    "1 2 10\n" +
    "2 3 10\n" +
    "3 4 10\n" +
    "4 1 10\n" +
    "1 5 1\n" +
    "2 6 2\n" +
    "3 7 3\n" +
    "4 8 4"
  )
  run
  Lines = Result split "\n"
  (Lines len) equal 5
  OutNums = Lines integer
  Has1 = (OutNums equal 1) any
  Has2 = (OutNums equal 2) any
  Has5 = (OutNums equal 5) any
  Has6 = (OutNums equal 6) any
  Has7 = (OutNums equal 7) any
  (
    Has1 and Has2 and Has5 and
    Has6 and Has7
  ) equal true
end

