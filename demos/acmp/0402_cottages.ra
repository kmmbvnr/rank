  "100 140\n" +
  "110 140\n" +
  "120 140\n" +
  "130 140\n" +
  "140 140\n" +
  "150 140\n" +
  "160 140\n" +
  "170 140\n" +
  "180 140\n" +
  "190 140"
)

FlatText = Input split "\n" join " "
RawTokens = FlatText split " "
Tokens = RawTokens (
  RawTokens not equal ""
)
N = (Tokens 0) integer

Result = 0
if N at least 2
  Coords = Tokens drop 1 integer
  Idx = (0 till N) * 2
  X = Coords Idx
  Y = Coords (Idx + 1)

  P = 0 till (N * N)
  I = P // N
  J = P mod N
  Mask = I less J
  PairsI = I Mask
  PairsJ = J Mask

  Dx = (X PairsJ) - (X PairsI)
  Dy = (Y PairsJ) - (Y PairsI)
  G = Dx gcd Dy
  Dx = Dx // G
  Dy = Dy // G

  A = 0 - Dy
  B = Dx
  Neg = A less 0 or (
    A equal 0 and (B less 0)
  )
  A = Neg choose (0 - A) A
  B = Neg choose (0 - B) B
  C = 0 - (
    (A * (X PairsI)) +
    (B * (Y PairsI))
  )

  Key = (
    (A * 60000 + (B + 30000)) *
    1200000000
  ) + (C + 600000000)

  SortedKey = Key sort
  M = SortedKey len

  Diff = (
    SortedKey drop 1 not equal (
      SortedKey take (M - 1)
    )
  )
  IdxM = 0 till (M - 1)
  Cuts = (IdxM Diff) + 1
  Bounds = concat (
    concat (array 0) Cuts
  ) (array M)
  BLen = Bounds len
  Counts = (Bounds drop 1) - (
    Bounds take (BLen - 1)
  )

  Rad = 1 + (8 * Counts)
  Roots = Rad isqrt
  Result = (Roots - 1) sum
end

Result text
return Result
