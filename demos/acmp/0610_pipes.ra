rem ACMP 0610: Pipe Laying
rem Count Hamiltonian cycles in R x C
rem Plug DP with bracket profile
use io
use cli
use sequences
use text

arg Input text = "12 8"

Clean = Input split "\r" join " "
Clean = Clean split "\n" join " "
Tokens = Clean split " "
Tokens = Tokens (Tokens not equal "")
Nums = Tokens integer

R0 = Nums 0
C0 = Nums 1

Prod = R0 * C0
IsOdd = Prod mod 2
Ans = 0

if IsOdd equal 1
  Ans = 0
else
  R = R0 min C0
  C = R0 max C0
  R1 = R + 1
  MaxCap = 5000
  CurKeys = array shape MaxCap fill 0
  CurVals = array shape MaxCap fill 0
  NextKeys = array shape MaxCap fill 0
  NextVals = array shape MaxCap fill 0
  CurLen = 1
  NextLen = 0
  CurKeys 0 = 0
  CurVals 0 = 1
  ThreeP = array shape 12 fill 1
  for PIdx in 1 till 12
    PrevP = ThreeP (PIdx - 1)
    ThreeP PIdx = PrevP * 3
  end
  for Col in 0 till C
    NextLen = 0
    for SIdx in 0 till CurLen
      K0 = CurKeys SIdx
      V0 = CurVals SIdx
      PBottom = (K0 // (ThreeP R)) mod 3
      if PBottom equal 0
        KShift = (
          (K0 mod (ThreeP R)) * 3
        )
        NextKeys NextLen = KShift
        NextVals NextLen = V0
        NextLen = NextLen + 1
      end
    end
    CurLen = NextLen
    for SIdx in 0 till CurLen
      CurKeys SIdx = NextKeys SIdx
      CurVals SIdx = NextVals SIdx
    end
    for Row in 0 till R
      NextLen = 0
      EndC = Col equal (C - 1)
      EndR = Row equal (R - 1)
      IsLast = (EndC and EndR) integer
      P3L = ThreeP Row
      P3U = ThreeP (Row + 1)
      for SIdx in 0 till CurLen
        K0 = CurKeys SIdx
        V0 = CurVals SIdx
        Left = (K0 // P3L) mod 3
        Up = (K0 // P3U) mod 3
        KBase = K0 - ((Left * P3L) + (
          Up * P3U
        ))
        L0 = Left equal 0
        U0 = Up equal 0
        L1 = Left equal 1
        U1 = Up equal 1
        L2 = Left equal 2
        U2 = Up equal 2
        if L0 and U0
          if IsLast equal 0
            NextKeys NextLen = KBase + (
              P3L + (2 * P3U)
            )
            NextVals NextLen = V0
            NextLen = NextLen + 1
          end
        elif (Left greater 0) and U0
          NextKeys NextLen = KBase + (
            Left * P3U
          )
          NextVals NextLen = V0
          NextLen = NextLen + 1
          NextKeys NextLen = KBase + (
            Left * P3L
          )
          NextVals NextLen = V0
          NextLen = NextLen + 1
        elif L0 and (Up greater 0)
          NextKeys NextLen = KBase + (
            Up * P3U
          )
          NextVals NextLen = V0
          NextLen = NextLen + 1
          NextKeys NextLen = KBase + (
            Up * P3L
          )
          NextVals NextLen = V0
          NextLen = NextLen + 1
        elif L1 and U1
          Depth = 1
          Targ = Row + 2
          ScanK = K0
          for KStep in (Row + 2) till R1
            if Depth greater 0
              PTarg = ThreeP Targ
              DivK = ScanK // PTarg
              Plug = DivK mod 3
              if Plug equal 1
                Depth = Depth + 1
              elif Plug equal 2
                Depth = Depth - 1
              end
              if Depth greater 0
                Targ = Targ + 1
              end
            end
          end
          KNew = KBase - (
            (ThreeP Targ)
          )
          NextKeys NextLen = KNew
          NextVals NextLen = V0
          NextLen = NextLen + 1
        elif L2 and U2
          Depth = 1
          Targ = Row - 1
          ScanK = K0
          StepRange = (
            (Row - 1) till -1 by -1
          )
          for KStep in StepRange
            if Depth greater 0
              PTarg = ThreeP Targ
              DivK = ScanK // PTarg
              Plug = DivK mod 3
              if Plug equal 2
                Depth = Depth + 1
              elif Plug equal 1
                Depth = Depth - 1
              end
              if Depth greater 0
                Targ = Targ - 1
              end
            end
          end
          KNew = KBase + (
            (ThreeP Targ)
          )
          NextKeys NextLen = KNew
          NextVals NextLen = V0
          NextLen = NextLen + 1
        elif L2 and U1
          NextKeys NextLen = KBase
          NextVals NextLen = V0
          NextLen = NextLen + 1
        elif L1 and U2
          if (IsLast equal 1) and (
            KBase equal 0
          )
            NextKeys NextLen = 0
            NextVals NextLen = V0
            NextLen = NextLen + 1
          end
        end
      end
      if NextLen greater 1
        CurNextK = NextKeys take NextLen
        CurNextV = NextVals take NextLen
        Ord = CurNextK argsort
        SortedK = CurNextK Ord
        SortedV = CurNextV Ord
        SortedK1 = SortedK drop 1
        LenM1 = NextLen - 1
        SortedK0 = SortedK take LenM1
        Diff = (
          SortedK1 not equal SortedK0
        )
        DiffIdx = Diff indices
        GroupEnds = DiffIdx + 1
        GroupStarts = concat (
          array 0
        ) GroupEnds
        GroupCount = GroupStarts len
        for GIdx in 0 till GroupCount
          StartI = GroupStarts GIdx
          CurK = SortedK StartI
          EndI = NextLen
          if GIdx less (GroupCount - 1)
            NextG = GIdx + 1
            EndI = GroupStarts NextG
          end
          SumV = 0
          for SumI in StartI till EndI
            SumV = SumV + (SortedV SumI)
          end
          NextKeys GIdx = CurK
          NextVals GIdx = SumV
        end
        CurLen = GroupCount
      else
        CurLen = NextLen
      end
      for SIdx in 0 till CurLen
        CurKeys SIdx = NextKeys SIdx
        CurVals SIdx = NextVals SIdx
      end
    end
  end
  Ans = 0
  if (CurLen greater 0) and (
    (CurKeys 0) equal 0
  )
    Ans = CurVals 0
  end
  Ans print
end
return Ans
