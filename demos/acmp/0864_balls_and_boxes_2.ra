use algo
use cli
use io
use numbers
use sequences
use text

arg Input text = "15
0 3 1 1 1 3 2 0 0 0 0 0 1 0 0"

Lines = (Input split "\r") join ""
Clean = Lines split "\n"
Parts = (Clean 0) split " "
N = (Parts 0) integer

CleanLen = Clean shape 0
LinesTail = Clean (1 to (CleanLen - 1))
WordStr = LinesTail join " "
Tokens = WordStr split " "
Nums = Tokens (Tokens not equal "")
A = Nums integer

S = A reduce +
INF = 1000000000

fun Cut get_cut_cost
  Head = A drop Cut
  Tail = A take Cut
  A_rot = concat Head Tail
  Prot = A_rot scan +
  C_init = 0 to S
  DP = (C_init equal 0) choose 0 INF
  for I in 1 to N
    Pi = Prot (I - 1)
    Prev0 = DP
    TailDP = DP take S
    Prev1 = concat (array INF) TailDP
    Best = Prev0 min Prev1
    C = 0 to S
    Diff = (Pi - C) abs
    DP = Best + Diff
  end
  return DP S
end

Ans = 0

if S equal N
  D = A - 1
  P = D scan +
  Med = (P sort) (N // 2)
  Diff = (P - Med) abs
  Ans = Diff reduce +
else
  Zeros = (0 till N) (A equal 0)
  D = A - 1
  P = D scan +
  Pz = P Zeros
  Order = Pz argsort
  SortedZeros = Zeros Order
  NumZeros = SortedZeros shape 0
  CandCount = (NumZeros min 15) integer
  Cand = SortedZeros take CandCount
  CostQ = new queue
  for Cut in Cand
    CostQ push (Cut get_cut_cost)
  end
  Costs = (CostQ reverse) reverse
  Ans = Costs reduce min
end

return Ans
