rem Pretty Patterns
rem https://acmp.ru/index.asp?main=task&id_task=83
rem Count M x N monochromatic-free 2x2 patterns

use bits
use io
use linalg
use sequences
use cli

arg M integer = 3
arg N integer = 3

Rows = M min N
Cols = M max N

rem Represent a column as a number:
rem a bit per cell, 0 is all white,
rem Max is all black
States = 2 ** Rows
Max = States - 1

Cell = 0 till States
Both1' = Cell Cell outer band
Adj1' = Both1 shr 1 band Both1

Flip = Cell bxor Max
Both0' = Flip Flip outer band
Adj0' = Both0 shr 1 band Both0

rem Compat A B: can A be next to B?
Bad' = Adj1 bor Adj0
Compat = Bad equal 0 integer

Answer = Compat matpow (Cols - 1) sum

Answer print
