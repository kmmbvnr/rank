rem Pretty Patterns
rem https://acmp.ru/index.asp?main=task&id_task=83
rem Count M x N monochromatic-free 2x2 patterns

use bits
use io
use sequences
use cli

arg M integer = 3
arg N integer = 3

R = M
C = N
if R greater C
  R = N
  C = M
end

Answer = 0
if R equal 1
  Answer = 2 ** C
else
  States = 2 ** R
  AdjacentMask = (2 ** (R - 1)) - 1
  FullMask = States - 1

  Compat = array shape States States fill 0

  for A in 0 till States
    for B in 0 till States
      Both1 = A band B
      Adj1 = Both1 band (Both1 shr 1) band AdjacentMask
      Both0 = (A bor B) bxor FullMask
      Adj0 = Both0 band (Both0 shr 1) band AdjacentMask
      if (Adj1 equal 0) and (Adj0 equal 0)
        Compat A B = 1
      end
    end
  end

  DP = array shape States fill 1
  for Step in 1 till C
    DP = (Compat * DP) sum axis -1
  end

  Answer = DP sum
end

Answer print
