use testing

test "sample 1: 3 stones is WIN"
  use "0404_stone_game" as solve
  Answer = solve 3

  Answer equal "WIN"
end

test "sample 2: 5 stones is LOSE"
  use "0404_stone_game" as solve
  Answer = solve 5

  Answer equal "LOSE"
end

test "boundary: 2 stones is LOSE"
  use "0404_stone_game" as solve
  Answer = solve 2

  Answer equal "LOSE"
end

test "small P-position: 8 stones LOSE"
  use "0404_stone_game" as solve
  Answer = solve 8

  Answer equal "LOSE"
end

test "large 10^12 is WIN"
  use "0404_stone_game" as solve
  Answer = solve 1000000000000

  Answer equal "WIN"
end

test "large P-position close to 10^12"
  use "0404_stone_game" as solve
  Answer = solve 1000000951425

  Answer equal "LOSE"
end
