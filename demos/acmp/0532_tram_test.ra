use testing

test "sample 1: 4 pass 2 seats -> 28"
  use "0532_tram" as solve
  MaxSatisfaction = solve (
    "4 2 4\n" +
    "10 -10 2 3\n" +
    "-1 -3 1 4\n" +
    "6 -6 1 3\n" +
    "7 4 2 4"
  )

  MaxSatisfaction equal 28
end

test "all passengers prefer standing"
  use "0532_tram" as solve
  MaxSatisfaction = solve "2 1 3\n1 5 1 2\n2 10 2 3"

  MaxSatisfaction equal 15
end

test "zero seats forces all to stand"
  use "0532_tram" as solve
  MaxSatisfaction = solve "2 0 3\n10 1 1 3\n20 2 1 3"

  MaxSatisfaction equal 6
end

test "unlimited seats allows all to sit"
  use "0532_tram" as solve
  MaxSatisfaction = solve "2 5 3\n10 1 1 3\n20 2 1 3"

  MaxSatisfaction equal 60
end

test "disjoint passenger intervals"
  use "0532_tram" as solve
  MaxSatisfaction = solve "2 1 4\n5 1 1 2\n8 2 2 4"

  MaxSatisfaction equal 21
end
