use testing

test "sample 1 -> 5"
  use "0776_jupiter" as solve
  Ans = solve (
    "5 4\n" +
    "5 3\n" +
    "1 6\n" +
    "2 1 4 2 1\n" +
    "1 2 4 2 1\n" +
    "4 4 6 2 1\n" +
    "2 2 2 2 1"
  )

  Ans equal "5"
end

test "sample 2 -> 3"
  use "0776_jupiter" as solve
  Ans = solve "4 4
4 2
1 3
2 0 0 3
3 0 4 3
4 0 5 2
4 5 5 1"

  Ans equal "3"
end

test "sample 3 -> IMPOSSIBLE"
  use "0776_jupiter" as solve
  Ans = solve "3 3
3 3
10 10
1 0 0
1 0 0
0 1 1"

  Ans equal "IMPOSSIBLE"
end

test "start is the goal -> 0"
  use "0776_jupiter" as solve
  Ans = solve "1 1
1 1
0 0
5"

  Ans equal "0"
end

test "no flights: walk around lava"
  use "0776_jupiter" as solve
  Ans = solve "3 3
3 3
0 0
1 1 1
0 0 1
1 1 1"

  Ans equal "4"
end

test "height jump of 2 needs a flight"
  use "0776_jupiter" as solve
  Ans = solve "2 1
2 1
1 3
1 3"

  Ans equal "1"
end

test "flight too short"
  use "0776_jupiter" as solve
  Ans = solve "2 1
2 1
1 2
1 4"

  Ans equal "IMPOSSIBLE"
end

test "fly over lava in a column"
  use "0776_jupiter" as solve
  Ans = solve "1 3
1 3
1 5
1
0
1"

  Ans equal "1"
end

test "max grid with flights is fast"
  use text
  use "0776_jupiter" as solve
  Cells = ((0 till 10000) mod 3) + 1
  GridStr = Cells join " "
  Pfx = "100 100 100 100 10 100 "
  Ans = solve (Pfx + GridStr)

  Ans not equal "IMPOSSIBLE"
end

test "max grid, lava goal: full search"
  use text
  use "0776_jupiter" as solve
  Cells = ((0 till 10000) mod 3) + 1
  Cells 9999 = 0
  GridStr = Cells join " "
  Pfx = "100 100 100 100 10 100 "
  Ans = solve (Pfx + GridStr)

  Ans equal "IMPOSSIBLE"
end
