rem Line Coloring 2
rem ACMP 467
rem Longest white interval after flips

use io
use cli
use sequences
use text

arg Input text = (
  "4\n20 50\n10 35\n40 90\n" +
  "100 1000000000"
)

Lines = Input split "\n"
Joined = Lines join " "
Tokens = Joined split " "
Tokens = Tokens (Tokens not equal "")

N = Tokens 0 integer

Answer = 1000000000

if N greater 0
  N2 = 2 * N
  RawTok = Tokens drop 1 take N2
  Raw = RawTok integer
  Idx = 0 till N array
  A = Raw (Idx * 2)
  B = Raw (Idx * 2 + 1)
  L = A min B
  R = A max B

  Valid = L less R
  L = L Valid
  R = R Valid

  AllEvents = concat L R
  EndPts = array 0 1000000000
  AllPts = concat EndPts AllEvents
  SortedPts = AllPts sort unique array

  NumSegments = (SortedPts len) - 1
  IdxL = 0 till NumSegments
  IdxR = 1 to NumSegments
  SegLeft = SortedPts IdxL
  SegRight = SortedPts IdxR
  SegLen = SegRight - SegLeft

  PtsLen = SortedPts len
  Flips = array shape PtsLen fill 0
  for I in 0 to (PtsLen - 1)
    P = SortedPts I
    Eq = AllEvents equal P
    Flips I = Eq count
  end

  CumFlips = Flips scan +
  SegIdx = 0 till NumSegments
  LeftFlips = CumFlips SegIdx
  SegColor = LeftFlips mod 2
  IsWhite = SegColor equal 0

  Cur = 0
  MaxLen = 0
  for I in 0 to (NumSegments - 1)
    if IsWhite I
      Cur += SegLen I
      MaxLen = MaxLen max Cur
    else
      Cur = 0
    end
  end

  Answer = MaxLen
end

Answer print
