rem ACMP 0749 - Incorrect RSA
rem Factorizations of n = p^k * q^k
rem 2D vector partitions of (k, k)

use io
use cli
use numbers
use text
use sequences

arg Input text = "1000000000000000000"

Lines = Input split "\n"
Line = Lines join " "
Tokens = Line split " "
Tokens = Tokens (Tokens not equal "")
NStr = Tokens 0
N = NStr real

FoundK = 1
K = 23

for K greater 1 and (FoundK equal 1)
  InvK = 1.0 / K
  PowVal = N ** InvK
  X = PowVal round 0
  if not (X less 2.0)
    P = X ** K
    DiffVal = P - N
    Diff = DiffVal abs
    Tol = 0.1 max (N * 0.00000000001)
    if not (Diff greater Tol)
      FoundK = K
    end
  end
  K = K - 1
end

Ans1 = array "1" "8" "30" "108" "338"
Ans2 = array "1042" "2997" "8405"
Ans3 = array "22651" "59520" "151957"
Ans4 = array "379692" "927621" "2224234"
Ans5 = array "5236585" "12130779"
Ans6 = array "27669592" "62229989"
Ans7 = array "138095695" "302673028"
Ans8 = array "655627974" "1404599866"
Ans9 = array "2977831388"
A1 = concat Ans1 Ans2
A2 = concat Ans3 Ans4
A3 = concat Ans5 Ans6
A4 = concat Ans7 Ans8
T1 = concat A1 A2
T2 = concat A3 A4
T12 = concat T1 T2
AnsTable = concat T12 Ans9

Answer = AnsTable (FoundK - 1)
Answer print
