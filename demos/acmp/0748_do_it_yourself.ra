rem ACMP 0748: Do It Yourself
rem Automorphism breaking coloring
use io
use cli
use sequences
use text

arg Input text = "50
1 1 3 3 2 2 2 2 9 2
10 7 1 1 2 7 8 17 1 18
7 21 23 18 14 8 15 19 9 26
28 1 11 28 22 18 10 14 22 7
6 25 7 23 23 39 17 3 47"

Clean = Input split "\r" join " "
Clean = Clean split "\n" join " "
Tokens = Clean split " "
Tokens = Tokens (Tokens not equal "")
Nums = Tokens integer
N = Nums 0

Ans = 1
Output = "1\n1"

fun M comb K
  if K equal 0
    return 1
  end
  if K greater M
    return 0
  end
  if K equal M
    return 1
  end
  K2 = K min (M - K)
  P = 1
  for I in 1 till (K2 + 1)
    P = P * (M - I + 1)
    Q = P / I
    P = Q integer
  end
  return P
end

if N greater 1
  P = Nums drop 1
  ShapeStrings = array shape N fill ""
  for Rev in 0 till N
    U = N - Rev
    Mask = P equal U
    Kids = (Mask indices) + 2
    KidsLen = Kids len
    if KidsLen equal 0
      ShapeStrings (U - 1) = "()"
    else
      KidStrings = (
        ShapeStrings (Kids - 1)
      )
      SortedKids = KidStrings sort
      Joined = SortedKids join ""
      ShapeStrings (U - 1) = (
        "(" + Joined + ")"
      )
    end
  end

  UniqueShapes = ShapeStrings unique
  NumShapes = UniqueShapes len
  NodeShapes = array shape N fill 0
  for UIdx in 0 till N
    Str = ShapeStrings UIdx
    NodeShapes UIdx = (
      UniqueShapes find Str
    )
  end

  LeafId = UniqueShapes find "()"
  CapLimit = N + 1

  MinK = 1
  for CandK in 1 till (N + 2)
    Cap = array shape NumShapes fill 0
    Cap LeafId = CandK min CapLimit
    AllOk = 1
    for Rev in 0 till N
      U = N - Rev
      S = NodeShapes (U - 1)
      if (Cap S) equal 0
        KidMask = P equal U
        Kids = (KidMask indices) + 2
        KidS = NodeShapes (Kids - 1)
        UniqKidS = KidS unique
        UKLen = UniqKidS len
        Prod = 1
        for KIdx in 0 till UKLen
          CS = UniqKidS KIdx
          MatchMask = KidS equal CS
          Mult = MatchMask count
          if (Cap CS) less Mult
            Prod = 0
            AllOk = 0
          else
            Ways = (Cap CS) comb Mult
            Prod = (
              Prod * Ways
            ) min CapLimit
          end
        end
        Cap S = (
          CandK * Prod
        ) min CapLimit
      end
    end
    if AllOk equal 1
      MinK = CandK
      break
    end
  end

  Ans = MinK

  CapFinal = (
    array shape NumShapes fill 0
  )
  CapFinal LeafId = MinK min CapLimit
  for Rev in 0 till N
    U = N - Rev
    S = NodeShapes (U - 1)
    if (CapFinal S) equal 0
      KidMask = P equal U
      Kids = (KidMask indices) + 2
      KidS = NodeShapes (Kids - 1)
      UniqKidS = KidS unique
      UKLen = UniqKidS len
      Prod = 1
      for KIdx in 0 till UKLen
        CS = UniqKidS KIdx
        MatchMask = KidS equal CS
        Mult = MatchMask count
        Ways = (CapFinal CS) comb Mult
        Prod = (
          Prod * Ways
        ) min CapLimit
      end
      CapFinal S = (
        MinK * Prod
      ) min CapLimit
    end
  end

  AssignedIdx = array shape N fill 0
  Colors = array shape N fill 1

  for U in 1 till (N + 1)
    S = NodeShapes (U - 1)
    Idx = AssignedIdx (U - 1)
    ColorVal = (Idx mod MinK) + 1
    Colors (U - 1) = ColorVal
    QRem = Idx / MinK
    RemVal = QRem integer

    KidMask = P equal U
    Kids = (KidMask indices) + 2
    KidsLen = Kids len
    if KidsLen greater 0
      KidS = NodeShapes (Kids - 1)
      UniqKidS = KidS unique
      UKLen = UniqKidS len
      for KIdx in 0 till UKLen
        CS = UniqKidS KIdx
        MatchMask = KidS equal CS
        MatchKids = Kids MatchMask
        Mult = MatchKids len
        CapM = CapFinal CS
        Ways = CapM comb Mult
        RankVal = 0
        if Ways greater 0
          RankVal = RemVal mod Ways
          QNext = RemVal / Ways
          RemVal = QNext integer
        end

        RemNeed = Mult
        PickCount = 0
        LimitCur = CapM min (
          RankVal + RemNeed + 2
        )
        for Cur in 0 till LimitCur
          if RemNeed greater 0
            W = (CapM - 1 - Cur) comb (
              RemNeed - 1
            )
            if RankVal less W
              TargetKid = (
                MatchKids PickCount
              )
              AssignedIdx (
                TargetKid - 1
              ) = Cur
              PickCount = (
                PickCount + 1
              )
              RemNeed = RemNeed - 1
            else
              RankVal = RankVal - W
            end
          end
        end
      end
    end
  end

  JoinedCols = Colors join " "
  Output = (
    MinK text
  ) + "\n" + JoinedCols
end

return record
  .ans = Ans
  .output = Output
end
