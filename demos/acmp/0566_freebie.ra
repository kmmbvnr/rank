rem Freebie
rem https://acmp.ru/
rem   index.asp?main=task&id_task=566
rem Maximize shirts from star caps

use io
use cli
use numbers
use sequences
use text

arg Input text = "100 100 100 10"

Lines = Input split "\n"
Tokens = (Lines join " ") split " "
Tokens = Tokens (Tokens not equal "")
Nums = Tokens integer

A = Nums 0
B = Nums 1
C = Nums 2
K = Nums 3

TotalStars = A + 2 * B + 3 * C
Answer = 0

if K less 1 or (TotalStars less K)
  Answer = 0
else
  if K equal 1
    Answer = A + B + C
  else
    if K equal 2
      Answer = C + B + (A // 2)
    else
      if K equal 3
        Pairs = A min B
        RemA = A - Pairs
        RemB = B - Pairs
        Extra = 0
        if RemA greater 0
          Extra = RemA // 3
        else
          Extra = RemB // 2
        end
        Answer = C + Pairs + Extra
      else
        K3 = (K + 2) // 3
        MaxL = C min K3
        K2 = (K + 1) // 2
        MaxJ = B min K2

        LSize = MaxL + 1
        JSize = MaxJ + 1
        MaxBundles = LSize * JSize
        BL = (
          array shape MaxBundles fill 0
        )
        BJ = (
          array shape MaxBundles fill 0
        )
        BI = (
          array shape MaxBundles fill 0
        )
        NumBundles = 0

        L = MaxL
        for not (L less 0)
          J = MaxJ
          for not (J less 0)
            Sum23 = 3 * L + 2 * J
            Valid = 0
            ReqI = 0
            if not (Sum23 less K)
              Sub3 = Sum23 - 3
              Less3 = Sub3 less K
              D3Check = not Less3
              Drop3 = (
                L greater 0 and D3Check
              )
              Sub2 = Sum23 - 2
              Less2 = Sub2 less K
              D2Check = not Less2
              Drop2 = (
                J greater 0 and D2Check
              )
              HasDrop = Drop3 or Drop2
              if not HasDrop
                Valid = 1
                ReqI = 0
              end
            else
              ReqI = K - Sum23
              if not (ReqI greater A)
                Valid = 1
              end
            end
            if Valid equal 1
              BL NumBundles = L
              BJ NumBundles = J
              BI NumBundles = ReqI
              NumBundles += 1
            end
            J = J - 1
          end
          L = L - 1
        end

        Best = 0
        StackCap = 2000
        StackIdx = (
          array shape StackCap fill 0
        )
        StackA = (
          array shape StackCap fill 0
        )
        StackB = (
          array shape StackCap fill 0
        )
        StackC = (
          array shape StackCap fill 0
        )
        StackShirts = (
          array shape StackCap fill 0
        )

        StackIdx 0 = 0
        StackA 0 = A
        StackB 0 = B
        StackC 0 = C
        StackShirts 0 = 0
        Top = 1

        for Top greater 0
          Top = Top - 1
          Idx = StackIdx Top
          CurA = StackA Top
          CurB = StackB Top
          CurC = StackC Top
          CurShirts = StackShirts Top

          if CurShirts greater Best
            Best = CurShirts
          end

          if Idx less NumBundles
            CurB2 = 2 * CurB
            CurC3 = 3 * CurC
            RemStars = CurA + CurB2
            RemStars += CurC3
            Bound = RemStars // K
            MaxPoss = CurShirts + Bound
            if MaxPoss greater Best
              CurL = BL Idx
              CurJ = BJ Idx
              CurI = BI Idx

              MaxC = 999999
              if CurL greater 0
                MaxC = CurC // CurL
              end
              MaxB = 999999
              if CurJ greater 0
                MaxB = CurB // CurJ
              end
              MaxA = 999999
              if CurI greater 0
                MaxA = CurA // CurI
              end
              MaxBC = MaxB min MaxA
              MaxCount = MaxC min MaxBC

              TakeK = 0
              for TakeK at most MaxCount
                SubA = TakeK * CurI
                RemA = CurA - SubA
                SubB = TakeK * CurJ
                RemB = CurB - SubB
                SubC = TakeK * CurL
                RemC = CurC - SubC
                NextSh = CurShirts
                NextSh += TakeK
                RemB2 = 2 * RemB
                RemC3 = 3 * RemC
                NextStars = RemA + RemB2
                NextStars += RemC3
                BndNxt = NextStars // K
                NxtUp = NextSh + BndNxt
                if NxtUp greater Best
                  StackIdx Top = Idx + 1
                  StackA Top = RemA
                  StackB Top = RemB
                  StackC Top = RemC
                  StackShirts Top = (
                    NextSh
                  )
                  Top = Top + 1
                end
                TakeK = TakeK + 1
              end
            end
          end
        end
        Answer = Best
      end
    end
  end
end

return record
  .answer = Answer
  .k = K
end
