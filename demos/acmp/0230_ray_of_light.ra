rem Ray of Light
rem https://acmp.ru/
rem   index.asp?main=task&id_task=230
rem Optical ray tracing on a grid

use io
use cli
use sequences
use text

arg N integer = 8
arg M integer = 8
arg GridText text = (
  "..*.....\n" +
  "........\n" +
  ".....*..\n" +
  "...X....\n" +
  "........\n" +
  "..*.....\n" +
  ".......*\n" +
  ".*......"
)

RawLines = GridText split "\n"
Lines = (RawLines join " ") split " "
Tokens = Lines (not (Lines equal ""))
Grid = Tokens join ""

rem Find start cell containing X
StartIdx = 0
for I in 0 till (N * M)
  if Grid I equal "X"
    StartIdx = I
  end
end
StartR = StartIdx // M
StartC = StartIdx mod M

Visited = array shape (4 * N * M) fill 0
Slash = array shape (N * M) fill 0
Backslash = array shape (N * M) fill 0

for InitDir in 0 till 4
  R = StartR
  C = StartC
  DR = (InitDir // 2) * 2 - 1
  DC = (InitDir mod 2) * 2 - 1
  CellIdx = R * M + C
  if DR equal DC
    Backslash CellIdx = 1
  else
    Slash CellIdx = 1
  end
  StateIdx = (InitDir * N * M) + CellIdx
  Visited StateIdx = 1

  Running = true
  for Running
    AR = R + DR
    AC = C + DC
    Ahead = 0
    OutAR = AR less 0 or (AR at least N)
    OutAC = AC less 0 or (AC at least M)
    if OutAR or OutAC
      Ahead = 1
    else
      if Grid (AR * M + AC) equal "*"
        Ahead = 1
      end
    end

    HR = R
    HC = C + DC
    Horiz = 0
    OutHR = HR less 0 or (HR at least N)
    OutHC = HC less 0 or (HC at least M)
    if OutHR or OutHC
      Horiz = 1
    else
      if Grid (HR * M + HC) equal "*"
        Horiz = 1
      end
    end

    VR = R + DR
    VC = C
    Vert = 0
    OutVR = VR less 0 or (VR at least N)
    OutVC = VC less 0 or (VC at least M)
    if OutVR or OutVC
      Vert = 1
    else
      if Grid (VR * M + VC) equal "*"
        Vert = 1
      end
    end

    NR = R
    NC = C
    NDR = 0
    NDC = 0

    H1 = Horiz equal 1
    V1 = Vert equal 1
    H0 = Horiz equal 0
    V0 = Vert equal 0

    if Ahead equal 1
      if H1 and V1
        NDR = 0 - DR
        NDC = 0 - DC
        NR = R
        NC = C
      else
        if H1 and V0
          NDR = DR
          NDC = 0 - DC
          NR = R + DR
          NC = C
        else
          if V1 and H0
            NDR = 0 - DR
            NDC = DC
            NR = R
            NC = C + DC
          else
            NDR = 0 - DR
            NDC = 0 - DC
            NR = R
            NC = C
          end
        end
      end
    else
      if H1 and V1
        NDR = 0 - DR
        NDC = 0 - DC
        NR = R
        NC = C
      else
        NDR = DR
        NDC = DC
        NR = R + DR
        NC = C + DC
      end
    end

    DirR = (NDR + 1) // 2
    DirC = (NDC + 1) // 2
    NDir = (DirR * 2) + DirC
    NCell = NR * M + NC
    NM = N * M
    NextStateIdx = (NDir * NM) + NCell
    if Visited NextStateIdx equal 1
      Running = false
    else
      Visited NextStateIdx = 1
      if NDR equal NDC
        Backslash NCell = 1
      else
        Slash NCell = 1
      end
      R = NR
      C = NC
      DR = NDR
      DC = NDC
    end
  end
end

ResultLines = array shape 0 fill ""
for Row in 0 till N
  LineStr = ""
  for Col in 0 till M
    Idx = Row * M + Col
    Ch = Grid Idx
    if Ch equal "*"
      LineStr = LineStr + "*"
    else
      SVal = Slash Idx
      BVal = Backslash Idx
      if SVal equal 1 and (BVal equal 1)
        LineStr = LineStr + "X"
      else
        if SVal equal 1
          LineStr = LineStr + "/"
        else
          if BVal equal 1
            LineStr = LineStr + "\\"
          else
            LineStr = LineStr + "."
          end
        end
      end
    end
  end
  LineArr = array LineStr
  ResultLines = (
    concat ResultLines LineArr
  )
end

Answer = ResultLines join "\n"
Answer print
