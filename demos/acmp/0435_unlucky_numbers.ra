rem Unlucky Numbers
rem acmp.ru: task 435
rem Numbers with no equal partition.

use io
use cli
use sequences
use bits
use algo

arg N integer = 8
arg K integer = 5

Facts = array shape (N + 1) fill 1
for I in 2 to N
  Facts I = (Facts (I - 1)) * I
end

Poly = array shape (K + 1) fill 1
DP = Poly
for Step in 1 till N
  LenDP = DP len
  NextLen = LenDP + K
  NextDP = array shape NextLen fill 0
  for D in 0 to K
    Range = D till (D + LenDP)
    CurTerms = NextDP Range
    NextDP Range = CurTerms + DP
  end
  DP = NextDP
end

OddIdxs = 1 till (DP len) by 2
OddDP = DP OddIdxs
OddTotal = OddDP sum

EvenTotal = 0
S = new stack
InitState = array 0 0 0 1 1 0 0
S push InitState

for S len greater 0
  State = S pop
  Step = State 0
  LastD = State 1
  CurSum = State 2
  Mask = State 3
  Div = State 4
  Run = State 5
  CandD = State 6

  if Step equal N
    IsPositive = CurSum greater 0
    IsEven = CurSum mod 2 equal 0
    if IsPositive and IsEven
      Target = CurSum // 2
      ShiftMask = Mask shr Target
      Bit = ShiftMask band 1
      if Bit equal 0
        Ways = (Facts N) // Div
        EvenTotal += Ways
      end
    end
  else
    if CandD less K
      NextCand = CandD + 1
      A1 = array Step LastD CurSum
      A2 = array Mask Div Run NextCand
      S push (concat A1 A2)
    end
    if not (CandD greater K)
      NextSum = CurSum + CandD
      Shifted = Mask shl CandD
      NextMask = Mask bor Shifted
      NextRun = 1
      SameD = CandD equal LastD
      if (Step greater 0) and SameD
        NextRun = Run + 1
      end
      NextDiv = Div * NextRun
      NextStep = Step + 1
      C1 = array NextStep CandD NextSum
      C2 = array NextMask NextDiv
      C3 = array NextRun CandD
      C12 = concat C1 C2
      S push (concat C12 C3)
    end
  end
end

Answer = OddTotal + EvenTotal
Answer print
