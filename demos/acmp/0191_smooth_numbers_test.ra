use testing

test "ACMP 191: sample case 1 -> 1"
  use "0191_smooth_numbers"
  N = 1
  run

  Answer equal 1
end

test "ACMP 191: sample case 11 -> 12"
  use "0191_smooth_numbers"
  N = 11
  run

  Answer equal 12
end

test "ACMP 191: sample case 239 -> 1135"
  use "0191_smooth_numbers"
  N = 239
  run

  Answer equal 1135
end

test "ACMP 191: boundary case 2^31 - 1"
  use "0191_smooth_numbers"
  N = 2147483647
  run

  Expected = 11111111333333344444444444444777777778999
  Answer equal Expected
end
