rem Test Work
rem https://acmp.ru/
rem   index.asp?main=task&id_task=660
rem Count empty subrectangles via stack

use io
use numbers
use cli
use sequences
use text

arg Input text = (
  "20 20 15\n" +
  "2 5\n" +
  "3 12\n" +
  "5 8\n" +
  "7 15\n" +
  "8 3\n" +
  "10 18\n" +
  "12 6\n" +
  "13 14\n" +
  "15 2\n" +
  "16 11\n" +
  "17 19\n" +
  "18 7\n" +
  "19 13\n" +
  "4 16\n" +
  "11 9"
)

Tokens = (
  (Input split "\n" join " ")
  split " "
)
Tokens = Tokens (Tokens not equal "")

N = Tokens 0 integer
M = Tokens 1 integer
K = Tokens 2 integer

Idx = 3

PaintedR = array shape K fill 0
PaintedC = array shape K fill 0

for I in 0 till K
  R_tok = Tokens (Idx + (I * 2))
  C_tok = Tokens (Idx + (I * 2) + 1)
  PaintedR I = (R_tok integer) - 1
  PaintedC I = (C_tok integer) - 1
end

if M greater N
  Temp = N
  N = M
  M = Temp
  TempArr = PaintedR
  PaintedR = PaintedC
  PaintedC = TempArr
end

SortedR = PaintedR
SortedC = PaintedC
if K greater 0
  Order = PaintedR argsort
  SortedR = PaintedR Order
  SortedC = PaintedC Order
end

H = array shape M fill 0
M1 = M + 1
StackCol = array shape M1 fill 0
StackH = array shape M1 fill 0
StackSum = array shape M1 fill 0

Total = 0
PIdx = 0

for R in 0 till N
  H = H + 1

  LimitStep = K + 1
  for Step in 0 till LimitStep
    EndK = PIdx equal K
    NotR = false
    if not EndK
      NotR = SortedR PIdx not equal R
    end
    if EndK or NotR
      break
    end
    H (SortedC PIdx) = 0
    PIdx = PIdx + 1
  end

  Top = 0
  StackCol 0 = -1
  StackH 0 = -1
  StackSum 0 = 0
  RowTotal = 0

  for C in 0 till M
    CurH = H C

    LimitPop = Top + 1
    for Pop in 0 till LimitPop
      Top0 = Top equal 0
      LessH = false
      if not Top0
        LessH = StackH Top less CurH
      end
      if Top0 or LessH
        break
      end
      Top = Top - 1
    end

    PrevC = StackCol Top
    SpanC = C - PrevC
    CurSum = (StackSum Top) + (
      SpanC * CurH
    )
    Top = Top + 1
    StackCol Top = C
    StackH Top = CurH
    StackSum Top = CurSum
    RowTotal = RowTotal + CurSum
  end

  Total = Total + RowTotal
end

return Total
