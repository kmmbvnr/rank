rem Tests for ACMP 0902 Ribbon 2

use testing

test "default N = 6 ribbon"
  use "0902_ribbon_2" as solve
  Ans = solve

  Ans equal "PZPZPZ"
end

test "sample 1: 2 OOK -> PZ"
  use "0902_ribbon_2" as solve
  Ans = solve "2
OOK"

  Ans equal "PZ"
end

test "sample 2: 2 OOO -> NO"
  use "0902_ribbon_2" as solve
  Ans = solve "2
OOO"

  Ans equal "NO"
end

test "N = 1: O -> P"
  use "0902_ribbon_2" as solve
  Ans = solve "1
O"

  Ans equal "P"
end

test "N = 1: K -> Z"
  use "0902_ribbon_2" as solve
  Ans = solve "1
K"

  Ans equal "Z"
end

test "N = 3: OKKOOOK -> PPZ"
  use "0902_ribbon_2" as solve
  Ans = solve "3
OKKOOOK"

  Ans equal "PPZ"
end

test "N = 3 invalid symmetry -> NO"
  use "0902_ribbon_2" as solve
  Ans = solve "3
OKKOOOO"

  Ans equal "NO"
end
