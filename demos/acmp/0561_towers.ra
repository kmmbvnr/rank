rem ACMP 0561: Towers
rem Sort power towers a0^(a1^...^ak)
rem via canonical exp-level (L, x)
use io
use cli
use numbers
use sequences
use text

arg Input text = "12
9 99 99 99 99 99 99 99 99 99 99
9 2 2 2 2 2 2 2 2 2 2
4 2 2 2 2 2
1 2 2
1 3 2
1 2 3
3 3 2 2 2
2 2 2 2
1 3 3
3 3 3 3 3
3 3 2 2 3
3 4 2 2 3"

Clean = Input split "\r" join " "
Clean = Clean split "\n" join " "
Tokens = Clean split " "
Tokens = Tokens (Tokens not equal "")
Nums = Tokens integer

N = Nums 0
Keys = array shape N fill 0.0
Buf = array shape 12 fill 0

Phase = 0
Idx = 0
Pos = 1
K = 0
J = 0
EffLen = 0
CurL = 0
CurX = 0.0
M = 0
W = 0.0
LogB = 0.0
LogLogB = 0.0

for Phase less 6
  if Phase equal 0
    if Idx less N
      K = Nums Pos
      Pos = Pos + 1
      J = 0
      EffLen = K + 1
      Phase = 1
    else
      Phase = 6
    end
  elif Phase equal 1
    if J less (K + 1)
      V0 = Nums (Pos + J)
      Buf J = V0
      if (V0 equal 1) and (
        EffLen equal (K + 1)
      )
        EffLen = J
      end
      J = J + 1
    else
      Pos = Pos + (K + 1)
      if EffLen equal 0
        Keys Idx = 0.0
        Idx = Idx + 1
        Phase = 0
      else
        LastIdx = EffLen - 1
        TopR = (Buf LastIdx) real
        CurL = 1
        CurX = TopR log
        J = EffLen - 2
        Phase = 2
      end
    end
  elif Phase equal 2
    if CurX less 1.0
      Phase = 3
    else
      CurX = CurX log
      CurL = CurL + 1
    end
  elif Phase equal 3
    if J greater -1
      BaseR = (Buf J) real
      LogB = BaseR log
      LogLogB = LogB log
      if CurL equal 1
        ExpX = CurX exp
        CurX = ExpX * LogB
        CurL = 1
        J = J - 1
        Phase = 2
      else
        W = CurX
        M = CurL - 1
        Phase = 4
      end
    else
      KeyVal = (CurL real) + CurX
      Keys Idx = KeyVal
      Idx = Idx + 1
      Phase = 0
    end
  elif Phase equal 4
    if (M greater 0) and (W less 40.0)
      W = W exp
      M = M - 1
    else
      if M equal 0
        CurX = W + LogLogB
        CurL = 2
      else
        CurL = CurL + 1
      end
      J = J - 1
      Phase = 2
    end
  end
end

Ord = Keys argsort
Ids = (1 to N) Ord
Result = Ids join " "
Result print
