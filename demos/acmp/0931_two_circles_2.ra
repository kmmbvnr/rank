fun solve_circles Input
  Raw1 = Input split "
" join " "
  Raw2 = Raw1 split "
" join " "
  RawToks = Raw2 split " "
  NonEmpty = not (RawToks equal "")
  ToksStr = RawToks NonEmpty
  Toks = ToksStr real
  ToksInt = ToksStr integer
  N = ToksInt 0
  Coords = Toks (1 to (2 * N))
  IdxX = (0 to (N - 1)) * 2
  IdxY = IdxX + 1
  X = Coords IdxX
  Y = Coords IdxY
  AllIdx = 0 to (N - 1)

  TA = "0 0 0 0 0 0 1 1 1 2"
  TB = "1 1 1 2 2 3 2 2 3 3"
  TC = "2 3 4 3 4 4 3 4 4 4"
  TripA = TA words integer
  TripB = TB words integer
  TripC = TC words integer

  Found = false
  Res1 = ""
  Res2 = ""

  for T in 0 to 9
    if not Found
      I1 = TripA T
      I2 = TripB T
      I3 = TripC T
      if (I3 less N)
        X1 = X I1
        Y1 = Y I1
        X2 = X I2
        Y2 = Y I2
        X3 = X I3
        Y3 = Y I3
        A1 = 2.0 * (X2 - X1)
        B1 = 2.0 * (Y2 - Y1)
        C1 = ((X2 ** 2) + (Y2 ** 2)) - (
          (X1 ** 2) + (Y1 ** 2))
        A2 = 2.0 * (X3 - X1)
        B2 = 2.0 * (Y3 - Y1)
        C2 = ((X3 ** 2) + (Y3 ** 2)) - (
          (X1 ** 2) + (Y1 ** 2))
        Det = (A1 * B2) - (A2 * B1)
        if not ((Det abs) less 1e-6)
          XC1 = ((C1 * B2) - (
            C2 * B1)) / Det
          YC1 = ((A1 * C2) - (
            A2 * C1)) / Det
          R1 = ((X1 - XC1) ** 2) + (
            (Y1 - YC1) ** 2)
          D1 = ((X - XC1) ** 2) + (
            (Y - YC1) ** 2)
          Diff1 = (D1 - R1) abs
          Tol1 = (R1 * 1e-5) max 0.1
          On1 = Diff1 less Tol1
          Rem = AllIdx (not On1)
          RemN = Rem len
          if RemN equal 0
            Found = true
            Res1 = (AllIdx + 1) join " "
            Res2 = "1 2"
          end
          if RemN equal 1
            Found = true
            P1 = (AllIdx On1) + 1
            Res1 = P1 join " "
            RemP = (Rem 0) + 1
            Res2 = (RemP text) + " 1"
          end
          if RemN equal 2
            J1 = Rem 0
            J2 = Rem 1
            XC2 = (X J1 + (X J2)) / 2.0
            YC2 = (Y J1 + (Y J2)) / 2.0
            DX2 = (X J1) - (X J2)
            DY2 = (Y J1) - (Y J2)
            R2 = ((DX2 ** 2) + (
              DY2 ** 2)) / 4.0
            D2 = ((X - XC2) ** 2) + (
              (Y - YC2) ** 2)
            Diff2 = (D2 - R2) abs
            Tol2 = (R2 * 1e-5) max 0.1
            On2 = Diff2 less Tol2
            Found = true
            P1 = (AllIdx On1) + 1
            P2 = (AllIdx On2) + 1
            Res1 = P1 join " "
            Res2 = P2 join " "
          end
          if RemN greater 2
            J1 = Rem 0
            J2 = Rem 1
            J3 = Rem 2
            JX1 = X J1
            JY1 = Y J1
            JX2 = X J2
            JY2 = Y J2
            JX3 = X J3
            JY3 = Y J3
            JA1 = 2.0 * (JX2 - JX1)
            JB1 = 2.0 * (JY2 - JY1)
            JC1 = ((JX2 ** 2) + (
              JY2 ** 2)) - (
              (JX1 ** 2) + (JY1 ** 2))
            JA2 = 2.0 * (JX3 - JX1)
            JB2 = 2.0 * (JY3 - JY1)
            JC2 = ((JX3 ** 2) + (
              JY3 ** 2)) - (
              (JX1 ** 2) + (JY1 ** 2))
            JDet = (JA1 * JB2) - (
              JA2 * JB1)
            if not (JDet abs less 1e-6)
              XC2 = ((JC1 * JB2) - (
                JC2 * JB1)) / JDet
              YC2 = ((JA1 * JC2) - (
                JA2 * JC1)) / JDet
              R2 = (JX1 - XC2) ** 2 + (
                (JY1 - YC2) ** 2)
              D2 = ((X - XC2) ** 2) + (
                (Y - YC2) ** 2)
              Diff2 = (D2 - R2) abs
              Tol2 = (R2 * 1e-5) max 0.1
            On2 = Diff2 less Tol2
              if ((On2 Rem) all)
                Found = true
                P1 = (AllIdx On1) + 1
                P2 = (AllIdx On2) + 1
                Res1 = P1 join " "
                Res2 = P2 join " "
              end
            end
          end
        end
      end
    end
  end

  if not Found
    Res1 = "1"
    Res2 = "2"
    if N equal 4
      Res1 = "1 2"
      Res2 = "3 4"
    end
    if N equal 3
      Res1 = "1 2"
      Res2 = "2 3"
    end
  end

  return Res1 + "
" + Res2
end

return solve_circles Input
