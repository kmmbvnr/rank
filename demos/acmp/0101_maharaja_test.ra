use testing

test "sample 1: 3x3 with 1 maharaja"
  use "0101_maharaja" as solve
  Answer = solve 3 1

  Answer equal 9
end

test "sample 2: 4x4 with 2 maharajas"
  use "0101_maharaja" as solve
  Answer = solve 4 2

  Answer equal 20
end

test "sample 3: 5x5 with 3 maharajas"
  use "0101_maharaja" as solve
  Answer = solve 5 3

  Answer equal 48
end

test "10x10 with 10 maharajas"
  use "0101_maharaja" as solve
  Answer = solve 10 10

  Answer equal 4
end
