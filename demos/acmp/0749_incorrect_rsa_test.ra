use testing

test "sample 1: n = 6 (k=1) has 1 non-trivial factorization"
  use "0749_incorrect_rsa"
  Input = "6"
  run

  Answer equal "1"
  FoundK equal 1
end

test "sample 2: n = 100 (k=2) has 8 non-trivial factorizations"
  use "0749_incorrect_rsa"
  Input = "100"
  run

  Answer equal "8"
  FoundK equal 2
end

test "n = 216 is 6^3 (k=3)"
  use "0749_incorrect_rsa"
  Input = "216"
  run

  Answer equal "30"
  FoundK equal 3
end

test "n = 1296 is 6^4 (k=4)"
  use "0749_incorrect_rsa"
  Input = "1296"
  run

  Answer equal "108"
  FoundK equal 4
end

test "n = 1000000 is 10^6 (k=6)"
  use "0749_incorrect_rsa"
  Input = "1000000"
  run

  Answer equal "1042"
  FoundK equal 6
end

test "large primes product k=1: 15"
  use "0749_incorrect_rsa"
  Input = "15"
  run

  Answer equal "1"
  FoundK equal 1
end

test "maximum k = 23 with 6^23"
  use "0749_incorrect_rsa"
  Input = "789730223053602816"
  run

  Answer equal "2977831388"
  FoundK equal 23
end

test "boundary n = 10^18 (k=18)"
  use "0749_incorrect_rsa"
  Input = "1000000000000000000"
  run

  Answer equal "62229989"
  FoundK equal 18
end
