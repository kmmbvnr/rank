use testing

test "sample 1: n = 6 (k=1) has 1"
  use "0749_incorrect_rsa" as solve
  Out = solve "6"
  Answer = Out .answer
  FoundK = Out .found_k

  Answer equal "1"
  FoundK equal 1
end

test "sample 2: n = 100 (k=2) has 8"
  use "0749_incorrect_rsa" as solve
  Out = solve "100"
  Answer = Out .answer
  FoundK = Out .found_k

  Answer equal "8"
  FoundK equal 2
end

test "n = 216 is 6^3 (k=3)"
  use "0749_incorrect_rsa" as solve
  Out = solve "216"
  Answer = Out .answer
  FoundK = Out .found_k

  Answer equal "30"
  FoundK equal 3
end

