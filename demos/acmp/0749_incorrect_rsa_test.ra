test "boundary n = 10^18 (k=18)"
  use "0749_incorrect_rsa" as solve
  Out = solve "1000000000000000000"
  Answer = Out .answer
  FoundK = Out .found_k

  Answer equal "62229989"
  FoundK equal 18
end
