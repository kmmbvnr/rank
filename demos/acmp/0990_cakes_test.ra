rem ACMP 0990: Cakes tests
use testing

test "ACMP 990: Maximal 30 children"
  use "0990_cakes" as solve
  Out = solve
  MinCost = Out .min_cost
  ResCakes = Out .res_cakes
  MinCost equal 29
  (ResCakes sum) equal 5000
  Pos = ResCakes (ResCakes greater 0)
  (Pos len) equal 30
end

test "ACMP 990: Sample 1"
  use "0990_cakes" as solve
  Out = solve "3 20
1 2 3"
  MinCost = Out .min_cost
  ResCakes = Out .res_cakes
  MinCost equal 2
  (ResCakes sum) equal 20
end

test "ACMP 990: Sample 2"
  use "0990_cakes" as solve
  Out = solve "4 9
2 1 5 8"
  Result = Out .result
  Result equal "7
2 1 3 3"
end

test "ACMP 990: Single child"
  use "0990_cakes" as solve
  Out = solve "1 5
10"
  Result = Out .result
  Result equal "0
5"
end

test "ACMP 990: N equals M"
  use "0990_cakes" as solve
  Out = solve "5 5
5 4 3 2 1"
  Result = Out .result
  Result equal "0
1 1 1 1 1"
end
