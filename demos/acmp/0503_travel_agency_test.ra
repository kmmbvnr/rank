rem ACMP 0503: Travel Agency tests
use testing

test "ACMP 503: Sample 1"
  use "0503_travel_agency" as solve
  Result = solve "2
C 1 4 5 2
P 2 5 1 4"
  Result equal "5 0 2 1 0"
end

test "ACMP 503: Sample 2"
  use "0503_travel_agency" as solve
  Result = solve "4
C 3 0 0 0
C 3 0 0 1
C 3 0 0 1
C 3 0 0 1"
  Result equal "3 0 1 2 3 4 0"
end

test "ACMP 503: Single planet"
  use "0503_travel_agency" as solve
  Result = solve "1
P 10 20 30 40"
  Result equal "0 0 1 0"
end

test "ACMP 503: 3 mixed planets"
  use "0503_travel_agency" as solve
  Result = solve "3
P 10 0 0 10
C 0 10 10 0
P 5 5 5 5"
  Result equal "20 0 1 3 2 0"
end

test "14-planet stress"
  use "0503_travel_agency" as solve
  Result = solve
  Result not equal ""
end
