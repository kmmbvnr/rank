rem Bracket Sequences of Depth K
rem acmp.ru: task 176
rem Count balanced sequences of
rem length 2N and depth K

use sequences
use io
use cli

arg N integer = 37
arg K integer = 23

Opens = 0 to N array
Prefix = array 0
PrevIdxs = 0 till N array

DMax = K
DPrev = K - 1

DPMax = array shape (N + 1) fill 0
DPMax 0 = 1

DPPrev = array shape (N + 1) fill 0
DPPrev 0 = 1

for Step in 1 to (2 * N)
  Balance = 2 * Opens - Step
  NonNeg = not (Balance less 0)

  DPMaxVal = DPMax PrevIdxs
  ShiftMax = concat Prefix DPMaxVal
  BelowMax = not (Balance greater DMax)
  MaskMaxBool = NonNeg and BelowMax
  MaskMax = MaskMaxBool integer
  SumMax = DPMax + ShiftMax
  DPMax = SumMax * MaskMax

  if DPrev greater 0
    DPPrevVal = DPPrev PrevIdxs
    ShiftPrev = concat Prefix DPPrevVal
    OverPrev = Balance greater DPrev
    BelowPrev = not OverPrev
    MaskPrevBool = NonNeg and BelowPrev
    MaskPrev = MaskPrevBool integer
    SumPrev = DPPrev + ShiftPrev
    DPPrev = SumPrev * MaskPrev
  end
end

Answer = DPMax N
if DPrev greater 0
  Answer -= DPPrev N
end
return Answer
