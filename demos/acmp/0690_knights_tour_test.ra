rem Tests for ACMP 0690: Knight's Tour

use testing
use numbers
use sequences
use text

test "ACMP 690: Sample 8x8"
  use "0690_knights_tour"
  Input = "8 8
K.......
........
........
........
........
........
........
........"
  run

  Vals = Result words integer
  (Vals len) equal 64
  (Vals min) equal 1
  (Vals max) equal 64
  (Vals unique len) equal 64

  Pos = array shape 65 fill 0
  for I in 0 to 63
    S = Vals I
    Pos S = I
  end
  Ok = true
  for S in 1 to 63
    P1 = Pos S
    P2 = Pos (S + 1)
    DR = ((P1 // 8) - (P2 // 8)) abs
    DC = ((P1 mod 8) - (P2 mod 8)) abs
    Is12 = (DR equal 1) and (
      DC equal 2)
    Is21 = (DR equal 2) and (
      DC equal 1)
    if not (Is12 or Is21)
      Ok = false
    end
  end
  Ok equal true
end

test "ACMP 690: Minimal 6x6"
  use "0690_knights_tour"
  Input = "6 6
.K....
......
......
......
......
......"
  run

  Vals = Result words integer
  (Vals len) equal 36
  (Vals min) equal 1
  (Vals max) equal 36
  (Vals unique len) equal 36
end

test "ACMP 690: Default 10x10"
  use "0690_knights_tour"
  run

  Vals = Result words integer
  (Vals len) equal 100
  (Vals min) equal 1
  (Vals max) equal 100
  (Vals unique len) equal 100
end
