use testing

test "sample 1: L-step shape is TRUE"
  use "0583_drawing" as solve
  Ans = solve (
    "11\n" +
    "f 1\n" +
    "r\n" +
    "f 2\n" +
    "r\n" +
    "f 2\n" +
    "r\n" +
    "f 1\n" +
    "r\n" +
    "f 1\n" +
    "l\n" +
    "f 1"
  )

  Ans equal "TRUE"
end

test "simple rectangle is TRUE"
  use "0583_drawing" as solve
  Ans = solve "7
f 5
r
f 3
r
f 5
r
f 3"

  Ans equal "TRUE"
end

test "dent shape is FALSE"
  use "0583_drawing" as solve
  Ans = solve "9
f 3
r
f 3
r
f 1
r
f 2
l
f 1
l
f 2
r
f 1
r
f 3"

  Ans equal "FALSE"
end

test "cross shape is TRUE"
  use "0583_drawing" as solve
  Ans = solve "23
f 1
r
f 1
l
f 1
r
f 1
r
f 1
l
f 1
r
f 1
r
f 1
l
f 1
r
f 1
r
f 1
l
f 1"

  Ans equal "TRUE"
end
