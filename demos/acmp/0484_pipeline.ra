rem Pipeline
rem ACMP 484
rem Open valves in Fibonacci tree

use io
use numbers
use cli
use sequences
use text

arg Input text = "433494435"

fun Curr stepParent
  Cond = F3 less (Curr + 1)
  L = Cond count
  StartL = (F (L + 2)) - 1
  StartPrev = (F (L + 1)) - 1
  K = Curr - StartL

  CurL = L
  CurK = K
  Offset = 0
  for CurL greater 2
    FL = F CurL
    if CurK less FL
      CurL = CurL - 1
    else
      Offset = Offset + (F (CurL - 1))
      CurK = CurK - FL
      CurL = CurL - 2
    end
  end
  return StartPrev + Offset
end

Lines = Input split "\n"
Line = Lines join " "
Tokens = Line split " "
Tokens = Tokens (Tokens not equal "")
S = Tokens 0 integer

F = array shape 45 fill 0
F 1 = 1
F 2 = 1
for I in 3 till 45
  F I = (F (I - 1)) + (F (I - 2))
end

F3 = (F drop 3) - 1

Path = array S
Curr = S

for Curr greater 1
  Curr = Curr stepParent
  Path = concat Path (array Curr)
end

Answer = Path join " "
return record
  .answer = Answer
  .path = Path
end
