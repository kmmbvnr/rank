use testing

test "sample 1: 5 cards with dups"
  use "0441_cards_2" as solve
  Answer = solve "5
3 2 3 4 5
5 4 3 2 3"

  Answer equal 7
end

test "sample 2: different cards"
  use "0441_cards_2" as solve
  Answer = solve (
    "8\n" +
    "1 2 1 2 1 2 1 2\n" +
    "2 1 2 1 2 1 2 2"
  )

  Answer equal -1
end

test "already identical gives 0 swaps"
  use "0441_cards_2" as solve
  Answer = solve "4\n1 2 3 4\n1 2 3 4"

  Answer equal 0
end

test "reversed 4 cards gives 6 swaps"
  use "0441_cards_2" as solve
  Answer = solve "4\n1 2 3 4\n4 3 2 1"

  Answer equal 6
end
