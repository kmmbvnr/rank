rem Lucky Tickets
rem https://acmp.ru/index.asp?main=task&id_task=100
rem Number of N-digit tickets where sum of first N/2 digits equals sum of last N/2 digits

use io
use cli

arg N integer = 4

K = N // 2
MaxSum = 9 * K

DP = array shape (MaxSum + 1) fill 0
DP 0 = 1

for Step in 1 to K
  NextDP = array shape (MaxSum + 1) fill 0
  for S in 0 to (Step * 9)
    Total = 0
    MaxD = 9 min S
    for D in 0 to MaxD
      Total += DP (S - D)
    end
    NextDP S = Total
  end
  DP = NextDP
end

Squares = DP * DP
Answer = Squares sum
Answer print
