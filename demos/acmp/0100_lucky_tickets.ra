rem Lucky Tickets
rem https://acmp.ru/index.asp?main=task&id_task=100
rem Number of N-digit tickets where sum of first N/2 digits equals sum of last N/2 digits

use io
use cli

arg N integer = 4

K = N // 2
DP = array 1

for Step in 1 to K
  C = DP scan + with 0 array
  NextLen = DP len + 9
  Indices = 0 till NextLen array
  HiLimit = array shape NextLen fill (DP len)
  LoLimit = array shape NextLen fill 0
  Hi = (Indices + 1) min HiLimit
  Lo = (Indices - 9) max LoLimit
  DP = C Hi - C Lo
end

Squares = DP * DP
Answer = Squares sum
Answer print
