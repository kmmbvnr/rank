rem Lucky Tickets
rem acmp.ru: task 100
rem Number of N-digit tickets where
rem first N/2 sum equals last N/2 sum

use io
use cli

arg N integer = 100

K = N // 2
DP = array 1

for Step in 1 to K
  C = DP scan + with 0 array
  L2 = DP len + 9
  Indices = 0 till L2 array
  DpLen = DP len
  HiLimit = array shape L2 fill DpLen
  LoLimit = array shape L2 fill 0
  Hi = Indices + 1 min HiLimit
  Lo = Indices - 9 max LoLimit
  DP = C Hi - C Lo
end

Squares = DP * DP
Answer = Squares sum
Answer print
