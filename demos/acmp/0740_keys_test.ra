use testing

test "sample 1: identical single holes"
  use "0740_keys" as solve
  MaxHoles = solve "10 10
1
1 1 2 2
1
1 1 2 2"

  MaxHoles equal 1
end

test "sample 2: two non-adjacent holes"
  use "0740_keys" as solve
  MaxHoles = solve "10 10
2
1 1 2 2
3 3 4 4
1
1 1 2 2"

  MaxHoles equal 1
end

test "sample 3: half-integer shift"
  use "0740_keys" as solve
  MaxHoles = solve "10 10
2
1 1 2 2
3 3 4 4
1
1 1 3 3"

  MaxHoles equal 2
end

test "multiple holes alignment"
  use "0740_keys" as solve
  MaxHoles = solve "20 20
3
1 1 2 2
5 5 6 6
9 9 10 10
3
2 2 3 3
6 6 7 7
10 10 11 11"

  MaxHoles equal 3
end

test "no overlapping holes possible"
  use "0740_keys" as solve
  MaxHoles = solve "100 100
1
0 0 1 1
1
0 0 1 1"

  MaxHoles equal 1
end
