use testing
use text

test "sample 1: ABABAAABABA -> weight 5"
  use "0747_string_decomposition" as solve
  Ans = solve

  Exp = "5
AB 2
A 3
BA 2"
  Ans equal Exp
end

test "all same chars: AAAAAA -> A 6"
  use "0747_string_decomposition" as solve
  Ans = solve "AAAAAA"

  Exp = "1
A 6"
  Ans equal Exp
end

test "no repetitions: ABCDE -> weight 5"
  use "0747_string_decomposition" as solve
  use text
  Ans = solve "ABCDE"

  Lines = Ans split "\n"
  W = Lines 0 integer
  W equal 5
end
