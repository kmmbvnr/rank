rem Transport Reform
rem https://acmp.ru/
rem   index.asp?main=task&id_task=591
rem Even red edge spanning tree via DSU

use algo
use cli
use graph
use io
use sequences
use text

arg Input text = (
  "20 30\n" +
  "1 2 2\n" +
  "2 3 2\n" +
  "3 4 2\n" +
  "4 5 2\n" +
  "5 6 2\n" +
  "6 7 2\n" +
  "7 8 2\n" +
  "8 9 2\n" +
  "9 10 2\n" +
  "10 11 2\n" +
  "11 12 2\n" +
  "12 13 2\n" +
  "13 14 2\n" +
  "14 15 2\n" +
  "15 16 2\n" +
  "16 17 2\n" +
  "17 18 2\n" +
  "18 19 2\n" +
  "19 20 2\n" +
  "1 20 2\n" +
  "1 5 1\n" +
  "2 7 1\n" +
  "3 9 1\n" +
  "4 11 1\n" +
  "6 13 1\n" +
  "8 15 1\n" +
  "10 17 1\n" +
  "12 19 1\n" +
  "14 18 1\n" +
  "1 11 1"
)

Seps = array " " "\n" "\r"
Raw = Input split Seps
NonEmp = Raw (Raw not equal "")
Tokens = NonEmp integer

N = Tokens 0
M = Tokens 1
Rest = Tokens drop 2
I0 = 0 till M
Us = Rest (I0 * 3)
Vs = Rest ((I0 * 3) + 1)
Ts = Rest ((I0 * 3) + 2)
Eids = 1 to M

IsRed = Ts equal 2
RedEids = Eids IsRed
RedUs = Us IsRed
RedVs = Vs IsRed

IsBlue = Ts equal 1
BlueEids = Eids IsBlue
BlueUs = Us IsBlue
BlueVs = Vs IsBlue

Nodes = 1 to N
D1 = new dsu Nodes
TreeQ1 = new queue
RedCount = 0

NumRed = RedEids shape 0
for I in 0 till NumRed
  U = RedUs I
  V = RedVs I
  Eid = RedEids I
  CanAdd = not (D1 U V connected)
  if CanAdd
    D1 U V merge
    TreeQ1 push Eid
    RedCount = RedCount + 1
  end
end

NumBlue = BlueEids shape 0
for I in 0 till NumBlue
  U = BlueUs I
  V = BlueVs I
  Eid = BlueEids I
  CanAdd = not (D1 U V connected)
  if CanAdd
    D1 U V merge
    TreeQ1 push Eid
  end
end

TreeLen = TreeQ1 shape 0
IsConn = TreeLen equal (N - 1)
RedMod2 = RedCount mod 2
IsEven = RedMod2 equal 0

Ans = new queue
if not IsConn
  Ans push -1
elif IsEven
  Ans = TreeQ1
else
  RedDSU = new dsu Nodes
  for I in 0 till NumRed
    RU = RedUs I
    RV = RedVs I
    RedDSU RU RV merge
  end

  ForcedIdx = -1
  for I in 0 till NumBlue
    U = BlueUs I
    V = BlueVs I
    if RedDSU U V connected
      ForcedIdx = I
      break
    end
  end

  if ForcedIdx equal -1
    Ans push -1
  else
    ForcedEid = BlueEids ForcedIdx
    ForcedU = BlueUs ForcedIdx
    ForcedV = BlueVs ForcedIdx

    D2 = new dsu Nodes
    D2 ForcedU ForcedV merge
    TreeQ2 = new queue
    TreeQ2 push ForcedEid

    for I in 0 till NumRed
      U = RedUs I
      V = RedVs I
      Eid = RedEids I
      CanAdd = not (D2 U V connected)
      if CanAdd
        D2 U V merge
        TreeQ2 push Eid
      end
    end

    for I in 0 till NumBlue
      U = BlueUs I
      V = BlueVs I
      Eid = BlueEids I
      CanAdd = not (D2 U V connected)
      if CanAdd
        D2 U V merge
        TreeQ2 push Eid
      end
    end

    Ans = TreeQ2
  end
end

Rev1 = Ans reverse
AnsArr = Rev1 reverse
for X in AnsArr
  X print
end
