rem Email
rem https://acmp.ru/
rem   index.asp?main=task&id_task=624
rem Validate email logs via cycle check

use io
use cli
use sequences
use numbers
use text
use graph

arg Input text = (
  "3\n" +
  "3 3\n" +
  "2 1 -2\n" +
  "2 2 -3\n" +
  "2 3 -1\n" +
  "4 4\n" +
  "2 1 2\n" +
  "2 -1 3\n" +
  "2 -2 4\n" +
  "2 -3 -4\n" +
  "2 2\n" +
  "2 1 -2\n" +
  "2 2 -1"
)

Tokens = (
  (Input split "\n" join " ")
  split " "
)
Tokens = Tokens (Tokens not equal "")
Nums = Tokens integer

T = Nums 0
Ptr = 1
Results = array shape 0 fill ""

for TestIdx in 0 till T
  N = Nums Ptr
  M = Nums (Ptr + 1)
  Ptr = Ptr + 2

  AllFrom = array shape 0 fill 0
  AllTo = array shape 0 fill 0
  VerticesList = array shape 0 fill 0

  for Comp in 0 till N
    K = Nums Ptr
    Ptr = Ptr + 1
    if K greater 0
      EndP = Ptr + K
      Events = Nums (Ptr till EndP)
      Ptr = EndP
      VNext = concat VerticesList Events
      VerticesList = VNext
      if K greater 1
        Froms = Events take (K - 1)
        Tos = Events drop 1
        AllFrom = concat AllFrom Froms
        AllTo = concat AllTo Tos
      end
    end
  end

  PosMask = VerticesList greater 0
  PosEvents = VerticesList PosMask
  UniquePos = PosEvents sort unique

  if (UniquePos len) greater 0
    SendTos = 0 - UniquePos
    AllFrom = concat AllFrom UniquePos
    AllTo = concat AllTo SendTos
    VNext = concat VerticesList SendTos
    VerticesList = VNext
  end

  G = new graph VerticesList .directed
  if (AllFrom len) greater 0
    GEdges = stack AllFrom AllTo axis 1
    G add GEdges
  end

  Cycle = G cycle
  Verdict = "NO"
  if (Cycle len) equal 0
    Verdict = "YES"
  end
  ResNext = concat Results (
    array Verdict
  )
  Results = ResNext
end

return Results join "\n"
