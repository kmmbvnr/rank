rem SMS
rem https://acmp.ru/
rem   index.asp?main=task&id_task=428
rem Count original messages of length N

use io
use cli
use sequences
use text

arg S text = (
  "OMSCMNWQTTARTERPDEINAL" +
  "OMSCMNW"
)
arg N integer = 30

AlphaText = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
Alpha = AlphaText split ""
Alpha = Alpha (Alpha not equal "")

B1 = array 2 2 2  3 3 3  4 4 4
B2 = array 5 5 5  6 6 6  7 7 7 7
B3 = array 8 8 8  9 9 9 9
Buttons = concat (concat B1 B2) B3

P1 = array 1 2 3  1 2 3  1 2 3
P2 = array 1 2 3  1 2 3  1 2 3 4
P3 = array 1 2 3  1 2 3 4
Presses = concat (concat P1 P2) P3

Chars = S split ""
Chars = Chars (Chars not equal "")
L = Chars len

Answer = 0
if L greater 0
  Match = (
    Chars Alpha outer equal integer
  )
  CharButtons = (
    Match * Buttons sum axis -1
  )
  CharPresses = (
    Match * Presses sum axis -1
  )

  PrevBtns = (
    CharButtons (0 till (L - 1))
  )
  NextBtns = (
    CharButtons (1 till L)
  )
  DiffBtns = (
    NextBtns not equal PrevBtns
  )
  IsNewRun = (
    concat (array true) DiffBtns
  )
  RunID = (IsNewRun integer scan +) - 1
  NumRuns = (RunID max) + 1

  DP = array shape (N + 1) fill 0
  DP 0 = 1

  for R in 0 till NumRuns
    RunMask = RunID equal R integer
    K = CharPresses * RunMask sum
    Btn = CharButtons * RunMask max
    Cap = 3
    if Btn equal 7 or (Btn equal 9)
      Cap = 4
    end

    TableSize = (K + 1) * (K + 1)
    PartDP = (
      array shape TableSize fill 0
    )
    PartDP 0 = 1
    KStep = K + 1

    for k in 1 to K
      for s in 1 to K
        SumWays = 0
        for d in 1 to Cap
          if not (s less d)
            PrevK = (k - 1) * KStep
            Prev = PrevK + (s - d)
            PrevVal = PartDP Prev
            SumWays = SumWays + PrevVal
          end
        end
        Cur = k * KStep + s
        PartDP Cur = SumWays
      end
    end

    NextDP = array shape (N + 1) fill 0
    for OldLen in 0 to N
      if DP OldLen greater 0
        for k in 1 to K
          NewLen = OldLen + k
          if not (N less NewLen)
            WaysIdx = k * KStep + K
            CurWays = PartDP WaysIdx
            OldVal = DP OldLen
            Term = OldVal * CurWays
            NextDP NewLen = (
              (NextDP NewLen) + Term
            )
          end
        end
      end
    end
    DP = NextDP
  end

  Answer = DP N
end

Answer print
