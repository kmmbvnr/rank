rem Tests for ACMP 0880: Covering
use testing

test "ACMP 880: Maximal 9x9"
  use "0880_covering" as solve
  Result = solve
  Result equal 17
end

test "ACMP 880: Sample 1 (3 3)"
  use "0880_covering" as solve
  Result = solve (
    "3 3\n" +
    ".X.\n" +
    "XXX\n" +
    "XX."
  )
  Result equal 3
end

test "ACMP 880: Sample 2 (3 2)"
  use "0880_covering" as solve
  Result = solve (
    "3 2\n" +
    "XXX\n" +
    "XXX\n" +
    "..."
  )
  Result equal 1
end

test "ACMP 880: Sample 3 (2 3)"
  use "0880_covering" as solve
  Result = solve (
    "2 3\n" +
    "XXX\n" +
    "XXX\n" +
    "..."
  )
  Result equal 2
end

test "ACMP 880: Sample 4 (2 2)"
  use "0880_covering" as solve
  Result = solve (
    "2 2\n" +
    "XXX\n" +
    "X.X\n" +
    "..X"
  )
  Result equal 2
end
