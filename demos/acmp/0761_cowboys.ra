rem Cowboys (Ковбои)
rem https://acmp.ru/task.asp?id=761
rem Eulerian trail count via DSU.

use cli
use io
use numbers
use sequences
use text

arg Input text = "6 6
1 2
2 3
1 3
4 5
5 6
4 6"

Tok = Input words
N = Tok 0 integer
M = Tok 1 integer

Ans = 0

if M greater 0
  Parent = 0 to N
  Size = array shape (N + 1) fill 1
  Deg = array shape (N + 1) fill 0

  for E in 0 till M
    U = Tok (2 + 2 * E) integer
    V = Tok (3 + 2 * E) integer
    Deg U = (Deg U) + 1
    Deg V = (Deg V) + 1

    RootU = U
    for Step in 0 till 11
      P = Parent RootU
      if P equal RootU
        break
      end
      RootU = P
    end

    RootV = V
    for Step in 0 till 11
      P = Parent RootV
      if P equal RootV
        break
      end
      RootV = P
    end

    if RootU not equal RootV
      if (Size RootU) less (Size RootV)
        Tmp = RootU
        RootU = RootV
        RootV = Tmp
      end
      Parent RootV = RootU
      SzU = Size RootU
      Size RootU = SzU + Size RootV
    end
  end

  CompOdd = array shape (N + 1) fill 0
  HasC = array shape (N + 1) fill false

  for I in 1 to N
    if (Deg I) greater 0
      Root = I
      for Step in 0 till 11
        P = Parent Root
        if P equal Root
          break
        end
        Root = P
      end
      HasC Root = true
      if ((Deg I) mod 2) equal 1
        OddC = CompOdd Root
        CompOdd Root = OddC + 1
      end
    end
  end

  AllRoots = 1 to N
  Mask = HasC AllRoots
  Active = AllRoots Mask
  Odds = CompOdd Active
  IsZero = Odds equal 0
  ZeroCost = IsZero integer
  OddPart = Odds // 2
  Nz = (not IsZero) integer
  NonZeroCost = Nz * OddPart
  Costs = ZeroCost + NonZeroCost
  Ans = Costs sum
end

return Ans
