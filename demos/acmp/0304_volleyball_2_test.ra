use testing

test "ACMP 304: sample 1 (3 sets, 3:0 sweep)"
  use "0304_volleyball_2"
  N = 3
  MatchesText = "25:23 25:20 25:18"
  run

  Expected = 10043105786927107686166271970998925000
  Answer equal Expected
end

test "ACMP 304: sample 2 (4 sets with overtime 26:24)"
