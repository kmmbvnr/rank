rem Hello Space!
rem https://acmp.ru/
rem   index.asp?main=task&id_task=657
rem Demodulating alien Manchester signal

use io
use numbers
use cli
use sequences
use text

arg Input text = (
  "3\n" +
  "9\n" +
  "103\n" +
  "195\n" +
  "204\n" +
  "198\n" +
  "202\n" +
  "196\n" +
  "205\n" +
  "197\n" +
  "98\n" +
  "5\n" +
  "42\n" +
  "43\n" +
  "39\n" +
  "93\n" +
  "44\n" +
  "5\n" +
  "10\n" +
  "10\n" +
  "22\n" +
  "10\n" +
  "30"
)

Tokens = (
  (Input split "\n" join " ")
  split " "
)
Tokens = Tokens (Tokens not equal "")

K = Tokens 0 integer
Idx = 1

Results = array shape K fill ""

for KIdx in 0 till K
  N = Tokens Idx integer
  Idx = Idx + 1
  EndIdx = Idx + N
  T = (Tokens (Idx till EndIdx)) integer
  Idx = EndIdx

  T1 = T 0
  Failed = 0
  if T1 equal 0
    Failed = 1
  end

  Types = array shape N fill 1
  if Failed equal 0
    T14 = T1 * 14
    T10 = T * 10
    IsType1 = not (T10 greater T14)
    TypeInt = IsType1 integer
    Types = 2 - TypeInt

    Types11 = Types * 11.0
    Types9 = Types * 9.0
    TReal10 = T * 10.0
    LowBounds = TReal10 / Types11
    HighBounds = TReal10 / Types9
    MaxLow = LowBounds max
    MinHigh = HighBounds min

    if MaxLow greater MinHigh
      Failed = 1
    end
  end

  if Failed equal 0
    TotalHalf = Types sum
    HalfMod = TotalHalf mod 2
    if HalfMod not equal 0
      Failed = 1
    end
  end

  BitStr = "ERROR"
  if Failed equal 0
    TotalHalf = Types sum
    NumBits = TotalHalf // 2
    HalfBits = (
      array shape TotalHalf fill 0
    )
    Pos = 0
    for I in 0 till N
      Val = 1 - (I mod 2)
      Len = Types I
      HalfBits Pos = Val
      if Len equal 2
        HalfBits (Pos + 1) = Val
      end
      Pos = Pos + Len
    end

    EvenIdx = (0 till NumBits) * 2
    OddIdx = EvenIdx + 1
    B0 = HalfBits EvenIdx
    B1 = HalfBits OddIdx

    IsOne = (B0 equal 1) and (
      B1 equal 0
    )
    IsZero = (B0 equal 0) and (
      B1 equal 1
    )
    Valid = IsOne or IsZero
    ValCnt = Valid count

    if not (ValCnt equal NumBits)
      Failed = 1
    else
      First1 = IsOne 0
      LastBit = NumBits - 1
      Last0 = IsZero LastBit
      Starts1Ends0 = First1 and Last0
      if not Starts1Ends0
        Failed = 1
      else
        BitChars = (
          array shape NumBits fill "0"
        )
        for BIdx in 0 till NumBits
          if IsOne BIdx
            BitChars BIdx = "1"
          end
        end
        BitStr = BitChars join ""
      end
    end
  end

  Results KIdx = BitStr
end

Output = Results join "\n"
Output print
