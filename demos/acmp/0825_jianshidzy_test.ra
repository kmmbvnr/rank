rem Tests for ACMP 0825 Jianshidzy

use testing

test "default test with bounds"
  use "0825_jianshidzy" as solve
  Ans = solve

  Ans 0 equal "0 0"
  Ans 1 equal "1 2"
  Ans 2 equal "3 5"
  Ans 3 equal "1134903169 1836311902"
  Ans 4 equal "1618033988 2618033988"
end

test "sample: 3 0 1 2"
  use "0825_jianshidzy" as solve
  Ans = solve "3
0
1
2"

  Exp = array "0 0" "1 2" "3 5"
  Ans equal Exp
end

test "precision boundary 1"
  use "0825_jianshidzy" as solve
  Ans = solve "1
701408733"

  Ans 0 equal "1134903169 1836311902"
end

test "precision boundary 2"
  use "0825_jianshidzy" as solve
  Ans = solve "1
267914296"

  Ans 0 equal "433494436 701408732"
end
