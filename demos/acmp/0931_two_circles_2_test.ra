rem Tests for ACMP 0931: Circles

use testing
use text

test "ACMP 931: Sample 1 (7 points)"
  use "0931_two_circles_2" as solve
  use text
  Result = solve "7
1 -1
0 0
1 1
3 1
3 -1
2 0
4 0"

  Lines = Result split "\n"
  (Lines len) equal 2
end

test "ACMP 931: Sample 2 (5 points)"
  use "0931_two_circles_2" as solve
  use text
  Result = solve "5
-1000000 0
0 1000000
1000000 0
0 -1000000
0 0"

  Lines = Result split "\n"
  (Lines len) equal 2
end

test "ACMP 931: Minimal N=2"
  use "0931_two_circles_2" as solve
  use text
  Result = solve "2
0 0
1 1"

  Lines = Result split "\n"
  (Lines len) equal 2
end

test "ACMP 931: Default 110 points"
  use "0931_two_circles_2" as solve
  use text
  Result = solve

  Lines = Result split "\n"
  (Lines len) equal 2
end
