rem Lattice Points in Polygon
rem acmp.ru: task 209
rem Interior points via Pick's theorem

use numbers
use sequences
use text
use io
use cli

arg XsText text = "0 10000 10000 0"
arg YsText text = "0 0 10000 10000"

XParts = XsText split " "
Xs = XParts integer
YParts = YsText split " "
Ys = YParts integer

N = Xs len
Shift = concat (1 till N) (array 0)

XsNext = Xs Shift
YsNext = Ys Shift

Cross = Xs * YsNext - XsNext * Ys
CrossSum = Cross sum
DoubleArea = CrossSum abs
DX = XsNext - Xs abs
DY = YsNext - Ys abs

Gcds = DX gcd DY
Boundary = Gcds sum
Diff = DoubleArea - Boundary + 2
Answer = Diff // 2
Answer print
