use testing

test "official next passwords"
  use "011_password"

  "abcdefgh" nextvalid equal "abcdffaa"
  "ghijklmn" nextvalid equal "ghjaabcc"
end

test "password increment"
  use "011_password"

  "xx" increment equal "xy"
  "xz" increment equal "ya"
  "zz" increment equal "aa"
end

test "forbidden ranges are skipped"
  use "011_password"

  "ghijklmp" skipforbidden equal "ghjaaaaa"
  "abcdffaa" skipforbidden equal "abcdffaa"
end

test "invalid password rules"
  use "011_password"

  not ("hijklmmn" valid)
  not ("abbceffg" valid)
  not ("abbcegjk" valid)
end

test "valid password rules"
  use "011_password"

  "abcdffaa" valid
  "ghjaabcc" valid
end
