rem Advent of Code 2015 — Day 22
rem Wizard Simulator 20XX
rem https://adventofcode.com/2015/day/22

use io
use cli
use text

argument Input path

Lines = Input readlines
unpack Part1 Part2 = Lines solve
Part1 print
Part2 print


rem Parse the boss and solve the normal and hard fights.
fun solve Lines
  Pattern = "/text: /integer"
  unpack Name BossHP = Lines 0 Pattern parse
  unpack Name BossDamage = Lines 1 Pattern parse
  Part1 = BossHP BossDamage 50 500 false leastmana
  Part2 = BossHP BossDamage 50 500 true leastmana
  return array Part1 Part2
end


rem Start the search with no active effects and no mana spent.
fun leastmana BossHP BossDamage PlayerHP PlayerMana Hard
  State = record
    .hp = PlayerHP
    .mana = PlayerMana
    .boss = BossHP
    .shield = 0
    .poison = 0
    .recharge = 0
    .spent = 0
  end
  return State BossDamage Hard 1000000000 fight
end


rem Search every spell sequence and retain the least mana cost found.
fun fight State BossDamage Hard Best
  if State .spent at least Best
    return Best
  end

  if Hard
    State = State with
      .hp -= 1
    end
    if State .hp at most 0
      return Best
    end
  end

  Now = State effects
  if Now .boss at most 0
    return Best Now .spent min
  end
  Mana = Now .mana

  if Mana at least 53
    Next = Now with
      .mana -= 53
      .boss -= 4
      .spent += 53
    end
    Best = Next BossDamage Hard Best bossturn
  end

  if Mana at least 73
    Next = Now with
      .hp += 2
      .mana -= 73
      .boss -= 2
      .spent += 73
    end
    Best = Next BossDamage Hard Best bossturn
  end

  if Mana at least 113 and Now .shield equal 0
    Next = Now with
      .mana -= 113
      .shield = 6
      .spent += 113
    end
    Best = Next BossDamage Hard Best bossturn
  end

  if Mana at least 173 and Now .poison equal 0
    Next = Now with
      .mana -= 173
      .poison = 6
      .spent += 173
    end
    Best = Next BossDamage Hard Best bossturn
  end

  if Mana at least 229 and Now .recharge equal 0
    Next = Now with
      .mana -= 229
      .recharge = 5
      .spent += 229
    end
    Best = Next BossDamage Hard Best bossturn
  end

  return Best
end


rem Apply effects, let the boss attack, then continue with the player turn.
fun bossturn State BossDamage Hard Best
  Now = State effects
  if Now .boss at most 0
    return Best Now .spent min
  end

  Armor = 0
  if Now .shield greater 0
    Armor = 7
  end
  Next = Now with
    .hp -= 1 (BossDamage - Armor) max
  end

  if Next .hp at most 0
    return Best
  end
  return Next BossDamage Hard Best fight
end


rem Apply active effects once and decrease all effect timers.
fun effects State
  Next = State with
    .shield = 0 (State .shield - 1) max
    .poison = 0 (State .poison - 1) max
    .recharge = 0 (State .recharge - 1) max
  end
  if State .poison greater 0
    Next .boss -= 3
  end
  if State .recharge greater 0
    Next .mana += 101
  end
  return Next
end
