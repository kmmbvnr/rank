rem Advent of Code 2015 — Day 22
rem Wizard Simulator 20XX
rem https://adventofcode.com/2015/day/22

use io
use cli
use text

argument Input path

Lines = Input readlines
unpack Part1 Part2 = Lines solve
Part1 print
Part2 print


rem Parse the boss and solve the normal and hard fights.
fun solve Lines
  Pattern = "/text: /integer"
  unpack Name BossHP = Lines 0 Pattern parse
  unpack Name BossDamage = Lines 1 Pattern parse
  Part1 = BossHP BossDamage 50 500 false leastmana
  Part2 = BossHP BossDamage 50 500 true leastmana
  return array Part1 Part2
end


rem Start the search with no active effects and no mana spent.
fun leastmana BossHP BossDamage PlayerHP PlayerMana Hard
  State = array shape 7
    PlayerHP PlayerMana BossHP 0 0 0 0
  end
  return State BossDamage Hard 1000000000 fight
end


rem Search every spell sequence and retain the least mana cost found.
fun fight State BossDamage Hard Best
  if State 6 at least Best
    return Best
  end

  if Hard
    State 0 -= 1
    if State 0 at most 0
      return Best
    end
  end

  unpack HP Mana Boss Shield Poison Recharge Spent = State effects

  if Boss at most 0
    return Best min Spent
  end

  if Mana at least 53
    NewMana = Mana - 53
    NewBoss = Boss - 4
    NewSpent = Spent + 53
    Next = array shape 7
      HP NewMana NewBoss Shield
      Poison Recharge NewSpent
    end
    Best = Next BossDamage Hard Best bossturn
  end

  if Mana at least 73
    NewHP = HP + 2
    NewMana = Mana - 73
    NewBoss = Boss - 2
    NewSpent = Spent + 73
    Next = array shape 7
      NewHP NewMana NewBoss Shield
      Poison Recharge NewSpent
    end
    Best = Next BossDamage Hard Best bossturn
  end

  if Mana at least 113 and Shield equal 0
    NewMana = Mana - 113
    NewSpent = Spent + 113
    Next = array shape 7
      HP NewMana Boss 6
      Poison Recharge NewSpent
    end
    Best = Next BossDamage Hard Best bossturn
  end

  if Mana at least 173 and Poison equal 0
    NewMana = Mana - 173
    NewSpent = Spent + 173
    Next = array shape 7
      HP NewMana Boss Shield
      6 Recharge NewSpent
    end
    Best = Next BossDamage Hard Best bossturn
  end

  if Mana at least 229 and Recharge equal 0
    NewMana = Mana - 229
    NewSpent = Spent + 229
    Next = array shape 7
      HP NewMana Boss Shield
      Poison 5 NewSpent
    end
    Best = Next BossDamage Hard Best bossturn
  end

  return Best
end


rem Apply effects, let the boss attack, then continue with the player turn.
fun bossturn State BossDamage Hard Best
  unpack HP Mana Boss Shield Poison Recharge Spent = State effects

  if Boss at most 0
    return Best min Spent
  end

  Armor = 0
  if Shield greater 0
    Armor = 7
  end
  Damage = 1 max (BossDamage - Armor)
  HP -= Damage

  if HP at most 0
    return Best
  end

  Next = array shape 7
    HP Mana Boss Shield
    Poison Recharge Spent
  end
  return Next BossDamage Hard Best fight
end


rem Apply active effects once and decrease all effect timers.
fun effects State
  unpack HP Mana Boss Shield Poison Recharge Spent = State

  if Poison greater 0
    Boss -= 3
  end
  if Recharge greater 0
    Mana += 101
  end

  Shield = 0 max (Shield - 1)
  Poison = 0 max (Poison - 1)
  Recharge = 0 max (Recharge - 1)

  return array HP Mana Boss Shield Poison Recharge Spent
end
