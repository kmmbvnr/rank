rem Advent of Code 2015 — Day 16
rem Aunt Sue
rem https://adventofcode.com/2015/day/16

use io
use cli
use algo
use text

argument Input path

Lines = Input readlines
unpack Part1 Part2 = Lines solve
Part1 print
Part2 print


rem Find the candidates matching exact and corrected evidence rules.
fun solve Lines
  Index = new index
  Index "children" = 3
  Index "cats" = 7
  Index "samoyeds" = 2
  Index "pomeranians" = 3
  Index "akitas" = 0
  Index "vizslas" = 0
  Index "goldfish" = 5
  Index "trees" = 3
  Index "cars" = 2
  Index "perfumes" = 1

  Pattern = "Sue /integer: /word: /integer, /word: /integer, /word: /integer"
  Part1 = 0
  Part2 = 0

  for Line in Lines
    unpack Id P1 V1 P2 V2 P3 V3 = Line Pattern parse

    A = P1 V1 Index exact
    B = P2 V2 Index exact
    C = P3 V3 Index exact
    if A and B and C
      Part1 = Id
    end

    A = P1 V1 Index corrected
    B = P2 V2 Index corrected
    C = P3 V3 Index corrected
    if A and B and C
      Part2 = Id
    end
  end

  return array Part1 Part2
end


rem Compare one reported property with the original exact reading.
fun exact Property Value Targets
  return Value equal Targets Property
end


rem Apply the corrected range rules to one reported property.
fun corrected Property Value Targets
  Target = Targets Property

  if Property equal "cats"
    return Value greater Target
  elif Property equal "trees"
    return Value greater Target
  elif Property equal "pomeranians"
    return Value less Target
  elif Property equal "goldfish"
    return Value less Target
  else
    return Value equal Target
  end
end
