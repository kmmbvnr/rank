rem Advent of Code 2015 — Day 13
rem Knights of the Dinner Table
rem https://adventofcode.com/2015/day/13
rem
rem Part 1:
rem Find the seating arrangement with maximum happiness.
rem
rem Part 2:
rem Add yourself with zero happiness toward everyone.

use io
use cli
use algo
use text

argument Input path

Lines = Input readlines
unpack Part1 Part2 = Lines solve
Part1 print
Part2 print


rem Find the best circular seating before and after adding yourself.
fun solve Lines
  Index = new index
  Seen = new set
  Pattern = "/word would /word /integer happiness units by sitting next to /word."

  for Line in Lines
    unpack A Sign Value B = Line Pattern parse

    if Sign equal "lose"
      Value = -Value
    end

    Seen add A
    Seen add B
    Index A B = Value
  end

  Part1 = Seen Index best

  for Person in Seen
    Index "Me" Person = 0
    Index Person "Me" = 0
  end
  Seen add "Me"

  Part2 = Seen Index best
  return array Part1 Part2
end


rem Return the greatest happiness among all permutations of the guests.
fun best Guests Scores
  Queue = new queue
  for Route in Guests permutations
    Queue push Route Scores happiness
  end

  Happiness = Queue
  return Happiness max
end


rem Sum both directed scores around one circular seating arrangement.
fun happiness Route Scores
  Total = 0
  N = Route len

  for I in 0 till N
    J = (I + 1) % N
    A = Route I
    B = Route J
    Total += Scores A B
    Total += Scores B A
  end

  return Total
end
