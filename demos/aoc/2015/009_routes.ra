rem Advent of Code 2015 — Day 9
rem All in a Single Night
rem https://adventofcode.com/2015/day/9
use io
use cli
use algo
use text
use sequences

arg Input path

unpack Part1 Part2 = Input readlines solve
Part1 print
Part2 print


rem Find the shortest and longest routes that visit every city once.
fun Lines' solve
  Index = new index
  Queue = new queue
  Seen = new set
  Pattern = "/word to /word = /integer"

  for Line in Lines
    unpack A B Distance = Line parse Pattern
    Seen add A
    Seen add B
    Index A B = Distance
    Index B A = Distance
  end

  for Route in Seen permutations
    Queue push Route distance Index
  end

  Distances = Queue
  Shortest = Distances min
  Longest = Distances max
  return array Shortest Longest
end


rem Add the distances between adjacent cities in one route.
fun Route distance Distances
  Total = 0

  for Pair in Route window 2
    unpack A B = Pair
    Total += Distances A B
  end

  return Total
end
