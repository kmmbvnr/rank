rem Advent of Code 2015 - Day 3
rem Perfectly Spherical Houses in a Vacuum
rem https://adventofcode.com/2015/day/3

use io
use cli
use algo
use numbers

argument Input path

unpack Part1 Part2 = Input read solve
Part1 print
Part2 print


rem Return the houses visited with one and two deliverers.
fun solve Moves
  Part1 = Moves houses
  Part2 = Moves robohouses
  return array Part1 Part2
end


rem Return number of houses visited by Santa.
fun houses Moves
  Seen = new set
  X = 0
  Y = 0

  Seen add array X Y

  for C in Moves
    X += C dx
    Y += C dy
    Seen add array X Y
  end

  return Seen len
end


rem Return number of houses visited by Santa and Robo-Santa.
rem Even moves belong to Santa, odd moves to Robo-Santa.
fun robohouses Moves
  Seen = new set
  SantaX = 0
  SantaY = 0
  RoboX = 0
  RoboY = 0

  Seen add array 0 0

  for C i in Moves
    if i even
      SantaX += C dx
      SantaY += C dy
      Seen add array SantaX SantaY
    else
      RoboX += C dx
      RoboY += C dy
      Seen add array RoboX RoboY
    end
  end

  return Seen len
end


rem Return horizontal movement for one direction.
fun dx C
  if C equal ">"
    return 1
  elif C equal "<"
    return -1
  end
  return 0
end


rem Return vertical movement for one direction.
fun dy C
  if C equal "^"
    return 1
  elif C equal "v"
    return -1
  end
  return 0
end
