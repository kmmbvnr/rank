rem Advent of Code 2015 — Day 14
rem Reindeer Olympics
rem https://adventofcode.com/2015/day/14

use io
use cli
use algo
use sequences
use text

argument Input path

Lines = Input readlines
unpack Part1 Part2 = Lines 2503 solve
Part1 print
Part2 print


rem Find greatest distance and greatest per-second score.
fun solve Lines Race
  Pattern = "/word can fly /integer km//s for /integer seconds, but then must rest for /integer seconds."

  for Line in Lines
    unpack Name Speed Fly Rest = Line Pattern parse
    queue push Speed
    queue push Fly
    queue push Rest
  end

  N = Lines len
  Data = queue (array N 3) reshape
  Speeds = Data # 0
  Flys = Data # 1
  Rests = Data # 2

  Distances = Speeds Flys Rests Race distance
  Part1 = Distances max

  Scores = array shape N fill 0
  for Second in 1 to Race
    Distances = Speeds Flys Rests Second distance
    Lead = Distances max
    Scores += (Distances equal Lead) 1 0 choose
  end
  Part2 = Scores max

  return array Part1 Part2
end


rem Calculate distance for reindeer after Time seconds.
fun distance Speed Fly Rest Time
  Cycle = Fly + Rest
  Full = Time // Cycle
  Left = Time % Cycle
  Active = Left Fly min
  FlyTime = Full * Fly + Active
  return FlyTime * Speed
end
