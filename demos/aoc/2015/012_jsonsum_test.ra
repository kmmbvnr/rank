use testing

test "official array examples"
  use "012_jsonsum"
  use json

  "[1,2,3]" json sumall equal 6
  "[1,{\"a\":2},3]" json sumall equal 6
  "[1,\"red\",5]" json sumnored equal 6
end

test "red object is excluded"
  use "012_jsonsum"

  Result = "{\"d\":\"red\",\"e\":[1,2,3,4],\"f\":5}" solve
  Result equal array 15 0
end

test "red affects its object only"
  use "012_jsonsum"

  Result = "[1,{\"c\":\"red\",\"b\":2},3]" solve
  Result equal array 6 4
end
