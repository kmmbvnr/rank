rem Advent of Code 2015 - Day 6
rem Probably a Fire Hazard
rem https://adventofcode.com/2015/day/6

use io
use cli
use algo
use text

argument Input path

unpack Part1 Part2 = Input readlines solve
Part1 print
Part2 print


rem Return the final lit count and total brightness.
fun solve Lines
  Part1 = Lines lights
  Part2 = Lines brightness
  return array Part1 Part2
end


rem Parse an instruction into its operation and inclusive rectangle.
fun parse Line
  Words = Line " " split

  if Words 0 equal "toggle"
    Op = "toggle"
    unpack X1 Y1 = Words 1 "," split integer rank 0
    unpack X2 Y2 = Words 3 "," split integer rank 0
  else
    Op = Words 1
    unpack X1 Y1 = Words 2 "," split integer rank 0
    unpack X2 Y2 = Words 4 "," split integer rank 0
  end

  return array Op X1 Y1 X2 Y2
end


rem Apply the binary light rules to a sparse grid.
fun lights Lines
  Count = 0

  for Line in Lines
    unpack Op X1 Y1 X2 Y2 = Line parse

    for Y in Y1 to Y2
      for X in X1 to X2
        Old = index X Y default false
        New = true
        if Op equal "off"
          New = false
        else
          if Op equal "toggle"
            New = not Old
          end
        end

        if New not equal Old
          index X Y = New
          if New
            Count += 1
          else
            Count -= 1
          end
        end
      end
    end
  end

  return Count
end


rem Apply the brightness rules to a sparse integer grid.
fun brightness Lines
  Total = 0

  for Line in Lines
    unpack Op X1 Y1 X2 Y2 = Line parse

    for Y in Y1 to Y2
      for X in X1 to X2
        Value = index X Y default 0

        if Op equal "on"
          Value += 1
          Total += 1
        else
          if Op equal "toggle"
            Value += 2
            Total += 2
          else
            if Value greater 0
              Value -= 1
              Total -= 1
            end
          end
        end

        index X Y = Value
      end
    end
  end

  return Total
end
