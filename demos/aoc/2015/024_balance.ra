rem Advent of Code 2015 — Day 24
rem It Hangs in the Balance
rem https://adventofcode.com/2015/day/24

use io
use cli
use algo
use bits

argument Input path

Packages = Input readlines integer rank 0
Part1 = Packages balance 3
Part2 = Packages balance 4
Part1 print
Part2 print


rem Minimize the first group by package count, then by product.
fun Packages balance Groups
  Target = Packages sum // Groups
  Count = Packages len
  Indices' = 0 till Count

  for Size in 1 to Count
    Found = false
    Best = 0

    for Pick in Indices combinations Size
      Weight = 0
      Product = 1
      Used = 0

      for I in Pick
        Weight += Packages I
        Product *= Packages I
        Bit = 1 shl I
        Used = Used bor Bit
      end

      if Weight equal Target
        Remaining = Groups - 1
        Valid = Packages Used Remaining Target partitionable

        if Valid
          if not Found
            Found = true
            Best = Product
          elif Product less Best
            Best = Product
          end
        end
      end
    end

    if Found
      return Best
    end
  end
end


rem Check recursively whether unused packages can fill the remaining groups.
fun Packages Used Groups Target partitionable
  Queue = new queue
  if Groups equal 1
    return true
  end

  Count = Packages len
  for I in 0 till Count
    Taken = Used bit I
    if not Taken
      Queue push I
    end
  end
  Available = Queue

  for Size in 1 to (Available len)
    for Pick in Available combinations Size
      Weight = 0
      NextUsed = Used

      for I in Pick
        Weight += Packages I
        Bit = 1 shl I
        NextUsed = NextUsed bor Bit
      end

      if Weight equal Target
        Remaining = Groups - 1
        Valid = Packages NextUsed Remaining Target partitionable
        if Valid
          return true
        end
      end
    end
  end

  return false
end
