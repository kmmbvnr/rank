use testing

test "part 1 examples"
  use "001_floors"

  Answer = "(())" solve
  Answer equal array 0 0

  Answer = "(((()" solve
  Answer equal array 3 0

  Answer = "))(((((" solve
  Answer equal array 3 1

  Answer = ")())())" solve
  Answer equal array -3 1
end

test "part 2 examples"
  use "001_floors"

  Answer = ")" solve
  Answer equal array -1 1

  Answer = "()())" solve
  Answer equal array -1 5
end

test "trailing line ending"
  use "001_floors"

  Answer = "()())\n" solve
  Answer equal array -1 5
end
