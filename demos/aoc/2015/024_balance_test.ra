use testing

test "official three-group example"
  use "024_balance"

  Packages = array 1 2 3 4 5 7 8 9 10 11
  Packages balance 3 equal 99
end

test "official four-group example"
  use "024_balance"

  Packages = array 1 2 3 4 5 7 8 9 10 11
  Packages balance 4 equal 44
end

test "equal package weights remain separate choices"
  use "024_balance"

  Packages = array 1 1 1 1 2 2
  Packages balance 4 equal 2
end
