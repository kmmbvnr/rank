rem Advent of Code 2015 — Day 19
rem Medicine for Rudolph
rem https://adventofcode.com/2015/day/19

use io
use cli
use algo
use text
use sequences

arg Input path

unpack Part1 Part2 = Input readlines solve
Part1 print
Part2 print


rem Parse replacement rules and solve both molecule questions.
fun Lines' solve
  Queue = new queue
  Target = ""

  for Line in Lines
    if " => " in Line
      Queue push Line split " => "
    elif Line len greater 0
      Target = Line
    end
  end

  Part1 = Queue variants Target
  Part2 = Target medicine_steps
  return array Part1 Part2
end


rem Count distinct molecules made by applying exactly one rule once.
fun Rules variants Target
  Seen = new set
  for Rule in Rules
    From = Rule 0
    To = Rule 1
    Last = Target len - (From len)

    if Last at least 0
      for Start in 0 to Last
        if Target From Start matchat
          New = Target From To Start replaceat
          Seen add New
        end
      end
    end
  end

  return Seen len
end


rem Test whether Pattern occurs at one Unicode position in Text.
fun Text Pattern Start matchat
  Finish = Start + (Pattern len)
  if Text len less Finish
    return false
  end
  Part = Text (Start till Finish)
  return Part equal Pattern
end


rem Replace one occurrence beginning at a known Unicode position.
fun Text From To Start replaceat
  Prefix = Text (0 till Start)
  Tail = Start + (From len)
  Suffix = Text (Tail till (Text len))
  return Prefix + To + Suffix
end


rem Count minimum steps implied by the puzzle input's medicine grammar.
fun Text medicine_steps
  Elements = 0
  Rn = 0
  Ar = 0
  Y = 0
  Upper = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"

  for C in Text
    if C in Upper
      Elements += 1
    end
    if C equal "Y"
      Y += 1
    end
  end

  for Pair in Text window 2
    if Pair equal "Rn"
      Rn += 1
    elif Pair equal "Ar"
      Ar += 1
    end
  end

  return Elements - Rn - Ar - 2 * Y - 1
end
