rem Advent of Code 2015 — Day 12
rem JSAbacusFramework.io
rem https://adventofcode.com/2015/day/12

use io
use cli
use json

argument Input path

Text = Input read
unpack Part1 Part2 = Text solve
Part1 print
Part2 print


rem Decode a document and calculate both puzzle sums.
fun solve Text
  Data = Text json
  Part1 = Data sumall
  Part2 = Data sumnored
  return array Part1 Part2
end


rem Sum every numeric value nested in arrays and objects.
fun sumall Value
  if Value is .integer or Value is .real
    return Value
  end

  Total = 0.0
  if Value is .array
    for Item in Value
      Total += Item sumall
    end
  elif Value is .object
    for Item Key in Value
      Total += Item sumall
    end
  end
  return Total
end


rem Sum values except inside an object containing the text "red".
fun sumnored Value
  if Value is .integer or Value is .real
    return Value
  end

  if Value is .object
    for Item Key in Value
      if Item is .text and Item equal "red"
        return 0
      end
    end
  end

  Total = 0.0
  if Value is .array
    for Item in Value
      Total += Item sumnored
    end
  elif Value is .object
    for Item Key in Value
      Total += Item sumnored
    end
  end
  return Total
end
