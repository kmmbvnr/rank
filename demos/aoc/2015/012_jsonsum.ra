rem Advent of Code 2015 — Day 12
rem JSAbacusFramework.io
rem https://adventofcode.com/2015/day/12

use io
use cli
use json
use tables

argument Input path

Text = Input read
unpack Part1 Part2 = Text solve
Part1 print
Part2 print


rem Decode a document and calculate both puzzle sums.
rem Part 1 reads every number at any depth from the flat
rem table of nodes; part 2 needs the nesting, so it walks
rem the tree.
fun solve Text
  Nodes = Text json .flat
  Numbers = Nodes filter .kind equal "integer"
  Part1 = Numbers .value sum
  Part2 = Text json sumnored
  return array Part1 Part2
end


rem Sum values except inside an object containing the text "red".
fun sumnored Value
  if Value is .integer or Value is .real
    return Value
  end

  if Value is .object
    for Item Key in Value
      if Item is .text and Item equal "red"
        return 0
      end
    end
  end

  Total = 0.0
  if Value is .array
    for Item in Value
      Total += Item sumnored
    end
  elif Value is .object
    for Item Key in Value
      Total += Item sumnored
    end
  end
  return Total
end
