rem Advent of Code 2015 — Day 25
rem Let It Snow
rem https://adventofcode.com/2015/day/25

use io
use cli
use text

argument Input path

Text = Input read
Answer = Text solve
Answer print


rem Parse the requested grid position from the manual sentence.
fun solve Text
  Pattern = "/text row /integer, column /integer."
  unpack Description Row Column = Text Pattern parse
  return Row Column code
end


rem Convert a row and column to its diagonal sequence position.
fun code Row Column
  Diagonal = Row + Column - 1
  Before = Diagonal - 1
  Position = Before * Diagonal // 2 + Column

  Seed = 20151125
  Factor = 252533 (Position - 1) 33554393 modpow
  return Seed * Factor % 33554393
end


rem Raise Base to Exp modulo Mod by repeated squaring.
fun modpow Base Exp Mod
  Result = 1
  Base = Base % Mod

  for Exp greater 0
    if Exp % 2 equal 1
      Result = Result * Base % Mod
    end
    Base = Base * Base % Mod
    Exp //= 2
  end

  return Result
end
