rem Advent of Code 2015 — Day 25
rem Let It Snow
rem https://adventofcode.com/2015/day/25

use io
use cli
use numbers
use text

argument Input path

Text = Input read
Answer = Text solve
Answer print


rem Parse the requested grid position from the manual sentence.
fun solve Text
  Pattern = "/text row /integer, column /integer."
  unpack Description Row Column = Text Pattern parse
  return Row Column code
end


rem Convert a row and column to its diagonal sequence position.
fun code Row Column
  Diagonal = Row + Column - 1
  Before = Diagonal - 1
  Position = Before * Diagonal // 2 + Column

  Seed = 20151125
  Factor = 252533 (Position - 1) 33554393 powmod
  return Seed * Factor % 33554393
end
