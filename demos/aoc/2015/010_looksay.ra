rem Advent of Code 2015 — Day 10
rem Elves Look, Elves Say
rem https://adventofcode.com/2015/day/10

use io
use cli

arg Input path

Start = Input readlines 0
unpack Part1 Part2 = Start solve
Part1 print
Part2 print


rem Return the lengths after 40 and 50 look-and-say rounds.
fun Value solve
  After40 = Value look repeat 40
  After50 = After40 look repeat 10
  Part1 = After40 len
  Part2 = After50 len
  return array Part1 Part2
end


rem Describe each consecutive run as its length followed by its value.
fun Value look
  Result = ""
  Last = Value 0
  Count = 0

  for C in Value
    if C equal Last
      Count += 1
    else
      Result += Count text + Last
      Last = C
      Count = 1
    end
  end

  Result += Count text + Last
  return Result
end
