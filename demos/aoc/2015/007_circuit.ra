rem Advent of Code 2015 - Day 7
rem Some Assembly Required
rem https://adventofcode.com/2015/day/7

use io
use cli
use algo
use bits
use text

arg Input path

Lines = Input readlines
unpack Part1 Part2 = Lines solve

Part1 print
Part2 print


rem Evaluate a twice. For Part 2, replace
rem b with the first signal.
fun Lines solve
  Part1 = Lines "a" (-1) circuit
  Part2 = Lines "a" Part1 circuit
  return array Part1 Part2
end


rem Resolve Target by repeatedly evaluating
rem instructions with ready inputs.
fun Lines Target Override circuit
  Index = new index
  if Override at least 0
    Index "b" = Override band 65535
  end

  Pattern = "/text -> /word"

  for not Target in Index
    Progress = false

    for Line in Lines
      unpack Expression Dest = Line parse Pattern

      if not Dest in Index
        try
          Value = Expression eval_expr Index
          Index Dest = Value band 65535
          Progress = true
        catch .NotReady Error
        end
      end
    end

    if not Progress
      .InvalidCircuit Target raise
    end
  end

  return Index Target
end


rem Evaluate an expression or raise .NotReady if any wire is pending.
fun Expression eval_expr Wires
  Terms = Expression split " "

  if Terms len equal 1
    return Terms 0 signal Wires
  end

  if Terms 0 equal "NOT"
    return (Terms 1 signal Wires) bnot
  end

  Left = Terms 0 signal Wires
  Op = Terms 1
  Right = Terms 2 signal Wires
  return Op Left Right operate
end


rem Read a decimal literal or wire signal, or fail if not yet resolved.
fun Token signal Wires
  try
    return Token integer
  catch .InvalidNumber Error
    if Token in Wires
      return Wires Token
    end
    .NotReady raise
  end
end


rem Apply one binary circuit operation.
fun Op Left Right operate
  if Op equal "AND"
    return Left band Right
  end
  if Op equal "OR"
    return Left bor Right
  end
  if Op equal "LSHIFT"
    return Left shl Right
  end
  if Op equal "RSHIFT"
    return Left shr Right
  end

  .InvalidCircuit Op raise
end
