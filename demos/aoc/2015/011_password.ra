rem Advent of Code 2015 — Day 11
rem Corporate Policy
rem https://adventofcode.com/2015/day/11

use io
use cli
use text
use sequences

argument Input path

Password = Input readlines 0
Part1 = Password nextvalid
Part2 = Part1 nextvalid
Part1 print
Part2 print


rem Find the first valid password after the given one.
fun nextvalid Password
  Password = Password increment skipforbidden

  for not (Password valid)
    Password = Password increment skipforbidden
  end

  return Password
end


rem Increment a lowercase password as a base-26 number.
fun increment Value
  Result = ""
  Carry = true

  for C in Value reverse
    if Carry
      if C equal "z"
        C = "a"
      else
        C = (C codepoint + 1) character
        Carry = false
      end
    end

    Result = C + Result
  end

  return Result
end


rem Skip the whole range below the next allowed lowercase password.
fun skipforbidden Value
  Result = ""
  Reset = false

  for C in Value
    if Reset
      C = "a"
    else
      if C forbidden
        C = (C codepoint + 1) character
        Reset = true
      end
    end
    Result += C
  end

  return Result
end


rem Return true for a letter forbidden in a password.
fun forbidden C
  return C equal "i" or C equal "o" or C equal "l"
end


rem Check the straight, forbidden-letter and distinct-pair rules.
fun valid Value
  if "i" in Value or "o" in Value or "l" in Value
    return false
  end
  if not (Value straight)
    return false
  end
  return Value pairs
end


rem Return true when the password contains three increasing letters.
fun straight Value
  for Triple in Value 3 window
    A = Triple 0 codepoint
    B = Triple 1 codepoint
    C = Triple 2 codepoint

    if B equal A + 1 and C equal B + 1
      return true
    end
  end

  return false
end


rem Return true when two different non-overlapping pairs occur.
fun pairs Value
  First = ""
  Position = 0
  Last = Value len - 1

  for Position less Last
    if Value Position equal Value (Position + 1)
      C = Value Position
      if First equal ""
        First = C
      else
        if C not equal First
          return true
        end
      end
      Position += 2
    else
      Position += 1
    end
  end

  return false
end
