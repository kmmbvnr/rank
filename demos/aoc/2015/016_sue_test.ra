use testing

test "exact and ranged evidence select different Sues"
  use "016_sue"

  Lines = array shape 2
    "Sue 1: children: 3, cats: 7, trees: 3"
    "Sue 2: cats: 8, trees: 4, pomeranians: 2"
  end

  Lines solve equal array 1 2
end

test "ordinary properties remain exact in part two"
  use "016_sue"

  Lines = array shape 2
    "Sue 3: akitas: 1, vizslas: 0, cars: 2"
    "Sue 4: akitas: 0, vizslas: 0, cars: 2"
  end

  Lines solve equal array 4 4
end
