rem Advent of Code 2016 - Day 3
rem Squares With Three Sides
rem https://adventofcode.com/2016/day/3

use io
use cli
use text
use sequences

argument Input path

Answers = Input read solve
Part1 = Answers 0
Part2 = Answers 1

Part1 print
Part2 print


rem Return the triangle counts for sides read along rows and down columns.
rem Part 2 groups every three rows into a block, so the triangles of a
rem block run along axis 1 and the same count works without a transpose.
fun solve Text
  Sides = Text words integer rank 0
  Height = Sides len // 3
  Table = Sides (array Height 3) reshape
  Blocks = Sides (array (Height // 3) 3 3) reshape

  Part1 = Table triangles
  Part2 = Blocks triangles
  return array Part1 Part2
end


rem Count the triangles whose sides lie along axis 1 of the data.
rem A triangle is valid when the longest side is shorter than the other two.
fun triangles Data
  Total = Data sum axis 1
  Longest = Data max axis 1
  Twice = 2 * Longest
  Valid = Total greater Twice
  return Valid count
end
