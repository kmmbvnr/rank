use testing

test "impossible triangle"
  use "003_triangles"

  Answer = "5 10 25\n3 4 5\n3 4 5" solve
  Answer 0 equal 2
end

test "two blocks retain the side axis in a non-cubic tensor"
  use "003_triangles"
  Text = "101 301 501\n102 302 502\n103 303 503\n201 401 601\n202 402 602\n203 403 603"
  Text solve equal array 3 6
end

test "rows and columns give different counts"
  use "003_triangles"
  use text

  Lines = array shape 9
    "101 301 501"
    "102 302 502"
    "103 303 503"
    "201 202 203"
    "201 202 203"
    "201 202 203"
    "5 10 25"
    "5 10 25"
    "5 10 25"
  end

  Answer = Lines join "\n" solve
  Answer equal array 3 9
end
