rem Missing measurements and query fallbacks.
use numbers
use sequences
use algo

Counts = array 12 .NA 7 .NA 21
Adjusted = Counts + 3
Known = (Counts filter present) array
Total = Counts sum
Filled = Counts default 0

Keys = array 10 20 30
Queries = array 20 99 10
Positions = Keys find Queries default -1
Choices = (array 0 9 2) (array 100 200 300) choose default -1
Bag = Keys multiset
Floors = Bag floor (array 5 25 40) default -1

Prices = array 1.25 .NA 3.75
Rounded = Prices round 1
Texts = Prices text rank 0
