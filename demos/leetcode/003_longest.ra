rem Longest Substring Without Repeating
rem Length of the longest substring with
rem no repeated character

use algo

fun longest Text
  Index = new index
  Start = 0
  Best = 0

  for C i in Text
    if C in Index
      Start = Start (Index C + 1) max
    end

    Index C = i
    Best = Best (i - Start + 1) max
  end

  return Best
end
