rem Longest Substring Without Repeating
rem Length of the longest substring with
rem no repeated character

use algo

fun Text longest
  Index = new index
  Start = 0
  Best = 0

  for C i in Text
    if C in Index
      Start = Start max (Index C + 1)
    end

    Index C = i
    Best = Best max (i - Start + 1)
  end

  return Best
end
