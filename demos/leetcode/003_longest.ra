rem Longest Substring Without Repeating
rem Length of the longest substring with
rem no repeated character

use algo

fun longest Text
  Start = 0
  Best = 0

  for C i in Text
    if C in index
      Last = index C

      if Last at least Start
        Start = Last + 1
      end
    end

    index C = i
    Size = i - Start + 1

    if Size greater Best
      Best = Size
    end
  end

  return Best
end
