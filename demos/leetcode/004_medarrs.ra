rem Median of Two Sorted Arrays
rem Median of two sorted arrays in
rem O(log(m+n)) time

use algo

fun median A B
  M = A len
  N = B len

  if M greater N
    return B A median
  end

  Half = M + N + 1
  Half //= 2

  Low = 0
  High = M

  for Low at most High
    I = Low + High
    I //= 2
    J = Half - I

    MoveLeft = false

    if I greater 0
      if J less N
        P = I - 1
        AL = A P
        BR = B J
        MoveLeft = AL greater BR
      end
    end

    if MoveLeft
      High = I - 1
    else
      MoveRight = false

      if J greater 0
        if I less M
          Q = J - 1
          BL = B Q
          AR = A I
          MoveRight = BL greater AR
        end
      end

      if MoveRight
        Low = I + 1
      else
        Left = 0
        if I equal 0
          Q = J - 1
          Left = B Q
        else
          P = I - 1
          Left = A P

          if J greater 0
            Q = J - 1
            BL = B Q
            Left = Left BL max
          end
        end

        Total = M + N

        if Total % 2 equal 1
          return Left / 1.0
        end

        Right = 0
        if I equal M
          Right = B J
        else
          Right = A I

          if J less N
            BR = B J
            Right = Right BR min
          end
        end

        Sum = Left + Right
        return Sum / 2.0
      end
    end
  end
end
