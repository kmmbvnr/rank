rem Median of Two Sorted Arrays
rem Median of two sorted arrays in
rem O(log(m+n)) time

fun median A B
  M = A len
  N = B len

  if M greater N
    return B A median
  end

  Half = (M + N + 1) // 2
  Low = 0
  High = M

  for Low at most High
    I = (Low + High) // 2
    J = Half - I

    if I greater 0
      if J less N
        if A (I - 1) greater B J
          High = I - 1
          continue
        end
      end
    end

    if J greater 0
      if I less M
        if B (J - 1) greater A I
          Low = I + 1
          continue
        end
      end
    end

    Left = 0
    if I equal 0
      Left = B (J - 1)
    elif J equal 0
      Left = A (I - 1)
    else
      Left = A (I - 1)
      Left = Left (B (J - 1)) max
    end

    if (M + N) % 2 equal 1
      return Left / 1.0
    end

    Right = 0
    if I equal M
      Right = B J
    elif J equal N
      Right = A I
    else
      Right = A I
      Right = Right (B J) min
    end

    return (Left + Right) / 2.0
  end
end
