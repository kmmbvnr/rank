use testing

test "three rows"
  use "006_zigzag"
  run

  Answer = "PAYPALISHIRING" 3 zigzag
  Answer equal "PAHNAPLSIIGYIR"
end

test "four rows"
  use "006_zigzag"
  run

  Answer = "PAYPALISHIRING" 4 zigzag
  Answer equal "PINALSIGYAHRPI"
end

test "one row"
  use "006_zigzag"
  run

  Answer = "A" 1 zigzag
  Answer equal "A"
end

test "two rows"
  use "006_zigzag"
  run

  Answer = "ABCDE" 2 zigzag
  Answer equal "ACEBD"
end

test "more rows than characters"
  use "006_zigzag"
  run

  Answer = "ABC" 5 zigzag
  Answer equal "ABC"
end

test "unicode code points"
  use "006_zigzag"
  run

  Answer = "A😀Б猫C" 3 zigzag
  Answer equal "AC😀猫Б"
end
