use testing

test "three rows"
  use "006_zigzag"
  run

  Answer = "PAYPALISHIRING" zigzag 3
  Answer equal "PAHNAPLSIIGYIR"
end

test "four rows"
  use "006_zigzag"
  run

  Answer = "PAYPALISHIRING" zigzag 4
  Answer equal "PINALSIGYAHRPI"
end

test "one row"
  use "006_zigzag"
  run

  Answer = "A" zigzag 1
  Answer equal "A"
end

test "two rows"
  use "006_zigzag"
  run

  Answer = "ABCDE" zigzag 2
  Answer equal "ACEBD"
end

test "more rows than characters"
  use "006_zigzag"
  run

  Answer = "ABC" zigzag 5
  Answer equal "ABC"
end

test "unicode code points"
  use "006_zigzag"
  run

  Answer = "A😀Б猫C" zigzag 3
  Answer equal "AC😀猫Б"
end
