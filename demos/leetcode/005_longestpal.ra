rem Longest Palindromic Substring
rem Longest substring of a string that
rem reads the same both ways

rem Find the first longest palindrome.
rem Try an odd and even center at every
rem character and keep the longest result.
fun Text longest
  Best = ""

  for C i in Text
    Best = Text i i Best expand
    Best = Text i (i + 1) Best expand
  end

  return Best
end

rem Grow a palindrome around L and R while
rem both characters match, then return Best.
fun Text L R Best expand
  N = Text len

  for L at least 0 and R less N
    if Text L not equal Text R
      break
    end

    if R - L + 1 greater (Best len)
      Best = Text (L to R)
    end

    L -= 1
    R += 1
  end

  return Best
end
