rem Longest Palindromic Substring
rem Longest substring of a string that
rem reads the same both ways

use algo
use sequences

fun longest Text
  Best = ""

  for C i in Text
    Best = Text i i Best expand
    R = i + 1
    Best = Text i R Best expand
  end

  return Best
end

fun expand Text L R Best
  N = Text len
  More = true

  for More
    if L less 0
      More = false
    else
      if R at least N
        More = false
      else
        Left = Text L
        Right = Text R

        if Left not equal Right
          More = false
        else
          Size = R - L + 1
          BestSize = Best len

          if Size greater BestSize
            Best = Text from L to R
          end

          L -= 1
          R += 1
        end
      end
    end
  end

  return Best
end
