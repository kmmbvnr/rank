use testing

test "repeating groups"
  use "003_longest"

  Answer = "abcabcbb" longest
  Answer equal 3
end

test "one repeated character"
  use "003_longest"

  Answer = "bbbbb" longest
  Answer equal 1
end

test "window moves past a repeat"
  use "003_longest"

  Answer = "pwwkew" longest
  Answer equal 3
end

test "empty text"
  use "003_longest"

  Answer = "" longest
  Answer equal 0
end

test "unicode code points"
  use "003_longest"

  Answer = "😀a😀b" longest
  Answer equal 3
end
