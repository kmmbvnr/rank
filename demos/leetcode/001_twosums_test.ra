use testing

test "first example"
  use "001_twosums"
  run

  A = array 2 7 11 15
  Answer = A 9 two_sum

  Answer equal array 0 1
end

test "later indices"
  use "001_twosums"
  run

  A = array 3 2 4
  Answer = A 6 two_sum

  Answer equal array 1 2
end

test "duplicate values"
  use "001_twosums"
  run

  A = array 3 3
  Answer = A 6 two_sum

  Answer equal array 0 1
end

test "negative values"
  use "001_twosums"
  run

  A = array -3 4 3 90
  Answer = A 0 two_sum

  Answer equal array 0 2
end

test "stops before evaluating the remaining input"
  use "001_twosums"
  fun X checked
    if X greater 2
      .DomainError raise
    end
    return X
  end
  Source' = (1 to 10) checked rank 0
  Source 3 two_sum equal array 0 1
end
