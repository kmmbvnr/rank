use testing

test "odd total length"
  use "004_medarrs"
  run

  A = array 1 3
  B = array 2
  Answer = A B median

  Answer equal 2.0
end

test "even total length"
  use "004_medarrs"
  run

  A = array 1 2
  B = array 3 4
  Answer = A B median

  Answer equal 2.5
end

test "empty first array"
  use "004_medarrs"
  run

  A = array shape 0
  end
  B = array 1
  Answer = A B median

  Answer equal 1.0
end

test "partition moves right"
  use "004_medarrs"
  run

  A = array 1 2
  B = array 3 4 5 6 7
  Answer = A B median

  Answer equal 4.0
end

test "partition moves left"
  use "004_medarrs"
  run

  A = array 7 8
  B = array 1 2 3 4 5
  Answer = A B median

  Answer equal 4.0
end

test "arguments arrive longest first"
  use "004_medarrs"
  run

  A = array 3 4 5 6 7
  B = array 1 2
  Answer = A B median

  Answer equal 4.0
end

test "empty second array"
  use "004_medarrs"
  run

  A = array 1
  B = array shape 0
  end
  Answer = A B median

  Answer equal 1.0
end

test "duplicate zeroes"
  use "004_medarrs"
  run

  A = array 0 0
  B = array 0 0
  Answer = A B median

  Answer equal 0.0
end
