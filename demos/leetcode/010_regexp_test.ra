use testing

test "single character is not a full match"
  use "010_regexp"

  Answer = "aa" match "a"
  Answer equal false
end

test "star repeats a character"
  use "010_regexp"

  Answer = "aa" match "a*"
  Answer equal true
end

test "dot star matches any text"
  use "010_regexp"

  Answer = "ab" match ".*"
  Answer equal true
end

test "starred elements may be skipped"
  use "010_regexp"

  Answer = "aab" match "c*a*b"
  Answer equal true
end

test "later mismatch rejects the match"
  use "010_regexp"

  Answer = "mississippi" match "mis*is*p*."
  Answer equal false
end

test "suffix must also match"
  use "010_regexp"

  Answer = "ab" match ".*c"
  Answer equal false
end

test "star may match zero characters"
  use "010_regexp"

  Answer = "a" match "ab*"
  Answer equal true
end

test "several stars share the text"
  use "010_regexp"

  Answer = "aaa" match "ab*a*c*a"
  Answer equal true
end

test "star and following literal both consume text"
  use "010_regexp"

  Answer = "aaa" match "a*a"
  Answer equal true
end

test "single dot matches one character"
  use "010_regexp"

  Answer = "z" match "."
  Answer equal true
end

test "wildcards still require enough characters"
  use "010_regexp"

  Answer = "a" match ".*.."
  Answer equal false
end

test "empty text and empty pattern"
  use "010_regexp"

  Answer = "" match ""
  Answer equal true
end

test "starred pattern matches empty text"
  use "010_regexp"

  Answer = "" match "a*b*"
  Answer equal true
end

test "empty pattern rejects nonempty text"
  use "010_regexp"

  Answer = "a" match ""
  Answer equal false
end
