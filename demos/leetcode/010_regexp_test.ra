use testing

test "single character is not a full match"
  use "010_regexp"
  run

  Answer = "aa" "a" match
  Answer equal false
end

test "star repeats a character"
  use "010_regexp"
  run

  Answer = "aa" "a*" match
  Answer equal true
end

test "dot star matches any text"
  use "010_regexp"
  run

  Answer = "ab" ".*" match
  Answer equal true
end

test "starred elements may be skipped"
  use "010_regexp"
  run

  Answer = "aab" "c*a*b" match
  Answer equal true
end

test "later mismatch rejects the match"
  use "010_regexp"
  run

  Answer = "mississippi" "mis*is*p*." match
  Answer equal false
end

test "suffix must also match"
  use "010_regexp"
  run

  Answer = "ab" ".*c" match
  Answer equal false
end

test "star may match zero characters"
  use "010_regexp"
  run

  Answer = "a" "ab*" match
  Answer equal true
end

test "several stars share the text"
  use "010_regexp"
  run

  Answer = "aaa" "ab*a*c*a" match
  Answer equal true
end

test "star and following literal both consume text"
  use "010_regexp"
  run

  Answer = "aaa" "a*a" match
  Answer equal true
end

test "single dot matches one character"
  use "010_regexp"
  run

  Answer = "z" "." match
  Answer equal true
end

test "wildcards still require enough characters"
  use "010_regexp"
  run

  Answer = "a" ".*.." match
  Answer equal false
end

test "empty text and empty pattern"
  use "010_regexp"
  run

  Answer = "" "" match
  Answer equal true
end

test "starred pattern matches empty text"
  use "010_regexp"
  run

  Answer = "" "a*b*" match
  Answer equal true
end

test "empty pattern rejects nonempty text"
  use "010_regexp"
  run

  Answer = "a" "" match
  Answer equal false
end
