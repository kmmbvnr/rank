rem Regular Expression Matching
rem Full match of text against a pattern
rem containing '.' and '*'

use algo
use sequences

rem Build a table where index i j says whether
rem the first i characters match the first j
rem pattern characters.
fun match Text Pattern
  N = Text len
  M = Pattern len

  index 0 0 = true

  rem A starred element can match empty text.
  for PatternSymbol j in Pattern
    if j at least 1 and PatternSymbol equal "*"
      Column = j + 1
      Previous = Column - 2
      Empty = index 0 Previous pad false
      index 0 Column = Empty
    end
  end

  for TextSymbol i in Text
    for PatternSymbol j in Pattern
      Row = i + 1
      Column = j + 1

      if PatternSymbol equal "*"
        Previous = Column - 2
        Repeated = Pattern Previous
        Same = Repeated equal "."

        if Repeated equal TextSymbol
          Same = true
        end

        Zero = index Row Previous pad false
        More = false

        if Same
          More = index i Column pad false
        end

        index Row Column = Zero or More
      else
        Same = PatternSymbol equal "."

        if PatternSymbol equal TextSymbol
          Same = true
        end

        Previous = Column - 1
        Prefix = index i Previous pad false
        index Row Column = Same and Prefix
      end
    end
  end

  return index N M pad false
end
