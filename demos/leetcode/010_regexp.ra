rem Regular Expression Matching
rem Full match of text against a pattern
rem containing '.' and '*'

use algo

rem Build a table where index i j says whether
rem the first i characters match the first j
rem pattern characters.
fun match Text Pattern
  Index = new index
  N = Text len
  M = Pattern len

  Index 0 0 = true

  rem A starred element can match empty text.
  for PatternSymbol j in Pattern
    if j at least 1 and PatternSymbol equal "*"
      Prev = j - 1
      Index 0 (j + 1) = Index 0 Prev default false
    end
  end

  for TextSymbol i in Text
    for PatternSymbol j in Pattern
      Row = i + 1
      Column = j + 1

      if PatternSymbol equal "*"
        Prev = Column - 2
        Repeated = Pattern (j - 1)
        Same = Repeated TextSymbol matches
        Zero = Index Row Prev default false
        Valid = Index i Column default false
        More = Same and Valid
        Index Row Column = Zero or More
      else
        Same = PatternSymbol TextSymbol matches
        Prefix = Index i j default false
        Index Row Column = Same and Prefix
      end
    end
  end

  return Index N M default false
end


fun matches S T
  return S equal "." or S equal T
end
