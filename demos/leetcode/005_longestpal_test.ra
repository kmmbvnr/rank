use testing

test "odd palindrome"
  use "005_longestpal"

  Answer = "babad" longest
  Answer equal "bab"
end

test "even palindrome"
  use "005_longestpal"

  Answer = "cbbd" longest
  Answer equal "bb"
end

test "one character"
  use "005_longestpal"

  Answer = "a" longest
  Answer equal "a"
end

test "first wins equal length"
  use "005_longestpal"

  Answer = "ac" longest
  Answer equal "a"
end

test "empty text"
  use "005_longestpal"

  Answer = "" longest
  Answer equal ""
end

test "long even palindrome"
  use "005_longestpal"

  Answer = "forgeeksskeegfor" longest
  Answer equal "geeksskeeg"
end

test "unicode code points"
  use "005_longestpal"

  Answer = "x😀a😀y" longest
  Answer equal "😀a😀"
end
