rem Add Two Numbers
rem Two numbers as digit lists in reverse
rem order, return their sum the same way

use algo
use sequences

fun add_two A B
  N = A len
  M = B len
  Size = N

  if M greater Size
    Size = M
  end

  Carry = 0
  I = 0

  for I less Size
    X = 0
    Y = 0

    if I less N
      X = A I
    end

    if I less M
      Y = B I
    end

    Sum = X + Y + Carry
    queue push Sum % 10
    Carry = Sum // 10
    I += 1
  end

  if Carry greater 0
    queue push Carry
  end

  return queue
end
