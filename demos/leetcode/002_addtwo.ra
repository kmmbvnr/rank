rem Add Two Numbers
rem Two numbers as digit lists in reverse
rem order, return their sum the same way

fun add_two A B
  Size = (A len) (B len) max
  Carry = 0

  for I in 0 till Size
    X = A I default 0
    Y = B I default 0
    Sum = X + Y + Carry
    yield Sum mod 10
    Carry = Sum // 10
  end

  if Carry greater 0
    yield Carry
  end
end
