rem Zigzag Conversion
rem Write a string in zigzag on N rows,
rem then read it back row by row

use algo

rem Return Text in zigzag row order.
rem Visit vertical and diagonal positions
rem within each repeating zigzag cycle.
fun zigzag Text N
  Queue = new queue
  if N equal 1
    return Text
  end

  Length = Text len
  Cycle = N * 2 - 2

  for Row in 0 till N
    Step = Cycle - Row * 2
    for Position in Row till Length by Cycle
      Queue push Position

      if Row greater 0 and Row less N - 1
        Diag = Position + Step
        if Diag less Length
          Queue push Diag
        end
      end
    end
  end

  return Text Queue
end
