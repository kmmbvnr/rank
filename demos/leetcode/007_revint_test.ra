use testing

test "positive integer"
  use "007_revint"
  run

  Answer = 123 reverse
  Answer equal 321
end

test "negative integer"
  use "007_revint"
  run

  Answer = -123 reverse
  Answer equal -321
end

test "trailing zero"
  use "007_revint"
  run

  Answer = 120 reverse
  Answer equal 21
end

test "zero"
  use "007_revint"
  run

  Answer = 0 reverse
  Answer equal 0
end

test "positive overflow"
  use "007_revint"
  run

  Answer = 1534236469 reverse
  Answer equal 0
end

test "negative overflow"
  use "007_revint"
  run

  Answer = -1563847412 reverse
  Answer equal 0
end

test "largest safe reversal"
  use "007_revint"
  run

  Answer = 1463847412 reverse
  Answer equal 2147483641
end

test "smallest input overflows"
  use "007_revint"
  run

  Answer = -2147483648 reverse
  Answer equal 0
end
