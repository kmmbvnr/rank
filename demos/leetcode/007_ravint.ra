rem Reverse Integer
rem Reverse the digits of a signed integer,
rem return 0 if it leaves 32-bit range

use algo

fun reverse X
  Sign = 1

  if X less 0
    Sign = -1
    X = -X
  end

  Result = 0
  Limit = 2147483647

  if Sign less 0
    Limit = 2147483648
  end

  for X greater 0
    Digit = X % 10
    X = X / 10

    Max = Limit - Digit
    Max = Max / 10

    if Result greater Max
      return 0
    end

    Result = Result * 10 + Digit
  end

  return Result * Sign
end
