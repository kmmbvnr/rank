rem Palindrome Number
rem True if an integer reads the same
rem both ways, without making a string

fun X palindrome
  if X less 0
    return false
  end

  if X mod 10 equal 0 and X not equal 0
    return false
  end

  Back = 0

  for X greater Back
    Back = Back * 10 + X mod 10
    X //= 10
  end

  return X equal Back or X equal Back // 10
end
