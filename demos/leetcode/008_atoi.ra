rem String to Integer (atoi)
rem Skip spaces, take an optional sign and
rem digits, clamp to 32-bit range

use algo

rem Parse the decimal prefix of Text.
rem Accumulate a negative result so the
rem lower 32-bit bound remains representable.
fun atoi Text
  N = Text len
  Position = 0

  for Symbol j in "0123456789"
    index Symbol = j
  end

  for Position less N
    C = Text Position

    if C not equal " "
      break
    end

    Position += 1
  end

  Negative = false

  if Position less N
    C = Text Position

    if C equal "-"
      Negative = true
      Position += 1
    else
      if C equal "+"
        Position += 1
      end
    end
  end

  Limit = -2147483647

  if Negative
    Limit = -2147483648
  end

  Mult = Limit // 10
  Result = 0

  for Position less N
    C = Text Position

    if C in index
      Digit = index C
    else
      break
    end

    if Result less Mult
      return Negative clamp
    end

    Result = Result * 10

    Edge = Limit + Digit

    if Result less Edge
      return Negative clamp
    end

    Result = Result - Digit
    Position += 1
  end

  if Negative
    return Result
  end

  return -Result
end

rem Return the 32-bit bound for Sign.
fun clamp Negative
  if Negative
    return -2147483648
  end

  return 2147483647
end
