use testing

test "equal length"
  use "002_addtwo"
  run

  A = array 2 4 3
  B = array 5 6 4
  Answer = A B add_two

  Answer equal array 7 0 8
end

test "zero"
  use "002_addtwo"
  run

  A = array 0
  B = array 0
  Answer = A B add_two

  Answer equal array 0
end

test "carry and unequal lengths"
  use "002_addtwo"
  run

  A = array 9 9 9 9 9 9 9
  B = array 9 9 9 9
  Answer = A B add_two

  Answer equal array 8 9 9 9 0 0 0 1
end
