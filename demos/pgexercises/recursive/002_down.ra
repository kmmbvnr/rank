rem PostgreSQL Exercises: recursive 2
rem https://pgexercises.com/questions/recursive/getdownward.html

use cli
use sequences
use tables

argument DbPath path = "demos/pgexercises/data/club.sqlite3"
argument OutputPath path = "demos/pgexercises/data/rec_002.csv"

Db = DbPath sqlite
M = Db .members
E = M select
  .member = .memid
  .recommender = .recommendedby
end
Names = M select
  .member = .memid
  .firstname = .firstname
  .surname = .surname
end
R = E 1 reach by .recommender .member
R = R Names innerjoin by .member
Result = R select
  .memid = .member
  .firstname = .firstname
  .surname = .surname
end
Result = Result sort by .memid
Result OutputPath csv
