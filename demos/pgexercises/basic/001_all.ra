rem PostgreSQL Exercises: basic 1
rem https://pgexercises.com/questions/basic/selectall.html
rem Retrieve every facility and all six columns.

use cli
use tables

arg DbPath path = "demos/pgexercises/data/club.sqlite3"
arg OutputPath path = "demos/pgexercises/data/001_all.csv"

Db = DbPath sqlite
Result' = Db .facilities
Result csv OutputPath
