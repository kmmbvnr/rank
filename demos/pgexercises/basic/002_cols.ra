rem PostgreSQL Exercises: basic 2
rem https://pgexercises.com/questions/basic/selectspecific.html

use cli
use tables

arg DbPath path = "demos/pgexercises/data/club.sqlite3"
arg OutputPath path = "demos/pgexercises/data/002_cols.csv"

Db = DbPath sqlite
R' = Db .facilities
Result' = R select .name .membercost
Result csv OutputPath
