rem PostgreSQL Exercises: basic 7
rem https://pgexercises.com/questions/basic/classify.html

use cli
use sequences
use tables

argument DbPath path = "demos/pgexercises/data/club.sqlite3"
argument OutputPath path = "demos/pgexercises/data/007_classify.csv"

Db = DbPath sqlite
Rows = (Db .facilities) array
Cost = array shape (Rows len) pad "cheap"
Cost (Rows .monthlymaintenance greater 100) = "expensive"
Rows .cost = Cost
Result = Rows (array .name .cost)
Result OutputPath csv
