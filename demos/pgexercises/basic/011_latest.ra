rem PostgreSQL Exercises: basic 11
rem https://pgexercises.com/questions/basic/agg.html

use cli
use sequences
use tables

arg DbPath path = "demos/pgexercises/data/club.sqlite3"
arg OutputPath path = "demos/pgexercises/data/011_latest.csv"

Db = DbPath sqlite
Rows = (Db .members) array
Dates = (Rows .joindate) sort
Latest = Dates last
First = Rows (0 till 1)
Result = First select
  .latest = Latest
end
Result csv OutputPath
