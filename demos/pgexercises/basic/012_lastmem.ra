rem PostgreSQL Exercises: basic 12
rem https://pgexercises.com/questions/basic/agg2.html

use cli
use sequences
use tables

argument DbPath path = "demos/pgexercises/data/club.sqlite3"
argument OutputPath path = "demos/pgexercises/data/012_lastmem.csv"

Db = DbPath sqlite
Rows = (Db .members) array
Dates = (Rows .joindate) sort
Latest = Dates (Dates len - 1)
R = Rows filter .joindate equal Latest
Result = R select
  .firstname = .firstname
  .surname = .surname
  .joindate = .joindate
end
Result OutputPath csv
