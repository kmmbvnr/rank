rem PostgreSQL Exercises: basic 9
rem https://pgexercises.com/questions/basic/unique.html

use cli
use sequences
use tables

argument DbPath path = "demos/pgexercises/data/club.sqlite3"
argument OutputPath path = "demos/pgexercises/data/009_unique.csv"

Db = DbPath sqlite
R = Db .members select .surname
R = R unique
R = R sort by .surname
Rows = R array
Result = Rows from 0 until 10
Result OutputPath csv
