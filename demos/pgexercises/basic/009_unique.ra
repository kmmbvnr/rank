rem PostgreSQL Exercises: basic 9
rem https://pgexercises.com/questions/basic/unique.html

use cli
use sequences
use tables

arg DbPath path = "demos/pgexercises/data/club.sqlite3"
arg OutputPath path = "demos/pgexercises/data/009_unique.csv"

Db = DbPath sqlite
R' = Db .members select .surname
R' = R unique
R' = R sort by .surname
Rows = R array
Result = Rows (0 till 10)
Result csv OutputPath
