rem PostgreSQL Exercises: basic 10
rem https://pgexercises.com/questions/basic/union.html

use cli
use algo
use sequences
use tables

argument DbPath path = "demos/pgexercises/data/club.sqlite3"
argument OutputPath path = "demos/pgexercises/data/010_union.csv"

Db = DbPath sqlite
M = Db .members select .surname
F = Db .facilities select
  .surname = .name
end
All = new queue
for Row in M array
  All push Row
end
for Row in F array
  All push Row
end
Rows = All (array (All len)) reshape
Rows = Rows select .surname
Result = Rows unique
Result OutputPath csv
