rem PostgreSQL Exercises: basic 8
rem https://pgexercises.com/questions/basic/date.html

use cli
use dates
use tables

argument DbPath path = "demos/pgexercises/data/club.sqlite3"
argument OutputPath path = "demos/pgexercises/data/008_dates.csv"

Db = DbPath sqlite
Rows = (Db .members) array
Joined = Rows .joindate datetime
Start = "2012-09-01 00:00:00" datetime
Mask = (Joined greater Start) or (Joined equal Start)
Selected = (Rows Mask) array
Result = Selected (array .memid .surname .firstname .joindate)
Result OutputPath csv
