rem PostgreSQL Exercises: basic 8
rem https://pgexercises.com/questions/basic/date.html

use cli
use tables

argument DbPath path = "demos/pgexercises/data/club.sqlite3"
argument OutputPath path = "demos/pgexercises/data/008_dates.csv"

Db = DbPath sqlite
R = Db .members
R = R filter .joindate at least "2012-09-01"
Result = R select
  .memid = .memid
  .surname = .surname
  .firstname = .firstname
  .joindate = .joindate
end
Result OutputPath csv
