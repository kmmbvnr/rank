rem PostgreSQL Exercises: basic 7
rem https://pgexercises.com/questions/basic/classify.html

use cli
use sequences
use tables

argument DbPath path = "demos/pgexercises/data/club.sqlite3"
argument OutputPath path = "demos/pgexercises/data/007_case.csv"

Db = DbPath sqlite
R = Db .facilities
Result = R select
  High = .monthlymaintenance greater 100
  .name = .name
  .cost = High "expensive" "cheap" choose
end
Result OutputPath csv
