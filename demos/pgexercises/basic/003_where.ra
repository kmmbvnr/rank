rem PostgreSQL Exercises: basic 3
rem https://pgexercises.com/questions/basic/where.html

use cli
use tables

argument DbPath path = "demos/pgexercises/data/club.sqlite3"
argument OutputPath path = "demos/pgexercises/data/003_where.csv"

Db = DbPath sqlite
R = Db .facilities
Result = R filter .membercost greater 0
Result OutputPath csv
