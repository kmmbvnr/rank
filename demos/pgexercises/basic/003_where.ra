rem PostgreSQL Exercises: basic 3
rem https://pgexercises.com/questions/basic/where.html

use cli
use tables

arg DbPath path = "demos/pgexercises/data/club.sqlite3"
arg OutputPath path = "demos/pgexercises/data/003_where.csv"

Db = DbPath sqlite
R' = Db .facilities
Result' = R filter .membercost greater 0
Result csv OutputPath
