rem PostgreSQL Exercises: basic 3
rem https://pgexercises.com/questions/basic/where.html

use cli
use tables

argument DbPath path = "demos/pgexercises/data/club.sqlite3"
argument OutputPath path = "demos/pgexercises/data/003_where.csv"

Db = DbPath sqlite
Rows = (Db .facilities) array
Result = (Rows (Rows .membercost greater 0)) array
Result OutputPath csv
