rem PostgreSQL Exercises: basic 2
rem https://pgexercises.com/questions/basic/selectspecific.html

use cli
use tables

argument DbPath path = "demos/pgexercises/data/club.sqlite3"
argument OutputPath path = "demos/pgexercises/data/002_select_specific.csv"

Db = DbPath sqlite
R = Db .facilities
Result = R select .name .membercost
Result OutputPath csv
