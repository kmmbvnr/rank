rem PostgreSQL Exercises: aggregates 11
rem https://pgexercises.com/questions/aggregates/fachours2.html

use cli
use sequences
use tables

argument DbPath path = "demos/pgexercises/data/club.sqlite3"
argument OutputPath path = "demos/pgexercises/data/agg_011.csv"

Db = DbPath sqlite
R = Db .bookings
G = R group by .facid
R = G select
  .slots = .slots sum
end
R = R sort by .slots descending
Result = R from 0 until 1
Result OutputPath csv
