rem PostgreSQL Exercises: aggregates 15
rem https://pgexercises.com/questions/aggregates/countmembers.html

use cli
use sequences
use tables

argument DbPath path = "demos/pgexercises/data/club.sqlite3"
argument OutputPath path = "demos/pgexercises/data/agg_015.csv"

Db = DbPath sqlite
M = Db .members
Total = M len
R = M select
  .count = Total
  .firstname = .firstname
  .surname = .surname
  .joindate = .joindate
end
R = R sort by .joindate
Result = R select .count .firstname .surname
Result OutputPath csv
