rem PostgreSQL Exercises: aggregates 2
rem https://pgexercises.com/questions/aggregates/count2.html

use cli
use io
use tables

argument DbPath path = "demos/pgexercises/data/club.sqlite3"

Db = DbPath sqlite
F = Db .facilities
Costly = F filter .guestcost at least 10
Count = Costly len
Count print
