rem PostgreSQL Exercises: joins 4
rem https://pgexercises.com/questions/joins/self2.html

use cli
use sequences
use tables

argument DbPath path = "demos/pgexercises/data/club.sqlite3"
argument OutputPath path = "demos/pgexercises/data/joins_004.csv"

Db = DbPath sqlite
M = Db .members alias .m
R = Db .members alias .r
J = M R leftjoin on
  .recommendedby equal .memid
Rows = J array
Rows .memfname = Rows .m .firstname
Rows .memsname = Rows .m .surname
RF = Rows .r .firstname pad ""
RS = Rows .r .surname pad ""
Rows .recfname = RF
Rows .recsname = RS
Last = Rows .memsname
First = Rows .memfname
Names = Last + " " + First
Ordered = Rows (Names argsort)
Cols = array shape 4
  .memfname .memsname
  .recfname .recsname
end
Result = Ordered Cols
Result OutputPath csv
