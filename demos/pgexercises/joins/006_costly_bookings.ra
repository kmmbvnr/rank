rem PostgreSQL Exercises: joins 6, without subqueries
rem https://pgexercises.com/questions/joins/threejoin2.html

use cli
use ranges
use sequences
use tables

argument DbPath path = "demos/pgexercises/data/club.sqlite3"
argument OutputPath path = "demos/pgexercises/data/joins_006.csv"

Db = DbPath sqlite
NoParams = array shape 0 pad 0
BookingsQuery = Db "SELECT facid, memid, starttime, slots FROM bookings" NoParams sqlquery
MembersQuery = Db "SELECT memid, firstname, surname FROM members" NoParams sqlquery
FacilitiesQuery = Db "SELECT facid, name AS facility, membercost, guestcost FROM facilities" NoParams sqlquery
Bookings = BookingsQuery array
Members = MembersQuery array
Facilities = FacilitiesQuery array
WithMembers = Bookings Members innerjoin by .memid
Joined = WithMembers Facilities innerjoin by .facid
Day = (Joined .starttime greater "2012-09-14") and (Joined .starttime less "2012-09-15")
Rows = (Joined Day) array
Cost = array shape (Rows len) pad 0.0
for I in 0 until Rows len
  if ((Rows .memid) I) equal 0
    Cost I = ((Rows .slots) I) * ((Rows .guestcost) I)
  else
    Cost I = ((Rows .slots) I) * ((Rows .membercost) I)
  end
end
Rows .cost = Cost
Rows .member = Rows .firstname + " " + Rows .surname
Costly = (Rows (Rows .cost greater 30)) array
Ordered = Costly ((0 - Costly .cost) argsort)
Result = Ordered (array .member .facility .cost)
Result OutputPath csv
