rem PostgreSQL Exercises: joins 6, without subqueries
rem https://pgexercises.com/questions/joins/threejoin2.html

use cli
use sequences
use tables

argument DbPath path = "demos/pgexercises/data/club.sqlite3"
argument OutputPath path = "demos/pgexercises/data/joins_006.csv"

Db = DbPath sqlite
R = Db .bookings
M = Db .members
F = Db .facilities
R = R M innerjoin by .memid
R = R F innerjoin by .facid
R = R filter
  .starttime at least "2012-09-14"
  .starttime less "2012-09-15"
end
R = R select
  Guest = .memid equal 0
  GCost = .slots * .guestcost
  MCost = .slots * .membercost
  .member = .firstname + " " + .surname
  .facility = .name
  .cost = Guest GCost MCost choose
end
R = R filter .cost greater 30
Result = R sort by .cost descending
Result OutputPath csv
