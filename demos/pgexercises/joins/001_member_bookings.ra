rem PostgreSQL Exercises: joins 1
rem https://pgexercises.com/questions/joins/simplejoin.html

use cli
use tables

argument DbPath path = "demos/pgexercises/data/club.sqlite3"
argument OutputPath path = "demos/pgexercises/data/joins_001.csv"

Db = DbPath sqlite
Bookings = (Db .bookings) (array .memid .starttime)
Members = (Db .members) (array .memid .firstname .surname)
Joined = Bookings Members innerjoin by .memid
David = (Joined .firstname equal "David") and (Joined .surname equal "Farrell")
Result = (Joined David) (array .starttime)
Result OutputPath csv
