rem PostgreSQL Exercises: joins 1
rem https://pgexercises.com/questions/joins/simplejoin.html

use cli
use tables

arg DbPath path = "demos/pgexercises/data/club.sqlite3"
arg OutputPath path = "demos/pgexercises/data/joins_001.csv"

Db = DbPath sqlite
B' = Db .bookings
M' = Db .members
R' = B M innerjoin by .memid
R' = R filter
  .firstname equal "David"
  .surname equal "Farrell"
end
Result' = R select .starttime
Result csv OutputPath
