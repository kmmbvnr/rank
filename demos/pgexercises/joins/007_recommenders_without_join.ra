rem PostgreSQL Exercises: joins 7, without joins
rem https://pgexercises.com/questions/joins/sub.html

use cli
use sequences
use tables

argument DbPath path = "demos/pgexercises/data/club.sqlite3"
argument OutputPath path = "demos/pgexercises/data/joins_007.csv"

Db = DbPath sqlite
Members = Db .members
Ids = Members .recommendedby
Keys = Members .memid
First = Members .firstname + " "
Names = First + Members .surname
Rec = Ids Keys Names lookup
Cols = record
  .member = Names
  .recommender = Rec
end
Pairs = Members Cols select
Result = (Pairs unique) sort by .member
Result OutputPath csv
