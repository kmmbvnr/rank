rem PostgreSQL Exercises: joins 5
rem https://pgexercises.com/questions/joins/threejoin.html

use cli
use sequences
use tables

argument DbPath path = "demos/pgexercises/data/club.sqlite3"
argument OutputPath path = "demos/pgexercises/data/joins_005.csv"

Db = DbPath sqlite
Bookings = Db .bookings
Members = Db .members
Facilities = Db .facilities
WithMembers = Bookings Members innerjoin by .memid
Joined = WithMembers Facilities innerjoin by .facid
Court = (Joined .name equal "Tennis Court 1") or (Joined .name equal "Tennis Court 2")
Filtered = Joined Court
First = Filtered .firstname + " "
Name = First + Filtered .surname
Cols = record
  .member = Name
  .facility = Filtered .name
end
Pairs = Filtered Cols select
Result = (Pairs unique) sort by .member .facility
Result OutputPath csv
