rem PostgreSQL Exercises: joins 3
rem https://pgexercises.com/questions/joins/self.html

use cli
use sequences
use tables

argument DbPath path = "demos/pgexercises/data/club.sqlite3"
argument OutputPath path = "demos/pgexercises/data/joins_003.csv"

Db = DbPath sqlite
M = Db .members select .recommendedby
R = Db .members
R = R select .memid .firstname .surname
J = M R innerjoin on
  .recommendedby equal .memid
R = J select .firstname .surname
R = R unique
Result = R sort by .surname .firstname
Result OutputPath csv
