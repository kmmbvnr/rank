rem PostgreSQL Exercises: joins 3
rem https://pgexercises.com/questions/joins/self.html

use cli
use sequences
use tables

argument DbPath path = "demos/pgexercises/data/club.sqlite3"
argument OutputPath path = "demos/pgexercises/data/joins_003.csv"

Db = DbPath sqlite
Refs = (Db .members) (array .recommendedby)
Recs = (Db .members) (array .memid .firstname .surname)
Matched = Refs Recs innerjoin on
  .recommendedby equal .memid
Names = Matched (array .firstname .surname)
Ordered = (Names unique) sort by .surname .firstname
Result = Ordered
Result OutputPath csv
