rem PostgreSQL Exercises: joins 3
rem https://pgexercises.com/questions/joins/self.html

use cli
use algo
use sequences
use tables

argument DbPath path = "demos/pgexercises/data/club.sqlite3"
argument OutputPath path = "demos/pgexercises/data/joins_003.csv"

Db = DbPath sqlite
NoParams = array shape 0 pad 0
RefsQuery = Db "SELECT recommendedby FROM members" NoParams sqlquery
RecsQuery = Db "SELECT memid AS recommendedby, firstname, surname FROM members" NoParams sqlquery
Refs = RefsQuery array
Recs = RecsQuery array
Matched = Refs Recs innerjoin by .recommendedby
Names = Matched .surname + "|" + Matched .firstname
UniqueNames = Names unique
Distinct = new queue
for Name in UniqueNames
  Matches = (Matched (Names equal Name)) array
  Distinct push (Matches 0)
end
DistinctRows = Distinct (array (Distinct len)) reshape
Keys = DistinctRows .surname + "|" + DistinctRows .firstname
Ordered = DistinctRows (Keys argsort)
Result = Ordered (array .firstname .surname)
Result OutputPath csv
