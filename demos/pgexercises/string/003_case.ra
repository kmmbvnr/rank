rem PostgreSQL Exercises: string 3
rem https://pgexercises.com/questions/string/case.html

use cli
use tables
use text

arg DbPath path = "demos/pgexercises/data/club.sqlite3"
arg OutputPath path = "demos/pgexercises/data/string_003.csv"

Db = DbPath sqlite
F' = Db .facilities
Names' = F .name lower
Mask' = Names startswith "tennis"
Result' = F filter Mask
Result csv OutputPath
