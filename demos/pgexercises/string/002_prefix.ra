rem PostgreSQL Exercises: string 2
rem https://pgexercises.com/questions/string/like.html

use cli
use tables
use text

arg DbPath path = "demos/pgexercises/data/club.sqlite3"
arg OutputPath path = "demos/pgexercises/data/string_002.csv"

Db = DbPath sqlite
F' = Db .facilities
Names' = F .name
Mask' = Names startswith "Tennis"
Result' = F filter Mask
Result csv OutputPath
