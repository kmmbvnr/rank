rem PostgreSQL Exercises: string 5
rem https://pgexercises.com/questions/string/default.html

use cli
use sequences
use tables
use text

arg DbPath path = "demos/pgexercises/data/club.sqlite3"
arg OutputPath path = "demos/pgexercises/data/string_005.csv"

Db = DbPath sqlite
M' = Db .members
Codes' = M .zipcode text rank 0
Padded' = Codes 5 "0" lpad
Result' = M select
  .zip = Padded
end
Result' = Result sort by .zip
Result csv OutputPath
