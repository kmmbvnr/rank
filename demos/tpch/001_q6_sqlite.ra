rem TPC-H Q6: forecast revenue change using a lazy SQLite view
rem https://www.tpc.org/tpc_documents_current_versions/pdf/tpc-h_v3.0.1.pdf

use cli
use io
use tables

argument DbPath path = "demos/tpch/data/tpch.sqlite3"

Db = DbPath sqlite
Lineitem = Db .lineitem
YearAfter = Lineitem .l_shipdate at least "1994-01-01"
YearBefore = Lineitem .l_shipdate less "1995-01-01"
YearRows = Lineitem (YearAfter and YearBefore)

DiscountLow = YearRows .l_discount at least 0.05
DiscountHigh = YearRows .l_discount at most 0.07
Discounted = YearRows (DiscountLow and DiscountHigh)

Limited = Discounted (Discounted .l_quantity less 24)
Price = Limited .l_extendedprice * Limited .l_discount
Revenue = Price sum
Revenue print
