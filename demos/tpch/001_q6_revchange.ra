rem TPC-H Q6
rem Forecasting Revenue Change
rem Source: TPC-H 3.0.1, section 2.4.6
rem Date: 1994-01-01
rem Discount: 0.06
rem Quantity: 24

use tables
use dates

Lineitem = csv "lineitem.csv"

Year = 1994
Discount = 0.06
Quantity = 24

Mask =
    Lineitem .l_shipdate year
    equal Year

filter Lineitem Mask

Mask =
    Lineitem .l_discount
    at least Discount - 0.01

filter Lineitem Mask

Mask =
    Lineitem .l_discount
    at most Discount + 0.01

filter Lineitem Mask

Mask =
    Lineitem .l_quantity
    less Quantity

filter Lineitem Mask

Increase =
    Lineitem .l_extendedprice *
    Lineitem .l_discount

Revenue = sum Increase

print Revenue