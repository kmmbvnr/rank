rem AtCoder Beginners Selection: Shift Only
rem https://atcoder.jp/contests/abc081/tasks/abc081_b

use io

N = stdin .integer
A = stdin .integer N array

A shifts print


rem Count the shared factors of two across every value.
fun A' shifts
  return (A trailing_twos rank 0) min
end


rem Count trailing factors of two in a positive integer.
fun V trailing_twos
  Count = 0

  for V mod 2 equal 0
    V //= 2
    Count += 1
  end

  return Count
end
