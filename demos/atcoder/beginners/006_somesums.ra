rem AtCoder Beginners Selection: Some Sums
rem https://atcoder.jp/contests/abc083/tasks/abc083_b

use io

N = stdin .integer
A = stdin .integer
B = stdin .integer

N A B some_sums print


fun digit_sum X
  return X text integer rank 0 sum
end

rem Sum every value in 1..N whose digit sum falls in a range.
fun some_sums N A B
  Values = (1 to N) array
  Sums = Values digit_sum rank 0
  Mask = Sums at least A
  Mask = Mask and (Sums at most B)
  return (Values Mask) sum
end
