rem AtCoder Educational DP Contest: Frog 2
rem https://atcoder.jp/contests/dp/tasks/dp_b

use io
use numbers
use sequences

N = stdin .integer
K = stdin .integer
H = stdin .integer N array

H min_cost K print


rem Cheapest way to hop from stone 1 to stone N, up to K stones at a time.
fun H min_cost K
  N = H len
  Cost = array shape N fill 0

  for I in 1 to N - 1
    Lo = 0 max (I - K)
    Diff = H I - H Lo
    Best = Cost Lo + (Diff abs)

    for J in (Lo + 1) till I
      Diff = H I - H J
      Step = Cost J + (Diff abs)
      Best = Best min Step
    end

    Cost I = Best
  end

  return Cost last
end
