use testing

test "single plate always takes exactly its piece count"
  use "10_sushi"
  Plates = array 3
  1 expected_turns Plates equal 3.0
end

test "official-style example with mixed plates"
  use "10_sushi"
  Plates = array 1 2
  2 expected_turns Plates equal 4.5
end

test "three plates of three pieces each"
  use "10_sushi"
  use numbers
  Plates = array 3 3 3
  Actual = 3 expected_turns Plates
  Rounded = Actual round 6
  Rounded equal 13.486883
end

test "three plates of one piece each"
  use "10_sushi"
  Plates = array 1 1 1
  3 expected_turns Plates equal 5.5
end
