rem AtCoder Educational DP Contest: Longest Common Subsequence
rem https://atcoder.jp/contests/dp/tasks/dp_f

use io
use sequences

S = stdin .word
T = stdin .word

S T longest_common print


rem Build lengths, then trace one longest common subsequence.
fun longest_common S T
  N = S len
  M = T len
  Rows = N + 1
  Lengths = array shape Rows (M + 1) fill 0

  for i in 1 to N
    Up = i - 1
    Letter = S Up

    for j in 1 to M
      Back = j - 1
      if Letter equal T Back
        Lengths i j = (Lengths Up Back) + 1
      else
        Above = Lengths Up j
        Left = Lengths i Back
        Lengths i j = Above Left max
      end
    end
  end

  Result = ""
  Row = N
  Col = M

  for Row greater 0 and Col greater 0
    RowBack = Row - 1
    ColBack = Col - 1
    Letter = S RowBack
    Above = Lengths RowBack Col
    Left = Lengths Row ColBack

    if Letter equal T ColBack
      Result = Letter + Result
      Row = RowBack
      Col = ColBack
    elif Above greater Left
      Row = RowBack
    else
      Col = ColBack
    end
  end

  return Result
end
