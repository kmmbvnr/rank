rem AtCoder Educational DP Contest: Longest Common Subsequence
rem https://atcoder.jp/contests/dp/tasks/dp_f

use io
use sequences

S = stdin .word
T = stdin .word

S T longest_common print


rem Build lengths, then trace one longest common subsequence.
fun longest_common S T
  N = S len
  M = T len
  Rows = N + 1
  Cols = M + 1
  Lengths = array shape Rows Cols fill 0

  for i in 1 to N
    Letter = S (i - 1)
    Up = i - 1

    for j in 1 to M
      Back = j - 1
      if Letter equal T Back
        Prior = Lengths Up Back
        Lengths i j = Prior + 1
      else
        Above = Lengths Up j
        Left = Lengths i Back
        Lengths i j = Above Left max
      end
    end
  end

  Result = ""
  Row = N
  Column = M

  for Row greater 0 and Column greater 0
    RowBack = Row - 1
    ColumnBack = Column - 1
    Letter = S RowBack
    Above = Lengths RowBack Column
    Left = Lengths Row ColumnBack

    if Letter equal T ColumnBack
      Result = Letter + Result
      Row = RowBack
      Column = ColumnBack
    elif Above greater Left
      Row = RowBack
    else
      Column = ColumnBack
    end
  end

  return Result
end
