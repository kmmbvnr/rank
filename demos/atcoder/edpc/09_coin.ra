rem AtCoder Educational DP Contest: Coin
rem https://atcoder.jp/contests/dp/tasks/dp_i

use io
use sequences

N = stdin .integer
P = array shape N fill 0.0

for I in 0 to N - 1
  P I = stdin .word real
end

P more_than_half print


rem Probability of strictly more than half heads across N biased coins.
fun more_than_half P
  N = P len
  Size = N + 1
  Dp = array shape Size fill 0.0
  Dp 0 = 1.0

  for Prob I in P
    Miss = 1.0 - Prob
    Next = array shape Size fill 0.0

    for J in 0 to I
      Current = Dp J
      if Current at most 0.0
        continue
      end

      Next (J + 1) += Current * Prob
      Next J += Current * Miss
    end

    Dp = Next
  end

  Start = N // 2 + 1
  return (Dp (Start to N)) sum
end
