rem AtCoder Educational DP Contest: Coin
rem https://atcoder.jp/contests/dp/tasks/dp_i

use io
use sequences

N = stdin .integer
P = array shape N pad 0.0

for I in 0 to N - 1
  Word = stdin .word
  P I = Word real
end

P more_than_half print


rem Probability of strictly more than half heads across N biased coins.
fun more_than_half P
  N = P len
  Size = N + 1
  Dp = array shape Size pad 0.0
  Dp 0 = 1.0

  for I in 0 to N - 1
    Prob = P I
    Miss = 1.0 - Prob
    Next = array shape Size pad 0.0

    for J in 0 to I
      Current = Dp J
      Landed = Current greater 0.0

      if Landed
        Heads = J + 1
        Gain = Current * Prob
        Stay = Current * Miss
        Next Heads += Gain
        Next J += Stay
      end
    end

    Dp = Next
  end

  Threshold = N // 2
  Start = Threshold + 1
  Total = 0.0

  for J in Start to N
    Share = Dp J
    Total += Share
  end

  return Total
end
