use testing

test "two items fill the capacity exactly"
  use "05_knapsack2"
  Weights = array 3 4 2
  Values = array 30 50 60
  6 Weights Values max_value equal 110
end

test "small items beat one big item"
  use "05_knapsack2"
  Weights = array 6 4 2 5 1
  Values = array 9 10 3 5 1
  9 Weights Values max_value equal 15
end

test "capacity far larger than needed"
  use "05_knapsack2"
  Weights = array 5 5
  Values = array 10 10
  Capacity = 1000000000
  Capacity Weights Values max_value equal 20
end
