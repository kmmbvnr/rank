use testing

test "official example 1"
  use "02_frog2"
  Values = array 10 30 40 50 20
  Values min_cost 3 equal 30
end

test "official example 2 forces single steps"
  use "02_frog2"
  Values = array 10 20 10
  Values min_cost 1 equal 20
end

test "official example 3 allows one big jump"
  use "02_frog2"
  Values = array 10 10
  Values min_cost 100 equal 0
end
