rem AtCoder Educational DP Contest: Grid 1
rem https://atcoder.jp/contests/dp/tasks/dp_h

use io
use sequences

H = stdin .integer
W = stdin .integer
Grid = stdin .word H array

Grid path_count print


rem Count right/down paths from the top-left to the bottom-right, skipping
rem walls, modulo 1e9+7.
fun path_count Grid
  H = Grid len
  W = (Grid 0) len
  Ways = array shape H W fill 0

  for Row R in Grid
    for Cell C in Row
      if Cell equal "#"
        continue
      end

      if R equal 0 and C equal 0
        Ways 0 0 = 1
        continue
      end

      Total = 0
      if R greater 0
        Total += Ways (R - 1) C
      end
      if C greater 0
        Total += Ways R (C - 1)
      end
      Ways R C = Total mod 1000000007
    end
  end

  R = H - 1
  return Ways R (W - 1)
end
