rem AtCoder Educational DP Contest: Frog 1
rem https://atcoder.jp/contests/dp/tasks/dp_a

use io
use numbers
use sequences

N = stdin .integer
H = stdin .integer N array

H min_cost print


rem Cheapest way to hop from stone 1 to stone N, one or two steps at a time.
fun min_cost H
  N = H len
  Cost = array shape N fill 0

  for I in 1 to N - 1
    Diff = H I - H (I - 1)
    Diff = Diff abs
    Best = Cost (I - 1) + Diff

    if I greater 1
      Diff = H I - H (I - 2)
      Diff = Diff abs
      Step = Cost (I - 2) + Diff
      Best = Best Step min
    end

    Cost I = Best
  end

  return Cost (N - 1)
end
