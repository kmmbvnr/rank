rem AtCoder Educational DP Contest: Frog 1
rem https://atcoder.jp/contests/dp/tasks/dp_a

use io
use numbers
use sequences

N = stdin .integer
H = stdin .integer N array

H min_cost print


rem Cheapest way to hop from stone 1 to stone N, one or two steps at a time.
fun H min_cost
  N = H len
  Cost = array shape N fill 0

  Prev' = H shift 1
  Prev2' = H shift 2
  One = (H - Prev) abs
  Two = (H - Prev2) abs

  for I in 1 to N - 1
    Hop = One I
    Best = Cost (I - 1) + Hop

    if I greater 1
      Jump = Two I
      Step = Cost (I - 2) + Jump
      Best = Best min Step
    end

    Cost I = Best
  end

  return Cost last
end
