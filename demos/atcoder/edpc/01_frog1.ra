rem AtCoder Educational DP Contest: Frog 1
rem https://atcoder.jp/contests/dp/tasks/dp_a

use io
use numbers
use sequences

N = stdin .integer
H = stdin .integer N array

H min_cost print


rem Cheapest way to hop from stone 1 to stone N, one or two steps at a time.
fun min_cost H
  N = H len
  Cost = array shape N fill 0

  for I in 1 to N - 1
    Diff1 = H I - H (I - 1)
    Best = Cost (I - 1) + (Diff1 abs)

    if I greater 1
      Diff2 = H I - H (I - 2)
      Step2 = Cost (I - 2) + (Diff2 abs)
      Best = Best Step2 min
    end

    Cost I = Best
  end

  return Cost (N - 1)
end
