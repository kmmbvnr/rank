use testing

test "official example 1"
  use "07_longestpath"
  use graph
  Nodes = 1 to 4
  Graph = new graph Nodes .directed
  Edges = array shape 5 2
    1 2
    1 3
    3 2
    2 4
    3 4
  end
  Graph add Edges
  Graph 4 longest_path equal 3
end

test "official example 2 skips an isolated vertex"
  use "07_longestpath"
  use graph
  Nodes = 1 to 6
  Graph = new graph Nodes .directed
  Edges = array shape 3 2
    2 3
    4 5
    5 6
  end
  Graph add Edges
  Graph 6 longest_path equal 2
end

test "single edge"
  use "07_longestpath"
  use graph
  Nodes = 1 to 2
  Graph = new graph Nodes .directed
  Graph add 1 2
  Graph 2 longest_path equal 1
end
