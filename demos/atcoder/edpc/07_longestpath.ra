rem AtCoder Educational DP Contest: Longest Path
rem https://atcoder.jp/contests/dp/tasks/dp_g

use graph
use io
use sequences

N = stdin .integer
M = stdin .integer
Values = stdin .integer (M * 2) array
Edges = Values (array M 2) reshape
Nodes = 1 to N
Graph = new graph Nodes .directed
Graph add Edges

Graph N longest_path print


rem Longest path length, counted in edges, through a DAG.
fun longest_path Graph N
  Dist = array shape (N + 1) fill 1
  Sorted = Graph topological

  for Cur in Sorted .order
    Cand = Dist Cur + 1
    for Next in Graph Cur
      Dist Next = (Dist Next) Cand max
    end
  end

  return Dist max - 1
end
