rem AtCoder Educational DP Contest: Knapsack 1
rem https://atcoder.jp/contests/dp/tasks/dp_d

use io
use sequences

N = stdin .integer
W = stdin .integer
Weights = array shape N fill 0
Values = array shape N fill 0

for I in 0 to N - 1
  Weights I = stdin .integer
  Values I = stdin .integer
end

W Weights Values max_value print


rem Visit capacities backwards so every item is used at most once.
fun max_value W Weights Values
  Best = array shape (W + 1) fill 0

  for Wt i in Weights
    if Wt greater W
      continue
    end

    Val = Values i
    for Cap in W to Wt by -1
      Gain = Best (Cap - Wt) + Val
      Best Cap = (Best Cap) Gain max
    end
  end

  return Best W
end
