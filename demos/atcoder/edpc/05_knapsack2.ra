rem AtCoder Educational DP Contest: Knapsack 2
rem https://atcoder.jp/contests/dp/tasks/dp_e

use io
use sequences

N = stdin .integer
W = stdin .integer
Weights = array shape N fill 0
Values = array shape N fill 0

for I in 0 to N - 1
  Weights I = stdin .integer
  Values I = stdin .integer
end

W Weights Values max_value print


rem Track the minimum weight for each achievable total value instead of the
rem other way around, since the capacity can be far larger than the value sum.
fun max_value W Weights Values
  TotalValue = Values sum
  Inf = 1000000000000000000
  Size = TotalValue + 1
  MinW = array shape Size fill Inf
  MinW 0 = 0

  for Weight i in Weights
    Val = Values i
    for V in TotalValue to Val by -1
      Next = MinW (V - Val) + Weight
      MinW V = (MinW V) Next min
    end
  end

  for V in TotalValue to 0 by -1
    if MinW V at most W
      return V
    end
  end

  return 0
end
