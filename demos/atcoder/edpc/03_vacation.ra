rem AtCoder Educational DP Contest: Vacation
rem https://atcoder.jp/contests/dp/tasks/dp_c

use io
use sequences

N = stdin .integer
A = array shape N fill 0
B = array shape N fill 0
C = array shape N fill 0

for I in 0 to N - 1
  A I = stdin .integer
  B I = stdin .integer
  C I = stdin .integer
end

A B C best_score print


rem Maximum points over N days without repeating yesterday's activity.
fun best_score A B C
  PrevA = 0
  PrevB = 0
  PrevC = 0

  for I in 0 till (A len)
    NextA = A I + (PrevB PrevC max)
    NextB = B I + (PrevA PrevC max)
    NextC = C I + (PrevA PrevB max)
    PrevA = NextA
    PrevB = NextB
    PrevC = NextC
  end

  return PrevA PrevB max PrevC max
end
