rem AtCoder Educational DP Contest: Vacation
rem https://atcoder.jp/contests/dp/tasks/dp_c

use io
use sequences

N = stdin .integer
A = array shape N pad 0
B = array shape N pad 0
C = array shape N pad 0

for I in 0 to N - 1
  A I = stdin .integer
  B I = stdin .integer
  C I = stdin .integer
end

A B C best_score print


rem Maximum points over N days without repeating yesterday's activity.
fun best_score A B C
  N = A len
  PrevA = 0
  PrevB = 0
  PrevC = 0

  for I in 0 to N - 1
    Ai = A I
    Bi = B I
    Ci = C I
    RestB = PrevB max PrevC
    RestA = PrevA max PrevC
    RestC = PrevA max PrevB
    NextA = Ai + RestB
    NextB = Bi + RestA
    NextC = Ci + RestC
    PrevA = NextA
    PrevB = NextB
    PrevC = NextC
  end

  Best = PrevA max PrevB
  return Best max PrevC
end
