rem Cody 843: hyperspectral unmixing
rem Basis columns are material spectra.

use linalg
use numbers
use sequences


rem Fit fractions to one spectrum.
fun Basis unmix Spectrum
  BasisT = Basis transpose
  Gram = BasisT matmul Basis
  Projection = BasisT matmul Spectrum
  Fractions = Gram solve Projection
  Fitted = Basis matmul Fractions
  Residual' = Spectrum - Fitted
  Error = Residual * Residual sum sqrt

  return record
    .fractions = Fractions
    .fitted = Fitted
    .error = Error
  end
end
