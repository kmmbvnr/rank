rem Cody 71: missing weather data
rem 9999 marks an interpolated reading.

use sequences
use text


rem Parse readings and interpolate gaps.
fun interpolate_weather Source
  if Source type equal .text
    return Source "\n" split interpolate_readings
  end
  return Source interpolate_readings
end


fun interpolate_readings Lines
  Readings = Lines real rank 0 copy
  N = Readings len

  for Start in 0 until N
    if Readings Start equal 9999
      End = Start
      for Readings End equal 9999
        End += 1
      end

      Anchor = Readings (Start - 1)
      Gap = End - Start + 1
      Step = (Readings End - Anchor) / Gap
      Val = Anchor
      for i in Start until End
        Val += Step
        Readings i = Val
      end
    end
  end

  return Readings
end
