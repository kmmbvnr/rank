rem Cody 54730: local grid extrema
rem Tied values are not extrema.

use sequences
use numbers


rem Keep strict eight-neighbor extrema.
fun local_extrema Grid
  Size = array 3 3
  Above = Grid Size window padding 1 with -infinity
  Below = Grid Size window padding 1 with infinity
  Peaks = Above peak rank 2
  Valleys = Below valley rank 2
  Marks = Peaks Valleys max
  return Grid * Marks
end


rem One when no other cell reaches the center.
fun peak Cell
  Ties = Cell at least Cell 1 1
  if Ties count equal 1
    return 1
  end
  return 0
end


rem One when no other cell falls to the center.
fun valley Cell
  Ties = Cell at most Cell 1 1
  if Ties count equal 1
    return 1
  end
  return 0
end
