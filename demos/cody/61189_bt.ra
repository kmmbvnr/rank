rem Cody 61189: emergency braking
rem Acceleration can change each step.

use sequences


rem Simulate until stopped or exhausted.
fun brake Initial AccelSamples Delta
  Count = AccelSamples len
  Length = Count + 1
  Speeds = array shape Length fill 0.0
  Speed = Initial
  Distance = 0.0
  Time = 0.0
  Stopped = false
  Speeds 0 = Speed

  for Accel i in AccelSamples
    Next = Speed + Accel * Delta
    if Next at most 0
      Partial = Speed / (0 - Accel)
      Average = Speed / 2
      Distance += Average * Partial
      Time += Partial
      Speeds (i + 1) = 0.0
      Stopped = true
      break
    end

    Average = (Speed + Next) / 2
    Distance += Average * Delta
    Time += Delta
    Speed = Next
    Speeds (i + 1) = Speed
  end

  return record
    .distance = Distance
    .time = Time
    .stopped = Stopped
    .speeds = Speeds
  end
end
