use testing

test "break-even rent from the contest"
  use "004_seek"
  use numbers

  Params = array 150000.0 5000.0 360.0 75000.0 10.0 30000.0 5.0 1.5 25.0 1.75 3.0 nan
  Rent = 0 Params seek
  (Rent - 573.2682766) abs less 0.01
end

test "a found value reaches the target within one unit"
  use "004_seek"
  use numbers
  use sequences

  Base = array 150000.0 5000.0 360.0 75000.0 10.0 30000.0 5.0 1.5 25.0 1.75 3.0 600.0
  Close = true
  for Pos in array 0 4 9
    Trial = Base copy
    Trial Pos = nan
    Value = 5000.0 Trial seek
    Close = Close and (Value Pos Trial 5000.0 gap abs at most 1)
  end
  Close
end

test "a whole loan term"
  use "004_seek"
  use numbers
  use sequences

  Base = array 150000.0 5000.0 360.0 75000.0 10.0 30000.0 5.0 1.5 25.0 1.75 3.0 600.0
  Target = 240.0 2 Base 0.0 gap
  Trial = Base copy
  Trial 2 = nan
  Target Trial seek equal 240.0
end

test "an unreachable target is a domain error"
  use "004_seek"
  use numbers

  Params = array 150000.0 5000.0 360.0 75000.0 10.0 30000.0 5.0 1.5 25.0 1.75 3.0 nan
  Raised = false
  try
    Rent = -1000000000.0 Params seek
  catch .DomainError Error
    Raised = true
  end
  Raised
end
