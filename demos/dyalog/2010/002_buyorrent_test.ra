use testing

test "first three months of the contest example"
  use "002_buyorrent"
  use numbers
  use sequences

  Params = array 150000.0 5000.0 360.0 75000.0 10.0 30000.0 5.0 1.5 25.0 1.75 3.0 600.0
  Model = Params buyorrent
  Series = Model .series
  rem Rows of the table in the contest description.
  Month1 = array 1 625.00 33.18 74966.82 125.00 36.05 29963.95 156.25 0.0 150186.22 -662.98 44592.47 600.0 49493.75 -4901.28
  Month2 = array 2 624.72 33.46 74933.37 124.85 36.20 29927.76 156.18 0.0 150372.68 -1327.26 44184.29 600.0 48986.55 -4802.26
  Month3 = array 3 624.44 33.73 74899.63 124.70 36.35 29891.41 156.11 0.0 150559.36 -1992.87 43775.46 600.0 48478.40 -4702.94
  Expected = (array Month1 Month2 Month3) copy

  Shape = Series shape equal array 360 15
  Payments = Model .payments 2 round equal array 658.18 161.05
  Months = Series 3 take 2 round equal Expected
  (Shape all) and (Payments all) and (Months all)
end

test "property tax is paid every six months on the value at the start of the year"
  use "002_buyorrent"
  use numbers
  use sequences

  Params = array 150000.0 5000.0 360.0 75000.0 10.0 30000.0 5.0 1.5 25.0 1.75 3.0 600.0
  Tax = Params buyorrent .series # 8
  Paid = Tax 30 take 2 round
  (Paid 5 equal 1312.5) and (Paid 11 equal 1312.5) and (Paid 17 equal 1332.19) and (Paid 12 equal 0.0)
end

test "the break-even rent from task 4 leaves no advantage at the end of the term"
  use "002_buyorrent"
  use numbers

  Params = array 150000.0 5000.0 360.0 75000.0 10.0 30000.0 5.0 1.5 25.0 1.75 3.0 573.2682766
  Series = Params buyorrent .series
  Series 359 14 abs less 1
end
