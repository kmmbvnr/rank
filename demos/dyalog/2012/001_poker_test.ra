use testing

test "all categories and royal flush increase in value"
  use "001_poker"
  Hands = array shape 10
    "2H 4C 6S 8D TH"
    "2H 2C 6S 8D TH"
    "2H 2C 6S 6D TH"
    "2H 2C 2S 8D TH"
    "2H 3C 4S 5D 6H"
    "2H 4H 6H 8H TH"
    "2H 2C 2S 8D 8H"
    "2H 2C 2S 2D TH"
    "2H 3H 4H 5H 6H"
    "TH JH QH KH AH"
  end
  Values = Hands handValue rank 0
  Values drop 1 greater Values take 9
end

test "case, spaces, order and suits do not change values"
  use "001_poker"
  Value = "QC QD 9H 7D 2C" handValue
  Value equal ("qcqD9h7D2c" handValue)
  Value equal ("2S 7H 9D QH QS" handValue)
end

test "every combination and kicker breaks ties"
  use "001_poker"
  Strong = array shape 9
    "AH AD 2C 3S 4H"
    "AH AD 2C 2S 3H"
    "AH AD KC KS 3H"
    "AH AD KC KS 4H"
    "8H 8D 8C 2S 3H"
    "4H 4D 4C 2S 2H"
    "8H 8D 8C 8S 2H"
    "5H 5D AH KC 3H"
    "AH JH 9H 5H 3H"
  end
  Weak = array shape 9
    "KH KD QC JS TH"
    "KH KD QC QS JH"
    "AC AS QC QS JH"
    "AC AS KH KD 3H"
    "7H 7D 7C AS KH"
    "3H 3D 3C AS AH"
    "7H 7D 7C 7S AH"
    "5C 5S AS KD 2H"
    "AS JS 9S 5S 2S"
  end
  Strong handValue rank 0 greater Weak handValue rank 0
end

test "ace is low only in the five-high straight"
  use "001_poker"
  "2H 3C 4S 5D 6H" handValue greater "AH 2C 3S 4D 5H" handValue
  "2S 3S 4S 5S 6S" handValue greater "AH 2H 3H 4H 5H" handValue
  "AS KD QS JH TC" handValue greater "9S TD JC QH KC" handValue
  "AH 2C 3S 4D 6H" handValue less "2H 2C 6S 8D TH" handValue
end

test "published best hand uses one hole card"
  use "001_poker"
  ("QS 8H 7S QH AC" "AD 7C" bestHand) equal "AD AC QS QH 8H"
end

test "best hand can use zero or two hole cards"
  use "001_poker"
  Board = "AS KS QS JS TS"
  (Board "2H 3D" bestHand) handValue equal (Board handValue)
  ("AH KH QH 2C 3D" "JH TH" bestHand) handValue equal (Board handValue)
end

test "best hand picks the higher full house from two triples"
  use "001_poker"
  Result = "AS AH KS KH 2D" "AD KD" bestHand
  Result handValue equal ("AS AH AD KS KH" handValue)
end

test "best hand is independent of input order and mixed case"
  use "001_poker"
  First = "qs8h7sqhac" "ad7c" bestHand
  Second = "AC QH 7S 8H QS" "7C AD" bestHand
  First handValue equal (Second handValue)
end

test "published showdown has dense ties and hole-card counts"
  use "001_poker"
  use tables
  Players = array "AD 7C" "AS 4D" "QD 8S" "3S 2H"
  Result = "QS 8H 7S QH AC" Players showdown
  Result .hand equal array "AD AC QS QH 8H" "AS AC QS QH 8H" "QD QS QH 8S 8H" "QS QH AC 8H 7S"
  Result .rank equal array 2 2 1 3
  Result .used equal array 1 1 2 0
end

test "playing a royal-flush board ties every player"
  use "001_poker"
  use tables
  Result = "AS KS QS JS TS" (array "2H 3D" "4H 5D" "6H 7D") showdown
  Result .rank equal array 1 1 1
  Result .used equal array 0 0 0
end
