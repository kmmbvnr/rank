use testing

test "all categories and royal flush increase in value"
  use "001_poker"
  Hands = array shape 10
    "2H 4C 6S 8D TH"
    "2H 2C 6S 8D TH"
    "2H 2C 6S 6D TH"
    "2H 2C 2S 8D TH"
    "2H 3C 4S 5D 6H"
    "2H 4H 6H 8H TH"
    "2H 2C 2S 8D 8H"
    "2H 2C 2S 2D TH"
    "2H 3H 4H 5H 6H"
    "TH JH QH KH AH"
  end
  Values = Hands handValue rank 0
  Values drop 1 greater Values take 9
end

test "case, spaces, order and suits do not change values"
  use "001_poker"
  Value = "QC QD 9H 7D 2C" handValue
  Value equal ("qcqD9h7D2c" handValue)
  Value equal ("2S 7H 9D QH QS" handValue)
end

test "every combination and kicker breaks ties"
  use "001_poker"
  Strong = array shape 9
    "AH AD 2C 3S 4H"
    "AH AD 2C 2S 3H"
    "AH AD KC KS 3H"
    "AH AD KC KS 4H"
    "8H 8D 8C 2S 3H"
    "4H 4D 4C 2S 2H"
    "8H 8D 8C 8S 2H"
    "5H 5D AH KC 3H"
    "AH JH 9H 5H 3H"
  end
  Weak = array shape 9
    "KH KD QC JS TH"
    "KH KD QC QS JH"
    "AC AS QC QS JH"
    "AC AS KH KD 3H"
    "7H 7D 7C AS KH"
    "3H 3D 3C AS AH"
    "7H 7D 7C 7S AH"
    "5C 5S AS KD 2H"
    "AS JS 9S 5S 2S"
  end
  Strong handValue rank 0 greater Weak handValue rank 0
end

test "ace is low only in the five-high straight"
  use "001_poker"
  "2H 3C 4S 5D 6H" handValue greater "AH 2C 3S 4D 5H" handValue
  "2S 3S 4S 5S 6S" handValue greater "AH 2H 3H 4H 5H" handValue
  "AS KD QS JH TC" handValue greater "9S TD JC QH KC" handValue
  "AH 2C 3S 4D 6H" handValue less "2H 2C 6S 8D TH" handValue
end

test "published best hand uses one hole card"
  use "001_poker"
  ("QS 8H 7S QH AC" bestHand "AD 7C") equal "AD AC QS QH 8H"
end

test "best hand can use zero or two hole cards"
  use "001_poker"
  Board = "AS KS QS JS TS"
  (Board bestHand "2H 3D") handValue equal (Board handValue)
  ("AH KH QH 2C 3D" bestHand "JH TH") handValue equal (Board handValue)
end

test "best hand picks the higher full house from two triples"
  use "001_poker"
  Result = "AS AH KS KH 2D" bestHand "AD KD"
  Result handValue equal ("AS AH AD KS KH" handValue)
end

test "best hand is independent of input order and mixed case"
  use "001_poker"
  First = "qs8h7sqhac" bestHand "ad7c"
  Second = "AC QH 7S 8H QS" bestHand "7C AD"
  First handValue equal (Second handValue)
end

test "published showdown has dense ties and hole-card counts"
  use "001_poker"
  use tables
  Players = array "AD 7C" "AS 4D" "QD 8S" "3S 2H"
  Result = "QS 8H 7S QH AC" showdown Players
  Result .hand equal array "AD AC QS QH 8H" "AS AC QS QH 8H" "QD QS QH 8S 8H" "QS QH AC 8H 7S"
  Result .rank equal array 2 2 1 3
  Result .used equal array 1 1 2 0
end

test "playing a royal-flush board ties every player"
  use "001_poker"
  use tables
  Result = "AS KS QS JS TS" showdown (array "2H 3D" "4H 5D" "6H 7D")
  Result .rank equal array 1 1 1
  Result .used equal array 0 0 0
end

test "nuts on a flop allow any suits for a wheel"
  use "001_poker"
  use sequences
  ("AS 5C 4D" nuts) sort equal (array "2*" "3*")
end

test "nuts on a paired board require both remaining fours"
  use "001_poker"
  use sequences
  ("AS 5C 4D 4H" nuts) sort equal ((array "4S" "4C") sort)
end

test "nuts can require only one specific suited card"
  use "001_poker"
  ("AS KS QS TS" nuts) equal array "JS"
end

test "the board can already contain the nuts"
  use "001_poker"
  ("AS KS QD JH TC" nuts) len equal 0
end

test "direct evaluation equals the best of every five-card subset"
  use "001_poker"
  use sequences
  use text
  Low = array "AS" "AH" "2S" "2H" "3S" "3H" "4S" "4H" "5S" "5H" "KS" "KH"
  Mid = array "AS" "AH" "AD" "AC" "KS" "KH" "KD" "KC" "QS" "QH" "QD" "QC" "JS" "JH" "JD" "JC" "TS" "TH" "TD" "TC" "9S" "9H" "9D" "9C" "8S" "8H" "8D" "8C"
  Seed = 4242
  Bad = 0
  for Which in 0 till 3
    Pool0 = deck array
    if Which equal 1
      Pool0 = Low
    elif Which equal 2
      Pool0 = Mid
    end
    for Round in 0 till 60
      Pool = Pool0 copy
      Cards = array shape 0 fill ""
      for I in 0 till (5 + (Round mod 3))
        Seed = (Seed * 1103515245 + 12345) mod 2147483648
        J = (Seed // 65536) mod (Pool len)
        Cards = concat Cards (array (Pool J))
        Pool = Pool (Pool not equal (Pool J)) array
      end
      unpack Best Highest = Cards bestChoice
      if (Cards quickValue) not equal Highest
        Bad += 1
      end
    end
  end
  Bad equal 0
end
