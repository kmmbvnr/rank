rem Dyalog 2012, problem 4: Nurikabe.
use algo
use sequences

fun adjacent Position Height Width
  Row = Position // Width
  Column = Position mod Width
  if Row greater 0
    yield Position - Width
  end
  if Row + 1 less Height
    yield Position + Width
  end
  if Column greater 0
    yield Position - 1
  end
  if Column + 1 less Width
    yield Position + 1
  end
end

fun seaSquare Flat Height Width
  for Row in 0 till (Height - 1)
    for Column in 0 till (Width - 1)
      P = Row * Width + Column
      Square = array (Flat P) (Flat (P + 1)) (Flat (P + Width)) (Flat (P + Width + 1))
      if (Square equal -1) all
        return true
      end
    end
  end
  return false
end

fun valid Board
  Shape = Board shape
  if (Shape len) not equal 2
    return 0
  end
  unpack Height Width = Shape
  Size = Height * Width
  if Size equal 0
    return 0
  end
  Flat = Board reshape Size
  for Cell in Flat
    if not Cell is .integer
      return 0
    end
    if Cell less -1
      return 0
    end
  end
  if Flat Height Width seaSquare
    return 0
  end
  Seen = array shape Size fill false
  Seas = 0
  for Cell Start in Flat
    if Seen Start
      continue
    end
    Sea = Cell equal -1
    if Sea
      Seas += 1
      if Seas greater 1
        return 0
      end
    end
    Count = 0
    Clues = 0
    Expected = 0
    Pending = new queue
    Pending push Start
    Seen Start = true
    for Position in Pending
      Count += 1
      Value = Flat Position
      if Value greater 0
        Clues += 1
        Expected = Value
      end
      for Next in Position Height Width adjacent
        if Seen Next
          continue
        end
        if ((Flat Next) equal -1) not equal Sea
          continue
        end
        Seen Next = true
        Pending push Next
      end
    end
    if not Sea
      if Clues not equal 1 or Count not equal Expected
        return 0
      end
    end
  end
  return 1
end

Example = array shape 2 2
  -1 -1
   2  0
end
Valid = Example valid
