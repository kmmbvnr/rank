use testing

test "published two-month and ten-month moving averages"
  use "009_moving"
  Sales = array 200 300 2700 3400 100 2000 400 2100 3500 3000 4700 4300
  (2 movingAverage Sales) equal array 250 1500 3050 1750 1050 1200 1250 2800 3250 3850 4500
  (10 movingAverage Sales) equal array 1770 2220 2620
  (1 movingAverage Sales) equal Sales
end

test "oversized windows and empty vectors produce empty vectors"
  use "009_moving"
  use sequences
  (4 movingAverage (array 1.0 2.0 3.0)) shape equal array 0
  (2 movingAverage (array shape 0 fill 0.0)) shape equal array 0
  (2 movingAverage (array 1.0 2.0 3.0)) equal array 1.5 2.5
end

test "each moving average agrees with its explicit slice"
  use "009_moving"
  use sequences
  use numbers
  Values = array -2.0 1.0 7.0 -3.0 4.0 9.0
  for N in 1 to 6
    Actual = N movingAverage Values
    Actual len equal (7 - N)
    for Mean I in Actual
      Slice = Values drop I take N
      (Mean - ((Slice sum) / N)) abs less 0.000000000001
    end
  end
end

test "nonpositive windows are rejected"
  use "009_moving"
  Caught = false
  try
    0 movingAverage (array 1 2)
  catch .InvalidWindow Error
    Caught = true
  end
  Caught
end
