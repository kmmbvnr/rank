use testing

test "published two-equation system"
  use "010_linear"
  A = array shape 2 2
    3 2
    1 -1
  end
  B = array 13 1
  (A linearSolve B) equal array 3 2
end

test "published three-equation system and its residual"
  use "010_linear"
  use linalg
  use numbers
  A = array shape 3 3
    4 1 3
    2 2 2
    6 3 1
  end
  B = array 2 6 4
  X = A linearSolve B
  ((X - (array -1 3 1)) abs) less 0.0000000001
  (((A matmul X) - B) abs) less 0.0000000001
end

test "pivoting and multiple right-hand sides"
  use "010_linear"
  A = array shape 2 2
    0 2
    1 3
  end
  (A linearSolve (array 4 7)) equal array 1 2
  Coefficients = array shape 2 2
    3 2
    1 -1
  end
  B = array shape 2 2
    13 26
    1 2
  end
  Expected = array shape 2 2
    3 6
    2 4
  end
  (Coefficients linearSolve B) equal Expected
end

test "singular and incompatible systems retain linalg errors"
  use "010_linear"
  A = array shape 2 2
    1 2
    2 4
  end
  Singular = false
  try
    A linearSolve (array 1 2)
  catch .SingularMatrix Error
    Singular = true
  end
  Singular
  Incompatible = false
  try
    A linearSolve (array 1 2 3)
  catch .DimensionMismatch Error
    Incompatible = true
  end
  Incompatible
end
