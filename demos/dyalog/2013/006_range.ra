rem Dyalog 2013, problem 6: one numeric range across all cells.
use sequences
use io

fun numericRange A
  if not A is .array
    return 0.0
  end
  Size = A shape reduce *
  if Size equal 0
    return 0.0
  end
  Values = A reshape Size
  Difference = (Values max) - (Values min)
  return Difference real
end

Example = (array 19.0 -3.0 7.6 22.0) numericRange
Example print
