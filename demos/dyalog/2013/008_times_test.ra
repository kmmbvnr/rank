use testing

test "published five by five multiplication table"
  use "008_times"
  Expected = array shape 5 5
    1 2 3 4 5
    2 4 6 8 10
    3 6 9 12 15
    4 8 12 16 20
    5 10 15 20 25
  end
  (5 timesTable) equal Expected
end

test "zero and one retain both matrix axes"
  use "008_times"
  use sequences
  (0 timesTable) shape equal array 0 0
  (1 timesTable) shape equal array 1 1
  (1 timesTable) 0 0 equal 1
end

test "every cell is the product of its one-based indices"
  use "008_times"
  use sequences
  for N in 1 to 8
    Table = N timesTable
    for Row in 0 till N
      for Column in 0 till N
        Table Row Column equal ((Row + 1) * (Column + 1))
      end
    end
  end
end
