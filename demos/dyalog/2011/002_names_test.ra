use testing

test "the contest example finds the misspelling"
  use "002_names" as solve
  Out = solve
  Matches = Out .matches
  Positions = Out .positions

  Positions equal array 8 and Matches equal array "Jakc Jonnson"
end

test "tolerance boundary"
  use "002_names" as solve
  Out = solve 0.2 42 "Jack Johnson" "Jakc Jonnson" 2
  Positions = Out .positions
  Missed = Positions len equal 0

  Out = solve 0.2 42 "Jack Johnson" "Jakc Jonnson" 3
  Positions = Out .positions
  Missed and Positions len equal 1
end

test "case is ignored and the case kept"
  use "002_names" as solve
  Out = solve 0.2 42 "Jack Johnson" "xx JACK johnson" 0
  Matches = Out .matches
  Positions = Out .positions

  Positions equal array 3 and Matches equal array "JACK johnson"
end

test "overlapping matches"
  use "002_names" as solve
  Out = solve 0.2 42 "aa" "aaaa" 0
  Positions = Out .positions

  Positions equal array 0 1 2
end

test "an insertion is not a match"
  use "002_names" as solve
  Out = solve 0.2 42 "ab" "axb" 0
  Positions = Out .positions

  Positions len equal 0
end

test "an empty name has no matches"
  use "002_names" as solve
  Out = solve 0.2 42 "" "I think Jakc Jonnson is the greatest" 5
  Positions = Out .positions

  Positions len equal 0
end

test "a name longer than the text has no matches"
  use "002_names" as solve
  Out = solve 0.2 42 "abc" "ab" 5
  Positions = Out .positions

  Positions len equal 0
end

test "rate zero changes nothing"
  use "002_names" as solve
  Out = solve 0.0
  Noisy = Out .noisy

  Noisy equal "Jack Johnson"
end

test "rate one replaces only letters"
  use "002_names" as solve
  Out = solve 1.0 42 "Jack, Johnson 42!"
  Noisy = Out .noisy

  Noisy equal "XXXX, XXXXXXX 42!"
end

test "each letter is replaced independently"
  use "002_names" as solve
  use numbers
  use sequences
  use text
  Parts = array shape 1000 fill "abcdefghij"
  Out = solve 0.3 42 (Parts join "") "x"
  Name = Out .name
  Noisy = Out .noisy

  Marks = Noisy split "" equal "X"
  Total = Name len
  Share = Marks count / Total
  (Share - 0.3) abs less 0.02
end
