rem Dyalog 2011, task 5: Go Find It Yourself.
use text
use sequences
use numbers
use linalg

fun Text tokenize
  return Text words
end

fun Titles allWords
  for Title in Titles
    for Word in Title tokenize
      yield Word
    end
  end
end

fun Titles makeDict
  return Titles allWords unique array
end

fun Dict dictCount Text rank 1 0
  Words = Text tokenize
  Matches' = Dict Words outer equal
  return Matches count axis 1
end

fun A cosine B rank 1 1
  Dot = A matmul B
  MagA = (A matmul A) sqrt
  MagB = (B matmul B) sqrt
  return Dot / (MagA * MagB)
end

fun Titles seek Query
  Dict = Titles makeDict
  QueryVec = Dict dictCount Query
  if QueryVec sum equal 0
    return Titles take 0
  end
  TitleVecs = Dict dictCount Titles rank 1 0
  rem Positive overlap also excludes tokenless titles before cosine.
  Hits = (TitleVecs matmul QueryVec) greater 0
  HitTitles = Titles Hits array
  HitVecs' = TitleVecs Hits #
  HitScores' = HitVecs cosine QueryVec rank 1 1
  Order' = HitScores argsort .descending
  Best = Order take 10
  return HitTitles Best
end

rem Titles printed in the contest examples, not the full workspace corpus.
Titles = array shape 8
  "Sudoku with Dyalog APL"
  "A Sudoku Solver in J"
  "Error Trapping Tutorial for APL.68000"
  "Error Trapping Tutorial for APL*PLUS"
  "Error Trapping Tutorial for IPSA APL"
  "Error Trapping Tutorial in Dyalog APL"
  "Tutorial on Error Trapping in APL2/PC"
  "Letter: Chaos - Computer Error not to Blame"
end
Misspelled = Titles seek "suduko"
Sudoku = Titles seek "sudoku"
ErrorTrapping = Titles seek "Error Trapping"
