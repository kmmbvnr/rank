rem Dyalog 2011, task 2
rem What's in a Name?
rem Noise: replace letters with X.
rem Search: find Name in Text.
rem Ignore case; allow mismatches.
rem Name must be nonempty and fit.

use io
use cli
use random
use sequences
use text

rem Chance per letter to become X.
option Rate real = 0.2
rem Seed for repeatable noise.
option Seed integer = 42
rem Name to alter and find.
option Name path = "Jack Johnson"
rem Text to search.
option Text path = "I think Jakc Jonnson is the greatest"
rem Maximum mismatched characters.
option Tolerance integer = 3

rem Only letters change.
rem Each draw is independent.
rem The changed count is random.
Seed seed
Chars = Name "" split
Shape = array (Chars len)
Draws = Shape 0 1 uniform
Mask = Draws less Rate and Chars letter
Letters = Mask choose "X" Chars
Noisy = Letters "" join
Noisy print

rem Compare equal-width windows.
rem Count differences; ignore case.
rem Return the original text.
Width = Name len
Positions = array shape 0 fill 0
Matches = array shape 0 fill ""
if Width at least 1
  Lower = (Text lower) "" split
  Windows = Lower window Width
  Pattern = (Name lower) "" split
  Different = Windows not equal Pattern
  Errors = Different count axis 1
  Close = Errors at most Tolerance
  Positions = Close indices
  Raw = Text window Width
  Matches = Raw Positions
end
Positions print
Matches print
