rem Kaggle: Store Sales
rem https://www.kaggle.com/competitions/store-sales-time-series-forecasting
rem Forecast each store and family from its
rem historical mean on the same weekday.

use algo
use cli
use numbers
use sequences
use stats
use tables
use text

argument TrainPath path = "demos/kaggle/data/store-sales/train.csv"
argument TestPath path = "demos/kaggle/data/store-sales/test.csv"
argument OutputPath path = "demos/kaggle/submissions/store-sales.csv"

Train = TrainPath csv
Test = TestPath csv
Stores = Train .store_nbr
Families = Train .family
Dates = Train .date
Sales = Train .sales
TestStores = Test .store_nbr
TestFamilies = Test .family
TestDates = Test .date
Pred = Stores Families Dates Sales TestStores TestFamilies TestDates forecast
Test .sales = Pred
Submission = Test (array .id .sales)
Submission OutputPath csv


rem Sunday is 0 and Saturday is 6.
fun weekday Date
  unpack Year Month Day = Date "/integer-/integer-/integer" parse
  Offset = array 0 3 2 5 0 3 5 1 4 6 2 4
  if Month less 3
    Year -= 1
  end
  return (Year + Year // 4 - Year // 100 + Year // 400
    + Offset (Month - 1) + Day) % 7
end


fun weekdays Dates
  Result = array shape (Dates len) pad 0
  for Date i in Dates
    Result i = Date weekday
  end
  return Result
end


rem Use the global training mean for a key absent from Train.
fun forecast Stores Families Dates Sales TestStores TestFamilies TestDates
  Count = Stores len
  if Families len not equal Count or Dates len not equal Count
    .DimensionMismatch raise
  end
  if Sales len not equal Count
    .DimensionMismatch raise
  end

  Days = Dates weekdays
  Sums = new index
  Counts = new index
  for Sale i in Sales
    Key = array (Stores i) (Families i) (Days i)
    try
      Sums unpack Key += Sale
      Counts unpack Key += 1
    catch .Missing Error
      Sums unpack Key = Sale
      Counts unpack Key = 1
    end
  end

  TestCount = TestStores len
  if TestFamilies len not equal TestCount or TestDates len not equal TestCount
    .DimensionMismatch raise
  end
  TestDays = TestDates weekdays
  Global = Sales mean
  Result = array shape TestCount pad Global
  for Value i in Result
    Key = array (TestStores i) (TestFamilies i) (TestDays i)
    try
      Result i = Sums unpack Key / Counts unpack Key
    catch .Missing Error
      rem Keep the global fallback.
    end
  end
  return Result
end
