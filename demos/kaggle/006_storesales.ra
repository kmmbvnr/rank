rem Kaggle: Store Sales
rem https://www.kaggle.com/competitions/store-sales-time-series-forecasting
rem Forecast each store and family from its
rem historical mean on the same weekday.

use cli
use dates
use stats
use tables

arg TrainPath path = "demos/kaggle/data/store-sales/train.csv"
arg TestPath path = "demos/kaggle/data/store-sales/test.csv"
arg OutputPath path = "demos/kaggle/submissions/store-sales.csv"

Train = TrainPath csv
Test = TestPath csv
Pred = Train forecast Test
Test .sales = Pred
Submission = Test (array .id .sales)
Submission csv OutputPath


rem Use the global training mean for a key absent from Train.
fun Train forecast Test
  Global = Train .sales mean
  Train .weekday = Train .date date weekday
  Test .weekday = Test .date date weekday
  Groups' = Train group by .store_nbr .family .weekday
  Means' = Groups select
    .sales = .sales mean
  end
  rem Materialize before the caller adds the prediction column.
  Joined = Test Means leftjoin by .store_nbr .family .weekday
  return Joined .sales default Global
end
