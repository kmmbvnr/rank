rem Kaggle: Digit Recognizer
rem https://www.kaggle.com/competitions/digit-recognizer
rem Classify normalized pixels by nearest
rem training-class centroid.

use cli
use sequences
use stats
use tables

argument TrainPath path = "demos/kaggle/data/digits/train.csv"
argument TestPath path = "demos/kaggle/data/digits/test.csv"
argument OutputPath path = "demos/kaggle/submissions/digits.csv"

Train = TrainPath csv
Test = TestPath csv
Submission = Train Test solve_table
Submission OutputPath csv


rem Use CSV headers to retain pixel order in both files.
fun solve_table Train Test
  Labels = Train labels
  Features = (Labels (Labels not equal .label)) array
  X = Train Features
  Xtest = Test Features
  Y = Train .label
  Classes = Y unique
  Pred = X Y Xtest Classes solve
  Test .ImageId = (1 to (Pred len)) array
  Test .Label = Pred
  return Test (array .ImageId .Label)
end


fun centroids X Y Classes
  Shape = X shape
  if Shape len not equal 2 or Y len not equal Shape 0
    .DimensionMismatch raise
  end
  Result = array shape (Classes len) (Shape 1) pad 0.0
  for Class ci in Classes
    Mask = Y equal Class
    Group = X Mask #
    if Group len equal 0
      .DomainError raise
    end
    Result ci # = Group mean axis 0
  end
  return Result
end


fun classify X Centers Classes
  Shape = X shape
  if Shape len not equal 2
    .DimensionMismatch raise
  end
  Pred = array shape (Shape 0) pad 0
  for Row in 0 until Shape 0
    Point = X Row #
    Delta = Centers - Point
    Dist = Delta * Delta sum axis 1
    Best = 0
    for Candidate in 1 until (Classes len)
      if Dist Candidate less Dist Best
        Best = Candidate
      end
    end
    Pred Row = Classes Best
  end
  return Pred
end


fun solve X Y Xtest Classes
  X = X / 255.0
  Xtest = Xtest / 255.0
  Centers = X Y Classes centroids
  return Xtest Centers Classes classify
end
