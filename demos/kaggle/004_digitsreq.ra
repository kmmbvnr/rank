rem Kaggle: Digit Recognizer
rem https://www.kaggle.com/competitions/digit-recognizer
rem Classify normalized pixels by nearest
rem training-class centroid.

use cli
use sequences
use stats
use tables

arg TrainPath path = "demos/kaggle/data/digits/train.csv"
arg TestPath path = "demos/kaggle/data/digits/test.csv"
arg OutputPath path = "demos/kaggle/submissions/digits.csv"

Train = TrainPath csv
Test = TestPath csv
Submission = Train solve_table Test
Submission csv OutputPath


rem Use CSV headers to retain pixel order in both files.
fun Train solve_table Test
  Labels = Train labels
  Mask' = Labels not equal .label
  Features = (Labels Mask) array
  X = Train Features
  Xtest = Test Features
  Y = Train .label
  Classes = Y unique
  Pred = X Y Xtest Classes solve
  Count = Pred len
  Test .ImageId = (1 to Count) array
  Test .Label = Pred
  return Test (array .ImageId .Label)
end


fun X Y Classes centroids
  unpack Rows Cols = X shape
  if Y len not equal Rows
    .DimensionMismatch raise
  end
  K = Classes len
  Result = array shape K Cols fill 0.0
  for Class ci in Classes
    Mask' = Y equal Class
    Group = X Mask #
    if Group len equal 0
      .DomainError raise
    end
    Result ci # = Group mean axis 0
  end
  return Result
end


fun X Centers Classes classify
  unpack Rows Cols = X shape
  Pred = array shape Rows fill 0
  for Row in 0 till Rows
    Point = X Row #
    Delta' = Centers - Point
    Dist' = Delta * Delta sum axis 1
    Best = Dist argsort .ascending 0
    Pred Row = Classes Best
  end
  return Pred
end


fun X Y Xtest Classes solve
  Pixels = (X real rank 0) / 255.0
  TestPixels = (Xtest real rank 0) / 255.0
  Centers = Pixels Y Classes centroids
  return TestPixels Centers Classes classify
end
