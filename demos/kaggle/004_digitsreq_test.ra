use testing

test "selects pixels by CSV schema and writes ordered submission columns"
  use json
  use tables
  use "004_digitsreq"
  Train = "[{\"label\":0,\"pixel0\":0,\"pixel1\":0},{\"label\":1,\"pixel0\":255,\"pixel1\":255}]" json
  Test = "[{\"pixel0\":0,\"pixel1\":0},{\"pixel0\":250,\"pixel1\":250}]" json
  Out = Train Test solve_table
  Out equal array shape 2 2
    1 0
    2 1
  end
end

test "classifies pixels by the nearest class centroid"
  use "004_digitsreq"
  X = array shape 4 2
    0 0
    0 10
    250 245
    255 255
  end
  Y = array 0 0 1 1
  Xtest = array shape 2 2
    5 5
    250 250
  end

  X Y Xtest (array 0 1) solve equal array 0 1
end

test "keeps caller feature tensors unchanged"
  use sequences
  use "004_digitsreq"
  X = array shape 2 1
    0
    255
  end
  Before = X copy
  Pred = X (array 0 1) X (array 0 1) solve
  X equal Before
end

test "requires a sample for every requested class"
  use "004_digitsreq"
  X = array shape 1 1 pad 0
  Raised = false
  try
    Centers = X (array 0) (array 0 1) centroids
  catch .DomainError Error
    Raised = true
  end
  Raised
end
