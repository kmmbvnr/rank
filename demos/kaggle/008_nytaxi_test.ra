use testing

test "computes planar coordinate distance"
  use numbers
  use "008_nytaxi"
  (array 0 0 3 4) distance round 4 equal 555.0
end

test "extracts taxi features"
  use json
  use "008_nytaxi"
  Rows = "[{\"pickup_datetime\":\"2024-01-07 13:00:00\",\"pickup_latitude\":40.0,\"pickup_longitude\":-73.0,\"dropoff_latitude\":40.0,\"dropoff_longitude\":-72.0,\"passenger_count\":2}]" json
  Expected = array shape 1 5
    111.0 13 0 1 2
  end
  Rows taxi_features equal Expected
end

test "builds a nonnegative duration submission"
  use json
  use sequences
  use "008_nytaxi"
  Train = "[{\"id\":\"a\",\"pickup_datetime\":\"2024-01-01 08:00:00\",\"pickup_latitude\":40.0,\"pickup_longitude\":-73.0,\"dropoff_latitude\":40.1,\"dropoff_longitude\":-73.0,\"passenger_count\":1,\"trip_duration\":300}, {\"id\":\"b\",\"pickup_datetime\":\"2024-01-02 18:00:00\",\"pickup_latitude\":40.0,\"pickup_longitude\":-73.0,\"dropoff_latitude\":40.2,\"dropoff_longitude\":-73.0,\"passenger_count\":2,\"trip_duration\":600}]" json
  Test = "[{\"id\":\"c\",\"pickup_datetime\":\"2024-01-03 12:00:00\",\"pickup_latitude\":40.0,\"pickup_longitude\":-73.0,\"dropoff_latitude\":40.15,\"dropoff_longitude\":-73.0,\"passenger_count\":1}]" json

  Result = Train Test 0.03 300 solve
  Result shape equal array 1 2 and Result 0 1 at least 0
end
