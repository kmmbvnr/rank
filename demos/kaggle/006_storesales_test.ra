use testing

test "parses Gregorian dates and uses Monday-first weekdays"
  use dates
  use "006_storesales"
  Dates = array "2024-01-01" "2024-01-07" "2000-02-29"
  Dates date weekday equal array 0 6 1
end

test "averages matching store family and weekday keys"
  use json
  use "006_storesales"
  Train = "[{\"store_nbr\":1,\"family\":\"A\",\"date\":\"2024-01-01\",\"sales\":10},
    {\"store_nbr\":1,\"family\":\"A\",\"date\":\"2024-01-08\",\"sales\":20},
    {\"store_nbr\":1,\"family\":\"A\",\"date\":\"2024-01-02\",\"sales\":90},
    {\"store_nbr\":2,\"family\":\"A\",\"date\":\"2024-01-01\",\"sales\":50}]" json
  Test = "[{\"store_nbr\":1,\"family\":\"A\",\"date\":\"2024-01-15\"},
    {\"store_nbr\":2,\"family\":\"A\",\"date\":\"2024-01-08\"},
    {\"store_nbr\":9,\"family\":\"A\",\"date\":\"2024-01-01\"}]" json

  Result = Train Test forecast
  Result equal array 15.0 50.0 42.5
end

test "rejects invalid calendar dates"
  use json
  use "006_storesales"
  Train = "[{\"store_nbr\":1,\"family\":\"A\",\"date\":\"2024-01-01\",\"sales\":1}]" json
  Test = "[{\"store_nbr\":1,\"family\":\"A\",\"date\":\"2024-02-30\"}]" json
  Raised = false
  try
    Result = Train Test forecast
  catch .InvalidDate Error
    Raised = true
  end
  Raised
end
