use testing

test "parses Gregorian dates and uses Monday-first weekdays"
  use dates
  use "006_storesales"
  Dates = array "2024-01-01" "2024-01-07" "2000-02-29"
  Dates date weekday equal array 0 6 1
end

test "averages matching store family and weekday keys"
  use "006_storesales"
  Stores = array 1 1 1 2
  Families = array "A" "A" "A" "A"
  Dates = array "2024-01-01" "2024-01-08" "2024-01-02" "2024-01-01"
  Sales = array 10 20 90 50
  TestStores = array 1 2 9
  TestFamilies = array "A" "A" "A"
  TestDates = array "2024-01-15" "2024-01-08" "2024-01-01"

  Result = Stores Families Dates Sales TestStores TestFamilies TestDates forecast
  Result equal array 15.0 50.0 42.5
end

test "checks aligned training columns"
  use "006_storesales"
  Raised = false
  try
    Result = (array 1) (array "A" "B") (array "2024-01-01") (array 1) (array 1) (array "A") (array "2024-01-01") forecast
  catch .DimensionMismatch Error
    Raised = true
  end
  Raised
end
