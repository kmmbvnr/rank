rem Kaggle: Dogs vs Cats
rem https://www.kaggle.com/competitions/dogs-vs-cats
rem Resize JPEG/PNG images and fit a small
rem RGB-pixel logistic classifier.

use "001_titanic" as Classifier
use cli
use images
use linalg
use sequences
use tables
use text

argument TrainPath path = "demos/kaggle/data/dogs-vs-cats/train"
argument TestPath path = "demos/kaggle/data/dogs-vs-cats/test1"
argument OutputPath path = "demos/kaggle/submissions/dogs-vs-cats.csv"

Train = TrainPath images
Test = TestPath images
Submission = Train Test 0.1 300 solve_images
Submission csv OutputPath


rem File names cat.N and dog.N provide training labels.
fun Train image_labels
  Y = array shape (Train len) fill 0
  for Name Row in Train .name
    if Name startswith "dog."
      Y Row = 1
    elif not Name startswith "cat."
      .InvalidText raise
    end
  end
  return Y
end


fun Train Test Rate Steps solve_images
  Height = 8
  Width = 8
  Features = Height * Width * 3

  N = Train len
  Images = Train Height Width resize
  X = Images reshape N Features

  M = Test len
  TestImages = Test Height Width resize
  Xtest = TestImages reshape M Features

  Y = Train image_labels
  Pred = X Y Xtest Rate Steps predictall
  Ids = array shape M fill 0
  for Name Row in Test .name
    Prefix = (Name split ".") 0
    Ids Row = Prefix integer
  end
  Test .id = Ids
  Test .label = Pred
  return Test (array .id .label)
end


fun X' probability Model
  Z' = (X - Model .center) / Model .scale
  Score' = Z matmul Model .weights + Model .bias
  return Score Classifier.sigmoid
end


fun X Y Xtest Rate Steps predictall
  Pixels = (X real rank 0) / 255.0
  TestPixels = (Xtest real rank 0) / 255.0
  Model = Pixels Y Rate Steps Classifier.logistic
  return TestPixels probability Model
end
