rem Kaggle: House Prices
rem https://www.kaggle.com/competitions/house-prices-advanced-regression-techniques
rem Fit a numeric log-price baseline.

use cli
use linalg
use numbers
use sequences
use stats
use tables

argument TrainPath path = "demos/kaggle/data/house-prices/train.csv"
argument TestPath path = "demos/kaggle/data/house-prices/test.csv"
argument OutputPath path = "demos/kaggle/submissions/house-prices.csv"

Train = TrainPath csv
Test = TestPath csv
Submission = Train Test 0.05 1500 solve
Submission OutputPath csv


rem Train standardized linear regression with an intercept.
fun linear X Y Rate Steps
  unpack Rows Columns = X shape
  if Rows equal 0
    .DomainError raise
  end
  if Y len not equal Rows
    .DimensionMismatch raise
  end

  Center = X mean axis 0
  Std = X std axis 0
  Scale = (Std equal 0) 1.0 Std choose
  Z = (X - Center) / Scale

  Weights = array shape Columns fill 0.0
  Bias = Y mean
  Zt = Z transpose
  for # in 0 until Steps
    Error = Z Weights matmul + Bias - Y
    Weights -= Rate * (Zt Error matmul / Rows)
    Bias -= Rate * (Error mean)
  end

  return record
    .weights = Weights
    .bias = Bias
    .center = Center
    .scale = Scale
  end
end


fun linear_predict X Model
  Z = (X - Model .center) / Model .scale
  return Z Model .weights matmul + Model .bias
end


fun solve Train Test Rate Steps
  Quality = Train .OverallQual median
  Area = Train .GrLivArea median
  Train .OverallQual = Train .OverallQual default Quality
  Test .OverallQual = Test .OverallQual default Quality
  Train .GrLivArea = Train .GrLivArea default Area
  Test .GrLivArea = Test .GrLivArea default Area

  Features = array .OverallQual .GrLivArea
  X = Train Features
  Xtest = Test Features
  Y = Train .SalePrice + 1 log

  Model = X Y Rate Steps linear
  Raw = Xtest Model linear_predict
  Pred = (Raw exp - 1) 0.0 max
  Test .SalePrice = Pred
  return Test (array .Id .SalePrice)
end
