rem Kaggle: House Prices
rem https://www.kaggle.com/competitions/house-prices-advanced-regression-techniques
rem Fit a numeric log-price baseline.

use cli
use linalg
use numbers
use sequences
use stats
use tables

arg TrainPath path = "demos/kaggle/data/house-prices/train.csv"
arg TestPath path = "demos/kaggle/data/house-prices/test.csv"
arg OutputPath path = "demos/kaggle/submissions/house-prices.csv"

Train = TrainPath csv
Test = TestPath csv
Submission = Train Test 0.05 1500 predictall
Submission csv OutputPath


rem Train standardized linear regression with an intercept.
fun X Y Rate Steps linear
  unpack Rows Columns = X shape
  if Rows equal 0
    .DomainError raise
  end
  if Y len not equal Rows
    .DimensionMismatch raise
  end

  Center = X mean axis 0
  Std = X std axis 0
  Scale = (Std equal 0) 1.0 Std choose
  Z = (X - Center) / Scale

  Weights = array shape Columns fill 0.0
  Bias = Y mean
  Zt = Z transpose
  for # in 0 till Steps
    Error = Z matmul Weights + Bias - Y
    Weights -= Rate * (Zt matmul Error / Rows)
    Bias -= Rate * (Error mean)
  end

  return record
    .weights = Weights
    .bias = Bias
    .center = Center
    .scale = Scale
  end
end


fun X' linear_predict Model
  Z' = (X - Model .center) / Model .scale
  return Z matmul Model .weights + Model .bias
end


fun Train Test Rate Steps predictall
  Quality = Train .OverallQual median
  Area = Train .GrLivArea median
  Train .OverallQual = Train .OverallQual default Quality
  Test .OverallQual = Test .OverallQual default Quality
  Train .GrLivArea = Train .GrLivArea default Area
  Test .GrLivArea = Test .GrLivArea default Area

  Features = array .OverallQual .GrLivArea
  X = Train Features
  Xtest = Test Features
  Y = Train .SalePrice + 1 log

  Model = X Y Rate Steps linear
  Raw' = Xtest linear_predict Model
  Pred' = (Raw exp - 1) max 0.0
  Test .SalePrice = Pred
  return Test (array .Id .SalePrice)
end
