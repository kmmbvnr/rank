rem Kaggle: Bike Sharing Demand
rem https://www.kaggle.com/competitions/bike-sharing-demand
rem Fit log demand from calendar, weather
rem and numeric ride conditions.

use "002_prices" as Regression
use cli
use dates
use numbers
use sequences
use tables

argument TrainPath path = "demos/kaggle/data/bike-sharing/train.csv"
argument TestPath path = "demos/kaggle/data/bike-sharing/test.csv"
argument OutputPath path = "demos/kaggle/submissions/bike-sharing.csv"

Train = TrainPath csv
Test = TestPath csv
Submission = Train Test 0.03 1200 solve
Submission OutputPath csv


fun bike_features Data
  Times = Data .datetime datetime
  Rows = Times len
  NumericFields = array .season .holiday .workingday .weather .temp .atemp .humidity .windspeed
  Numeric = Data NumericFields
  Result = array shape Rows 12 fill 0.0

  Result # 0 = Times hour
  Result # 1 = Times weekday
  Result # 2 = Times month
  Result # 3 = Times year
  for Column in 0 until 8
    Result # (Column + 4) = Numeric # Column
  end
  return Result
end


fun solve Train Test Rate Steps
  X = Train bike_features
  Xtest = Test bike_features
  Y = Train .count + 1 log
  Model = X Y Rate Steps Regression.linear
  Pred = ((Xtest Model Regression.linear_predict) exp - 1) copy
  Pred (Pred less 0) = 0.0
  Test .count = Pred
  return Test (array .datetime .count)
end
