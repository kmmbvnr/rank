rem Kaggle: Spaceship Titanic
rem https://www.kaggle.com/competitions/spaceship-titanic
rem Fit a numeric spending and passenger baseline.

use "001_titanic" as Titanic
use cli
use stats
use tables

argument TrainPath path = "demos/kaggle/data/spaceship-titanic/train.csv"
argument TestPath path = "demos/kaggle/data/spaceship-titanic/test.csv"
argument OutputPath path = "demos/kaggle/submissions/spaceship-titanic.csv"

Train = TrainPath csv
Test = TestPath csv
Submission = Train Test 0.1 1000 solve
Submission OutputPath csv


rem Fill spending columns from Train and add their total.
fun spending_features Train Test
  Money = array .RoomService .FoodCourt .ShoppingMall .Spa .VRDeck
  for Feature in Money
    Middle = Train Feature median
    Train Feature = Train Feature default Middle
    Test Feature = Test Feature default Middle
  end

  TrainMoney = Train Money
  TestMoney = Test Money
  Train .TotalSpend = TrainMoney sum axis 1
  Test .TotalSpend = TestMoney sum axis 1

  Age = Train .Age median
  Train .Age = Train .Age default Age
  Test .Age = Test .Age default Age

  Train .Cryo = (Train .CryoSleep default false) Titanic.binary
  Test .Cryo = (Test .CryoSleep default false) Titanic.binary
  Train .Vip = (Train .VIP default false) Titanic.binary
  Test .Vip = (Test .VIP default false) Titanic.binary

  Features = array .Cryo .Vip .Age .TotalSpend
  X = Train Features
  Xtest = Test Features
  return array X Xtest
end


fun solve Train Test Rate Steps
  unpack X Xtest = Train Test spending_features
  Y = Train .Transported Titanic.binary
  Model = X Y Rate Steps Titanic.logistic
  Pred = Xtest Model Titanic.logistic_predict
  Test .Transported = Pred equal 1
  return Test (array .PassengerId .Transported)
end
