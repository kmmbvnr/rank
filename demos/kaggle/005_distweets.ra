rem Kaggle: Natural Language Processing with Disaster Tweets
rem https://www.kaggle.com/competitions/nlp-getting-started
rem Build TF-IDF features for a fixed vocabulary
rem and fit logistic regression in Rank.

use "001_titanic" as Classifier
use algo
use cli
use numbers
use sequences
use tables
use text

argument TrainPath path = "demos/kaggle/data/disaster-tweets/train.csv"
argument TestPath path = "demos/kaggle/data/disaster-tweets/test.csv"
argument OutputPath path = "demos/kaggle/submissions/disaster-tweets.csv"

Train = TrainPath csv
Test = TestPath csv
Submission = Train Test 128 0.1 500 solve_table
Submission OutputPath csv


rem Learn vocabulary only from training text.
fun solve_table Train Test Limit Rate Steps
  TrainTexts = Train .text default ""
  TestTexts = Test .text default ""
  Vocab = TrainTexts Limit vocab
  Pred = TrainTexts (Train .target) TestTexts Vocab Rate Steps solve
  Test .target = Pred
  return Test (array .id .target)
end


rem Count normalized Unicode words from the training vocabulary.
fun term_counts Texts Vocab
  Rows = Texts len
  Columns = Vocab len
  Counts = array shape Rows Columns fill 0.0
  Positions = new index
  for Term Column in Vocab
    if not (Term in Positions)
      Positions Term = new queue
    end
    (Positions Term) push Column
  end
  for Text Row in Texts
    Words = Text words
    for Word in Words
      if Word in Positions
        for Column in (Positions Word)
          Counts Row Column += 1.0
        end
      end
    end
  end
  return Counts
end


rem Fit smoothed inverse document frequencies on Train only.
fun tfidf_fit Texts Vocab
  Counts = Texts Vocab term_counts
  Documents = Texts len
  Terms = Vocab len
  Present = Counts copy
  for Row in 0 until Documents
    for Column in 0 until Terms
      if Counts Row Column greater 0
        Present Row Column = 1.0
      else
        Present Row Column = 0.0
      end
    end
  end
  Frequency = Present sum axis 0
  Idf = (Documents + 1.0) / (Frequency + 1.0) log + 1.0
  return record
    .vocab = Vocab
    .idf = Idf
  end
end


fun tfidf_transform Texts Model
  Counts = Texts (Model .vocab) term_counts
  return Counts * Model .idf
end


fun solve TrainTexts Y TestTexts Vocab Rate Steps
  TextModel = TrainTexts Vocab tfidf_fit
  X = TrainTexts TextModel tfidf_transform
  Xtest = TestTexts TextModel tfidf_transform
  Model = X Y Rate Steps Classifier.logistic
  return Xtest Model Classifier.logistic_predict
end
