rem Kaggle: Connect X
rem Choose a column for the next move.
rem
rem Board: Rows by Cols
rem 0 = empty
rem 1 or 2 = player

use numbers
use sequences


fun move Board Player Rows Cols Need
  Other = 3 - Player

  rem Win immediately.
  for C in 0 until Cols
    if Board C legal
      Next = Board C Player place
      if Next Player Need won
        return C
      end
    end
  end

  rem Block an immediate opponent win.
  for C in 0 until Cols
    if Board C legal
      Next = Board C Other place
      if Next Other Need won
        return C
      end
    end
  end

  rem Otherwise choose the legal column
  rem nearest the center.
  Center = Cols // 2
  Best = -1
  BestDist = Cols + 1
  for C in 0 until Cols
    if Board C legal
      Dist = C - Center abs
      if Dist less BestDist
        Best = C
        BestDist = Dist
      end
    end
  end
  return Best
end


fun legal Board C
  return Board 0 C equal 0
end


rem Return a board with one added piece.
fun place Board C Player
  Next = Board copy
  Rows = (Board shape) 0
  R = Rows - 1
  for R at least 0
    if Next R C equal 0
      Next R C = Player
      return Next
    end
    R -= 1
  end
  return Next
end


fun won Board Player Need
  Rows = (Board shape) 0
  Cols = (Board shape) 1
  for R in 0 until Rows
    for C in 0 until Cols
      if Board R C equal Player
        if Board R C 0 1 Need line
          return true
        end
        if Board R C 1 0 Need line
          return true
        end
        if Board R C 1 1 Need line
          return true
        end
        if Board R C 1 (-1) Need line
          return true
        end
      end
    end
  end
  return false
end


fun line Board R C DR DC Need
  Rows = (Board shape) 0
  Cols = (Board shape) 1
  Player = Board R C
  for K in 1 until Need
    I = R + DR * K
    J = C + DC * K
    if I less 0 or I at least Rows
      return false
    end
    if J less 0 or J at least Cols
      return false
    end
    if Board I J not equal Player
      return false
    end
  end
  return true
end
